@model FYPTracker.Models.FYPProject
@{
    ViewData["Title"] = "Project Details - Library";
}

<div class="container-fluid px-4 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder text-dark mb-1">Library Project Details</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Library")" class="text-decoration-none">Digital Library</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Index", "Library")" class="btn btn-light-primary fw-bold">
            <i class="fas fa-arrow-left me-2"></i>Back to Library
        </a>
    </div>

    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <span class="badge bg-success rounded-pill px-3 mb-2">@Model.FinalGrade Project</span>
                        @if (!string.IsNullOrEmpty(Model.AcademicSession))
                        {
                            <span class="badge bg-secondary rounded-pill px-3 mb-2 ms-2">@Model.AcademicSession</span>
                        }
                        <h2 class="fw-bolder text-dark mb-3">@Model.Title</h2>
                    </div>

                    <h5 class="fw-bold text-dark mt-5 mb-3 border-bottom pb-2">Abstract / Description</h5>
                    <p class="text-muted" style="white-space: pre-line; line-height: 1.8;">
                        @(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)
                    </p>

                    <h5 class="fw-bold text-dark mt-5 mb-3 border-bottom pb-2">Problem Statement</h5>
                    <p class="text-muted" style="white-space: pre-line; line-height: 1.8;">
                        @(string.IsNullOrEmpty(Model.ProblemStatement) ? "No problem statement provided." : Model.ProblemStatement)
                    </p>

                    <h5 class="fw-bold text-dark mt-5 mb-3 border-bottom pb-2">Objectives</h5>
                    <ul class="text-muted" style="line-height: 1.8;">
                        @if (!string.IsNullOrEmpty(Model.Objective1)) { <li>@Model.Objective1</li> }
                        @if (!string.IsNullOrEmpty(Model.Objective2)) { <li>@Model.Objective2</li> }
                        @if (!string.IsNullOrEmpty(Model.Objective3)) { <li>@Model.Objective3</li> }
                        @if (string.IsNullOrEmpty(Model.Objective1) && string.IsNullOrEmpty(Model.Objective2) && string.IsNullOrEmpty(Model.Objective3))
                        {
                            <li>No objectives provided.</li>
                        }
                    </ul>

                    <h5 class="fw-bold text-dark mt-5 mb-3 border-bottom pb-2">Scope</h5>
                    <p class="text-muted" style="white-space: pre-line; line-height: 1.8;">
                        @(string.IsNullOrEmpty(Model.Scope) ? "No scope provided." : Model.Scope)
                    </p>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="col-lg-4">
            <!-- Team Info -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-4">
                    <h5 class="card-title fw-bold text-dark mb-0">Project Team</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <small class="text-muted d-block fw-bold text-uppercase mb-2" style="font-size: 0.7rem;">Author</small>
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:45px;height:45px;border-radius:50%;background:#e0e7ff;display:flex;align-items:center;justify-content:center;color:#4f46e5;font-weight:700;font-size:16px;">
                                @(Model.Student?.FullName?.Substring(0, 1) ?? "S")
                            </div>
                            <div>
                                <div class="fw-bold text-dark">@(Model.Student?.FullName ?? "Unknown")</div>
                                <div class="text-muted small">Student</div>
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <small class="text-muted d-block fw-bold text-uppercase mb-2" style="font-size: 0.7rem;">Supervisor</small>
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:45px;height:45px;border-radius:50%;background:#fef3c7;display:flex;align-items:center;justify-content:center;color:#d97706;font-weight:700;font-size:16px;">
                                @(Model.Supervisor?.FullName?.Substring(0, 1) ?? "S")
                            </div>
                            <div>
                                <div class="fw-bold text-dark">@((!string.IsNullOrEmpty(Model.Supervisor?.Title) ? Model.Supervisor.Title + " " : "") + (Model.Supervisor?.FullName ?? "Unknown"))</div>
                                <div class="text-muted small">Supervisor</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Downloadable Documents -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-4">
                    <h5 class="card-title fw-bold text-dark mb-0">Project Documents</h5>
                </div>
                <div class="card-body p-4">
                    @{
                        // Only show files uploaded by the student
                        // If it's a "Final" milestone, we only want the FIRST file (the thesis), because the second file is always the Ethics form.
                        // For other milestones, we keep all files.
                        var studentFiles = Model.Milestones
                            .Where(m => !string.IsNullOrEmpty(m.Title) && !m.Title.Contains("Ethics", StringComparison.OrdinalIgnoreCase))
                            .SelectMany(m => {
                                var files = m.SubmissionFiles.Where(f => f.UploadedBy == Model.StudentId).OrderBy(f => f.Id).ToList();
                                if (m.Title.Contains("Final", StringComparison.OrdinalIgnoreCase) && files.Count > 1) {
                                    return files.Take(1); // Keep only the first file (thesis), drop the rest (ethics)
                                }
                                return files;
                            })
                            .Where(f => !f.FileName.Contains("Ethics", StringComparison.OrdinalIgnoreCase))
                            .OrderByDescending(f => f.UploadedDate)
                            .ToList();
                    }

                    @if (studentFiles.Any())
                    {
                        var usedNames = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                        <div class="d-flex flex-column gap-3">
                            @foreach (var file in studentFiles)
                            {
                                string ext = System.IO.Path.GetExtension(file.FileName);
                                string mTitle = file.Milestone?.Title ?? "Document";
                                string mTitleLower = mTitle.ToLower();
                                string displayName;

                                if (mTitleLower.Contains("proposal")) {
                                    displayName = "proposal" + ext;
                                } else if (mTitleLower.Contains("final")) {
                                    displayName = "finalReport" + ext;
                                } else {
                                    string safeName = System.Text.RegularExpressions.Regex.Replace(mTitle, @"[^a-zA-Z0-9]", "");
                                    if (string.IsNullOrEmpty(safeName)) safeName = "document";
                                    else safeName = char.ToLower(safeName[0]) + safeName.Substring(1);
                                    
                                    displayName = safeName + ext;
                                }

                                if (usedNames.ContainsKey(displayName)) {
                                    usedNames[displayName]++;
                                    string nameWithoutExt = System.IO.Path.GetFileNameWithoutExtension(displayName);
                                    displayName = nameWithoutExt + "_" + usedNames[displayName] + ext;
                                } else {
                                    usedNames[displayName] = 1;
                                }

                                <div class="d-flex align-items-center justify-content-between p-3 border rounded-3 bg-light">
                                    <div class="d-flex align-items-center gap-3 overflow-hidden">
                                        <i class="fas fa-file-pdf text-danger fs-2"></i>
                                        <div>
                                            <div class="fw-bold text-dark text-truncate" style="max-width: 180px;" title="@displayName">@displayName</div>
                                            <div class="text-muted small">@file.UploadedDate.ToString("dd MMM yyyy")</div>
                                        </div>
                                    </div>
                                    <a href="@Url.Action("DownloadFile", "Library", new { fileId = file.Id })" class="btn btn-sm btn-icon btn-light-primary rounded-circle" title="Download">
                                        <i class="fas fa-download"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-folder-open fs-2 mb-2 text-gray-400"></i>
                            <p class="mb-0 small">No downloadable documents available.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
