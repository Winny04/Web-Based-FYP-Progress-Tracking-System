<!--begin::Toolbar wrapper-->
<div class="topbar d-flex align-items-stretch flex-shrink-0">
    @using Microsoft.AspNetCore.Mvc;
    @using FYPTracker.Models;
    @using System.Net;
    @using Microsoft.AspNetCore.Mvc.Rendering;
    @using Microsoft.Data.SqlClient;
    @using Microsoft.EntityFrameworkCore;
    @using Microsoft.AspNetCore.Http;
    @{
        var dbContext = Context.RequestServices.GetService(typeof(FYPTrackerContext)) as FYPTrackerContext;
        var currentUserName = Context.User.Identity?.Name;
        var currentUserObj = currentUserName != null ? dbContext?.ApplicationUsers.Include(u => u.UserRoles).ThenInclude(ur => ur.Role).FirstOrDefault(u => u.UserName == currentUserName) : null;
        var avatarImg = !string.IsNullOrEmpty(currentUserObj?.Image) ? currentUserObj.Image : "/assets/media/avatars/blank.png";
        
        var userType = Context.Session.GetString("ActiveRole");
        if (string.IsNullOrEmpty(userType)) {
            var userRoles = Context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            userType = userRoles.FirstOrDefault() ?? "";
        }
        
        string notifUrl = "/User/Notification";
        if (userType == "Student") {
            notifUrl = "/Student/Notifications";
        } else if (userType == "Supervisor") {
            notifUrl = "/Supervisor/Notifications";
        } else if (userType == "Examiner") {
            notifUrl = "/Examiner/Notifications";
        }
        
        int unreadCount = 0;
        if (currentUserObj != null && dbContext != null) {
            unreadCount = dbContext.FYPNotifications.Count(n => n.RecipientId == currentUserObj.Id && !n.IsRead);
        }
    }
    <div class="d-flex align-items-center me-n3 ms-1 ms-lg-3">
    </div>
    <div class="d-flex align-items-center me-n3 ms-1 ms-lg-3" id="kt_header_user_menu_toggle">
        <!--begin::Menu wrapper-->
        <div class="btn btn-icon btn-active-light-primary btn btn-icon btn-active-light-primary btn-custom w-30px h-30px w-md-40px h-md-40px" data-kt-menu-trigger="click" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
            <img class="h-30px w-30px rounded-circle" style="object-fit: cover;" src="@avatarImg" alt="Profile Image" onerror="this.onerror=null; this.src='/assets/media/avatars/blank.png';" />
        </div>
        <!--begin::User account menu-->
        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-primary fw-bold py-4 fs-6 w-275px" data-kt-menu="true">
            <!--begin::Menu item-->
            <div class="menu-item px-3">
                <div class="menu-content d-flex align-items-center px-3">
                    <!--begin::Username-->
                    <div class="d-flex flex-column">
                        <div class="fw-bolder d-flex align-items-center fs-5">
                            @(!string.IsNullOrEmpty(currentUserObj?.Title) && currentUserObj.Title != "Not Assigned" ? currentUserObj.Title + " " : "")@(currentUserObj?.FullName ?? Context.User.Identity?.Name ?? "")
                        </div>
                    </div>
                    <!--end::Username-->
                </div>
            </div>
            <!--end::Menu item-->
            <!--begin::Menu separator-->
            <div class="separator my-2"></div>
            <!--end::Menu separator-->
            <!--begin::Menu item-->
            <div class="menu-item px-5">
                <a href="/User/Profile?name=@Context.User.Identity.Name" class="menu-link px-5"><i class="fas fa-user me-2 text-muted"></i> My Profile</a>
            </div>
            <!--end::Menu item-->
            <!--begin::Menu separator-->
            <div class="separator my-2"></div>
            @if (currentUserObj != null && currentUserObj.UserRoles != null && currentUserObj.UserRoles.Count > 1)
            {
                <div class="menu-item px-5" data-kt-menu-trigger="hover" data-kt-menu-placement="left-start">
                    <a href="#" class="menu-link px-5">
                        <span class="menu-title"><i class="fas fa-exchange-alt me-2 text-muted"></i> Switch Role</span>
                        <span class="menu-arrow"></span>
                    </a>
                    <div class="menu-sub menu-sub-dropdown w-175px py-4">
                        @foreach (var ur in currentUserObj.UserRoles)
                        {
                            var roleName = ur.Role?.Name;
                            if (!string.IsNullOrEmpty(roleName))
                            {
                                <div class="menu-item px-3">
                                    <form method="post" action="/User/SwitchRole" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="newRole" value="@roleName" />
                                        <a href="javascript:void(0);" onclick="$(this).closest('form').submit();" class="menu-link px-5 @(userType == roleName ? "active text-primary" : "")">
                                            @roleName
                                        </a>
                                    </form>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="separator my-2"></div>
            }

            @if (userType != "Admin") {
                <div class="menu-item px-5">
                    <a href="@notifUrl" class="menu-link px-5">
                        <i class="fas fa-bell me-2 text-muted"></i>
                        <span class="flex-grow-1">Notification</span>
                        <span id="header_notification_badge" class="badge badge-sm badge-circle badge-danger @(unreadCount > 0 ? "" : "d-none")" style="width: 18px; height: 18px; font-size: 0.75rem; transition: transform 0.2s;">@unreadCount</span>
                    </a>
                </div>
                <div class="separator my-2"></div>
            }
            <div class="menu-item px-5">
                <a href="/User/Logout" class="menu-link px-5"><i class="fas fa-sign-out-alt me-2 text-muted"></i> Sign Out</a>
            </div>
        </div>
    </div>
</div>



