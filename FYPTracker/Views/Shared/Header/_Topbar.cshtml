<!--begin::Toolbar wrapper-->
<div class="topbar d-flex align-items-stretch flex-shrink-0">
    @using Microsoft.AspNetCore.Mvc;
    @using FYPTracker.Models;
    @using System.Net;
    @using Microsoft.AspNetCore.Mvc.Rendering;
    @using Microsoft.Data.SqlClient;

    <div class="d-flex align-items-center me-n3 ms-1 ms-lg-3" id="kt_header_user_menu_toggle">

        <div class="form-check form-switch">
            <input class="form-check-input" checked="checked" type="checkbox" role="switch" id="toggleNotify">
            <p style="color:white;" class="mx-1" id="ct6"></p>
        </div>

    </div>
    <div class="d-flex align-items-center me-n3 ms-1 ms-lg-3" id="kt_header_user_menu_toggle">
        <!--begin::Menu wrapper-->
        <div class="btn btn-icon btn-active-light-primary btn btn-icon btn-active-light-primary btn-custom w-30px h-30px w-md-40px h-md-40px" data-kt-menu-trigger="click" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
            @if (!string.IsNullOrEmpty(Context.Request.Cookies[CookieDefaults.CookieImageKey]))
            {
                <img class="h-30px w-30px rounded" src="@Context.Request.Cookies[CookieDefaults.CookieImageKey]" alt="Profile Image" />
            }
            else
            {
                <img class="h-30px w-30px rounded" src="/blank.png" alt="Profile Image" />
            }
        </div>
        <!--begin::User account menu-->
        <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-primary fw-bold py-4 fs-6 w-275px" data-kt-menu="true">
            <!--begin::Menu item-->
            <div class="menu-item px-3">
                <div class="menu-content d-flex align-items-center px-3">
                    <!--begin::Username-->
                    <div class="d-flex flex-column">
                        <div class="fw-bolder d-flex align-items-center fs-5">
                            @Context.User.Identity.Name
                        </div>
                    </div>
                    <!--end::Username-->
                </div>
            </div>
            <!--end::Menu item-->
            <!--begin::Menu separator-->
            <div class="separator my-2"></div>
            <!--end::Menu separator-->
            <!--begin::Menu item-->
            <div class="menu-item px-5">
                <a href="/User/Profile?name=@Context.User.Identity.Name" class="menu-link px-5">My Profile</a>
            </div>
            <!--end::Menu item-->
            <!--begin::Menu separator-->
            <div class="separator my-2"></div>
             <div class="menu-item px-5">
                <a href="@Url.Action("Notification","ApplicationUser")" class="menu-link px-5">Notification</a>
            </div>
             <div class="separator my-2"></div>
            <div class="menu-item px-5">
                <a href="/User/Logout" class="menu-link px-5">Sign Out</a>
            </div>
        </div>
    </div>
</div>

<script>
 function display_ct6() {
        var x = new Date()
        hours = x.getHours();
        var x2 = x.toLocaleString('default', { month: 'short' })
        var x3 = x.toLocaleString('default', { weekday: 'short' })
        var x1 = " " + x.getDate() + " " + x.getFullYear();
        x1 = x3 + " " + x2 + x1 + "  " + hours + ":" + x.getMinutes() + ":" + x.getSeconds();
        document.getElementById('ct6').innerHTML = x1;
        display_c6();
    }
    function display_c6() {
        var refresh = 1000; // Refresh rate in milli seconds
        mytime = setTimeout('display_ct6()', refresh)
    }
    display_c6()
    
    </script>


