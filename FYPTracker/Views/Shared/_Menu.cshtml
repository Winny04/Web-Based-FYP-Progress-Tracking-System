@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Http
@using FYPTracker.Models
@using Microsoft.EntityFrameworkCore
@inject IAuthorizationService AuthorizationService
@inject FYPTrackerContext _context
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    // Always look up the logged-in user directly — ViewBag is NOT passed to ViewComponents
    var userName = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
    var currentUser = (userName != null)
        ? await _context.ApplicationUsers.FirstOrDefaultAsync(u => u.UserName == userName)
        : null;
        
    var sessionRole = HttpContextAccessor.HttpContext?.Session.GetString("ActiveRole");
    var userRoles = HttpContextAccessor.HttpContext?.User?.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList() ?? new List<string>();
    var userType = !string.IsNullOrEmpty(sessionRole) ? sessionRole : (userRoles.FirstOrDefault() ?? "Student");
    // Check if this student already has a confirmed (Approved) supervisor
    bool hasSupervisor = false;
    if (userType == "Student" && currentUser != null)
    {
        hasSupervisor = await _context.SupervisorRequests
            .AnyAsync(r => r.StudentId == currentUser.Id && r.Status == "Approved");
    }

    var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? "";

    int pendingRequests = 0;
    int pendingSubmissions = 0;
    int pendingMeetings = 0;
    int unreadMessages = 0;
    
    // Admin counts
    int adminPendingRequests = 0;
    
    // Student counts
    int studentPendingSupervisorReqs = 0;
    int studentPendingForms = 0;
    int studentPendingMeetings = 0;

    if (userType == "Supervisor" && currentUser != null)
    {
        pendingRequests = await _context.SupervisorRequests.CountAsync(r => r.SupervisorId == currentUser.Id && r.Status == "Pending");
        pendingSubmissions = await _context.FYPMilestones.CountAsync(m => m.Project.SupervisorId == currentUser.Id && m.Status == "Submitted");
        pendingMeetings = await _context.MeetingBookings.CountAsync(m => m.SupervisorId == currentUser.Id && m.Status == "Pending");
    }
    else if ((userType == "Admin" || userType == "SuperAdmin") && currentUser != null)
    {
        adminPendingRequests = await _context.SupervisorRequests.CountAsync(r => r.Status == "Pending");
    }
    else if (userType == "Student" && currentUser != null)
    {
        studentPendingSupervisorReqs = await _context.SupervisorRequests.CountAsync(r => r.StudentId == currentUser.Id && r.Status == "Pending");
        studentPendingForms = await _context.FYPMilestones.CountAsync(m => m.Project.StudentId == currentUser.Id && (m.Status == "Rejected" || m.Status == "Revision"));
        studentPendingMeetings = await _context.MeetingBookings.CountAsync(m => m.StudentId == currentUser.Id && (m.Status == "Pending" || m.Status == "Postponed"));
    }
    
    if (currentUser != null)
    {
        unreadMessages = await _context.ChatMessages.CountAsync(m => m.ReceiverId == currentUser.Id && !m.IsRead);
    }
}

<!--begin::Menu wrapper-->
<div class="header-menu align-items-stretch">
    <!--begin::Menu-->
    <div class="menu menu-lg-rounded menu-column menu-lg-row menu-state-bg menu-title-gray-700 menu-state-icon-primary menu-state-bullet-primary menu-arrow-gray-400 fw-bold my-5 my-lg-0 align-items-stretch" id="kt_header_menu" data-kt-menu="true">
        
        @if (userType != "Admin" && userType != "SuperAdmin" && userType != "Examiner")
        {
            string dashUrl = (userType == "Supervisor") ? "/Supervisor" : "/Student";
            <div class="menu-item @(pageTitle.Contains("Home") || pageTitle.Contains("Dashboard") ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle.Contains("Home") || pageTitle.Contains("Dashboard") ? "active border-bottom border-3 border-primary" : "")" href="@dashUrl">
                    <span class="menu-title">Dashboard</span>
                </a>
            </div>
        }

        @if (userType == "Student")
        {
            @if (hasSupervisor)
            {
                <div class="menu-item @(pageTitle == "Project Details" ? "here show" : "")">
                    <a class="menu-link py-3 @(pageTitle == "Project Details" ? "active border-bottom border-3 border-primary" : "")" href="/Student/ProjectDetails">
                        <span class="menu-title">Project Details</span>
                    </a>
                </div>
            }
            @if (!hasSupervisor)
            {
            <div class="menu-item @(pageTitle == "Select Supervisor" ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle == "Select Supervisor" ? "active border-bottom border-3 border-primary" : "")" href="/Student/SelectSupervisor">
                    <span class="menu-title d-flex align-items-center">
                        Select Supervisor
                        @if(studentPendingSupervisorReqs > 0) { <span class="badge badge-sm badge-circle badge-warning ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@studentPendingSupervisorReqs</span> }
                    </span>
                </a>
            </div>
            }
            @if (hasSupervisor)
            {
                <div class="menu-item @(pageTitle.Contains("Forms") ? "here show" : "")">
                    <a class="menu-link py-3 @(pageTitle.Contains("Forms") ? "active border-bottom border-3 border-primary" : "")" href="/Student/Forms">
                        <span class="menu-title d-flex align-items-center">
                            Assignments
                            @if(studentPendingForms > 0) { <span class="badge badge-sm badge-circle badge-danger ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@studentPendingForms</span> }
                        </span>
                    </a>
                </div>
                <div class="menu-item @(pageTitle == "Book Meeting" ? "here show" : "")">
                    <a class="menu-link py-3 @(pageTitle == "Book Meeting" ? "active border-bottom border-3 border-primary" : "")" href="/Student/BookMeeting">
                        <span class="menu-title d-flex align-items-center">
                            Book Meeting
                            @if(studentPendingMeetings > 0) { <span class="badge badge-sm badge-circle badge-danger ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@studentPendingMeetings</span> }
                        </span>
                    </a>
                </div>
                <div class="menu-item @(pageTitle == "Messages" ? "here show" : "")">
                    <a class="menu-link py-3 @(pageTitle == "Messages" ? "active border-bottom border-3 border-primary" : "")" asp-controller="Chat" asp-action="Index">
                        <span class="menu-title d-flex align-items-center">
                            Messages
                            @if(unreadMessages > 0) { <span class="badge badge-sm badge-circle badge-danger ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@unreadMessages</span> }
                        </span>
                    </a>
                </div>
            }
        }
        else if (userType == "Supervisor")
        {
            <div class="menu-item @(pageTitle == "Student Requests" ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle == "Student Requests" ? "active border-bottom border-3 border-primary" : "")" href="/Supervisor/StudentRequests">
                    <span class="menu-title d-flex align-items-center">
                        Student Requests
                        @if(pendingRequests > 0) { <span class="badge badge-sm badge-circle badge-danger ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@pendingRequests</span> }
                    </span>
                </a>
            </div>
            <div class="menu-item @(pageTitle == "My Students" ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle == "My Students" ? "active border-bottom border-3 border-primary" : "")" href="/Supervisor/MyProjects">
                    <span class="menu-title">My Students</span>
                </a>
            </div>
            <div class="menu-item @(pageTitle == "Review Submissions" ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle == "Review Submissions" ? "active border-bottom border-3 border-primary" : "")" href="/Supervisor/ReviewSubmissions">
                    <span class="menu-title d-flex align-items-center">
                        Review Submissions
                        @if(pendingSubmissions > 0) { <span class="badge badge-sm badge-circle badge-danger ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@pendingSubmissions</span> }
                    </span>
                </a>
            </div>
            <div class="menu-item @(pageTitle == "Manage Meetings" ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle == "Manage Meetings" ? "active border-bottom border-3 border-primary" : "")" href="/Supervisor/ManageMeetings">
                    <span class="menu-title d-flex align-items-center">
                        Manage Meetings
                        @if(pendingMeetings > 0) { <span class="badge badge-sm badge-circle badge-danger ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@pendingMeetings</span> }
                    </span>
                </a>
            </div>
            <div class="menu-item @(pageTitle == "My Availability" ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle == "My Availability" ? "active border-bottom border-3 border-primary" : "")" href="/Supervisor/ManageAvailability">
                    <span class="menu-title">My Availability</span>
                </a>
            </div>
            <div class="menu-item @(pageTitle == "Reports & Analytics" ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle == "Reports & Analytics" ? "active border-bottom border-3 border-primary" : "")" href="/Supervisor/Reporting">
                    <span class="menu-title">Reporting</span>
                </a>
            </div>
            <div class="menu-item @(pageTitle == "Messages" ? "here show" : "")">
                <a class="menu-link py-3 @(pageTitle == "Messages" ? "active border-bottom border-3 border-primary" : "")" asp-controller="Chat" asp-action="Index">
                    <span class="menu-title d-flex align-items-center">
                        Messages
                        @if(unreadMessages > 0) { <span class="badge badge-sm badge-circle badge-danger ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@unreadMessages</span> }
                    </span>
                </a>
            </div>

        }
        else if (userType == "Admin" || userType == "SuperAdmin")
        {
            bool isDashboard = currentPath == "/Admin" || currentPath == "/Admin/" || currentPath.StartsWith("/Admin/Index", StringComparison.OrdinalIgnoreCase);
            bool isUsers = currentPath.StartsWith("/Admin/ManageUsers", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Admin/EditUser", StringComparison.OrdinalIgnoreCase);
            bool isProjects = currentPath.StartsWith("/Admin/ManageProjects", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Admin/ProjectDetails", StringComparison.OrdinalIgnoreCase);
            bool isReporting = currentPath.StartsWith("/Admin/Reporting", StringComparison.OrdinalIgnoreCase);
            bool isSettings = currentPath.StartsWith("/Admin/Settings", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/Admin/ApprovedIafList", StringComparison.OrdinalIgnoreCase);
            bool isLookups = currentPath.StartsWith("/Admin/ManageLookups", StringComparison.OrdinalIgnoreCase);

            <div class="menu-item @(isDashboard ? "here show" : "")">
                <a class="menu-link py-3 @(isDashboard ? "active border-bottom border-3 border-primary" : "")" href="/Admin">
                    <span class="menu-title d-flex align-items-center">
                        Dashboard
                        @if(adminPendingRequests > 0) { <span class="badge badge-sm badge-circle badge-danger ms-2" style="width: 18px; height: 18px; font-size: 0.75rem;">@adminPendingRequests</span> }
                    </span>
                </a>
            </div>
            <div class="menu-item @(isUsers ? "here show" : "")">
                <a class="menu-link py-3 @(isUsers ? "active border-bottom border-3 border-primary" : "")" href="/Admin/ManageUsers">
                    <span class="menu-title">Manage Users</span>
                </a>
            </div>
            <div class="menu-item @(isLookups ? "here show" : "")">
                <a class="menu-link py-3 @(isLookups ? "active border-bottom border-3 border-primary" : "")" href="/Admin/ManageLookups">
                    <span class="menu-title">Manage Lookups</span>
                </a>
            </div>
            <div class="menu-item @(isProjects ? "here show" : "")">
                <a class="menu-link py-3 @(isProjects ? "active border-bottom border-3 border-primary" : "")" href="/Admin/ManageProjects">
                    <span class="menu-title">All Projects</span>
                </a>
            </div>
            <div class="menu-item @(isReporting ? "here show" : "")">
                <a class="menu-link py-3 @(isReporting ? "active border-bottom border-3 border-primary" : "")" href="/Admin/Reporting">
                    <span class="menu-title">Reporting</span>
                </a>
            </div>
            <div class="menu-item @(isSettings ? "here show" : "")">
                <a class="menu-link py-3 @(isSettings ? "active border-bottom border-3 border-primary" : "")" href="/Admin/Settings">
                    <span class="menu-title">System Settings</span>
                </a>
            </div>
        }
        else if (userType == "Examiner")
        {
            bool isDashboard = currentPath == "/Examiner" || currentPath == "/Examiner/" || currentPath.StartsWith("/Examiner/Index", StringComparison.OrdinalIgnoreCase);

            <div class="menu-item @(isDashboard ? "here show" : "")">
                <a class="menu-link py-3 @(isDashboard ? "active border-bottom border-3 border-primary" : "")" href="/Examiner">
                    <span class="menu-title d-flex align-items-center">
                        Dashboard
                    </span>
                </a>
            </div>
        }
        
        @{
            bool isLibrary = currentPath.StartsWith("/Library", StringComparison.OrdinalIgnoreCase);
        }
        <div class="menu-item @(isLibrary ? "here show" : "")">
            <a class="menu-link py-3 @(isLibrary ? "active border-bottom border-3 border-primary" : "")" href="/Library">
                <span class="menu-title"><i class="fas fa-book me-2"></i>Digital Library</span>
            </a>
        </div>
    </div>
    <!--end::Menu-->
</div>
<!--end::Menu wrapper-->



