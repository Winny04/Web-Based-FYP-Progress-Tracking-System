@using FYPTracker.ViewModels;
@model CardModel

<div class="card h-lg-100 @Model.bgColor rounded">
    <!--begin::Body-->
    <div class="card-body d-flex justify-content-between align-items-start flex-column">
        <!--begin::Icon-->
        <div class="m-0">
            <i class="fs-2hx @Model.symbol"></i>
        </div>
        <!--end::Icon-->
        <!--begin::Section-->
        <div class="d-flex flex-column my-7">
            <!--begin::Number-->
            <span class="fw-bold fs-3x text-gray-800 lh-1 ls-n2">@Model.value</span>
            <!--end::Number-->
            <!--begin::Follower-->
            <div class="m-0">
                <span class="fw-bold fs-6 text-gray-400">@Model.title</span>
            </div>
            <!--end::Follower-->
        </div>
        <!--end::Section-->
    </div>
    <!--end::Body-->
</div>

