@model IEnumerable<FYPTracker.Models.SupervisorTimetableEntry>

@{
    ViewData["Title"] = "Preview Timetable Upload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root { 
        --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); 
        --glass-bg: rgba(255, 255, 255, 0.95);
        --glass-border: rgba(255, 255, 255, 0.2);
    }
    
    .premium-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }
</style>

<div class="container-xxl py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="premium-card p-5">
                <div class="text-center mb-5">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-4" style="width: 80px; height: 80px;">
                        <i class="fas fa-search fs-1"></i>
                    </div>
                    <h2 class="fw-bold text-dark">Preview Timetable Upload</h2>
                    <p class="text-muted">Review the parsed schedule before applying it to your account for session <span class="fw-bold text-dark">@ViewBag.CurrentSession</span>.</p>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark mb-4 rounded-4 p-3 d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle fs-4 me-3 text-warning"></i>
                        <div>
                            <strong>Warning:</strong> Saving this will completely replace your existing weekly timetable for this academic session.
                        </div>
                    </div>

                    <div class="table-responsive rounded-4 border overflow-hidden mb-5">
                        <table class="table table-borderless table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="text-muted small fw-bold text-uppercase border-bottom">
                                    <th class="ps-4">Day</th>
                                    <th>Time</th>
                                    <th class="pe-4">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int GetDayOrder(string? d) => d?.Trim().ToLowerInvariant() switch
                                    {
                                        "monday" => 1,
                                        "tuesday" => 2,
                                        "wednesday" => 3,
                                        "thursday" => 4,
                                        "friday" => 5,
                                        "saturday" => 6,
                                        "sunday" => 7,
                                        _ => 99
                                    };
                                }
                                @foreach (var item in Model.OrderBy(i => GetDayOrder(i.DayOfWeek)).ThenBy(i => i.StartTime))
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">
                                            <span class="badge badge-light-primary px-3 py-2 fw-bolder fs-7" style="color: #009ef7 !important; background-color: #f1faff !important; border: 1px solid rgba(0, 158, 247, 0.3) !important;">@item.DayOfWeek</span>
                                        </td>
                                        <td><span class="fw-semibold text-dark"><i class="far fa-clock text-muted me-1 small"></i> @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span></td>
                                        <td class="pe-4 text-muted small">@item.Details</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <form asp-action="SaveTimetable" method="post" class="d-flex gap-3 justify-content-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSession" />
                        <a href="@Url.Action("ManageTimetable", new { sessionFilter = ViewBag.CurrentSession })" class="btn btn-light btn-lg fw-bold rounded-pill px-5 shadow-sm text-dark">Cancel</a>
                        <button class="btn btn-success btn-lg fw-bold rounded-pill px-5 shadow-sm" type="submit"><i class="fas fa-save me-2"></i>Confirm & Save</button>
                    </form>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-times-circle fs-1 text-danger mb-3"></i>
                        <h5 class="fw-bold text-dark">No Valid Entries</h5>
                        <p class="text-muted">We couldn't parse any valid timetable blocks from your CSV file.</p>
                        <a href="@Url.Action("ManageTimetable", new { sessionFilter = ViewBag.CurrentSession })" class="btn btn-primary fw-bold rounded-pill px-5 mt-3 shadow-sm">Go Back to Upload</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
