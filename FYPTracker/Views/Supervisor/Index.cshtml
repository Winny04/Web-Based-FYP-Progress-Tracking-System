@using FYPTracker.Models
@{
    ViewData["Title"] = "Supervisor Dashboard";
    var user           = ViewBag.CurrentUser as ApplicationUser;
    var recentRequests = ViewBag.RecentRequests as List<SupervisorRequest> ?? new();
    var nextMeetings   = ViewBag.NextMeetings as List<MeetingBooking> ?? new();
    var pendingMilestones = ViewBag.PendingMilestones as List<FYPMilestone> ?? new();
    var pendingMeetingsList = ViewBag.PendingMeetingsList as List<MeetingBooking> ?? new();
    var upcomingDefenses = ViewBag.UpcomingDefenses as List<FYPMilestone> ?? new();
    
    int pendingRequestsCount = ViewBag.PendingRequests ?? 0;
    int pendingReviewsCount = ViewBag.PendingReviews ?? 0;
    int pendingMeetingCount = pendingMeetingsList.Count;

    bool hasActionRequired = pendingRequestsCount > 0 || pendingReviewsCount > 0 || pendingMeetingCount > 0;
}

<style>
    :root {
        --bg-body: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #1e293b;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --accent-dark: #0f172a;
        --accent-light: #334155;
    }

    body {
        background-color: var(--bg-body);
        font-family: 'Inter', sans-serif;
    }

    /* FullCalendar Custom Overrides */
    .fc .fc-daygrid-body tr:hover {
        background-color: transparent !important;
    }
    
    .fc .fc-daygrid-day:hover {
        background-color: #f8fafc !important;
        cursor: pointer;
    }

    .premium-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
    }

    .taskbar {
        background-color: var(--accent-dark);
        border-radius: 16px;
        color: white;
        padding: 32px 40px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.3);
        margin-bottom: 32px;
        position: relative;
        overflow: hidden;
    }
    
    .taskbar::before {
        content: '';
        position: absolute;
        top: 0; right: 0; bottom: 0; left: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%);
        pointer-events: none;
    }

    .stat-card-clean {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: transform 0.2s ease;
    }

    .stat-card-clean:hover {
        transform: translateY(-2px);
        border-color: #cbd5e1;
    }

    .stat-icon-wrapper {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        background-color: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-dark);
        font-size: 1.5rem;
    }

    .action-alert {
        border-left: 4px solid var(--accent-dark);
        background-color: #f8fafc;
        padding: 16px 20px;
        border-radius: 8px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 12px;
        border-top: 1px solid var(--border-color);
        border-right: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .action-alert-icon {
        color: var(--accent-dark);
        font-size: 1.25rem;
        margin-top: 2px;
    }

    .list-item-clean {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        transition: background-color 0.2s;
    }
    
    .list-item-clean:last-child {
        border-bottom: none;
    }

    .list-item-clean:hover {
        background-color: #f8fafc;
    }

    .btn-monochrome {
        background-color: var(--accent-dark);
        color: white;
        border: none;
        font-weight: 500;
        transition: background-color 0.2s;
    }

    .btn-monochrome:hover {
        background-color: var(--accent-light);
        color: white;
    }

    .btn-outline-monochrome {
        background-color: transparent;
        color: var(--accent-dark);
        border: 1px solid var(--border-color);
        font-weight: 500;
        transition: all 0.2s;
    }

    .btn-outline-monochrome:hover {
        background-color: #f1f5f9;
        border-color: #cbd5e1;
        color: var(--accent-dark);
    }
    
    .badge-monochrome {
        background-color: #e2e8f0;
        color: var(--text-main);
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 999px;
    }

    .avatar-circle-sm {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #e2e8f0;
        color: var(--accent-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .badge-bell {
        position: absolute;
        top: -4px;
        right: -4px;
        font-size: 0.65rem;
        padding: 4px 6px;
        border-radius: 999px;
        background-color: #ef4444;
        color: white;
    }
</style>

<div class="container-fluid py-4">

    @* ── TOP TASKBAR ────────────────────────────────────────── *@
    <div class="taskbar d-flex justify-content-between align-items-center flex-wrap gap-4">
        <div>
            <h1 class="display-6 fw-bold mb-2">Welcome Back, @(!string.IsNullOrEmpty(user?.Title) && user.Title != "Not Assigned" ? user.Title + " " : "")@(user?.FullName ?? "Supervisor")</h1>
            <div class="d-flex align-items-center gap-3 flex-wrap opacity-75" style="font-size: 0.95rem;">
                <!-- <span><strong>Staff ID:</strong> @(user?.EmployeeId ?? "—")</span> -->
                <span class="text-white-50">|</span>
                <span><strong>Supervising:</strong> @ViewBag.TotalProjects Active Projects</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            @await Html.PartialAsync("_SessionFilter")
            <a href="/Supervisor/Notifications" class="btn btn-icon position-relative rounded-circle" style="width: 48px; height: 48px; background: rgba(255,255,255,0.1); color: white; display: flex; align-items: center; justify-content: center; transition: background 0.2s;">
                <i class="fas fa-bell fs-4"></i>
                @if (ViewBag.UnreadNotificationCount > 0)
                {
                    <span class="badge badge-bell">@ViewBag.UnreadNotificationCount</span>
                }
            </a>
        </div>
    </div>

    @* ── PRIORITY ACTION CENTER ─────────────────────────────── *@
    @if (hasActionRequired)
    {
        <div class="premium-card p-4 mb-5 border-0 shadow-sm" style="border-top: 4px solid var(--accent-dark) !important;">
            <h5 class="fw-bold mb-4 text-dark"><i class="fas fa-clipboard-list me-2"></i>Priority Action Required</h5>
            
            <div class="d-flex flex-column gap-2">
                @if (pendingRequestsCount > 0)
                {
                    <div class="action-alert shadow-sm">
                        <i class="fas fa-user-plus action-alert-icon"></i>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1">New Project Requests</h6>
                            <p class="mb-0 text-muted" style="font-size: 0.9rem;">You have <strong>@pendingRequestsCount</strong> student(s) requesting your supervision.</p>
                        </div>
                        <a href="/Supervisor/StudentRequests" class="btn btn-sm btn-monochrome px-4 rounded-pill">Review Requests</a>
                    </div>
                }

                @if (pendingReviewsCount > 0)
                {
                    <div class="action-alert shadow-sm">
                        <i class="fas fa-file-signature action-alert-icon"></i>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1">Milestone Submissions Pending Review</h6>
                            <p class="mb-0 text-muted" style="font-size: 0.9rem;">You have <strong>@pendingReviewsCount</strong> document(s) waiting for your feedback or approval.</p>
                        </div>
                        <a href="/Supervisor/ReviewSubmissions" class="btn btn-sm btn-monochrome px-4 rounded-pill">Review Submissions</a>
                    </div>
                }

                @if (pendingMeetingCount > 0)
                {
                    <div class="action-alert shadow-sm">
                        <i class="fas fa-handshake action-alert-icon"></i>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1">Pending Meeting Bookings</h6>
                            <p class="mb-0 text-muted" style="font-size: 0.9rem;">You have <strong>@pendingMeetingCount</strong> meeting request(s) awaiting your approval or rescheduling.</p>
                        </div>
                        <a href="/Supervisor/ManageMeetings" class="btn btn-sm btn-monochrome px-4 rounded-pill">Manage Meetings</a>
                    </div>
                }
            </div>
        </div>
    }

    @* ── STATS ROW ──────────────────────────────────────────── *@
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card-clean shadow-sm">
                <div class="stat-icon-wrapper"><i class="fas fa-project-diagram"></i></div>
                <div>
                    <div class="text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Active Projects</div>
                    <div class="fs-2 fw-bolder text-dark" style="line-height: 1;">@ViewBag.TotalProjects</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-clean shadow-sm">
                <div class="stat-icon-wrapper"><i class="fas fa-user-clock"></i></div>
                <div>
                    <div class="text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Pending Requests</div>
                    <div class="fs-2 fw-bolder text-dark" style="line-height: 1;">@pendingRequestsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-clean shadow-sm">
                <div class="stat-icon-wrapper"><i class="fas fa-tasks"></i></div>
                <div>
                    <div class="text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Documents to Review</div>
                    <div class="fs-2 fw-bolder text-dark" style="line-height: 1;">@pendingReviewsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-clean shadow-sm">
                <div class="stat-icon-wrapper"><i class="fas fa-calendar-check"></i></div>
                <div>
                    <div class="text-muted fw-semibold" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Upcoming Meetings</div>
                    <div class="fs-2 fw-bolder text-dark" style="line-height: 1;">@ViewBag.UpcomingMeetings</div>
                </div>
            </div>
        </div>
    </div>

    @* ── MAIN CONTENT (2 COLUMN) ────────────────────────────── *@
    <div class="row g-4">
        
        @* LEFT COLUMN: Needs Attention *@
        <div class="col-lg-7">
            
            <!-- Pending Milestone Reviews -->
            <div class="premium-card mb-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center p-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-inbox me-2 text-muted"></i>Awaiting Your Review</h5>
                    <a href="/Supervisor/ReviewSubmissions" class="btn btn-sm btn-outline-monochrome rounded-pill px-3">View All</a>
                </div>
                
                @if (!pendingMilestones.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-check-double fs-1 mb-3" style="color: #e2e8f0;"></i>
                        <p class="mb-0">You're all caught up! No documents to review.</p>
                    </div>
                }
                else
                {
                    <div>
                        @foreach (var m in pendingMilestones)
                        {
                            <div class="list-item-clean d-flex align-items-center gap-3">
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark fs-6">@m.Title</div>
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <div class="avatar-circle-sm">
                                            @(m.Project?.Student?.FullName?[0] ?? 'S')
                                        </div>
                                        <span class="text-muted fs-7">@m.Project?.Student?.FullName</span>
                                        <span class="text-muted mx-1">&bull;</span>
                                        <span class="text-muted fs-7"><i class="far fa-clock me-1"></i> Submitted: @(m.SubmittedDate?.ToString("dd MMM yyyy") ?? "Recently")</span>
                                    </div>
                                </div>
                                <a href="/Supervisor/ReviewSubmissions" class="btn btn-sm btn-monochrome px-3">Review</a>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Recent Project Requests -->
            <div class="premium-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center p-4 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-user-plus me-2 text-muted"></i>Recent Project Requests</h5>
                    <a href="/Supervisor/StudentRequests" class="btn btn-sm btn-outline-monochrome rounded-pill px-3">View All</a>
                </div>

                @if (!recentRequests.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-users-slash fs-1 mb-3" style="color: #e2e8f0;"></i>
                        <p class="mb-0">No new student requests at the moment.</p>
                    </div>
                }
                else
                {
                    <div>
                        @foreach (var req in recentRequests)
                        {
                            <div class="list-item-clean d-flex align-items-center gap-3">
                                <div class="avatar-circle-sm">
                                    @(req.Student?.FullName?[0] ?? 'S')
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark">@req.Student?.FullName</div>
                                    <div class="text-muted fs-7 mt-1">Requested on @req.RequestedDate.ToString("dd MMM yyyy")</div>
                                </div>
                                <a href="/Supervisor/StudentRequests" class="btn btn-sm btn-outline-monochrome px-3">Evaluate</a>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        @* RIGHT COLUMN: Sidebar *@
        <div class="col-lg-5">
            
            <!-- Upcoming Defenses -->
            @if (upcomingDefenses.Any())
            {
                <div class="premium-card mb-4 shadow-sm" style="border-left: 6px solid #e11d48 !important; background-color: #fff1f2;">
                    <div class="p-4 border-bottom border-danger bg-white" style="border-radius: 10px 10px 0 0;">
                        <h5 class="fw-bold mb-0 text-danger"><i class="fas fa-shield-alt me-2"></i>Scheduled Student Defenses</h5>
                    </div>
                    <div class="p-0">
                        @foreach (var defense in upcomingDefenses)
                        {
                            <div class="list-item-clean">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="avatar-circle-sm bg-danger text-white me-3">
                                        @(defense.Project?.Student?.FullName?.Substring(0, 1) ?? "S")
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">@(defense.Project?.Student?.FullName ?? "Unknown Student")</h6>
                                        <div class="small text-muted">@defense.Title</div>
                                    </div>
                                </div>
                                <div class="bg-white rounded p-3 mt-2 border">
                                    <div class="d-flex align-items-center text-dark fw-bold mb-1">
                                        <i class="far fa-calendar-alt text-danger me-2"></i>
                                        @(defense.DefenseDate?.ToString("dd MMMM yyyy"))
                                    </div>
                                    <div class="d-flex align-items-center text-dark fw-bold mb-1">
                                        <i class="far fa-clock text-danger me-2"></i>
                                        @defense.DefenseTime
                                    </div>
                                    <div class="d-flex align-items-start text-dark mt-2 fw-bold">
                                        <i class="fas fa-map-marker-alt text-danger me-2 mt-1"></i>
                                        <span style="line-height: 1.4;">
                                            @if (!string.IsNullOrEmpty(defense.DefenseVenue) && defense.DefenseVenue.Contains("http"))
                                            {
                                                <a href="@defense.DefenseVenue.Substring(defense.DefenseVenue.IndexOf("http"))" target="_blank" class="text-primary text-decoration-underline">Join Online Defense Meeting</a>
                                            }
                                            else
                                            {
                                                @defense.DefenseVenue
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Upcoming Meetings Agenda -->
            <div class="premium-card mb-4 shadow-sm">
                <div class="p-4 border-bottom bg-light" style="border-radius: 16px 16px 0 0;">
                    <h5 class="fw-bold mb-0 text-dark"><i class="far fa-calendar-alt me-2"></i>Upcoming Agenda</h5>
                </div>
                
                @if (!nextMeetings.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="far fa-calendar-times fs-1 mb-3" style="color: #e2e8f0;"></i>
                        <p class="mb-0">Your schedule is clear.</p>
                    </div>
                }
                else
                {
                    <div class="p-3">
                        @foreach (var m in nextMeetings)
                        {
                            <div class="d-flex align-items-stretch gap-3 mb-3 pb-3 border-bottom border-light">
                                <div class="text-center rounded-3 bg-light border p-2 d-flex flex-column justify-content-center" style="min-width: 65px;">
                                    <span class="fs-4 fw-bolder text-dark" style="line-height: 1;">@m.MeetingDate.Day</span>
                                    <span class="fs-7 text-uppercase text-muted fw-bold">@m.MeetingDate.ToString("MMM")</span>
                                </div>
                                <div class="flex-grow-1 d-flex flex-column justify-content-center">
                                    <div class="fw-bold text-dark fs-6 mb-1">@m.Student?.FullName</div>
                                    <div class="text-muted fs-7 d-flex align-items-center gap-2">
                                        <span><i class="far fa-clock me-1"></i> @m.MeetingTime</span>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="text-center mt-2">
                            <a href="/Supervisor/ManageMeetings" class="text-decoration-none text-muted fw-semibold fs-7 hover-primary">View Full Schedule &rarr;</a>
                        </div>
                    </div>
                }
            </div>

            <!-- Quick Links -->
            <div class="premium-card shadow-sm">
                <div class="p-4">
                    <h5 class="fw-bold mb-4 text-dark"><i class="fas fa-bolt me-2 text-muted"></i>Quick Shortcuts</h5>
                    <div class="d-grid gap-3">
                        <a href="/Supervisor/MyProjects" class="btn btn-outline-monochrome text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                            <span><i class="fas fa-users me-3 text-muted"></i> Manage Supervised Projects</span>
                            <i class="fas fa-chevron-right text-muted opacity-50"></i>
                        </a>
                        <a href="/Chat" class="btn btn-outline-monochrome text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                            <span><i class="far fa-comments me-3 text-muted"></i> Student Messaging</span>
                            <i class="fas fa-chevron-right text-muted opacity-50"></i>
                        </a>
                        <a href="/Supervisor/ReviewSubmissions" class="btn btn-outline-monochrome text-start p-3 rounded-3 d-flex align-items-center justify-content-between">
                            <span><i class="fas fa-file-signature me-3 text-muted"></i> Review Milestones</span>
                            <i class="fas fa-chevron-right text-muted opacity-50"></i>
                        </a>
                    </div>
                </div>
            </div>

    </div>



</div>

