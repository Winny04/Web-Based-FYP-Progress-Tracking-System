@model FYPTracker.Models.FYPProject
@{
    ViewData["Title"] = "Stage 1 Proposal Assessment";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var stage1Milestone = FYPTracker.Utils.GradingHelper.GetStage1FinalMilestone(Model.Milestones);
    var proposalFile = stage1Milestone?.SubmissionFiles?.Where(f => !f.IsDeleted).OrderByDescending(f => f.UploadedDate).FirstOrDefault();
    var existingMarks = stage1Milestone?.SupervisorMarksheetData ?? "";
    bool isDraft = FYPTracker.Utils.GradingHelper.IsMarksheetDraft(existingMarks);
    bool isFinalized = !string.IsNullOrEmpty(existingMarks) && !isDraft;
}

<div class="d-flex flex-column h-100" style="background: #f8fafc; min-height: calc(100vh - 100px);">
    <div class="p-4 bg-white border-bottom d-flex justify-content-between align-items-center shadow-sm">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="fas fa-file-alt text-primary me-2"></i> Stage 1 Proposal Assessment</h3>
            <p class="mb-0 text-muted">
                Candidate: <span class="fw-bold text-dark">@Model.Student?.FullName</span> | 
                Project: <span class="fw-bold text-dark">@Model.Title</span>
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (isFinalized)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold">
                    <i class="fas fa-check-circle me-1"></i> Finalized
                </span>
            }
            else if (isDraft)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-bold">
                    <i class="fas fa-edit me-1"></i> Draft Saved
                </span>
            }
            <a href="@Url.Action("ProjectDetails", "Supervisor", new { id = Model.Id })" class="btn btn-outline-secondary rounded-pill px-4"><i class="fas fa-arrow-left me-2"></i>Back</a>
        </div>
    </div>

    <div class="row g-0 flex-grow-1">
        <!-- PDF Viewer (Left Side) -->
        <div class="col-lg-6 border-end bg-dark">
            @if (proposalFile != null)
            {
                <iframe src="@proposalFile.FilePath" style="width: 100%; height: calc(100vh - 180px); border: none;" allowfullscreen></iframe>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center h-100 text-white flex-column">
                    <i class="fas fa-file-pdf fa-4x mb-3 text-secondary"></i>
                    <h5>No proposal document uploaded</h5>
                </div>
            }
        </div>

        <!-- Evaluation Form (Right Side) -->
        <div class="col-lg-6 bg-white overflow-auto" style="height: calc(100vh - 180px);">
            <div class="p-4 p-xl-5">
                <form asp-controller="Supervisor" asp-action="GradeMarksheetStage1" method="post" id="marksheetForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <input type="hidden" name="marksheetData" id="marksheetData" value="@existingMarks" />
                    <input type="hidden" name="isDraft" id="isDraftInput" value="false" />

                    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                        <div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-8 fw-bold text-uppercase">
                                <i class="fas fa-graduation-cap me-1"></i> Stage 1 Supervisor Evaluation
                            </span>
                        </div>
                        <div class="text-muted small">
                            Role: <span class="fw-bold text-dark">Supervisor</span> &bull; 6 Official Criteria (0–4 Scale)
                        </div>
                    </div>

                    <!-- 1. Report Format (10 marks) -->
                    <div class="card border border-light-subtle shadow-sm rounded-3 mb-4 criterion-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="fw-bold fs-6 text-dark mb-0">1. Report Format</label>
                                <span class="badge bg-dark fs-7 px-3 py-2 rounded-pill" id="valCrit1">0/10</span>
                            </div>
                            <p class="text-muted small mb-3">Organization, flow of ideas, structural formatting, appropriate writing style, figures and tables referenced.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <input type="range" class="form-range custom-range w-75" min="0" max="4" step="1" id="scoreCrit1" oninput="updateScore('Crit1')">
                                <span class="badge bg-light text-dark border ms-3 px-3 py-2" id="weightCrit1">Weight: 0/4</span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Introduction (20 marks) -->
                    <div class="card border border-light-subtle shadow-sm rounded-3 mb-4 criterion-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="fw-bold fs-6 text-dark mb-0">2. Introduction</label>
                                <span class="badge bg-dark fs-7 px-3 py-2 rounded-pill" id="valCrit2">0/20</span>
                            </div>
                            <p class="text-muted small mb-3">Problem statement clarity, project objectives feasibility, scope definition, and significance of the study.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <input type="range" class="form-range custom-range w-75" min="0" max="4" step="1" id="scoreCrit2" oninput="updateScore('Crit2')">
                                <span class="badge bg-light text-dark border ms-3 px-3 py-2" id="weightCrit2">Weight: 0/4</span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Literature Review (30 marks) -->
                    <div class="card border border-light-subtle shadow-sm rounded-3 mb-4 criterion-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="fw-bold fs-6 text-dark mb-0">3. Literature Review</label>
                                <span class="badge bg-dark fs-7 px-3 py-2 rounded-pill" id="valCrit3">0/30</span>
                            </div>
                            <p class="text-muted small mb-3">Theoretical concepts, concise in-depth critical review of previous works, gap identification, and significance.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <input type="range" class="form-range custom-range w-75" min="0" max="4" step="1" id="scoreCrit3" oninput="updateScore('Crit3')">
                                <span class="badge bg-light text-dark border ms-3 px-3 py-2" id="weightCrit3">Weight: 0/4</span>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Methodology (20 marks) -->
                    <div class="card border border-light-subtle shadow-sm rounded-3 mb-4 criterion-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="fw-bold fs-6 text-dark mb-0">4. Methodology</label>
                                <span class="badge bg-dark fs-7 px-3 py-2 rounded-pill" id="valCrit4">0/20</span>
                            </div>
                            <p class="text-muted small mb-3">Description of methods in convincing detail to achieve objectives, clear design decisions and justifications.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <input type="range" class="form-range custom-range w-75" min="0" max="4" step="1" id="scoreCrit4" oninput="updateScore('Crit4')">
                                <span class="badge bg-light text-dark border ms-3 px-3 py-2" id="weightCrit4">Weight: 0/4</span>
                            </div>
                        </div>
                    </div>

                    <!-- 5. References and Citation (10 marks) -->
                    <div class="card border border-light-subtle shadow-sm rounded-3 mb-4 criterion-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="fw-bold fs-6 text-dark mb-0">5. References &amp; Citation</label>
                                <span class="badge bg-dark fs-7 px-3 py-2 rounded-pill" id="valCrit5">0/10</span>
                            </div>
                            <p class="text-muted small mb-3">Quality, completeness, and accuracy of citations, proper reference list formatting.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <input type="range" class="form-range custom-range w-75" min="0" max="4" step="1" id="scoreCrit5" oninput="updateScore('Crit5')">
                                <span class="badge bg-light text-dark border ms-3 px-3 py-2" id="weightCrit5">Weight: 0/4</span>
                            </div>
                        </div>
                    </div>

                    <!-- 6. Ethics & Lifelong Learning & Sustainability Impact (10 marks) -->
                    <div class="card border border-light-subtle shadow-sm rounded-3 mb-4 criterion-card">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="fw-bold fs-6 text-dark mb-0">6. Ethics &amp; Lifelong Learning &amp; Sustainability</label>
                                <span class="badge bg-dark fs-7 px-3 py-2 rounded-pill" id="valCrit6">0/10</span>
                            </div>
                            <p class="text-muted small mb-3">Ethical considerations, creative problem-solving from prior knowledge, sustainability impact, FYP exhibition participation.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <input type="range" class="form-range custom-range w-75" min="0" max="4" step="1" id="scoreCrit6" oninput="updateScore('Crit6')">
                                <span class="badge bg-light text-dark border ms-3 px-3 py-2" id="weightCrit6">Weight: 0/4</span>
                            </div>
                        </div>
                    </div>

                    <!-- Feedback Fields (Matching Excel rows 19, 22, 25) -->
                    <div class="card border border-light-subtle shadow-sm rounded-3 mb-4">
                        <div class="card-body p-4">
                            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-comment-alt text-primary me-2"></i>Qualitative Feedback &amp; Remarks</h6>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small">Strengths of Proposal</label>
                                <textarea class="form-control bg-light" id="strengthsText" rows="3" placeholder="Highlight key strengths of the proposal..."></textarea>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold text-dark small">Areas for Improvement</label>
                                <textarea class="form-control bg-light" id="improvementsText" rows="3" placeholder="Specify areas needing remediation or refinement..."></textarea>
                            </div>
                            
                            <div class="mb-0">
                                <label class="form-label fw-bold text-dark small">Additional Comments</label>
                                <textarea class="form-control bg-light" id="commentsText" rows="3" placeholder="Any further guidance for the student..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top gap-3">
                        <div class="fs-4 fw-bold text-dark">
                            Total Score: <span id="totalScore" class="text-primary">0</span><span class="text-muted fs-5">/100</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary px-4 rounded-pill shadow-sm fw-bold" onclick="saveDraft()">
                                <i class="fas fa-save me-1"></i> Save Draft
                            </button>
                            <button type="button" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm fw-bold d-flex align-items-center" onclick="confirmSubmission()">
                                <i class="fas fa-check-double me-2"></i> Final Submit
                            </button>
                        </div>
                    </div>

                    <!-- Confirmation Modal -->
                    <div class="modal fade" id="submitConfirmModal" tabindex="-1" aria-labelledby="submitConfirmModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header bg-light">
                                    <h5 class="modal-title fw-bold text-dark" id="submitConfirmModalLabel"><i class="fas fa-check-circle text-primary me-2"></i>Confirm Stage 1 Proposal Evaluation</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <p class="mb-3 text-dark">Are you sure you want to finalize Stage 1 marks for <strong class="text-primary">@Model.Student?.FullName</strong>?</p>
                                    <div class="p-3 bg-light rounded-3 border mb-3">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted small">Supervisor Total Score:</span>
                                            <span class="fw-bold text-dark" id="modalConfirmTotal">0/100</span>
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-0"><i class="fas fa-info-circle me-1"></i>Once finalized, your marks will be recorded. The final Stage 1 outcome (Pass/Fail) will be calculated once the Examiner also finalizes their assessment.</p>
                                </div>
                                <div class="modal-footer bg-light">
                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                    <button type="button" class="btn btn-primary rounded-pill px-4" id="modalConfirmSubmitBtn" onclick="executeSubmit(false)">Confirm &amp; Final Submit</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-range::-webkit-slider-thumb {
        background: #0f172a;
        width: 24px;
        height: 24px;
        border: 4px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
    .custom-range::-webkit-slider-runnable-track {
        background: #cbd5e1;
        height: 8px;
        border-radius: 4px;
    }
    .criterion-card {
        transition: box-shadow 0.2s ease-in-out;
    }
    .criterion-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }
</style>

@section Scripts {
    <script>
        const fullMarks = { Crit1: 10, Crit2: 20, Crit3: 30, Crit4: 20, Crit5: 10, Crit6: 10 };

        // Init scores from existing data if any
        let existing = document.getElementById('marksheetData').value;
        if (existing) {
            try {
                let data = JSON.parse(existing);
                document.getElementById('scoreCrit1').value = data.Crit1 ?? 0;
                document.getElementById('scoreCrit2').value = data.Crit2 ?? 0;
                document.getElementById('scoreCrit3').value = data.Crit3 ?? 0;
                document.getElementById('scoreCrit4').value = data.Crit4 ?? 0;
                document.getElementById('scoreCrit5').value = data.Crit5 ?? 0;
                document.getElementById('scoreCrit6').value = data.Crit6 ?? 0;
                if (document.getElementById('strengthsText')) document.getElementById('strengthsText').value = data.Strengths ?? "";
                if (document.getElementById('improvementsText')) document.getElementById('improvementsText').value = data.Improvements ?? "";
                if (document.getElementById('commentsText')) document.getElementById('commentsText').value = data.Comments ?? "";
            } catch(e) {}
        }

        function formatScore(val) {
            let rounded = Math.round(val * 100) / 100;
            if (rounded % 1 === 0) return rounded.toString();
            return (Math.round(rounded * 10) / 10 === rounded) ? rounded.toFixed(1) : rounded.toFixed(2);
        }

        function updateScore(category, updateAvg = true) {
            let weight = parseInt(document.getElementById('score' + category).value) || 0;
            if (document.getElementById('weight' + category)) {
                document.getElementById('weight' + category).innerText = "Weight: " + weight + "/4";
            }
            
            let fullMark = fullMarks[category];
            let score = (weight / 4.0) * fullMark;
            
            document.getElementById('val' + category).innerText = formatScore(score) + "/" + fullMark;
            
            if (updateAvg) calculateTotal();
        }

        function calculateTotal() {
            let total = 0;
            ['Crit1', 'Crit2', 'Crit3', 'Crit4', 'Crit5', 'Crit6'].forEach(cat => {
                let weight = parseInt(document.getElementById('score' + cat).value) || 0;
                total += (weight / 4.0) * fullMarks[cat];
            });
            
            document.getElementById('totalScore').innerText = formatScore(total);
        }

        function saveDraft() {
            executeSubmit(true);
        }

        function confirmSubmission() {
            let form = document.getElementById('marksheetForm');
            if (!form.reportValidity()) {
                return;
            }

            let totalText = document.getElementById('totalScore').innerText;
            document.getElementById('modalConfirmTotal').innerText = totalText + "/100";

            let modalEl = document.getElementById('submitConfirmModal');
            let modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        function executeSubmit(isDraft) {
            let confirmBtn = document.getElementById('modalConfirmSubmitBtn');
            if (confirmBtn && !isDraft) {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Submitting...';
            }

            let data = {
                Version: 2,
                Scale: "Rubric0-4",
                IsDraft: isDraft,
                Crit1: document.getElementById('scoreCrit1').value,
                Crit2: document.getElementById('scoreCrit2').value,
                Crit3: document.getElementById('scoreCrit3').value,
                Crit4: document.getElementById('scoreCrit4').value,
                Crit5: document.getElementById('scoreCrit5').value,
                Crit6: document.getElementById('scoreCrit6').value,
                Strengths: document.getElementById('strengthsText') ? document.getElementById('strengthsText').value : "",
                Improvements: document.getElementById('improvementsText') ? document.getElementById('improvementsText').value : "",
                Comments: document.getElementById('commentsText') ? document.getElementById('commentsText').value : "",
                Score: document.getElementById('totalScore').innerText,
                Total: document.getElementById('totalScore').innerText
            };

            document.getElementById('isDraftInput').value = isDraft ? "true" : "false";
            document.getElementById('marksheetData').value = JSON.stringify(data);
            document.getElementById('marksheetForm').submit();
        }
        
        // Initial setup
        calculateTotal();
        ['Crit1', 'Crit2', 'Crit3', 'Crit4', 'Crit5', 'Crit6'].forEach(cat => updateScore(cat, false));
    </script>
}
