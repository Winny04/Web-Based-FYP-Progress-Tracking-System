@model FYPTracker.Models.FYPMilestone
@using FYPTracker.Models
@using FYPTracker.ViewModels
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@inject FYPTrackerContext _context

@{
    ViewData["Title"] = "View IAF";
    Layout = null;

    // Never load the *current* Admin template for a historical attempt.
    // A saved per-attempt snapshot preserves exactly the form definition
    // used for that attempt. Attempts from before snapshot support use
    // their original legacy layout.
    string raw = Model.Remarks ?? "";
    int jsonIndex = raw.IndexOf("JSON: ", StringComparison.Ordinal);
    string parsedJson = jsonIndex >= 0
        ? raw.Substring(jsonIndex + "JSON: ".Length)
        : raw;
    var history = IafAttemptHistory.ParseOrMigrate(parsedJson);

    int.TryParse(Convert.ToString(ViewData["AttemptNumber"]), out int requestedAttemptNumber);
    var attempt = history.Attempts.FirstOrDefault(a => a.AttemptNumber == requestedAttemptNumber);
    var formData = attempt?.FormData ?? new Dictionary<string, string>();
    string Fv(string key) => formData.TryGetValue(key, out var value) ? value ?? "" : "";
    bool isSigned = !string.IsNullOrWhiteSpace(attempt?.SupervisorSignature);
    string signature = attempt?.SupervisorSignature ?? "";
    bool isSafeImageSignature =
        signature.StartsWith("data:image/png;base64,", StringComparison.OrdinalIgnoreCase) ||
        signature.StartsWith("data:image/jpeg;base64,", StringComparison.OrdinalIgnoreCase) ||
        signature.StartsWith("data:image/webp;base64,", StringComparison.OrdinalIgnoreCase);

    MeetingRecordTemplateVM? viewTemplate = null;
    if (formData.TryGetValue("__iafTemplateSnapshot", out var snapshotJson)
        && !string.IsNullOrWhiteSpace(snapshotJson))
    {
        try
        {
            viewTemplate = JsonSerializer.Deserialize<MeetingRecordTemplateVM>(
                snapshotJson,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (viewTemplate?.Fields == null || viewTemplate.Fields.Count == 0)
                viewTemplate = null;
        }
        catch (JsonException)
        {
            // Malformed snapshot: render the original legacy layout instead
            // of silently substituting a different Admin template version.
            viewTemplate = null;
        }
    }

    var orderedFields = viewTemplate?.Fields.OrderBy(f => f.Order).ToList();
    string moduleLeaderName = "Admin";
    if (viewTemplate == null)
    {
        var adminUser = _context.ApplicationUsers
            .FirstOrDefault(u => u.UserRoles.Any(r => r.Role.Name == "Admin"));
        moduleLeaderName = adminUser?.FullName ?? "Admin";
    }
    string documentTitle = viewTemplate?.Title ?? "Initial Project Allocation Form";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@documentTitle — Attempt @requestedAttemptNumber</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        body { background: #f8fafc; color: #1e293b; }
        .iaf-view-page { max-width: 1100px; margin: 0 auto; }
        .iaf-document-card { border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
        .iaf-field-label { color: #334155; font-size: 14px; font-weight: 600; margin-bottom: 7px; overflow-wrap: anywhere; }
        .iaf-field-value { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; min-height: 42px; padding: 12px 14px; white-space: pre-wrap; overflow-wrap: anywhere; }
        .iaf-readonly-table { width: 100%; table-layout: fixed; border-collapse: collapse; }
        .iaf-readonly-table td { border: 1px solid #e2e8f0; padding: 14px 16px; vertical-align: middle; overflow-wrap: anywhere; font-size: 14px; }
        .iaf-readonly-table .iaf-label { width: 32%; background: #f8fafc; font-weight: 600; color: #334155; }
        .iaf-readonly-table .iaf-value { width: 68%; white-space: pre-wrap; }
        .signature-image { max-height: 90px; max-width: 250px; object-fit: contain; }
        @@page { size: A4 portrait; margin: 15mm; }
        @@media (max-width: 767.98px) {
            .iaf-readonly-table td { padding: 10px; font-size: 13px; }
            .iaf-readonly-table .iaf-label { width: 40%; }
            .iaf-readonly-table .iaf-value { width: 60%; }
        }
        @@media print {
            .no-print { display: none !important; }
            body { background: white !important; }
            .iaf-view-page { max-width: 100% !important; }
            .iaf-document-card { border: none !important; box-shadow: none !important; }
            .iaf-readonly-table tr, .iaf-field { break-inside: avoid; page-break-inside: avoid; }
            .iaf-field-value { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
            iframe { display: none !important; }
        }
    </style>
</head>
<body>
<div class="container-xxl px-3 px-md-4 py-4">
    <div class="iaf-view-page">
        <div class="d-flex justify-content-end mb-3 no-print">
            <button type="button" class="btn btn-primary fw-semibold px-4 py-2"
                    onclick="window.print()">
                <i class="fas fa-file-pdf me-2"></i>Print / Save as PDF
            </button>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-4 no-print"
             style="background-color: #0f172a; color: white;">
            <div class="card-body p-4">
                <h4 class="fw-bold text-white mb-2">
                    <i class="fas fa-file-contract me-2"></i>Initial Project Allocation Form
                </h4>
                <p class="text-white-50 mb-0">
                    Read-only IAF Submission — Attempt @requestedAttemptNumber
                </p>
            </div>
        </div>

        @if (attempt == null)
        {
            <div class="alert alert-warning">The requested IAF attempt could not be found.</div>
        }
        else
        {
            <div class="card bg-white shadow-sm iaf-document-card">
                <div class="card-header bg-white py-4">
                    <h5 class="fw-bold text-dark mb-1">@documentTitle</h5>
                    <div class="text-muted small">
                        6000CEM / 6002CMD · Attempt @attempt.AttemptNumber
                        @if (viewTemplate != null)
                        {
                            <span> · Template Version @viewTemplate.Version</span>
                        }
                        else
                        {
                            <span> · Legacy Attempt Layout</span>
                        }
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (orderedFields != null)
                    {
                        <div class="row g-3">
                            @foreach (var field in orderedFields)
                            {
                                int width = field.Columns >= 1 && field.Columns <= 12 ? field.Columns : 12;
                                int minHeight = field.MinHeightMm > 0 ? field.MinHeightMm : 0;
                                <div class="col-12 col-md-@(width) iaf-field"
                                     data-field-key="@field.Key">
                                    <div class="iaf-field-label">@field.Label</div>

                                    @if (field.Key == "SupervisorSignature")
                                    {
                                        <div class="iaf-field-value" style="min-height:@(Math.Max(minHeight,20))mm;">
                                            @if (!isSigned)
                                            {
                                                <span class="text-muted fst-italic">Not signed</span>
                                            }
                                            else if (isSafeImageSignature)
                                            {
                                                <img src="@signature" alt="Supervisor Signature" class="signature-image" />
                                            }
                                            else
                                            {
                                                <span class="fst-italic text-primary">@signature</span>
                                            }
                                        </div>
                                    }
                                    else if (field.Key == "Objectives")
                                    {
                                        <div class="iaf-field-value" style="min-height:@(minHeight)mm;">
                                            <div>@Fv("obj1")</div>
                                            <div>@Fv("obj2")</div>
                                            @if (!string.IsNullOrWhiteSpace(Fv("obj3")))
                                            {
                                                <div>@Fv("obj3")</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        string value = field.Key switch
                                        {
                                            "StudentName" => !string.IsNullOrWhiteSpace(Fv("studentName"))
                                                ? Fv("studentName") : Model.Project?.Student?.FullName ?? "",
                                            "CoventryId" => !string.IsNullOrWhiteSpace(Fv("coventryId"))
                                                ? Fv("coventryId") : Model.Project?.Student?.CoventryId ?? "",
                                            "Program" => !string.IsNullOrWhiteSpace(Fv("program"))
                                                ? Fv("program") : Model.Project?.Student?.Programme ?? "",
                                            "ProjectTitle" => Fv("title"),
                                            "ScopeOfProject" => Fv("scope"),
                                            "ProblemStatement" => Fv("problem"),
                                            "References" => Fv("references"),
                                            "SupervisorName" => Fv("agreedSupervisor"),
                                            "CommentFeedback" => attempt.SupervisorFeedback ?? "",
                                            _ => ""
                                        };
                                        <div class="iaf-field-value"
                                             style="min-height:@(field.Type == "TextArea" ? Math.Max(minHeight, 15) : minHeight)mm;">@value</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Important: no snapshot exists for older attempts.
                           Keep original field titles and order; do NOT apply
                           the latest Admin JSON to already-signed records. *@
                        <div class="table-responsive">
                            <table class="iaf-readonly-table">
                                <tr><td class="iaf-label">Student Name</td><td class="iaf-value">@Model.Project?.Student?.FullName</td></tr>
                                <tr><td class="iaf-label">Coventry ID</td><td class="iaf-value">@Model.Project?.Student?.CoventryId</td></tr>
                                <tr><td class="iaf-label">INTI ID</td><td class="iaf-value">@Model.Project?.Student?.EmployeeId</td></tr>
                                <tr><td class="iaf-label">Course Code</td><td class="iaf-value">6002CMD</td></tr>
                                <tr><td class="iaf-label">Module Leader Name</td><td class="iaf-value">@moduleLeaderName</td></tr>
                                <tr><td class="iaf-label">Project Title</td><td class="iaf-value">@Fv("title")</td></tr>
                                <tr><td class="iaf-label">Scope of Project</td><td class="iaf-value">@Fv("scope")</td></tr>
                                <tr><td class="iaf-label">Problem Statement</td><td class="iaf-value">@Fv("problem")</td></tr>
                                <tr><td class="iaf-label">Objective 1</td><td class="iaf-value">@Fv("obj1")</td></tr>
                                <tr><td class="iaf-label">Objective 2</td><td class="iaf-value">@Fv("obj2")</td></tr>
                                <tr><td class="iaf-label">Objective 3</td><td class="iaf-value">@Fv("obj3")</td></tr>
                                <tr><td class="iaf-label">Agreed Supervisor Name</td><td class="iaf-value">@Fv("agreedSupervisor")</td></tr>
                                <tr><td class="iaf-label">Supervisor's Name</td><td class="iaf-value">@Model.Project?.Supervisor?.FullName</td></tr>
                                <tr>
                                    <td class="iaf-label">Supervisor's Signature</td>
                                    <td class="iaf-value">
                                        @if (!isSigned)
                                        {
                                            <span class="text-muted fst-italic">Not signed</span>
                                        }
                                        else if (isSafeImageSignature)
                                        {
                                            <img src="@signature" alt="Supervisor Signature" class="signature-image" />
                                        }
                                        else
                                        {
                                            <span class="fst-italic text-primary">@signature</span>
                                        }
                                    </td>
                                </tr>
                                <tr><td class="iaf-label">Comment / Feedback</td><td class="iaf-value">@attempt.SupervisorFeedback</td></tr>
                            </table>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(attempt.PanelComments))
                    {
                        <div class="mt-4">
                            <div class="iaf-field-label">Panel Comments</div>
                            <div class="iaf-field-value">@attempt.PanelComments</div>
                        </div>
                    }


                </div>
            </div>
        }
    </div>
</div>
</body>
</html>
