@using FYPTracker.Models
@model IEnumerable<FYPMilestone>
@{
    ViewData["Title"] = "Review Submissions";
}

<style>
    :root { --purple-grad: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); }

    .page-hero {
        background: var(--purple-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(139, 92, 246, 0.25);
    }
</style>

<div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white"><i class="fas fa-clipboard-check me-2"></i>Review Submissions</h2>
        <p class="mb-0 text-white opacity-75">Review and grade milestones submitted by your students.</p>
    </div>
    <div>
        <div class="d-flex align-items-center position-relative my-1">
            <i class="fas fa-filter position-absolute ms-3 text-muted"></i>
            <select id="milestoneFilter" class="form-select border-0 shadow-sm ps-10 w-250px" style="border-radius: 10px;">
                <option value="">All Milestones</option>
                @foreach (var title in Model.Select(m => m.Title).Distinct().OrderBy(t => t))
                {
                    <option value="@title">@title</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="card mb-5 mb-xl-8 border-0 shadow-sm" style="border-radius: 16px;">
    <div class="card-body py-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-4">@TempData["Success"]</div>
        }

        <div class="table-responsive">
            <table class="table align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted bg-light">
                        <th class="ps-4 min-w-200px">Milestone</th>
                        <th class="min-w-120px">Due Date</th>
                        <th class="min-w-120px">Date Submitted</th>
                        <th class="min-w-150px">Files</th>
                        <th class="min-w-120px">Status</th>
                        <th class="text-end min-w-120px pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var groupedMilestones = Model.GroupBy(m => m.Project).Where(g => g.Key != null).ToList();
                    }
                    @foreach (var group in groupedMilestones)
                    {
                        var project = group.Key;
                        var student = project?.Student;

                        <tr class="bg-light-primary student-group" data-project-id="@project?.Id">
                            <td colspan="6" class="ps-4 py-3 border-bottom border-primary">
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-40px me-3">
                                        <span class="symbol-label bg-primary text-inverse-primary fw-bolder">@(student?.FullName?.FirstOrDefault() ?? '?')</span>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark fw-bolder fs-5">@student?.FullName</span>
                                        <span class="text-muted fw-bold fs-7">@project?.Title</span>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        @foreach (var ms in group.OrderBy(m => m.DueDate ?? DateTime.MaxValue))
                        {
                            <tr class="milestone-item" data-project-id="@project?.Id" data-milestone-title="@ms.Title">
                                <td class="ps-4">
                                    <span class="text-dark fw-bolder d-block fs-6">@ms.Title</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold d-block fs-6">@(ms.DueDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold d-block fs-6">@(ms.SubmittedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</span>
                                </td>
                                <td>
                                    @if (ms.SubmissionFiles != null && ms.SubmissionFiles.Any())
                                    {
                                        @foreach(var f in ms.SubmissionFiles)
                                        {
                                            <div class="d-inline-flex align-items-center mb-1">
                                                <a href="@f.FilePath" download class="badge badge-light-primary"><i class="fas fa-file-download me-1 text-primary"></i> @f.FileName</a>
                                                <a href="@f.FilePath" target="_blank" class="btn btn-icon btn-active-light-primary w-20px h-20px ms-1" title="Preview in new tab">
                                                    <i class="fas fa-external-link-alt text-info" style="font-size: 0.85rem;"></i>
                                                </a>
                                            </div><br/>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7">-</span>
                                    }
                                </td>
                                <td>
                                    @if (ms.Status == "Submitted" || ms.Status == "UnderReview")
                                    {
                                        <span class="badge badge-light-warning">Under Review</span>
                                    }
                                    else if (ms.Status == "Approved")
                                    {
                                        <span class="badge badge-light-success">Approved</span>
                                    }
                                    else if (ms.Status == "Pending")
                                    {
                                        <span class="badge badge-light-secondary">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light-danger">Rejected / Revise</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light-primary" data-bs-toggle="modal" data-bs-target="#reviewModal_@ms.Id">Grade</button>


                                <!-- Review Modal -->
                                <div class="modal fade" id="reviewModal_@ms.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content text-start">
                                            <form asp-action="ReviewSubmission" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Grade Submission: @ms.Title</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <input type="hidden" name="milestoneId" value="@ms.Id" />
                                                    
                                                    @{
                                                        string raw = ms.Remarks ?? "";
                                                        string parsedJson = "";
                                                        string formInfo = "";
                                                        if (raw.Contains("JSON: ")) {
                                                            var parts = raw.Split(new[] { "JSON: " }, StringSplitOptions.None);
                                                            formInfo = parts[0].Trim();
                                                            parsedJson = parts[1];
                                                        }
                                                    }
                                                    
                                                    @if (!string.IsNullOrEmpty(formInfo))
                                                    {
                                                        <div class="alert alert-primary bg-light-primary border-primary border-dashed d-flex align-items-center p-3 mb-4">
                                                            <i class="fas fa-info-circle fs-3 text-primary me-3"></i>
                                                            <div class="d-flex flex-column">
                                                                <span class="fw-bold text-dark">Submission Information</span>
                                                                <span class="text-muted" style="font-size: 0.9rem;">@formInfo</span>
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (!string.IsNullOrEmpty(parsedJson))
                                                    {
                                                        <div class="mb-5 p-4 bg-light rounded-4 border border-secondary border-opacity-25 shadow-sm">
                                                            <h6 class="fw-bold text-primary mb-3"><i class="fas fa-file-alt me-2"></i>Form Details</h6>
                                                            @{
                                                                try {
                                                                    var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(parsedJson);
                                                                    if (dict != null) {
                                                                        <table class="table table-sm table-borderless m-0" style="font-size: 0.9rem;">
                                                                        @foreach (var kvp in dict) {
                                                                            if (!string.IsNullOrEmpty(kvp.Value)) {
                                                                                <tr>
                                                                                    <td class="fw-bold text-muted" style="width: 140px; vertical-align: top;">@kvp.Key:</td>
                                                                                    <td class="text-dark fw-semibold" style="white-space: pre-wrap;">@kvp.Value</td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                        </table>
                                                                    }
                                                                } catch {
                                                                    <div class="text-muted small" style="white-space: pre-wrap;">@parsedJson</div>
                                                                }
                                                            }
                                                        </div>
                                                    }

                                                    <div class="mb-5">
                                                        <label class="form-label fw-bold">Decision</label>
                                                        <select name="status" class="form-select form-select-solid" required>
                                                            <option value="">- Select -</option>
                                                            <option value="Approved" selected="@(ms.Status == "Approved")">Approve (Passed)</option>
                                                            <option value="Rejected" selected="@(ms.Status == "Rejected")">Reject (Needs Revision)</option>
                                                            <option value="UnderReview" selected="@(ms.Status == "UnderReview")">Mark as Under Review</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Feedback / Remarks</label>
                                                        <textarea name="remarks" class="form-control form-control-solid" rows="4" placeholder="Write feedback for the student here...">@ms.SupervisorFeedback</textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Save Review</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        }
                    }
                    @if (!groupedMilestones.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No student submissions found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filter = document.getElementById('milestoneFilter');
            if (filter) {
                filter.addEventListener('change', function() {
                    const selected = this.value;
                    const items = document.querySelectorAll('.milestone-item');
                    const groups = document.querySelectorAll('.student-group');
                    
                    const visibleGroups = new Set();

                    items.forEach(item => {
                        if (!selected || item.getAttribute('data-milestone-title') === selected) {
                            item.style.display = '';
                            visibleGroups.add(item.getAttribute('data-project-id'));
                        } else {
                            item.style.display = 'none';
                        }
                    });

                    groups.forEach(group => {
                        if (visibleGroups.has(group.getAttribute('data-project-id'))) {
                            group.style.display = '';
                        } else {
                            group.style.display = 'none';
                        }
                    });
                });
            }

            const urlParams = new URLSearchParams(window.location.search);
            const openId = urlParams.get('openMilestoneId');
            if (openId) {
                const modalEl = document.getElementById('reviewModal_' + openId);
                if (modalEl) {
                    new bootstrap.Modal(modalEl).show();
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
            }
        });
    </script>
}
