@using FYPTracker.Models
@model IEnumerable<FYPMilestone>
@{
    ViewData["Title"] = "Review Submissions";
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }
</style>

<div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white"><i class="fas fa-clipboard-check me-2"></i>Review Submissions</h2>
        <p class="mb-0 text-white opacity-75">Review milestones submitted by your students.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @await Html.PartialAsync("_SessionFilter")
        <div class="d-flex align-items-center position-relative my-1">
            <i class="fas fa-filter position-absolute ms-3 text-muted"></i>
            <select id="milestoneFilter" class="form-select border-0 shadow-sm ps-10 w-200px" style="border-radius: 10px;">
                <option value="">All Milestones</option>
                @foreach (var title in Model.Select(m => m.Title).Distinct().OrderBy(t => t))
                {
                    <option value="@title">@title</option>
                }
            </select>
        </div>
        <div class="d-flex align-items-center position-relative my-1">
            <i class="fas fa-user position-absolute ms-3 text-muted"></i>
            <select id="studentFilter" class="form-select border-0 shadow-sm ps-10 w-200px" style="border-radius: 10px;">
                <option value="">All Students</option>
                @foreach (var studentName in Model.Select(m => m.Project?.Student?.FullName).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s))
                {
                    <option value="@studentName">@studentName</option>
                }
            </select>
        </div>
        <div class="d-flex align-items-center position-relative my-1">
            <i class="fas fa-info-circle position-absolute ms-3 text-muted"></i>
            <select id="statusFilter" class="form-select border-0 shadow-sm ps-10 w-200px" style="border-radius: 10px;">
                <option value="">All Statuses</option>
                <option value="UnderReview">Needs Attention</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Completed">Completed</option>
                <option value="Rejected">Returned for Edits</option>
            </select>
        </div>
    </div>
</div>

<div class="card mb-5 mb-xl-8 border-0 shadow-sm" style="border-radius: 16px;">
    <div class="card-body py-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-4">@TempData["Success"]</div>
        }

        <div class="table-responsive">
            <table class="table align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted bg-light">
                        <th class="ps-4 min-w-200px">Milestone</th>
                        <th class="min-w-120px">Due Date</th>
                        <th class="min-w-120px">Date Submitted</th>
                        <th class="min-w-150px">Files</th>
                        <th class="min-w-120px">Status</th>
                        <th class="text-end min-w-120px pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var groupedMilestones = Model.GroupBy(m => m.Project).Where(g => g.Key != null).ToList();
                    }
                    @foreach (var group in groupedMilestones)
                    {
                        var project = group.Key;
                        var student = project?.Student;
                        var dppMilestones = group.Where(m => m.MilestoneSource == "Supervisor").OrderBy(m => m.DueDate ?? DateTime.MaxValue).ToList();
                        var stage1Milestones = group.Where(m => m.MilestoneSource == "Default" && m.Stage == 1).OrderBy(m => m.DueDate ?? DateTime.MaxValue).ToList();
                        var stage2Milestones = group.Where(m => m.MilestoneSource == "Default" && m.Stage == 2).OrderBy(m => m.Title).ToList();
                        bool isAllStage1Approved = stage1Milestones.Count >= 3 && stage1Milestones.All(m => m.Status == "Approved" || m.Status == "Completed");

                        <tr class="bg-light-primary student-group" data-project-id="@project?.Id">
                            <td colspan="6" class="ps-4 py-3 border-bottom border-primary">
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-40px me-3">
                                        <span class="symbol-label bg-primary text-inverse-primary fw-bolder">@(student?.FullName?.FirstOrDefault() ?? '?')</span>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark fw-bolder fs-5">@student?.FullName</span>
                                        <span class="text-muted fw-bold fs-7">@project?.Title</span>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        @if (dppMilestones.Any())
                        {
                            <tr class="bg-light">
                                <td colspan="6" class="ps-4 py-2"><span class="badge bg-info fw-bold text-white"><i class="fas fa-tasks me-1"></i>DPP Work & Progress</span></td>
                            </tr>
                            @foreach (var ms in dppMilestones)
                            {
                                <tr class="milestone-item" data-project-id="@project?.Id" data-milestone-title="@ms.Title" data-student-name="@(student?.FullName)" data-status="@(ms.Status == "PendingSupervisorReview" || ms.Status == "Submitted" ? "UnderReview" : ms.Status)">
                                    <td class="ps-4"><span class="text-dark fw-bolder d-block fs-6">@ms.Title</span></td>
                                    <td><span class="text-dark fw-bold d-block fs-6">@(ms.DueDate?.ToString("dd MMM yyyy") ?? "-")</span></td>
                                    <td><span class="text-dark fw-bold d-block fs-6">@(ms.SubmittedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</span></td>
                                    <td>
                                        @{
                                            var activeFiles = ms.SubmissionFiles?.Where(f => !f.IsDeleted && f.UploadedBy == project?.StudentId).ToList();
                                            var maxAttempt = activeFiles?.Any() == true ? activeFiles.Max(f => f.AttemptNumber) : 1;
                                            var latestFiles = activeFiles?.Where(f => f.AttemptNumber == maxAttempt).OrderByDescending(f => f.UploadedDate).ToList();
                                        }
                                        @if (latestFiles != null && latestFiles.Any())
                                        {
                                            @foreach(var f in latestFiles)
                                            {
                                                <div class="d-inline-flex align-items-center mb-1">
                                                    <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = f.Id })" target="_blank" class="badge badge-light-primary"><i class="fas fa-file-download me-1 text-primary"></i> @f.FileName</a>
                                                    <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = f.Id })" target="_blank" class="btn btn-icon btn-active-light-primary w-20px h-20px ms-1" title="Preview in new tab"><i class="fas fa-external-link-alt text-info" style="font-size: 0.85rem;"></i></a>
                                                </div><br/>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-7">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (ms.Status == "Submitted") { <span class="badge badge-light-primary">Submitted</span> }
                                        else if (ms.Status == "PendingSupervisorReview") { <span class="badge badge-light-primary">Pending Supervisor Review</span> }
                                        else if (ms.Status == "UnderReview") { <span class="badge badge-light-warning">Needs Attention</span> }
                                        else if (ms.Status == "Completed") { <span class="badge badge-light-primary">Completed</span> }
                                        else if (ms.Status == "Approved") { <span class="badge badge-light-success">Approved</span> }
                                        else if (ms.Status == "Pending") { <span class="badge badge-light-info">Pending</span> }
                                        else if (ms.Status == "ReturnedForChanges" || ms.Status == "ReturnedForEdits" || ms.Status == "Rejected") { <span class="badge badge-light-danger">Returned for Changes</span> }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (ms.Status == "Submitted" || ms.Status == "UnderReview" || ms.Status == "PendingSupervisorReview") { <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = ms.Id })" class="btn btn-sm btn-light-primary">Review</a> }
                                        else if (ms.Status == "Approved" || ms.Status == "Rejected" || ms.Status == "Completed" || ms.Status == "ReturnedForChanges" || ms.Status == "ReturnedForEdits" || ms.Status == "SupervisorSigned" || ms.Status == "PendingPanelReview" || ms.Status == "DefenseRequired" || ms.Status == "DefenseScheduled" || ms.Status == "AdminApproved") { <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = ms.Id })" class="btn btn-sm btn-light-info">View Details</a> }
                                        else { <button class="btn btn-sm btn-light text-muted" disabled>Waiting</button> }
                                    </td>
                                </tr>
                            }
                        }

                        @if (stage1Milestones.Any())
                        {
                            <tr class="bg-light">
                                <td colspan="6" class="ps-4 py-2"><span class="badge bg-primary fw-bold text-white"><i class="fas fa-layer-group me-1"></i>Stage 1 Required Submissions</span></td>
                            </tr>
                            @foreach (var ms in stage1Milestones)
                            {
                                <tr class="milestone-item" data-project-id="@project?.Id" data-milestone-title="@ms.Title" data-student-name="@(student?.FullName)" data-status="@(ms.Status == "Submitted" || ms.Status == "UnderReview" ? "UnderReview" : ms.Status)">
                                    <td class="ps-4"><span class="text-dark fw-bolder d-block fs-6">@ms.Title</span></td>
                                    <td><span class="text-dark fw-bold d-block fs-6">@(ms.DueDate?.ToString("dd MMM yyyy") ?? "-")</span></td>
                                    <td><span class="text-dark fw-bold d-block fs-6">@(ms.SubmittedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</span></td>
                                    <td>
                                        @{
                                            var activeFiles = ms.SubmissionFiles?.Where(f => !f.IsDeleted && f.UploadedBy == project?.StudentId).ToList();
                                            var maxAttempt = activeFiles?.Any() == true ? activeFiles.Max(f => f.AttemptNumber) : 1;
                                            var latestFiles = activeFiles?.Where(f => f.AttemptNumber == maxAttempt).OrderByDescending(f => f.UploadedDate).ToList();
                                        }
                                        @if (latestFiles != null && latestFiles.Any())
                                        {
                                            @foreach(var f in latestFiles)
                                            {
                                                <div class="d-inline-flex align-items-center mb-1">
                                                    <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = f.Id })" target="_blank" class="badge badge-light-primary"><i class="fas fa-file-download me-1 text-primary"></i> @f.FileName</a>
                                                    <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = f.Id })" target="_blank" class="btn btn-icon btn-active-light-primary w-20px h-20px ms-1" title="Preview in new tab"><i class="fas fa-external-link-alt text-info" style="font-size: 0.85rem;"></i></a>
                                                </div><br/>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-7">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (ms.Status == "Submitted") { <span class="badge badge-light-primary">Submitted</span> }
                                        else if (ms.Status == "PendingSupervisorReview") { <span class="badge badge-light-primary">Pending Supervisor Review</span> }
                                        else if (ms.Status == "UnderReview") { <span class="badge badge-light-warning">Needs Attention</span> }
                                        else if (ms.Status == "Completed") { <span class="badge badge-light-primary">Completed</span> }
                                        else if (ms.Status == "Approved") { <span class="badge badge-light-success">Approved</span> }
                                        else if (ms.Status == "Pending") { <span class="badge badge-light-info">Pending</span> }
                                        else if (ms.Status == "ReturnedForEdits" || ms.Status == "Rejected") { <span class="badge badge-light-danger">Returned for Edits</span> }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (ms.Status == "Submitted" || ms.Status == "UnderReview" || ms.Status == "PendingSupervisorReview") { <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = ms.Id })" class="btn btn-sm btn-light-primary">Review</a> }
                                        else if (ms.Status == "Approved" || ms.Status == "Rejected" || ms.Status == "Completed" || ms.Status == "ReturnedForEdits" || ms.Status == "SupervisorSigned" || ms.Status == "PendingPanelReview" || ms.Status == "DefenseRequired" || ms.Status == "DefenseScheduled" || ms.Status == "AdminApproved") { <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = ms.Id })" class="btn btn-sm btn-light-info">View Details</a> }
                                        else { <button class="btn btn-sm btn-light text-muted" disabled>Waiting</button> }
                                    </td>
                                </tr>
                            }
                        }

                        @if (stage2Milestones.Any())
                        {
                            <tr class="bg-light">
                                <td colspan="6" class="ps-4 py-2"><span class="badge bg-success fw-bold text-white"><i class="fas fa-graduation-cap me-1"></i>Stage 2 Required Submissions</span></td>
                            </tr>
                            @if (project?.Stage1Grade == "Pass")
                            {
                                @foreach (var ms in stage2Milestones)
                                {
                                    <tr class="milestone-item" data-project-id="@project?.Id" data-milestone-title="@ms.Title" data-student-name="@(student?.FullName)" data-status="@(ms.Status == "Submitted" || ms.Status == "UnderReview" ? "UnderReview" : ms.Status)">
                                        <td class="ps-4"><span class="text-dark fw-bolder d-block fs-6">@ms.Title</span></td>
                                        <td><span class="text-dark fw-bold d-block fs-6">-</span></td>
                                        <td><span class="text-dark fw-bold d-block fs-6">@(ms.SubmittedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</span></td>
                                        <td>
                                            @{
                                                var latestFile = ms.SubmissionFiles?.Where(f => !f.IsDeleted && f.UploadedBy == project?.StudentId).OrderByDescending(f => f.UploadedDate).FirstOrDefault();
                                            }
                                            @if (latestFile != null)
                                            {
                                                <div class="d-inline-flex align-items-center mb-1">
                                                    <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = latestFile.Id })" target="_blank" class="badge badge-light-primary"><i class="fas fa-file-download me-1 text-primary"></i> @latestFile.FileName</a>
                                                    <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = latestFile.Id })" target="_blank" class="btn btn-icon btn-active-light-primary w-20px h-20px ms-1" title="Preview in new tab"><i class="fas fa-external-link-alt text-info" style="font-size: 0.85rem;"></i></a>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-7">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (ms.Status == "Submitted") { <span class="badge badge-light-primary">Submitted</span> }
                                            else if (ms.Status == "UnderReview") { <span class="badge badge-light-warning">Needs Attention</span> }
                                            else if (ms.Status == "Completed") { <span class="badge badge-light-primary">Completed</span> }
                                            else if (ms.Status == "Approved") { <span class="badge badge-light-success">Approved</span> }
                                            else if (ms.Status == "Pending") { <span class="badge badge-light-info">Pending</span> }
                                            else if (ms.Status == "ReturnedForEdits" || ms.Status == "Rejected") { <span class="badge badge-light-danger">Returned for Edits</span> }
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (ms.Status == "Submitted" || ms.Status == "UnderReview") { <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = ms.Id })" class="btn btn-sm btn-light-primary">Review</a> }
                                            else if (ms.Status == "Approved" || ms.Status == "Rejected" || ms.Status == "Completed" || ms.Status == "ReturnedForEdits" || ms.Status == "SupervisorSigned") { <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = ms.Id })" class="btn btn-sm btn-light-info">View Details</a> }
                                            else { <button class="btn btn-sm btn-light text-muted" disabled>Waiting</button> }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted" style="font-style: italic; background-color: #f8fafc;">
                                        <i class="fas fa-lock me-2"></i>Stage 2 is locked. Student has not passed Stage 1 yet.
                                    </td>
                                </tr>
                            }
                        }
                    }
                    @if (!groupedMilestones.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No student submissions found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const msFilter = document.getElementById('milestoneFilter');
            const stFilter = document.getElementById('studentFilter');
            const stStatus = document.getElementById('statusFilter');

            function applyFilters() {
                const msVal = msFilter ? msFilter.value : '';
                const stVal = stFilter ? stFilter.value : '';
                const statVal = stStatus ? stStatus.value : '';
                
                const items = document.querySelectorAll('.milestone-item');
                const groups = document.querySelectorAll('.student-group');
                
                const visibleGroups = new Set();

                items.forEach(item => {
                    const matchMs = !msVal || item.getAttribute('data-milestone-title') === msVal;
                    const matchSt = !stVal || item.getAttribute('data-student-name') === stVal;
                    const matchStat = !statVal || item.getAttribute('data-status') === statVal;
                    
                    if (matchMs && matchSt && matchStat) {
                        item.style.display = '';
                        visibleGroups.add(item.getAttribute('data-project-id'));
                    } else {
                        item.style.display = 'none';
                    }
                });

                groups.forEach(group => {
                    if (visibleGroups.has(group.getAttribute('data-project-id'))) {
                        group.style.display = '';
                    } else {
                        group.style.display = 'none';
                    }
                });
            }

            if(msFilter) msFilter.addEventListener('change', applyFilters);
            if(stFilter) stFilter.addEventListener('change', applyFilters);
            if(stStatus) stStatus.addEventListener('change', applyFilters);

            document.addEventListener('MilestoneUpdateEvent', function(e) {
                const p = e.detail;
                let currentSession = document.querySelector('select[name="sessionFilter"]')?.value || '';
                
                if (currentSession && p.session && currentSession !== p.session) {
                    p._handled = true;
                    Swal.fire({
                        title: 'New Submission (' + p.session + ')',
                        text: `Student ${p.studentName || 'A student'} submitted a milestone in another session. Switch to ${p.session} to view?`,
                        icon: 'info',
                        showCancelButton: true,
                        confirmButtonText: 'Switch Session',
                        cancelButtonText: 'Stay Here'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/Supervisor/ReviewSubmissions?sessionFilter=' + encodeURIComponent(p.session);
                        }
                    });
                    return;
                }

                p._handled = true;
                Swal.fire({
                    title: p.title,
                    text: p.message,
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: 'Refresh Page',
                    cancelButtonText: 'Later'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.reload();
                    }
                });
            });
        });
    </script>
}
