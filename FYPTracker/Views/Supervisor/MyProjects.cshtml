@using FYPTracker.Models
@model IEnumerable<FYPProject>
@{
    ViewData["Title"] = "My Students";
    var distinctMilestones = Model.SelectMany(p => p.Milestones).Select(m => m.Title).Distinct().OrderBy(t => t).ToList();
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }
</style>

<div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white"><i class="fas fa-user-graduate me-2"></i>My Students</h2>
        <p class="mb-0 text-white opacity-75">Manage your supervised students, track their progress, and update milestones.</p>
    </div>
    <div class="d-flex my-2 gap-2 align-items-center">
        @await Html.PartialAsync("_SessionFilter")
        <button type="button" class="btn btn-sm btn-info ms-2" data-bs-toggle="modal" data-bs-target="#bulkEditMilestoneModal">
            <i class="fas fa-edit text-white"></i> Edit
        </button>
        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#bulkDeleteMilestoneModal">
            <i class="fas fa-trash text-white"></i> Delete
        </button>
        <button type="button" class="btn btn-sm btn-light text-primary fw-bolder shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkAddMilestoneModal">
            <i class="fas fa-plus text-primary"></i> Add Milestone
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
    </div>
}

<div class="row g-5 g-xl-8">
    @foreach (var proj in Model)
    {
        var completed = proj.Milestones.Count(m => m.Status == "Approved");
        var total = proj.Milestones.Count;
        var progress = total > 0 ? (completed * 100) / total : 0;

        <div class="col-xl-4">
            <div class="card card-xl-stretch mb-xl-8 shadow-sm border-0">
                <div class="card-body d-flex flex-column pb-10 pb-lg-15">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center justify-content-between mb-5">
                            @if (proj.Status == "Failed")
                            {
                                <span class="badge bg-danger text-white fw-bolder px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-times-circle me-1"></i> Failed</span>
                            }
                            else if (total > 0 && completed == total)
                            {
                                <span class="badge bg-success text-white fw-bolder px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-check-circle me-1"></i> Completed</span>
                            }
                            else
                            {
                                <span class="badge badge-light-primary fw-bolder px-4 py-2 rounded-pill">FYP Project</span>
                            }
                            <span class="text-muted fw-bold">@proj.CreatedDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <a href="/Supervisor/ProjectDetails/@proj.Id" class="text-dark fw-bolder text-hover-primary fs-3">Title: @proj.Title</a>
                        <p class="text-gray-600 fw-bold fs-6 mt-3 mb-1">Student: @proj.Student?.FullName</p>
                        @if (proj.ExaminerId == null)
                        {
                            <span class="badge bg-warning text-dark fw-bolder mt-1"><i class="fas fa-exclamation-triangle me-1"></i> Pending Examiner Assignment</span>
                        }
                        else
                        {
                            <span class="badge bg-light-success text-success fw-bolder mt-1"><i class="fas fa-user-check me-1"></i> Examiner Assigned</span>
                        }
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <div class="d-flex justify-content-between w-100 fs-6 fw-bolder mb-2">
                            <span>Project Progress</span>
                            <span>@progress%</span>
                        </div>
                        <div class="h-8px bg-light rounded mb-3">
                            <div class="bg-primary rounded h-8px" role="progressbar" style="width: @progress%;"></div>
                        </div>
                        <div class="mt-5 pt-3">
                            <a href="/Supervisor/ProjectDetails/@proj.Id" class="btn btn-sm btn-light-primary w-100 fw-bolder">View More <i class="fas fa-arrow-right ms-2 fs-7"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-10">
            <i class="fas fa-folder-open fs-1 text-muted mb-4"></i>
            <h4>No active projects under your supervision.</h4>
        </div>
    }
</div>

<!-- Bulk Add Milestone Modal -->
<div class="modal fade" id="bulkAddMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <form asp-action="BulkAddMilestone" asp-controller="Supervisor" method="post" id="bulkAddForm" onsubmit="return validateBulkAdd()" novalidate>
                <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSession" />
                <div class="modal-header">
                    <h2 class="fw-bolder">Add Milestone</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                        <i class="fas fa-times fs-1"></i>
                    </div>
                </div>
                <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                    @if (TempData["AddModalError"] != null)
                    {
                        <div class="alert alert-danger bg-light-danger border-danger d-flex align-items-center p-5 mb-7">
                            <i class="fas fa-exclamation-triangle text-danger fs-1 me-4"></i>
                            <div class="d-flex flex-column text-danger pe-0 pe-sm-10">
                                <h4 class="mb-1 text-danger">Validation Error</h4>
                                <span>@TempData["AddModalError"]</span>
                            </div>
                        </div>
                    }
                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required">Milestone Title</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="e.g. FYP 1: Final Report" name="title" id="addTitle" oninput="validateBulkAddRealtime()" />
                        <div id="addTitleError" class="text-danger fw-bold small mt-1 d-none">Title must be at least 5 characters long.</div>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required">Due Date</span>
                        </label>
                        <input type="date" class="form-control form-control-solid" name="dueDate" id="addDueDate" onchange="validateBulkAddRealtime()" />
                        <div id="addDueDateError" class="text-danger fw-bold small mt-1 d-none">Please select a valid due date.</div>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="fs-6 fw-bold form-label mb-2">Description</label>
                        <textarea class="form-control form-control-solid" rows="3" name="description" id="addDescription" placeholder="Instructions for students..." oninput="validateBulkAddRealtime()"></textarea>
                        <div id="addDescriptionError" class="text-danger fw-bold small mt-1 d-none">Description must be at least 10 characters long.</div>
                    </div>
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <span class="indicator-label">Submit</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bulk Edit Milestone Modal -->
<div class="modal fade" id="bulkEditMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <form asp-action="BulkEditMilestone" asp-controller="Supervisor" method="post" id="bulkEditForm" onsubmit="return validateBulkEdit()" novalidate>
                <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSession" />
                <div class="modal-header">
                    <h2 class="fw-bolder">Edit Milestone</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                        <i class="fas fa-times fs-1"></i>
                    </div>
                </div>
                <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                    @if (TempData["EditModalError"] != null)
                    {
                        <div class="alert alert-danger bg-light-danger border-danger d-flex align-items-center p-5 mb-7">
                            <i class="fas fa-exclamation-triangle text-danger fs-1 me-4"></i>
                            <div class="d-flex flex-column text-danger pe-0 pe-sm-10">
                                <h4 class="mb-1 text-danger">Validation Error</h4>
                                <span>@TempData["EditModalError"]</span>
                            </div>
                        </div>
                    }
                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required">Target Milestone to Edit</span>
                        </label>
                        <select name="targetTitle" class="form-select form-select-solid" id="editTargetTitle" onchange="validateBulkEditRealtime()" required>
                            <option value="">-- Select Milestone --</option>
                            @foreach(var t in distinctMilestones)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                        <div id="editTargetError" class="text-danger fw-bold small mt-1 d-none">Please select a milestone to edit.</div>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span>New Title (Optional)</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="Leave blank to keep same" name="newTitle" id="bulkNewTitle" oninput="validateBulkEditRealtime()" />
                        <div id="editTitleError" class="text-danger fw-bold small mt-1 d-none">New title must be at least 5 characters long.</div>
                        <small id="bulkTitleWarning" class="text-danger mt-1 fw-bold" style="display: none;"><i class="fas fa-lock me-1"></i>Core system milestone titles cannot be renamed.</small>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span>New Due Date (Optional)</span>
                        </label>
                        <input type="date" class="form-control form-control-solid" name="newDueDate" id="bulkNewDueDate" onchange="validateBulkEditRealtime()" />
                        <small id="bulkDateWarning" class="text-danger mt-1 fw-bold" style="display: none;"><i class="fas fa-lock me-1"></i>The IAF deadline is centrally managed by the Admin.</small>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="fs-6 fw-bold form-label mb-2">New Description (Optional)</label>
                        <textarea class="form-control form-control-solid" rows="3" name="newDescription" id="bulkNewDescription" placeholder="Leave blank to keep same..." oninput="validateBulkEditRealtime()"></textarea>
                        <div id="editDescriptionError" class="text-danger fw-bold small mt-1 d-none">New description must be at least 10 characters long.</div>
                    </div>
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bulk Delete Milestone Modal -->
<div class="modal fade" id="bulkDeleteMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <form asp-action="BulkDeleteMilestone" asp-controller="Supervisor" method="post" id="bulkDeleteForm" onsubmit="return validateBulkDelete()" novalidate>
                <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSession" />
                <div class="modal-header">
                    <h2 class="fw-bolder">Delete Milestone</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                        <i class="fas fa-times fs-1"></i>
                    </div>
                </div>
                <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required text-danger">Target Milestone to Delete</span>
                        </label>
                        <select name="targetTitle" class="form-select form-select-solid" id="deleteTargetTitle" onchange="validateBulkDeleteRealtime()" required>
                            <option value="">-- Select Milestone --</option>
                            @foreach(var t in distinctMilestones.Where(m => !m.Contains("IAF", StringComparison.OrdinalIgnoreCase) && !m.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) && !m.Contains("Proposal", StringComparison.OrdinalIgnoreCase) && !m.Contains("Final", StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                        <div id="deleteTargetError" class="text-danger fw-bold small mt-1 d-none">Please select a milestone to delete.</div>
                    </div>
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            function setupDynamicFiltering(formId, rowClass) {
                var form = document.getElementById(formId);
                if(form) {
                    var selectElement = form.querySelector('select[name="targetTitle"]');
                    if(selectElement) {
                        selectElement.addEventListener('change', function() {
                            var selectedTitle = this.value;

                            if (formId === 'bulkEditForm') {
                                var titleInput = document.getElementById('bulkNewTitle');
                                var dateInput = document.getElementById('bulkNewDueDate');
                                var titleWarning = document.getElementById('bulkTitleWarning');
                                var dateWarning = document.getElementById('bulkDateWarning');

                                if (titleInput && dateInput) {
                                    // Reset states
                                    titleInput.readOnly = false;
                                    titleInput.classList.remove('bg-light');
                                    dateInput.readOnly = false;
                                    dateInput.classList.remove('bg-light');
                                    if(titleWarning) titleWarning.style.display = 'none';
                                    if(dateWarning) dateWarning.style.display = 'none';

                                    if (selectedTitle) {
                                        var isIaf = selectedTitle.includes('IAF') || selectedTitle.includes('Initial Project');
                                        var isSystem = isIaf || selectedTitle.includes('Proposal') || selectedTitle.includes('Progress') || selectedTitle.includes('Final');

                                        if (isSystem) {
                                            titleInput.readOnly = true;
                                            titleInput.value = '';
                                            titleInput.classList.add('bg-light');
                                            if(titleWarning) titleWarning.style.display = 'block';
                                        }

                                        if (isIaf) {
                                            dateInput.readOnly = true;
                                            dateInput.value = '';
                                            dateInput.classList.add('bg-light');
                                            if(dateWarning) dateWarning.style.display = 'block';
                                        }
                                    }
                                }
                            }

                            // Student rows removed, no need to filter them here
                        });
                        
                        // Initialize state on load
                        selectElement.dispatchEvent(new Event('change'));
                    }
                }
            }

            setupDynamicFiltering('bulkEditForm');
            setupDynamicFiltering('bulkDeleteForm');

            // --- Auto-trigger modals based on query parameters ---
            const urlParams = new URLSearchParams(window.location.search);
            const action = urlParams.get('action');
            const target = urlParams.get('target');

            if (action === 'bulk-edit') {
                var modalElement = document.getElementById('bulkEditMilestoneModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    if (target) {
                        var select = document.querySelector('#bulkEditForm select[name="targetTitle"]');
                        if(select) { 
                            select.value = target; 
                            select.dispatchEvent(new Event('change')); 
                        }
                    }
                    modal.show();
                }
            } else if (action === 'bulk-delete') {
                var modalElement = document.getElementById('bulkDeleteMilestoneModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    if (target) {
                        var select = document.querySelector('#bulkDeleteForm select[name="targetTitle"]');
                        if(select) { 
                            select.value = target; 
                            select.dispatchEvent(new Event('change')); 
                        }
                    }
                    modal.show();
                }
            } else if (action === 'bulk-add') {
                var modalElement = document.getElementById('bulkAddMilestoneModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
            }
        });

        // --- Real-time Validation ---
        window.validateBulkAddRealtime = function(isSubmit = false) {
            var title = document.getElementById('addTitle');
            var titleError = document.getElementById('addTitleError');
            var date = document.getElementById('addDueDate');
            var dateError = document.getElementById('addDueDateError');
            var desc = document.getElementById('addDescription');
            var descError = document.getElementById('addDescriptionError');
            var isValid = true;

            if (!title.value.trim() && isSubmit) {
                title.classList.add('is-invalid');
                titleError.innerText = "Title is required.";
                titleError.classList.remove('d-none');
                isValid = false;
            } else if (title.value && title.value.trim().length < 5) {
                title.classList.add('is-invalid');
                title.classList.remove('is-valid');
                titleError.innerText = "Title must be at least 5 characters long.";
                titleError.classList.remove('d-none');
                isValid = false;
            } else if (title.value) {
                title.classList.remove('is-invalid');
                title.classList.add('is-valid');
                titleError.classList.add('d-none');
            } else {
                title.classList.remove('is-invalid', 'is-valid');
                titleError.classList.add('d-none');
            }

            if (!date.value && isSubmit) {
                date.classList.add('is-invalid');
                dateError.innerText = "Due date is required.";
                dateError.classList.remove('d-none');
                isValid = false;
            } else if (date.value) {
                var selectedDate = new Date(date.value);
                var today = new Date();
                today.setHours(0,0,0,0);
                
                if (isNaN(selectedDate.getTime()) || selectedDate < today) {
                    date.classList.add('is-invalid');
                    date.classList.remove('is-valid');
                    dateError.innerText = selectedDate < today ? "Due date cannot be in the past." : "Please select a valid due date.";
                    dateError.classList.remove('d-none');
                    isValid = false;
                } else {
                    date.classList.remove('is-invalid');
                    date.classList.add('is-valid');
                    dateError.classList.add('d-none');
                }
            } else {
                date.classList.remove('is-invalid', 'is-valid');
                dateError.classList.add('d-none');
            }

            if (desc.value && desc.value.trim().length < 10) {
                desc.classList.add('is-invalid');
                desc.classList.remove('is-valid');
                descError.classList.remove('d-none');
                isValid = false;
            } else if (desc.value) {
                desc.classList.remove('is-invalid');
                desc.classList.add('is-valid');
                descError.classList.add('d-none');
            } else {
                desc.classList.remove('is-invalid', 'is-valid');
                descError.classList.add('d-none');
            }

            return isValid;
        };

        window.validateBulkAdd = function() {
            var isValid = window.validateBulkAddRealtime(true);
            if(!isValid) {
                Swal.fire({ text: "Please fix the validation errors before submitting.", icon: "error", confirmButtonText: "Got it" });
            }
            return isValid;
        };

        window.validateBulkEditRealtime = function(isSubmit = false) {
            var target = document.getElementById('editTargetTitle');
            var targetError = document.getElementById('editTargetError');
            var title = document.getElementById('bulkNewTitle');
            var titleError = document.getElementById('editTitleError');
            var date = document.getElementById('bulkNewDueDate');
            var dateError = document.getElementById('bulkDateWarning');
            var desc = document.getElementById('bulkNewDescription');
            var descError = document.getElementById('editDescriptionError');
            var isValid = true;

            if (!target.value && isSubmit) {
                target.classList.add('is-invalid');
                target.classList.remove('is-valid');
                targetError.classList.remove('d-none');
                isValid = false;
            } else if (target.value) {
                target.classList.remove('is-invalid');
                target.classList.add('is-valid');
                targetError.classList.add('d-none');
            } else {
                target.classList.remove('is-invalid', 'is-valid');
                targetError.classList.add('d-none');
            }

            if (title.value && title.value.trim().length < 5) {
                title.classList.add('is-invalid');
                title.classList.remove('is-valid');
                titleError.classList.remove('d-none');
                isValid = false;
            } else if (title.value) {
                title.classList.remove('is-invalid');
                title.classList.add('is-valid');
                titleError.classList.add('d-none');
            } else {
                title.classList.remove('is-invalid', 'is-valid');
                titleError.classList.add('d-none');
            }
            
            if (date.value) {
                var selectedDate = new Date(date.value);
                var today = new Date();
                today.setHours(0,0,0,0);
                
                if (isNaN(selectedDate.getTime()) || selectedDate < today) {
                    date.classList.add('is-invalid');
                    date.classList.remove('is-valid');
                    dateError.innerText = selectedDate < today ? "Due date cannot be in the past." : "Please select a valid due date.";
                    dateError.style.display = 'block';
                    isValid = false;
                } else {
                    date.classList.remove('is-invalid');
                    date.classList.add('is-valid');
                    dateError.style.display = 'none';
                }
            } else {
                date.classList.remove('is-invalid', 'is-valid');
                dateError.style.display = 'none';
            }
            
            if (desc.value && desc.value.trim().length < 10) {
                desc.classList.add('is-invalid');
                desc.classList.remove('is-valid');
                descError.classList.remove('d-none');
                isValid = false;
            } else if (desc.value) {
                desc.classList.remove('is-invalid');
                desc.classList.add('is-valid');
                descError.classList.add('d-none');
            } else {
                desc.classList.remove('is-invalid', 'is-valid');
                descError.classList.add('d-none');
            }

            return isValid;
        };

        window.validateBulkEdit = function() {
            var isValid = window.validateBulkEditRealtime(true);
            if(!isValid) {
                Swal.fire({ text: "Please fix the validation errors before submitting.", icon: "error", confirmButtonText: "Got it" });
            }
            return isValid;
        };

        window.validateBulkDeleteRealtime = function(isSubmit = false) {
            var target = document.getElementById('deleteTargetTitle');
            var targetError = document.getElementById('deleteTargetError');
            
            if (!target.value && isSubmit) {
                target.classList.add('is-invalid');
                target.classList.remove('is-valid');
                targetError.classList.remove('d-none');
                return false;
            } else if (target.value) {
                target.classList.remove('is-invalid');
                target.classList.add('is-valid');
                targetError.classList.add('d-none');
                return true;
            } else {
                target.classList.remove('is-invalid', 'is-valid');
                targetError.classList.add('d-none');
                return true;
            }
        };

        window.validateBulkDelete = function() {
            var isValid = window.validateBulkDeleteRealtime(true);
            if(!isValid) {
                Swal.fire({ text: "Please select a milestone before deleting.", icon: "error", confirmButtonText: "Got it" });
            }
            return isValid;
        };

    </script>
}
