                            <div class="timeline-stepper pb-2">
                                @if(stage1Templates.Any()) {
                                    @foreach(var m in stage1Templates) {
                                        <div class="stepper-item">
                                            <div class="stepper-icon"></div>
                                            <div class="stepper-content">
                                                <div class="fw-bolder text-dark fs-7" style="margin: 0 auto;" title="@m.Title">@m.Title</div>
                                                <div class="text-muted fs-8 mt-1">@(m.DueDate?.ToString("dd MMM yyyy") ?? "No Date")</div>
                                            </div>
                                        </div>
                                    }
                                } else {
                                    <div class="text-muted fs-8 fst-italic">No Stage 1 milestones.</div>
                                }
                            </div>
                        </div>

                        <!-- Stage 2 Row -->
                        <div>
                            <h6 class="text-success fw-bold mb-3"><i class="fas fa-graduation-cap me-2"></i>Stage 2</h6>
                            <div class="timeline-stepper pb-2">
                                @if(stage2Templates.Any()) {
                                    @foreach(var m in stage2Templates) {
                                        <div class="stepper-item stage2">
                                            <div class="stepper-icon"></div>
                                            <div class="stepper-content">
                                                <div class="fw-bolder text-dark fs-7" style="margin: 0 auto;" title="@m.Title">@m.Title</div>
                                                <div class="text-muted fs-8 mt-1">@(m.DueDate?.ToString("dd MMM yyyy") ?? "No Date")</div>
                                            </div>
                                        </div>
                                    }
                                } else {
                                    <div class="text-muted fs-8 fst-italic">No Stage 2 milestones.</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required">Target Milestone to Edit</span>
                        </label>
                        <select name="targetTitle" class="form-select form-select-solid" id="editTargetTitle" onchange="validateBulkEditRealtime()" required>
                            <option value="">-- Select Milestone --</option>
                            @foreach(var t in distinctMilestones)
                            {
                                if (!defaultMilestoneTitles.Contains(t)) {
                                    <option value="@t">@t</option>
                                }
                            }
                        </select>
                        <div id="editTargetError" class="text-danger fw-bold small mt-1 d-none">Please select a milestone to edit.</div>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span>New Title (Optional)</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="Leave blank to keep same" name="newTitle" id="bulkNewTitle" oninput="validateBulkEditRealtime()" />
                        <div id="editTitleError" class="text-danger fw-bold small mt-1 d-none">New title must be at least 5 characters long.</div>
                        <small id="bulkTitleWarning" class="text-danger mt-1 fw-bold" style="display: none;"><i class="fas fa-lock me-1"></i>Core system milestone titles cannot be renamed.</small>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span>New Due Date (Optional)</span>
                        </label>
                        <input type="date" class="form-control form-control-solid" name="newDueDate" id="bulkNewDueDate" onchange="validateBulkEditRealtime()" />
                        <small id="bulkDateWarning" class="text-danger mt-1 fw-bold" style="display: none;"><i class="fas fa-lock me-1"></i>The IAF deadline is centrally managed by the Admin.</small>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="fs-6 fw-bold form-label mb-2">New Description (Optional)</label>
                        <textarea class="form-control form-control-solid" rows="3" name="newDescription" id="bulkNewDescription" placeholder="Leave blank to keep same..." oninput="validateBulkEditRealtime()"></textarea>
                        <div id="editDescriptionError" class="text-danger fw-bold small mt-1 d-none">New description must be at least 10 characters long.</div>
                    </div>
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

