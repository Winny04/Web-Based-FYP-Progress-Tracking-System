@using FYPTracker.Models
@model IEnumerable<FYPProject>
@{
    ViewData["Title"] = "My Students";
    var distinctMilestones = Model.SelectMany(p => p.Milestones).Select(m => m.Title).Distinct().OrderBy(t => t).ToList();
    
    var allMilestoneTemplates = Model.SelectMany(p => p.Milestones)
                                    .GroupBy(m => m.Title)
                                    .Select(g => g.First())
                                    .OrderBy(m => m.DueDate ?? DateTime.MaxValue)
                                    .ToList();
                                    
    var stage1Templates = allMilestoneTemplates.Where(m => !m.Title.StartsWith("Step ", StringComparison.OrdinalIgnoreCase)).ToList();
    var stage2Templates = allMilestoneTemplates.Where(m => m.Title.StartsWith("Step ", StringComparison.OrdinalIgnoreCase)).ToList();
    
    var defaultMilestoneTitles = new List<string> {
        "FYP 1: Initial Assessment Form (IAF)",
        "FYP 1: Stage 1 Final Submission",
        "Step 1: Turnitin Checking",
        "Step 2: Final Report Submission",
        "Step 3: Marksheet Submission",
        "Step 4: Record of Supervisor Meeting Form Submission",
        "Step 5: Presentation Slides Submission"
    };
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    /* Custom Timeline Stepper Horizontal */
    .timeline-stepper {
        position: relative;
        display: flex;
        align-items: flex-start;
        overflow-x: auto;
        padding-bottom: 15px;
        margin-bottom: 10px;
        gap: 15px;
    }
    /* Horizontal Line drawn per item to support scrolling */
    .stepper-item::before {
        content: '';
        position: absolute;
        top: 12px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e2e8f0;
        z-index: 0;
    }
    .stepper-item:last-child::before {
        display: none;
    }
    .stepper-item {
        position: relative;
        text-align: center;
        flex: 1 1 150px;
        min-width: 150px;
        z-index: 1;
        padding: 0 5px;
    }
    .stepper-icon {
        margin: 0 auto 12px auto;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #3b82f6;
        border: 4px solid #fff;
        box-shadow: 0 0 0 2px #3b82f6;
        position: relative;
    }
    .stepper-item.stage2 .stepper-icon {
        background: #10b981;
        box-shadow: 0 0 0 2px #10b981;
    }
    
    /* Scrollbar styling for timeline */
    .timeline-stepper::-webkit-scrollbar {
        height: 6px;
    }
    .timeline-stepper::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    
    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }
</style>

<div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white"><i class="fas fa-user-graduate me-2"></i>My Students</h2>
        <p class="mb-0 text-white opacity-75">Manage your supervised students, track their progress, and update milestones.</p>
    </div>
    <div class="d-flex my-2 gap-2 align-items-center">
        @await Html.PartialAsync("_SessionFilter")
        <button type="button" class="btn btn-sm btn-info ms-2" data-bs-toggle="modal" data-bs-target="#bulkEditMilestoneModal">
            <i class="fas fa-edit text-white"></i> Edit
        </button>
        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#bulkDeleteMilestoneModal">
            <i class="fas fa-trash text-white"></i> Delete
        </button>
        <button type="button" class="btn btn-sm btn-light text-primary fw-bolder shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkAddMilestoneModal">
            <i class="fas fa-plus text-primary"></i> Add Milestone
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
    </div>
}

<div class="row g-5 g-xl-8">
    @foreach (var proj in Model)
    {
        var completed = proj.Milestones.Count(m => m.Status == "Approved");
        var total = proj.Milestones.Count;
        var progress = total > 0 ? (completed * 100) / total : 0;

        <div class="col-xl-4">
            <div class="card card-xl-stretch mb-xl-8 shadow-sm border-0">
                <div class="card-body d-flex flex-column pb-10 pb-lg-15">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center justify-content-between mb-5">
                            @if (proj.Status == "Failed")
                            {
                                <span class="badge bg-danger text-white fw-bolder px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-times-circle me-1"></i> Failed</span>
                            }
                            else if (total > 0 && completed == total)
                            {
                                <span class="badge bg-success text-white fw-bolder px-3 py-2 rounded-pill shadow-sm"><i class="fas fa-check-circle me-1"></i> Completed</span>
                            }
                            else
                            {
                                <span class="badge badge-light-primary fw-bolder px-4 py-2 rounded-pill">FYP Project</span>
                            }
                            <span class="text-muted fw-bold">@proj.CreatedDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <a href="/Supervisor/ProjectDetails/@proj.Id" class="text-dark fw-bolder text-hover-primary fs-3">Title: @proj.Title</a>
                        <p class="text-gray-600 fw-bold fs-6 mt-3 mb-1">Student: @proj.Student?.FullName</p>
                        @if (proj.AssignedExaminers != null && proj.AssignedExaminers.Any())
                        {
                            var examinerName = proj.AssignedExaminers.FirstOrDefault()?.Examiner?.FullName;
                            <span class="badge bg-light-success text-success fw-bolder mt-1"><i class="fas fa-user-check me-1"></i> @(string.IsNullOrEmpty(examinerName) ? "Examiner Assigned" : $"Examiner: {examinerName}")</span>
                        }
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <div class="d-flex justify-content-between w-100 fs-6 fw-bolder mb-2">
                            <span>Project Progress</span>
                            <span>@progress%</span>
                        </div>
                        <div class="h-8px bg-light rounded mb-3">
                            <div class="bg-primary rounded h-8px" role="progressbar" style="width: @progress%;"></div>
                        </div>
                        <div class="mt-5 pt-3">
                            <a href="/Supervisor/ProjectDetails/@proj.Id" class="btn btn-sm btn-light-primary w-100 fw-bolder">View More <i class="fas fa-arrow-right ms-2 fs-7"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-10">
            <i class="fas fa-folder-open fs-1 text-muted mb-4"></i>
            <h4>No active projects under your supervision.</h4>
        </div>
    }
</div>

<!-- Bulk Add Milestone Modal -->
<div class="modal fade" id="bulkAddMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-1000px">
        <div class="modal-content">
            <form asp-action="BulkAddMilestone" asp-controller="Supervisor" method="post" id="bulkAddForm" onsubmit="return validateBulkAdd()" novalidate>
                <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSession" />
                <div class="modal-header">
                    <h2 class="fw-bolder">Add Milestone</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                        <i class="fas fa-times fs-1"></i>
                    </div>
                </div>
                <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                    @if (TempData["AddModalError"] != null)
                    {
                        <div class="alert alert-danger bg-light-danger border-danger d-flex align-items-center p-5 mb-7">
                            <i class="fas fa-exclamation-triangle text-danger fs-1 me-4"></i>
                            <div class="d-flex flex-column text-danger pe-0 pe-sm-10">
                                <h4 class="mb-1 text-danger">Validation Error</h4>
                                <span>@TempData["AddModalError"]</span>
                            </div>
                        </div>
                    }

                    <!-- Current Timeline Visualization -->
                    <div class="mb-8 p-5 rounded border border-light shadow-sm" style="background-color: #fafbfc;">
                        <h4 class="fw-bolder text-dark mb-4 text-center">Current Project Timeline</h4>
                        
                        <!-- Stage 1 Row -->
                        <div class="mb-6">
                            <h6 class="text-primary fw-bold mb-3"><i class="fas fa-flag me-2"></i>Stage 1</h6>
                            <div class="timeline-stepper pb-2">
                                @if(stage1Templates.Any()) {
                                    @foreach(var m in stage1Templates) {
                                        <div class="stepper-item">
                                            <div class="stepper-icon"></div>
                                            <div class="stepper-content">
                                                <div class="fw-bolder text-dark fs-7" style="margin: 0 auto;" title="@m.Title">@m.Title</div>
                                                <div class="text-muted fs-8 mt-1">@(m.DueDate?.ToString("dd MMM yyyy") ?? "No Date")</div>
                                            </div>
                                        </div>
                                    }
                                } else {
                                    <div class="text-muted fs-8 fst-italic">No Stage 1 milestones.</div>
                                }
                            </div>
                        </div>

                        <!-- Stage 2 Row -->
                        <div>
                            <h6 class="text-success fw-bold mb-3"><i class="fas fa-graduation-cap me-2"></i>Stage 2</h6>
                            <div class="timeline-stepper pb-2">
                                @if(stage2Templates.Any()) {
                                    @foreach(var m in stage2Templates) {
                                        <div class="stepper-item stage2">
                                            <div class="stepper-icon"></div>
                                            <div class="stepper-content">
                                                <div class="fw-bolder text-dark fs-7" style="margin: 0 auto;" title="@m.Title">@m.Title</div>
                                                <div class="text-muted fs-8 mt-1">@(m.DueDate?.ToString("dd MMM yyyy") ?? "No Date")</div>
                                            </div>
                                        </div>
                                    }
                                } else {
                                    <div class="text-muted fs-8 fst-italic">No Stage 2 milestones.</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row mb-7">
                        <div class="col-md-4 fv-row">
                            <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                                <span class="required">Stage</span>
                            </label>
                            <select class="form-select form-select-solid" id="addStage" name="stageSelection" onchange="updateTitlePreview()">
                                <option value="1">Stage 1</option>
                                <option value="2">Stage 2</option>
                            </select>
                        </div>
                        <div class="col-md-8 fv-row">
                            <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                                <span class="required">Custom Title</span>
                            </label>
                            <input type="text" class="form-control form-control-solid" placeholder="e.g. Demonstration Video" name="title" id="addTitle" oninput="updateTitlePreview()" />
                            <div id="addTitleError" class="text-danger fw-bold small mt-1 d-none">Title must be at least 3 characters long.</div>
                        </div>
                    </div>
                    <div class="mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span>Final Title Preview</span>
                        </label>
                        <input type="text" class="form-control form-control-solid bg-light text-primary fw-bolder fs-6 border-primary border-dashed" style="background-color: #f8fbfd !important;" id="addTitlePreview" readonly />
                        <small class="text-muted mt-2 d-block"><i class="fas fa-info-circle me-1"></i> The system will automatically add the correct prefix to place it in the correct stage.</small>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required">Due Date</span>
                        </label>
                        <input type="date" class="form-control form-control-solid" name="dueDate" id="addDueDate" onchange="validateBulkAddRealtime()" />
                        <div id="addDueDateError" class="text-danger fw-bold small mt-1 d-none">Please select a valid due date.</div>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="fs-6 fw-bold form-label mb-2">Description</label>
                        <textarea class="form-control form-control-solid" rows="3" name="description" id="addDescription" placeholder="Instructions for students..." oninput="validateBulkAddRealtime()"></textarea>
                        <div id="addDescriptionError" class="text-danger fw-bold small mt-1 d-none">Description must be at least 10 characters long.</div>
                    </div>
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <span class="indicator-label">Submit</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bulk Edit Milestone Modal -->
<div class="modal fade" id="bulkEditMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-1000px">
        <div class="modal-content">
            <form asp-action="BulkEditMilestone" asp-controller="Supervisor" method="post" id="bulkEditForm" onsubmit="return validateBulkEdit()" novalidate>
