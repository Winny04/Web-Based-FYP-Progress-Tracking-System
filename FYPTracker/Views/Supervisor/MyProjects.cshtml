@using FYPTracker.Models
@model IEnumerable<FYPProject>
@{
    ViewData["Title"] = "My Students";
    var distinctMilestones = Model.SelectMany(p => p.Milestones).Select(m => m.Title).Distinct().OrderBy(t => t).ToList();
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }
</style>

<div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1 text-white"><i class="fas fa-user-graduate me-2"></i>My Students</h2>
        <p class="mb-0 text-white opacity-75">Manage your supervised students, track their progress, and update milestones.</p>
    </div>
    <div class="d-flex my-2 gap-2">
        <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#bulkEditMilestoneModal">
            <i class="fas fa-edit text-white"></i> Bulk Edit
        </button>
        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#bulkDeleteMilestoneModal">
            <i class="fas fa-trash text-white"></i> Bulk Delete
        </button>
        <button type="button" class="btn btn-sm btn-light text-primary fw-bolder shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkAddMilestoneModal">
            <i class="fas fa-plus text-primary"></i> Bulk Add Milestone
        </button>
    </div>
</div>

<div class="row g-5 g-xl-8">
    @foreach (var proj in Model)
    {
        var completed = proj.Milestones.Count(m => m.Status == "Approved");
        var total = proj.Milestones.Count;
        var progress = total > 0 ? (completed * 100) / total : 0;

        <div class="col-xl-4">
            <div class="card card-xl-stretch mb-xl-8 shadow-sm border-0">
                <div class="card-body d-flex flex-column pb-10 pb-lg-15">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center justify-content-between mb-5">
                            <span class="badge badge-light-primary fw-bolder px-4 py-2 rounded-pill">FYP Project</span>
                            <span class="text-muted fw-bold">@proj.CreatedDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <a href="/Supervisor/ProjectDetails/@proj.Id" class="text-dark fw-bolder text-hover-primary fs-3">@proj.Title</a>
                        <p class="text-gray-600 fw-bold fs-6 mt-3">Student: @proj.Student?.FullName</p>
                    </div>

                    <div class="d-flex flex-column mt-5">
                        <div class="d-flex justify-content-between w-100 fs-6 fw-bolder mb-2">
                            <span>Project Progress</span>
                            <span>@progress%</span>
                        </div>
                        <div class="h-8px bg-light rounded mb-3">
                            <div class="bg-primary rounded h-8px" role="progressbar" style="width: @progress%;"></div>
                        </div>
                        <div class="mt-5 pt-3">
                            <a href="/Supervisor/ProjectDetails/@proj.Id" class="btn btn-sm btn-light-primary w-100 fw-bolder">View More <i class="fas fa-arrow-right ms-2 fs-7"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-10">
            <i class="fas fa-folder-open fs-1 text-muted mb-4"></i>
            <h4>No active projects under your supervision.</h4>
        </div>
    }
</div>

<!-- Bulk Add Milestone Modal -->
<div class="modal fade" id="bulkAddMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <form asp-action="BulkAddMilestone" asp-controller="Supervisor" method="post" id="bulkAddForm">
                <div class="modal-header">
                    <h2 class="fw-bolder">Bulk Add Milestone</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                        <i class="fas fa-times fs-1"></i>
                    </div>
                </div>
                <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                    @if (TempData["AddModalError"] != null)
                    {
                        <div class="alert alert-danger bg-light-danger border-danger d-flex align-items-center p-5 mb-7">
                            <i class="fas fa-exclamation-triangle text-danger fs-1 me-4"></i>
                            <div class="d-flex flex-column text-danger pe-0 pe-sm-10">
                                <h4 class="mb-1 text-danger">Validation Error</h4>
                                <span>@TempData["AddModalError"]</span>
                            </div>
                        </div>
                    }
                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required">Milestone Title</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="e.g. FYP 1: Final Report" name="title" required />
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required">Due Date</span>
                        </label>
                        <input type="date" class="form-control form-control-solid" name="dueDate" required />
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="fs-6 fw-bold form-label mb-2">Description</label>
                        <textarea class="form-control form-control-solid" rows="3" name="description" placeholder="Instructions for students..."></textarea>
                    </div>

                    <!-- Checkbox section removed as requested by user -->
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <span class="indicator-label">Submit</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bulk Edit Milestone Modal -->
<div class="modal fade" id="bulkEditMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <form asp-action="BulkEditMilestone" asp-controller="Supervisor" method="post" id="bulkEditForm">
                <div class="modal-header">
                    <h2 class="fw-bolder">Bulk Edit Milestone</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                        <i class="fas fa-times fs-1"></i>
                    </div>
                </div>
                <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                    @if (TempData["EditModalError"] != null)
                    {
                        <div class="alert alert-danger bg-light-danger border-danger d-flex align-items-center p-5 mb-7">
                            <i class="fas fa-exclamation-triangle text-danger fs-1 me-4"></i>
                            <div class="d-flex flex-column text-danger pe-0 pe-sm-10">
                                <h4 class="mb-1 text-danger">Validation Error</h4>
                                <span>@TempData["EditModalError"]</span>
                            </div>
                        </div>
                    }
                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required">Target Milestone to Edit</span>
                        </label>
                        <select name="targetTitle" class="form-select form-select-solid" required>
                            <option value="">-- Select Milestone --</option>
                            @foreach(var t in distinctMilestones)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span>New Title (Optional)</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="Leave blank to keep same" name="newTitle" id="bulkNewTitle" />
                        <small id="bulkTitleWarning" class="text-danger mt-1" style="display: none;"><i class="fas fa-lock me-1"></i>Core system milestone titles cannot be renamed.</small>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span>New Due Date (Optional)</span>
                        </label>
                        <input type="date" class="form-control form-control-solid" name="newDueDate" id="bulkNewDueDate" />
                        <small id="bulkDateWarning" class="text-danger mt-1" style="display: none;"><i class="fas fa-lock me-1"></i>The IAF deadline is centrally managed by the Admin.</small>
                    </div>

                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="fs-6 fw-bold form-label mb-2">New Description (Optional)</label>
                        <textarea class="form-control form-control-solid" rows="3" name="newDescription" placeholder="Leave blank to keep same..."></textarea>
                    </div>

                    <!-- Checkbox section removed as requested by user -->
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bulk Delete Milestone Modal -->
<div class="modal fade" id="bulkDeleteMilestoneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <form asp-action="BulkDeleteMilestone" asp-controller="Supervisor" method="post" id="bulkDeleteForm">
                <div class="modal-header">
                    <h2 class="fw-bolder">Bulk Delete Milestone</h2>
                    <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                        <i class="fas fa-times fs-1"></i>
                    </div>
                </div>
                <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                    <div class="d-flex flex-column mb-7 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold form-label mb-2">
                            <span class="required text-danger">Target Milestone to Delete</span>
                        </label>
                        <select name="targetTitle" class="form-select form-select-solid" required>
                            <option value="">-- Select Milestone --</option>
                            @foreach(var t in distinctMilestones.Where(m => !m.Contains("IAF", StringComparison.OrdinalIgnoreCase) && !m.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) && !m.Contains("Proposal", StringComparison.OrdinalIgnoreCase) && !m.Contains("Final", StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>

                    <!-- Checkbox section removed as requested by user -->
                </div>
                <div class="modal-footer flex-center">
                    <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            function setupDynamicFiltering(formId, rowClass) {
                var form = document.getElementById(formId);
                if(form) {
                    var selectElement = form.querySelector('select[name="targetTitle"]');
                    if(selectElement) {
                        selectElement.addEventListener('change', function() {
                            var selectedTitle = this.value;

                            if (formId === 'bulkEditForm') {
                                var titleInput = document.getElementById('bulkNewTitle');
                                var dateInput = document.getElementById('bulkNewDueDate');
                                var titleWarning = document.getElementById('bulkTitleWarning');
                                var dateWarning = document.getElementById('bulkDateWarning');

                                if (titleInput && dateInput) {
                                    // Reset states
                                    titleInput.readOnly = false;
                                    titleInput.classList.remove('bg-light');
                                    dateInput.readOnly = false;
                                    dateInput.classList.remove('bg-light');
                                    if(titleWarning) titleWarning.style.display = 'none';
                                    if(dateWarning) dateWarning.style.display = 'none';

                                    if (selectedTitle) {
                                        var isIaf = selectedTitle.includes('IAF') || selectedTitle.includes('Initial Project');
                                        var isSystem = isIaf || selectedTitle.includes('Proposal') || selectedTitle.includes('Progress') || selectedTitle.includes('Final');

                                        if (isSystem) {
                                            titleInput.readOnly = true;
                                            titleInput.value = '';
                                            titleInput.classList.add('bg-light');
                                            if(titleWarning) titleWarning.style.display = 'block';
                                        }

                                        if (isIaf) {
                                            dateInput.readOnly = true;
                                            dateInput.value = '';
                                            dateInput.classList.add('bg-light');
                                            if(dateWarning) dateWarning.style.display = 'block';
                                        }
                                    }
                                }
                            }

                            // Student rows removed, no need to filter them here
                        });
                        
                        // Initialize state on load
                        selectElement.dispatchEvent(new Event('change'));
                    }
                }
            }

            setupDynamicFiltering('bulkEditForm');
            setupDynamicFiltering('bulkDeleteForm');

            // --- Auto-trigger modals based on query parameters ---
            const urlParams = new URLSearchParams(window.location.search);
            const action = urlParams.get('action');
            const target = urlParams.get('target');

            if (action === 'bulk-edit') {
                var modalElement = document.getElementById('bulkEditMilestoneModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    if (target) {
                        var select = document.querySelector('#bulkEditForm select[name="targetTitle"]');
                        if(select) { 
                            select.value = target; 
                            select.dispatchEvent(new Event('change')); 
                        }
                    }
                    modal.show();
                }
            } else if (action === 'bulk-delete') {
                var modalElement = document.getElementById('bulkDeleteMilestoneModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    if (target) {
                        var select = document.querySelector('#bulkDeleteForm select[name="targetTitle"]');
                        if(select) { 
                            select.value = target; 
                            select.dispatchEvent(new Event('change')); 
                        }
                    }
                    modal.show();
                }
            } else if (action === 'bulk-add') {
                var modalElement = document.getElementById('bulkAddMilestoneModal');
                if (modalElement) {
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
            }
        });


    </script>
}
