@using FYPTracker.Models
@model IEnumerable<SupervisorRequest>
@{
    ViewData["Title"] = "Student Requests";
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .glass-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .section-title { font-size: .8rem; font-weight: 800; text-transform: uppercase; color: #475569; letter-spacing: .05em; border-bottom: 2px solid #f3f4f6; padding-bottom: 6px; margin-bottom: 12px; }
    
    .info-label { font-size: .75rem; color: #9ca3af; font-weight: 600; text-transform: uppercase; margin-bottom: 2px; }
    .info-value { font-size: .95rem; color: #1f2937; font-weight: 700; margin-bottom: 12px; }
</style>

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-3">@TempData["Success"]</div>
    }

    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-user-clock me-2"></i>Student Supervision Requests</h2>
            <p class="mb-0 opacity-80">Review student applications and approve or reject requests to supervise their projects.</p>
        </div>
        <div class="text-end d-flex flex-wrap gap-2 align-items-center">
            <div class="d-flex align-items-center position-relative my-1">
                <i class="fas fa-user position-absolute ms-3 text-muted"></i>
                <select id="studentFilter" class="form-select border-0 shadow-sm ps-10 w-200px" style="border-radius: 10px;">
                    <option value="">All Students</option>
                    @foreach (var studentName in Model.Select(m => m.Student?.FullName).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s))
                    {
                        <option value="@studentName">@studentName</option>
                    }
                </select>
            </div>
            <div class="d-flex align-items-center position-relative my-1">
                <i class="fas fa-info-circle position-absolute ms-3 text-muted"></i>
                <select id="statusFilter" class="form-select border-0 shadow-sm ps-10 w-150px" style="border-radius: 10px;">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <span class="badge bg-white text-dark fw-bold px-3 py-2 rounded-pill ms-2">
                @Model.Count(r => r.Status == "Pending") Pending Applications
            </span>
        </div>
    </div>

    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr class="text-muted small fw-bold text-uppercase">
                        <th>Student</th>
                        <th>Project Topic</th>
                        <th>Requested Date</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        <tr class="request-item" data-student-name="@req.Student?.FullName" data-status="@req.Status">
                            <td>
                                <div class="fw-bold text-dark">@req.Student?.FullName</div>
                                <div class="text-muted small">Matric: @req.MatricNumber</div>
                            </td>
                            <td>
                                <div class="fw-bold text-primary">@req.ProjectTopic</div>
                                <div class="text-muted small">@(req.RequestMessage?.Length > 50 ? req.RequestMessage.Substring(0, 47) + "..." : req.RequestMessage)</div>
                            </td>
                            <td>@req.RequestedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-light-warning rounded-3 me-1" onclick="viewFullForm(@req.Id, @(req.Status == "Pending" ? "true" : "false"))">
                                    <i class="fas fa-file-alt me-1"></i> Review
                                </button>
                                
                                @if (req.Status == "Pending")
                                {
                                    <div class="d-inline-flex gap-1">
                                        <form asp-action="RespondRequest" method="post" id="acceptForm_@req.Id">
                                            <input type="hidden" name="requestId" value="@req.Id" />
                                            <input type="hidden" name="status" value="Approved" />
                                            <button type="button" class="btn btn-sm btn-success rounded-3 px-3" onclick="confirmAccept(@req.Id, '@req.Student?.FullName')">Accept</button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-3" onclick="openRejectModal(@req.Id, '@req.Student?.FullName')">Reject</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted rounded-pill px-3">@req.Status</span>
                                }
                            </td>
                        </tr>

                        <div id="formData_@req.Id" style="display:none;" 
                             data-name="@req.Student?.FullName" 
                             data-matric="@req.MatricNumber" 
                             data-program="@req.Program" 
                             data-phone="@req.PhoneNumber" 
                             data-session="@req.SessionSemester" 
                             data-topic="@req.ProjectTopic" 
                             data-desc="@req.RequestMessage"
                             data-status="@req.Status">
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- FULL FORM MODAL -->
<div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="fw-bold mb-0">Student Supervision Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-5">
                <div class="section-title">Part A: Personal Information</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="info-label">Full Name</div>
                        <div id="modal_name" class="info-value"></div>
                        <div class="info-label">Matric Number</div>
                        <div id="modal_matric" class="info-value"></div>
                        <div class="info-label">Program</div>
                        <div id="modal_program" class="info-value"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-label">Phone Number</div>
                        <div id="modal_phone" class="info-value"></div>
                        <div class="info-label">Session / Semester</div>
                        <div id="modal_session" class="info-value"></div>
                    </div>
                </div>

                <div class="section-title mt-4">Part B: Project Information</div>
                <div class="info-label">Project Topic</div>
                <div id="modal_topic" class="info-value text-primary fs-5"></div>
                <div class="info-label">Description / Notes</div>
                <div id="modal_desc" class="info-value" style="white-space:pre-wrap; font-weight:400; line-height:1.6;"></div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-between align-items-center bg-light rounded-bottom-4">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
                <div id="modalActionButtons" class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-danger rounded-3 px-4" id="modalBtnReject">Reject</button>
                    <button type="button" class="btn btn-success rounded-3 px-4 fw-bold" id="modalBtnAccept">Approve & Accept</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="RespondRequest" method="post">
                <input type="hidden" name="requestId" id="rejectRequestId" />
                <input type="hidden" name="status" value="Rejected" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold">Reject Application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Please provide a reason for rejecting <strong id="rejectStudentName"></strong>'s request.</p>
                    <textarea name="responseNote" class="form-control rounded-3" rows="3" placeholder="e.g. Research topic not aligned, Supervisor full capacity..." required></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-3 px-4">Confirm Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function viewFullForm(id, isPending) {
        const data = document.getElementById('formData_' + id).dataset;
        document.getElementById('modal_name').textContent = data.name;
        document.getElementById('modal_matric').textContent = data.matric;
        document.getElementById('modal_program').textContent = data.program;
        document.getElementById('modal_phone').textContent = data.phone;
        document.getElementById('modal_session').textContent = data.session;
        document.getElementById('modal_topic').textContent = data.topic;
        document.getElementById('modal_desc').textContent = data.desc;

        var actionGroup = document.getElementById('modalActionButtons');
        if (isPending) {
            actionGroup.classList.remove('d-none');
            actionGroup.classList.add('d-flex');
            document.getElementById('modalBtnReject').onclick = function() {
                bootstrap.Modal.getInstance(document.getElementById('formModal')).hide();
                openRejectModal(id, data.name);
            };
            document.getElementById('modalBtnAccept').onclick = function() {
                bootstrap.Modal.getInstance(document.getElementById('formModal')).hide();
                confirmAccept(id, data.name);
            };
        } else {
            actionGroup.classList.remove('d-flex');
            actionGroup.classList.add('d-none');
        }

        new bootstrap.Modal(document.getElementById('formModal')).show();
    }

    function confirmAccept(id, name) {
        Swal.fire({
            title: 'Accept Application?',
            text: `Are you sure you want to accept ${name} as your FYP student?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#10b981',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Yes, Accept!'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('acceptForm_' + id).submit();
            }
        });
    }

    function openRejectModal(id, name) {
        document.getElementById('rejectRequestId').value = id;
        document.getElementById('rejectStudentName').textContent = name;
        new bootstrap.Modal(document.getElementById('rejectModal')).show();
    }

    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        const openId = urlParams.get('openRequestId');
        if (openId) {
            const dataEl = document.getElementById('formData_' + openId);
            if (dataEl) {
                const isPending = dataEl.dataset.status === 'Pending';
                viewFullForm(openId, isPending);
                
                // Clean up the URL so refreshing doesn't re-open it
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        }

        const reqStudentFilter = document.getElementById('studentFilter');
        const reqStatusFilter = document.getElementById('statusFilter');

        function applyReqFilters() {
            const stVal = reqStudentFilter ? reqStudentFilter.value : '';
            const statVal = reqStatusFilter ? reqStatusFilter.value : '';
            
            const items = document.querySelectorAll('.request-item');
            
            items.forEach(item => {
                const matchSt = !stVal || item.getAttribute('data-student-name') === stVal;
                const matchStat = !statVal || item.getAttribute('data-status') === statVal;
                
                if (matchSt && matchStat) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        if(reqStudentFilter) reqStudentFilter.addEventListener('change', applyReqFilters);
        if(reqStatusFilter) reqStatusFilter.addEventListener('change', applyReqFilters);
    });
</script>
}
