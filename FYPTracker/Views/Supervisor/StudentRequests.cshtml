@using FYPTracker.Models
@model IEnumerable<SupervisorRequest>
@{
    ViewData["Title"] = "Student Requests";
}

<div class="card mb-5 mb-xl-8">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bolder fs-3 mb-1">Incoming Student Supervision Requests</span>
            <span class="text-muted mt-1 fw-bold fs-7">@Model.Count(r => r.Status == "Pending") pending requests</span>
        </h3>
    </div>
    <div class="card-body py-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div class="table-responsive">
            <table class="table align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted bg-light">
                        <th class="ps-4 min-w-150px">Student</th>
                        <th class="min-w-150px">Proposed Topic</th>
                        <th class="min-w-120px">Date Requested</th>
                        <th class="min-w-120px">Status</th>
                        <th class="text-end min-w-200px pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="text-dark fw-bolder text-hover-primary mb-1 fs-6">@req.Student?.FullName</span>
                                <span class="text-muted fw-bold text-muted d-block fs-7">@req.Student?.Email</span>
                            </td>
                            <td><span class="text-dark fw-bold d-block fs-6">@req.RequestMessage</span></td>
                            <td><span class="text-dark fw-bold d-block fs-6">@req.RequestedDate.ToString("dd MMM yyyy")</span></td>
                            <td>
                                @if (req.Status == "Pending")
                                {
                                    <span class="badge badge-light-warning">Pending</span>
                                }
                                else if (req.Status == "Approved")
                                {
                                    <span class="badge badge-light-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge badge-light-danger">Rejected</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (req.Status == "Pending")
                                {
                                    <form asp-action="RespondRequest" method="post" class="d-inline">
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <input type="hidden" name="status" value="Approved" />
                                        <button type="submit" class="btn btn-sm btn-light-success me-2" onclick="return confirm('Approve this request?')">Approve</button>
                                    </form>
                                    <form asp-action="RespondRequest" method="post" class="d-inline">
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <input type="hidden" name="status" value="Rejected" />
                                        <button type="button" class="btn btn-sm btn-light-danger" data-bs-toggle="modal" data-bs-target="#rejectModal_@req.Id">Reject</button>

                                        <!-- Reject Modal -->
                                        <div class="modal fade" id="rejectModal_@req.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content text-start">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Reject Request</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label">Reason for Rejection</label>
                                                            <textarea name="responseNote" class="form-control" rows="3" required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted fw-bold">Responded: @req.RespondedDate?.ToString("dd MMM")</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">No student requests found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
