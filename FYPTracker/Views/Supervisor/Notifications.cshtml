@using FYPTracker.Models
@model IEnumerable<FYPNotification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="card mb-5 mb-xl-8">
    <div class="card-header border-0 pt-5">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bolder fs-3 mb-1">System Notifications</span>
            <span class="text-muted mt-1 fw-bold fs-7">@Model.Count(n => !n.IsRead) unread notifications</span>
        </h3>
        <div class="card-toolbar">
            <button class="btn btn-sm btn-light-primary" onclick="markAllAsRead()">
                <i class="fas fa-check-double"></i> Mark All as Read
            </button>
        </div>
    </div>
    <div class="card-body py-3">
        <div class="timeline">
            @foreach (var notif in Model)
            {
                var iconClass = notif.Type switch {
                    "SubmissionFeedback" => "fa-file-signature text-success",
                    "RevisionRequest" => "fa-exclamation-triangle text-danger",
                    "SupervisorApproval" => "fa-user-check text-primary",
                    "MeetingUpdate" => "fa-calendar-check text-warning",
                    _ => "fa-bell text-info"
                };

                <div class="timeline-item mb-5" onclick="markAsRead(@notif.Id, this)" style="cursor: pointer;">
                    <div class="timeline-line w-40px"></div>
                    <div class="timeline-icon symbol symbol-circle symbol-40px">
                        <div class="symbol-label bg-light">
                            <i class="fas @iconClass fs-2"></i>
                        </div>
                    </div>
                    <div class="timeline-content mt-n1">
                        <div class="pe-3 mb-2">
                            <div class="fs-5 fw-bold mb-1 @(notif.IsRead ? "text-gray-600" : "text-dark")">@notif.Title</div>
                            <div class="d-flex align-items-center mt-1 fs-6">
                                <div class="text-muted me-2 fs-7">@notif.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>
                        </div>
                        <div class="overflow-auto pb-5 @(notif.IsRead ? "text-muted" : "text-dark")">
                            @notif.Message
                        </div>
                    </div>
                </div>
            }
            @if (!Model.Any())
            {
                <div class="text-center py-10 text-muted">No notifications yet.</div>
            }
        </div>
    </div>
</div>

<script>
    function markAsRead(id, elem) {
        if (!elem.querySelector('.text-dark')) return; // Already read

        fetch('/Supervisor/MarkAsRead/' + id, { method: 'POST' })
        .then(response => {
            if (response.ok) {
                location.reload();
            }
        });
    }

    function markAllAsRead() {
        fetch('/Supervisor/MarkAllRead', { method: 'POST' })
        .then(response => {
            if (response.ok) {
                location.reload();
            }
        });
    }
</script>
