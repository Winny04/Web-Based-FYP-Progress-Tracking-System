@model FYPTracker.Models.FYPMilestone
@using System.Collections.Generic
@{
    ViewData["Title"] = "Review Submission";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder text-dark mb-1">Review Submission</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("ReviewSubmissions", "Supervisor")" class="text-decoration-none">Submissions</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("ReviewSubmissions", "Supervisor")" class="btn btn-light-primary fw-bold">
            <i class="fas fa-arrow-left me-2"></i>Back to Submissions
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4 rounded-3 border-danger shadow-sm">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <!-- Details Column -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-4">
                    <h5 class="card-title fw-bold text-dark mb-0">
                        <i class="fas fa-file-alt text-primary me-2"></i>Submission Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="fas fa-user text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">@Model.Project?.Student?.FullName</h6>
                            <span class="text-muted small">@Model.Project?.Student?.EmployeeId</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted text-uppercase fw-bold" style="font-size: 0.8rem; letter-spacing: 1px;">Project Title</h6>
                        <p class="text-dark fw-semibold mb-0">@(Model.Project?.Title ?? "Untitled Project")</p>
                    </div>

                    @{
                        string raw = Model.Remarks ?? "";
                        string parsedJson = "";
                        string formInfo = "";
                        if (raw.Contains("JSON: ")) {
                            var parts = raw.Split(new[] { "JSON: " }, StringSplitOptions.None);
                            formInfo = parts[0].Trim();
                            parsedJson = parts[1];
                        }
                    }

                    @if (!string.IsNullOrEmpty(formInfo))
                    {
                        <div class="alert alert-primary bg-light-primary border-primary border-dashed d-flex align-items-center p-3 mb-4 rounded-3">
                            <i class="fas fa-info-circle fs-3 text-primary me-3"></i>
                            <div class="d-flex flex-column">
                                <span class="fw-bold text-dark">Submission Information</span>
                                <span class="text-muted" style="font-size: 0.9rem;">@formInfo</span>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(parsedJson))
                    {
                        <!-- The iframe to display the generated PDF -->
                        <div class="bg-light rounded-4 border border-secondary border-opacity-25 shadow-sm p-2 mb-4" style="height: 900px;">
                            <h6 class="fw-bold text-primary mb-2 px-2 pt-2">Form Details (PDF)</h6>
                            <iframe id="iafPdfIframe" style="width: 100%; height: 90%; border: none; border-radius: 8px;"></iframe>
                        </div>

                        <!-- Off-screen container for HTML2PDF to read -->
                        <div id="iafPdfSource" style="display: none;">
                            <h4 style="color: #0d6efd; margin-bottom: 20px; font-family: sans-serif;">@Model.Title</h4>
                            <p style="font-family: sans-serif; color: #555;">Student: @Model.Project?.Student?.FullName (@Model.Project?.Student?.EmployeeId)</p>
                            <hr style="border: 1px solid #ddd; margin-bottom: 20px;" />
                            @{
                                try {
                                    var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(parsedJson);
                                    if (dict != null) {
                                        <table style="width: 100%; font-family: sans-serif; font-size: 14px; border-collapse: collapse;">
                                            @foreach (var kvp in dict) {
                                                if (!string.IsNullOrEmpty(kvp.Value)) {
                                                    <tr>
                                                        <td style="width: 30%; font-weight: bold; padding: 8px; border-bottom: 1px solid #eee; vertical-align: top;">@kvp.Key:</td>
                                                        <td style="padding: 8px; border-bottom: 1px solid #eee; white-space: pre-wrap;">
                                                            @if (kvp.Key == "Supervisor Signature") {
                                                                <span style="font-family: 'Brush Script MT', cursive; font-size: 24px; color: #00008B;">@kvp.Value</span>
                                                            } else {
                                                                @kvp.Value
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </table>
                                    }
                                } catch {
                                    <div style="font-family: monospace; white-space: pre-wrap;">@parsedJson</div>
                                }
                            }

                            @if (!string.IsNullOrEmpty(Model.SupervisorFeedback))
                            {
                                <hr style="border: 1px solid #ddd; margin: 20px 0;" />
                                <h5 style="color: #0d6efd; font-family: sans-serif;">Supervisor's Feedback</h5>
                                <p style="font-family: sans-serif; font-size: 14px; white-space: pre-wrap; background-color: #f8f9fa; padding: 15px; border-left: 4px solid #198754; color: #333;">@Model.SupervisorFeedback</p>
                            }
                        </div>
                    }

                    @if (Model.SubmissionFiles != null && Model.SubmissionFiles.Any())
                    {
                        var studentFiles = Model.SubmissionFiles.Where(f => f.UploadedBy == Model.Project?.StudentId).ToList();
                        var supervisorFiles = Model.SubmissionFiles.Where(f => f.UploadedBy != Model.Project?.StudentId).ToList();

                        if (studentFiles.Any())
                        {
                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Student Attached Files</h6>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var file in studentFiles)
                                    {
                                        <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = file.Id })" target="_blank" class="btn btn-outline-secondary text-start d-flex align-items-center rounded-3 p-3 text-decoration-none">
                                            <i class="fas fa-paperclip text-muted me-3"></i>
                                            <span class="text-dark fw-medium text-truncate flex-grow-1">@file.FileName</span>
                                            <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        if (supervisorFiles.Any())
                        {
                            <div class="mb-0">
                                <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Graded / Feedback Files</h6>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var file in supervisorFiles)
                                    {
                                        <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = file.Id })" target="_blank" class="btn btn-outline-primary text-start d-flex align-items-center rounded-3 p-3 text-decoration-none bg-light-primary border-primary border-opacity-25">
                                            <i class="fas fa-file-pdf text-primary me-3"></i>
                                            <span class="text-dark fw-bold text-truncate flex-grow-1">@file.FileName</span>
                                            <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Grading Column -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 2rem;">
                <div class="card-header bg-white border-bottom py-4">
                    <h5 class="card-title fw-bold text-dark mb-0">
                        <i class="fas fa-check-circle text-success me-2"></i>Grading Action
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ReviewSubmission" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="milestoneId" value="@Model.Id" />
                        
                        @{
                            bool isLocked = Model.Status == "Approved" || Model.Status == "Rejected";
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-signature text-primary me-2"></i>Supervisor Signature</label>
                                <input type="text" name="supervisorSignature" class="form-control form-control-solid form-control-lg border-primary bg-light-primary" placeholder="Type your full name to digitally sign" @(isLocked ? "disabled" : "required") />
                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Required to officially approve the Initial Project Allocation Form.</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Title) && Model.Title.Contains("Progress", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-percentage text-primary me-2"></i>Completion Rating</label>
                                <select name="pctComplete" class="form-select form-select-solid form-select-lg" @(isLocked ? "disabled" : "required")>
                                    <option value="">- Select rating -</option>
                                    <option value="10%">10%</option>
                                    <option value="25%">25%</option>
                                    <option value="50%">50%</option>
                                    <option value="75%">75%</option>
                                    <option value="90%">90%</option>
                                    <option value="100%">100%</option>
                                </select>
                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Rate the student's progress.</div>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Decision</label>
                            <select name="status" class="form-select form-select-solid form-select-lg" @(isLocked ? "disabled" : "required")>
                                <option value="">- Select a decision -</option>
                                <option value="Approved" selected="@(Model.Status == "Approved")">Approve (Passed)</option>
                                <option value="Rejected" selected="@(Model.Status == "Rejected")">Reject (Needs Revision)</option>
                                <option value="UnderReview" selected="@(Model.Status == "UnderReview")">Mark as Needs Attention</option>
                            </select>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Feedback / Remarks</label>
                            <textarea name="remarks" class="form-control form-control-solid rounded-3" rows="6" placeholder="Provide detailed feedback for the student here..." @(isLocked ? "readonly" : "")>@Model.SupervisorFeedback</textarea>
                            <div class="form-text mt-2">This feedback will be visible to the student immediately.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark"><i class="fas fa-file-pdf text-danger me-2"></i>Upload Graded File (Optional)</label>
                            <input type="file" name="gradedFile" accept=".pdf" class="form-control form-control-solid form-control-lg" @(isLocked ? "disabled" : "") />
                            <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Upload a marked/graded version of the student's submission.</div>
                        </div>

                        @if (isLocked)
                        {
                            <div class="alert alert-warning mt-4 mb-0 border-warning shadow-sm">
                                <i class="fas fa-lock me-2 text-warning"></i>This submission has already been reviewed and locked.
                            </div>
                        }
                        else
                        {
                            <div class="d-grid mt-5">
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">
                                    <i class="fas fa-save me-2"></i>Submit Review
                                </button>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async function() {
            const source = document.getElementById('iafPdfSource');
            const iframe = document.getElementById('iafPdfIframe');
            
            if (source && iframe) {
                // Ensure html2pdf is loaded
                if (typeof html2pdf === 'undefined') return;

                const opt = {
                    margin: 0.5,
                    filename: 'FormDetails.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true },
                    jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
                };

                const htmlString = `
                    <div style="width: 800px; padding: 20px; background: white;">
                        ${source.innerHTML}
                    </div>
                `;

                try {
                    // Generate PDF as blob and show in iframe
                    const pdfBlob = await html2pdf().set(opt).from(htmlString).outputPdf('blob');
                    const url = URL.createObjectURL(pdfBlob);
                    iframe.src = url;
                } catch(e) {
                    console.error("PDF generation failed", e);
                    iframe.parentElement.innerHTML = '<div class="alert alert-warning m-3">Failed to load PDF preview.</div>';
                }
            }
        });
    </script>
}
