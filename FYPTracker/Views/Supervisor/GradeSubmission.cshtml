@model FYPTracker.Models.FYPMilestone
@inject FYPTracker.Models.FYPTrackerContext _context
@using System.Collections.Generic
@{
    ViewData["Title"] = "Review Submission";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var adminUser = _context.ApplicationUsers.FirstOrDefault(u => u.UserRoles.Any(r => r.Role.Name == "Admin"));
    var moduleLeaderName = adminUser?.FullName ?? "Admin";
}

<div class="container-fluid px-4 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder text-dark mb-1">Review Submission</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("ReviewSubmissions", "Supervisor")" class="text-decoration-none">Submissions</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("ReviewSubmissions", "Supervisor")" class="btn btn-light-primary fw-bold">
            <i class="fas fa-arrow-left me-2"></i>Back to Submissions
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
        </div>
    }

    <style>
        .iaf-table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px; }
        .iaf-table, .iaf-table th, .iaf-table td { border: 1px solid #ccc; }
        .iaf-table th, .iaf-table td { padding: 8px; vertical-align: top; text-align: left; }
        .iaf-label { font-weight: bold; width: 30%; }
        .iaf-value { width: 70%; white-space: pre-wrap; }
        .iaf-attempt-card { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; padding: 12px 16px; border: 1px solid #e4e6ef; background-color: #fff; border-radius: 10px; transition: box-shadow .2s ease, transform .2s ease; }
        .iaf-attempt-card:hover { box-shadow: 0 4px 14px rgba(13,110,253,0.10); transform: translateY(-1px); }
        .iaf-attempt-card .iaf-attempt-title { font-weight: 700; color: #0d6efd; margin: 0; }
        .iaf-attempt-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 12px; }
        .iaf-readonly-view .iaf-value { background: #fff; }
        @@media print {
            .iaf-attempt-card { box-shadow: none; }
        }
    </style>

    @if (Model.Status == "DefenseScheduled")
    {
        <div class="alert alert-danger mb-4 rounded-3 shadow-sm d-flex justify-content-between align-items-center" style="border: 2px solid #f1416c;">
            <div>
                <h5 class="fw-bold mb-1"><i class="fas fa-lock me-2"></i>Submission Locked (Defense Required)</h5>
                <p class="mb-0">This student is required to attend a Defense Session. They cannot re-submit the digital form until the Admin unlocks it after their Defense Session.</p>
            </div>
            
        </div>
    }

    <div class="row g-4">
        <!-- Details Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-4">
                    <h5 class="card-title fw-bold text-dark mb-0">
                        <i class="fas fa-file-alt text-primary me-2"></i>Submission Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="fas fa-user text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">@Model.Project?.Student?.FullName</h6>
                            <span class="text-muted small">@Model.Project?.Student?.EmployeeId</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted text-uppercase fw-bold" style="font-size: 0.8rem; letter-spacing: 1px;">Project Title</h6>
                        <p class="text-dark fw-semibold mb-0">@(Model.Project?.Title ?? "Untitled Project")</p>
                    </div>

                    @{
                        string raw = Model.Remarks ?? "";
                        string parsedJson = "";
                        string formInfo = "";
                        if (raw.Contains("JSON: ")) {
                            var parts = raw.Split(new[] { "JSON: " }, StringSplitOptions.None);
                            formInfo = parts[0].Trim();
                            parsedJson = parts[1];
                        }
                    }

                    @if (!string.IsNullOrEmpty(formInfo))
                    {
                        <div class="alert alert-primary bg-light-primary border-primary border-dashed d-flex align-items-center p-3 mb-4 rounded-3">
                            <i class="fas fa-info-circle fs-3 text-primary me-3"></i>
                            <div class="d-flex flex-column">
                                <span class="fw-bold text-dark">Submission Information</span>
                                <span class="text-muted" style="font-size: 0.9rem;">@formInfo</span>
                            </div>
                        </div>
                    }

                    @{
                        bool isProposalOrProgress = false;
                        if (!string.IsNullOrEmpty(formInfo)) {
                            var fi = formInfo.ToLower();
                            if (fi.Contains("proposal") || fi.Contains("progress")) {
                                isProposalOrProgress = true;
                            }
                        }
                    }
                    @if (!string.IsNullOrEmpty(parsedJson) && !isProposalOrProgress)
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary mb-3">Form Details & History</h6>
                            @{
                                try {
                                    var history = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(parsedJson);
                                    if (history.Attempts.Count == 0) {
                                        <div class="alert alert-danger font-monospace">
                                            <strong>Warning: ParseOrMigrate returned 0 attempts.</strong><br/><br/>
                                            Raw JSON input: @parsedJson
                                        </div>
                                    }
                                    
                                    foreach (var attempt in history.Attempts.OrderByDescending(a => a.AttemptNumber)) {
                                        var snapshotFile = Model.SubmissionFiles?.FirstOrDefault(f => f.AttemptNumber == attempt.AttemptNumber && f.FileName.StartsWith("Signed IAF"));
                                        var fd = attempt.FormData ?? new Dictionary<string, string>();
                                        string Fv(string k) => fd.TryGetValue(k, out var v) ? v : "";
                                        var isSigned = !string.IsNullOrEmpty(attempt.SupervisorSignature);
                                        var modalId = $"iafAttemptModal{attempt.AttemptNumber}";
                                        var attStatus = string.IsNullOrEmpty(attempt.Status) ? "Pending" : attempt.Status;
                                        var statusBadge = attStatus switch {
                                            "Approved" or "AdminApproved" or "SupervisorSigned" => "badge-light-success",
                                            "Rejected" or "PanelRevisionRequired" or "ChangeOfTopicRequired" or "ReturnedForEdits" => "badge-light-danger",
                                            "Draft" => "badge-light-secondary",
                                            _ => "badge-light-warning"
                                        };

                                        <div class="iaf-attempt-card" id="iafAttemptCard@(attempt.AttemptNumber)">
                                            <div>
                                                <p class="iaf-attempt-title">Attempt @attempt.AttemptNumber @(attempt.AttemptNumber == history.CurrentAttempt ? "(Latest)" : "")</p>
                                                <div class="iaf-attempt-meta mt-1">
                                                    <span class="badge @statusBadge">@attStatus</span>
                                                    @if (isSigned) {
                                                        <span class="badge badge-light-success"><i class="fas fa-signature me-1 text-success"></i>Supervisor Signed</span>
                                                    } else {
                                                        <span class="badge badge-light-secondary"><i class="fas fa-hourglass-half me-1"></i>Not Signed</span>
                                                    }
                                                    <span class="text-muted"><i class="far fa-calendar me-1"></i>Reviewed: @(attempt.SupervisorReviewedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")</span>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-sm btn-light-primary" id="btnViewIaf@(attempt.AttemptNumber)" data-toggle="modal" data-target="#@modalId"><i class="fas fa-eye me-1"></i>View IAF</button>
                                                @if (snapshotFile != null) {
                                                    <a class="btn btn-sm btn-light" id="btnDownloadIaf@(attempt.AttemptNumber)" href="@Url.Action("DownloadFile", "Supervisor", new { fileId = snapshotFile.Id })"><i class="fas fa-download me-1"></i>Download PDF</a>
                                                }
                                            </div>
                                        </div>

                                        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Initial Project Allocation Form — Attempt @attempt.AttemptNumber</h5>
                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                    </div>
                                                    <div class="modal-body iaf-readonly-view">
                                                        <table class="iaf-table">
                                                            <tr><td class="iaf-label">Course Code</td><td class="iaf-value">6002CMD</td></tr>
                                                              <tr><td class="iaf-label">Module Leader Name</td><td class="iaf-value">@moduleLeaderName</td></tr>
                                                              <tr><td class="iaf-label">Project Title</td><td class="iaf-value">@Fv("title")</td></tr>
                                                            <tr><td class="iaf-label">Scope of Project</td><td class="iaf-value">@Fv("scope")</td></tr>
                                                            <tr><td class="iaf-label">Problem Statement</td><td class="iaf-value">@Fv("problem")</td></tr>
                                                            <tr><td class="iaf-label">Objective 1</td><td class="iaf-value">@Fv("obj1")</td></tr>
                                                            <tr><td class="iaf-label">Objective 2</td><td class="iaf-value">@Fv("obj2")</td></tr>
                                                            <tr><td class="iaf-label">Objective 3</td><td class="iaf-value">@Fv("obj3")</td></tr>
                                                            <tr><td class="iaf-label">Agreed Supervisor Name</td><td class="iaf-value">@Fv("agreedSupervisor")</td></tr>
                                                            <tr><td class="iaf-label">Supervisor's name</td><td class="iaf-value" style="background-color: #DBE5F1;">@Model.Project?.Supervisor?.FullName</td></tr>
                                                            <tr>
                                                                <td class="iaf-label">Supervisor's signature</td>
                                                                <td class="iaf-value" style="background-color: #DBE5F1;">
                                                                    @if (isSigned) {
                                                                        if (attempt.SupervisorSignature.StartsWith("data:image/")) {
                                                                            <img src="@attempt.SupervisorSignature" alt="Supervisor Signature" style="max-height: 80px; max-width: 250px;" />
                                                                        } else {
                                                                            <span style="font-family: 'Brush Script MT', cursive; font-size: 24px; color: #00008B;">@attempt.SupervisorSignature</span>
                                                                        }
                                                                    } else {
                                                                        <span class="text-muted fst-italic">Not signed</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                            <tr><td class="iaf-label">Comment/Feedback</td><td class="iaf-value">@attempt.SupervisorFeedback</td></tr>
                                                            @if (!string.IsNullOrEmpty(attempt.PanelComments)) {
                                                                <tr><td class="iaf-label">Panel Comments</td><td class="iaf-value">@attempt.PanelComments</td></tr>
                                                            }
                                                        </table>
                                                    </div>
                                                    <div class="modal-footer">
                                                        @if (snapshotFile != null) {
                                                            <a class="btn btn-sm btn-light" href="@Url.Action("DownloadFile", "Supervisor", new { fileId = snapshotFile.Id })"><i class="fas fa-download me-1"></i>Download PDF</a>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-primary" data-dismiss="modal">Close</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                } catch (Exception ex) {
                                    <div class="alert alert-danger font-monospace">
                                        <strong>Error parsing JSON:</strong> @ex.Message<br/><br/>
                                        Raw JSON: @parsedJson
                                    </div>
                                }
                            }

                            @if (!string.IsNullOrEmpty(Model.SupervisorFeedback))
                            {
                                <hr style="border: 1px solid #ddd; margin: 20px 0;" />
                                <h5 style="color: #0d6efd; font-family: sans-serif;">Supervisor's Overall Feedback</h5>
                                <p style="font-family: sans-serif; font-size: 14px; white-space: pre-wrap; background-color: #f8f9fa; padding: 15px; border-left: 4px solid #198754; color: #333;">@Model.SupervisorFeedback</p>
                            }
                        </div>
                    }
                    
                    @if (Model.SubmissionFiles != null && Model.SubmissionFiles.Any(f => f.UploadedBy == Model.Project?.StudentId))
                    {
                        var primaryFile = Model.SubmissionFiles.Where(f => f.UploadedBy == Model.Project?.StudentId).OrderByDescending(f => f.AttemptNumber).FirstOrDefault();
                        if (primaryFile != null)
                        {
                            <div class="bg-light rounded-4 border border-secondary border-opacity-25 shadow-sm p-2 mb-4" style="height: 900px;">
                                <h6 class="fw-bold text-primary mb-2 px-2 pt-2">Student Attached Document (@primaryFile.FileName)</h6>
                                <iframe src="@Url.Action("ViewFile", "Supervisor", new { fileId = primaryFile.Id })" style="width: 100%; height: 90%; border: none; border-radius: 8px;"></iframe>
                            </div>
                        }
                    }

                    @if (Model.SubmissionFiles != null && Model.SubmissionFiles.Any())
                    {
                        var studentFiles = Model.SubmissionFiles.Where(f => f.UploadedBy == Model.Project?.StudentId).OrderByDescending(f => f.AttemptNumber).ToList();
                        var supervisorFiles = Model.SubmissionFiles.Where(f => f.UploadedBy != Model.Project?.StudentId).ToList();

                        if (studentFiles.Any())
                        {
                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Student Attached Files (Version History)</h6>
                                <div class="d-flex flex-column gap-3">
                                    @for (int i = 0; i < studentFiles.Count; i++)
                                    {
                                        var file = studentFiles[i];
                                        // Find the most recent file from a PREVIOUS attempt
                                        var previousFile = studentFiles.FirstOrDefault(f => f.AttemptNumber < file.AttemptNumber);
                                        
                                        <div class="card border-0 shadow-sm rounded-3">
                                            <div class="card-body p-3 d-flex flex-column gap-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = file.Id })" target="_blank" class="text-dark fw-bold text-decoration-none d-flex align-items-center">
                                                        <i class="fas fa-paperclip text-primary me-2"></i> @file.FileName <span class="badge bg-secondary ms-2">Attempt @file.AttemptNumber</span>
                                                    </a>
                                                    @if (previousFile != null)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-primary" data-toggle="modal" data-target="#compareModal" onclick="setupCompareModal('@Url.Action("ViewFile", "Supervisor", new { fileId = previousFile.Id })', '@Url.Action("ViewFile", "Supervisor", new { fileId = file.Id })')">
                                                            <i class="fas fa-columns me-1"></i> Compare with Attempt @previousFile.AttemptNumber
                                                        </button>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(file.RevisionNotes))
                                                {
                                                    <div class="alert alert-warning m-0 p-2 mt-2 border-0">
                                                        <div class="fw-bold text-dark" style="font-size:0.85rem;"><i class="fas fa-history text-danger me-1"></i> Revision Notes:</div>
                                                        <div class="text-dark small">@file.RevisionNotes</div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        if (supervisorFiles.Any())
                        {
                            <div class="mb-0">
                                <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Graded / Feedback Files</h6>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var file in supervisorFiles)
                                    {
                                        <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = file.Id })" target="_blank" class="btn btn-outline-primary text-start d-flex align-items-center rounded-3 p-3 text-decoration-none bg-light-primary border-primary border-opacity-25">
                                            <i class="fas fa-file-pdf text-primary me-3"></i>
                                            <span class="text-dark fw-bold text-truncate flex-grow-1">@file.FileName</span>
                                            <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        string supStrengths = "", supImprovements = "", supComments = "";
                        if (!string.IsNullOrEmpty(Model.SupervisorMarksheetData) && Model.SupervisorMarksheetData.StartsWith("{"))
                        {
                            using var doc = System.Text.Json.JsonDocument.Parse(Model.SupervisorMarksheetData);
                            if (doc.RootElement.TryGetProperty("Strengths", out var sProp)) supStrengths = sProp.GetString();
                            if (doc.RootElement.TryGetProperty("Improvements", out var iProp)) supImprovements = iProp.GetString();
                            if (doc.RootElement.TryGetProperty("Comments", out var cProp)) supComments = cProp.GetString();
                        }
                        
                        if (!string.IsNullOrEmpty(supStrengths) || !string.IsNullOrEmpty(supImprovements) || !string.IsNullOrEmpty(supComments))
                        {
                            <div class="mb-0 mt-4 border-top pt-4">
                                <h6 class="text-primary text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;"><i class="fas fa-magic me-2"></i>Extracted from Marksheet</h6>
                                
                                @if (!string.IsNullOrEmpty(supStrengths))
                                {
                                    <div class="mb-3">
                                        <div class="fw-bold text-dark fs-7 mb-1">Strengths of Report</div>
                                        <div class="bg-light p-2 rounded text-muted fs-7">@supStrengths</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(supImprovements))
                                {
                                    <div class="mb-3">
                                        <div class="fw-bold text-dark fs-7 mb-1">Areas for Improvement</div>
                                        <div class="bg-light p-2 rounded text-muted fs-7">@supImprovements</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(supComments))
                                {
                                    <div class="mb-3">
                                        <div class="fw-bold text-dark fs-7 mb-1">Additional Comments</div>
                                        <div class="bg-light p-2 rounded text-muted fs-7">@supComments</div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Grading Column -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 2rem;">
                <div class="card-header bg-white border-bottom py-4">
                    <h5 class="card-title fw-bold text-dark mb-0">
                        <i class="fas fa-check-circle text-success me-2"></i>Grading Action
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.MilestoneSource == "Supervisor" && Model.Stage == 1)
                    {
                        <div class="mb-3">
                            <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3 py-2"><i class="fas fa-tasks me-1"></i>DPP Work &amp; Progress (not a formal submission)</span>
                            <div class="small text-muted mt-2">Current status: <strong>@(Model.Status == "PendingSupervisorReview" ? "Pending Supervisor Review" : Model.Status == "ReturnedForChanges" ? "Returned for Changes" : Model.Status)</strong></div>
                        </div>
                        @if (Model.Status == "PendingSupervisorReview")
                        {
                            <form asp-action="ReviewProgressMilestone" method="post">
                                <input type="hidden" name="milestoneId" value="@Model.Id" />
                                <label class="form-label fw-bold text-dark" for="progressFeedback">Supervisor Feedback</label>
                                <textarea id="progressFeedback" name="feedback" class="form-control mb-3" rows="4" placeholder="Required when returning for changes">@Model.SupervisorFeedback</textarea>
                                <div class="d-flex gap-2">
                                    <button type="submit" name="decision" value="return" id="btnProgressReturn" class="btn btn-outline-warning fw-bold flex-fill"><i class="fas fa-undo me-1"></i>Return for Changes</button>
                                    <button type="submit" name="decision" value="complete" id="btnProgressComplete" class="btn btn-success fw-bold flex-fill"><i class="fas fa-check me-1"></i>Mark Completed</button>
                                </div>
                            </form>
                        }
                        else if (!string.IsNullOrEmpty(Model.SupervisorFeedback))
                        {
                            <div class="alert alert-light border small mb-0"><strong>Feedback:</strong> @Model.SupervisorFeedback</div>
                        }
                    }
                    else
                    {
                    <form class="needs-validation" novalidate asp-action="ReviewSubmission" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="milestoneId" value="@Model.Id" />
                        
                        @{
                            // Lock the form if the milestone has already been graded
                            bool isLocked = Model.Status == "Approved" || Model.Status == "Rejected" || Model.Status == "SupervisorSigned" || Model.Status == "ReturnedForEdits" || Model.Status == "PendingPanelReview" || Model.Status == "DefenseRequired" || Model.Status == "DefenseScheduled" || Model.Status == "AdminApproved" || Model.Status == "Completed";
                            bool isMarksheetStage = !string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Final Report", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase));
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-signature text-primary me-2"></i>Supervisor Signature</label>
                                
                                <div class="btn-group w-100 mb-3" role="group">
                                    <input type="radio" class="btn-check" name="sigMethod" id="sigTypeDraw" value="draw" checked @(isLocked ? "disabled" : "")>
                                    <label class="btn btn-outline-primary" for="sigTypeDraw">Draw</label>
                                    
                                    <input type="radio" class="btn-check" name="sigMethod" id="sigTypeType" value="type" @(isLocked ? "disabled" : "")>
                                    <label class="btn btn-outline-primary" for="sigTypeType">Type</label>
                                    
                                    <input type="radio" class="btn-check" name="sigMethod" id="sigTypeManual" value="manual" @(isLocked ? "disabled" : "")>
                                    <label class="btn btn-outline-primary" for="sigTypeManual">Manual</label>
                                </div>
                                
                                <input type="hidden" name="supervisorSignature" id="supervisorSignatureHidden" />

                                <div id="sigDrawArea" class="border rounded bg-white overflow-hidden position-relative" style="height: 150px; border-color: #dee2e6;">
                                    <canvas id="signatureCanvas" style="width: 100%; height: 100%; cursor: crosshair; touch-action: none;" @(isLocked ? "style='pointer-events:none;'" : "")></canvas>
                                    @if(!isLocked)
                                    {
                                        <button type="button" class="btn btn-sm btn-light position-absolute top-0 end-0 m-2 shadow-sm border" onclick="clearSignature()"><i class="fas fa-eraser"></i> Clear</button>
                                    }
                                </div>

                                <div id="sigTypeArea" class="d-none">
                                    <input type="text" id="typedSignature" class="form-control form-control-lg form-control-solid" placeholder="Type your full name..." style="font-family: 'Brush Script MT', cursive; font-size: 24px;" @(isLocked ? "disabled" : "") />
                                </div>

                                <div id="sigManualArea" class="d-none bg-light-info border-info border rounded p-3 text-center">
                                    <i class="fas fa-file-upload fs-3 text-info mb-2"></i>
                                    <p class="mb-0 small text-dark fw-semibold">You have chosen manual signature. Please upload the physical signed document below.</p>
                                </div>

                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Required to officially approve the Initial Project Allocation Form.</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Title) && Model.Title.Contains("Progress", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-percentage text-primary me-2"></i>Completion Rating</label>
                                <select name="pctComplete" class="form-select form-select-solid form-select-lg" @(isLocked ? "disabled" : "required")>
                                    <option value="">- Select rating -</option>
                                    <option value="10%">10%</option>
                                    <option value="25%">25%</option>
                                    <option value="50%">50%</option>
                                    <option value="75%">75%</option>
                                    <option value="90%">90%</option>
                                    <option value="100%">100%</option>
                                </select>
                                <div class="invalid-feedback">Please select a completion rating.</div>
                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Rate the student's progress.</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Turnitin", StringComparison.OrdinalIgnoreCase)))
                        {

                            <div class="mb-4 p-3 bg-light-warning border border-warning border-dashed rounded-3">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-search text-warning me-2"></i>Turnitin Similarity Index (%)</label>
                                <input type="number" name="turnitinScore" class="form-control form-control-solid form-control-lg" min="0" max="100" value="@Model.Project?.TurnitinScore" placeholder="e.g. 14" @(isLocked ? "disabled" : "required") />
                                <div class="invalid-feedback">Please enter the Turnitin score.</div>
                                <div class="form-text text-muted mt-2"><i class="fas fa-exclamation-triangle me-1 text-warning"></i>Must be 20% or less to approve the Turnitin Report. The examiner cannot grade until this is approved.</div>
                            </div>
                        }


                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Feedback / Remarks</label>
                            <textarea name="remarks" id="remarks" class="form-control form-control-solid rounded-3" rows="6" placeholder="Provide detailed feedback for the student here..." @(isLocked ? "readonly" : "required")>@Model.SupervisorFeedback</textarea>
                            <div class="invalid-feedback">Please provide feedback or remarks.</div>
                            
                            <div class="form-text mt-2">This feedback will be visible to the student immediately.</div>
                        </div>

                        <div class="mb-4">
                            @if (!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)))
                            {
                                <label class="form-label fw-bold text-dark"><i class="fas fa-file-upload text-danger me-2"></i>Optional Feedback / Signed Document</label>
                            }
                            else
                            {
                                <label class="form-label fw-bold text-dark"><i class="fas fa-file-upload text-danger me-2"></i>Upload Feedback File / Graded Marksheet</label>
                            }
                            @if (Model.Title.Contains("Final Report", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="mb-3 p-3 bg-light rounded border">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-bold mb-1"><i class="fas fa-file-excel text-success me-2"></i>Excel Marksheet Template</h6>
                                            <small class="text-muted">Download this template, fill in your marks, and upload it back here as the Graded Marksheet below.</small>
                                        </div>
                                        <a href="@Url.Action("DownloadMarksheet", "Supervisor", new { projectId = Model.Project.Id })" class="btn btn-sm btn-outline-success">
                                            <i class="fas fa-download me-1"></i> Download
                                        </a>
                                    </div>
                                </div>
                            }

                            @if (isMarksheetStage)
                            {
                                <input type="file" id="gradedFile" name="gradedFile" accept=".xls,.xlsx" class="form-control form-control-solid form-control-lg" @(isLocked ? "disabled" : "") />
                                <div class="invalid-feedback">You must upload the completed Excel marksheet to approve or reject this milestone.</div>
                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Upload a marked/feedback version of the student's submission or your completed Excel marksheet (PDF, Word, or Excel).</div>
                            }
                            else if (!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)))
                            {
                                <input type="file" id="gradedFile" name="gradedFile" accept=".pdf,.doc,.docx,.xls,.xlsx" class="form-control form-control-solid form-control-lg" @(isLocked ? "disabled" : "") />
                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Upload an optionally signed document (PDF, Word, or Image).</div>
                            }
                            else
                            {
                                <input type="file" id="gradedFile" name="gradedFile" accept=".pdf,.doc,.docx,.xls,.xlsx" class="form-control form-control-solid form-control-lg" @(isLocked ? "disabled" : "") />
                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Upload a marked/feedback version of the student's submission (PDF, Word, or Excel).</div>
                            }
                        </div>

                        @if (isLocked)
                        {
                            <div class="alert alert-warning mt-4 mb-0 border-warning shadow-sm">
                                <i class="fas fa-lock me-2 text-warning"></i>This submission has already been reviewed and locked.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2 mt-5">
                                @if (!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)))
                                {
                                    <button type="submit" name="status" value="Approved" class="btn btn-success btn-lg rounded-3 fw-bold shadow-sm flex-fill" style="flex: 1 1 auto; min-width: 120px;" onclick="if(typeof updateSignatureData === 'function') updateSignatureData();">
                                        <i class="fas fa-check-circle me-1"></i> Acknowledge (Sign)
                                    </button>
                                    <button type="submit" name="status" value="Rejected" class="btn btn-warning btn-lg rounded-3 fw-bold shadow-sm flex-fill text-dark" style="flex: 1 1 auto; min-width: 120px;" onclick="if(typeof updateSignatureData === 'function') updateSignatureData();">
                                        <i class="fas fa-undo me-1"></i> Return to Student for Edits
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" name="status" value="Approved" class="btn btn-success btn-lg rounded-3 fw-bold shadow-sm flex-fill" style="flex: 1 1 auto; min-width: 120px;" onclick="if(typeof updateSignatureData === 'function') updateSignatureData();">
                                        <i class="fas fa-check-circle me-1"></i> Approve
                                    </button>
                                    <button type="submit" name="status" value="Rejected" class="btn btn-warning btn-lg rounded-3 fw-bold shadow-sm flex-fill text-dark" style="flex: 1 1 auto; min-width: 120px;" onclick="if(typeof updateSignatureData === 'function') updateSignatureData();">
                                        <i class="fas fa-edit me-1"></i> Request Revision
                                    </button>
                                    <button type="submit" name="status" value="UnderReview" class="btn btn-danger btn-lg rounded-3 fw-bold shadow-sm flex-fill" style="flex: 1 1 auto; min-width: 120px;" onclick="if(typeof updateSignatureData === 'function') updateSignatureData();">
                                        <i class="fas fa-times-circle me-1"></i> Reject
                                    </button>
                                }
                            </div>
                        }
                    </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function() {
            const iframe = document.getElementById('iafPdfIframe');
            if (iframe) {
                // If it's already set to a PDF URL in the HTML, we don't need to generate it.
            }
        });

        // Real-time Bootstrap Validation
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            // Validate on input/change
            form.addEventListener('input', function(e) {
                if (e.target.hasAttribute('required')) {
                    if (e.target.checkValidity()) {
                        e.target.classList.remove('is-invalid');
                        e.target.classList.add('is-valid');
                    } else {
                        e.target.classList.remove('is-valid');
                        e.target.classList.add('is-invalid');
                    }
                }
            });
            form.addEventListener('change', function(e) {
                if (e.target.hasAttribute('required') && e.target.tagName === 'SELECT') {
                    if (e.target.checkValidity()) {
                        e.target.classList.remove('is-invalid');
                        e.target.classList.add('is-valid');
                    } else {
                        e.target.classList.remove('is-valid');
                        e.target.classList.add('is-invalid');
                    }
                }
            });

            // Track clicked button for max compatibility
            let clickedSubmitButton = null;
            const submitButtons = form.querySelectorAll('button[type="submit"]');
            submitButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    clickedSubmitButton = this;
                });
            });

            // Validate on submit
            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                
                const submitter = event.submitter || clickedSubmitButton;
                
                if (!form.checkValidity()) {
                    event.stopPropagation();
                    form.classList.add('was-validated');
                    return;
                }
                form.classList.add('was-validated');
                
                const submitBtn = submitter || form.querySelector('button[type="submit"]');
                const originalBtnText = submitBtn ? submitBtn.innerHTML : '';
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Submitting...';
                }

                try {
                    const formData = new FormData(form);
                    if (submitter && submitter.name) {
                        formData.append(submitter.name, submitter.value);
                    }
                    const actionUrl = form.getAttribute('action') || window.location.href;
                    
                    const response = await fetch(actionUrl, {
                        method: form.getAttribute('method') || 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            window.location.href = '@Url.Action("ReviewSubmissions", "Supervisor")';
                        }
                    } else {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnText;
                        }
                        
                        let errorMsg = "A server error occurred. Please try again.";
                        try {
                            const errData = await response.json();
                            errorMsg = errData.message || errorMsg;
                        } catch(e) {
                            if (response.status === 400) errorMsg = "Validation failed. Please check your inputs.";
                            if (response.status === 500) errorMsg = "A database transaction error occurred. Your input has been saved locally, please try again.";
                        }
                        
                        let errorContainer = document.getElementById('ajax-error-container');
                        if (!errorContainer) {
                            errorContainer = document.createElement('div');
                            errorContainer.id = 'ajax-error-container';
                            form.insertBefore(errorContainer, form.firstChild);
                        }
                        errorContainer.innerHTML = `<div class="alert alert-danger shadow-sm border-danger"><i class="fas fa-exclamation-circle me-2"></i>${errorMsg}</div>`;
                    }
                } catch (error) {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnText;
                    }
                    
                    let errorContainer = document.getElementById('ajax-error-container');
                    if (!errorContainer) {
                        errorContainer = document.createElement('div');
                        errorContainer.id = 'ajax-error-container';
                        form.insertBefore(errorContainer, form.firstChild);
                    }
                    errorContainer.innerHTML = `<div class="alert alert-danger shadow-sm border-danger"><i class="fas fa-wifi me-2"></i>Network error occurred. Please check your connection.</div>`;
                }
            }, false);
        });

        function insertFeedback(text) {
            const remarks = document.getElementById('remarks');
            if (!remarks || remarks.readOnly) return;
            
            if (remarks.value.trim().length > 0) {
                remarks.value = remarks.value + '\n' + text;
            } else {
                remarks.value = text;
            }
            
            remarks.focus();
            remarks.dispatchEvent(new Event('input'));
        }

        function setupCompareModal(oldFileUrl, newFileUrl) {
            document.getElementById('compareOldIframe').src = oldFileUrl;
            document.getElementById('compareNewIframe').src = newFileUrl;
        }

        // Turnitin Front-end Validation
        document.addEventListener("DOMContentLoaded", function() {
            const turnitinInput = document.querySelector('input[name="turnitinScore"]');
            const statusSelect = document.querySelector('select[name="status"]');
            
            if (turnitinInput && statusSelect) {
                function validateTurnitin() {
                    const score = parseFloat(turnitinInput.value);
                    const approveOption = statusSelect.querySelector('option[value="Approved"]');
                    
                    if (!isNaN(score) && score > 20) {
                        turnitinInput.classList.add('border-danger');
                        if (statusSelect.value === 'Approved') {
                            statusSelect.value = '';
                        }
                        if (approveOption) {
                            approveOption.disabled = true;
                            approveOption.innerHTML = 'Approve (Blocked: Turnitin > 20%)';
                        }
                    } else {
                        turnitinInput.classList.remove('border-danger');
                        if (approveOption) {
                            approveOption.disabled = false;
                            approveOption.innerHTML = 'Approve (Passed)';
                        }
                    }
                }
                
                turnitinInput.addEventListener('input', validateTurnitin);
                validateTurnitin();
            }

            // Dynamic required attribute for graded marksheet file
            const gradedFileInput = document.getElementById('gradedFile');
            const statusSelectElem = document.querySelector('select[name="status"]');
            
            if (gradedFileInput && statusSelectElem && @((!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Final Report", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase))).ToString().ToLower())) {
                function updateGradedFileRequirement() {
                    if (statusSelectElem.value === 'Approved' || statusSelectElem.value === 'Rejected') {
                        gradedFileInput.setAttribute('required', 'required');
                    } else {
                        gradedFileInput.removeAttribute('required');
                    }
                }
                
                statusSelectElem.addEventListener('change', updateGradedFileRequirement);
                updateGradedFileRequirement();
            }
        });
        // Signature Handling
        let sigCanvas, sigCtx, drawing = false;

        function initSignatureCanvas() {
            const canvas = document.getElementById('signatureCanvas');
            if (!canvas) return;
            sigCanvas = canvas;
            sigCtx = canvas.getContext('2d');
            
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
            sigCtx.lineWidth = 2;
            sigCtx.lineCap = 'round';
            sigCtx.strokeStyle = '#00008B';

            const startDraw = (e) => {
                drawing = true;
                draw(e);
            };
            const stopDraw = () => {
                drawing = false;
                sigCtx.beginPath();
                updateSignatureData();
            };
            const draw = (e) => {
                if (!drawing) return;
                e.preventDefault();
                const rect = canvas.getBoundingClientRect();
                let x, y;
                if (e.touches && e.touches.length > 0) {
                    x = e.touches[0].clientX - rect.left;
                    y = e.touches[0].clientY - rect.top;
                } else {
                    x = e.clientX - rect.left;
                    y = e.clientY - rect.top;
                }
                sigCtx.lineTo(x, y);
                sigCtx.stroke();
                sigCtx.beginPath();
                sigCtx.moveTo(x, y);
            };

            canvas.addEventListener('mousedown', startDraw);
            canvas.addEventListener('mousemove', draw);
            canvas.addEventListener('mouseup', stopDraw);
            canvas.addEventListener('mouseout', stopDraw);
            
            canvas.addEventListener('touchstart', startDraw);
            canvas.addEventListener('touchmove', draw);
            canvas.addEventListener('touchend', stopDraw);
        }

        window.clearSignature = function() {
            if(sigCtx && sigCanvas) {
                sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
                updateSignatureData();
            }
        };

        window.updateSignatureData = function() {
            const method = document.querySelector('input[name="sigMethod"]:checked')?.value;
            const hiddenInput = document.getElementById('supervisorSignatureHidden');
            if (!hiddenInput) return;

            if (method === 'draw') {
                if(sigCanvas) {
                    const isCanvasBlank = (canvas) => {
                        const ctx = canvas.getContext('2d');
                        const pixelBuffer = new Uint32Array(ctx.getImageData(0, 0, canvas.width, canvas.height).data.buffer);
                        return !pixelBuffer.some(color => color !== 0);
                    }
                    hiddenInput.value = isCanvasBlank(sigCanvas) ? '' : sigCanvas.toDataURL('image/png');
                }
            } else if (method === 'type') {
                hiddenInput.value = document.getElementById('typedSignature').value;
            } else if (method === 'manual') {
                hiddenInput.value = "Manual Signature (See Attached Document)";
            }
        };

        // Handle Signature Method Change
        const methodRadios = document.querySelectorAll('input[name="sigMethod"]');
        if (methodRadios.length > 0) {
            initSignatureCanvas();
            methodRadios.forEach(radio => {
                radio.addEventListener('change', (e) => {
                    document.getElementById('sigDrawArea').classList.add('d-none');
                    document.getElementById('sigTypeArea').classList.add('d-none');
                    document.getElementById('sigManualArea').classList.add('d-none');
                    
                    if (e.target.value === 'draw') {
                        document.getElementById('sigDrawArea').classList.remove('d-none');
                    } else if (e.target.value === 'type') {
                        document.getElementById('sigTypeArea').classList.remove('d-none');
                    } else if (e.target.value === 'manual') {
                        document.getElementById('sigManualArea').classList.remove('d-none');
                    }
                    updateSignatureData();
                });
            });
            
            const typeInput = document.getElementById('typedSignature');
            if (typeInput) {
                typeInput.addEventListener('input', updateSignatureData);
            }
        }
    </script>
}

<!-- Compare Versions Modal -->
<div class="modal fade" id="compareModal" tabindex="-1" aria-labelledby="compareModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-light">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title fw-bold" id="compareModalLabel"><i class="fas fa-columns text-primary me-2"></i> Document Version Comparison</h5>
                <button type="button" class="btn-close btn-close-white" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="row g-0 h-100">
                    <div class="col-6 h-100 border-end border-2 border-dark">
                        <div class="bg-secondary text-white text-center py-2 fw-bold" style="font-size: 0.9rem;">
                            <i class="fas fa-history me-1"></i> Previous Version
                        </div>
                        <iframe id="compareOldIframe" src="" style="width:100%; height:calc(100vh - 100px); border:none;"></iframe>
                    </div>
                    <div class="col-6 h-100">
                        <div class="bg-primary text-white text-center py-2 fw-bold" style="font-size: 0.9rem;">
                            <i class="fas fa-star me-1"></i> New Version
                        </div>
                        <iframe id="compareNewIframe" src="" style="width:100%; height:calc(100vh - 100px); border:none;"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






