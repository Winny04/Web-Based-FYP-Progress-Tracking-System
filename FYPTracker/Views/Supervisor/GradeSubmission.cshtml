@model FYPTracker.Models.FYPMilestone
@using System.Collections.Generic
@{
    ViewData["Title"] = "Review Submission";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder text-dark mb-1">Review Submission</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("ReviewSubmissions", "Supervisor")" class="text-decoration-none">Submissions</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("ReviewSubmissions", "Supervisor")" class="btn btn-light-primary fw-bold">
            <i class="fas fa-arrow-left me-2"></i>Back to Submissions
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4 rounded-3 border-danger shadow-sm">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        </div>
    }

    @if (Model.RejectionCount >= 3)
    {
        <div class="alert alert-danger mb-4 rounded-3 shadow-sm d-flex justify-content-between align-items-center" style="border: 2px solid #f1416c;">
            <div>
                <h5 class="fw-bold mb-1"><i class="fas fa-lock me-2"></i>Submission Locked (Max Rejections Reached)</h5>
                <p class="mb-0">This student has reached the maximum of 3 rejections. They cannot re-submit the digital form until the Admin unlocks it after their Defense Session.</p>
            </div>
            
        </div>
    }

    <div class="row g-4">
        <!-- Details Column -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-4">
                    <h5 class="card-title fw-bold text-dark mb-0">
                        <i class="fas fa-file-alt text-primary me-2"></i>Submission Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="fas fa-user text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">@Model.Project?.Student?.FullName</h6>
                            <span class="text-muted small">@Model.Project?.Student?.EmployeeId</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted text-uppercase fw-bold" style="font-size: 0.8rem; letter-spacing: 1px;">Project Title</h6>
                        <p class="text-dark fw-semibold mb-0">@(Model.Project?.Title ?? "Untitled Project")</p>
                    </div>

                    @{
                        string raw = Model.Remarks ?? "";
                        string parsedJson = "";
                        string formInfo = "";
                        if (raw.Contains("JSON: ")) {
                            var parts = raw.Split(new[] { "JSON: " }, StringSplitOptions.None);
                            formInfo = parts[0].Trim();
                            parsedJson = parts[1];
                        }
                    }

                    @if (!string.IsNullOrEmpty(formInfo))
                    {
                        <div class="alert alert-primary bg-light-primary border-primary border-dashed d-flex align-items-center p-3 mb-4 rounded-3">
                            <i class="fas fa-info-circle fs-3 text-primary me-3"></i>
                            <div class="d-flex flex-column">
                                <span class="fw-bold text-dark">Submission Information</span>
                                <span class="text-muted" style="font-size: 0.9rem;">@formInfo</span>
                            </div>
                        </div>
                    }

                    @{
                        bool isProposalOrProgress = false;
                        if (!string.IsNullOrEmpty(formInfo)) {
                            var fi = formInfo.ToLower();
                            if (fi.Contains("proposal") || fi.Contains("progress")) {
                                isProposalOrProgress = true;
                            }
                        }
                    }
                    @if (!string.IsNullOrEmpty(parsedJson) && !isProposalOrProgress)
                    {
                        <!-- The iframe to display the generated PDF -->
                        <div class="bg-light rounded-4 border border-secondary border-opacity-25 shadow-sm p-2 mb-4" style="height: 900px;">
                            <h6 class="fw-bold text-primary mb-2 px-2 pt-2">Form Details (PDF)</h6>
                            <iframe id="iafPdfIframe" style="width: 100%; height: 90%; border: none; border-radius: 8px;"></iframe>
                        </div>

                        <!-- Off-screen container for HTML2PDF to read -->
                        <div id="iafPdfSource" style="position: absolute; left: -9999px; top: -9999px;">
                            <h4 style="color: #0d6efd; margin-bottom: 20px; font-family: sans-serif;">@Model.Title</h4>
                            <p style="font-family: sans-serif; color: #555;">Student: @Model.Project?.Student?.FullName (@Model.Project?.Student?.EmployeeId)</p>
                            <hr style="border: 1px solid #ddd; margin-bottom: 20px;" />
                            @{
                                try {
                                    var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(parsedJson);
                                    if (dict != null) {
                                        <table style="width: 100%; font-family: sans-serif; font-size: 14px; border-collapse: collapse;">
                                            @{
                                                var keysOrder = new[] { "Project Title", "Scope of Project", "Problem Statement", "Objective 1", "Objective 2", "Objective 3", "Agreed Supervisor Name", "Completion", "Supervisor Signature" };
                                                
                                                // 1. Print keys in the defined order
                                                foreach (var key in keysOrder) {
                                                    if (dict.TryGetValue(key, out var val) && !string.IsNullOrEmpty(val)) {
                                                        <tr>
                                                            <td style="width: 30%; font-weight: bold; padding: 8px; border-bottom: 1px solid #eee; vertical-align: top;">@key:</td>
                                                            <td style="padding: 8px; border-bottom: 1px solid #eee; white-space: pre-wrap;">
                                                                @if (key == "Supervisor Signature") {
                                                                    <span style="font-family: 'Brush Script MT', cursive; font-size: 24px; color: #00008B;">@val</span>
                                                                } else {
                                                                    @val
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                
                                                // 2. Print any remaining keys that weren't in the array
                                                foreach (var kvp in dict.Where(k => !keysOrder.Contains(k.Key))) {
                                                    if (!string.IsNullOrEmpty(kvp.Value)) {
                                                        <tr>
                                                            <td style="width: 30%; font-weight: bold; padding: 8px; border-bottom: 1px solid #eee; vertical-align: top;">@kvp.Key:</td>
                                                            <td style="padding: 8px; border-bottom: 1px solid #eee; white-space: pre-wrap;">@kvp.Value</td>
                                                        </tr>
                                                    }
                                                }
                                            }
                                        </table>
                                    }
                                } catch {
                                    <div style="font-family: monospace; white-space: pre-wrap;">@parsedJson</div>
                                }
                            }

                            @if (!string.IsNullOrEmpty(Model.SupervisorFeedback))
                            {
                                <hr style="border: 1px solid #ddd; margin: 20px 0;" />
                                <h5 style="color: #0d6efd; font-family: sans-serif;">Supervisor's Feedback</h5>
                                <p style="font-family: sans-serif; font-size: 14px; white-space: pre-wrap; background-color: #f8f9fa; padding: 15px; border-left: 4px solid #198754; color: #333;">@Model.SupervisorFeedback</p>
                            }
                        </div>
                    }
                    
                    @if (Model.SubmissionFiles != null && Model.SubmissionFiles.Any(f => f.UploadedBy == Model.Project?.StudentId))
                    {
                        var primaryFile = Model.SubmissionFiles.FirstOrDefault(f => f.UploadedBy == Model.Project?.StudentId);
                        if (primaryFile != null)
                        {
                            <div class="bg-light rounded-4 border border-secondary border-opacity-25 shadow-sm p-2 mb-4" style="height: 900px;">
                                <h6 class="fw-bold text-primary mb-2 px-2 pt-2">Student Attached Document (@primaryFile.FileName)</h6>
                                <iframe src="@Url.Action("ViewFile", "Supervisor", new { fileId = primaryFile.Id })" style="width: 100%; height: 90%; border: none; border-radius: 8px;"></iframe>
                            </div>
                        }
                    }

                    @if (Model.SubmissionFiles != null && Model.SubmissionFiles.Any())
                    {
                        var studentFiles = Model.SubmissionFiles.Where(f => f.UploadedBy == Model.Project?.StudentId).OrderByDescending(f => f.AttemptNumber).ToList();
                        var supervisorFiles = Model.SubmissionFiles.Where(f => f.UploadedBy != Model.Project?.StudentId).ToList();

                        if (studentFiles.Any())
                        {
                            <div class="mb-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Student Attached Files (Version History)</h6>
                                <div class="d-flex flex-column gap-3">
                                    @for (int i = 0; i < studentFiles.Count; i++)
                                    {
                                        var file = studentFiles[i];
                                        // Find the most recent file from a PREVIOUS attempt
                                        var previousFile = studentFiles.FirstOrDefault(f => f.AttemptNumber < file.AttemptNumber);
                                        
                                        <div class="card border-0 shadow-sm rounded-3">
                                            <div class="card-body p-3 d-flex flex-column gap-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = file.Id })" target="_blank" class="text-dark fw-bold text-decoration-none d-flex align-items-center">
                                                        <i class="fas fa-paperclip text-primary me-2"></i> @file.FileName <span class="badge bg-secondary ms-2">Attempt @file.AttemptNumber</span>
                                                    </a>
                                                    @if (previousFile != null)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#compareModal" onclick="setupCompareModal('@Url.Action("ViewFile", "Supervisor", new { fileId = previousFile.Id })', '@Url.Action("ViewFile", "Supervisor", new { fileId = file.Id })')">
                                                            <i class="fas fa-columns me-1"></i> Compare with Attempt @previousFile.AttemptNumber
                                                        </button>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(file.RevisionNotes))
                                                {
                                                    <div class="alert alert-warning m-0 p-2 mt-2 border-0">
                                                        <div class="fw-bold text-dark" style="font-size:0.85rem;"><i class="fas fa-history text-danger me-1"></i> Revision Notes:</div>
                                                        <div class="text-dark small">@file.RevisionNotes</div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        if (supervisorFiles.Any())
                        {
                            <div class="mb-0">
                                <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">Graded / Feedback Files</h6>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var file in supervisorFiles)
                                    {
                                        <a href="@Url.Action("ViewFile", "Supervisor", new { fileId = file.Id })" target="_blank" class="btn btn-outline-primary text-start d-flex align-items-center rounded-3 p-3 text-decoration-none bg-light-primary border-primary border-opacity-25">
                                            <i class="fas fa-file-pdf text-primary me-3"></i>
                                            <span class="text-dark fw-bold text-truncate flex-grow-1">@file.FileName</span>
                                            <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        string supStrengths = "", supImprovements = "", supComments = "";
                        if (!string.IsNullOrEmpty(Model.SupervisorMarksheetData) && Model.SupervisorMarksheetData.StartsWith("{"))
                        {
                            using var doc = System.Text.Json.JsonDocument.Parse(Model.SupervisorMarksheetData);
                            if (doc.RootElement.TryGetProperty("Strengths", out var sProp)) supStrengths = sProp.GetString();
                            if (doc.RootElement.TryGetProperty("Improvements", out var iProp)) supImprovements = iProp.GetString();
                            if (doc.RootElement.TryGetProperty("Comments", out var cProp)) supComments = cProp.GetString();
                        }
                        
                        if (!string.IsNullOrEmpty(supStrengths) || !string.IsNullOrEmpty(supImprovements) || !string.IsNullOrEmpty(supComments))
                        {
                            <div class="mb-0 mt-4 border-top pt-4">
                                <h6 class="text-primary text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px;"><i class="fas fa-magic me-2"></i>Extracted from Marksheet</h6>
                                
                                @if (!string.IsNullOrEmpty(supStrengths))
                                {
                                    <div class="mb-3">
                                        <div class="fw-bold text-dark fs-7 mb-1">Strengths of Report</div>
                                        <div class="bg-light p-2 rounded text-muted fs-7">@supStrengths</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(supImprovements))
                                {
                                    <div class="mb-3">
                                        <div class="fw-bold text-dark fs-7 mb-1">Areas for Improvement</div>
                                        <div class="bg-light p-2 rounded text-muted fs-7">@supImprovements</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(supComments))
                                {
                                    <div class="mb-3">
                                        <div class="fw-bold text-dark fs-7 mb-1">Additional Comments</div>
                                        <div class="bg-light p-2 rounded text-muted fs-7">@supComments</div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Grading Column -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 2rem;">
                <div class="card-header bg-white border-bottom py-4">
                    <h5 class="card-title fw-bold text-dark mb-0">
                        <i class="fas fa-check-circle text-success me-2"></i>Grading Action
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form class="needs-validation" novalidate asp-action="ReviewSubmission" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="milestoneId" value="@Model.Id" />
                        
                        @{
                            // Lock the form if the milestone has already been graded
                            bool isLocked = Model.Status == "Approved" || Model.Status == "Rejected";
                            bool isMarksheetStage = !string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Final Report", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase));
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-signature text-primary me-2"></i>Supervisor Signature</label>
                                <input type="text" name="supervisorSignature" class="form-control form-control-solid form-control-lg border-primary bg-light-primary" placeholder="Type your full name to digitally sign" @(isLocked ? "disabled" : "required") />
                                <div class="invalid-feedback">Supervisor signature is required.</div>
                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Required to officially approve the Initial Project Allocation Form.</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Title) && Model.Title.Contains("Progress", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-percentage text-primary me-2"></i>Completion Rating</label>
                                <select name="pctComplete" class="form-select form-select-solid form-select-lg" @(isLocked ? "disabled" : "required")>
                                    <option value="">- Select rating -</option>
                                    <option value="10%">10%</option>
                                    <option value="25%">25%</option>
                                    <option value="50%">50%</option>
                                    <option value="75%">75%</option>
                                    <option value="90%">90%</option>
                                    <option value="100%">100%</option>
                                </select>
                                <div class="invalid-feedback">Please select a completion rating.</div>
                                <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Rate the student's progress.</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Turnitin", StringComparison.OrdinalIgnoreCase)))
                        {

                            <div class="mb-4 p-3 bg-light-warning border border-warning border-dashed rounded-3">
                                <label class="form-label fw-bold text-dark"><i class="fas fa-search text-warning me-2"></i>Turnitin Similarity Index (%)</label>
                                <input type="number" name="turnitinScore" class="form-control form-control-solid form-control-lg" min="0" max="100" value="@Model.Project?.TurnitinScore" placeholder="e.g. 14" @(isLocked ? "disabled" : "required") />
                                <div class="invalid-feedback">Please enter the Turnitin score.</div>
                                <div class="form-text text-muted mt-2"><i class="fas fa-exclamation-triangle me-1 text-warning"></i>Must be 20% or less to approve the Turnitin Report. The examiner cannot grade until this is approved.</div>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Decision</label>
                            <select name="status" class="form-select form-select-solid form-select-lg" @(isLocked ? "disabled" : "required")>
                                <option value="">- Select a decision -</option>
                                <option value="Approved" selected="@(Model.Status == "Approved")">Approve (Passed)</option>
                                <option value="Rejected" selected="@(Model.Status == "Rejected")">Reject (Needs Revision)</option>
                                <option value="UnderReview" selected="@(Model.Status == "UnderReview")">Mark as Needs Attention</option>
                            </select>
                            <div class="invalid-feedback">Please select a decision.</div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Feedback / Remarks</label>
                            <textarea name="remarks" id="remarks" class="form-control form-control-solid rounded-3" rows="6" placeholder="Provide detailed feedback for the student here..." @(isLocked ? "readonly" : "required")>@Model.SupervisorFeedback</textarea>
                            <div class="invalid-feedback">Please provide feedback or remarks.</div>
                            
                            @if (!isLocked)
                            {
                                <div class="mt-3 d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-light-success border border-success border-opacity-25" onclick="insertFeedback('Good progress, keep it up!')">
                                        <i class="fas fa-thumbs-up me-1"></i> Good Progress
                                    </button>
                                    <button type="button" class="btn btn-sm btn-light-warning border border-warning border-opacity-25" onclick="insertFeedback('Needs minor revisions. Please check the graded file.')">
                                        <i class="fas fa-edit me-1"></i> Needs Revision
                                    </button>
                                    <button type="button" class="btn btn-sm btn-light-primary border border-primary border-opacity-25" onclick="insertFeedback('Approved as requested.')">
                                        <i class="fas fa-check me-1"></i> Approved
                                    </button>
                                </div>
                            }
                            <div class="form-text mt-2">This feedback will be visible to the student immediately.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark"><i class="fas fa-file-upload text-danger me-2"></i>Upload Feedback File / Graded Marksheet</label>
                            
                            @if (Model.Title.Contains("Final Report", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="mb-3 p-3 bg-light rounded border">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-bold mb-1"><i class="fas fa-file-excel text-success me-2"></i>Excel Marksheet Template</h6>
                                            <small class="text-muted">Download this template, fill in your marks, and upload it back here as the Graded Marksheet below.</small>
                                        </div>
                                        <a href="@Url.Action("DownloadMarksheet", "Supervisor", new { projectId = Model.Project.Id })" class="btn btn-sm btn-outline-success">
                                            <i class="fas fa-download me-1"></i> Download
                                        </a>
                                    </div>
                                </div>
                            }

                            @if (isMarksheetStage)
                            {
                                <input type="file" id="gradedFile" name="gradedFile" accept=".xls,.xlsx" class="form-control form-control-solid form-control-lg" @(isLocked ? "disabled" : "") />
                                <div class="invalid-feedback">You must upload the completed Excel marksheet to approve or reject this milestone.</div>
                            }
                            else
                            {
                                <input type="file" id="gradedFile" name="gradedFile" accept=".pdf,.doc,.docx,.xls,.xlsx" class="form-control form-control-solid form-control-lg" @(isLocked ? "disabled" : "") />
                            }
                            <div class="form-text text-muted mt-2"><i class="fas fa-info-circle me-1"></i>Upload a marked/feedback version of the student's submission or your completed Excel marksheet (PDF, Word, or Excel).</div>
                        </div>

                        @if (isLocked)
                        {
                            <div class="alert alert-warning mt-4 mb-0 border-warning shadow-sm">
                                <i class="fas fa-lock me-2 text-warning"></i>This submission has already been reviewed and locked.
                            </div>
                        }
                        else
                        {
                            <div class="d-grid mt-5">
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">
                                    <i class="fas fa-save me-2"></i>Submit Review
                                </button>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async function() {
            const source = document.getElementById('iafPdfSource');
            const iframe = document.getElementById('iafPdfIframe');
            
            if (source && iframe) {
                // Ensure html2pdf is loaded
                if (typeof html2pdf === 'undefined') return;

                const opt = {
                    margin: 0.5,
                    filename: 'FormDetails.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true },
                    jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
                };

                const htmlString = `
                    <div style="width: 800px; padding: 20px; background: white;">
                        ${source.innerHTML}
                    </div>
                `;

                try {
                    // Generate PDF as blob and show in iframe
                    const pdfBlob = await html2pdf().set(opt).from(htmlString).outputPdf('blob');
                    const url = URL.createObjectURL(pdfBlob);
                    iframe.src = url;
                } catch(e) {
                    console.error("PDF generation failed", e);
                    iframe.parentElement.innerHTML = '<div class="alert alert-warning m-3">Failed to load PDF preview.</div>';
                }
            }
        });

        // Real-time Bootstrap Validation
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            // Validate on input/change
            form.addEventListener('input', function(e) {
                if (e.target.hasAttribute('required')) {
                    if (e.target.checkValidity()) {
                        e.target.classList.remove('is-invalid');
                        e.target.classList.add('is-valid');
                    } else {
                        e.target.classList.remove('is-valid');
                        e.target.classList.add('is-invalid');
                    }
                }
            });
            form.addEventListener('change', function(e) {
                if (e.target.hasAttribute('required') && e.target.tagName === 'SELECT') {
                    if (e.target.checkValidity()) {
                        e.target.classList.remove('is-invalid');
                        e.target.classList.add('is-valid');
                    } else {
                        e.target.classList.remove('is-valid');
                        e.target.classList.add('is-invalid');
                    }
                }
            });

            // Validate on submit
            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                
                if (!form.checkValidity()) {
                    event.stopPropagation();
                    form.classList.add('was-validated');
                    return;
                }
                form.classList.add('was-validated');
                
                const submitBtn = form.querySelector('button[type="submit"]');
                const originalBtnText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Submitting...';

                try {
                    const formData = new FormData(form);
                    const actionUrl = form.getAttribute('action') || window.location.href;
                    
                    const response = await fetch(actionUrl, {
                        method: form.getAttribute('method') || 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            window.location.href = '@Url.Action("ReviewSubmissions", "Supervisor")';
                        }
                    } else {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnText;
                        
                        let errorMsg = "A server error occurred. Please try again.";
                        try {
                            const errData = await response.json();
                            errorMsg = errData.message || errorMsg;
                        } catch(e) {
                            if (response.status === 400) errorMsg = "Validation failed. Please check your inputs.";
                            if (response.status === 500) errorMsg = "A database transaction error occurred. Your input has been saved locally, please try again.";
                        }
                        
                        let errorContainer = document.getElementById('ajax-error-container');
                        if (!errorContainer) {
                            errorContainer = document.createElement('div');
                            errorContainer.id = 'ajax-error-container';
                            form.insertBefore(errorContainer, form.firstChild);
                        }
                        errorContainer.innerHTML = `<div class="alert alert-danger shadow-sm border-danger"><i class="fas fa-exclamation-circle me-2"></i>${errorMsg}</div>`;
                    }
                } catch (error) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                    
                    let errorContainer = document.getElementById('ajax-error-container');
                    if (!errorContainer) {
                        errorContainer = document.createElement('div');
                        errorContainer.id = 'ajax-error-container';
                        form.insertBefore(errorContainer, form.firstChild);
                    }
                    errorContainer.innerHTML = `<div class="alert alert-danger shadow-sm border-danger"><i class="fas fa-wifi me-2"></i>Network error occurred. Please check your connection.</div>`;
                }
            }, false);
        });

        function insertFeedback(text) {
            const remarks = document.getElementById('remarks');
            if (!remarks || remarks.readOnly) return;
            
            if (remarks.value.trim().length > 0) {
                remarks.value = remarks.value + '\n' + text;
            } else {
                remarks.value = text;
            }
            
            remarks.focus();
            remarks.dispatchEvent(new Event('input'));
        }

        function setupCompareModal(oldFileUrl, newFileUrl) {
            document.getElementById('compareOldIframe').src = oldFileUrl;
            document.getElementById('compareNewIframe').src = newFileUrl;
        }

        // Turnitin Front-end Validation
        document.addEventListener("DOMContentLoaded", function() {
            const turnitinInput = document.querySelector('input[name="turnitinScore"]');
            const statusSelect = document.querySelector('select[name="status"]');
            
            if (turnitinInput && statusSelect) {
                function validateTurnitin() {
                    const score = parseFloat(turnitinInput.value);
                    const approveOption = statusSelect.querySelector('option[value="Approved"]');
                    
                    if (!isNaN(score) && score > 20) {
                        turnitinInput.classList.add('border-danger');
                        if (statusSelect.value === 'Approved') {
                            statusSelect.value = '';
                        }
                        if (approveOption) {
                            approveOption.disabled = true;
                            approveOption.innerHTML = 'Approve (Blocked: Turnitin > 20%)';
                        }
                    } else {
                        turnitinInput.classList.remove('border-danger');
                        if (approveOption) {
                            approveOption.disabled = false;
                            approveOption.innerHTML = 'Approve (Passed)';
                        }
                    }
                }
                
                turnitinInput.addEventListener('input', validateTurnitin);
                validateTurnitin();
            }

            // Dynamic required attribute for graded marksheet file
            const gradedFileInput = document.getElementById('gradedFile');
            const statusSelectElem = document.querySelector('select[name="status"]');
            
            if (gradedFileInput && statusSelectElem && @((!string.IsNullOrEmpty(Model.Title) && (Model.Title.Contains("Final Report", StringComparison.OrdinalIgnoreCase) || Model.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase))).ToString().ToLower())) {
                function updateGradedFileRequirement() {
                    if (statusSelectElem.value === 'Approved' || statusSelectElem.value === 'Rejected') {
                        gradedFileInput.setAttribute('required', 'required');
                    } else {
                        gradedFileInput.removeAttribute('required');
                    }
                }
                
                statusSelectElem.addEventListener('change', updateGradedFileRequirement);
                updateGradedFileRequirement();
            }
        });
    </script>
}

<!-- Compare Versions Modal -->
<div class="modal fade" id="compareModal" tabindex="-1" aria-labelledby="compareModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-light">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title fw-bold" id="compareModalLabel"><i class="fas fa-columns text-primary me-2"></i> Document Version Comparison</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="row g-0 h-100">
                    <div class="col-6 h-100 border-end border-2 border-dark">
                        <div class="bg-secondary text-white text-center py-2 fw-bold" style="font-size: 0.9rem;">
                            <i class="fas fa-history me-1"></i> Previous Version
                        </div>
                        <iframe id="compareOldIframe" src="" style="width:100%; height:calc(100vh - 100px); border:none;"></iframe>
                    </div>
                    <div class="col-6 h-100">
                        <div class="bg-primary text-white text-center py-2 fw-bold" style="font-size: 0.9rem;">
                            <i class="fas fa-star me-1"></i> New Version
                        </div>
                        <iframe id="compareNewIframe" src="" style="width:100%; height:calc(100vh - 100px); border:none;"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


