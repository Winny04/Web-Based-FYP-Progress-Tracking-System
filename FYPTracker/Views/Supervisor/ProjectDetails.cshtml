@using FYPTracker.Models
@model FYPProject
@{
    ViewData["Title"] = "Manage Project Milestones";
}

<style>
    :root { --blue-grad: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); }

    .page-hero {
        background: var(--blue-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(37, 99, 235, 0.25);
    }

    .glass-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid rgba(37, 99, 235, 0.1);
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        padding: 24px;
        margin-bottom: 20px;
    }

    .milestone-item {
        border-left: 4px solid #3b82f6;
        background: #f8fafc;
        border-radius: 0 12px 12px 0;
        padding: 16px 20px;
        margin-bottom: 16px;
        transition: all 0.2s ease;
    }
    .milestone-item:hover {
        background: #f1f5f9;
        transform: translateX(4px);
    }

    .btn-action {
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
        transition: all 0.2s;
    }
    .btn-edit { background: #e0e7ff; color: #4f46e5; }
    .btn-edit:hover { background: #c7d2fe; }
    .btn-delete { background: #fee2e2; color: #dc2626; }
    .btn-delete:hover { background: #fecaca; }
    .btn-add { background: #2563eb; color: white; border-radius: 10px; padding: 10px 20px; font-weight: 600; }
    .btn-add:hover { background: #1d4ed8; color: white;}
</style>

<div class="container-fluid py-4">
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">@TempData["Error"]</div>
    }

    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <a href="/Supervisor/MyProjects" class="text-white text-decoration-none opacity-75 mb-2 d-inline-block"><i class="fas fa-arrow-left me-2"></i>Back to Projects</a>
            <h2 class="fw-bold mb-1"><i class="fas fa-tasks me-2"></i>Milestone Management</h2>
            <p class="mb-0 opacity-80">Configure tracking milestones for this student.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="glass-card">
                <h6 class="fw-bold text-dark mb-4"><i class="fas fa-user-graduate text-primary me-2"></i>Student Details</h6>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div style="width:50px;height:50px;border-radius:50%;background:#e0e7ff;display:flex;align-items:center;justify-content:center;color:#4f46e5;font-weight:700;font-size:18px;">
                        @(Model.Student?.FullName?.Substring(0, 1) ?? "S")
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">@Model.Student?.FullName</div>
                        <div class="text-muted small">@Model.Student?.Email</div>
                    </div>
                </div>
                
                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-project-diagram text-primary me-2"></i>Project Info</h6>
                <div class="mb-3">
                    <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Project Title</small>
                    <span class="fw-semibold text-dark">@Model.Title</span>
                </div>
                <div>
                    <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Status</small>
                    <span class="badge bg-success rounded-pill px-3 mb-4">@Model.Status</span>
                </div>
                
                @{
                    var pendingCount = Model.Milestones.Count(m => m.Status != "Approved");
                    var isGradingLocked = pendingCount > 0;
                }
                <div class="d-flex justify-content-between align-items-center mb-3 pt-2 border-top">
                    <h6 class="fw-bold text-dark mb-0"><i class="fas fa-graduation-cap text-primary me-2"></i>Final Grading</h6>
                    @if (isGradingLocked)
                    {
                        <span class="badge bg-danger rounded-pill"><i class="fas fa-lock me-1"></i> Locked</span>
                    }
                    else
                    {
                        <span class="badge bg-success rounded-pill"><i class="fas fa-unlock me-1"></i> Ready</span>
                    }
                </div>
                
                @if (isGradingLocked)
                {
                    <div class="alert alert-light-danger border-danger border border-dashed rounded-3 p-3 mb-3 d-flex align-items-center">
                        <i class="fas fa-exclamation-circle text-danger fs-4 me-3"></i>
                        <div>
                            <p class="mb-0 fw-bold text-danger" style="font-size: 0.8rem;">Action Required</p>
                            <span class="text-dark" style="font-size: 0.75rem;">@pendingCount milestone(s) are pending approval before you can assign a Final Grade.</span>
                        </div>
                    </div>
                }

                <form method="post" action="/Supervisor/UpdateFinalGrade">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <div class="mb-3">
                        <small class="text-muted d-block fw-bold text-uppercase mb-1" style="font-size: 0.7rem;">Overall Project Grade</small>
                        <select name="finalGrade" class="form-select form-select-sm" style="border-radius: 8px; border-color: #e2e8f0;" @(isGradingLocked ? "disabled" : "")>
                            <option value="">-- Pending Grading --</option>
                            @{
                                var grades = new[] { "A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D", "F" };
                                foreach (var g in grades)
                                {
                                    if (Model.FinalGrade == g)
                                    {
                                        <option value="@g" selected>@g</option>
                                    }
                                    else
                                    {
                                        <option value="@g">@g</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold" style="border-radius: 8px;" @(isGradingLocked ? "disabled" : "")>Save Grade</button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="glass-card">
                <h5 class="fw-bold text-dark mb-4"><i class="fas fa-stream text-primary me-2"></i>Project Milestones</h5>
                
                @if (!Model.Milestones.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-folder-open fs-1 opacity-25 d-block mb-3"></i>
                        No milestones configured yet.
                    </div>
                }
                else
                {
                    <div class="milestone-list">
                        @foreach (var m in Model.Milestones.OrderBy(x => x.DueDate))
                        {
                            <div class="milestone-item d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@m.Title</h6>
                                    @if (!string.IsNullOrEmpty(m.Description))
                                    {
                                        <p class="text-muted small mb-2" style="max-width: 500px;">@m.Description</p>
                                    }
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge @(m.Status == "Approved" ? "bg-success" : (m.Status == "Pending" ? "bg-warning text-dark" : "bg-primary")) rounded-pill">@m.Status</span>
                                        @if (m.DueDate.HasValue)
                                        {
                                            <small class="text-muted fw-semibold"><i class="far fa-calendar-alt me-1"></i>Due: @m.DueDate.Value.ToString("dd MMM yyyy")</small>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (m.Status == "Submitted" || m.Status == "UnderReview" || m.Status == "Approved" || m.Status == "Rejected" || m.Status == "Revision")
                                    {
                                        <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = m.Id })" class="btn-action text-decoration-none" style="background: #e0f2fe; color: #0284c7;" title="Review Documents">
                                            <i class="fas fa-file-alt"></i> View/Grade
                                        </a>
                                    }
                                </div>                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(e, form) {
            e.preventDefault();
            Swal.fire({
                title: 'Delete Milestone?',
                text: "Are you sure you want to delete this milestone? This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, delete it!',
                background: '#ffffff',
                customClass: { popup: 'rounded-4 shadow-lg border-0' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        }
    </script>
}
