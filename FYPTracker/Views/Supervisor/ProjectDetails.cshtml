@using FYPTracker.Models
@model FYPProject
@{
    ViewData["Title"] = "Manage Project Milestones";
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .glass-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid rgba(37, 99, 235, 0.1);
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        padding: 24px;
        margin-bottom: 20px;
    }

    .milestone-item {
        border-left: 4px solid #3b82f6;
        background: #f8fafc;
        border-radius: 0 12px 12px 0;
        padding: 16px 20px;
        margin-bottom: 16px;
        transition: all 0.2s ease;
    }
    .milestone-item:hover {
        background: #f1f5f9;
        transform: translateX(4px);
    }

    .btn-action {
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
        transition: all 0.2s;
    }
    .btn-edit { background: #e0e7ff; color: #4f46e5; }
    .btn-edit:hover { background: #c7d2fe; }
    .btn-delete { background: #fee2e2; color: #dc2626; }
    .btn-delete:hover { background: #fecaca; }
    .btn-add { background: #2563eb; color: white; border-radius: 10px; padding: 10px 20px; font-weight: 600; }
    .btn-add:hover { background: #1d4ed8; color: white;}
</style>

<div class="container-fluid py-4">
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">@TempData["Error"]</div>
    }

    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <a href="/Supervisor/MyProjects" class="text-white text-decoration-none opacity-75 mb-2 d-inline-block"><i class="fas fa-arrow-left me-2"></i>Back to Projects</a>
            <h2 class="fw-bold mb-1"><i class="fas fa-tasks me-2"></i>Milestone Management</h2>
            <p class="mb-0 opacity-80">Configure tracking milestones for this student.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="glass-card">
                <h6 class="fw-bold text-dark mb-4"><i class="fas fa-user-graduate text-primary me-2"></i>Student Details</h6>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div style="width:50px;height:50px;border-radius:50%;background:#e0e7ff;display:flex;align-items:center;justify-content:center;color:#4f46e5;font-weight:700;font-size:18px;">
                        @(Model.Student?.FullName?.Substring(0, 1) ?? "S")
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">@Model.Student?.FullName</div>
                        <div class="text-muted small">@Model.Student?.Email</div>
                    </div>
                </div>
                
                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-project-diagram text-primary me-2"></i>Project Info</h6>
                <div class="mb-3">
                    <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Project Title</small>
                    <span class="fw-semibold text-dark">@Model.Title</span>
                </div>
                <div>
                    <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Status</small>
                    <span class="badge bg-success rounded-pill px-3 mb-4">@Model.Status</span>
                </div>
                
                <h6 class="fw-bold text-dark mb-3 mt-3"><i class="fas fa-chalkboard-teacher text-primary me-2"></i>Examiner Info</h6>
                @if (Model.AssignedExaminers.Any())
                {
                    @foreach (var examinerAssignment in Model.AssignedExaminers)
                    {
                        var examiner = examinerAssignment.Examiner;
                        if (examiner != null)
                        {
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div style="width:50px;height:50px;border-radius:50%;background:#dcfce7;display:flex;align-items:center;justify-content:center;color:#15803d;font-weight:700;font-size:18px;">
                                    @(examiner.FullName?.Substring(0, 1) ?? "E")
                                </div>
                                <div>
                                    <div class="fw-bold text-dark fs-5">@examiner.FullName</div>
                                    <div class="text-muted small">@examiner.Email</div>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="text-muted mb-4 small">
                        No examiner assigned to this project yet.
                    </div>
                    <button type="button" class="btn w-100 mb-3" style="background: #2563eb; color: white; font-weight: 600; border-radius: 10px;" data-bs-toggle="modal" data-bs-target="#inviteExaminerModal">
                        <i class="fas fa-user-plus me-2"></i>Invite Examiner
                    </button>
                }

            </div>

            <!-- Turnitin & Plagiarism Card -->
            <div class="glass-card mt-3">
                <h6 class="fw-bold text-dark mb-4"><i class="fas fa-search text-success me-2"></i>Plagiarism & Turnitin</h6>
                
                @if (Model.IsTurnitinApproved)
                {
                    <div class="alert alert-success d-flex align-items-center mb-0 p-3 border-0 shadow-sm">
                        <i class="fas fa-check-circle fs-4 me-3 text-success"></i>
                        <div>
                            <div class="fw-bold text-success mb-1">Approved (@Model.TurnitinScore%)</div>
                            <div class="small">The examiner can now proceed to grade.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning p-3 border-0 shadow-sm mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle fs-4 me-3 text-warning"></i>
                            <div>
                                <div class="fw-bold text-warning mb-1">Approval Required</div>
                                <div class="small">Pending approval. You can verify and approve the Turnitin score when grading the student's Final Report submission.</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Invite Examiner Modal -->
        <div class="modal fade" id="inviteExaminerModal" tabindex="-1" aria-labelledby="inviteExaminerModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content" style="border-radius: 16px; border: none; overflow: hidden;">
                    <div class="modal-header" style="background: var(--blue-grad); color: white; border-bottom: none; padding: 20px 24px;">
                        <h5 class="modal-title fw-bold" id="inviteExaminerModalLabel"><i class="fas fa-user-plus me-2"></i>Select an Examiner</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 bg-light">
                        <p class="text-muted mb-4">Select an examiner from the list below to evaluate <strong>@Model.Title</strong>.</p>
                        
                        <!-- Filters -->
                        <div class="row g-2 mb-4">
                            <div class="col-md-12">
                                <input type="text" id="examinerSearch" class="form-control" placeholder="Search by name or email..." onkeyup="filterExaminers()">
                            </div>
                            <div class="col-md-4">
                                <select id="deptFilter" class="form-select" onchange="filterExaminers()">
                                    <option value="">All Departments</option>
                                    @if (ViewBag.AvailableExaminers != null)
                                    {
                                        var depts = ((IEnumerable<ApplicationUser>)ViewBag.AvailableExaminers)
                                            .Where(u => !string.IsNullOrEmpty(u.EmpDepartment?.Name))
                                            .SelectMany(u => u.EmpDepartment!.Name.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            .Select(d => d.Trim())
                                            .Distinct()
                                            .OrderBy(d => d);
                                        foreach (var d in depts)
                                        {
                                            <option value="@d">@d</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <select id="progFilter" class="form-select" onchange="filterExaminers()">
                                    <option value="">All Programmes</option>
                                    @if (ViewBag.AvailableExaminers != null)
                                    {
                                        var progs = ((IEnumerable<ApplicationUser>)ViewBag.AvailableExaminers)
                                            .Where(u => !string.IsNullOrEmpty(u.Programme))
                                            .SelectMany(u => u.Programme.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            .Select(p => p.Trim())
                                            .Distinct()
                                            .OrderBy(p => p);
                                        foreach (var p in progs)
                                        {
                                            <option value="@p">@p</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <select id="specFilter" class="form-select" onchange="filterExaminers()">
                                    <option value="">All Specializations</option>
                                    @if (ViewBag.AvailableExaminers != null)
                                    {
                                        var specs = ((IEnumerable<ApplicationUser>)ViewBag.AvailableExaminers)
                                            .Where(u => !string.IsNullOrEmpty(u.Specialization))
                                            .SelectMany(u => u.Specialization.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            .Select(s => s.Trim())
                                            .Distinct()
                                            .OrderBy(s => s);
                                        foreach (var s in specs)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        
                        <div class="row row-cols-1 row-cols-md-2 g-4" id="examinerCardsContainer">
                            @if (ViewBag.AvailableExaminers != null)
                            {
                                foreach (var examiner in (IEnumerable<ApplicationUser>)ViewBag.AvailableExaminers)
                                {
                                    <div class="col examiner-card-wrapper" 
                                         data-name="@(examiner.FullName?.ToLower())" 
                                         data-email="@(examiner.Email?.ToLower())" 
                                         data-dept="@(examiner.EmpDepartment?.Name)" 
                                         data-prog="@(examiner.Programme)" 
                                         data-spec="@(examiner.Specialization)">
                                        <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px; transition: transform 0.2s;">
                                            <div class="card-body d-flex flex-column align-items-center text-center p-4">
                                                <div style="width:60px;height:60px;border-radius:50%;background:#e0e7ff;display:flex;align-items:center;justify-content:center;color:#4f46e5;font-weight:700;font-size:24px; margin-bottom: 12px;">
                                                    @(examiner.FullName?.Substring(0, 1) ?? "E")
                                                </div>
                                                <h6 class="fw-bold mb-1">@examiner.FullName</h6>
                                                <p class="text-muted small mb-2">@examiner.Email</p>
                                                
                                                <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
                                                    @if(!string.IsNullOrEmpty(examiner.EmpDepartment?.Name)) { <span class="badge" style="background: #475569; color: white; font-size: 0.75rem; padding: 5px 10px; border-radius: 6px;"><i class="fas fa-building me-1"></i> @examiner.EmpDepartment.Name</span> }
                                                    @if(!string.IsNullOrEmpty(examiner.Programme)) { <span class="badge" style="background: #0ea5e9; color: white; font-size: 0.75rem; padding: 5px 10px; border-radius: 6px;"><i class="fas fa-graduation-cap me-1"></i> @examiner.Programme</span> }
                                                    @if(!string.IsNullOrEmpty(examiner.Specialization)) { <span class="badge" style="background: #8b5cf6; color: white; font-size: 0.75rem; padding: 5px 10px; border-radius: 6px;"><i class="fas fa-star me-1"></i> @examiner.Specialization</span> }
                                                </div>
                                                
                                                <form action="/Supervisor/InviteExaminer" method="post" class="mt-auto w-100" onsubmit="return confirm('Are you sure you want to assign @(examiner.FullName) as the Examiner for this project? \n\nNote: Once assigned, you cannot change the examiner later.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="projectId" value="@Model.Id" />
                                                    <input type="hidden" name="examinerId" value="@examiner.Id" />
                                                    <button type="submit" class="btn w-100" style="background: #2563eb; color: #ffffff; font-weight: 600; border-radius: 8px; transition: background-color 0.2s;" onmouseover="this.style.background='#1d4ed8'" onmouseout="this.style.background='#2563eb'">
                                                        Select Examiner
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="glass-card">
                <h5 class="fw-bold text-dark mb-4"><i class="fas fa-stream text-primary me-2"></i>Project Milestones</h5>
                
                @if (!Model.Milestones.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-folder-open fs-1 opacity-25 d-block mb-3"></i>
                        No milestones configured yet.
                    </div>
                }
                else
                {
                    <div class="milestone-list">
                        @foreach (var m in Model.Milestones.OrderBy(x => x.DueDate))
                        {
                            <div class="milestone-item d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@m.Title</h6>
                                    @if (!string.IsNullOrEmpty(m.Description))
                                    {
                                        <p class="text-muted small mb-2" style="max-width: 500px;">@m.Description</p>
                                    }
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge @(m.Status == "Approved" ? "bg-success" : (m.Status == "Pending" ? "bg-warning text-dark" : "bg-primary")) rounded-pill">@m.Status</span>
                                        @if (m.DueDate.HasValue)
                                        {
                                            <small class="text-muted fw-semibold"><i class="far fa-calendar-alt me-1"></i>Due: @m.DueDate.Value.ToString("dd MMM yyyy")</small>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (m.Status == "Submitted" || m.Status == "UnderReview" || m.Status == "Approved" || m.Status == "Rejected" || m.Status == "Revision")
                                    {
                                        <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = m.Id })" class="btn-action text-decoration-none" style="background: #e0f2fe; color: #0284c7;" title="Review Documents">
                                            <i class="fas fa-file-alt"></i> Review
                                        </a>
                                    }
                                </div>                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(e, form) {
            e.preventDefault();
            Swal.fire({
                title: 'Delete Milestone?',
                text: "Are you sure you want to delete this milestone? This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, delete it!',
                background: '#ffffff',
                customClass: { popup: 'rounded-4 shadow-lg border-0' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        }

        document.addEventListener('MilestoneUpdateEvent', function(e) {
            const payload = e.detail;
            payload._handled = true;
            Swal.fire({
                title: payload.title,
                text: payload.message,
                icon: 'info',
                showCancelButton: true,
                confirmButtonText: 'Refresh Page',
                cancelButtonText: 'Later'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.reload();
                }
            });
        });
        function filterExaminers() {
            const searchTerm = document.getElementById('examinerSearch').value.toLowerCase();
            const deptFilter = document.getElementById('deptFilter').value;
            const progFilter = document.getElementById('progFilter').value;
            const specFilter = document.getElementById('specFilter').value;

            const cards = document.querySelectorAll('.examiner-card-wrapper');
            let visibleCount = 0;

            cards.forEach(card => {
                const name = card.getAttribute('data-name') || "";
                const email = card.getAttribute('data-email') || "";
                const dept = card.getAttribute('data-dept') || "";
                const prog = card.getAttribute('data-prog') || "";
                const spec = card.getAttribute('data-spec') || "";

                const matchesSearch = name.includes(searchTerm) || email.includes(searchTerm);
                
                const hasDept = deptFilter === "" || dept.split(',').map(s => s.trim()).includes(deptFilter);
                const hasProg = progFilter === "" || prog.split(',').map(s => s.trim()).includes(progFilter);
                const hasSpec = specFilter === "" || spec.split(',').map(s => s.trim()).includes(specFilter);

                if (matchesSearch && hasDept && hasProg && hasSpec) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Optionally handle empty state
            const container = document.getElementById('examinerCardsContainer');
            let emptyMsg = document.getElementById('examiner-empty-msg');
            if (visibleCount === 0) {
                if (!emptyMsg) {
                    emptyMsg = document.createElement('div');
                    emptyMsg.id = 'examiner-empty-msg';
                    emptyMsg.className = 'col-12 text-center text-muted py-5';
                    emptyMsg.innerHTML = 'No examiners found matching the selected filters.';
                    container.appendChild(emptyMsg);
                }
                emptyMsg.style.display = 'block';
            } else {
                if (emptyMsg) {
                    emptyMsg.style.display = 'none';
                }
            }
        }
    </script>
}
