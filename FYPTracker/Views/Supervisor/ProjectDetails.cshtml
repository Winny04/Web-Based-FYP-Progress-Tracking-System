@using FYPTracker.Models
@model FYPProject
@{
    ViewData["Title"] = "Manage Project Milestones";
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .glass-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid rgba(37, 99, 235, 0.1);
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        padding: 24px;
        margin-bottom: 20px;
    }

    .milestone-item {
        border-left: 4px solid #3b82f6;
        background: #f8fafc;
        border-radius: 0 12px 12px 0;
        padding: 16px 20px;
        margin-bottom: 16px;
        transition: all 0.2s ease;
    }
    .milestone-item:hover {
        background: #f1f5f9;
        transform: translateX(4px);
    }

    .btn-action {
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
        transition: all 0.2s;
    }
    .btn-edit { background: #e0e7ff; color: #4f46e5; }
    .btn-edit:hover { background: #c7d2fe; }
    .btn-delete { background: #fee2e2; color: #dc2626; }
    .btn-delete:hover { background: #fecaca; }
    .btn-add { background: #2563eb; color: white; border-radius: 10px; padding: 10px 20px; font-weight: 600; }
    .btn-add:hover { background: #1d4ed8; color: white;}
</style>

<div class="container-fluid py-4">
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">@TempData["Error"]</div>
    }

    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <a href="/Supervisor/MyProjects" class="text-white text-decoration-none opacity-75 mb-2 d-inline-block"><i class="fas fa-arrow-left me-2"></i>Back to Projects</a>
            <h2 class="fw-bold mb-1"><i class="fas fa-tasks me-2"></i>Milestone Management</h2>
            <p class="mb-0 opacity-80">Configure tracking milestones for this student.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="glass-card">
                <h6 class="fw-bold text-dark mb-4"><i class="fas fa-user-graduate text-primary me-2"></i>Student Details</h6>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div style="width:50px;height:50px;border-radius:50%;background:#e0e7ff;display:flex;align-items:center;justify-content:center;color:#4f46e5;font-weight:700;font-size:18px;">
                        @(Model.Student?.FullName?.Substring(0, 1) ?? "S")
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">@Model.Student?.FullName</div>
                        <div class="text-muted small">@Model.Student?.Email</div>
                    </div>
                </div>
                
                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-project-diagram text-primary me-2"></i>Project Info</h6>
                <div class="mb-3">
                    <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Project Title</small>
                    <span class="fw-semibold text-dark">@Model.Title</span>
                </div>
                <div>
                    <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Status</small>
                    <span class="badge bg-success rounded-pill px-3 mb-4">@Model.Status</span>
                </div>
                
                <h6 class="fw-bold text-dark mb-3 mt-3"><i class="fas fa-chalkboard-teacher text-primary me-2"></i>Examiner Info</h6>
                @if (Model.AssignedExaminers.Any())
                {
                    @foreach (var examinerAssignment in Model.AssignedExaminers)
                    {
                        var examiner = examinerAssignment.Examiner;
                        if (examiner != null)
                        {
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div style="width:50px;height:50px;border-radius:50%;background:#dcfce7;display:flex;align-items:center;justify-content:center;color:#15803d;font-weight:700;font-size:18px;">
                                    @(examiner.FullName?.Substring(0, 1) ?? "E")
                                </div>
                                <div>
                                    <div class="fw-bold text-dark fs-5">@examiner.FullName</div>
                                    <div class="text-muted small">@examiner.Email</div>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="p-3 bg-light rounded-3 text-muted mb-3 small d-flex align-items-center gap-2">
                        <i class="fas fa-info-circle text-primary fs-5"></i>
                        <span>No examiner assigned yet.<br /><small class="text-muted">Examiners are assigned by the Administrator.</small></span>
                    </div>
                }

            </div>

            <!-- Turnitin & Plagiarism Card -->
            <div class="glass-card mt-3">
                <h6 class="fw-bold text-dark mb-4"><i class="fas fa-search text-success me-2"></i>Plagiarism & Turnitin</h6>
                
                @if (Model.IsTurnitinApproved)
                {
                    <div class="alert alert-success d-flex align-items-center mb-0 p-3 border-0 shadow-sm">
                        <i class="fas fa-check-circle fs-4 me-3 text-success"></i>
                        <div>
                            <div class="fw-bold text-success mb-1">Approved (@Model.TurnitinScore%)</div>
                            <div class="small">The examiner can now proceed to grade.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning p-3 border-0 shadow-sm mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle fs-4 me-3 text-warning"></i>
                            <div>
                                <div class="fw-bold text-warning mb-1">Approval Required</div>
                                <div class="small">Pending approval. You can verify and approve the Turnitin score when grading the student's Final Report submission.</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-8">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold text-dark mb-0"><i class="fas fa-stream text-primary me-2"></i>Project Milestones</h5>
                    
                    @{
                        var stage1Milestone = Model.Milestones.FirstOrDefault(m => m.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase));
                        var stage2Milestones = Model.Milestones.Where(m => m.Title.StartsWith("Step", StringComparison.OrdinalIgnoreCase)).ToList();
                        bool isAllStage2Approved = stage2Milestones.Any() && stage2Milestones.All(m => m.Status == "Approved" || m.Status == "Completed");
                    }
                    <div>
                        @if (stage1Milestone != null && (stage1Milestone.Status == "Approved" || stage1Milestone.Status == "Completed"))
                        {
                            <button type="button" class="btn btn-primary shadow-sm btn-sm px-4 me-2" data-bs-toggle="modal" data-bs-target="#uploadMarksheetModal_@Model.Id">
                                <i class="fas fa-file-excel me-2"></i> Upload Stage 1 Marksheet
                            </button>
                            
                            <!-- Upload Marksheet Modal for Stage 1 -->
                            <div class="modal fade" id="uploadMarksheetModal_@Model.Id" tabindex="-1" aria-labelledby="uploadMarksheetModalLabel_@Model.Id" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg rounded-4">
                                        <div class="modal-header border-bottom-0 pb-0">
                                            <h5 class="modal-title fw-bold text-dark" id="uploadMarksheetModalLabel_@Model.Id">Upload Stage 1 Marksheet</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body pt-3">
                                            <p class="text-muted small mb-3">Please download the student's submitted marksheet, fill in your marks, and upload it back here.</p>
                                            
                                            <div class="mb-4 bg-light p-3 rounded">
                                                <h6 class="fw-bold fs-7 mb-2 text-dark">Student's Submitted Files:</h6>
                                                @if (stage1Milestone.SubmissionFiles != null && stage1Milestone.SubmissionFiles.Any())
                                                {
                                                    foreach (var file in stage1Milestone.SubmissionFiles)
                                                    {
                                                        <a href="@file.FilePath" class="btn btn-sm btn-outline-secondary me-2 mb-2" target="_blank" download>
                                                            <i class="fas fa-file-download me-1"></i> @file.FileName
                                                        </a>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">No files submitted by student yet.</span>
                                                }
                                            </div>
                                            
                                            <form asp-controller="Supervisor" asp-action="UploadMarksheetStage1" method="post" enctype="multipart/form-data">
                                                <input type="hidden" name="projectId" value="@Model.Id" />
                                                @{ var idempotencyToken = Guid.NewGuid().ToString(); TempData["IdempotencyToken"] = idempotencyToken; }
                                                <input type="hidden" name="idempotencyToken" value="@idempotencyToken" />
                                                
                                                <div class="mb-4">
                                                    <label for="marksheetFile" class="form-label fw-bold">Select Excel File</label>
                                                    <input class="form-control" type="file" id="marksheetFile" name="marksheetFile" accept=".xls,.xlsx" required>
                                                    <div class="form-text mt-2"><i class="fas fa-info-circle me-1"></i> Only .xls and .xlsx formats are accepted.</div>
                                                </div>
                                                
                                                <div class="d-grid mt-4">
                                                    <button type="submit" class="btn btn-primary rounded-3 py-2 fw-bold">
                                                        <i class="fas fa-cloud-upload-alt me-2"></i> Upload & Extract Score
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (isAllStage2Approved)
                        {
                            <a href="@Url.Action("GradeMarksheetStage2", "Supervisor", new { id = Model.Id })" class="btn btn-success shadow-sm btn-sm px-4">
                                <i class="fas fa-clipboard-check me-2"></i> Grade Stage 2 Final Report
                            </a>
                        }
                    </div>
                </div>
                
                @if (stage1Milestone != null && !string.IsNullOrEmpty(stage1Milestone.SupervisorMarksheetData))
                {
                    string supFilePath = "";
                    string supScore = "";
                    if (stage1Milestone.SupervisorMarksheetData.StartsWith("{"))
                    {
                        try
                        {
                            using var doc = System.Text.Json.JsonDocument.Parse(stage1Milestone.SupervisorMarksheetData);
                            if (doc.RootElement.TryGetProperty("FilePath", out var fp)) supFilePath = fp.GetString();
                            if (doc.RootElement.TryGetProperty("Score", out var sc)) supScore = sc.GetString();
                        } catch { }
                    }
                    
                    if (!string.IsNullOrEmpty(supFilePath))
                    {
                        <div class="alert alert-success mb-4 p-3 d-flex align-items-center justify-content-between rounded-3 border-0 shadow-sm">
                            <div class="d-flex flex-column">
                                <h6 class="fw-bolder text-dark mb-1"><i class="fas fa-check-circle text-success me-2"></i>Stage 1 Marksheet Uploaded</h6>
                                <span><a href="@supFilePath" target="_blank" class="fw-bold text-success text-decoration-none"><i class="fas fa-download me-1"></i>Download your uploaded file</a></span>
                                <span class="text-dark mt-1 small">Score extracted: <strong class="badge bg-success">@(supScore ?? "N/A")</strong></span>
                            </div>
                        </div>
                    }
                }
                
                @if (!Model.Milestones.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-folder-open fs-1 opacity-25 d-block mb-3"></i>
                        No milestones configured yet.
                    </div>
                }
                else
                {
                    <div class="milestone-list">
                        @foreach (var m in Model.Milestones.Where(m => m.MilestoneSource == "Supervisor").OrderBy(x => x.DueDate))
                        {
                            <div class="milestone-item d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@m.Title</h6>
                                    @if (!string.IsNullOrEmpty(m.Description))
                                    {
                                        <p class="text-muted small mb-2" style="max-width: 500px;">@m.Description</p>
                                    }
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge @(m.Status == "Approved" ? "bg-success" : (m.Status == "Pending" ? "bg-warning text-dark" : "bg-primary")) rounded-pill">@m.Status</span>
                                        @if (m.DueDate.HasValue)
                                        {
                                            <small class="text-muted fw-semibold"><i class="far fa-calendar-alt me-1"></i>Due: @m.DueDate.Value.ToString("dd MMM yyyy")</small>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (m.Status == "Submitted" || m.Status == "UnderReview" || m.Status == "Approved" || m.Status == "Rejected" || m.Status == "Revision")
                                    {
                                        <a href="@Url.Action("GradeSubmission", "Supervisor", new { id = m.Id })" class="btn-action text-decoration-none" style="background: #e0f2fe; color: #0284c7;" title="Review Documents">
                                            <i class="fas fa-file-alt"></i> Review
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(e, form) {
            e.preventDefault();
            Swal.fire({
                title: 'Delete Milestone?',
                text: "Are you sure you want to delete this milestone? This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, delete it!',
                background: '#ffffff',
                customClass: { popup: 'rounded-4 shadow-lg border-0' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        }

        document.addEventListener('MilestoneUpdateEvent', function(e) {
            const payload = e.detail;
            payload._handled = true;
            Swal.fire({
                title: payload.title,
                text: payload.message,
                icon: 'info',
                showCancelButton: true,
                confirmButtonText: 'Refresh Page',
                cancelButtonText: 'Later'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.reload();
                }
            });
        });
    </script>
}
