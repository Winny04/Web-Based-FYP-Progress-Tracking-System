@{
    var supervisorLogTemplates = new Dictionary<
        string, FYPTracker.ViewModels.MeetingRecordTemplateVM>
    {
        ["1"] = await MeetingLogTemplateService.LoadAsync(1),
        ["2"] = await MeetingLogTemplateService.LoadAsync(2)
    };

    var supervisorLogTemplatesJson = JsonSerializer.Serialize(
        supervisorLogTemplates,
        new JsonSerializerOptions(JsonSerializerDefaults.Web)
    );
}

<script type="application/json" id="supervisorLogTemplatesJson">
@Html.Raw(supervisorLogTemplatesJson)
</script>

