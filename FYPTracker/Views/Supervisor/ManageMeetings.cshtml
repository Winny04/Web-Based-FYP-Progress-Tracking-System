                                <strong id="spStudentName" class="text-dark"></strong>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Current Booking:</small>
                                <strong id="spCurrentSchedule" class="text-dark"></strong>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" id="spOriginalDate" />
                    <input type="hidden" id="spOriginalTime" />
                    <div id="spSameScheduleError" class="alert alert-warning py-2 small mb-3" style="display:none;">
                        <i class="fas fa-exclamation-triangle me-1"></i> The proposed date and time are the same as your current meeting. Please select a different date or time.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Proposed Date <span class="text-danger">*</span></label>
                        <input type="date" name="proposedDate" id="spDateInput" class="form-control rounded-3" required min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="updateSupervisorProposeAvailability()" />
