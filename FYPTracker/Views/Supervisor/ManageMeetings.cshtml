<!-- Reschedule Reject Modal -->
<div class="modal fade" id="rescheduleRejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form asp-action="RespondRescheduleRequest" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" id="rejectRequestId" />
                <input type="hidden" name="status" value="Rejected" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-times-circle text-danger me-2"></i>Reject Reschedule Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason for Rejection</label>
                        <textarea name="reason" class="form-control rounded-3" rows="3" required placeholder="Please explain why the request is rejected..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4 rounded-3">Submit Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reschedule Counter Propose Modal -->
<div class="modal fade" id="rescheduleCounterProposeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form asp-action="RespondRescheduleRequest" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" id="counterProposeRequestId" />
                <input type="hidden" name="status" value="CounterProposed" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-calendar-plus text-primary me-2"></i>Propose Another Date</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="cpOriginalDate" />
                    <input type="hidden" id="cpOriginalTime" />
                    <div id="cpSameScheduleError" class="alert alert-warning py-2 small mb-3" style="display:none;">
                        <i class="fas fa-exclamation-triangle me-1"></i> The proposed date and time are the same as your current meeting. Please select a different date or time.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Proposed Date</label>
                        <input type="date" name="proposedDate" id="cpDateInput" class="form-control" required onchange="updateCpAvailability()" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Available Slots</label>
                        <input type="hidden" name="proposedTime" id="cpTimeInput" required />
                        <div class="row g-2" id="cpTimeSlots">
                            <div class="col-12 text-muted small"><i class="fas fa-arrow-up"></i> Please pick a date first.</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message / Reason</label>
                        <textarea name="reason" class="form-control rounded-3" rows="3" required placeholder="Explain why you are proposing this date..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3" id="cpSubmitBtn" disabled>Send Proposal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Supervisor Propose New Meeting Time Modal -->
<div class="modal fade" id="supervisorProposeModal" tabindex="-1">
