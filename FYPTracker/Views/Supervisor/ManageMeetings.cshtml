        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form asp-action="ProposeMeetingReschedule" method="post" id="supervisorProposeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="meetingId" id="spMeetingId" />
