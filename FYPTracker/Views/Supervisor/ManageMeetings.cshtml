                        <textarea name="reason" id="spReasonInput" class="form-control rounded-3" rows="3" required minlength="5" placeholder="e.g. Schedule conflict due to unavailable period; proposing alternative time..."></textarea>
                        <small class="text-muted">This message will be displayed to the student along with the proposed schedule.</small>
