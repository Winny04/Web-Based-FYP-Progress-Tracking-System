@using FYPTracker.Models
@model IEnumerable<MeetingBooking>
@using System.Text.Json
@inject FYPTracker.Services.Forms.MeetingLogTemplateService MeetingLogTemplateService
@inject FYPTracker.Services.Meetings.IMeetingRequirementService MeetingReqService
@{
    ViewData["Title"] = "Manage Meetings";
    var user = ViewBag.CurrentUser as ApplicationUser;
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .glass-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid rgba(37, 99, 235, 0.1);
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .status-badge {
        font-size: .72rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .badge-pending   { background: #fef9c3; color: #854d0e; }
    .badge-approved  { background: #dcfce7; color: #14532d; }
    .badge-rejected  { background: #fee2e2; color: #991b1b; }
    .badge-postponed { background: #dbeafe; color: #1e40af; }

    .time-slot {
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        font-size: .85rem;
        font-weight: 700;
        text-align: center;
        transition: all .2s;
        background: #f8fafc;
        color: #374151;
        border-color: #e2e8f0;
    }
    .time-slot:hover { border-color: #64748b; background: #f1f5f9; }
    .time-slot.selected { border-color: #1e293b; background: #1e293b; color: white; }
    .time-slot.booked { background: #f3f4f6 !important; color: #9ca3af !important; border-color: #e5e7eb !important; cursor: not-allowed; opacity: 0.7; text-decoration: line-through; }

    .table th { font-size: .73rem; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; font-weight: 700; }
    .table td { font-size: .87rem; vertical-align: middle; }

    /* FullCalendar Custom Overrides */
    .fc .fc-daygrid-body tr:hover { background-color: transparent !important; }
    .fc .fc-daygrid-day:hover { background-color: #f8fafc !important; cursor: pointer; }

    /* Custom Monochrome Tabs */
    #meetingTabs .nav-link { color: #475569; transition: all 0.2s; }
    #meetingTabs .nav-link:hover { background-color: #f1f5f9; color: #1e293b; }
    #meetingTabs .nav-link.active { background-color: #0f172a !important; color: #ffffff !important; }

    #reviewLogModal .modal-content {
    max-height: calc(100dvh - 32px);
    overflow: hidden;
}

#reviewLogModal #reviewLogForm {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    max-height: calc(100dvh - 32px);
}

#reviewLogModal .modal-header,
#reviewLogModal .modal-footer {
    flex-shrink: 0;
}

#reviewLogModal .modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
}

/* ===== Respond Meeting Modal Fix ===== */

.modal[id^="respondModal_"] .modal-dialog {
    max-width: 860px;
    width: calc(100% - 32px);
    height: min(780px, calc(100dvh - 32px));
    margin: 16px auto;
}

.modal[id^="respondModal_"] .modal-content {
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 14px;
}

/* Important: form is between modal-content and modal-body */
.modal[id^="respondModal_"] .modal-content > form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
}

.modal[id^="respondModal_"] .modal-header {
    flex-shrink: 0;
    background: #fff;
    padding: 16px 20px;
    border-bottom: 1px solid #e2e8f0;
}

.modal[id^="respondModal_"] .modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    padding: 20px;
}

.modal[id^="respondModal_"] .modal-footer {
    flex-shrink: 0;
    background: #fff;
    padding: 12px 20px;
    border-top: 1px solid #e2e8f0;
}

/* Mobile */
  @@media (max-width: 576px) {
    .modal[id^="respondModal_"] .modal-dialog {
        max-width: none;
        width: calc(100% - 16px);
        height: calc(100dvh - 16px);
        margin: 8px auto;
    }

    .modal[id^="respondModal_"] .modal-body {
        padding: 14px;
    }
}

</style>

<div class="container-xxl py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-3 d-flex align-items-center gap-2">
            <i class="fas fa-check-circle fs-4"></i> <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-3 d-flex align-items-center gap-2">
            <i class="fas fa-exclamation-circle fs-4"></i> <span>@TempData["Error"]</span>
        </div>
    }



    <!-- Tomorrow's Meeting Reminder -->
    @{
        var tomorrowMeetings = Model.Where(m => m.Status == "Approved" && m.MeetingDate.Date == DateTime.Today.AddDays(1).Date).ToList();
    }
    @if (tomorrowMeetings.Any())
    {
        foreach(var tm in tomorrowMeetings)
        {
            <div class="alert alert-primary border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" style="background-color: #e0f2fe;">
                <i class="fas fa-bell fa-2x text-primary me-3"></i>
                <div>
                    <h5 class="mb-1 fw-bold text-primary">Reminder: Upcoming Meeting Tomorrow!</h5>
                    <p class="mb-0 text-dark">You have an approved meeting scheduled for tomorrow with <strong>@tm.Student?.FullName</strong> at <strong>@tm.MeetingTime</strong>.</p>
                    @if(!string.IsNullOrEmpty(tm.MeetingLink)) {
                        <p class="mb-0 mt-1"><a href="@tm.MeetingLink" target="_blank" class="btn btn-sm btn-primary"><i class="fas fa-video me-1"></i> Join Online Meeting</a></p>
                    } else if(!string.IsNullOrEmpty(tm.Location)) {
                        <p class="mb-0 mt-1 text-dark"><i class="fas fa-map-marker-alt text-danger me-1"></i> <strong>Location / Link:</strong> @tm.Location</p>
                    }
                </div>
            </div>
        }
    }

    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-white"><i class="fas fa-calendar-alt me-2"></i>Manage Meetings</h2>
            <p class="mb-0 text-white opacity-75">Oversee and respond to meeting requests from your students.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @await Html.PartialAsync("_SessionFilter")
            <div class="d-flex align-items-center position-relative my-1">
                <i class="fas fa-user position-absolute ms-3 text-muted"></i>
                <select id="studentFilter" class="form-select border-0 shadow-sm ps-10" style="border-radius: 10px; min-width: 200px;">
                    <option value="">All Students</option>
                    @foreach (var studentName in Model.Select(m => m.Student?.FullName).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s))
                    {
                        <option value="@studentName">@studentName</option>
                    }
                </select>
            </div>
            <div class="d-flex align-items-center position-relative my-1">
                <i class="fas fa-info-circle position-absolute ms-3 text-muted"></i>
                <select id="statusFilter" class="form-select border-0 shadow-sm ps-10" style="border-radius: 10px; min-width: 150px;">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                    <option value="Postponed">Postponed</option>
                </select>
            </div>
            <div class="d-flex align-items-center position-relative my-1">
                <i class="fas fa-comment-dots position-absolute ms-3 text-muted"></i>
                <select id="feedbackFilter" class="form-select border-0 shadow-sm ps-10" style="border-radius: 10px; min-width: 200px;">
                    <option value="">All Feedback States</option>
                    <option value="NeedFeedback">Needs Feedback</option>
                    <option value="Done">Reviewed / Signed</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Tabs Nav -->
    <ul class="nav nav-pills mb-4" id="meetingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold px-4 rounded-pill" id="list-tab" data-bs-toggle="pill" data-bs-target="#list-view" type="button" role="tab" aria-controls="list-view" aria-selected="true">
                <i class="fas fa-list-ul me-2"></i> List View
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4 rounded-pill ms-2" id="calendar-tab" data-bs-toggle="pill" data-bs-target="#calendar-view" type="button" role="tab" aria-controls="calendar-view" aria-selected="false">
                <i class="fas fa-calendar-alt me-2"></i> Calendar View
            </button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="meetingTabsContent">
        <!-- List View -->
        <div class="tab-pane fade show active" id="list-view" role="tabpanel" aria-labelledby="list-tab">

            
            <!-- Pending Reschedule Requests -->
            @{
                var pendingReschedules = ViewBag.PendingReschedules as IEnumerable<FYPTracker.Models.MeetingRescheduleRequest>;
            }
            @if (pendingReschedules != null && pendingReschedules.Any())
            {
                <div class="glass-card p-4 mb-4" style="border-left: 4px solid #f59e0b;">
                    <h5 class="fw-bold mb-3"><i class="fas fa-clock text-warning me-2"></i>Pending Reschedule Requests</h5>
                    <div class="table-responsive">
                        <table class="table align-middle gs-0 gy-3">
                            <thead>
                                <tr class="fw-bolder text-muted bg-light">
                                    <th class="ps-4 min-w-150px">Student</th>
                                    <th class="min-w-150px">Original Date & Time</th>
                                    <th class="min-w-150px">Proposed Date & Time</th>
                                    <th class="min-w-200px">Reason</th>
                                    <th class="text-end min-w-200px pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in pendingReschedules)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@req.Student?.FullName</td>
                                        <td>
                                            <div class="text-danger"><i class="fas fa-calendar-times me-1"></i>@req.OriginalDate.ToString("dd MMM yyyy")</div>
                                            <div class="small text-muted">@req.OriginalTime</div>
                                        </td>
                                        <td>
                                            <div class="text-success"><i class="fas fa-calendar-check me-1"></i>@req.ProposedDate.ToString("dd MMM yyyy")</div>
                                            <div class="small text-muted">@req.ProposedTime</div>
                                        </td>
                                        <td>@req.Reason</td>
                                        <td class="text-end pe-4">
                                            <form asp-action="RespondRescheduleRequest" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@req.Id" />
                                                <input type="hidden" name="status" value="Approved" />
                                                <button type="submit" class="btn btn-sm btn-success fw-semibold border-0 me-1"><i class="fas fa-check"></i> Approve</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-danger fw-semibold border-0 me-1" onclick="openRescheduleRejectModal(@req.Id)">
                                                <i class="fas fa-times"></i> Reject
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary fw-semibold border-0" onclick="openRescheduleCounterProposeModal(@req.Id)">
                                                <i class="fas fa-calendar-plus"></i> Propose Date
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="glass-card p-4">
                <div class="table-responsive">
                    <table class="table align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted bg-light">
                        <th class="ps-4 min-w-150px">Date & Time</th>
                        <th class="min-w-100px">Stage & Week</th>
                        <th class="min-w-120px">Status</th>
                        <th class="min-w-150px">Logbook Feedback</th>
                        <th class="text-end min-w-120px pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var groupedMeetings = Model.GroupBy(m => m.Student).Where(g => g.Key != null).ToList();
                    }
                    @foreach (var group in groupedMeetings)
                    {
                        var student = group.Key;
                        
                        <tr class="bg-light-primary student-group" data-student-id="@student?.Id">
                            <td colspan="5" class="ps-4 py-3 border-bottom border-primary">
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-40px me-3">
                                        <span class="symbol-label bg-primary text-inverse-primary fw-bolder">@(student?.FullName?.FirstOrDefault() ?? '?')</span>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark fw-bolder fs-5">@student?.FullName</span>
                                        <span class="text-muted fw-bold fs-7">@student?.UserName</span>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        @foreach (var stageGroup in group.GroupBy(x => x.Stage).OrderBy(g => g.Key))
                        {
                            var prog = student != null ? await MeetingReqService.GetStudentProgressAsync(student.Id, stageGroup.Key ?? 1) : null;
                            <tr class="bg-light">
                                <td colspan="5" class="ps-4 py-2">
                                    <div class="d-flex justify-content-between align-items-center pe-4">
                                        <span class="text-primary fw-bold">Stage @stageGroup.Key</span>
                                        @if(prog != null && prog.Required.HasValue) {
                                            <span class="badge @(prog.Completed >= prog.Required.Value ? "bg-success" : "bg-warning text-dark")">Progress: @prog.Completed / @prog.Required.Value</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                            @foreach (var m in stageGroup.OrderByDescending(x => x.MeetingDate).ThenByDescending(x => x.MeetingTime))
                            {
                            var feedbackState = (m.Status == "Approved" && m.MeetingLog != null && m.MeetingLog.LogStatus == "Draft") ? "NeedFeedback" : (m.MeetingLog != null && m.MeetingLog.LogStatus == "Signed" ? "Done" : "");

                            <tr class="meeting-item" id="meetingRow_@m.Id" data-student-id="@student?.Id" data-student-name="@student?.FullName" data-status="@m.Status" data-feedback="@feedbackState">
                                <td class="ps-4">
                                    <div class="fw-bold">@m.MeetingDate.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted small">@m.MeetingTime</div>
                                </td>
                                <td>
                                    <span class="badge @(m.Stage == 1 ? "bg-info" : "bg-primary")">Stage @m.Stage</span><br/>
                                    @if(m.WeekNumber > 0) {
                                        <span class="badge bg-secondary text-white mt-1">Week @m.WeekNumber</span>
                                    } else {
                                        <span class="badge bg-light text-muted mt-1 border">Unlogged</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-badge @(m.Status == "Approved" ? "badge-approved" : m.Status == "Rejected" ? "badge-rejected" : m.Status == "Postponed" ? "badge-postponed" : "badge-pending")">
                                        @m.Status
                                    </span>
                                </td>
                                <td>
                                    @if (feedbackState == "NeedFeedback")
                                    {
                                        <span class="badge badge-light-warning">Needs Feedback</span>
                                    }
                                    else if (feedbackState == "Done")
                                    {
                                        <span class="badge badge-light-success">Reviewed & Signed</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light-primary rounded-3" 
                                            onclick="showMeetingDetails(@m.Id, '@m.MeetingDate.ToString("yyyy-MM-dd")', '@m.MeetingTime', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.Student?.FullName ?? ""))', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.Reason ?? "No agenda provided."))', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.SupervisorNote ?? "No notes added."))', '@m.Status', '@(m.ProposedNewDate?.ToString("yyyy-MM-dd") ?? "")', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.Location ?? ""))', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.MeetingLink ?? ""))')">
                                        <i class="fas fa-info-circle"></i> View Details
                                    </button>
                                    
                                    @if (m.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-sm btn-primary rounded-3 ms-1" data-bs-toggle="modal" data-bs-target="#respondModal_@m.Id">
                                            Respond
                                        </button>

                                        <!-- Quick Respond Modal -->
                                        <div class="modal fade" id="respondModal_@m.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                                <div class="modal-content border-0 shadow-lg">
                                                    <form asp-action="RespondMeeting" method="post" id="respondForm_@m.Id" onsubmit="return validateRespondModal(@m.Id)">
                                                        <div class="modal-header">
                                                            <h5 class="fw-bold">Respond to @m.Student?.FullName</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <input type="hidden" name="meetingId" value="@m.Id" />
                                                            
                                                            <!-- Meeting Context -->
                                                            <div class="mb-4 p-3 bg-light rounded border border-primary border-opacity-25">
                                                                <div class="fw-bold text-dark mb-1"><i class="fas fa-calendar-alt text-primary me-2"></i>Requested Date & Time:</div>
                                                                <div class="mb-3 ms-4 fs-6">@m.MeetingDate.ToString("dd MMM yyyy") at @m.MeetingTime</div>
                                                                
                                                                <div class="fw-bold text-dark mb-1"><i class="fas fa-comment-dots text-primary me-2"></i>Student's Agenda:</div>
                                                                <div class="ms-4 text-muted fst-italic" style="white-space: pre-wrap;">@(string.IsNullOrEmpty(m.Reason) ? "No specific agenda provided." : m.Reason)</div>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Decision</label>
                                                                <select name="status" class="form-select rounded-3 border-primary" id="decisionSelect_@m.Id" onchange="toggleProposedDate(@m.Id); toggleRecurringWeeks(@m.Id)">
                                                                    <option value="Approved">Approve Meeting</option>
                                                                    <option value="Rejected">Decline Meeting</option>
                                                                    <option value="Postponed">Postpone Meeting</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3" id="recurringWeeksContainer_@m.Id">
                                                                <label class="form-label fw-bold text-primary">Meeting Structure</label>
                                                                <div class="alert alert-primary py-2 px-3 mb-0" style="font-size: 0.9rem;">
                                                                    <i class="fas fa-info-circle me-1"></i> Weekly progress tracking runs independently. Approving this request only books this single meeting.
                                                                </div>
                                                                <input type="hidden" name="recurringWeeks" id="recurringWeeks_@m.Id" value="1" />
                                                            </div>
                                                            <div class="mb-3" id="proposedDateContainer_@m.Id" style="display: none;">
                                                                <label class="form-label fw-bold text-primary">Proposed New Date</label>
                                                                <input type="date" name="proposedDate" id="proposedDate_@m.Id" class="form-control rounded-3 border-primary" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" oninput="validateRespondModalRealtime(@m.Id)" />
                                                                <div id="proposedDateError_@m.Id" class="text-danger fw-bold small mt-1 d-none">Please provide a proposed date.</div>
                                                            </div>
                                                            <div class="mb-3" id="meetingTimeContainer_@m.Id">
                                                                <label class="form-label fw-bold">Meeting Time</label>
                                                                <input type="time" name="newMeetingTime" id="newMeetingTime_@m.Id" class="form-control rounded-3 bg-light" value="@m.MeetingTime" readonly />
                                                            </div>
                                                            <div class="mb-3" id="locationContainer_@m.Id">
                                                                <label class="form-label fw-bold">Meeting Location / Link</label>
                                                                <input type="text" name="location" id="location_@m.Id" class="form-control rounded-3" placeholder="e.g. MS Teams Link, Room 404" oninput="validateRespondModalRealtime(@m.Id)" />
                                                                <div class="mt-2 d-flex flex-wrap gap-2">
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('location_@m.Id').value = 'Lab 1'; validateRespondModalRealtime(@m.Id)">Lab 1</button>
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('location_@m.Id').value = 'Room 402'; validateRespondModalRealtime(@m.Id)">Room 402</button>
                                                                    <button type="button" class="btn btn-sm btn-primary border-0 fw-semibold" onclick="document.getElementById('location_@m.Id').value = 'Online'; validateRespondModalRealtime(@m.Id)"><i class="fas fa-video me-1"></i> Auto-Generate Online Link</button>
                                                                </div>
                                                                <div id="locationError_@m.Id" class="text-danger fw-bold small mt-1 d-none">Location is required when approving.</div>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Message to Student <span class="text-danger">*</span></label>
                                                                <textarea name="note" id="note_@m.Id" class="form-control rounded-3" rows="3" placeholder="Add instructions or feedback..." oninput="validateRespondModalRealtime(@m.Id)"></textarea>
                                                                <div class="mt-2 d-flex flex-wrap gap-2">
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('note_@m.Id').value = 'Approved! Please bring your updated logbook.'; validateRespondModalRealtime(@m.Id)">Bring Logbook</button>
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('note_@m.Id').value = 'I am currently away. Let\'s reschedule to the proposed date.'; validateRespondModalRealtime(@m.Id)">Away / Reschedule</button>
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('note_@m.Id').value = 'Please provide a more detailed agenda before we meet.'; validateRespondModalRealtime(@m.Id)">Need Agenda</button>
                                                                </div>
                                                                <div id="noteError_@m.Id" class="text-danger fw-bold small mt-1 d-none">Please provide a valid reason (at least 10 characters).</div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0">
                                                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary rounded-3 px-4">Submit</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (m.Status == "Approved" && m.MeetingLog != null)
                                    {
                                        if (m.MeetingLog.LogStatus == "Draft")
                                        {
                                            <button type="button" class="btn btn-sm btn-warning rounded-3 ms-1" 
                                                    data-id="@m.Id"
                                                    data-student="@m.Student?.FullName"
                                                    data-date="@m.MeetingDate.ToString("dd/MM/yyyy")"
                                                    data-topics="@(m.MeetingLog?.KeyTopicsDiscussed)"
                                                    data-completed="@(m.MeetingLog?.CompletedActionsAndNotes)"
                                                    data-action="@(m.MeetingLog?.ActionPointsForNextMeeting)"
                                                    data-next-date="@(m.MeetingLog?.NextMeetingDate?.ToString("yyyy-MM-dd") ?? "")"
                                                    data-stage="@m.Stage"
                                                    data-supervisor="@(m.Supervisor?.FullName ?? "")"
                                                    onclick="openReviewLogModal(this)">
                                                Review Log
                                            </button>
                                        }
                                        else if (m.MeetingLog.LogStatus == "Signed")
                                        {
                                            <button type="button" class="btn btn-sm btn-success rounded-3 ms-1" onclick="viewFinalLog(@m.MeetingLog.Id)">
                                                View Final Log
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                            }
                        }
                    }
                    @if (!groupedMeetings.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-calendar-times fs-1 mb-3" style="color: #cbd5e1;"></i>
                                    <h5 class="fw-bold text-dark mb-1">No Meetings Found</h5>
                                    <p class="mb-0">There are currently no meeting records matching your filters.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div> <!-- End List View -->
    
    <!-- Calendar View -->
    <div class="tab-pane fade" id="calendar-view" role="tabpanel" aria-labelledby="calendar-tab">
        <div class="glass-card p-4">
            <h5 class="fw-bold text-dark mb-4"><i class="fas fa-calendar-alt text-primary me-2"></i>Meeting Calendar</h5>
            <div id="calendar" style="min-height: 400px;"></div>
        </div>
    </div>
    <!-- End Calendar View -->
    
    </div> <!-- End tab-content -->
</div>

