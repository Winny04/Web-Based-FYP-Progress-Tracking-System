@using FYPTracker.Models
@model IEnumerable<MeetingBooking>
@{
    ViewData["Title"] = "Manage Meetings";
    var user = ViewBag.CurrentUser as ApplicationUser;
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .glass-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid rgba(37, 99, 235, 0.1);
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .status-badge {
        font-size: .72rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .badge-pending   { background: #fef9c3; color: #854d0e; }
    .badge-approved  { background: #dcfce7; color: #14532d; }
    .badge-rejected  { background: #fee2e2; color: #991b1b; }
    .badge-postponed { background: #dbeafe; color: #1e40af; }

    .time-slot {
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        font-size: .85rem;
        font-weight: 700;
        text-align: center;
        transition: all .2s;
        background: #f8fafc;
        color: #374151;
        border-color: #e2e8f0;
    }
    .time-slot:hover { border-color: #64748b; background: #f1f5f9; }
    .time-slot.selected { border-color: #1e293b; background: #1e293b; color: white; }
    .time-slot.booked { background: #f3f4f6 !important; color: #9ca3af !important; border-color: #e5e7eb !important; cursor: not-allowed; opacity: 0.7; text-decoration: line-through; }

    .table th { font-size: .73rem; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; font-weight: 700; }
    .table td { font-size: .87rem; vertical-align: middle; }

    /* FullCalendar Custom Overrides */
    .fc .fc-daygrid-body tr:hover { background-color: transparent !important; }
    .fc .fc-daygrid-day:hover { background-color: #f8fafc !important; cursor: pointer; }

    /* Custom Monochrome Tabs */
    #meetingTabs .nav-link { color: #475569; transition: all 0.2s; }
    #meetingTabs .nav-link:hover { background-color: #f1f5f9; color: #1e293b; }
    #meetingTabs .nav-link.active { background-color: #0f172a !important; color: #ffffff !important; }
</style>

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-3 d-flex align-items-center gap-2">
            <i class="fas fa-check-circle fs-4"></i> <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-3 d-flex align-items-center gap-2">
            <i class="fas fa-exclamation-circle fs-4"></i> <span>@TempData["Error"]</span>
        </div>
    }



    <!-- Tomorrow's Meeting Reminder -->
    @{
        var tomorrowMeetings = Model.Where(m => m.Status == "Approved" && m.MeetingDate.Date == DateTime.Today.AddDays(1).Date).ToList();
    }
    @if (tomorrowMeetings.Any())
    {
        foreach(var tm in tomorrowMeetings)
        {
            <div class="alert alert-primary border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" style="background-color: #e0f2fe;">
                <i class="fas fa-bell fa-2x text-primary me-3"></i>
                <div>
                    <h5 class="mb-1 fw-bold text-primary">Reminder: Upcoming Meeting Tomorrow!</h5>
                    <p class="mb-0 text-dark">You have an approved meeting scheduled for tomorrow with <strong>@tm.Student?.FullName</strong> at <strong>@tm.MeetingTime</strong>.</p>
                    @if(!string.IsNullOrEmpty(tm.MeetingLink)) {
                        <p class="mb-0 mt-1"><a href="@tm.MeetingLink" target="_blank" class="btn btn-sm btn-primary"><i class="fas fa-video me-1"></i> Join Online Meeting</a></p>
                    } else if(!string.IsNullOrEmpty(tm.Location)) {
                        <p class="mb-0 mt-1 text-dark"><i class="fas fa-map-marker-alt text-danger me-1"></i> <strong>Location / Link:</strong> @tm.Location</p>
                    }
                </div>
            </div>
        }
    }

    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-white"><i class="fas fa-calendar-alt me-2"></i>Manage Meetings</h2>
            <p class="mb-0 text-white opacity-75">Oversee and respond to meeting requests from your students.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @await Html.PartialAsync("_SessionFilter")
            <div class="d-flex align-items-center position-relative my-1">
                <i class="fas fa-user position-absolute ms-3 text-muted"></i>
                <select id="studentFilter" class="form-select border-0 shadow-sm ps-10 w-200px" style="border-radius: 10px;">
                    <option value="">All Students</option>
                    @foreach (var studentName in Model.Select(m => m.Student?.FullName).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s))
                    {
                        <option value="@studentName">@studentName</option>
                    }
                </select>
            </div>
            <div class="d-flex align-items-center position-relative my-1">
                <i class="fas fa-info-circle position-absolute ms-3 text-muted"></i>
                <select id="statusFilter" class="form-select border-0 shadow-sm ps-10 w-150px" style="border-radius: 10px;">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                    <option value="Postponed">Postponed</option>
                </select>
            </div>
            <div class="d-flex align-items-center position-relative my-1">
                <i class="fas fa-comment-dots position-absolute ms-3 text-muted"></i>
                <select id="feedbackFilter" class="form-select border-0 shadow-sm ps-10 w-200px" style="border-radius: 10px;">
                    <option value="">All Feedback States</option>
                    <option value="NeedFeedback">Needs Feedback</option>
                    <option value="Done">Reviewed / Signed</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Tabs Nav -->
    <ul class="nav nav-pills mb-4" id="meetingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold px-4 rounded-pill" id="list-tab" data-bs-toggle="pill" data-bs-target="#list-view" type="button" role="tab" aria-controls="list-view" aria-selected="true">
                <i class="fas fa-list-ul me-2"></i> List View
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4 rounded-pill ms-2" id="calendar-tab" data-bs-toggle="pill" data-bs-target="#calendar-view" type="button" role="tab" aria-controls="calendar-view" aria-selected="false">
                <i class="fas fa-calendar-alt me-2"></i> Calendar View
            </button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="meetingTabsContent">
        <!-- List View -->
        <div class="tab-pane fade show active" id="list-view" role="tabpanel" aria-labelledby="list-tab">
            <div class="glass-card p-4">
                <div class="table-responsive">
                    <table class="table align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted bg-light">
                        <th class="ps-4 min-w-150px">Date & Time</th>
                        <th class="min-w-120px">Status</th>
                        <th class="min-w-150px">Logbook Feedback</th>
                        <th class="text-end min-w-120px pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var groupedMeetings = Model.GroupBy(m => m.Student).Where(g => g.Key != null).ToList();
                    }
                    @foreach (var group in groupedMeetings)
                    {
                        var student = group.Key;
                        
                        <tr class="bg-light-primary student-group" data-student-id="@student?.Id">
                            <td colspan="4" class="ps-4 py-3 border-bottom border-primary">
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-40px me-3">
                                        <span class="symbol-label bg-primary text-inverse-primary fw-bolder">@(student?.FullName?.FirstOrDefault() ?? '?')</span>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark fw-bolder fs-5">@student?.FullName</span>
                                        <span class="text-muted fw-bold fs-7">@student?.UserName</span>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        @foreach (var m in group.OrderByDescending(x => x.MeetingDate).ThenByDescending(x => x.MeetingTime))
                        {
                            var feedbackState = (m.Status == "Approved" && m.MeetingLog != null && m.MeetingLog.LogStatus == "Draft") ? "NeedFeedback" : (m.MeetingLog != null && m.MeetingLog.LogStatus == "Signed" ? "Done" : "");

                            <tr class="meeting-item" id="meetingRow_@m.Id" data-student-id="@student?.Id" data-student-name="@student?.FullName" data-status="@m.Status" data-feedback="@feedbackState">
                                <td class="ps-4">
                                    <div class="fw-bold">@m.MeetingDate.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted small">@m.MeetingTime</div>
                                </td>
                                <td>
                                    <span class="status-badge @(m.Status == "Approved" ? "badge-approved" : m.Status == "Rejected" ? "badge-rejected" : m.Status == "Postponed" ? "badge-postponed" : "badge-pending")">
                                        @m.Status
                                    </span>
                                </td>
                                <td>
                                    @if (feedbackState == "NeedFeedback")
                                    {
                                        <span class="badge badge-light-warning">Needs Feedback</span>
                                    }
                                    else if (feedbackState == "Done")
                                    {
                                        <span class="badge badge-light-success">Reviewed & Signed</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-light-primary rounded-3" 
                                            onclick="showMeetingDetails(@m.Id, '@m.MeetingDate.ToString("yyyy-MM-dd")', '@m.MeetingTime', '@(m.Student?.FullName)', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.Reason ?? "No agenda provided."))', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.SupervisorNote ?? "No notes added."))', '@m.Status', '@(m.ProposedNewDate?.ToString("yyyy-MM-dd") ?? "")', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.Location ?? ""))', '@(System.Web.HttpUtility.JavaScriptStringEncode(m.MeetingLink ?? ""))')">
                                        <i class="fas fa-info-circle"></i> View Details
                                    </button>
                                    
                                    @if (m.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-sm btn-primary rounded-3 ms-1" data-bs-toggle="modal" data-bs-target="#respondModal_@m.Id">
                                            Respond
                                        </button>

                                        <!-- Quick Respond Modal -->
                                        <div class="modal fade" id="respondModal_@m.Id" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow-lg">
                                                    <form asp-action="RespondMeeting" method="post" id="respondForm_@m.Id" onsubmit="return validateRespondModal(@m.Id)">
                                                        <div class="modal-header">
                                                            <h5 class="fw-bold">Respond to @m.Student?.FullName</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <input type="hidden" name="meetingId" value="@m.Id" />
                                                            
                                                            <!-- Meeting Context -->
                                                            <div class="mb-4 p-3 bg-light rounded border border-primary border-opacity-25">
                                                                <div class="fw-bold text-dark mb-1"><i class="fas fa-calendar-alt text-primary me-2"></i>Requested Date & Time:</div>
                                                                <div class="mb-3 ms-4 fs-6">@m.MeetingDate.ToString("dd MMM yyyy") at @m.MeetingTime</div>
                                                                
                                                                <div class="fw-bold text-dark mb-1"><i class="fas fa-comment-dots text-primary me-2"></i>Student's Agenda:</div>
                                                                <div class="ms-4 text-muted fst-italic" style="white-space: pre-wrap;">@(string.IsNullOrEmpty(m.Reason) ? "No specific agenda provided." : m.Reason)</div>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Decision</label>
                                                                <select name="status" class="form-select rounded-3 border-primary" id="decisionSelect_@m.Id" onchange="toggleProposedDate(@m.Id); toggleRecurringWeeks(@m.Id)">
                                                                    <option value="Approved">Approve Meeting</option>
                                                                    <option value="Rejected">Decline Meeting</option>
                                                                    <option value="Postponed">Postpone Meeting</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3" id="recurringWeeksContainer_@m.Id">
                                                                <label class="form-label fw-bold text-success">Auto-Generate Recurring Meetings?</label>
                                                                <div class="input-group">
                                                                    <span class="input-group-text bg-light border-success text-success fw-bold">Weeks</span>
                                                                    <input type="number" name="recurringWeeks" id="recurringWeeks_@m.Id" class="form-control border-success" value="14" min="1" max="52" title="Set to 1 for just this meeting, or up to 52 to automatically book the rest of the semester." />
                                                                </div>
                                                                <small class="text-muted mt-1 d-block">If greater than 1, we will automatically generate weekly meetings at this same time.</small>
                                                            </div>
                                                            <div class="mb-3" id="proposedDateContainer_@m.Id" style="display: none;">
                                                                <label class="form-label fw-bold text-primary">Proposed New Date</label>
                                                                <input type="date" name="proposedDate" id="proposedDate_@m.Id" class="form-control rounded-3 border-primary" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" oninput="validateRespondModalRealtime(@m.Id)" />
                                                                <div id="proposedDateError_@m.Id" class="text-danger fw-bold small mt-1 d-none">Please provide a proposed date.</div>
                                                            </div>
                                                            <div class="mb-3" id="meetingTimeContainer_@m.Id">
                                                                <label class="form-label fw-bold">Meeting Time</label>
                                                                <input type="time" name="newMeetingTime" id="newMeetingTime_@m.Id" class="form-control rounded-3 bg-light" value="@m.MeetingTime" readonly />
                                                            </div>
                                                            <div class="mb-3" id="locationContainer_@m.Id">
                                                                <label class="form-label fw-bold">Meeting Location / Link</label>
                                                                <input type="text" name="location" id="location_@m.Id" class="form-control rounded-3" placeholder="e.g. MS Teams Link, Room 404" oninput="validateRespondModalRealtime(@m.Id)" />
                                                                <div class="mt-2 d-flex flex-wrap gap-2">
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('location_@m.Id').value = 'Lab 1'; validateRespondModalRealtime(@m.Id)">Lab 1</button>
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('location_@m.Id').value = 'Room 402'; validateRespondModalRealtime(@m.Id)">Room 402</button>
                                                                    <button type="button" class="btn btn-sm btn-primary border-0 fw-semibold" onclick="document.getElementById('location_@m.Id').value = 'Online'; validateRespondModalRealtime(@m.Id)"><i class="fas fa-video me-1"></i> Auto-Generate Online Link</button>
                                                                </div>
                                                                <div id="locationError_@m.Id" class="text-danger fw-bold small mt-1 d-none">Location is required when approving.</div>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Message to Student <span class="text-danger">*</span></label>
                                                                <textarea name="note" id="note_@m.Id" class="form-control rounded-3" rows="3" placeholder="Add instructions or feedback..." oninput="validateRespondModalRealtime(@m.Id)"></textarea>
                                                                <div class="mt-2 d-flex flex-wrap gap-2">
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('note_@m.Id').value = 'Approved! Please bring your updated logbook.'; validateRespondModalRealtime(@m.Id)">Bring Logbook</button>
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('note_@m.Id').value = 'I am currently away. Let\'s reschedule to the proposed date.'; validateRespondModalRealtime(@m.Id)">Away / Reschedule</button>
                                                                    <button type="button" class="btn btn-sm btn-light border text-dark fw-semibold" onclick="document.getElementById('note_@m.Id').value = 'Please provide a more detailed agenda before we meet.'; validateRespondModalRealtime(@m.Id)">Need Agenda</button>
                                                                </div>
                                                                <div id="noteError_@m.Id" class="text-danger fw-bold small mt-1 d-none">Please provide a valid reason (at least 10 characters).</div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0">
                                                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary rounded-3 px-4">Submit</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (m.Status == "Approved" && m.MeetingLog != null)
                                    {
                                        if (m.MeetingLog.LogStatus == "Draft")
                                        {
                                            <button type="button" class="btn btn-sm btn-warning rounded-3 ms-1" 
                                                    data-id="@m.Id"
                                                    data-student="@m.Student?.FullName"
                                                    data-date="@m.MeetingDate.ToString("dd/MM/yyyy")"
                                                    data-pdf="@(m.MeetingLog?.PdfLogbookPath)"
                                                    data-next-date="@(m.MeetingLog.NextMeetingDate?.ToString("yyyy-MM-ddTHH:mm"))"
                                                    onclick="openReviewLogModal(this)">
                                                Review Log
                                            </button>
                                        }
                                        else if (m.MeetingLog.LogStatus == "Signed")
                                        {
                                            <button type="button" class="btn btn-sm btn-success rounded-3 ms-1" onclick="viewFinalLog(@m.MeetingLog.Id)">
                                                View Final Log
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    @if (!groupedMeetings.Any())
                    {
                        <tr><td colspan="4" class="text-center py-4 text-muted">No meeting records found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div> <!-- End List View -->
    
    <!-- Calendar View -->
    <div class="tab-pane fade" id="calendar-view" role="tabpanel" aria-labelledby="calendar-tab">
        <div class="glass-card p-4">
            <h5 class="fw-bold text-dark mb-4"><i class="fas fa-calendar-alt text-primary me-2"></i>Meeting Calendar</h5>
            <div id="calendar" style="min-height: 400px;"></div>
        </div>
    </div>
    <!-- End Calendar View -->
    
    </div> <!-- End tab-content -->
</div>

<!-- Unified Meeting Details & Reschedule Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            
            <!-- VIEW MODE -->
            <div id="modalViewMode">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-info-circle text-primary me-2"></i>Meeting Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-4 d-flex justify-content-between align-items-center">
                        <span id="detStatusBadge" class="status-badge"></span>
                        <div class="text-end">
                            <div id="detDateTime" class="fw-bold text-dark"></div>
                            <small class="text-muted">Requested Time</small>
                        </div>
                    </div>

                    <div id="detMeetingLinkContainer" class="alert alert-info py-2 px-3 mb-3" style="display: none;">
                        <a id="detMeetingLinkBtn" href="#" target="_blank" class="btn btn-sm btn-primary w-100"><i class="fas fa-video me-2"></i>Join Online Meeting</a>
                    </div>
                    <div id="detLocationContainer" class="alert alert-info py-2 px-3 mb-3" style="display: none;">
                        <i class="fas fa-map-marker-alt text-danger me-2"></i><strong>Location/Link: </strong><span id="detLocation"></span>
                    </div>

                    <div id="detPostponedContainer" class="alert alert-warning text-start mb-4" style="display: none; font-size: 0.9rem;">
                        <strong>Previous Requested Date:</strong> <span id="detOriginalDate"></span><br>
                        <strong>New Postponed Date:</strong> <span id="detProposedDate"></span>
                    </div>
                    
                    <div class="p-3 bg-light rounded-3 mb-4">
                        <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Student</label>
                        <div id="detUser" class="fw-bold text-dark"></div>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Student's Agenda</label>
                        <p id="detReason" class="mb-0 text-dark" style="font-size:.9rem; line-height:1.6; white-space:pre-wrap;"></p>
                    </div>

                    <div class="mb-0">
                        <label class="text-muted small fw-bold text-uppercase mb-1 d-block">Supervisor Notes</label>
                        <p id="detNotes" class="mb-0 text-dark italic" style="font-size:.9rem; line-height:1.6; white-space:pre-wrap;"></p>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary px-4 rounded-3" data-bs-dismiss="modal">Close</button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Supervisor Review Log Modal -->
<div class="modal fade" id="reviewLogModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form asp-action="ReviewMeetingLogSupervisor" method="post" enctype="multipart/form-data" id="reviewLogForm" onsubmit="return confirmReviewLogSubmission(event)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="meetingId" id="revMeetingId" />
                
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-file-signature text-warning me-2"></i>Review & Sign Progress Logbook</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-4">Review the student's weekly progress logbook. Add your comments, upload the signed PDF, and approve.</p>
                    
                    <div class="row mb-3">
                        <div class="col-6"><strong>Student:</strong> <span id="revStudentName"></span></div>
                        <div class="col-6 text-end"><strong>Date:</strong> <span id="revMeetingDate"></span></div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4 text-center">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-2">Student's Logbook Submission</label>
                        <a id="revStudentPdfLink" href="#" target="_blank" class="btn btn-outline-primary rounded-3">
                            <i class="fas fa-file-pdf me-2"></i>View Student's PDF Logbook
                        </a>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-primary">Upload Signed Logbook (PDF)</label>
                        <input type="file" name="signedLogbookPdf" class="form-control rounded-3" accept="application/pdf" />
                        <div class="text-muted small mt-1">Upload the signed version of the PDF to return to the student.</div>
                    </div>



                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3"><i class="fas fa-upload me-1"></i> Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<script>
    var eventsData = [
        @foreach (var m in Model.Where(x => x.Status == "Approved" || x.Status == "Pending" || x.Status == "Postponed"))
        {
            string color = m.Status == "Approved" ? "#10b981" : (m.Status == "Pending" ? "#f59e0b" : "#ef4444");
            string startTimeStr = m.MeetingTime ?? "09:00 AM";
            DateTime startDt;
            if (!DateTime.TryParse($"{m.MeetingDate:yyyy-MM-dd} {startTimeStr}", out startDt)) {
                startDt = m.MeetingDate;
            }
            
            <text>
            {
                id: '@m.Id',
                title: 'Meeting: @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(m.Student?.FullName ?? "Student"))',
                start: '@startDt.ToString("yyyy-MM-ddTHH:mm:00")',
                end: '@startDt.AddHours(1).ToString("yyyy-MM-ddTHH:mm:00")',
                allDay: false,
                color: '@color'
            },
            </text>
        }
    ];

    var meetingCalendar;
    function initCalendar() {
        var calendarEl = document.getElementById('calendar');
        if(calendarEl) {
            meetingCalendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                height: 'auto',
                contentHeight: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek'
                },
                events: eventsData
            });
            meetingCalendar.render();
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        initCalendar();
        
        var calendarTabEl = document.getElementById('calendar-tab');
        if (calendarTabEl) {
            calendarTabEl.addEventListener('shown.bs.tab', function () {
                if(meetingCalendar) {
                    meetingCalendar.render();
                }
            });
        }

        const stFilter = document.getElementById('studentFilter');
        const statFilter = document.getElementById('statusFilter');
        const fbFilter = document.getElementById('feedbackFilter');

        function applyFilters() {
            const stVal = stFilter ? stFilter.value : '';
            const statVal = statFilter ? statFilter.value : '';
            const fbVal = fbFilter ? fbFilter.value : '';
            
            const items = document.querySelectorAll('.meeting-item');
            const groups = document.querySelectorAll('.student-group');
            
            const visibleGroups = new Set();

            items.forEach(item => {
                const matchSt = !stVal || item.getAttribute('data-student-name') === stVal;
                const matchStat = !statVal || item.getAttribute('data-status') === statVal;
                const matchFb = !fbVal || item.getAttribute('data-feedback') === fbVal;
                
                if (matchSt && matchStat && matchFb) {
                    item.style.display = '';
                    visibleGroups.add(item.getAttribute('data-student-id'));
                } else {
                    item.style.display = 'none';
                }
            });

            groups.forEach(group => {
                if (visibleGroups.has(group.getAttribute('data-student-id'))) {
                    group.style.display = '';
                } else {
                    group.style.display = 'none';
                }
            });
        }

        if(stFilter) stFilter.addEventListener('change', applyFilters);
        if(statFilter) statFilter.addEventListener('change', applyFilters);
        if(fbFilter) fbFilter.addEventListener('change', applyFilters);
    });

    const editTimeInput = document.getElementById('editTimeInput');
    const editTimeError = document.getElementById('editTimeError');
    const supId = @(user?.Id ?? 0);

    async function updateAvailability(dateInputId, containerId) {
        const date = document.getElementById(dateInputId).value;
        if (!date) return;
        const container = document.getElementById(containerId);
        container.querySelectorAll('.time-slot').forEach(s => {
            s.classList.remove('booked', 'selected');
            s.title = "";
        });
        editTimeInput.value = "";

        try {
            const resp = await fetch(`/Supervisor/GetBookedSlots?supervisorId=${supId}&date=${date}`);
            const bookedTimes = await resp.json();
            
            container.querySelectorAll('.time-slot').forEach(slot => {
                if (bookedTimes.includes(slot.dataset.time)) {
                    slot.classList.add('booked');
                    slot.title = "Already booked";
                }
            });
        } catch (err) { console.error(err); }
    }

    function selectTime(el, containerId) {
        if (el.classList.contains('booked')) return;
        document.getElementById(containerId).querySelectorAll('.time-slot').forEach(s => s.classList.remove('selected'));
        el.classList.add('selected');
        editTimeInput.value = el.dataset.time;
        editTimeError.style.display = 'none';
    }

    function showMeetingDetails(id, date, time, user, reason, notes, status, proposedDate, location, meetingLink) {
        const d = new Date(date + 'T00:00:00');
        const formattedDate = d.toLocaleDateString('en-US', { day:'2-digit', month:'short', year:'numeric' });
        
        document.getElementById('detDateTime').textContent = formattedDate + " at " + time;
        document.getElementById('detUser').textContent = user;
        document.getElementById('detReason').textContent = reason;
        document.getElementById('detNotes').textContent = notes;

        const locContainer = document.getElementById('detLocationContainer');
        const linkContainer = document.getElementById('detMeetingLinkContainer');
        if (meetingLink) {
            document.getElementById('detMeetingLinkBtn').href = meetingLink;
            linkContainer.style.display = 'block';
            locContainer.style.display = 'none';
        } else if (location) {
            document.getElementById('detLocation').textContent = location;
            locContainer.style.display = 'block';
            if (linkContainer) linkContainer.style.display = 'none';
        } else {
            locContainer.style.display = 'none';
            if (linkContainer) linkContainer.style.display = 'none';
        }

        const postponeContainer = document.getElementById('detPostponedContainer');
        if (status === 'Postponed' && proposedDate) {
            const pd = new Date(proposedDate + 'T00:00:00');
            const fpd = pd.toLocaleDateString('en-US', { day:'2-digit', month:'short', year:'numeric' });
            document.getElementById('detOriginalDate').textContent = formattedDate;
            document.getElementById('detProposedDate').textContent = fpd;
            postponeContainer.style.display = 'block';
        } else {
            postponeContainer.style.display = 'none';
        }
        
        const badge = document.getElementById('detStatusBadge');
        badge.textContent = status;
        badge.className = 'status-badge ' + (status === 'Approved' ? 'badge-approved' : 
                                            status === 'Rejected' ? 'badge-rejected' : 
                                            status === 'Postponed' ? 'badge-postponed' : 'badge-pending');

        document.getElementById('modalViewMode').style.display = 'block';
        new bootstrap.Modal(document.getElementById('detailsModal')).show();
    }

    function openReviewLogModal(btn) {
        document.getElementById('revMeetingId').value = btn.getAttribute('data-id');
        document.getElementById('revStudentName').textContent = btn.getAttribute('data-student');
        document.getElementById('revMeetingDate').textContent = btn.getAttribute('data-date');
        
        const pdfLink = document.getElementById('revStudentPdfLink');
        const pdfPath = btn.getAttribute('data-pdf');
        if (pdfPath && pdfPath !== '') {
            pdfLink.href = pdfPath;
            pdfLink.style.display = 'inline-block';
        } else {
            pdfLink.style.display = 'none';
        }
        new bootstrap.Modal(document.getElementById('reviewLogModal')).show();
    }

    function toggleRecurringWeeks(id) {
        var select = document.getElementById('decisionSelect_' + id);
        var recurringContainer = document.getElementById('recurringWeeksContainer_' + id);
        if (recurringContainer) {
            if (select.value === 'Approved') {
                recurringContainer.style.display = 'block';
            } else {
                recurringContainer.style.display = 'none';
            }
        }
    }

    function viewFinalLog(logId) {
        window.open('/Supervisor/ViewMeetingLog/' + logId, '_blank');
    }

    function toggleProposedDate(id) {
        var select = document.getElementById('decisionSelect_' + id);
        var proposedContainer = document.getElementById('proposedDateContainer_' + id);
        var locationContainer = document.getElementById('locationContainer_' + id);
        var timeContainer = document.getElementById('meetingTimeContainer_' + id);

        // Reset validation UI
        document.getElementById('location_' + id).classList.remove('is-invalid', 'is-valid');
        document.getElementById('locationError_' + id).classList.add('d-none');
        document.getElementById('note_' + id).classList.remove('is-invalid', 'is-valid');
        document.getElementById('noteError_' + id).classList.add('d-none');
        document.getElementById('proposedDate_' + id).classList.remove('is-invalid', 'is-valid');
        document.getElementById('proposedDateError_' + id).classList.add('d-none');

        if (select.value === 'Postponed') {
            proposedContainer.style.display = 'block';
            locationContainer.style.display = 'none';
            timeContainer.style.display = 'none';
        } else if (select.value === 'Rejected') {
            proposedContainer.style.display = 'none';
            locationContainer.style.display = 'none';
            timeContainer.style.display = 'none';
        } else {
            proposedContainer.style.display = 'none';
            locationContainer.style.display = 'block';
            timeContainer.style.display = 'block';
        }
    }

    function validateRespondModalRealtime(id) {
        var select = document.getElementById('decisionSelect_' + id);
        var location = document.getElementById('location_' + id);
        var locationError = document.getElementById('locationError_' + id);
        var note = document.getElementById('note_' + id);
        var noteError = document.getElementById('noteError_' + id);
        var proposedDate = document.getElementById('proposedDate_' + id);
        var proposedDateError = document.getElementById('proposedDateError_' + id);

        var isValid = true;

        if (select.value === 'Approved') {
            if (location.value.trim().length === 0) {
                location.classList.remove('is-valid');
                location.classList.add('is-invalid');
                locationError.classList.remove('d-none');
                isValid = false;
            } else {
                location.classList.remove('is-invalid');
                location.classList.add('is-valid');
                locationError.classList.add('d-none');
            }
            
            if (note.value.trim().length < 10) {
                note.classList.remove('is-valid');
                note.classList.add('is-invalid');
                noteError.classList.remove('d-none');
                isValid = false;
            } else {
                note.classList.remove('is-invalid');
                note.classList.add('is-valid');
                noteError.classList.add('d-none');
            }
            
        } else if (select.value === 'Rejected') {
            if (note.value.trim().length < 10) {
                note.classList.remove('is-valid');
                note.classList.add('is-invalid');
                noteError.classList.remove('d-none');
                isValid = false;
            } else {
                note.classList.remove('is-invalid');
                note.classList.add('is-valid');
                noteError.classList.add('d-none');
            }
        } else if (select.value === 'Postponed') {
            if (note.value.trim().length < 10) {
                note.classList.remove('is-valid');
                note.classList.add('is-invalid');
                noteError.classList.remove('d-none');
                isValid = false;
            } else {
                note.classList.remove('is-invalid');
                note.classList.add('is-valid');
                noteError.classList.add('d-none');
            }

            if (proposedDate.value.trim().length === 0) {
                proposedDate.classList.remove('is-valid');
                proposedDate.classList.add('is-invalid');
                proposedDateError.classList.remove('d-none');
                isValid = false;
            } else {
                proposedDate.classList.remove('is-invalid');
                proposedDate.classList.add('is-valid');
                proposedDateError.classList.add('d-none');
            }
        }
        return isValid;
    }

    function validateRespondModal(id) {
        var isValid = validateRespondModalRealtime(id);
        if (isValid) {
            Swal.fire({
                title: 'Confirm Submission',
                text: "Are you sure you want to submit this response?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Submit'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('respondForm_' + id).submit();
                }
            });
        }
        return false;
    }

    function confirmReviewLogSubmission(event) {
        event.preventDefault();
        Swal.fire({
            title: 'Confirm Submission',
            text: "Are you sure you want to submit this reviewed logbook?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Submit'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('reviewLogForm').submit();
            }
        });
        return false;
    }

    document.addEventListener('MeetingUpdateEvent', function(e) {
        const p = e.detail;
        
        if (p.type === 'MeetingCancelled') {
            let row = document.getElementById('meetingRow_' + p.meetingId);
            if (row) {
                row.remove();
                // We let _Layout show the Toast normally by NOT setting p._handled = true
            }
            return;
        }

        if (p.type === 'MeetingAccepted') {
            let row = document.getElementById('meetingRow_' + p.meetingId);
            if (row) {
                const statusBadge = row.querySelector('.status-badge');
                if (statusBadge) {
                    statusBadge.className = 'status-badge badge-approved';
                    statusBadge.textContent = 'Approved';
                }
            }
            return;
        }

        if (p.type === 'NewMeetingRequest' || p.type === 'MeetingRescheduled') {
            let currentSession = document.querySelector('select[name="sessionFilter"]')?.value || '';
            
            if (!p.session) {
                p._handled = true;
                Swal.fire({
                    title: 'System Error',
                    text: 'The backend is still running old code! It did not send the student Academic Session. Please completely stop the app and rebuild it without errors.',
                    icon: 'error'
                });
                return;
            }

            if (currentSession && p.session && currentSession !== p.session) {
                p._handled = true; // Prevent default Toast from _Layout
                // Ignore injecting row, but show a popup to navigate to the correct session!
                Swal.fire({
                    title: 'New Request (' + p.session + ')',
                    text: `Student ${p.studentName} booked a meeting in another session. Switch to ${p.session} to view?`,
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: 'Switch Session',
                    cancelButtonText: 'Stay Here'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Supervisor/ManageMeetings?sessionFilter=' + encodeURIComponent(p.session);
                    }
                });
                return;
            }

            let tbody = document.querySelector('table tbody');
            if (!tbody) return;

            // Optional: check if row already exists (reschedule), remove it
            let existingRow = document.getElementById('meetingRow_' + p.meetingId);
            if (existingRow) existingRow.remove();

            let token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            let rowHtml = `
                <tr class="meeting-item bg-light-info" id="meetingRow_${p.meetingId}">
                    <td class="ps-4">
                        <div class="fw-bold text-dark"><i class="fas fa-exclamation-circle text-info me-1"></i>${p.meetingDateFormatted || p.meetingDate}</div>
                        <div class="text-muted small">${p.meetingTime}</div>
                    </td>
                    <td><span class="status-badge badge-pending">Pending</span></td>
                    <td><span class="text-muted small">-</span></td>
                    <td class="text-end pe-4">
                        <button type="button" class="btn btn-sm btn-light-primary rounded-3" 
                                onclick="showMeetingDetails(${p.meetingId}, '${p.meetingDate}', '${p.meetingTime}', '${p.studentName}', 'View Agenda in DB', 'None', 'Pending', '', '')">
                            <i class="fas fa-info-circle"></i> Details
                        </button>
                        <button type="button" class="btn btn-sm btn-primary rounded-3 ms-1" data-bs-toggle="modal" data-bs-target="#respondModal_${p.meetingId}">
                            Respond
                        </button>
                        
                        <!-- Quick Respond Modal (Injected) -->
                        <div class="modal fade" id="respondModal_${p.meetingId}" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg">
                                    <form action="/Supervisor/RespondMeeting" method="post" id="respondForm_${p.meetingId}" onsubmit="return validateRespondModal(${p.meetingId})">
                                        <input name="__RequestVerificationToken" type="hidden" value="${token}" />
                                        <div class="modal-header">
                                            <h5 class="fw-bold">Respond to ${p.studentName}</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body text-start">
                                            <input type="hidden" name="meetingId" value="${p.meetingId}" />
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Decision <span class="text-danger">*</span></label>
                                                <select name="status" class="form-select form-select-solid" id="respondSelect_${p.meetingId}" onchange="toggleRespondFields(${p.meetingId})" required>
                                                    <option value="">Select an action...</option>
                                                    <option value="Approved">Approve Meeting</option>
                                                    <option value="Postponed">Postpone & Suggest New Date</option>
                                                    <option value="Rejected">Reject Meeting</option>
                                                </select>
                                            </div>
                                            <div id="locationGroup_${p.meetingId}" class="mb-3 d-none">
                                                <label class="form-label fw-bold">Location / Link <span class="text-danger">*</span></label>
                                                <input type="text" name="location" id="location_${p.meetingId}" class="form-control" placeholder="e.g. Room 302 or Zoom Link" />
                                                <div class="text-danger small mt-1 d-none" id="locationError_${p.meetingId}">Required for Approved meetings.</div>
                                            </div>
                                            <div id="postponeGroup_${p.meetingId}" class="mb-3 d-none row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">New Date <span class="text-danger">*</span></label>
                                                    <input type="date" name="proposedDate" id="proposedDate_${p.meetingId}" class="form-control" min="${new Date().toISOString().split('T')[0]}" />
                                                    <div class="text-danger small mt-1 d-none" id="proposedDateError_${p.meetingId}">Required.</div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">New Time</label>
                                                    <input type="time" name="newMeetingTime" class="form-control" />
                                                </div>
                                            </div>
                                            <div id="noteGroup_${p.meetingId}" class="mb-3 d-none">
                                                <label class="form-label fw-bold">Note <span class="text-danger">*</span></label>
                                                <textarea name="note" id="note_${p.meetingId}" class="form-control" rows="3"></textarea>
                                                <div class="text-danger small mt-1 d-none" id="noteError_${p.meetingId}">Please provide a reason (min 10 chars).</div>
                                            </div>
                                            <div class="text-end mt-4">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary fw-bold px-4">Submit</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            `;

            let studentHeader = document.querySelector('.student-group[data-student-id="' + p.studentId + '"]');
            if (studentHeader) {
                // Insert directly under this student's header
                studentHeader.insertAdjacentHTML('afterend', rowHtml);
            } else {
                // Generate a new student header since they have no existing meetings
                let headerHtml = `
                    <tr class="bg-light-primary student-group" data-student-id="${p.studentId}">
                        <td colspan="4" class="ps-4 py-3 border-bottom border-primary">
                            <div class="d-flex align-items-center">
                                <div class="symbol symbol-40px me-3">
                                    <span class="symbol-label bg-primary text-inverse-primary fw-bolder">${p.studentName ? p.studentName.charAt(0).toUpperCase() : '?'}</span>
                                </div>
                                <div class="d-flex flex-column">
                                    <span class="text-dark fw-bolder fs-5">${p.studentName}</span>
                                    <span class="text-muted fw-bold fs-7">${p.studentMatric || ''}</span>
                                </div>
                            </div>
                        </td>
                    </tr>
                `;
                // Insert both at the top of the table
                tbody.insertAdjacentHTML('afterbegin', rowHtml);
                tbody.insertAdjacentHTML('afterbegin', headerHtml);
            }
            
        } else if (p.type === 'MeetingLogSubmitted') {
            let existingRow = document.getElementById('meetingRow_' + p.meetingId);
            if (existingRow) {
                const feedbackCell = existingRow.cells[2];
                feedbackCell.innerHTML = `<span class="badge badge-light-warning">Needs Feedback</span>`;
                // To safely update buttons without rewriting everything, just reload for this specific logbook case
                // Or just show toast and let them click 'View Details' which will fetch latest data
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 4000,
                    icon: 'info',
                    title: `Logbook submitted by ${p.studentName}. Refresh to sign.`
                });
            }
        }
    });
</script>
}


