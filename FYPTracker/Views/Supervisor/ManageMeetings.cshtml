                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3 fw-bold" id="spSubmitBtn" disabled>
                        <i class="fas fa-paper-plane me-1"></i> Send Proposal to Student
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

