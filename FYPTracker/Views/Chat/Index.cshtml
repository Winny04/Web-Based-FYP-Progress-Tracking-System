@using FYPTracker.Models
@{
    ViewData["Title"] = "Messages";
    var isStudent = ViewBag.IsStudent != null && (bool)ViewBag.IsStudent;
    var partnerId = ViewBag.DefaultPartnerId as int?;
    var activeGroupId = ViewBag.ActiveGroupId as int?;
    var groupName = ViewBag.GroupName as string;
    var partnerName = ViewBag.PartnerName as string ?? "Your Supervisor";
    var noSupervisor = ViewBag.NoSupervisor != null && (bool)ViewBag.NoSupervisor;
}

<div class="container-fluid py-4">
    <div class="row g-0" style="height: 78vh; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.07);">

        @if (true)
        {
            <!-- Sidebar: List of Students and Groups -->
            <div class="col-lg-3 border-end d-flex flex-column bg-white h-100">
                <!-- Sidebar Header -->
                <div class="p-4 border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-dark mb-0">Chats</h4>
                        @if (!isStudent) {
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                                <i class="fas fa-plus"></i> Group
                            </button>
                        }
                    </div>
                    <!-- Search Bar -->
                    <div class="position-relative">
                        <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="z-index:1;"></i>
                        <input type="text" id="chat-search" class="form-control bg-light border-0 rounded-pill" style="padding-left: 2.8rem !important;" placeholder="Search students..." onkeyup="filterStudents()">
                    </div>
                    <!-- Filter Chips -->
                    <div class="d-flex gap-2 mt-3 overflow-auto" style="white-space: nowrap;">
                        <span class="badge rounded-pill bg-dark text-white px-3 py-2 fw-normal">All</span>
                    </div>
                </div>

                
                <!-- Group List -->
                <div class="p-3 border-bottom bg-light">
                    <h6 class="text-muted fw-bold mb-0 small text-uppercase">Groups</h6>
                </div>
                <div class="overflow-auto border-bottom" style="max-height: 30vh;">
                    @if (ViewBag.Groups != null)
                    {
                        var groups = (List<FYPTracker.Models.ChatGroup>)ViewBag.Groups;
                        <ul class="list-group list-group-flush">
                            @foreach (var g in groups)
                            {
                                var isActive = activeGroupId.HasValue && activeGroupId.Value == g.Id;
                                var activeBg = isActive ? "background: linear-gradient(135deg, #10b981, #059669);" : "";
                                var textCls = isActive ? "text-white" : "text-dark";
                                var initBg = isActive ? "background: rgba(255,255,255,0.25);" : "background:#f1f5f9;";
                                var initColor = isActive ? "color:white;" : "color:#1e293b;";
                                
                                <a href="@Url.Action("Index", "Chat", new { groupId = g.Id })"
                                   class="list-group-item list-group-item-action border-0 py-3 px-4"
                                   style="transition: background 0.15s; @activeBg">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3 shadow-sm flex-shrink-0"
                                             style="width:44px;height:44px;font-size:1rem;@initBg @initColor">
                                            <i class="fas fa-users"></i>
                                        </div>
                                        <div class="overflow-hidden flex-grow-1">
                                            <h6 class="mb-0 fw-bold @textCls text-truncate">@g.Name</h6>
                                        </div>
                                    </div>
                                </a>
                            }
                        </ul>
                    }
                </div>
                
                @if (isStudent && ViewBag.PartnerName != null) {
                    <!-- Student's private chat link to supervisor -->
                    <div class="p-3 border-bottom bg-light">
                        <h6 class="text-muted fw-bold mb-0 small text-uppercase">Direct Messages</h6>
                    </div>
                    <ul class="list-group list-group-flush">
                        @{
                            var isActive = partnerId.HasValue && !activeGroupId.HasValue;
                            var activeBg = isActive ? "background: linear-gradient(135deg, #2563eb, #0ea5e9);" : "";
                            var textCls = isActive ? "text-white" : "text-dark";
                            var initBg = isActive ? "background: rgba(255,255,255,0.25);" : "background:#f1f5f9;";
                            var initColor = isActive ? "color:white;" : "color:#1e293b;";
                            string pn = ViewBag.PartnerName;
                        }
                        <a href="@Url.Action("Index", "Chat", new { partnerId = ViewBag.DefaultPartnerId })"
                           class="list-group-item list-group-item-action border-0 py-3 px-4"
                           style="transition: background 0.15s; @activeBg">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3 shadow-sm flex-shrink-0"
                                     style="width:44px;height:44px;font-size:1rem;@initBg @initColor">
                                    @(pn.Substring(0, 1))
                                </div>
                                <div class="overflow-hidden flex-grow-1">
                                    <h6 class="mb-0 fw-bold @textCls text-truncate">@pn</h6>
                                </div>
                            </div>
                        </a>
                    </ul>
                }

                <!-- Student List -->
                <div class="overflow-auto flex-grow-1">
                    @if (ViewBag.AssignedStudents != null)
                    {
                        var studentList = (List<ChatStudentItem>)ViewBag.AssignedStudents;
                        <ul class="list-group list-group-flush">
                            @foreach (var student in studentList)
                            {
                                var isActive = partnerId.HasValue && partnerId.Value == student.Id;
                                var activeBg = isActive ? "background: linear-gradient(135deg, #2563eb, #0ea5e9);" : "";
                                var textCls = isActive ? "text-white" : "text-dark";
                                var subCls = isActive ? "text-white-50" : "text-muted";
                                var initBg = isActive ? "background: rgba(255,255,255,0.25);" : "background:#f1f5f9;";
                                var initColor = isActive ? "color:white;" : "color:#1e293b;";

                                <a href="@Url.Action("Index", "Chat", new { partnerId = student.Id })"
                                   class="student-chat-item list-group-item list-group-item-action border-0 py-3 px-4"
                                   style="transition: background 0.15s; @activeBg">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3 shadow-sm flex-shrink-0"
                                             style="width:44px;height:44px;font-size:1rem;@initBg @initColor">
                                            @(student.Name?.Substring(0, 1) ?? "?")
                                        </div>
                                        <div class="overflow-hidden flex-grow-1">
                                            <h6 class="mb-0 fw-bold @textCls text-truncate">
                                                @student.Name
                                                <span class="online-dot online-dot-@student.Id badge badge-circle bg-success ms-1 d-none" style="width: 8px; height: 8px; vertical-align: middle;"></span>
                                            </h6>
                                            <small class="@subCls text-truncate d-block">@student.Programme</small>
                                        </div>
                                        @if (student.UnreadCount > 0)
                                        {
                                            <div class="ms-2">
                                                <span class="badge rounded-pill bg-danger shadow-sm" style="font-size: 0.75rem; padding: 0.35em 0.6em;">@student.UnreadCount</span>
                                            </div>
                                        }
                                    </div>
                                </a>
                            }
                        </ul>
                        @if (!studentList.Any())
                        {
                            <div class="text-center text-muted py-5 px-3">
                                <i class="fas fa-user-slash fs-2 mb-3 opacity-50"></i>
                                <p class="small">No active students assigned yet.</p>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <!-- Chat Window -->
        <div class="col-lg-9 d-flex flex-column bg-white h-100">

            @if (noSupervisor)
            {
                <!-- No supervisor assigned yet -->
                <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5">
                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mb-4" style="width:90px;height:90px;">
                        <i class="fas fa-user-tie fs-2 text-primary opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Supervisor Assigned</h5>
                    <p class="text-muted text-center px-4">You don't have an assigned supervisor yet. Please submit a supervisor request first to start messaging.</p>
                    <a href="/Student/SelectSupervisor" class="btn btn-primary rounded-pill px-4 mt-2">Find a Supervisor</a>
                </div>
            }
            else if (partnerId.HasValue || activeGroupId.HasValue)
            {
                <!-- Chat Header -->
                <div class="p-4 border-bottom d-flex align-items-center" style="background: rgba(248,250,252,0.8);">
                    <div class="d-flex align-items-center w-100">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm me-3 flex-shrink-0"
                             style="width:48px;height:48px;font-size:1.1rem;background:linear-gradient(135deg,#2563eb,#0ea5e9);color:white;">
                            @partnerName.Substring(0, 1)
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold text-dark mb-0">
                                @(activeGroupId.HasValue ? groupName : partnerName)
                                @if (activeGroupId.HasValue && !isStudent)
                                {
                                    <button class="btn btn-sm btn-light ms-2 text-primary shadow-sm rounded-circle" onclick="openManageGroupModal(@activeGroupId)" title="Manage Group Members" style="width: 32px; height: 32px;">
                                        <i class="fas fa-cog"></i>
                                    </button>
                                }
                            </h5>
                        @if(!activeGroupId.HasValue) {
                        <span id="partner-online-status" class="text-success small fw-semibold d-none">
                            <i class="fas fa-circle me-1" style="font-size:0.45rem;"></i>Online
                        </span>
                        <span id="partner-offline-status" class="text-muted small fw-semibold">
                            <i class="fas fa-circle me-1" style="font-size:0.45rem;"></i>Offline
                        </span>
                        }
                    </div>
                    <input type="text" id="chat-history-search" class="form-control form-control-sm rounded-pill w-auto ms-auto d-none d-md-block" placeholder="Search in chat..." onkeyup="searchChatHistory()">
                    </div>
                </div>
                
                <!-- Pinned Messages Area -->
                <div id="pinned-messages-container" class="bg-warning bg-opacity-10 border-bottom border-warning px-4 py-2 d-none shadow-sm" style="z-index: 9;">
                    <div class="d-flex align-items-center justify-content-between">
                        <strong class="text-warning small text-uppercase"><i class="fas fa-thumbtack me-1"></i> Pinned Messages</strong>
                        <button type="button" class="btn-close btn-sm" onclick="document.getElementById('pinned-messages-container').classList.add('d-none')"></button>
                    </div>
                    <div id="pinned-messages-list" class="mt-1 d-flex flex-column gap-1"></div>
                </div>

                <!-- Messages Area -->
                <div id="chat-messages" class="p-4" style="flex: 1 1 auto; overflow-y: auto; overflow-x: hidden; background-color: #f8fafc; background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 20px 20px; scroll-behavior: smooth;">
                    <div class="text-center text-muted small mb-3">
                        <i class="fas fa-lock me-1"></i> @(activeGroupId.HasValue ? "Group Conversation" : "Conversation is private")
                    </div>
                    <!-- Messages injected by JS -->
                </div>

                <!-- Typing Indicator -->
                <div id="typingIndicator" class="px-4 py-2 d-none" style="background: rgba(248,250,252,0.9);">
                    <small class="text-muted fst-italic">@partnerName is typing...</small>
                </div>

                <!-- Input Area -->
                <div class="p-3 border-top bg-white position-relative">
                    
                    <!-- Attachment Preview -->
                    <div id="attachment-preview-container" class="mb-2 px-3 py-2 bg-light rounded align-items-center justify-content-between border" style="display: none;">
                        <div class="d-flex align-items-center overflow-hidden">
                            <i id="attachment-preview-icon" class="fas fa-file-alt text-primary fs-4 me-2 flex-shrink-0"></i>
                            <span id="attachment-preview-name" class="small text-truncate"></span>
                        </div>
                        <button type="button" class="btn-close btn-sm ms-2 flex-shrink-0" onclick="clearAttachment()"></button>
                    </div>
                    <div id="reply-preview-container" class="mb-2 px-3 py-2 bg-dark text-white rounded align-items-center justify-content-between shadow" style="display: none;">
                        <div class="overflow-hidden">
                            <strong id="reply-mode-label" class="small text-white-50 d-block"><i class="fa fa-reply me-1"></i> Replying to:</strong>
                            <span id="reply-preview-text" class="small text-white text-truncate d-block"></span>
                            <input type="hidden" id="reply-to-id" value="" />
                        </div>
                        <button type="button" class="btn-close btn-close-white btn-sm ms-2 flex-shrink-0" onclick="clearReply()"></button>
                    </div>

                    <!-- Tag Autocomplete -->
                    <ul id="tag-autocomplete" class="dropdown-menu shadow-lg position-fixed" style="display: none; max-height: 200px; overflow-y: auto; z-index: 1060; margin-bottom: 5px;">
                    </ul>
                    <emoji-picker id="emojiPicker" class="d-none shadow" style="position: absolute; bottom: 100%; left: 1rem; z-index: 1050; margin-bottom: 10px;"></emoji-picker>
                    
                    <form id="chat-form" class="d-flex align-items-center gap-2" onsubmit="event.preventDefault(); sendMessage(event); return false;">
                        <button type="button" class="btn btn-light rounded-circle flex-shrink-0 d-flex align-items-center justify-content-center" id="emoji-btn" style="width:45px;height:45px;" title="Emojis">
                            <i class="far fa-smile fs-5 text-muted"></i>
                        </button>
                        
                        <input type="file" id="chat-attachment" class="d-none" accept="image/*,.pdf,.doc,.docx,.zip,.xls,.xlsx,.ppt,.pptx,.txt" onchange="previewAttachment(event)" />
                        <button type="button" class="btn btn-light rounded-circle flex-shrink-0 d-flex align-items-center justify-content-center" onclick="document.getElementById('chat-attachment').click()" style="width:45px;height:45px;" title="Attach File">
                            <i class="fas fa-paperclip fs-5 text-muted"></i>
                        </button>
                        
                        <button type="button" class="btn btn-danger rounded-circle flex-shrink-0 align-items-center justify-content-center d-none" id="mic-stop-btn" style="width:45px;height:45px;" title="Stop Recording">
                            <i class="fas fa-stop"></i>
                        </button>
                        <button type="button" class="btn btn-light rounded-circle flex-shrink-0 d-flex align-items-center justify-content-center" id="mic-start-btn" style="width:45px;height:45px;" title="Voice Note">
                            <i class="fas fa-microphone fs-5 text-muted"></i>
                        </button>

                        <input type="text" id="chat-input"
                               class="form-control form-control-lg border-0 shadow-none bg-light rounded-pill px-4"
                               placeholder="Type a message or attach a file..."
                               data-group-members="@System.Text.Json.JsonSerializer.Serialize(ViewBag.GroupMembers ?? new object[0])"
                               autocomplete="off" />
                        <button type="submit"
                                class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center shadow flex-shrink-0"
                                style="width:50px;height:50px;transition:transform 0.2s;"
                                onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <!-- Supervisor: no student selected yet -->
                <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5 text-muted">
                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mb-4" style="width:90px;height:90px;">
                        <i class="far fa-comments fs-2 text-primary opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Select a Student</h5>
                    <p class="small">Choose a student from the sidebar to view the conversation.</p>
                </div>
            }

        </div>
    </div>
</div>


@if (!isStudent) {
<!-- Create Group Modal -->
<div class="modal fade" id="createGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Create Chat Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Group Name</label>
                    <input type="text" id="groupNameInput" class="form-control" placeholder="e.g. Project Alpha Team" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Select Students</label>
                    <div style="max-height: 200px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; border-radius: 4px;">
                        @if (ViewBag.AssignedStudents != null) {
                            var sts = (List<ChatStudentItem>)ViewBag.AssignedStudents;
                            foreach (var s in sts) {
                                <div class="form-check">
                                    <input class="form-check-input group-student-checkbox" type="checkbox" value="@s.Id" id="student_@s.Id">
                                    <label class="form-check-label" for="student_@s.Id">@s.Name</label>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createGroup()">Create Group</button>
            </div>
        </div>
    </div>
</div>

<!-- Manage Group Modal -->
<div class="modal fade" id="manageGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Manage Group Members</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="manageGroupId" />
                <h6 class="fw-bold">Current Members</h6>
                <div id="currentMembersList" class="mb-4" style="max-height: 150px; overflow-y: auto; border: 1px solid #eee; padding: 10px; border-radius: 4px;">
                    <!-- Populated via JS -->
                </div>
                
                <h6 class="fw-bold">Add Member</h6>
                <div class="input-group">
                    <select class="form-select" id="availableStudentsSelect">
                        <option value="">Select a student...</option>
                    </select>
                    <button class="btn btn-outline-primary" type="button" onclick="addGroupMember()">Add</button>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-danger" onclick="deleteGroup()">Delete Group</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    function createGroup() {
        var name = document.getElementById('groupNameInput').value;
        var checkboxes = document.querySelectorAll('.group-student-checkbox:checked');
        var memberIds = Array.from(checkboxes).map(c => c.value);
        if(!name) { alert("Please enter group name"); return; }
        if(memberIds.length === 0) { alert("Please select at least one student"); return; }
        
        var fd = new FormData();
        fd.append('name', name);
        memberIds.forEach(id => fd.append('memberIds', id));
        
        fetch('/Chat/CreateGroup', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(d => {
            if(d.success) window.location.href = '/Chat/Index?groupId=' + d.id;
            else alert("Error creating group");
        });
    }

    function openManageGroupModal(groupId) {
        document.getElementById('manageGroupId').value = groupId;
        loadGroupMembers(groupId);
        loadAvailableStudents(groupId);
        var modal = new bootstrap.Modal(document.getElementById('manageGroupModal'));
        modal.show();
    }

    function loadGroupMembers(groupId) {
        fetch('/Chat/GetGroupMembers?groupId=' + groupId)
            .then(r => r.json())
            .then(data => {
                var list = document.getElementById('currentMembersList');
                list.innerHTML = '';
                if(data.length === 0) {
                    list.innerHTML = '<div class="text-muted small">No members.</div>';
                    return;
                }
                data.forEach(m => {
                    list.innerHTML += `
                        <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                            <div>
                                <span class="fw-bold">${m.name}</span><br>
                                <small class="text-muted">Joined: ${m.joinedAt}</small>
                            </div>
                            <button class="btn btn-sm btn-outline-danger" onclick="removeGroupMember(${groupId}, ${m.studentId})">Remove</button>
                        </div>
                    `;
                });
            });
    }

    function loadAvailableStudents(groupId) {
        fetch('/Chat/GetAvailableStudents?groupId=' + groupId)
            .then(r => r.json())
            .then(data => {
                var select = document.getElementById('availableStudentsSelect');
                select.innerHTML = '<option value="">Select a student...</option>';
                data.forEach(s => {
                    select.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                });
            });
    }

    function addGroupMember() {
        var groupId = document.getElementById('manageGroupId').value;
        var studentId = document.getElementById('availableStudentsSelect').value;
        if (!studentId) { alert("Please select a student"); return; }

        var fd = new FormData();
        fd.append('groupId', groupId);
        fd.append('studentId', studentId);

        fetch('/Chat/AddGroupMember', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(d => {
                if(d.success) {
                    loadGroupMembers(groupId);
                    loadAvailableStudents(groupId);
                } else {
                    alert(d.error || "Error adding member");
                }
            });
    }

    function removeGroupMember(groupId, studentId) {
        if(!confirm("Are you sure you want to remove this member?")) return;

        var fd = new FormData();
        fd.append('groupId', groupId);
        fd.append('studentId', studentId);

        fetch('/Chat/RemoveGroupMember', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(d => {
                if(d.success) {
                    loadGroupMembers(groupId);
                    loadAvailableStudents(groupId);
                } else {
                    alert(d.error || "Error removing member");
                }
            });
    }
    function deleteGroup() {
        var groupId = document.getElementById('manageGroupId').value;
        if (!groupId) return;

        if (!confirm("Are you sure you want to completely delete this group? All chat history for this group will be permanently lost.")) return;

        var fd = new FormData();
        fd.append('groupId', groupId);

        fetch('/Chat/DeleteGroup', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    window.location.href = '/Chat';
                } else {
                    alert(d.message || d.error || "Error deleting group");
                }
            });
    }
</script>
}

@section Scripts {
    <script>
        const partnerId = @(partnerId.HasValue ? partnerId.Value.ToString() : "0");
        const activeGroupId = @(activeGroupId.HasValue ? activeGroupId.Value.ToString() : "0");
        const messagesContainer = document.getElementById('chat-messages');
        const chatInput = document.getElementById('chat-input');
        let lastMessageCount = 0;
        let editMessageId = null;
        let currentSkip = 0;
        const takeCount = 20;
        let hasMoreMessages = true;
        let isFetching = false;
        
        if (messagesContainer) {
            messagesContainer.addEventListener('scroll', () => {
                if (messagesContainer.scrollTop === 0 && hasMoreMessages && !isFetching) {
                    fetchHistory(false);
                }
            });
        }

        // Filter sidebar students
        function filterStudents() {
            const input = document.getElementById('chat-search');
            if (!input) return;
            const filter = input.value.toLowerCase();
            document.querySelectorAll('.student-chat-item').forEach(item => {
                const name = item.querySelector('h6')?.innerText?.toLowerCase() ?? '';
                item.style.display = name.includes(filter) ? '' : 'none';
            });
        }

        // Auto scroll to bottom
        function scrollToBottom() {
            if (messagesContainer) {
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }
        }

        // Render a message bubble
        function appendMessage(msg, prepend = false) {
            if (!messagesContainer) return;
            const isMine = msg.isMine === true;
            const alignClass = isMine ? 'justify-content-end' : 'justify-content-start';
            const bubbleStyle = isMine
                ? 'background: linear-gradient(135deg,#2563eb,#0ea5e9); color:white; border:none;'
                : 'background: linear-gradient(135deg,#ffffff,#f8fafc); color:#0f172a; border:1px solid #e2e8f0;';
            const radius = isMine ? 'border-radius:20px 20px 0 20px;' : 'border-radius:20px 20px 20px 0;';
            const timeAlign = isMine ? 'text-end' : '';
            let safeText = '';
            
            if (msg.isDeleted) {
                safeText = '<span class="text-white-50 fst-italic" style="opacity: 0.8;">🚫 This message was deleted.</span>';
                if (!isMine) safeText = '<span class="text-muted fst-italic">🚫 This message was deleted.</span>';
            } else if (msg.messageText) {
                let text = msg.messageText.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                text = text.replace(/@@([A-Za-z0-9_]+)/g, function(match, p1) {
                    return `<span class="badge bg-primary text-white p-1" style="font-size: 0.8rem;">@@${p1}</span>`;
                });
                safeText = text.replace(/\n/g,'<br>');
            }

            let attachmentHtml = '';
            if (msg.attachmentUrl && !msg.isDeleted) {
                const isImage = msg.attachmentUrl.match(/\.(jpeg|jpg|gif|png|webp)$/i) != null;
                const isAudio = msg.attachmentUrl.match(/\.(webm|mp3|wav|ogg)$/i) != null;
                if (isImage) {
                    attachmentHtml = `<div class="mt-2 text-center"><img src="${msg.attachmentUrl}" alt="${msg.attachmentName}" style="max-width:100%; border-radius:10px; cursor:pointer;" onclick="window.open(this.src,'_blank')" /></div>`;
                } else if (isAudio) {
                    attachmentHtml = `<div class="mt-2"><audio controls style="max-width:200px; height: 35px;"><source src="${msg.attachmentUrl}" type="audio/webm">Your browser does not support audio element.</audio></div>`;
                } else {
                    attachmentHtml = `<div class="mt-2 p-2 bg-white rounded border d-flex align-items-center">
                        <i class="fas fa-file-download fs-3 text-primary me-2"></i>
                        <a href="${msg.attachmentUrl}" target="_blank" class="text-decoration-none text-dark small text-truncate" style="max-width:150px;">${msg.attachmentName}</a>
                    </div>`;
                }
            }

            let replyHtml = '';
            if (msg.replyToMessageText) {
                replyHtml = `<div class="mb-2 p-2 rounded" style="background: rgba(0,0,0,0.05); border-left: 3px solid ${isMine ? 'rgba(255,255,255,0.7)' : '#0ea5e9'}; font-size: 0.8rem; font-style: italic;">
                    <i class="fas fa-reply me-1"></i> ${msg.replyToMessageText.length > 50 ? msg.replyToMessageText.substring(0,50) + '...' : msg.replyToMessageText}
                </div>`;
            }

            let tickHtml = '';
            if (isMine) {
                tickHtml = msg.isRead 
                    ? `<span class="ms-1" style="color: #0ea5e9;"><i class="fas fa-check-double"></i></span>`
                    : `<span class="ms-1 text-white-50"><i class="fas fa-check"></i></span>`;
            }
            if (msg.isEdited && !msg.isDeleted) {
                tickHtml = `<span class="text-white-50 ms-1" style="font-size: 0.65rem; opacity: 0.8;">(edited)</span> ` + tickHtml;
            }

            let pinClass = msg.isPinned ? "text-warning fw-bold" : "text-muted";
            let pinText = msg.isPinned ? "Unpin" : "Pin";
            
            let actionsHtml = '';
            if (!msg.isDeleted) {
                actionsHtml = `<div class="chat-actions d-flex align-items-center gap-1 px-2" style="opacity: 0; transition: opacity 0.2s;">
                    <button type="button" class="btn btn-sm btn-light rounded-pill border shadow-sm px-2 py-1 ${pinClass}" onclick="togglePin(${msg.id})" title="Pin Message"><i class="fas fa-thumbtack"></i> <span class="small ms-1 d-none d-md-inline">${pinText}</span></button>
                    <button type="button" class="btn btn-sm btn-dark text-white rounded-pill border shadow-sm px-2 py-1" onclick="prepareReply(${msg.id})" title="Reply"><i class="fa fa-reply"></i> <span class="small ms-1 d-none d-md-inline">Reply</span></button>`;
                
                if (isMine && msg.messageText) {
                    actionsHtml += `<button type="button" class="btn btn-sm btn-light rounded-pill border shadow-sm px-2 py-1 text-success" onclick="prepareEdit(${msg.id})" title="Edit"><i class="fa fa-pencil"></i></button>`;
                }
                if (isMine) {
                    actionsHtml += `<button type="button" class="btn btn-sm btn-light rounded-pill border shadow-sm px-2 py-1 text-danger" onclick="deleteMessage(${msg.id})" title="Delete"><i class="fa fa-trash"></i></button>`;
                }
                actionsHtml += `</div>`;
            }

            const div = document.createElement('div');
            div.className = `d-flex mb-3 align-items-center ${alignClass} chat-message-bubble`;
            div.id = `chat-msg-${msg.id}`;
            div.setAttribute('data-text', msg.messageText ? msg.messageText.toLowerCase() : '');
            div.setAttribute('data-original-text', msg.messageText ? msg.messageText : '');
            
            // Show actions on hover of the entire bubble
            div.onmouseover = function() { const act = this.querySelector('.chat-actions'); if(act) act.style.opacity = '1'; };
            div.onmouseout = function() { const act = this.querySelector('.chat-actions'); if(act) act.style.opacity = '0'; };
            
            let bubbleContent = `
                <div style="max-width:75%;">
                    ${!isMine && msg.groupId ? `<div class="small fw-bold text-muted mb-1" style="font-size: 0.75rem;">${msg.senderName}</div>` : ''}
                    <div class="position-relative" style="${bubbleStyle}${radius}padding:10px 16px;font-size:0.95rem;line-height:1.4;word-break:break-word;box-shadow:0 1px 2px rgba(0,0,0,0.08);">
                        ${replyHtml}
                        ${safeText}
                        ${attachmentHtml}
                    </div>
                    <div class="mt-1 text-muted ${timeAlign}" style="font-size:0.7rem;font-weight:500;">
                        ${msg.sentAtStr}
                        ${tickHtml}
                    </div>
                </div>`;
            
            div.innerHTML = isMine ? actionsHtml + bubbleContent : bubbleContent + actionsHtml;
            
            if (prepend) {
                messagesContainer.prepend(div);
            } else {
                messagesContainer.appendChild(div);
            }

            if (msg.isPinned) {
                addPinnedMessageUI(msg);
            }
        }

        function addPinnedMessageUI(msg) {
            const container = document.getElementById('pinned-messages-container');
            const list = document.getElementById('pinned-messages-list');
            if (document.getElementById(`pinned-msg-${msg.id}`)) return; 
            
            let display = msg.messageText || msg.attachmentName || "Pinned Message";
            if (display.length > 50) display = display.substring(0,50) + "...";
            
            const div = document.createElement('div');
            div.id = `pinned-msg-${msg.id}`;
            div.className = "bg-white rounded p-2 mb-1 small border d-flex justify-content-between align-items-center";
            div.style.cursor = "pointer";
            div.innerHTML = `<span class="text-truncate w-100" onclick="scrollToMessage(${msg.id})"><i class="fa fa-link text-muted me-1"></i> ${display}</span>`;
            list.appendChild(div);
            container.classList.remove('d-none');
        }

        function scrollToMessage(id) {
            const target = document.getElementById('chat-msg-' + id);
            if (target && messagesContainer) {
                // Add a highlight class or style briefly
                const originalTransition = target.style.transition;
                const originalBg = target.style.backgroundColor;
                target.style.transition = 'background-color 0.3s ease';
                target.style.backgroundColor = 'rgba(255, 193, 7, 0.3)'; // Yellow highlight
                
                setTimeout(() => { 
                    target.style.backgroundColor = originalBg; 
                    setTimeout(() => { target.style.transition = originalTransition; }, 300);
                }, 2000);
                
                // Scroll smoothly relative to container
                messagesContainer.scrollTo({
                    top: target.offsetTop - messagesContainer.offsetTop - 20,
                    behavior: 'smooth'
                });
            }
        }

        // Fetch history with Pagination
        async function fetchHistory(reset = true) {
            if ((!partnerId || partnerId <= 0) && (!activeGroupId || activeGroupId <= 0)) return;
            if (isFetching) return;
            
            if (reset) {
                currentSkip = 0;
                hasMoreMessages = true;
                messagesContainer.innerHTML = '';
                document.getElementById('pinned-messages-list').innerHTML = '';
                document.getElementById('pinned-messages-container').classList.add('d-none');
            }
            
            if (!hasMoreMessages) return;
            isFetching = true;
            
            try {
                // Save current scroll height to prevent jumping when prepending
                const oldScrollHeight = messagesContainer.scrollHeight;
                
                const res = await fetch(`/Chat/GetHistory?partnerId=${partnerId}&groupId=${activeGroupId}&skip=${currentSkip}&take=${takeCount}`);
                if (!res.ok) { isFetching = false; return; }
                
                const messages = await res.json();
                
                if (messages.length < takeCount) {
                    hasMoreMessages = false;
                }
                
                if (messages.length === 0 && reset) {
                    messagesContainer.innerHTML = '<div class="text-center text-muted small mb-3"><i class="fas fa-lock me-1"></i> Conversation is private</div>';
                } else if (messages.length > 0) {
                    if (reset) {
                        messagesContainer.innerHTML = '<div class="text-center text-muted small mb-3"><i class="fas fa-lock me-1"></i> Conversation is private</div>';
                        messages.forEach(m => appendMessage(m, false));
                        scrollToBottom();
                    } else {
                        // Prepend older messages
                        messages.reverse().forEach(m => appendMessage(m, true));
                        // Maintain scroll position
                        const newScrollHeight = messagesContainer.scrollHeight;
                        messagesContainer.scrollTop = newScrollHeight - oldScrollHeight;
                    }
                }
                
                currentSkip += messages.length;
            } catch (err) {
                console.error('Failed to load messages', err);
            } finally {
                isFetching = false;
            }
        }

        // Search Chat History
        function searchChatHistory() {
            const query = document.getElementById('chat-history-search').value.toLowerCase();
            const bubbles = messagesContainer.querySelectorAll('.chat-message-bubble');
            bubbles.forEach(b => {
                const text = b.getAttribute('data-text');
                if (text.includes(query)) {
                    b.classList.remove('d-none');
                    b.classList.add('d-flex');
                } else {
                    b.classList.remove('d-flex');
                    b.classList.add('d-none');
                }
            });
        }

        // Toggle Pin
        async function togglePin(id) {
            try {
                const fd = new FormData();
                fd.append('messageId', id);
                await fetch('/Chat/TogglePinMessage', { method: 'POST', body: fd });
                lastMessageCount = 0;
                fetchHistory();
            } catch(e) { console.error(e); }
        }

        function prepareReply(id) {
            cancelEdit();
            const bubble = document.getElementById('chat-msg-' + id);
            const text = bubble ? bubble.getAttribute('data-original-text') : 'Attachment';
            document.getElementById('reply-to-id').value = id;
            document.getElementById('reply-preview-text').innerText = text || 'Attachment';
            document.getElementById('reply-preview-container').style.display = 'flex';
            document.getElementById('chat-input').focus();
        }

        function prepareEdit(id) {
            clearPreview();
            const bubble = document.getElementById('chat-msg-' + id);
            const text = bubble ? bubble.getAttribute('data-original-text') : '';
            if (!text) return; 
            
            editMessageId = id;
            document.getElementById('chat-input').value = text;
            document.getElementById('chat-input').focus();
            
            document.getElementById('reply-preview-container').style.display = 'flex';
            document.getElementById('reply-preview-container').className = "mb-2 px-3 py-2 bg-warning text-dark rounded align-items-center justify-content-between shadow";
            document.getElementById('reply-preview-text').innerText = text;
            document.getElementById('reply-preview-text').classList.replace('text-white', 'text-dark');
            document.getElementById('reply-mode-label').innerHTML = `<i class="fa fa-pencil me-1"></i> Editing Message:`;
            document.getElementById('reply-mode-label').classList.replace('text-white-50', 'text-dark');
        }

        function cancelEdit() {
            editMessageId = null;
            document.getElementById('chat-input').value = '';
            document.getElementById('reply-preview-container').style.display = 'none';
            document.getElementById('reply-preview-container').className = "mb-2 px-3 py-2 bg-dark text-white rounded align-items-center justify-content-between shadow";
            document.getElementById('reply-preview-text').classList.replace('text-dark', 'text-white');
            document.getElementById('reply-mode-label').innerHTML = `<i class="fa fa-reply me-1"></i> Replying to:`;
            document.getElementById('reply-mode-label').classList.replace('text-dark', 'text-white-50');
        }

        function clearPreview() {
            document.getElementById('reply-to-id').value = '';
            if (editMessageId) {
                cancelEdit();
            } else {
                document.getElementById('reply-preview-container').style.display = 'none';
            }
        }

        async function deleteMessage(id) {
            if (!confirm('Are you sure you want to delete this message? This action cannot be undone.')) return;
            try {
                const fd = new FormData();
                fd.append('messageId', id);
                await fetch('/Chat/DeleteMessage', { method: 'POST', body: fd });
                fetchHistory(true);
            } catch(e) { console.error(e); }
        }

        // Voice Note logic
        let mediaRecorder;
        let audioChunks = [];

        document.getElementById('mic-start-btn')?.addEventListener('click', async () => {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                mediaRecorder.start();
                audioChunks = [];
                
                mediaRecorder.addEventListener("dataavailable", event => {
                    audioChunks.push(event.data);
                });

                mediaRecorder.addEventListener("stop", () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    const file = new File([audioBlob], "voice_note.webm", { type: 'audio/webm' });
                    
                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    document.getElementById('chat-attachment').files = dataTransfer.files;
                    previewAttachment({ target: document.getElementById('chat-attachment') });
                    
                    stream.getTracks().forEach(track => track.stop());
                });

                document.getElementById('mic-start-btn').classList.add('d-none');
                document.getElementById('mic-stop-btn').classList.remove('d-none');
            } catch (err) {
                alert('Microphone access denied or not available.');
            }
        });

        document.getElementById('mic-stop-btn')?.addEventListener('click', () => {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
            }
            document.getElementById('mic-stop-btn').classList.add('d-none');
            document.getElementById('mic-start-btn').classList.remove('d-none');
        });

        // Attachment Preview
        function previewAttachment(e) {
            const file = e.target.files[0];
            const container = document.getElementById('attachment-preview-container');
            const nameSpan = document.getElementById('attachment-preview-name');
            const icon = document.getElementById('attachment-preview-icon');
            
            if (file) {
                nameSpan.innerText = file.name;
                if (file.type.startsWith('image/')) {
                    icon.className = 'fas fa-file-image text-success fs-4 me-2 flex-shrink-0';
                } else {
                    icon.className = 'fas fa-file-alt text-primary fs-4 me-2 flex-shrink-0';
                }
                container.style.display = 'flex';
            } else {
                clearAttachment();
            }
        }

        function clearAttachment() {
            document.getElementById('chat-attachment').value = '';
            document.getElementById('attachment-preview-container').style.display = 'none';
        }

        // Send a message
        async function sendMessage(e) {
            e.preventDefault();
            if ((!partnerId || partnerId <= 0) && (!activeGroupId || activeGroupId <= 0)) return;
            const text = chatInput.value.trim();
            const fileInput = document.getElementById('chat-attachment');
            const file = fileInput.files[0];
            const replyToId = document.getElementById('reply-to-id').value;

            if (!text && !file) return;

            if (editMessageId) {
                const fd = new FormData();
                fd.append('messageId', editMessageId);
                fd.append('newText', text);
                try {
                    const res = await fetch('/Chat/EditMessage', { method: 'POST', body: fd });
                    if (res.ok) cancelEdit();
                    fetchHistory(true);
                } catch(e) { console.error(e); }
                return;
            }

            chatInput.value = '';
            clearAttachment();
            clearPreview();
            chatInput.focus();

            const formData = new FormData();
            formData.append('receiverId', partnerId);
            if (activeGroupId > 0) formData.append('groupId', activeGroupId);
            if (text) formData.append('messageText', text);
            if (file) formData.append('attachment', file);
            if (replyToId) formData.append('replyToId', replyToId);

            try {
                const res = await fetch('/Chat/SendMessage', { 
                    method: 'POST', 
                    body: formData 
                });
                if (res.ok) {
                    const result = await res.json();
                    if (result.success) {
                        appendMessage(result.message);
                        scrollToBottom();
                    }
                }
            } catch (err) {
                console.error('Failed to send message', err);
            }
        }

        // Autocomplete Tag Logic
        const tagAutocomplete = document.getElementById('tag-autocomplete');
        let currentTagSearch = '';
        let tagSearchActive = false;

        document.addEventListener('keyup', function(e) {
            if (e.target && e.target.id === 'chat-input') {
                const input = e.target;
                const val = input.value;
                const caretPos = input.selectionStart;
                
                const textBefore = val.substring(0, caretPos);
                const lastAt = textBefore.lastIndexOf(String.fromCharCode(64));
                
                if (lastAt !== -1 && (lastAt === 0 || textBefore[lastAt - 1] === ' ' || textBefore[lastAt - 1] === '\n')) {
                    const searchStr = textBefore.substring(lastAt + 1).toLowerCase();
                    
                    if (searchStr.includes(' ')) {
                        closeTagAutocomplete();
                        return;
                    }
                    
                    tagSearchActive = true;
                    currentTagSearch = searchStr;
                    renderTagAutocomplete(lastAt);
                } else {
                    closeTagAutocomplete();
                }
            }
        });

        function closeTagAutocomplete() {
            tagSearchActive = false;
            const tagAutocomplete = document.getElementById('tag-autocomplete');
            if (tagAutocomplete) {
                tagAutocomplete.classList.remove('show');
                tagAutocomplete.style.display = 'none';
            }
        }

        function renderTagAutocomplete(atIndex) {
            if (!tagSearchActive) return;
            
            const tagAutocomplete = document.getElementById('tag-autocomplete');
            const chatInput = document.getElementById('chat-input');
            if (!tagAutocomplete || !chatInput) return;
            
            let html = '';
            const addOption = (name, displayName) => {
                if (name && name.toLowerCase().includes(currentTagSearch)) {
                    html += `<li><a class="dropdown-item" href="#" onclick="selectTag('${name}', ${atIndex}); return false;"><i class="fas fa-at me-2 text-primary"></i>${displayName || name}</a></li>`;
                }
            };
            
            addOption('all', 'all');
            
            let groupMembers = [];
            try {
                const gmData = chatInput.getAttribute('data-group-members');
                if (gmData) groupMembers = JSON.parse(gmData);
            } catch (e) { console.error('Failed to parse group members:', e); }
            
            if (groupMembers && groupMembers.length > 0) {
                groupMembers.forEach(m => {
                    const n = m.Name || m.name || 'Unknown';
                    addOption(n.replace(/\s+/g, ''), n);
                });
            }
            
            if (html === '') {
                closeTagAutocomplete();
            } else {
                tagAutocomplete.innerHTML = html;
                
                // Position perfectly above input using fixed coordinates
                const rect = chatInput.getBoundingClientRect();
                tagAutocomplete.style.position = 'fixed';
                tagAutocomplete.style.left = rect.left + 'px';
                tagAutocomplete.style.bottom = (window.innerHeight - rect.top + 5) + 'px';
                tagAutocomplete.style.top = 'auto'; // ensure top is not conflicting
                
                tagAutocomplete.classList.add('show');
                tagAutocomplete.style.display = 'block';
            }
        }

        window.selectTag = function(tagName, atIndex) {
            const chatInput = document.getElementById('chat-input');
            if (!chatInput) return;
            
            const val = chatInput.value;
            const before = val.substring(0, atIndex);
            let endPos = atIndex + 1;
            while(endPos < val.length && val[endPos] !== ' ' && val[endPos] !== '\n') {
                endPos++;
            }
            const after = val.substring(endPos);
            
            chatInput.value = before + String.fromCharCode(64) + tagName + ' ' + after;
            closeTagAutocomplete();
            chatInput.focus();
        };
        
        // Enter key sends message (Shift+Enter for newline)
        let typingTimeout;
        const myName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MyName ?? "User"));
        
        document.addEventListener('keydown', function(e) {
            if (e.target && e.target.id === 'chat-input') {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage(e);
                } else {
                    // Throttle typing indicator
                    if (!typingTimeout && window.signalRConnection && partnerId) {
                        window.signalRConnection.invoke("SendTypingIndicator", partnerId, myName).catch(err => console.error(err));
                        typingTimeout = setTimeout(() => { typingTimeout = null; }, 2000);
                    }
                }
            }
        });

        // Init
        if ((partnerId && partnerId > 0) || (activeGroupId && activeGroupId > 0)) {
            fetchHistory();
            
            if (activeGroupId && activeGroupId > 0) {
                // Ensure the connection is established before joining
                const checkConnection = setInterval(() => {
                    if (window.signalRConnection && window.signalRConnection.state === signalR.HubConnectionState.Connected) {
                        clearInterval(checkConnection);
                        window.signalRConnection.invoke("JoinGroupChat", activeGroupId).catch(err => console.error(err));
                    }
                }, 500);
            }
            
            // Listen for incoming messages in real-time
            if (window.signalRConnection) {
                window.signalRConnection.on("ReceiveChatMessage", function(msg) {
                    // Check if the message is from the active partner
                    if (msg.senderId == partnerId) {
                        appendMessage(msg);
                        lastMessageCount++;
                        // Instantly mark as read since we are actively viewing this chat
                        fetch(`/Chat/MarkAsRead?senderId=${msg.senderId}`, { method: 'POST' });
                    } else {
                        // The message is from someone else. Update the sidebar badge!
                        // Let's find the student in the sidebar by checking the links
                        var links = document.querySelectorAll('.student-chat-item');
                        links.forEach(link => {
                            if (link.href.includes('partnerId=' + msg.senderId)) {
                                var badge = link.querySelector('.badge');
                                if (badge) {
                                    badge.innerText = parseInt(badge.innerText) + 1;
                                } else {
                                    // Need to create a badge if it doesn't exist
                                    var container = link.querySelector('.d-flex.align-items-center');
                                    var badgeHtml = `<div class="ms-2"><span class="badge rounded-pill bg-danger shadow-sm" style="font-size: 0.75rem; padding: 0.35em 0.6em;">1</span></div>`;
                                    container.insertAdjacentHTML('beforeend', badgeHtml);
                                }
                                
                                // Optional: Move the chat item to the top of the list
                                var ul = link.closest('ul');
                                if (ul) {
                                    ul.prepend(link);
                                }
                            }
                        });
                    }
                });

                // Listen for typing indicators
                let hideTypingTimeout;
                window.signalRConnection.on("ReceiveTypingIndicator", function(senderName) {
                    var typingDiv = document.getElementById("typingIndicator");
                    if (typingDiv) {
                        typingDiv.querySelector('small').innerText = senderName + ' is typing...';
                        typingDiv.classList.remove('d-none');
                        clearTimeout(hideTypingTimeout);
                        hideTypingTimeout = setTimeout(() => {
                            typingDiv.classList.add('d-none');
                        }, 3000);
                    }
                });

                // Listen for Read Receipts
                window.signalRConnection.on("MessagesRead", function(readerId) {
                    if (partnerId == readerId) {
                        fetchHistory(true);
                    }
                });

                // Listen for Pin Toggles
                window.signalRConnection.on("MessagePinnedToggled", function(messageId, isPinned) {
                    fetchHistory(true);
                });

                window.signalRConnection.on("MessageEdited", function(messageId, newText) {
                    fetchHistory(true);
                });

                window.signalRConnection.on("MessageDeleted", function(messageId) {
                    fetchHistory(true);
                });
            }
        }

        // --- Online Presence Tracking ---
        function updateOnlineStatus(userId, isOnline) {
            // Update sidebar dots
            document.querySelectorAll('.online-dot-' + userId).forEach(dot => {
                if (isOnline) {
                    dot.classList.remove('d-none');
                } else {
                    dot.classList.add('d-none');
                }
            });
            // Update main chat header if it's the active partner
            if (partnerId === userId) {
                const onStatus = document.getElementById('partner-online-status');
                const offStatus = document.getElementById('partner-offline-status');
                if (onStatus && offStatus) {
                    if (isOnline) {
                        onStatus.classList.remove('d-none');
                        offStatus.classList.add('d-none');
                    } else {
                        onStatus.classList.add('d-none');
                        offStatus.classList.remove('d-none');
                    }
                }
            }
        }

        if (window.signalRConnection) {
            window.signalRConnection.on("UserOnline", function(userId) {
                updateOnlineStatus(userId, true);
            });
            window.signalRConnection.on("UserOffline", function(userId) {
                updateOnlineStatus(userId, false);
            });

            // Fetch initial online users once connected
            const checkConnection = setInterval(() => {
                if (window.signalRConnection.state === signalR.HubConnectionState.Connected) {
                    clearInterval(checkConnection);
                    window.signalRConnection.invoke("GetOnlineUsers")
                        .then(onlineUsers => {
                            onlineUsers.forEach(userId => updateOnlineStatus(userId, true));
                        })
                        .catch(err => console.error(err));
                }
            }, 500);
        }

        // Emoji Picker Logic
        import('https://unpkg.com/emoji-picker-element@1').then(() => {
            const picker = document.getElementById('emojiPicker');
            const btn = document.getElementById('emoji-btn');
            
            if (picker && btn) {
                btn.addEventListener('click', () => {
                    picker.classList.toggle('d-none');
                });

                picker.addEventListener('emoji-click', event => {
                    chatInput.value += event.detail.unicode;
                    picker.classList.add('d-none');
                    chatInput.focus();
                });

                // Hide picker when clicking outside
                document.addEventListener('click', (e) => {
                    if (!picker.contains(e.target) && !btn.contains(e.target)) {
                        picker.classList.add('d-none');
                    }
                });
            }
        });
    </script>
}
