@model IEnumerable<FYPTracker.Models.FYPProject>

@{
    ViewData["Title"] = "Dashboard";
    var currentUser = ViewBag.CurrentUser as FYPTracker.Models.EmployeeInfo;
    var userType = currentUser?.UserType ?? "Student";
    
    // For demo purposes, we will pick the first project if it exists.
    var currentProject = Model?.FirstOrDefault();
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --success-gradient: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
        --warning-gradient: linear-gradient(135deg, #fccb90 0%, #d57eeb 100%);
        --danger-gradient: linear-gradient(135deg, #ff0844 0%, #ffb199 100%);
        --card-bg: rgba(255, 255, 255, 0.95);
    }
    
    body {
        background-color: #f4f6f9;
        font-family: 'Inter', sans-serif;
    }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.07);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 40px rgba(31, 38, 135, 0.12);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
    }

    .progress-bar-animated {
        animation: progress-load 1.5s ease-out forwards;
    }

    @@keyframes progress-load {
        0% { width: 0; }
    }

    .table-hover tbody tr {
        transition: background-color 0.2s ease;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.05);
    }

    .badge-soft-success { background-color: #d1fae5; color: #065f46; }
    .badge-soft-warning { background-color: #fef3c7; color: #92400e; }
    .badge-soft-danger { background-color: #fee2e2; color: #991b1b; }
    .badge-soft-info { background-color: #dbeafe; color: #1e40af; }
    
    .timeline-item {
        border-left: 2px solid #e5e7eb;
        padding-left: 20px;
        position: relative;
        padding-bottom: 20px;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: -6px;
        top: 0;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #667eea;
    }
</style>

@if (userType == "Student")
{
    <!-- STUDENT DASHBOARD -->
    <div class="container-fluid py-4">
        
        <!-- Taskbar / Welcome Banner -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="glass-card p-4 d-flex justify-content-between align-items-center" style="background: var(--primary-gradient); color: white;">
                    <div>
                        <h2 class="fw-bold mb-1">Welcome back, @currentUser?.FullName! 👋</h2>
                        <p class="mb-0 opacity-75">
                            <strong>Student ID:</strong> @(currentUser?.UserName ?? "STU-001") &nbsp;|&nbsp;
                            <strong>Supervisor:</strong> @(currentProject?.Supervisor?.FullName ?? "Not Assigned") &nbsp;|&nbsp;
                            <strong>Session:</strong> 2026/2027
                        </p>
                    </div>
                    <div class="text-end d-none d-md-block">
                        <span class="fs-5 fw-bold">Active Project:</span><br/>
                        <span class="opacity-75">@(currentProject?.Title ?? "No Project Submitted Yet")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deadline Alert -->
        <div class="alert alert-warning border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 glass-card" role="alert" style="border-left: 5px solid #f59e0b !important;">
            <i class="fas fa-exclamation-triangle fs-3 text-warning me-3"></i>
            <div>
                <h5 class="alert-heading mb-1 fw-bold">Upcoming Deadline!</h5>
                <p class="mb-0">Your <strong>Chapter 3: Methodology</strong> is due in 3 days (May 14, 2026). Please ensure all revisions are submitted.</p>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon me-3 shadow" style="background: var(--success-gradient);">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1 fs-7">Completed Modules</h6>
                        <h3 class="fw-bold mb-0 text-dark">2</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon me-3 shadow" style="background: var(--warning-gradient);">
                        <i class="fas fa-hourglass-half"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1 fs-7">Pending Reviews</h6>
                        <h3 class="fw-bold mb-0 text-dark">1</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 d-flex align-items-center">
                    <div class="stat-icon me-3 shadow" style="background: var(--danger-gradient);">
                        <i class="fas fa-edit"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1 fs-7">Needs Revision</h6>
                        <h3 class="fw-bold mb-0 text-dark">1</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <!-- Overall Progress -->
            <div class="col-12">
                <div class="glass-card p-4">
                    <h5 class="fw-bold mb-3 text-dark">Overall Project Progress</h5>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-bold text-muted">Completion Rate</span>
                        <span class="fw-bold text-primary">45%</span>
                    </div>
                    <div class="progress" style="height: 12px; border-radius: 6px;">
                        <div class="progress-bar progress-bar-animated bg-primary" role="progressbar" style="width: 45%; background: var(--primary-gradient) !important;" aria-valuenow="45" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Chapter Status Table -->
            <div class="col-lg-8 mb-4">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold text-dark mb-0">Chapter Status</h5>
                        <button class="btn btn-sm btn-primary shadow-sm" style="background: var(--primary-gradient); border: none;">+ Submit Work</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="text-muted text-uppercase fs-7 fw-bolder">
                                <tr>
                                    <th>Chapter</th>
                                    <th>Deadline</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">Chapter 1: Introduction</div>
                                        <span class="text-muted fs-7">Submitted on Apr 15</span>
                                    </td>
                                    <td>Apr 20, 2026</td>
                                    <td><span class="badge badge-soft-success px-3 py-2 rounded-pill">Approved</span></td>
                                    <td class="text-end"><button class="btn btn-sm btn-light btn-active-light-primary text-muted">View</button></td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">Chapter 2: Lit Review</div>
                                        <span class="text-muted fs-7">Submitted on May 01</span>
                                    </td>
                                    <td>May 05, 2026</td>
                                    <td><span class="badge badge-soft-danger px-3 py-2 rounded-pill">Revision Needed</span></td>
                                    <td class="text-end"><button class="btn btn-sm btn-light btn-active-light-primary text-muted">Edit</button></td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">Chapter 3: Methodology</div>
                                        <span class="text-muted fs-7">Not submitted yet</span>
                                    </td>
                                    <td>May 14, 2026</td>
                                    <td><span class="badge badge-soft-warning px-3 py-2 rounded-pill">Pending</span></td>
                                    <td class="text-end"><button class="btn btn-sm btn-light btn-active-light-primary text-muted">Upload</button></td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">Chapter 4: Implementation</div>
                                        <span class="text-muted fs-7">Upcoming</span>
                                    </td>
                                    <td>Jun 10, 2026</td>
                                    <td><span class="badge badge-soft-info px-3 py-2 rounded-pill">Upcoming</span></td>
                                    <td class="text-end"><button class="btn btn-sm btn-light btn-active-light-primary text-muted disabled">Locked</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Recent Activities -->
            <div class="col-lg-4 mb-4">
                <div class="glass-card p-4 h-100">
                    <h5 class="fw-bold text-dark mb-4">Recent Activities</h5>
                    <div class="timeline-item">
                        <div class="fw-bold text-dark">Supervisor Feedback</div>
                        <div class="text-muted fs-7 mb-1">Dr. Smith added comments to Chapter 2.</div>
                        <span class="badge bg-light text-muted fs-8">2 hours ago</span>
                    </div>
                    <div class="timeline-item">
                        <div class="fw-bold text-dark">Meeting Scheduled</div>
                        <div class="text-muted fs-7 mb-1">Weekly sync confirmed for Friday 10 AM.</div>
                        <span class="badge bg-light text-muted fs-8">Yesterday</span>
                    </div>
                    <div class="timeline-item border-0 pb-0">
                        <div class="fw-bold text-dark">Document Uploaded</div>
                        <div class="text-muted fs-7 mb-1">Draft_v2.docx was uploaded successfully.</div>
                        <span class="badge bg-light text-muted fs-8">May 01, 2026</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (userType == "Supervisor")
{
    <!-- SUPERVISOR DASHBOARD PLACEHOLDER -->
    <div class="container-fluid py-4 text-center mt-5 pt-5">
        <h1 class="display-3 fw-bold text-muted mb-4"><i class="fas fa-chalkboard-teacher text-primary"></i></h1>
        <h2 class="fw-bolder">Supervisor Dashboard</h2>
        <p class="text-muted fs-5">This interface is currently under construction. Please check back later!</p>
        <button class="btn btn-primary btn-lg mt-3 shadow" style="background: var(--primary-gradient); border: none;">Refresh View</button>
    </div>
}
else
{
    <!-- ADMIN DASHBOARD PLACEHOLDER -->
    <div class="container-fluid py-4 text-center mt-5 pt-5">
        <h1 class="display-3 fw-bold text-muted mb-4"><i class="fas fa-user-shield text-danger"></i></h1>
        <h2 class="fw-bolder">Admin Dashboard</h2>
        <p class="text-muted fs-5">This interface is currently under construction. Please check back later!</p>
        <button class="btn btn-danger btn-lg mt-3 shadow" style="background: var(--danger-gradient); border: none;">Refresh View</button>
    </div>
}
