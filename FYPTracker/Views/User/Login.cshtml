	<!--begin::Fonts-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
	<!--end::Fonts-->
	<!--begin::Global Stylesheets Bundle(used by all pages)-->
	<link href="assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
	<!--end::Global Stylesheets Bundle-->
</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_body" class="bg-body">
	<!--begin::Main-->
	<!--begin::Root-->
	<div class="content">	<a href="" class="logo">
					<img src="~/assets/media/logos/fyp-logo-whale.png" alt="FYP Tracking System" style="position: absolute; top: 10px; left: 10px; height: 50px;" />
				</a></div>

	<div class="d-flex flex-column flex-root">
		<!--begin::Authentication - Sign-in -->
		<div class="d-flex flex-column flex-column-fluid login-bg-wrapper">
			<!--begin::Content-->
			<div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
				<!--begin::Logo-->
				
				<!--end::Logo-->
				<!--begin::Wrapper-->
				<div class="w-lg-500px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto">
					<!--begin::Form-->
					<form class="form w-100" method="post">
						<!--begin::Heading-->
						<div class="text-center mb-10">
							<!--begin::Title-->
							<h1 class="text-dark mb-3">Sign In</h1>
							<!--end::Title-->
							<!--begin::Link-->

							@if (TempData["error"] != null)
							{
							<div class="alert alert-danger" role="alert">
								@TempData["error"]
							</div>
							}
							<!--end::Link-->
						</div>
						<!--begin::Heading-->
						<!--begin::Input group-->
						<div class="fv-row mb-10">
							<!--begin::Label-->
							<label class="form-label fs-6 fw-bolder text-dark">Username / Email</label>
							<!--end::Label-->
							<!--begin::Input-->
							<input class="form-control form-control-lg form-control-solid" type="text" name="username" autocomplete="off" />
							<!--end::Input-->
						</div>
						<!--end::Input group-->
						<!--begin::Input group-->
						<div class="fv-row mb-10">
							<!--begin::Wrapper-->
							<div class="d-flex flex-stack mb-2">
								<!--begin::Label-->
								<label class="form-label fw-bolder text-dark fs-6 mb-0">Password</label>
								<!--end::Label-->
								<!--begin::Link-->
								<a href="#" class="link-primary fs-6 fw-bolder" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">Forgot Password ?</a>
								<!--end::Link-->

							</div>
							<!--end::Wrapper-->
							<!--begin::Input-->
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="password" id="password" autocomplete="off" />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('password', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
							<!--end::Input-->
						</div>
						<!--end::Input group-->
						<!--begin::Actions-->
						<div class="text-center">
							<!--begin::Submit button-->
							<button type="submit" id="kt_sign_in_submit" class="btn btn-lg btn-primary w-100 mb-5">
								<span class="indicator-label">Login</span>
								<span class="indicator-progress">
									Please wait...
									<span class="spinner-border spinner-border-sm align-middle ms-2"></span>
								</span>
							</button>

							<!--end::Google link-->
						</div>
						<!--end::Actions-->
					</form>
					<!--end::Form-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Content-->
			<!--begin::Footer-->
			<!--end::Footer-->
		</div>
		<!--end::Authentication - Sign-in-->
	</div>
	<!--end::Root-->
	<!--end::Main-->

	<!--begin::Forgot Password Modal-->
	<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content rounded shadow-sm">
				<div class="modal-header border-0 pb-0">
					<h3 class="modal-title text-dark fw-bolder" id="forgotPasswordModalLabel">Forgot Password</h3>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body pt-2">
					<p class="text-gray-400 fw-bold fs-6 mb-6">Please enter your Username or Email to reset your password.</p>
					<form id="forgotPasswordForm" method="post" action="/User/ForgotPassword">
						<div class="fv-row mb-8">
							<label class="form-label fs-6 fw-bolder text-dark">Username / Email</label>
							<input class="form-control form-control-lg form-control-solid" type="text" name="username" id="forgotUsername" autocomplete="off" required />
							<div id="forgotPasswordMessage" class="text-danger fw-bold mt-2" style="display: none; font-size: 0.9rem;"></div>
						</div>
						<div class="text-center">
							<button type="submit" id="forgotPasswordSubmit" class="btn btn-lg btn-primary w-100">
								<span class="indicator-label">Send Reset Link</span>
								<span class="indicator-progress" style="display:none;">Please wait... <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
	<!--end::Forgot Password Modal-->

	<!--begin::Javascript-->
	<script>var hostUrl = "assets/";</script>
	<!--begin::Global Javascript Bundle(used by all pages)-->
	<script src="assets/plugins/global/plugins.bundle.js"></script>
	<script src="assets/js/scripts.bundle.js"></script>
	<!--end::Global Javascript Bundle-->
	<!--begin::Page Custom Javascript(used by this page)-->
	<script>
		function togglePasswordVisibility(fieldId, element) {
			var field = document.getElementById(fieldId);
			var icon = element.querySelector('i');
			if (field.type === "password") {
				field.type = "text";
				icon.classList.remove('fa-eye');
				icon.classList.add('fa-eye-slash');
			} else {
				field.type = "password";
				icon.classList.remove('fa-eye-slash');
				icon.classList.add('fa-eye');
			}
		}

		// Forgot Password AJAX submission
		$(document).ready(function() {
			$('#forgotPasswordForm').on('submit', function(e) {
				e.preventDefault();
				var btn = $('#forgotPasswordSubmit');
				btn.find('.indicator-label').hide();
				btn.find('.indicator-progress').show();
				btn.prop('disabled', true);

				$('#forgotPasswordMessage').hide().removeClass('text-danger text-success');
				$.ajax({
					url: '/User/ForgotPassword',
					type: 'POST',
					headers: { 'X-Requested-With': 'XMLHttpRequest' },
					data: { username: $('#forgotUsername').val() },
					success: function(response) {
						if (response.success) {
							$('#forgotPasswordModal').modal('hide');
							Swal.fire({
								text: response.message || 'If the account exists, a password reset link has been sent to the registered email.',
								icon: 'success',
								buttonsStyling: false,
								confirmButtonText: 'Ok, got it!',
								customClass: { confirmButton: 'btn btn-primary' }
							});
							$('#forgotUsername').val('');
						} else {
							$('#forgotPasswordMessage').text(response.message || 'User not found!').addClass('text-danger').show();
						}
					},
					error: function() {
						$('#forgotPasswordMessage').text('Something went wrong. Please try again later.').addClass('text-danger').show();
					},
					complete: function() {
						btn.find('.indicator-label').show();
						btn.find('.indicator-progress').hide();
						btn.prop('disabled', false);
					}
				});
			});
		});
	</script>
</body>
<!--end::Body-->
</html>


