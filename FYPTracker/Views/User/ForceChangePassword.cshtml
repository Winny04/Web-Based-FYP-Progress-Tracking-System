@{
    Layout = null;
}
<!DOCTYPE html>
<style>
	#content {
    position: relative;
}
#content a img {
    position: absolute;
    top: 0px;
    right: 0px;
	max-width:100px;
	max-height:100px;
}
	body#kt_body {
		background-image: none !important;
		background-color: #eef2f7;
	}
	.login-bg-wrapper {
		background-image: none !important;
		background: linear-gradient(135deg, #1a3a5c 0%, #2d6a9f 50%, #1e4d7b 100%) !important;
		min-height: 100vh;
	}
</style>
<html lang="en">
<!--begin::Head-->
<head>
	<base href="../../../">
	<title>Complete Your Profile - FYP Tracking System</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	
	<!--begin::Fonts-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
	<!--end::Fonts-->
	<!--begin::Global Stylesheets Bundle(used by all pages)-->
	<link href="assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
	<!--end::Global Stylesheets Bundle-->
</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_body" class="bg-body">
	<!--begin::Main-->
	<div class="content">	<a href="" class="logo">
					<img src="~/assets/media/logos/fyp-logo-whale.png" alt="FYP Tracking System" style="position: absolute; top: 10px; left: 10px; height: 50px;" />
				</a></div>

	<div class="d-flex flex-column flex-root">
		<div class="d-flex flex-column flex-column-fluid login-bg-wrapper">
			<!--begin::Content-->
			<div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
				<!--begin::Wrapper-->
				<div class="w-lg-600px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto">
					<!--begin::Form-->
					<form class="form w-100" method="post" action="/User/ForceChangePassword">
                        @Html.AntiForgeryToken()
						<!--begin::Heading-->
						<div class="text-center mb-10">
							<h1 class="text-dark mb-3">Complete Your Profile</h1>
                            <div class="text-muted fw-bold fs-5 mb-5">Welcome! Please complete your profile details and set a new password before continuing.</div>
							
							@if (ViewBag.Error != null)
							{
							<div class="alert alert-danger" role="alert">
								@ViewBag.Error
							</div>
							}
						</div>
						<!--begin::Heading-->
						
                        <div class="fv-row mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">Full Name <span class="text-danger">*</span></label>
                            <input id="fullName" class="form-control form-control-lg form-control-solid" type="text" name="fullName" value="@ViewBag.User?.FullName" required placeholder="e.g. Ahmad bin Ali" minlength="8" maxlength="50" title="Full Name must be between 8 and 50 characters" />
                            <div id="fullNameError" class="text-danger mt-2 fs-7 fw-bold"></div>
                        </div>

                        <div class="fv-row mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">Phone Number</label>
                            <input id="phone" class="form-control form-control-lg form-control-solid" type="text" name="phone" value="@ViewBag.User?.Phone" pattern="^01[0-9]-?\d{7,8}$" title="Must be a valid Malaysian mobile number starting with 01 (e.g. 012-3456789 or 0123456789)" />
                            <div id="phoneError" class="text-danger mt-2 fs-7 fw-bold"></div>
                        </div>

                        @if (ViewBag.User != null && ViewBag.User.UserType == "Student")
                        {
                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Programme </label>
                                <input type="text" name="programme" id="programme" class="form-control form-control-lg form-control-solid bg-light text-muted" value="@ViewBag.User?.Programme" readonly />
                            </div>

                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Academic Session </label>
                                <input type="text" name="academicSession" id="academicSession" class="form-control form-control-lg form-control-solid bg-light text-muted" value="@ViewBag.User?.AcademicSession" readonly />
                            </div>
                        }

                        @if (ViewBag.User != null && (ViewBag.User.UserType == "Supervisor" || ViewBag.User.UserType == "Examiner"))
                        {
                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Title <span class="text-danger">*</span></label>
                                <select name="title" class="form-select form-select-solid form-select-lg fw-bold" required>
                                    <option value="">-- Select Title --</option>
                                    <option value="Mr." selected="@(ViewBag.User?.Title == "Mr." ? "selected" : null)">Mr.</option>
                                    <option value="Ms." selected="@(ViewBag.User?.Title == "Ms." ? "selected" : null)">Ms.</option>
                                    <option value="Mrs." selected="@(ViewBag.User?.Title == "Mrs." ? "selected" : null)">Mrs.</option>
                                    <option value="Dr." selected="@(ViewBag.User?.Title == "Dr." ? "selected" : null)">Dr.</option>
                                    <option value="Prof." selected="@(ViewBag.User?.Title == "Prof." ? "selected" : null)">Prof.</option>
                                    <option value="Assoc. Prof." selected="@(ViewBag.User?.Title == "Assoc. Prof." ? "selected" : null)">Assoc. Prof.</option>
                                    <option value="Ts." selected="@(ViewBag.User?.Title == "Ts." ? "selected" : null)">Ts.</option>
                                    <option value="Ir." selected="@(ViewBag.User?.Title == "Ir." ? "selected" : null)">Ir.</option>
                                </select>
                            </div>

                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Department <span class="text-danger">*</span></label>
                                <select name="departmentId" class="form-select form-select-solid form-select-lg fw-bold" required>
                                    <option value="">-- Select Department --</option>
                                    @if(ViewBag.Departments != null)
                                    {
                                        foreach(var dept in ViewBag.Departments)
                                        {
                                            <option value="@dept.Id" selected="@(ViewBag.User?.DepartmentId == dept.Id ? "selected" : null)">@dept.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Programme</label>
                                <select name="selectedProgrammes" class="form-select form-select-solid form-select-lg fw-bold" multiple="multiple" data-control="select2" data-placeholder="-- Select Programme(s) --">
                                    @if(ViewBag.Programmes != null)
                                    {
                                        var userProgs = ViewBag.User?.Programme != null ? (ViewBag.User.Programme as string).Split(',').Select(p => p.Trim()).ToList() : new List<string>();
                                        foreach(var prog in ViewBag.Programmes)
                                        {
                                            <option value="@prog.Name" selected="@(userProgs.Contains(prog.Name) ? "selected" : null)">@prog.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            
                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Specialization</label>
                                <select name="selectedSpecializations" class="form-select form-select-solid form-select-lg fw-bold" multiple="multiple" data-control="select2" data-placeholder="-- Select Specialization(s) --">
                                    @if(ViewBag.Specializations != null)
                                    {
                                        var userSpecs = ViewBag.User?.Specialization != null ? (ViewBag.User.Specialization as string).Split(',').Select(s => s.Trim()).ToList() : new List<string>();
                                        foreach(var spec in ViewBag.Specializations)
                                        {
                                            <option value="@spec.Name" selected="@(userSpecs.Contains(spec.Name) ? "selected" : null)">@spec.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        }

						<!--begin::Input group-->
						<div class="fv-row mb-7">
							<div class="d-flex flex-stack mb-2">
								<label class="form-label fw-bolder text-dark fs-6 mb-0">New Password <span class="text-danger">*</span></label>
							</div>
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="newPassword" id="newPassword" autocomplete="off" required />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('newPassword', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
							
							<!-- Password requirements checklist -->
							<div class="mt-3 text-muted d-none" id="passwordRequirements" style="font-size: 0.85rem;">
								<div class="d-flex align-items-center mb-1" id="req-length">
									<i class="fas fa-circle fs-9 me-2"></i> At least 8 characters
								</div>
								<div class="d-flex align-items-center mb-1" id="req-uppercase">
									<i class="fas fa-circle fs-9 me-2"></i> At least one uppercase letter (A-Z)
								</div>
								<div class="d-flex align-items-center mb-1" id="req-lowercase">
									<i class="fas fa-circle fs-9 me-2"></i> At least one lowercase letter (a-z)
								</div>
								<div class="d-flex align-items-center mb-1" id="req-number">
									<i class="fas fa-circle fs-9 me-2"></i> At least one number (0-9)
								</div>
								<div class="d-flex align-items-center mb-1" id="req-symbol">
									<i class="fas fa-circle fs-9 me-2"></i> At least one special symbol (!@@#$%^&*)
								</div>
							</div>
						</div>
						<!--end::Input group-->

                        <!--begin::Input group-->
						<div class="fv-row mb-10">
							<div class="d-flex flex-stack mb-2">
								<label class="form-label fw-bolder text-dark fs-6 mb-0">Confirm Password <span class="text-danger">*</span></label>
							</div>
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="confirmPassword" id="confirmPassword" autocomplete="off" required />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('confirmPassword', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
							
							<!-- Confirm match checklist -->
							<div class="mt-3 text-muted d-none" id="passwordMatchRequirement" style="font-size: 0.85rem;">
								<div class="d-flex align-items-center mb-1" id="req-match">
									<i class="fas fa-circle fs-9 me-2"></i> Passwords match
								</div>
							</div>
							
							<div id="passwordError" class="text-danger mt-2 fs-6 fw-bold"></div>
						</div>
						<!--end::Input group-->

						<!--begin::Actions-->
						<div class="text-center">
							<button type="submit" class="btn btn-lg btn-primary w-100 mb-5">
								<span class="indicator-label">Save & Continue</span>
							</button>
						</div>
						<!--end::Actions-->
					</form>
					<!--end::Form-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Content-->
		</div>
	</div>
	<!--end::Main-->
	
	<!--begin::Javascript-->
	<script src="assets/plugins/global/plugins.bundle.js"></script>
	<script src="assets/js/scripts.bundle.js"></script>
	<!--end::Global Javascript Bundle-->
	<!--begin::Page Custom Javascript-->
	<script>
		function togglePasswordVisibility(fieldId, element) {
			var field = document.getElementById(fieldId);
			var icon = element.querySelector('i');
			if (field.type === "password") {
				field.type = "text";
				icon.classList.remove('fa-eye');
				icon.classList.add('fa-eye-slash');
			} else {
				field.type = "password";
				icon.classList.remove('fa-eye-slash');
				icon.classList.add('fa-eye');
			}
		}

        // Academic session dropdown population removed as it's now a readonly input

		// Dynamic requirement highlighting
		document.getElementById('newPassword').addEventListener('input', function(e) {
			var p = e.target.value;
			var reqContainer = document.getElementById('passwordRequirements');
			
			if (p.length > 0) {
				reqContainer.classList.remove('d-none');
			} else {
				reqContainer.classList.add('d-none');
			}
			
			var hasLength = p.length >= 8;
			var hasUpper = /[A-Z]/.test(p);
			var hasLower = /[a-z]/.test(p);
			var hasNumber = /[0-9]/.test(p);
			var hasSymbol = /[^\da-zA-Z]/.test(p);
			
			function toggleReq(id, isValid) {
				var el = document.getElementById(id);
				var icon = el.querySelector('i');
				if (isValid) {
					el.classList.remove('text-muted');
					el.classList.add('text-success', 'fw-bold');
					icon.classList.remove('fa-circle', 'fs-9', 'text-muted');
					icon.classList.add('fa-check-circle', 'text-success');
				} else {
					el.classList.add('text-muted');
					el.classList.remove('text-success', 'fw-bold');
					icon.classList.add('fa-circle', 'fs-9', 'text-muted');
					icon.classList.remove('fa-check-circle', 'text-success');
				}
			}
			
			toggleReq('req-length', hasLength);
			toggleReq('req-uppercase', hasUpper);
			toggleReq('req-lowercase', hasLower);
			toggleReq('req-number', hasNumber);
			toggleReq('req-symbol', hasSymbol);
			
			checkMatch();
		});

		function checkMatch() {
			var p = document.getElementById('newPassword').value;
			var cp = document.getElementById('confirmPassword').value;
			var matchContainer = document.getElementById('passwordMatchRequirement');
			
			if (cp.length > 0) {
				matchContainer.classList.remove('d-none');
			} else {
				matchContainer.classList.add('d-none');
			}

			var match = (p === cp && cp.length > 0);
			var el = document.getElementById('req-match');
			var icon = el.querySelector('i');
			
			if (match) {
				el.classList.remove('text-muted');
				el.classList.add('text-success', 'fw-bold');
				icon.classList.remove('fa-circle', 'fs-9', 'text-muted');
				icon.classList.add('fa-check-circle', 'text-success');
			} else {
				el.classList.add('text-muted');
				el.classList.remove('text-success', 'fw-bold');
				icon.classList.add('fa-circle', 'fs-9', 'text-muted');
				icon.classList.remove('fa-check-circle', 'text-success');
			}
		}

		document.getElementById('confirmPassword').addEventListener('input', checkMatch);

		// Real-time validation for Full Name
		document.getElementById('fullName').addEventListener('input', function(e) {
			var val = e.target.value;
			var err = document.getElementById('fullNameError');
			if (val.length > 0 && (val.length < 8 || val.length > 50)) {
				err.innerText = "Full Name must be between 8 and 50 characters.";
			} else {
				err.innerText = "";
			}
		});

		// Real-time validation for Phone Number
		document.getElementById('phone').addEventListener('input', function(e) {
			var val = e.target.value;
			var err = document.getElementById('phoneError');
			var regex = /^01[0-9]-?\d{7,8}$/;
			if (val.length > 0 && !regex.test(val)) {
				err.innerText = "Must be a valid Malaysian mobile number (e.g. 012-3456789).";
			} else {
				err.innerText = "";
			}
		});

		// Optional client-side verification
		document.querySelector('form').addEventListener('submit', function(e) {
			var password = document.getElementById('newPassword').value;
			var confirmPassword = document.getElementById('confirmPassword').value;
			var errorDiv = document.getElementById('passwordError');

            var userType = '@ViewBag.User?.UserType';
            
            if (userType === 'Supervisor') {
                var title = document.getElementById('title');
                var dept = document.getElementById('department');
                if (title && title.value === "") {
                    e.preventDefault();
                    errorDiv.innerText = "Please select your Title.";
                    return;
                }
                if (dept && dept.value === "") {
                    e.preventDefault();
                    errorDiv.innerText = "Please select your Department.";
                    return;
                }
            }

			var strengthRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,}$/;
			if (!strengthRegex.test(password)) {
				e.preventDefault();
				errorDiv.innerText = "Password must be at least 8 characters long, containing uppercase, lowercase, numbers, and symbols.";
				return;
			}

			if (password !== confirmPassword) {
				e.preventDefault();
				errorDiv.innerText = "Passwords do not match!";
				return;
			}

			errorDiv.innerText = "";
		});
	</script>
</body>
</html>
