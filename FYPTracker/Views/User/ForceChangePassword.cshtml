@{
    Layout = null;
}
<!DOCTYPE html>
<style>
	#content {
    position: relative;
}
#content a img {
    position: absolute;
    top: 0px;
    right: 0px;
	max-width:100px;
	max-height:100px;
}
	body#kt_body {
		background-image: none !important;
		background-color: #eef2f7;
	}
	.login-bg-wrapper {
		background-image: none !important;
		background: linear-gradient(135deg, #1a3a5c 0%, #2d6a9f 50%, #1e4d7b 100%) !important;
		min-height: 100vh;
	}
</style>
<html lang="en">
<!--begin::Head-->
<head>
	<base href="../../../">
	<title>Complete Your Profile - FYP Tracking System</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	
	<!--begin::Fonts-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
	<!--end::Fonts-->
	<!--begin::Global Stylesheets Bundle(used by all pages)-->
	<link href="assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
	<!--end::Global Stylesheets Bundle-->
</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_body" class="bg-body">
	<!--begin::Main-->
	<div class="content">	<a href="" class="logo">
					<img src="~/assets/media/logos/fyp-logo-whale.png" alt="FYP Tracking System" style="position: absolute; top: 10px; left: 10px; height: 50px;" />
				</a></div>

	<div class="d-flex flex-column flex-root">
		<div class="d-flex flex-column flex-column-fluid login-bg-wrapper">
			<!--begin::Content-->
			<div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
				<!--begin::Wrapper-->
				<div class="w-lg-600px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto">
					<!--begin::Form-->
					<form class="form w-100" method="post" action="/User/ForceChangePassword">
                        @Html.AntiForgeryToken()
						<!--begin::Heading-->
						<div class="text-center mb-10">
							<h1 class="text-dark mb-3">Complete Your Profile</h1>
                            <div class="text-muted fw-bold fs-5 mb-5">Welcome! Please complete your profile details and set a new password before continuing.</div>
							
							@if (ViewBag.Error != null)
							{
							<div class="alert alert-danger" role="alert">
								@ViewBag.Error
							</div>
							}
						</div>
						<!--begin::Heading-->
						
                        <div class="fv-row mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">Full Name <span class="text-danger">*</span></label>
                            <input class="form-control form-control-lg form-control-solid" type="text" name="fullName" required placeholder="e.g. Ahmad bin Ali" />
                        </div>

                        <div class="fv-row mb-7">
                            <label class="form-label fw-bolder text-dark fs-6">Phone Number</label>
                            <input class="form-control form-control-lg form-control-solid" type="text" name="phone" placeholder="e.g. 0123456789" />
                        </div>

                        @if (ViewBag.User != null && ViewBag.User.UserType == "Student")
                        {
                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Programme <span class="text-danger">*</span></label>
                                <select name="programme" class="form-select form-select-solid form-select-lg fw-bold" required>
                                    <option value="">-- Select Programme --</option>
                                    <option value="BCSCUNP (Bachelor of Computer Science)">BCSCUNP (Bachelor of Computer Science)</option>
                                    <option value="BIT (Bachelor of Information Technology)">BIT (Bachelor of Information Technology)</option>
                                    <option value="BSE (Bachelor of Software Engineering)">BSE (Bachelor of Software Engineering)</option>
                                    <option value="DIT (Diploma in Information Technology)">DIT (Diploma in Information Technology)</option>
                                    <option value="FIC (Foundation in Computing)">FIC (Foundation in Computing)</option>
                                    <option value="BCSC-CC (BSc Cloud Computing)">BCSC-CC (BSc Cloud Computing)</option>
                                    <option value="BCSC-MC (BSc Mobile Computing)">BCSC-MC (BSc Mobile Computing)</option>
                                    <option value="BCSC-BA (BSc Business Analytics)">BCSC-BA (BSc Business Analytics)</option>
                                    <option value="BCSC-CS (BSc Cyber Security)">BCSC-CS (BSc Cyber Security)</option>
                                </select>
                            </div>

                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Academic Session <span class="text-danger">*</span></label>
                                <select name="academicSession" id="academicSession" class="form-select form-select-solid form-select-lg fw-bold" required>
                                    <option value="">-- Select Session --</option>
                                </select>
                            </div>
                        }

                        @if (ViewBag.User != null && ViewBag.User.UserType == "Supervisor")
                        {
                            <div class="fv-row mb-7">
                                <label class="form-label fw-bolder text-dark fs-6">Title</label>
                                <input class="form-control form-control-lg form-control-solid" type="text" name="title" placeholder="e.g. Dr., Prof." />
                            </div>
                        }

						<!--begin::Input group-->
						<div class="fv-row mb-7">
							<div class="d-flex flex-stack mb-2">
								<label class="form-label fw-bolder text-dark fs-6 mb-0">New Password <span class="text-danger">*</span></label>
							</div>
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="newPassword" id="newPassword" autocomplete="off" required />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('newPassword', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
						</div>
						<!--end::Input group-->

                        <!--begin::Input group-->
						<div class="fv-row mb-10">
							<div class="d-flex flex-stack mb-2">
								<label class="form-label fw-bolder text-dark fs-6 mb-0">Confirm Password <span class="text-danger">*</span></label>
							</div>
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="confirmPassword" id="confirmPassword" autocomplete="off" required />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('confirmPassword', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
						</div>
						<!--end::Input group-->

						<!--begin::Actions-->
						<div class="text-center">
							<button type="submit" class="btn btn-lg btn-primary w-100 mb-5">
								<span class="indicator-label">Save & Continue</span>
							</button>
						</div>
						<!--end::Actions-->
					</form>
					<!--end::Form-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Content-->
		</div>
	</div>
	<!--end::Main-->
	
	<!--begin::Javascript-->
	<script src="assets/plugins/global/plugins.bundle.js"></script>
	<script src="assets/js/scripts.bundle.js"></script>
	<!--end::Global Javascript Bundle-->
	<!--begin::Page Custom Javascript-->
	<script>
		function togglePasswordVisibility(fieldId, element) {
			var field = document.getElementById(fieldId);
			var icon = element.querySelector('i');
			if (field.type === "password") {
				field.type = "text";
				icon.classList.remove('fa-eye');
				icon.classList.add('fa-eye-slash');
			} else {
				field.type = "password";
				icon.classList.remove('fa-eye-slash');
				icon.classList.add('fa-eye');
			}
		}

        // Populate academic session
        var sessionSelect = document.getElementById('academicSession');
        if (sessionSelect) {
            var currentYear = new Date().getFullYear();
            var intakes = ['Jan', 'April', 'Aug'];
            for (var y = currentYear - 1; y <= currentYear + 2; y++) {
                intakes.forEach(function(intake) {
                    var sessionText = y + ' ' + intake;
                    var opt = document.createElement('option');
                    opt.value = sessionText;
                    opt.innerHTML = sessionText;
                    sessionSelect.appendChild(opt);
                });
            }
        }
	</script>
</body>
</html>
