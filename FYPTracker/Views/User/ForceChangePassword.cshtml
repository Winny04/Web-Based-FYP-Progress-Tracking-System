@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<!--begin::Head-->
<head>
	<base href="../../../">
	<title>Force Password Change - FYP Tracking System</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	
	<!--begin::Fonts-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
	<!--end::Fonts-->
	<!--begin::Global Stylesheets Bundle(used by all pages)-->
	<link href="assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
	<!--end::Global Stylesheets Bundle-->
</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_body" class="bg-body" style="background-image: url(/assets/media/patterns/header-bg.jpg)">
	<!--begin::Main-->
	<div class="d-flex flex-column flex-root">
		<div class="d-flex flex-column flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain bgi-attachment-fixed" style="background-image: url(assets/media/illustrations/sigma-1/14.png);height:1000px;">
			<!--begin::Content-->
			<div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
				<!--begin::Wrapper-->
				<div class="w-lg-500px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto">
					<!--begin::Form-->
					<form class="form w-100" method="post" action="/User/ForceChangePassword">
                        @Html.AntiForgeryToken()
						<!--begin::Heading-->
						<div class="text-center mb-10">
							<h1 class="text-dark mb-3">Change Password Required</h1>
                            <div class="text-muted fw-bold fs-5 mb-5">For your security, please change your temporary password before continuing.</div>
							
							@if (ViewBag.Error != null)
							{
							<div class="alert alert-danger" role="alert">
								@ViewBag.Error
							</div>
							}
						</div>
						<!--begin::Heading-->
						
						<!--begin::Input group-->
						<div class="fv-row mb-10">
							<div class="d-flex flex-stack mb-2">
								<label class="form-label fw-bolder text-dark fs-6 mb-0">New Password</label>
							</div>
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="newPassword" id="newPassword" autocomplete="off" required />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('newPassword', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
						</div>
						<!--end::Input group-->

                        <!--begin::Input group-->
						<div class="fv-row mb-10">
							<div class="d-flex flex-stack mb-2">
								<label class="form-label fw-bolder text-dark fs-6 mb-0">Confirm Password</label>
							</div>
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="confirmPassword" id="confirmPassword" autocomplete="off" required />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('confirmPassword', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
						</div>
						<!--end::Input group-->

						<!--begin::Actions-->
						<div class="text-center">
							<button type="submit" class="btn btn-lg btn-primary w-100 mb-5">
								<span class="indicator-label">Update Password</span>
							</button>
						</div>
						<!--end::Actions-->
					</form>
					<!--end::Form-->
				</div>
				<!--end::Wrapper-->
			</div>
			<!--end::Content-->
		</div>
	</div>
	<!--end::Main-->
	
	<!--begin::Javascript-->
	<script src="assets/plugins/global/plugins.bundle.js"></script>
	<script src="assets/js/scripts.bundle.js"></script>
	<!--end::Global Javascript Bundle-->
	<!--begin::Page Custom Javascript-->
	<script>
		function togglePasswordVisibility(fieldId, element) {
			var field = document.getElementById(fieldId);
			var icon = element.querySelector('i');
			if (field.type === "password") {
				field.type = "text";
				icon.classList.remove('fa-eye');
				icon.classList.add('fa-eye-slash');
			} else {
				field.type = "password";
				icon.classList.remove('fa-eye-slash');
				icon.classList.add('fa-eye');
			}
		}
	</script>
</body>
</html>
