@model FYPTracker.Models.ApplicationUser
@{
    ViewBag.Title = "Set up Two-Factor Authentication";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom py-3">
            <h3 class="card-title fw-bold text-dark mb-0"><i class="fas fa-shield-alt text-primary me-2"></i> Set up Two-Factor Authentication (2FA)</h3>
        </div>
        <div class="card-body p-5 text-center">
            
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger mb-4">@TempData["error"]</div>
            }

            <h5 class="fw-bold text-dark mb-4">Step 1: Scan the QR Code</h5>
            <p class="text-muted">Open your Authenticator app (e.g., Microsoft Authenticator or Google Authenticator) and scan the following QR code.</p>
            
            <div class="bg-light p-4 rounded-3 d-inline-block mb-4 border">
                <img src="@ViewBag.QrCodeImageUrl" alt="QR Code" class="img-fluid" />
            </div>

            <p class="text-muted small mb-5">If you cannot scan the QR code, manually enter this key into your app:<br />
                <strong class="text-dark fs-5 tracking-widest">@ViewBag.ManualEntryKey</strong>
            </p>

            <hr />

            <h5 class="fw-bold text-dark mb-4 mt-5">Step 2: Verify and Enable</h5>
            <p class="text-muted mb-4">Enter the 6-digit code generated by your app to verify the setup.</p>
            
            <form action="@Url.Action("VerifyMfaSetup", "User")" method="post" class="w-md-50 mx-auto">
                <div class="input-group mb-4">
                    <input type="text" name="code" class="form-control form-control-lg text-center fw-bold tracking-widest" placeholder="123456" maxlength="6" pattern="\d{6}" required autocomplete="off" autofocus />
                    <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold">Verify & Enable</button>
                </div>
            </form>

        </div>
    </div>
</div>
