@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<title>FYP Tracking System - Reset Password</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
	<link href="/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
	<style>
		body#kt_body {
			background-image: none !important;
			background-color: #eef2f7;
		}
		.login-bg-wrapper {
			background-image: none !important;
			background: linear-gradient(135deg, #1a3a5c 0%, #2d6a9f 50%, #1e4d7b 100%) !important;
			min-height: 100vh;
		}
	</style>
</head>
<body id="kt_body" class="bg-body">
	<div class="content">	
		<a href="" class="logo">
			<img src="~/assets/media/logos/fyp-logo-whale.png" alt="FYP Tracking System" style="position: absolute; top: 10px; left: 10px; height: 50px;" />
		</a>
	</div>

	<div class="d-flex flex-column flex-root">
		<div class="d-flex flex-column flex-column-fluid login-bg-wrapper">
			<div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
				<div class="w-lg-500px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto">
					<form class="form w-100" method="post" id="resetPasswordForm">
						<input type="hidden" name="token" value="@ViewBag.Token" />
						<div class="text-center mb-10">
							<h1 class="text-dark mb-3">Reset Password</h1>
							<div class="text-gray-400 fw-bold fs-4">Please enter and confirm your new password below.</div>
							

							@if (ViewBag.Success != null)
							{
								<div class="alert alert-success mt-4" role="alert" id="successAlert">
									@ViewBag.Success
								</div>
								<script>
									setTimeout(function() {
										window.location.href = '/User/Login';
									}, 3000);
								</script>
							}
						</div>

						<div class="fv-row mb-10">
							<label class="form-label fw-bolder text-dark fs-6 mb-0">New Password</label>
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="password" id="password" required autocomplete="off" />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('password', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
							
							<!-- Password requirements checklist -->
							<div class="mt-3 text-muted d-none" id="passwordRequirements" style="font-size: 0.85rem;">
								<div class="d-flex align-items-center mb-1" id="req-length">
									<i class="fas fa-circle fs-9 me-2"></i> At least 8 characters
								</div>
								<div class="d-flex align-items-center mb-1" id="req-uppercase">
									<i class="fas fa-circle fs-9 me-2"></i> At least one uppercase letter (A-Z)
								</div>
								<div class="d-flex align-items-center mb-1" id="req-lowercase">
									<i class="fas fa-circle fs-9 me-2"></i> At least one lowercase letter (a-z)
								</div>
								<div class="d-flex align-items-center mb-1" id="req-number">
									<i class="fas fa-circle fs-9 me-2"></i> At least one number (0-9)
								</div>
								<div class="d-flex align-items-center mb-1" id="req-symbol">
									<i class="fas fa-circle fs-9 me-2"></i> At least one special symbol (!@@#$%^&*)
								</div>
							</div>
						</div>

						<div class="fv-row mb-10">
							<label class="form-label fw-bolder text-dark fs-6 mb-0">Confirm New Password</label>
							<div class="position-relative">
								<input class="form-control form-control-lg form-control-solid" style="padding-right: 40px;" type="password" name="confirmPassword" id="confirmPassword" required autocomplete="off" />
								<span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('confirmPassword', this)">
									<i class="fas fa-eye text-muted"></i>
								</span>
							</div>
							
							<!-- Confirm match checklist -->
							<div class="mt-3 text-muted d-none" id="passwordMatchRequirement" style="font-size: 0.85rem;">
								<div class="d-flex align-items-center mb-1" id="req-match">
									<i class="fas fa-circle fs-9 me-2"></i> Passwords match
								</div>
							</div>
							
							<div id="passwordError" class="text-danger mt-2 fs-6 fw-bold">
								@if (ViewBag.Error != null)
								{
									@ViewBag.Error
								}
							</div>
						</div>

						<div class="text-center">
							<button type="submit" id="kt_reset_password_submit" class="btn btn-lg btn-primary w-100 mb-5">
								<span class="indicator-label">Update Password</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>

	<script src="/assets/plugins/global/plugins.bundle.js"></script>
	<script src="/assets/js/scripts.bundle.js"></script>
	<script>
		function togglePasswordVisibility(fieldId, element) {
			var field = document.getElementById(fieldId);
			var icon = element.querySelector('i');
			if (field.type === "password") {
				field.type = "text";
				icon.classList.remove('fa-eye');
				icon.classList.add('fa-eye-slash');
			} else {
				field.type = "password";
				icon.classList.remove('fa-eye-slash');
				icon.classList.add('fa-eye');
			}
		}

		// Dynamic requirement highlighting
		document.getElementById('password').addEventListener('input', function(e) {
			var p = e.target.value;
			var reqContainer = document.getElementById('passwordRequirements');
			
			if (p.length > 0) {
				reqContainer.classList.remove('d-none');
			} else {
				reqContainer.classList.add('d-none');
			}
			
			var hasLength = p.length >= 8;
			var hasUpper = /[A-Z]/.test(p);
			var hasLower = /[a-z]/.test(p);
			var hasNumber = /[0-9]/.test(p);
			var hasSymbol = /[^\da-zA-Z]/.test(p);
			
			function toggleReq(id, isValid) {
				var el = document.getElementById(id);
				var icon = el.querySelector('i');
				if (isValid) {
					el.classList.remove('text-muted');
					el.classList.add('text-success', 'fw-bold');
					icon.classList.remove('fa-circle', 'fs-9', 'text-muted');
					icon.classList.add('fa-check-circle', 'text-success');
				} else {
					el.classList.add('text-muted');
					el.classList.remove('text-success', 'fw-bold');
					icon.classList.add('fa-circle', 'fs-9', 'text-muted');
					icon.classList.remove('fa-check-circle', 'text-success');
				}
			}
			
			toggleReq('req-length', hasLength);
			toggleReq('req-uppercase', hasUpper);
			toggleReq('req-lowercase', hasLower);
			toggleReq('req-number', hasNumber);
			toggleReq('req-symbol', hasSymbol);
			
			checkMatch();
		});

		function checkMatch() {
			var p = document.getElementById('password').value;
			var cp = document.getElementById('confirmPassword').value;
			var matchContainer = document.getElementById('passwordMatchRequirement');
			
			if (cp.length > 0) {
				matchContainer.classList.remove('d-none');
			} else {
				matchContainer.classList.add('d-none');
			}

			var match = (p === cp && cp.length > 0);
			var el = document.getElementById('req-match');
			var icon = el.querySelector('i');
			
			if (match) {
				el.classList.remove('text-muted');
				el.classList.add('text-success', 'fw-bold');
				icon.classList.remove('fa-circle', 'fs-9', 'text-muted');
				icon.classList.add('fa-check-circle', 'text-success');
			} else {
				el.classList.add('text-muted');
				el.classList.remove('text-success', 'fw-bold');
				icon.classList.add('fa-circle', 'fs-9', 'text-muted');
				icon.classList.remove('fa-check-circle', 'text-success');
			}
		}

		document.getElementById('confirmPassword').addEventListener('input', checkMatch);

		// Optional client-side verification
		document.getElementById('resetPasswordForm').addEventListener('submit', function(e) {
			var password = document.getElementById('password').value;
			var confirmPassword = document.getElementById('confirmPassword').value;
			var errorDiv = document.getElementById('passwordError');

			var strengthRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,}$/;
			if (!strengthRegex.test(password)) {
				e.preventDefault();
				errorDiv.innerText = "Password must be at least 8 characters long, containing uppercase, lowercase, numbers, and symbols.";
				return;
			}

			if (password !== confirmPassword) {
				e.preventDefault();
				errorDiv.innerText = "Passwords do not match!";
				return;
			}

			errorDiv.innerText = "";
		});
	</script>
</body>
</html>
