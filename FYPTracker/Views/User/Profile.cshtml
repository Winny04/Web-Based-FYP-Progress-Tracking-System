@using FYPTracker.Models
@using Microsoft.EntityFrameworkCore
@model ApplicationUser
@inject FYPTrackerContext DbContext
@{
    ViewData["Title"] = "Student Profile";
    
    // Fetch project and supervisor dynamically
    var project = DbContext.FYPProjects.Include(p => p.Supervisor).FirstOrDefault(p => p.StudentId == Model.Id);
    var supervisorName = project?.Supervisor?.FullName ?? "Not Assigned";
}

<style>
    :root {
        --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }
    
    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .premium-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .form-control {
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        font-size: 0.9rem;
        padding: 9px 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus {
        border-color: #334155;
        box-shadow: 0 0 0 3px rgba(51, 65, 85, 0.15);
    }

    .btn-submit {
        background: #1e293b;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 700;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: scale(1.03);
        color: white;
    }

    .profile-photo-circle {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        border: 4px solid white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        overflow: hidden;
        margin: 0 auto 15px auto;
    }
</style>

<div class="container py-4">

    @* HTML Alerts removed in favor of SweetAlert popup below *@

    @* ── Page Title & Hero ──────────────────────────────────── *@
    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-user-circle me-2"></i>My Profile</h2>
            <p class="mb-0 opacity-90">View and update your account settings, change password, and customize your experience.</p>
        </div>
    </div>

    <div class="row g-4">
        
        @* ── LEFT COLUMN: Profile info display & edit ──────────── *@
        <div class="col-lg-7">
            <!-- Edit Profile & Info Display Card -->
            <div class="premium-card p-4">
                <div class="text-center mb-4">
                    <!-- Circular Profile Photo -->
                    <div class="profile-photo-circle">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img id="avatarPreview" src="@Model.Image" alt="Profile Image" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/assets/media/avatars/blank.png';" />
                        }
                        else
                        {
                            <img id="avatarPreview" src="/assets/media/avatars/blank.png" alt="Profile Image" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                    </div>
                    <h4 class="fw-bold text-dark mb-0">@(Model.UserType == "Supervisor" ? Model.Title + " " : "")@Model.FullName</h4>
                    <span class="badge bg-light text-muted border px-3 py-1 rounded-pill mt-1">@Model.UserType</span>
                </div>

                <form asp-action="EditProfile" asp-controller="User" method="post" enctype="multipart/form-data" id="editProfileForm">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="UserName" value="@Model.UserName" />

                    <input type="hidden" name="UserType" value="@Model.UserType" />
                    <input type="hidden" name="PassCode" value="@Model.PassCode" />
                    <input type="hidden" name="Department" value="@Model.EmpDepartment?.Name" />
                    <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />
                    <input type="hidden" name="isImgChanged" id="isImgChanged" value="false" />
                    @* Preserve readonly fields so they are not wiped on save *@
                    <input type="hidden" name="Programme" value="@Model.Programme" />
                    <input type="hidden" name="Specialization" value="@Model.Specialization" />
                    <input type="hidden" name="AcademicSession" value="@Model.AcademicSession" />
                    <input type="hidden" name="Title" value="@Model.Title" />

                    <!-- Circular Photo Upload -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Upload Profile Photo</label>
                        <input type="file" name="picture" class="form-control" accept="image/*" onchange="previewImage(this)" />
                    </div>

                    <!-- Display Info & Editable Fields -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input type="text" name="FullName" class="form-control bg-light border-0" value="@Model.FullName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" name="Email" class="form-control bg-light" value="@Model.Email" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input type="tel" name="Phone" id="phone" class="form-control" value="@Model.Phone" placeholder="012-3456789" />
                            <div id="phoneError" class="text-danger mt-1 fs-7 fw-bold"></div>
                        </div>

                        @if (Model.UserType == "Student")
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Matric ID</label>
                                <input type="text" class="form-control bg-light border-0" value="@Model.EmployeeId" readonly />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Programme</label>
                                <input type="text" class="form-control bg-light border-0" value="@(Model.Programme ?? "Not Assigned")" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Academic Session</label>
                                <input type="text" class="form-control bg-light border-0" value="@(Model.AcademicSession ?? "Not Assigned")" readonly />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Assigned Supervisor</label>
                                <input type="text" class="form-control bg-light border-0" value="@supervisorName" readonly />
                            </div>
                        }
                        else if (Model.UserType == "Supervisor" || Model.UserType == "Examiner")
                        {
                            var currentStudents = ViewBag.FilledSlots ?? 0;
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Title</label>
                                <input type="text" class="form-control bg-light border-0" value="@(Model.Title ?? "Not Assigned")" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Department</label>
                                <input type="text" class="form-control bg-light border-0" value="@(Model.EmpDepartment?.Name ?? "Not Assigned")" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Programme</label>
                                <input type="text" class="form-control bg-light border-0" value="@(Model.Programme ?? "Not Assigned")" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Specialization</label>
                                <input type="text" class="form-control bg-light border-0" value="@(Model.Specialization ?? "Not Assigned")" readonly />
                            </div>

                            @if (Model.UserType == "Supervisor")
                            {
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold">Current Student Slots</label>
                                    <input type="number" name="MaxStudentSlots" class="form-control" value="@Model.MaxStudentSlots" min="1" max="10" />
                                    <small class="text-muted d-block mt-1">Currently @currentStudents slots are filled. (@Math.Max(0, (Model.MaxStudentSlots ?? 5) - (int)currentStudents)) available left)</small>
                                </div>
                            }
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <!-- Account Actions: Logout -->
                        <a href="/User/Logout" class="btn btn-outline-danger rounded-3 px-4 fw-bold">
                            <i class="fas fa-sign-out-alt me-1"></i> Logout
                        </a>
                        <button type="submit" class="btn-submit">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* ── RIGHT COLUMN: Security Section (Change Password) ── *@
        <div class="col-lg-5">
            <div class="premium-card p-4 h-100">
                <h5 class="fw-bold text-dark mb-4"><i class="fas fa-shield-alt text-primary me-2"></i>Security Section</h5>
                
                <form asp-action="ChangePassword" asp-controller="User" method="post" id="changePasswordForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Password</label>
                        <div class="position-relative">
                            <input type="password" name="currentPassword" id="currentPassword" class="form-control" required />
                            <span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('currentPassword', this)">
                                <i class="fas fa-eye text-muted"></i>
                            </span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password</label>
                        <div class="position-relative">
                            <input type="password" name="newPassword" id="newPassword" class="form-control" required />
                            <span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('newPassword', this)">
                                <i class="fas fa-eye text-muted"></i>
                            </span>
                        </div>
                        
                        <!-- Password requirements checklist -->
                        <div class="mt-2 text-muted d-none" id="passwordRequirements" style="font-size: 0.85rem;">
                            <div class="d-flex align-items-center mb-1" id="req-length">
                                <i class="fas fa-circle fs-9 me-2"></i> At least 8 characters
                            </div>
                            <div class="d-flex align-items-center mb-1" id="req-uppercase">
                                <i class="fas fa-circle fs-9 me-2"></i> At least one uppercase letter (A-Z)
                            </div>
                            <div class="d-flex align-items-center mb-1" id="req-lowercase">
                                <i class="fas fa-circle fs-9 me-2"></i> At least one lowercase letter (a-z)
                            </div>
                            <div class="d-flex align-items-center mb-1" id="req-number">
                                <i class="fas fa-circle fs-9 me-2"></i> At least one number (0-9)
                            </div>
                            <div class="d-flex align-items-center mb-1" id="req-symbol">
                                <i class="fas fa-circle fs-9 me-2"></i> At least one special symbol (!@@#$%^&*)
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Confirm New Password</label>
                        <div class="position-relative">
                            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" required />
                            <span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('confirmPassword', this)">
                                <i class="fas fa-eye text-muted"></i>
                            </span>
                        </div>
                        
                        <!-- Confirm match checklist -->
                        <div class="mt-2 text-muted d-none" id="passwordMatchRequirement" style="font-size: 0.85rem;">
                            <div class="d-flex align-items-center mb-1" id="req-match">
                                <i class="fas fa-circle fs-9 me-2"></i> Passwords match
                            </div>
                        </div>
                        <div id="passwordError" class="text-danger mt-2 fs-6 fw-bold"></div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-dark btn-lg rounded-3 fw-bold">
                            Update Password
                        </button>
                    </div>
                </form>
                
                <hr class="my-5" />

                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-lock text-primary me-2"></i>Two-Factor Authentication</h5>
                @if (Model.IsMfaEnabled)
                {
                    <div class="alert alert-success d-flex align-items-center p-4">
                        <i class="fas fa-check-circle fs-2hx text-success me-4"></i>
                        <div class="d-flex flex-column">
                            <h4 class="mb-1 text-success">2FA is Enabled</h4>
                            <span>Your account is protected with an authenticator app.</span>
                        </div>
                    </div>
                    <form action="@Url.Action("DisableMfa", "User")" method="post" onsubmit="return confirm('Are you sure you want to disable Two-Factor Authentication? This will make your account less secure.');">
                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold">Disable 2FA</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning d-flex align-items-center p-4">
                        <i class="fas fa-exclamation-triangle fs-2hx text-warning me-4"></i>
                        <div class="d-flex flex-column">
                            <h4 class="mb-1 text-warning">2FA is Disabled</h4>
                            <span>Protect your account by enabling Two-Factor Authentication.</span>
                        </div>
                    </div>
                    <a href="@Url.Action("SetupMfa", "User")" class="btn btn-primary w-100 fw-bold">Enable 2FA</a>
                }

            </div>
        </div>
    </div>
</div>

@section scripts{
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(document).ready(function() {
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({
                title: 'Success!',
                text: '@Html.Raw(TempData["Success"].ToString().Replace("'", "\\'"))',
                icon: 'success',
                confirmButtonColor: '#3b82f6'
            });
            </text>
        }
        
        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({
                title: 'Error!',
                text: '@Html.Raw(TempData["Error"].ToString().Replace("'", "\\'"))',
                icon: 'error',
                confirmButtonColor: '#3b82f6'
            });
            </text>
        }
    });

    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            
            reader.onload = function(e) {
                $('#avatarPreview').attr('src', e.target.result);
                $('#isImgChanged').val('true');
            }
            
            reader.readAsDataURL(input.files[0]);
        }
    }

    function togglePasswordVisibility(inputId, iconSpan) {
        var input = document.getElementById(inputId);
        var icon = iconSpan.querySelector('i');
        
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
            icon.classList.add('text-primary');
            icon.classList.remove('text-muted');
        } else {
            input.type = "password";
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
            icon.classList.remove('text-primary');
            icon.classList.add('text-muted');
        }
    }

    // Dynamic requirement highlighting
    document.getElementById('newPassword').addEventListener('input', function(e) {
        var p = e.target.value;
        var reqContainer = document.getElementById('passwordRequirements');
        
        if (p.length > 0) {
            reqContainer.classList.remove('d-none');
        } else {
            reqContainer.classList.add('d-none');
        }
        
        var hasLength = p.length >= 8;
        var hasUpper = /[A-Z]/.test(p);
        var hasLower = /[a-z]/.test(p);
        var hasNumber = /[0-9]/.test(p);
        var hasSymbol = /[^\da-zA-Z]/.test(p);
        
        function toggleReq(id, isValid) {
            var el = document.getElementById(id);
            var icon = el.querySelector('i');
            if (isValid) {
                el.classList.remove('text-muted');
                el.classList.add('text-success', 'fw-bold');
                icon.classList.remove('fa-circle', 'fs-9', 'text-muted');
                icon.classList.add('fa-check-circle', 'text-success');
            } else {
                el.classList.add('text-muted');
                el.classList.remove('text-success', 'fw-bold');
                icon.classList.add('fa-circle', 'fs-9', 'text-muted');
                icon.classList.remove('fa-check-circle', 'text-success');
            }
        }
        
        toggleReq('req-length', hasLength);
        toggleReq('req-uppercase', hasUpper);
        toggleReq('req-lowercase', hasLower);
        toggleReq('req-number', hasNumber);
        toggleReq('req-symbol', hasSymbol);
        
        checkMatch();
    });

    function checkMatch() {
        var p = document.getElementById('newPassword').value;
        var cp = document.getElementById('confirmPassword').value;
        var matchContainer = document.getElementById('passwordMatchRequirement');
        
        if (cp.length > 0) {
            matchContainer.classList.remove('d-none');
        } else {
            matchContainer.classList.add('d-none');
        }

        var match = (p === cp && cp.length > 0);
        var el = document.getElementById('req-match');
        var icon = el.querySelector('i');
        
        if (match) {
            el.classList.remove('text-muted');
            el.classList.add('text-success', 'fw-bold');
            icon.classList.remove('fa-circle', 'fs-9', 'text-muted');
            icon.classList.add('fa-check-circle', 'text-success');
        } else {
            el.classList.add('text-muted');
            el.classList.remove('text-success', 'fw-bold');
            icon.classList.add('fa-circle', 'fs-9', 'text-muted');
            icon.classList.remove('fa-check-circle', 'text-success');
        }
    }

    document.getElementById('confirmPassword').addEventListener('input', checkMatch);

    // Custom form validation before submit
    document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
        var password = document.getElementById('newPassword').value;
        var confirmPassword = document.getElementById('confirmPassword').value;
        var errorDiv = document.getElementById('passwordError');

        var strengthRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,}$/;
        if (!strengthRegex.test(password)) {
            e.preventDefault();
            errorDiv.innerText = "Password must be at least 8 characters long, containing uppercase, lowercase, numbers, and symbols.";
            return;
        }

        if (password !== confirmPassword) {
            e.preventDefault();
            errorDiv.innerText = "Passwords do not match!";
            return;
        }

        errorDiv.innerText = "";
    });

    // Phone validation
    const phoneInput = document.getElementById('phone');
    const phoneError = document.getElementById('phoneError');
    const phonePattern = /^01[0-9]-?\d{7,8}$/;
    
    if (phoneInput) {
        phoneInput.addEventListener('input', function() {
            if (this.value && !phonePattern.test(this.value)) {
                phoneError.innerText = "Please enter a valid Malaysian mobile number (e.g. 012-3456789).";
                this.classList.add('is-invalid');
            } else {
                phoneError.innerText = "";
                this.classList.remove('is-invalid');
            }
        });
    }

    document.getElementById('editProfileForm').addEventListener('submit', function(e) {
        if (phoneInput && phoneInput.value && !phonePattern.test(phoneInput.value)) {
            e.preventDefault();
            phoneError.innerText = "Please enter a valid Malaysian mobile number before saving.";
            phoneInput.focus();
        }
    });
</script>
}
