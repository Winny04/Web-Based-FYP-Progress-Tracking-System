@using FYPTracker.Models
@model IEnumerable<FYPNotification>
@{
    ViewData["Title"] = "Notifications";
    var currentUser = ViewBag.CurrentUser as ApplicationUser;
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
    var notifications = Model?.ToList() ?? new List<FYPNotification>();
}

<style>
    :root { --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .glass-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 20px rgba(0,0,0,.06);
    }

    .notif-item {
        border-radius: 12px;
        padding: 16px 20px;
        border: 2px solid #f3f4f6;
        transition: all .2s;
        position: relative;
    }
    .notif-item.unread {
        border-color: #e2e8f0;
        background: #f8fafc;
    }
    .notif-item:hover { border-color: #94a3b8; }
    
    .hover-orange:hover { color: #d97706 !important; }

    .unread-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: #475569;
        flex-shrink: 0;
        margin-top: 6px;
    }

    .notif-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .btn-read {
        background: none;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        padding: 4px 12px;
        font-size: .75rem;
        font-weight: 600;
        color: #6b7280;
        transition: all .18s;
    }
    .btn-read:hover { border-color: #475569; color: #1e293b; background: #f1f5f9; }

    .btn-mark-all {
        background: #fff;
        color: #1e293b;
        border: 1.5px solid rgba(255,255,255,0.5);
        border-radius: 10px;
        padding: 8px 20px;
        font-weight: 700;
        font-size: .85rem;
        transition: opacity .2s;
    }
    .btn-mark-all:hover { background: rgba(255,255,255,0.9); }

    .filter-tab {
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 6px 16px;
        cursor: pointer;
        font-size: .82rem;
        font-weight: 600;
        color: #6b7280;
        background: #fff;
        transition: all .18s;
    }
    .filter-tab:hover, .filter-tab.active { border-color: #334155; color: #1e293b; background: #f1f5f9; }
</style>

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-3 d-flex align-items-center gap-2">
            <i class="fas fa-check-circle fs-4"></i> <span>@TempData["Success"]</span>
        </div>
    }

    @* ── Hero ─────────────────────────────────────────────── *@
    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="display-6 fw-bold mb-2"><i class="fas fa-bell me-2"></i>Notifications</h2>
            <p class="mb-0 opacity-80">Stay updated with supervisor approvals, meeting updates, and deadlines.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            @if (unreadCount > 0)
            {
                <span class="badge bg-white fw-bold px-3 py-2 rounded-pill text-dark">
                    @unreadCount Unread
                </span>
                <form asp-action="MarkAllRead" asp-controller="Student" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-mark-all btn">
                        <i class="fas fa-check-double me-1"></i> Mark All Read
                    </button>
                </form>
            }
            else
            {
                <span class="badge bg-white fw-bold px-3 py-2 rounded-pill text-success">All caught up ✓</span>
            }
        </div>
    </div>

    <div class="glass-card p-4">

        @* ── Filter Tabs ──────────────────────────────────── *@
        <div class="d-flex gap-2 flex-wrap mb-4">
            <button class="filter-tab active" onclick="filterNotifs('all', this)">All (@notifications.Count)</button>
            <button class="filter-tab" onclick="filterNotifs('unread', this)">Unread (@unreadCount)</button>
            <button class="filter-tab" onclick="filterNotifs('SupervisorApproval', this)">Supervisor</button>
            <button class="filter-tab" onclick="filterNotifs('MeetingUpdate', this)">Meetings</button>
            <button class="filter-tab" onclick="filterNotifs('DeadlineReminder', this)">Deadlines</button>
            <button class="filter-tab" onclick="filterNotifs('SubmissionFeedback', this)">Feedback</button>
        </div>

        @* ── Notifications List ───────────────────────────── *@
        @if (!notifications.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-bell-slash fs-1 d-block mb-3 opacity-30"></i>
                <p class="fw-semibold mb-0">No notifications yet.</p>
                <small>Notifications will appear here when there are updates.</small>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3" id="notifList">
                @foreach (var n in notifications)
                {
                    var iconCls = n.Type switch {
                        "SupervisorApproval" => "fas fa-user-check",
                        "MeetingUpdate"      => "fas fa-calendar-check",
                        "DeadlineReminder"   => "fas fa-clock",
                        "SubmissionFeedback" => "fas fa-comment-alt",
                        "RevisionRequest"    => "fas fa-edit",
                        "ExaminerAssignment" => "fas fa-user-tag",
                        _                   => "fas fa-bell"
                    };
                    var bgColor = n.Type switch {
                        "SupervisorApproval" => "#dcfce7",
                        "MeetingUpdate"      => "#dbeafe",
                        "DeadlineReminder"   => "#fee2e2",
                        "SubmissionFeedback" => "#ede9fe",
                        "RevisionRequest"    => "#fef3c7",
                        "ExaminerAssignment" => "#ffedd5",
                        _                   => "#f3f4f6"
                    };
                    var iconColor = n.Type switch {
                        "SupervisorApproval" => "#16a34a",
                        "MeetingUpdate"      => "#1d4ed8",
                        "DeadlineReminder"   => "#dc2626",
                        "SubmissionFeedback" => "#7c3aed",
                        "RevisionRequest"    => "#d97706",
                        "ExaminerAssignment" => "#ea580c",
                        _                   => "#6b7280"
                    };
                    var timeAgo = GetTimeAgo(n.CreatedDate);

                    var targetUrl = n.Type switch {
                        "ExaminerAssignment" => $"/Examiner/StudentDetails?projectId={n.RelatedRecordId}",
                        _                    => "#"
                    };

                    <div class="notif-item @(n.IsRead ? "" : "unread")"
                         data-type="@n.Type" data-read="@(n.IsRead ? "read" : "unread")">
                        <div class="d-flex align-items-start gap-3">
                            @if (!n.IsRead)
                            {
                                <div class="unread-dot"></div>
                            }
                            else
                            {
                                <div style="width:10px;flex-shrink:0;"></div>
                            }
                            <div class="notif-icon" style="background:@bgColor;color:@iconColor;">
                                <i class="@iconCls"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <a href="@targetUrl" class="text-decoration-none fw-bold text-dark stretched-link hover-orange">@n.Title</a>
                                    <small class="text-muted position-relative" style="z-index: 2;">@timeAgo</small>
                                </div>
                                @if (!string.IsNullOrEmpty(n.Message))
                                {
                                    <div class="text-muted mt-1" style="font-size:.85rem;">@n.Message</div>
                                }
                                <div class="mt-2 position-relative" style="z-index: 2;">
                                    <small class="text-muted me-3">@n.CreatedDate.ToString("dd MMM yyyy, h:mm tt")</small>
                                    @if (!n.IsRead)
                                    {
                                        <form asp-action="MarkAsRead" asp-controller="Student"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="notificationId" value="@n.Id" />
                                            <button type="submit" class="btn-read">
                                                <i class="fas fa-check me-1"></i> Mark Read
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <small class="text-success"><i class="fas fa-check me-1"></i>Read</small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section scripts {
<script>
    function filterNotifs(filter, btn) {
        document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');

        document.querySelectorAll('.notif-item').forEach(item => {
            if (filter === 'all') {
                item.style.display = '';
            } else if (filter === 'unread') {
                item.style.display = item.dataset.read === 'unread' ? '' : 'none';
            } else {
                item.style.display = item.dataset.type === filter ? '' : 'none';
            }
        });
    }
</script>
}

@functions {
    string GetTimeAgo(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 1)  return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 7)  return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("dd MMM yyyy");
    }
}


