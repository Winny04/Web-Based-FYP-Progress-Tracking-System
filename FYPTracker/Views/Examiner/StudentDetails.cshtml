@model FYPTracker.Models.FYPProject
@{
    ViewData["Title"] = "Evaluate Student";
    var meetingLogs = ViewBag.MeetingLogs as IEnumerable<FYPTracker.Models.MeetingLog>;
}

<div class="row gy-5 g-xl-8">
    <div class="col-xl-4">
        <!-- Project Details Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">Student Details</span>
                </h3>
            </div>
            <div class="card-body py-3">
                <div class="d-flex flex-column mb-8">
                    <span class="text-gray-400 fw-bold fs-7">Student Name</span>
                    <span class="text-dark fw-bolder fs-5">@Model.Student?.FullName</span>
                    <span class="text-gray-400 fw-bold fs-7 mt-1">@(Model.Student?.CoventryId ?? Model.Student?.EmployeeId ?? "N/A")</span>
                </div>
                <div class="d-flex flex-column mb-8">
                    <span class="text-gray-400 fw-bold fs-7">Project Title</span>
                    <span class="text-dark fw-bolder fs-5">@Model.Title</span>
                </div>
                <div class="d-flex flex-column mb-8">
                    <span class="text-gray-400 fw-bold fs-7">Supervisor</span>
                    <span class="text-dark fw-bolder fs-5">@Model.Supervisor?.FullName</span>
                </div>
            </div>
        </div>
        
        <!-- Viva Date Card (Read-only – set by Admin) -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1"><i class="fas fa-calendar-check text-success me-2"></i>Viva Schedule</span>
                </h3>
            </div>
            <div class="card-body py-3">
                @if (Model.VivaDate.HasValue)
                {
                    <div class="alert alert-success d-flex align-items-center p-4">
                        <i class="fas fa-calendar-alt fs-2 text-success me-3"></i>
                        <div>
                            <span class="fw-bolder d-block">Scheduled Viva</span>
                            <span class="fs-5 fw-bold text-success d-block">@Model.VivaDate.Value.ToString("dd MMMM yyyy, hh:mm tt")</span>
                            @if (!string.IsNullOrEmpty(Model.VivaVenue))
                            {
                                <span class="text-muted small mt-1 d-block"><i class="fas fa-map-marker-alt me-1"></i> Venue: @Model.VivaVenue</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning d-flex align-items-center p-4">
                        <i class="fas fa-clock fs-2 text-warning me-3"></i>
                        <div>
                            <span class="fw-bolder d-block">Not Yet Scheduled</span>
                            <span class="text-muted small">The Admin will schedule the Viva date. You will be notified by email and in-app notification.</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Evaluation Actions Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">Marksheet</span>
                </h3>
            </div>
            <div class="card-body py-3">
                <div class="mb-5 bg-light p-4 rounded">
                    <p class="text-muted fs-6 mb-3">
                        Student's submitted proposal/report files for your evaluation:
                    </p>
                    <h6 class="fw-bold fs-7 mb-2 text-dark">Student's Submitted Files:</h6>
                    @{
                        var stage1Milestone = FYPTracker.Utils.GradingHelper.GetStage1FinalMilestone(Model.Milestones);
                        if (stage1Milestone != null && stage1Milestone.SubmissionFiles != null && stage1Milestone.SubmissionFiles.Any(f => !f.IsDeleted))
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var file in stage1Milestone.SubmissionFiles.Where(f => !f.IsDeleted))
                                {
                                    <a href="@file.FilePath" class="btn btn-sm btn-outline-primary" target="_blank" download>
                                        <i class="fas fa-file-download me-1"></i> @file.FileName
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">No files submitted by student yet.</div>
                        }
                    }
                </div>
                
                <div class="separator mb-5"></div>
                
                <!-- Stage 1 Upload Section -->
                <div class="mb-5">
                    @{
                        var s1FinalMilestone = FYPTracker.Utils.GradingHelper.GetStage1FinalMilestone(Model.Milestones);
                        string exData = s1FinalMilestone?.ExaminerMarksheetData ?? "";
                        bool isExStage1Draft = FYPTracker.Utils.GradingHelper.IsMarksheetDraft(exData);
                        bool isExStage1Done = !string.IsNullOrEmpty(Model.Stage1ExaminerMarksheetPath) || (!string.IsNullOrEmpty(exData) && !isExStage1Draft);
                    }
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bolder text-dark mb-0">Stage 1 Proposal Assessment</h4>
                        @if (isExStage1Done)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold">
                                <i class="fas fa-check-circle me-1"></i> Stage 1 Evaluated
                            </span>
                        }
                        else if (isExStage1Draft)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-bold">
                                <i class="fas fa-edit me-1"></i> Draft Saved
                            </span>
                        }
                    </div>

                    <!-- Online Rubric Primary Grading Card -->
                    <div class="card border border-primary-subtle shadow-sm rounded-4 mb-4 bg-light-primary p-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">
                                    <i class="fas fa-clipboard-check text-primary me-2"></i>Stage 1 Online Rubric Evaluation
                                </h5>
                                <p class="text-muted small mb-0">
                                    Official 6-criterion proposal assessment with interactive criteria, qualitative feedback, and automatic grading.
                                </p>
                            </div>
                            <a href="@Url.Action("GradeMarksheetStage1", "Examiner", new { id = Model.Id })" class="btn btn-primary px-4 py-2 fw-bold text-nowrap shadow-sm">
                                <i class="fas @(isExStage1Done ? "fa-eye" : (isExStage1Draft ? "fa-pencil-alt" : "fa-edit")) me-2"></i>
                                @(isExStage1Done ? "View / Update Stage 1 Assessment" : (isExStage1Draft ? "Continue Draft Evaluation" : "Grade Stage 1 Rubric"))
                            </a>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Stage1ExaminerMarksheetPath))
                    {
                        <div class="alert alert-success mt-3 p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex flex-column">
                                <h4 class="fw-bolder text-dark mb-1">Stage 1 Marksheet Uploaded</h4>
                                <span><a href="@Model.Stage1ExaminerMarksheetPath" target="_blank" class="fw-bold text-success">Download your uploaded file</a></span>
                                <span class="text-dark mt-1">Total Score extracted: <strong>@(Model.Stage1TotalScore?.ToString() ?? "N/A")</strong></span>
                            </div>
                            <i class="bi bi-check-circle-fill fs-1 text-success"></i>
                        </div>
                    }
                    
                    @{
                            var interim = Model.Milestones?.FirstOrDefault(m => m.Title.Contains("Stage 1 Final Submission"));
                            string exStrengths = "", exImprovements = "", exComments = "";
                            if (interim != null && !string.IsNullOrEmpty(interim.ExaminerMarksheetData) && interim.ExaminerMarksheetData.StartsWith("{"))
                            {
                                using var doc = System.Text.Json.JsonDocument.Parse(interim.ExaminerMarksheetData);
                                if (doc.RootElement.TryGetProperty("Strengths", out var sProp)) exStrengths = sProp.GetString();
                                if (doc.RootElement.TryGetProperty("Improvements", out var iProp)) exImprovements = iProp.GetString();
                                if (doc.RootElement.TryGetProperty("Comments", out var cProp)) exComments = cProp.GetString();
                            }
                        }
                        
                        @if (!string.IsNullOrEmpty(exStrengths) || !string.IsNullOrEmpty(exImprovements) || !string.IsNullOrEmpty(exComments))
                        {
                            <!-- Extracted Feedback -->
                            <div class="mt-4">
                                <h5 class="fw-bolder text-dark mb-3">Extracted Feedback</h5>
                                
                                @if (!string.IsNullOrEmpty(exStrengths))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Strengths of Report</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@exStrengths</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(exImprovements))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Areas for Improvement</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@exImprovements</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(exComments))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Additional Comments</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@exComments</div>
                                    </div>
                                }
                            </div>
                        }
                </div>

                <div class="separator mb-5"></div>
                
                <!-- Stage 2 Section -->
                <div class="mb-5">
                    <h4 class="fw-bolder text-dark mb-4 mt-2">Stage 2: Final Assessment</h4>
                    @{
                        var stage2Milestones = Model.Milestones
                            .Where(m => m.Title.StartsWith("Step", StringComparison.OrdinalIgnoreCase) && !m.Title.StartsWith("Step -", StringComparison.OrdinalIgnoreCase))
                            .ToList();
                        bool isAllStage2Approved = stage2Milestones.Any() && stage2Milestones.All(m => m.Status == "Approved" || m.Status == "Completed");
                    }

                    @if (isAllStage2Approved)
                    {
                        <a href="@Url.Action("GradeMarksheetStage2", "Examiner", new { id = Model.Id })" class="btn btn-success w-100 py-3 shadow-sm mb-3">
                            <i class="fas fa-clipboard-check fs-4 me-2"></i> @(string.IsNullOrEmpty(Model.Stage2ExaminerMarksheetData) ? "Grade Stage 2 Final Marksheet" : "View / Update Stage 2 Final Assessment")
                        </a>
                        
                        {
                            double? exStage2Score = FYPTracker.Utils.GradingHelper.CalculateStage2Score(Model.Stage2ExaminerMarksheetData, "Examiner");
                            double? supStage2Score = FYPTracker.Utils.GradingHelper.CalculateStage2Score(Model.Stage2SupervisorMarksheetData, "Supervisor");
                            double? jointStage2Score = FYPTracker.Utils.GradingHelper.CalculateJointFinalPercentage(supStage2Score, exStage2Score);
                            bool isExDone = exStage2Score.HasValue;
                            bool isSupDone = supStage2Score.HasValue;
                            bool isJointReleased = isExDone && isSupDone && !string.IsNullOrEmpty(Model.FinalGrade);
                        
                            if (isExDone || isSupDone)
                            {
                            <div class="card border-0 shadow-sm rounded-3 mb-3 bg-light">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-dark fs-7"><i class="fas fa-balance-scale text-primary me-1"></i> Stage 2 Assessment Overview</span>
                                        @if (isJointReleased)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                                <i class="fas fa-check-double me-1"></i> Graded & Joint Released
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">
                                                <i class="fas fa-clock me-1"></i> Awaiting Joint Calculation
                                            </span>
                                        }
                                    </div>
                                    <div class="row g-2 text-center">
                                        <div class="col-4">
                                            <div class="p-2 bg-white rounded border">
                                                <small class="text-muted d-block" style="font-size: 0.72rem;">Your Score</small>
                                                <span class="fw-bold @(isExDone ? "text-primary" : "text-muted")">@(isExDone ? exStage2Score.Value.ToString("F2") + "%" : "Pending")</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 bg-white rounded border">
                                                <small class="text-muted d-block" style="font-size: 0.72rem;">Supervisor</small>
                                                <span class="fw-bold @(isSupDone ? "text-success" : "text-muted")">@(isSupDone ? supStage2Score.Value.ToString("F2") + "%" : "Pending")</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 bg-white rounded border">
                                                <small class="text-muted d-block" style="font-size: 0.72rem;">Joint Score</small>
                                                <span class="fw-bold @(isJointReleased ? "text-success" : "text-muted")">@(isJointReleased && jointStage2Score.HasValue ? jointStage2Score.Value.ToString("F2") + "% (" + Model.FinalGrade + ")" : "Pending")</span>
                                            </div>
                                        </div>
                                    </div>
                                    @if (isExDone && !isSupDone)
                                    {
                                        <div class="small text-muted mt-2 text-center">
                                            <i class="fas fa-info-circle me-1 text-primary"></i> Waiting for Supervisor to submit their marks for the final joint calculation.
                                        </div>
                                    }
                                </div>
                            </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning d-flex align-items-center p-4">
                            <i class="bi bi-exclamation-triangle fs-2 text-warning me-3"></i>
                            <div class="d-flex flex-column">
                                <h4 class="fw-bolder text-dark mb-1">Evaluation Locked</h4>
                                <span class="text-dark">The supervisor must approve all Stage 2 milestones before you can grade the Stage 2 final evaluation rubric.</span>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ExaminerMarksheetPath))
                    {
                        <div class="alert alert-success mt-3 p-3 d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                            <div class="d-flex flex-column">
                                <span class="fw-bolder">Historical Marksheet File</span>
                                <a href="@Model.ExaminerMarksheetPath" target="_blank" class="text-hover-primary text-decoration-underline text-success fw-bold">View Archive File</a>
                            </div>
                        </div>
                    }      
                    @if (!string.IsNullOrEmpty(Model.FinalGrade))
                    {
                        <div class="alert alert-primary mt-3 p-3 d-flex align-items-center">
                            <i class="bi bi-award-fill text-primary fs-3 me-3"></i>
                            <div class="d-flex flex-column">
                                <span class="fw-bolder fs-6">Auto-Graded Result</span>
                                <span class="text-dark fs-4 fw-bold">Final Grade: <span class="text-primary">@Model.FinalGrade</span></span>
                            </div>
                        </div>
                        
                        <!-- Extracted Feedback -->
                        <div class="mt-4">
                            <h5 class="fw-bolder text-dark mb-3">Extracted Feedback</h5>
                            
                            @if (!string.IsNullOrEmpty(Model.ExaminerStrengths))
                            {
                                <div class="mb-3">
                                    <h6 class="text-gray-800 fw-bold mb-1">Strengths of Report</h6>
                                    <div class="p-2 bg-light rounded text-gray-700 fs-7">@Model.ExaminerStrengths</div>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.ExaminerImprovements))
                            {
                                <div class="mb-3">
                                    <h6 class="text-gray-800 fw-bold mb-1">Areas for Improvement</h6>
                                    <div class="p-2 bg-light rounded text-gray-700 fs-7">@Model.ExaminerImprovements</div>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.ExaminerComments))
                            {
                                <div class="mb-3">
                                    <h6 class="text-gray-800 fw-bold mb-1">Additional Comments</h6>
                                    <div class="p-2 bg-light rounded text-gray-700 fs-7">@Model.ExaminerComments</div>
                                </div>
                            }
                        </div>
                    }
                </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <!-- Milestones Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">Milestones & Reports</span>
                </h3>
            </div>
            <div class="card-body py-3">
                @{
                    var stage1Milestones = Model.Milestones
                        .Where(m => m.Title.Contains("IAF") || m.Title.Contains("Stage 1 Final Submission"))
                        .OrderBy(m => m.DueDate ?? m.CreatedDate)
                        .ToList();
                    bool isAllStage1Approved = stage1Milestones.Count >= 2 && stage1Milestones.All(m => m.Status == "Approved" || m.Status == "Completed");
                    var finalStage1Milestone = stage1Milestones.FirstOrDefault(m => m.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase));
                }

                @if(stage1Milestones.Any())
                {
                    <h4 class="fw-bolder text-dark mb-4 mt-2">Stage 1 Milestones</h4>
                    <div class="table-responsive mb-8">
                        <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                            <thead>
                                <tr class="fw-bolder text-muted">
                                    <th class="min-w-150px">Milestone</th>
                                    <th class="min-w-100px">Status</th>
                                    <th class="min-w-100px">Date Submitted</th>
                                    <th class="min-w-100px text-end">Files</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var milestone in stage1Milestones)
                                {
                                    <tr>
                                        <td><span class="text-dark fw-bolder fs-6">@milestone.Title</span></td>
                                        <td>
                                            @{
                                                var badgeClass = "badge-light-primary";
                                                if (milestone.Status == "Approved" || milestone.Status == "Completed") badgeClass = "badge-light-success";
                                                if (milestone.Status == "Rejected") badgeClass = "badge-light-danger";
                                                if (milestone.Status == "Pending") badgeClass = "badge-light-warning";
                                            }
                                            <span class="badge @badgeClass">@milestone.Status</span>
                                        </td>
                                        <td>@milestone.SubmittedDate?.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">

                                            @{
                                                var activeFiles = milestone.SubmissionFiles?.Where(f => !f.IsDeleted && f.UploadedBy == Model.StudentId).ToList();
                                                var maxAttempt = activeFiles?.Any() == true ? activeFiles.Max(f => f.AttemptNumber) : 1;
                                                var latestFiles = activeFiles?.Where(f => f.AttemptNumber == maxAttempt).OrderByDescending(f => f.UploadedDate).ToList();
                                            }
                                            @if(latestFiles != null && latestFiles.Any())
                                            {
                                                @foreach(var file in latestFiles)
                                                {
                                                    <a href="@file.FilePath" class="btn btn-sm btn-light btn-active-light-primary me-2 mb-2 d-inline-flex align-items-center" target="_blank" title="Download @file.FileName">
                                                        <i class="bi bi-file-earmark-arrow-down fs-4 me-2"></i> @file.FileName
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-7">No files</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if(stage2Milestones.Any())
                {
                    <h4 class="fw-bolder text-dark mb-4">Stage 2 Milestones</h4>
                    <div class="table-responsive">
                        <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                            <thead>
                                <tr class="fw-bolder text-muted">
                                    <th class="min-w-150px">Milestone</th>
                                    <th class="min-w-100px">Status</th>
                                    <th class="min-w-100px">Date Submitted</th>
                                    <th class="min-w-100px text-end">Files</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var milestone in stage2Milestones)
                                {
                                    <tr>
                                        <td><span class="text-dark fw-bolder fs-6">@milestone.Title</span></td>
                                        <td>
                                            @{
                                                var badgeClass = "badge-light-primary";
                                                if (milestone.Status == "Approved" || milestone.Status == "Completed") badgeClass = "badge-light-success";
                                                if (milestone.Status == "Rejected") badgeClass = "badge-light-danger";
                                                if (milestone.Status == "Pending") badgeClass = "badge-light-warning";
                                            }
                                            <span class="badge @badgeClass">@milestone.Status</span>
                                        </td>
                                        <td>@milestone.SubmittedDate?.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">


                                            @{
                                                var activeFiles = milestone.SubmissionFiles?.Where(f => !f.IsDeleted && f.UploadedBy == Model.StudentId).ToList();
                                                var latestFile = activeFiles?.OrderByDescending(f => f.UploadedDate).FirstOrDefault();
                                            }
                                            @if(latestFile != null)
                                            {
                                                <a href="@latestFile.FilePath" class="btn btn-sm btn-light btn-active-light-primary me-2 mb-2 d-inline-flex align-items-center" target="_blank" title="Download @latestFile.FileName">
                                                    <i class="bi bi-file-earmark-arrow-down fs-4 me-2"></i> @latestFile.FileName
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-7">No files</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Meeting Logs Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">Weekly Meeting Logs</span>
                </h3>
            </div>
            <div class="card-body py-3">
                <div class="table-responsive">
                    <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <thead>
                            <tr class="fw-bolder text-muted bg-light">
                                <th class="ps-4 min-w-80px rounded-start">Week</th>
                                <th class="min-w-140px">Date & Time</th>
                                <th class="min-w-160px">Key Topics Discussed</th>
                                <th class="min-w-160px">Action Points</th>
                                <th class="min-w-160px">Completed Actions</th>
                                <th class="min-w-180px">Supervisor Feedback</th>
                                <th class="min-w-120px text-center">Status</th>
                                <th class="min-w-120px text-end pe-4 rounded-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.MeetingBookings != null && ((IEnumerable<dynamic>)ViewBag.MeetingBookings).Any())
                            {
                                foreach (var booking in ViewBag.MeetingBookings)
                                {
                                    var log = booking.MeetingLog as FYPTracker.Models.MeetingLog;
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-bolder text-dark">Week @(booking.WeekNumber ?? 0)</span>
                                            <div class="text-muted fs-8">Stage @(booking.Stage ?? 1)</div>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">@booking.MeetingDate.ToString("dd MMM yyyy")</span><br/>
                                            <span class="text-muted fs-7">@booking.MeetingTime</span>
                                        </td>
                                        
                                        @if (log != null)
                                        {
                                            <td>
                                                <div class="text-dark fs-7" style="max-width: 220px; word-break: break-word;">
                                                    @(string.IsNullOrWhiteSpace(log.KeyTopicsDiscussed) ? "-" : log.KeyTopicsDiscussed)
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-dark fs-7" style="max-width: 220px; word-break: break-word;">
                                                    @(string.IsNullOrWhiteSpace(log.ActionPointsForNextMeeting) ? "-" : log.ActionPointsForNextMeeting)
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-dark fs-7" style="max-width: 220px; word-break: break-word;">
                                                    @(string.IsNullOrWhiteSpace(log.CompletedActionsAndNotes) ? "-" : log.CompletedActionsAndNotes)
                                                </div>
                                            </td>
                                            <td>
                                                @{
                                                    string cleanFeedback = log.DisplayComments?.Trim() ?? "";
                                                    if (cleanFeedback.StartsWith("data:image", StringComparison.OrdinalIgnoreCase) ||
                                                        cleanFeedback.StartsWith("data:application", StringComparison.OrdinalIgnoreCase) ||
                                                        (cleanFeedback.Length > 100 && !cleanFeedback.Contains(" ") && !cleanFeedback.Contains(".")) ||
                                                        cleanFeedback.Contains("base64,", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        cleanFeedback = "";
                                                    }
                                                }
                                                <div class="text-dark fs-7" style="max-width: 220px; word-break: break-word;">
                                                    @if (!string.IsNullOrWhiteSpace(cleanFeedback))
                                                    {
                                                        <span>@cleanFeedback</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted fst-italic">No feedback provided</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                @if (log.LogStatus == "Signed")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold">
                                                        <i class="fas fa-check-circle me-1"></i> Signed
                                                    </span>
                                                }
                                                else if (log.LogStatus == "Submitted")
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-bold">
                                                        <i class="fas fa-clock me-1"></i> Submitted
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-bold">
                                                        <i class="fas fa-pencil-alt me-1"></i> Draft
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                @if (log.LogStatus == "Signed")
                                                {
                                                    <a href="@Url.Action("ViewMeetingLog", "Examiner", new { id = log.Id })" target="_blank" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center" title="View Digital Record of Supervisor Meeting PDF">
                                                        <i class="fas fa-file-pdf me-1"></i> View PDF
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small fst-italic">Not Available</span>
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            <td colspan="3" class="text-muted fst-italic">Logbook not created yet</td>
                                            <td><span class="text-muted fst-italic">No feedback provided</span></td>
                                            <td class="text-center"><span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">Not Created</span></td>
                                            <td class="text-end pe-4"><span class="text-muted small fst-italic">Not Available</span></td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-5">
                                        No meeting logs found for this project.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({
                    text: "@TempData["Success"]",
                    icon: "success",
                    buttonsStyling: false,
                    confirmButtonText: "Ok, got it!",
                    customClass: {
                        confirmButton: "btn btn-primary"
                    }
                });
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                    text: "@TempData["Error"]",
                    icon: "error",
                    buttonsStyling: false,
                    confirmButtonText: "Ok, got it!",
                    customClass: {
                        confirmButton: "btn btn-danger"
                    }
                });
                </text>
            }
        });
    </script>
}
