@model FYPTracker.Models.FYPProject
@{
    ViewData["Title"] = "Evaluate Student";
    var meetingLogs = ViewBag.MeetingLogs as IEnumerable<FYPTracker.Models.MeetingLog>;
}

<div class="row gy-5 g-xl-8">
    <div class="col-xl-4">
        <!-- Project Details Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">Student Details</span>
                </h3>
            </div>
            <div class="card-body py-3">
                <div class="d-flex flex-column mb-8">
                    <span class="text-gray-400 fw-bold fs-7">Student Name</span>
                    <span class="text-dark fw-bolder fs-5">@Model.Student?.FullName</span>
                    <span class="text-gray-400 fw-bold fs-7 mt-1">@Model.Student?.EmployeeId</span>
                </div>
                <div class="d-flex flex-column mb-8">
                    <span class="text-gray-400 fw-bold fs-7">Project Title</span>
                    <span class="text-dark fw-bolder fs-5">@Model.Title</span>
                </div>
                <div class="d-flex flex-column mb-8">
                    <span class="text-gray-400 fw-bold fs-7">Supervisor</span>
                    <span class="text-dark fw-bolder fs-5">@Model.Supervisor?.FullName</span>
                </div>
            </div>
        </div>
        
        <!-- Schedule Viva Date Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1"><i class="fas fa-calendar-check text-success me-2"></i>Schedule Viva Date</span>
                </h3>
            </div>
            <div class="card-body py-3">
                @if (Model.VivaDate.HasValue)
                {
                    <div class="alert alert-success d-flex align-items-center p-4 mb-4">
                        <i class="fas fa-calendar-alt fs-2 text-success me-3"></i>
                        <div>
                            <span class="fw-bolder d-block">Current Viva Date</span>
                            <span class="fs-5 fw-bold text-success">@Model.VivaDate.Value.ToString("dd MMMM yyyy, hh:mm tt")</span>
                        </div>
                    </div>
                }
                <form action="/Examiner/SetVivaDate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">
                            @(Model.VivaDate.HasValue ? "Change Viva Date & Time" : "Set Viva Date & Time")
                        </label>
                        <input type="datetime-local"
                               name="vivaDate"
                               class="form-control form-control-solid form-control-lg border-success"
                               value="@(Model.VivaDate?.ToString("yyyy-MM-ddTHH:mm"))"
                               required />
                        <div class="form-text text-muted mt-2">
                            <i class="fas fa-info-circle me-1"></i>
                            The student and supervisor will be notified by email and in-app notification.
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-calendar-check me-2"></i>
                        @(Model.VivaDate.HasValue ? "Update Viva Date" : "Schedule Viva")
                    </button>
                </form>
            </div>
        </div>

        <!-- Evaluation Actions Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">Marksheet</span>
                </h3>
            </div>
            <div class="card-body py-3">
                <div class="mb-5">
                    <p class="text-muted fs-6">
                        Please download the marksheet template (once provided in the project folder), fill it out, and upload it back here.
                    </p>
                    <a href="/Examiner/DownloadMarksheet?projectId=@Model.Id" class="btn btn-primary w-100 mb-3">
                        <i class="bi bi-download fs-4 me-2"></i> Download Template
                    </a>
                </div>
                
                <div class="separator mb-5"></div>
                
                <!-- Stage 1 Upload Section -->
                <div class="mb-5">
                    <h4 class="fw-bolder text-dark mb-4 mt-2">Stage 1: Proposal</h4>
                    @if (Model.Stage1MarksheetUploadCount >= 5)
                    {
                        <div class="alert alert-danger d-flex align-items-center p-4">
                            <i class="bi bi-x-circle fs-2 text-danger me-3"></i>
                            <div class="d-flex flex-column">
                                <h4 class="fw-bolder text-dark mb-1">Limit Reached</h4>
                                <span class="text-dark">You have reached the maximum of 5 marksheet uploads for Stage 1.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form action="/Examiner/UploadMarksheetStage1" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="projectId" value="@Model.Id" />
                            <input type="hidden" name="idempotencyToken" value="@ViewBag.IdempotencyToken" />
                            
                            <div class="mb-3">
                                <label for="marksheetFile1" class="form-label">Upload Completed Stage 1 Marksheet (Excel)</label>
                                <input class="form-control" type="file" id="marksheetFile1" name="marksheetFile" accept=".xls,.xlsx" required>
                                <div class="form-text text-muted">
                                    You can upload a new marksheet up to 5 times. 
                                    <strong class="@(Model.Stage1MarksheetUploadCount >= 4 ? "text-danger" : "text-primary")">
                                        @(5 - Model.Stage1MarksheetUploadCount) attempt(s) remaining.
                                    </strong>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-upload fs-4 me-2"></i> Submit Stage 1 Marksheet
                            </button>
                        </form>
                    }

                    @if (!string.IsNullOrEmpty(Model.Stage1ExaminerMarksheetPath))
                    {
                        <div class="alert alert-success mt-3 p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex flex-column">
                                <h4 class="fw-bolder text-dark mb-1">Stage 1 Marksheet Uploaded</h4>
                                <span><a href="@Model.Stage1ExaminerMarksheetPath" target="_blank" class="fw-bold text-success">Download your uploaded file</a></span>
                                <span class="text-dark mt-1">Total Score extracted: <strong>@(Model.Stage1TotalScore?.ToString() ?? "N/A")</strong></span>
                            </div>
                            <i class="bi bi-check-circle-fill fs-1 text-success"></i>
                        </div>
                    }
                    
                    @{
                            var interim = Model.Milestones?.FirstOrDefault(m => m.Title.Contains("Proposal"));
                            string exStrengths = "", exImprovements = "", exComments = "";
                            if (interim != null && !string.IsNullOrEmpty(interim.ExaminerMarksheetData) && interim.ExaminerMarksheetData.StartsWith("{"))
                            {
                                using var doc = System.Text.Json.JsonDocument.Parse(interim.ExaminerMarksheetData);
                                if (doc.RootElement.TryGetProperty("Strengths", out var sProp)) exStrengths = sProp.GetString();
                                if (doc.RootElement.TryGetProperty("Improvements", out var iProp)) exImprovements = iProp.GetString();
                                if (doc.RootElement.TryGetProperty("Comments", out var cProp)) exComments = cProp.GetString();
                            }
                        }
                        
                        @if (!string.IsNullOrEmpty(exStrengths) || !string.IsNullOrEmpty(exImprovements) || !string.IsNullOrEmpty(exComments))
                        {
                            <!-- Extracted Feedback -->
                            <div class="mt-4">
                                <h5 class="fw-bolder text-dark mb-3">Extracted Feedback</h5>
                                
                                @if (!string.IsNullOrEmpty(exStrengths))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Strengths of Report</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@exStrengths</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(exImprovements))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Areas for Improvement</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@exImprovements</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(exComments))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Additional Comments</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@exComments</div>
                                    </div>
                                }
                            </div>
                        }
                </div>

                <div class="separator mb-5"></div>
                
                <!-- Stage 2 Upload Section -->
                <div class="mb-5">
                    <h4 class="fw-bolder text-dark mb-4 mt-2">Stage 2: Final Assessment</h4>
                    @{
                        var stage2Milestones = Model.Milestones
                            .Where(m => m.Title.StartsWith("Step", StringComparison.OrdinalIgnoreCase) && !m.Title.StartsWith("Step -", StringComparison.OrdinalIgnoreCase))
                            .ToList();
                        bool isAllStage2Approved = stage2Milestones.Any() && stage2Milestones.All(m => m.Status == "Approved" || m.Status == "Completed");
                    }

                    @if (isAllStage2Approved)
                    {
                        if (Model.MarksheetUploadCount >= 5)
                        {
                            <div class="alert alert-danger d-flex align-items-center p-4">
                                <i class="bi bi-x-circle fs-2 text-danger me-3"></i>
                                <div class="d-flex flex-column">
                                    <h4 class="fw-bolder text-dark mb-1">Limit Reached</h4>
                                    <span class="text-dark">You have reached the maximum of 5 marksheet uploads for Stage 2.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <form action="/Examiner/UploadMarksheet" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="projectId" value="@Model.Id" />
                                <input type="hidden" name="idempotencyToken" value="@ViewBag.IdempotencyToken" />
                                
                                <div class="mb-3">
                                    <label for="marksheetFile" class="form-label">Upload Completed Stage 2 Marksheet (Excel)</label>
                                    <input class="form-control" type="file" id="marksheetFile" name="marksheetFile" accept=".xls,.xlsx" required>
                                    <div class="form-text text-muted">
                                        You can upload a new marksheet up to 5 times. 
                                        <strong class="@(Model.MarksheetUploadCount >= 4 ? "text-danger" : "text-primary")">
                                            @(5 - Model.MarksheetUploadCount) attempt(s) remaining.
                                        </strong>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-upload fs-4 me-2"></i> Submit Stage 2 Marksheet
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning d-flex align-items-center p-4">
                            <i class="bi bi-exclamation-triangle fs-2 text-warning me-3"></i>
                            <div class="d-flex flex-column">
                                <h4 class="fw-bolder text-dark mb-1">Upload Locked</h4>
                                <span class="text-dark">The supervisor must approve ALL Stage 2 milestones before you can submit the final Excel marksheet.</span>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ExaminerMarksheetPath))
                    {
                        <div class="alert alert-success mt-3 p-3 d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                            <div class="d-flex flex-column">
                                <span class="fw-bolder">Stage 2 Evaluation Submitted</span>
                                <a href="@Model.ExaminerMarksheetPath" target="_blank" class="text-hover-primary text-decoration-underline text-success fw-bold">View Uploaded File</a>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.FinalGrade))
                        {
                            <div class="alert alert-primary mt-3 p-3 d-flex align-items-center">
                                <i class="bi bi-award-fill text-primary fs-3 me-3"></i>
                                <div class="d-flex flex-column">
                                    <span class="fw-bolder fs-6">Auto-Graded Result</span>
                                    <span class="text-dark fs-4 fw-bold">Final Grade: <span class="text-primary">@Model.FinalGrade</span></span>
                                </div>
                            </div>
                            
                            <!-- Extracted Feedback -->
                            <div class="mt-4">
                                <h5 class="fw-bolder text-dark mb-3">Extracted Feedback</h5>
                                
                                @if (!string.IsNullOrEmpty(Model.ExaminerStrengths))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Strengths of Report</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@Model.ExaminerStrengths</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.ExaminerImprovements))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Areas for Improvement</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@Model.ExaminerImprovements</div>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.ExaminerComments))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-gray-800 fw-bold mb-1">Additional Comments</h6>
                                        <div class="p-2 bg-light rounded text-gray-700 fs-7">@Model.ExaminerComments</div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <!-- Milestones Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">Milestones & Reports</span>
                </h3>
            </div>
            <div class="card-body py-3">
                @{
                    var stage1Milestones = Model.Milestones
                        .Where(m => m.Title.Contains("IAF") || m.Title.Contains("Proposal"))
                        .OrderBy(m => m.DueDate ?? m.CreatedDate)
                        .ToList();
                    bool isAllStage1Approved = stage1Milestones.Count >= 2 && stage1Milestones.All(m => m.Status == "Approved" || m.Status == "Completed");
                    var finalStage1Milestone = stage1Milestones.FirstOrDefault(m => m.Title.Contains("Proposal", StringComparison.OrdinalIgnoreCase));
                }

                @if(stage1Milestones.Any())
                {
                    <h4 class="fw-bolder text-dark mb-4 mt-2">Stage 1 Milestones</h4>
                    <div class="table-responsive mb-8">
                        <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                            <thead>
                                <tr class="fw-bolder text-muted">
                                    <th class="min-w-150px">Milestone</th>
                                    <th class="min-w-100px">Status</th>
                                    <th class="min-w-100px">Date Submitted</th>
                                    <th class="min-w-100px text-end">Files</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var milestone in stage1Milestones)
                                {
                                    <tr>
                                        <td><span class="text-dark fw-bolder fs-6">@milestone.Title</span></td>
                                        <td>
                                            @{
                                                var badgeClass = "badge-light-primary";
                                                if (milestone.Status == "Approved" || milestone.Status == "Completed") badgeClass = "badge-light-success";
                                                if (milestone.Status == "Rejected") badgeClass = "badge-light-danger";
                                                if (milestone.Status == "Pending") badgeClass = "badge-light-warning";
                                            }
                                            <span class="badge @badgeClass">@milestone.Status</span>
                                        </td>
                                        <td>@milestone.SubmittedDate?.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">

                                            @{
                                                var activeFiles = milestone.SubmissionFiles?.Where(f => !f.IsDeleted && f.UploadedBy == Model.StudentId).ToList();
                                                var maxAttempt = activeFiles?.Any() == true ? activeFiles.Max(f => f.AttemptNumber) : 1;
                                                var latestFiles = activeFiles?.Where(f => f.AttemptNumber == maxAttempt).OrderByDescending(f => f.UploadedDate).ToList();
                                            }
                                            @if(latestFiles != null && latestFiles.Any())
                                            {
                                                @foreach(var file in latestFiles)
                                                {
                                                    <a href="@file.FilePath" class="btn btn-sm btn-light btn-active-light-primary me-2 mb-2 d-inline-flex align-items-center" target="_blank" title="Download @file.FileName">
                                                        <i class="bi bi-file-earmark-arrow-down fs-4 me-2"></i> @file.FileName
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-7">No files</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if(stage2Milestones.Any())
                {
                    <h4 class="fw-bolder text-dark mb-4">Stage 2 Milestones</h4>
                    <div class="table-responsive">
                        <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                            <thead>
                                <tr class="fw-bolder text-muted">
                                    <th class="min-w-150px">Milestone</th>
                                    <th class="min-w-100px">Status</th>
                                    <th class="min-w-100px">Date Submitted</th>
                                    <th class="min-w-100px text-end">Files</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var milestone in stage2Milestones)
                                {
                                    <tr>
                                        <td><span class="text-dark fw-bolder fs-6">@milestone.Title</span></td>
                                        <td>
                                            @{
                                                var badgeClass = "badge-light-primary";
                                                if (milestone.Status == "Approved" || milestone.Status == "Completed") badgeClass = "badge-light-success";
                                                if (milestone.Status == "Rejected") badgeClass = "badge-light-danger";
                                                if (milestone.Status == "Pending") badgeClass = "badge-light-warning";
                                            }
                                            <span class="badge @badgeClass">@milestone.Status</span>
                                        </td>
                                        <td>@milestone.SubmittedDate?.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">


                                            @{
                                                var activeFiles = milestone.SubmissionFiles?.Where(f => !f.IsDeleted && f.UploadedBy == Model.StudentId).ToList();
                                                var latestFile = activeFiles?.OrderByDescending(f => f.UploadedDate).FirstOrDefault();
                                            }
                                            @if(latestFile != null)
                                            {
                                                <a href="@latestFile.FilePath" class="btn btn-sm btn-light btn-active-light-primary me-2 mb-2 d-inline-flex align-items-center" target="_blank" title="Download @latestFile.FileName">
                                                    <i class="bi bi-file-earmark-arrow-down fs-4 me-2"></i> @latestFile.FileName
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-7">No files</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Meeting Logs Card -->
        <div class="card mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">Weekly Meeting Logs</span>
                </h3>
            </div>
            <div class="card-body py-3">
                <div class="table-responsive">
                    <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <thead>
                            <tr class="fw-bolder text-muted">
                                <th class="min-w-100px">Date</th>
                                <th class="min-w-200px">Topics Discussed</th>
                                <th class="min-w-150px">Supervisor Comments</th>
                                <th class="min-w-100px text-end">Logbook</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(meetingLogs != null && meetingLogs.Any())
                            {
                                foreach(var log in meetingLogs)
                                {
                                    <tr>
                                        <td>@log.CreatedDate.ToString("dd MMM yyyy")</td>
                                        <td>@log.KeyTopicsDiscussed</td>
                                        <td>@log.SupervisorComments</td>
                                        <td class="text-end">
                                            @if(!string.IsNullOrEmpty(log.PdfLogbookPath))
                                            {
                                                <a href="@log.PdfLogbookPath" class="btn btn-sm btn-icon btn-light btn-active-light-primary" target="_blank">
                                                    <i class="bi bi-file-pdf fs-4"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        No meeting logs found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({
                    text: "@TempData["Success"]",
                    icon: "success",
                    buttonsStyling: false,
                    confirmButtonText: "Ok, got it!",
                    customClass: {
                        confirmButton: "btn btn-primary"
                    }
                });
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                    text: "@TempData["Error"]",
                    icon: "error",
                    buttonsStyling: false,
                    confirmButtonText: "Ok, got it!",
                    customClass: {
                        confirmButton: "btn btn-danger"
                    }
                });
                </text>
            }
        });
    </script>
}
