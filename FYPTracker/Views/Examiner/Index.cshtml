@model IEnumerable<FYPTracker.Models.FYPProject>
@{
    ViewData["Title"] = "Examiner Dashboard";
}

<div class="card mb-5 mb-xl-8">
    <div class="card-header border-0 pt-5 d-flex justify-content-between align-items-center">
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bolder fs-3 mb-1">Assigned Projects</span>
            <span class="text-muted mt-1 fw-bold fs-7">Manage and evaluate your assigned student projects</span>
        </h3>
        <div class="d-flex align-items-center position-relative my-1">
            <span class="svg-icon svg-icon-1 position-absolute ms-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                </svg>
            </span>
            <input type="text" id="searchBar" class="form-control form-control-solid w-250px ps-15" placeholder="Search projects" />
        </div>
    </div>
    
    <div class="card-body py-3">
        <!-- Tabs -->
        <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x mb-5 fs-5 fw-bold" id="projectTabs">
            <li class="nav-item">
                <a class="nav-link active text-primary" style="cursor:pointer;" data-bs-toggle="tab" onclick="filterTable(event, '')">All Projects</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted" style="cursor:pointer;" data-bs-toggle="tab" onclick="filterTable(event, 'Pending')">Pending</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted" style="cursor:pointer;" data-bs-toggle="tab" onclick="filterTable(event, 'Graded')">Graded (Past)</a>
            </li>
        </ul>

        <div class="table-responsive">
            <table id="projectsTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted bg-light">
                        <th class="ps-4 min-w-200px rounded-start">Project Title</th>
                        <th class="min-w-150px">Student</th>
                        <th class="min-w-150px">Supervisor</th>
                        <th class="min-w-100px">Status</th>
                        <th class="min-w-100px">Grade</th>
                        <th class="min-w-100px text-end rounded-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var project in Model)
                        {
                            var hasGraded = !string.IsNullOrEmpty(project.ExaminerMarksheetPath) || !string.IsNullOrEmpty(project.FinalGrade);
                            var statusText = hasGraded ? "Graded" : "Pending";
                            var badgeClass = hasGraded ? "badge-light-success" : "badge-light-warning";
                            
                            <tr>
                                <td class="ps-4">
                                    <span class="text-dark fw-bolder text-hover-primary mb-1 fs-6">@project.Title</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bolder d-block mb-1 fs-6">@project.Student?.FullName</span>
                                    <span class="text-muted fw-bold text-muted d-block fs-7">@project.Student?.EmployeeId</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bolder d-block mb-1 fs-6">@project.Supervisor?.FullName</span>
                                </td>
                                <td>
                                    <span class="badge @badgeClass fs-7 fw-bold">@statusText</span>
                                </td>
                                <td>
                                    @if(hasGraded) {
                                        <span class="text-dark fw-bold">@(project.FinalGrade ?? "Uploaded")</span>
                                    } else {
                                        <span class="text-muted fw-bold">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Examiner/StudentDetails?projectId=@project.Id" class="btn btn-bg-light btn-color-muted btn-active-color-primary btn-sm px-4">
                                        Evaluate
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#projectsTable').DataTable({
                "info": true,
                "order": [],
                "pageLength": 10,
                "lengthChange": false,
                "dom": "<'row'<'col-sm-12'tr>>" +
                       "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>", // custom DOM to hide default search box but keep pagination/info
            });

            $('#searchBar').on('keyup', function () {
                table.search(this.value).draw();
            });
        });

        function filterTable(e, type) {
            e.preventDefault();
            const table = $('#projectsTable').DataTable();
            
            // Filter by the Status column (index 3).
            table.column(3).search(type).draw();
            
            // Update active tab styling
            $('#projectTabs .nav-link').removeClass('active text-primary').addClass('text-muted');
            $(e.target).removeClass('text-muted').addClass('active text-primary');
        }
    </script>
}
