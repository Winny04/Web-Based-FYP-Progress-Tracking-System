    // ── Tab Filtering Logic ────────────────────────────────────
    function filterUserType(e, type) {
        e.preventDefault();
        const table = $("#mytable").DataTable();
        
        // Filter by user type column (index 2) using regex for exact match if type provided
        table.column(2).search(type ? '^' + type + '$' : '', true, false).draw();
        
        // Dynamically hide/show columns based on the role
        // Column 3 is Supervisor (for Students), Column 4 is Assigned Students (for Supervisors/Examiners), Column 5 is Student Count
        if (type === 'Student') {
            table.column(3).visible(true);
            table.column(4).visible(false);
            table.column(5).visible(false);
        } else if (type === 'Supervisor' || type === 'Examiner') {
            table.column(3).visible(false);
            table.column(4).visible(true);
            table.column(5).visible(true);
        } else {
            table.column(3).visible(true);
            table.column(4).visible(true);
            table.column(5).visible(true);
        }

        // Update active tab styling
        $('#userRoleTabs .nav-link').removeClass('active text-primary').addClass('text-muted');
        $(e.target).removeClass('text-muted').addClass('active text-primary');
    }

    $(document).ready(function () {
        // Add Invitee Row
        $('#addInviteeBtn').click(function () {
            addInviteeRow();
        });

        // Remove Invitee Row
        $(document).on('click', '.remove-invitee', function () {
            if ($('.invitee-row').length > 1) {
                $(this).closest('.invitee-row').remove();
                updateRemoveButtons();
            }
        });

        // Smart Paste logic on email input
        $(document).on('paste', '.email-input', function (e) {
            e.preventDefault();
            let pasteData = (e.originalEvent || e).clipboardData.getData('text/plain');
            if (!pasteData) return;

            let rawItems = pasteData.split(/[\n\r,]+/).map(s => s.trim()).filter(s => s.length > 0);
            
            let emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            let extractedEmails = [];
            
            rawItems.forEach(item => {
                let match = item.match(/([a-zA-Z0-9._-]+@@[a-zA-Z0-9._-]+\.[a-zA-Z0-9_-]+)/gi);
                if (match && match.length > 0) {
                    extractedEmails.push(...match);
                }
            });

            if (extractedEmails.length > 0) {
                let inputEl = $(this);
                // Fill the current input
                inputEl.val(extractedEmails[0]);
                
                // Add new rows for the rest
                for (let i = 1; i < extractedEmails.length; i++) {
                    let newRow = addInviteeRow();
                    newRow.find('.email-input').val(extractedEmails[i]);
                }
            } else {
                $(this).val(pasteData);
            }
        });

        function addInviteeRow() {
            let rowHtml = `
                <div class="row mb-2 invitee-row">
                    <div class="col-5">
                        <input type="text" name="inviteNames[]" class="form-control form-control-solid" placeholder="Full Name (Optional)">
                    </div>
                    <div class="col-6">
                        <input type="email" name="inviteEmails[]" class="form-control form-control-solid email-input" placeholder="Email Address *" required>
                    </div>
                    <div class="col-1 text-end">
                        <button type="button" class="btn btn-icon btn-light-danger btn-sm remove-invitee"><i class="bi bi-trash fs-5"></i></button>
                    </div>
                </div>
            `;
            let newRow = $(rowHtml);
            $('#inviteesList').append(newRow);
            updateRemoveButtons();
            return newRow;
        }

        function updateRemoveButtons() {
            if ($('.invitee-row').length === 1) {
                $('.remove-invitee').prop('disabled', true);
            } else {
                $('.remove-invitee').prop('disabled', false);
            }
        }
    });
</script>











