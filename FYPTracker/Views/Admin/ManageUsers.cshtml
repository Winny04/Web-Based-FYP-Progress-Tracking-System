@using FYPTracker.Common
@using FYPTracker.Helpers
@using FYPTracker.Models
@model FYPTracker.Controllers.ApplicationUserVM
@inject FYPTrackerContext DbContext
@{
    //ViewBag.Title = "Configuration>Users";
    ViewBag.Title = "Manage Users";
    var departmentList = Departments.DepartmentListFromDb(DbContext);
    var programmeList = Departments.ProgrammeListFromDb(DbContext);
    var specializationList = Departments.SpecializationListFromDb(DbContext);
    var userTypeList = new List<SelectListItem>();
    userTypeList = UserTypes.UserTypeFilterList();
    var createUserTypeList = new List<SelectListItem>
    {
        new SelectListItem { Text = "Student", Value = "Student" },
        new SelectListItem { Text = "Supervisor", Value = "Supervisor" }
    };
}
<style>
    .tableBorder {
        border-right: 2px solid #D3D3D3;
        color: black;
        font-size: 15px;
    }
</style>

<div class="container-fluid py-4">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
            <h4 class="fw-bolder text-dark mb-0"><i class="fas fa-users-cog text-primary me-2"></i>User Management</h4>

    <div class="card-header border-0">

        <div class="card-toolbar">
            <div class="d-flex flex-stack flex-wrap gap-4">
                <div class="d-flex align-items-center position-relative my-1">
                    <span class="svg-icon svg-icon-1 position-absolute px-1" style="margin-right:1.5rem !important;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                        </svg>
                    </span>
                    <input type="text" id="searchBar" class="form-control form-control-solid w-250px" placeholder="Search user" style="padding-left:2.8rem !important;" />
                </div>
            </div>
        </div>
        <div class="card-toolbar">
            <div class="d-flex align-items-center py-3 py-md-1">
                <div class="me-4">
                    <!--start:: Btn Bulk Invite-->
                    <a href="#" id="btn-BulkInvite" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#bulkInviteModal">Invite</a>
                    <!--end:: Btn Bulk Invite-->
                </div>
            </div>
        </div>
    </div>

    <div class="card-body py-0">
        
        <!-- User Role Nav Tabs -->
        <ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x mb-5 fs-5 fw-bold" id="userRoleTabs">
            <li class="nav-item">
                <a class="nav-link active text-primary" data-bs-toggle="tab" href="#all_users" onclick="filterUserType(event, '')">All Users</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted" data-bs-toggle="tab" href="#students" onclick="filterUserType(event, 'Student')">Students</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted" data-bs-toggle="tab" href="#supervisors" onclick="filterUserType(event, 'Supervisor')">Supervisors</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted" data-bs-toggle="tab" href="#examiners" onclick="filterUserType(event, 'Examiner')">Examiners</a>
            </li>
        </ul>
        @* <label>@Html.ValidationMessageFor(model => model.EmplooyeeInfoID, "", new { @class = "text-danger" })</label>*@
        <div class="table-responsive">
            <table id="mytable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="text-start text-muted fw-bolder fs-7 text-uppercase gs-0">
                        <th class="w-25px">ID</th>
                        <th class="min-w-250px">User</th>
                        <th class="min-w-100px">User Type</th>
                        <th class="min-w-150px">Supervisor</th>
                        <th class="min-w-150px">Assigned Students</th>
                        <th class="min-w-100px">Student Count</th>
                        <th class="min-w-150px">Date Created</th>
                        <th class="min-w-100px">Status</th>
                        <th class="min-w-100px text-end">Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>



<!-- Edit User Modal -->
<div class="modal fade" id="editAccModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-600px">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Edit User</h2>
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body p-5">
                <div class="form-horizontal">
                    <input type="hidden" id="editUserId" />
                    <input type="hidden" id="editUserType" />

                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">Full Name</label>
                        <input type="text" id="editFullName" class="form-control form-control-lg form-control-solid bg-light text-muted" readonly />
                        <div class="form-text mt-2"><i class="fas fa-lock me-1"></i> Name cannot be modified.</div>
                    </div>

                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">Phone</label>
                        <input type="text" id="editPhone" class="form-control form-control-lg form-control-solid" placeholder="012-3456789" />
                        <div id="editPhoneError" class="text-danger mt-1 fs-7 fw-bold"></div>
                    </div>

                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">Email <span class="text-danger">*</span></label>
                        <input type="email" id="editEmail" class="form-control form-control-lg form-control-solid" placeholder="xxx@gmail.com or xxx@student.newinti.edu.my" />
                        <div id="editEmailError" class="text-danger mt-1 fs-7 fw-bold"></div>
                    </div>

                    <div id="editLookupFields" style="display:none;">
                        <div class="fv-row mb-5" id="editDeptContainer">
                            <label class="form-label fw-bolder text-dark fs-6">Department <span class="text-danger">*</span></label>
                            <select id="editDepartment" class="form-select form-select-solid form-select-lg fw-bold">
                                <option value="">-- Select Department --</option>
                                @foreach (var dept in departmentList)
                                {
                                    <option value="@dept.Value">@dept.Text</option>
                                }
                            </select>
                        </div>
                        <div class="fv-row mb-5">
                            <label class="form-label fw-bolder text-dark fs-6">Programme</label>
                            <select id="editProgramme" class="form-select form-select-solid form-select-lg fw-bold" multiple="multiple" data-control="select2" data-placeholder="-- Select Programme(s) --">
                                <option value=""></option>
                                @foreach (var prog in programmeList)
                                {
                                    <option value="@prog.Value">@prog.Text</option>
                                }
                            </select>
                        </div>
                        <div class="fv-row mb-5" id="editSpecContainer">
                            <label class="form-label fw-bolder text-dark fs-6">Specialization</label>
                            <select id="editSpecialization" class="form-select form-select-solid form-select-lg fw-bold" multiple="multiple" data-control="select2" data-placeholder="-- Select Specialization(s) --">
                                <option value=""></option>
                                @foreach (var spec in specializationList)
                                {
                                    <option value="@spec.Value">@spec.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div id="editStudentFields" style="display:none;">
                        <div class="fv-row mb-5">
                            <label class="form-label fw-bolder text-dark fs-6">Academic Session</label>
                            <select id="editAcademicSession" class="form-select form-select-solid form-select-lg fw-bold">
                                <option value="">-- Select Session --</option>
                            </select>
                        </div>
                    </div>

                    <div id="editSupervisorFields" style="display:none;">
                        <div class="fv-row mb-5">
                            <label class="form-label fw-bolder text-dark fs-6">Title</label>
                            <select id="editTitle" class="form-select form-select-solid form-select-lg fw-bold">
                                <option value="">-- Select Title --</option>
                                <option value="Mr.">Mr.</option>
                                <option value="Ms.">Ms.</option>
                                <option value="Mrs.">Mrs.</option>
                                <option value="Dr.">Dr.</option>
                                <option value="Prof.">Prof.</option>
                                <option value="Assoc. Prof.">Assoc. Prof.</option>
                                <option value="Ts.">Ts.</option>
                                <option value="Ir.">Ir.</option>
                            </select>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="button" id="btn_edit_submit" class="btn btn-lg btn-primary w-100">Save Changes</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Invite Modal -->
<div class="modal fade" id="bulkInviteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-600px">
        <div class="modal-content">
            <form method="post" action="/Admin/BulkInvite">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2>Invite Users</h2>
                    <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                        <span class="svg-icon svg-icon-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                                <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                            </svg>
                        </span>
                    </div>
                </div>
                <div class="modal-body p-5">
                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">Users to Invite <span class="text-danger">*</span></label>
                        <div id="inviteesList">
                            <div class="row mb-2 invitee-row">
                                <div class="col-5">
                                    <input type="text" name="inviteNames[]" class="form-control form-control-solid" placeholder="Full Name (Optional)">
                                </div>
                                <div class="col-6">
                                    <input type="email" name="inviteEmails[]" class="form-control form-control-solid email-input" placeholder="Email Address *" required>
                                </div>
                                <div class="col-1 text-end">
                                    <button type="button" class="btn btn-icon btn-light-danger btn-sm remove-invitee" disabled><i class="bi bi-trash fs-5"></i></button>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-light-primary btn-sm mt-2" id="addInviteeBtn">
                            <i class="bi bi-plus fs-4"></i> Add Another User
                        </button>
                        <div class="form-text mt-3">
                            <strong>Pro Tip:</strong> You can paste a list of comma or newline separated emails into the first Email box to automatically generate rows!
                        </div>
                    </div>
                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">User Type <span class="text-danger">*</span></label>
                        <select name="bulkUserType" class="form-select form-select-solid form-select-lg fw-bold" required>
                            <option value="">-- Select Type --</option>
                            <option value="Student">Student</option>
                            <option value="Supervisor">Supervisor</option>
                            <option value="Examiner">Examiner</option>
                        </select>
                    </div>
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-lg btn-primary w-100">Send Invites</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts{
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>


    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({
                title: 'Success!',
                text: '@Html.Raw(TempData["Success"].ToString().Replace("'", "\\'"))',
                icon: 'success',
                confirmButtonColor: '#3b82f6'
            });
            </text>
        }

        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({
                title: 'Error!',
                text: '@Html.Raw(TempData["Error"].ToString().Replace("'", "\\'"))',
                icon: 'error',
                confirmButtonColor: '#3b82f6'
            });
            </text>
        }

        @if (TempData["Info"] != null)
        {
            <text>
            Swal.fire({
                title: 'Info',
                text: '@Html.Raw(TempData["Info"].ToString().Replace("'", "\\'"))',
                icon: 'info',
                confirmButtonColor: '#3b82f6'
            });
            </text>
        }

        // Dynamically populate Academic Session dropdown
        var now = new Date();
        var currentYear = now.getFullYear();
        var currentMonth = now.getMonth() + 1; // 1-12
        var intakes = [
            { name: 'Jan', month: 1 },
            { name: 'April', month: 4 },
            { name: 'Aug', month: 8 }
        ];
        var sessionSelect = $('#createAcademicSession'); // populated if a create modal is added
        var editSessionSelect = $('#editAcademicSession');
        for (var y = currentYear - 1; y <= currentYear + 2; y++) {
            intakes.forEach(function(intake) {
                // Only allow selecting sessions from the current month onwards
                if (y > currentYear || (y === currentYear && intake.month >= currentMonth)) {
                    var sessionText = y + ' ' + intake.name;
                    sessionSelect.append(new Option(sessionText, sessionText));
                    editSessionSelect.append(new Option(sessionText, sessionText));
                }
            });
        }

        LoadTable();


    });

    $('#typeFilter').change(function (e) { $('#mytable').DataTable().columns(2).search(e.target.value).draw(); });

    function OpenEditModal(employeeId, isViewOnly) {
        var isView = false;
        EditableModal();
        if (isViewOnly == "View") {
            $("#modal-title").text("View");
            isView = true;
        }
        else {
            $("#modal-title").text("Edit");
        }

        $.ajax({
            type: "POST",
            url: '/User/Edit',
            data: {
                id: employeeId
            },
            success: function (data, row) {
                var imagePath = data.Image;
                $("#ApplicationUser_Id").val(data.Id);
                $("#ApplicationUser_FullName").val(data.FullName);
                $("#ApplicationUser_Email").val(data.Email);
                $("#ApplicationUser_PassCode").val(data.PassCode);
                if (data.Image != null) {
                    $("#UserImage").attr("value", data.Image);
                    $("#uploadedImg").attr("src", data.Image);
                    $("#backImg").css("background-image", "url(" + data.Image + ")");
                    $("#backImg1").css("background-image", "url(" + data.Image + ")");
                }
                else {
                    $("#UserImage").attr("value", '');
                    $("#uploadedImg").attr("src", '');
                    $("#backImg").css("background-image", "url(" + "assets/media/svg/avatars/blank.png" + ")");
                    $("#backImg1").css("background-image", "url(" + "assets/media/svg/avatars/blank.png" + ")");

                }
                $('#create_new_user_modal').modal('show');
                //CheckHasImage(isView);
            },
            error: function (data) {
            }

        });
        $("#div-submit").html('<input type="submit" value="Save" class="btn btn-primary" />');
    };


    $("#SearchDepartmentName").change(function (e) {
        e.stopPropagation();
        ReloadTable();
    });

    $('#searchBar').keyup(function () {
        $("#mytable").DataTable().search($(this).val()).draw();
    });

    function ReloadTable() {
        $("#mytable tbody").remove();
        LoadTable();
    }

    function LoadTable() {
        $.post("@Url.Action("ManageUsersData")", { DepartmentName: $('#SearchDepartmentName').val() }, function (d) {
            $("#mytable").DataTable(
                {
                    dom: 'ltip',
                    buttons: [],
                    processing: true,
                    searching: true,
                    destroy: true,
                    data: d.data,
                    columnDefs: [
                        {
                            "defaultContent": "-",
                            "targets": "_all"
                        }, 
                        {
                            targets: 1,
                            createdCell: function (td) {
                                // Default styling
                            }
                        },
                        {
                            targets: [2, 3, 4, 5, 6, 7],
                            createdCell: function (td, cellData, rowData, row, col) {
                                // Default styling
                            }
                        },
                        {
                            targets: 8,
                            createdCell: function (td, cellData, rowData, row, col) {
                                $(td).addClass('text-end');
                            }
                        },
                        {
                            "targets": 6, "render": function (data, type, row, meta) {
                                return data ? moment(data.toString()).format('DD MMM YYYY HHmm') : '-';
                            }
                        }],
                    order: [[6, 'desc']],// order by date desc
                    aoColumns: [
                        { mData: "id", visible: false },
                        {
                            render: function (data, type, row, meta) {
                                let imageComponent = ""

                                if (row.image !== "") {
                                    imageComponent = '<div class="symbol symbol-45px me-5"><img alt="Pic" src="' + row.image + '" onerror="this.onerror=null;this.src=\'/assets/media/avatars/blank.png\';" /></div>';
                                } else {
                                    imageComponent = '<div class="symbol symbol-45px me-5"><span class="symbol-label bg-light-danger text-danger fw-bolder">' + row.fullName.charAt(0).toUpperCase() + '</span></div>'
                                }

                                let detailComponent = '<div class="d-flex justify-content-start flex-column"><a style="cursor: pointer;" id="' + row.id + '" onclick="OpenViewModal(' + row.id + ')" class="text-muted fw-bold text-muted d-block fs-7"><span class="text-dark fw-bolder text-hover-primary fs-6" style="color:black">' + row.fullName + '</span></a><span class="text-gray-600 fw-bold fs-7">ID: ' + (row.employeeId || 'N/A') + '</span><a href="" class="text-dark fw-bold text-dark d-block fs-7" style="color:black"><span class="text-dark">Email</span>: ' + row.email + '</a></div>';

                                //Edit and Delete buttons
                                                                                                return '<div class="d-flex align-items-center">' + imageComponent + detailComponent + '</div>';
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if (type === 'display') {
                                    let badge = '<span class="fw-bold">' + row.userType + '</span>';
                                    if (row.isProfileIncomplete) {
                                        badge += '<br><span class="badge badge-light-warning fs-8 mt-1 border border-warning" data-bs-toggle="tooltip" title="Missing required profile configuration"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Pending Config</span>';
                                    }
                                    return badge;
                                }
                                return row.userType;
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if(row.userType === 'Student') {
                                    return '<span class="text-dark fw-bold">' + (row.supervisorName || 'Not Assigned') + '</span>';
                                }
                                return '-';
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if(row.userType === 'Supervisor' || row.userType === 'Examiner') {
                                    return '<span class="text-dark fw-bold">' + (row.assignedStudents || 'No Students') + '</span>';
                                }
                                return '-';
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if(row.userType === 'Supervisor' || row.userType === 'Examiner') {
                                    return '<span class="text-dark fw-bold">' + (row.assignedStudentCount || '0') + '</span>';
                                }
                                return '-';
                            }
                        },
                        { mData: "dateCreated" },
                        {
                            render: function (data, type, row, meta) {
                                if(row.isResign){
                                    return '<div class="badge badge-light-danger">Inactive</div>';
                                }
                                else{
                                    return '<div class="badge badge-light-success">Active</div>';
                                }
                            }
                        },
                        {
                            render: function (data, type, row, meta) {
                                let buttonComponent = '<a id="edit_' + row.id + '" onclick="Edit(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i class="bi bi-pencil-fill fs-4"></i></a>';
                                if (row.isResign) {
                                    buttonComponent += '<a id="activate_' + row.id + '" onclick="Activate(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-success btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Activate"><i class="bi bi-check-circle-fill fs-4 text-success"></i></a>';
                                } else {
                                    buttonComponent += '<a id="deactivate_' + row.id + '" onclick="Delete(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Deactivate"><i class="bi bi-slash-circle-fill fs-4 text-warning"></i></a>';
                                }
                                buttonComponent += '<a id="harddelete_' + row.id + '" onclick="HardDeleteUser(' + row.id + ', \'' + row.fullName + '\')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Permanently Delete"><i class="bi bi-trash-fill fs-4 text-danger"></i></a>';
                                return buttonComponent;
                            }
                        }
                    ],
                }
            )

        });
    }

    function Activate(employeeId) {
        Swal.fire({
            title: 'Confirm Activation',
            text: "Are you sure you want to activate this user?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#50cd89',
            cancelButtonColor: '#f1416c',
            confirmButtonText: 'Yes, activate!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '/Admin/Activate',
                    data: { id: employeeId },
                    success: function (data) {
                        if (data) {
                            Swal.fire({ text: "User activated successfully", icon: "success", confirmButtonText: "Ok, got it!" });
                            LoadTable();
                        } else {
                            Swal.fire({ text: "Failed to activate user", icon: "error", confirmButtonText: "Ok, got it!" });
                        }
                    }
                });
            }
        });
    }

    function Delete(employeeId) {
        Swal.fire({
            title: 'Confirm Deactivation',
            text: "Are you sure you want to deactivate this user? They will no longer be able to log in.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f59e0b',
            cancelButtonColor: '#a1a5b7',
            confirmButtonText: 'Yes, deactivate!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: '/Admin/Delete',
                    data: { id: employeeId },
                    success: function (data) {
                        Swal.fire({ text: "User deactivated successfully.", icon: "success", confirmButtonText: "Ok, got it!" });
                        LoadTable();
                    },
                    error: function (data) {
                        LoadTable();
                    }
                });
            }
        });
    }

    function HardDeleteUser(employeeId, fullName) {
        Swal.fire({
            title: '⚠️ Permanently Delete User?',
            html: '<p>You are about to <strong>permanently delete</strong> <strong>' + fullName + '</strong>.</p>' +
                  '<p class="text-danger mt-2 mb-0"><strong>This will also delete all their FYP project data, milestones, files, meeting records, and cannot be undone.</strong></p>',
            icon: 'error',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Yes, permanently delete!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                // Second confirmation
                Swal.fire({
                    title: 'Are you absolutely sure?',
                    text: 'This action CANNOT be undone. Type "DELETE" to confirm.',
                    input: 'text',
                    inputPlaceholder: 'Type DELETE to confirm',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Permanently Delete',
                    preConfirm: (val) => {
                        if (val !== 'DELETE') {
                            Swal.showValidationMessage('You must type DELETE to confirm.');
                        }
                    }
                }).then((result2) => {
                    if (result2.isConfirmed) {
                        $.ajax({
                            type: "POST",
                            url: '/Admin/HardDelete',
                            data: { id: employeeId },
                            success: function (data) {
                                if (data.status) {
                                    Swal.fire({ title: 'Deleted!', text: data.msg, icon: 'success', confirmButtonText: 'Ok' });
                                    LoadTable();
                                } else {
                                    Swal.fire({ title: 'Error', text: data.msg, icon: 'error', confirmButtonText: 'Ok' });
                                }
                            },
                            error: function () {
                                Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error' });
                            }
                        });
                    }
                });
            }
        });
    }

    function Edit(employeeId) {
        $.ajax({
            type: "GET",
            url: '/Admin/GetUserDetails',
            data: { id: employeeId },
            success: function (data) {
                if (data.success) {
                    $('#editUserId').val(data.id);
                    $('#editUserType').val(data.userType);
                    $('#editFullName').val(data.fullName);
                    $('#editEmail').val(data.email);
                    $('#editPhone').val(data.phone);

                    if (data.userType === 'Student' || data.userType === 'STUDENT' ||
                        data.userType === 'Supervisor' || data.userType === 'SUPERVISOR' ||
                        data.userType === 'Examiner' || data.userType === 'EXAMINER') {
                        $('#editLookupFields').show();

                        if (data.userType === 'Student' || data.userType === 'STUDENT') {
                            $('#editDeptContainer').show();
                            $('#editSpecContainer').hide();
                        } else {
                            $('#editDeptContainer').show();
                            $('#editSpecContainer').show();
                        }

                        $('#editDepartment').val(data.department);
                        
                        var progArray = data.programme ? data.programme.split(',').map(s => s.trim()) : [];
                        $('#editProgramme').val(progArray).trigger('change');
                        
                        var specArray = data.specialization ? data.specialization.split(',').map(s => s.trim()) : [];
                        $('#editSpecialization').val(specArray).trigger('change');
                    } else {
                        $('#editLookupFields').hide();
                    }

                    if (data.userType === 'Student' || data.userType === 'STUDENT') {
                        $('#editStudentFields').show();
                        $('#editSupervisorFields').hide();
                        if (data.academicSession && $('#editAcademicSession option[value="' + data.academicSession + '"]').length === 0) {
                            $('#editAcademicSession').append(new Option(data.academicSession, data.academicSession));
                        }
                        $('#editAcademicSession').val(data.academicSession);
                    } else if (data.userType === 'Supervisor' || data.userType === 'SUPERVISOR') {
                        $('#editStudentFields').hide();
                        $('#editSupervisorFields').show();
                        $('#editTitle').val(data.title);
                    } else {
                        $('#editStudentFields').hide();
                        $('#editSupervisorFields').hide();
                    }
                    
                    // Clear previous validation states
                    $('#editPhoneError').text("");
                    $('#editPhone').removeClass('is-invalid');
                    $('#editEmailError').text("");
                    $('#editEmail').removeClass('is-invalid');
                    
                    $('#editAccModal').modal('show');
                } else {
                    Swal.fire({ text: data.msg || "Could not fetch user details.", icon: "error", confirmButtonText: "Ok, got it!" });
                }
            },
            error: function () {
                Swal.fire({ text: "Server error while fetching user details.", icon: "error", confirmButtonText: "Ok, got it!" });
            }
        });
    }

    $('#btn_edit_submit').click(function () {
        var id = $('#editUserId').val();
        var email = $('#editEmail').val().trim();
        var phone = $('#editPhone').val().trim();
        var department = $('#editDepartment').val();
        
        var progVal = $('#editProgramme').val();
        var programme = Array.isArray(progVal) ? progVal.join(', ') : (progVal || '');
        
        var specVal = $('#editSpecialization').val();
        var specialization = Array.isArray(specVal) ? specVal.join(', ') : (specVal || '');
        
        var academicSession = $('#editAcademicSession').val();
        var title = $('#editTitle').val().trim();

        if (!email) {
            Swal.fire({ text: "Please enter an email.", icon: "warning", confirmButtonText: "Ok, got it!" });
            return;
        }

        const emailPattern = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;
        if (!emailPattern.test(email)) {
            Swal.fire({ text: "Please enter a valid email address.", icon: "warning", confirmButtonText: "Ok, got it!" });
            return;
        }

        var userType = $('#editUserType').val();
        if (userType === "Student") {
            if (!programme) {
                Swal.fire({ text: "Please select a Programme.", icon: "warning", confirmButtonText: "Ok, got it!" });
                return;
            }
            if (!academicSession) {
                Swal.fire({ text: "Please select an Academic Session.", icon: "warning", confirmButtonText: "Ok, got it!" });
                return;
            }
        } else if (userType === "Supervisor") {
            if (!title) {
                Swal.fire({ text: "Please select a Title.", icon: "warning", confirmButtonText: "Ok, got it!" });
                return;
            }
            if (!department) {
                Swal.fire({ text: "Please select a Department.", icon: "warning", confirmButtonText: "Ok, got it!" });
                return;
            }
        }

        const phonePattern = /^01[0-9]-?\d{7,8}$/;
        if (phone && !phonePattern.test(phone)) {
            Swal.fire({ text: "Please enter a valid Malaysian mobile number (e.g. 012-3456789).", icon: "warning", confirmButtonText: "Ok, got it!" });
            return;
        }

        $.ajax({
            url: "/Admin/UpdateUserModal", method: "POST",
            data: { 
                id: id, 
                email: email, 
                phone: phone, 
                department: department, 
                programme: programme, 
                specialization: specialization, 
                academicSession: academicSession, 
                title: title 
            },
            success: function (r) {
                if (r.status) {
                    $('#editAccModal').modal('hide');
                    Swal.fire({ text: r.msg, icon: "success", confirmButtonText: "Ok, got it!" }).then(function () { LoadTable(); });
                } else {
                    Swal.fire({ text: r.msg, icon: "warning", confirmButtonText: "Ok, got it!" });
                }
            },
            error: function () {
                Swal.fire({ text: "An error occurred. Please try again.", icon: "error", confirmButtonText: "Ok, got it!" });
            }
        });
    });

    // Real-time email validation
    const editEmailInput = document.getElementById('editEmail');
    const editEmailError = document.getElementById('editEmailError');
    const editEmailPattern = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;

    if (editEmailInput) {
        editEmailInput.addEventListener('input', function() {
            if (this.value && !editEmailPattern.test(this.value)) {
                editEmailError.innerText = "Please enter a valid email format.";
                this.classList.add('is-invalid');
            } else {
                editEmailError.innerText = "";
                this.classList.remove('is-invalid');
            }
        });
    }

    // Real-time phone validation for Edit modal
    const editPhoneInput = document.getElementById('editPhone');
    const editPhoneError = document.getElementById('editPhoneError');
    const editPhonePattern = /^01[0-9]-?\d{7,8}$/;

    if (editPhoneInput) {
        editPhoneInput.addEventListener('input', function() {
            if (this.value && !editPhonePattern.test(this.value)) {
                editPhoneError.innerText = "Please enter a valid Malaysian mobile number (e.g. 012-3456789).";
                this.classList.add('is-invalid');
            } else {
                editPhoneError.innerText = "";
                this.classList.remove('is-invalid');
            }
        });
    }

    // ── Tab Filtering Logic ────────────────────────────────────
    function filterUserType(e, type) {
        e.preventDefault();
        const table = $("#mytable").DataTable();
        
        // Filter by user type column (index 2) using regex for exact match if type provided
        table.column(2).search(type ? '^' + type + '$' : '', true, false).draw();
        
        // Dynamically hide/show columns based on the role
        // Column 3 is Supervisor (for Students), Column 4 is Assigned Students (for Supervisors/Examiners), Column 5 is Student Count
        if (type === 'Student') {
            table.column(3).visible(true);
            table.column(4).visible(false);
            table.column(5).visible(false);
        } else if (type === 'Supervisor' || type === 'Examiner') {
            table.column(3).visible(false);
            table.column(4).visible(true);
            table.column(5).visible(true);
        } else {
            table.column(3).visible(true);
            table.column(4).visible(true);
            table.column(5).visible(true);
        }

        // Update active tab styling
        $('#userRoleTabs .nav-link').removeClass('active text-primary').addClass('text-muted');
        $(e.target).removeClass('text-muted').addClass('active text-primary');
    }

    $(document).ready(function () {
        // Add Invitee Row
        $('#addInviteeBtn').click(function () {
            addInviteeRow();
        });

        // Remove Invitee Row
        $(document).on('click', '.remove-invitee', function () {
            if ($('.invitee-row').length > 1) {
                $(this).closest('.invitee-row').remove();
                updateRemoveButtons();
            }
        });

        // Smart Paste logic on email input
        $(document).on('paste', '.email-input', function (e) {
            e.preventDefault();
            let pasteData = (e.originalEvent || e).clipboardData.getData('text/plain');
            if (!pasteData) return;

            let rawItems = pasteData.split(/[\n\r,]+/).map(s => s.trim()).filter(s => s.length > 0);
            
            let emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            let extractedEmails = [];
            
            rawItems.forEach(item => {
                let match = item.match(/([a-zA-Z0-9._-]+@@[a-zA-Z0-9._-]+\.[a-zA-Z0-9_-]+)/gi);
                if (match && match.length > 0) {
                    extractedEmails.push(...match);
                }
            });

            if (extractedEmails.length > 0) {
                let inputEl = $(this);
                // Fill the current input
                inputEl.val(extractedEmails[0]);
                
                // Add new rows for the rest
                for (let i = 1; i < extractedEmails.length; i++) {
                    let newRow = addInviteeRow();
                    newRow.find('.email-input').val(extractedEmails[i]);
                }
            } else {
                $(this).val(pasteData);
            }
        });

        function addInviteeRow() {
            let rowHtml = `
                <div class="row mb-2 invitee-row">
                    <div class="col-5">
                        <input type="text" name="inviteNames[]" class="form-control form-control-solid" placeholder="Full Name (Optional)">
                    </div>
                    <div class="col-6">
                        <input type="email" name="inviteEmails[]" class="form-control form-control-solid email-input" placeholder="Email Address *" required>
                    </div>
                    <div class="col-1 text-end">
                        <button type="button" class="btn btn-icon btn-light-danger btn-sm remove-invitee"><i class="bi bi-trash fs-5"></i></button>
                    </div>
                </div>
            `;
            let newRow = $(rowHtml);
            $('#inviteesList').append(newRow);
            updateRemoveButtons();
            return newRow;
        }

        function updateRemoveButtons() {
            if ($('.invitee-row').length === 1) {
                $('.remove-invitee').prop('disabled', true);
            } else {
                $('.remove-invitee').prop('disabled', false);
            }
        }
    });
</script>
