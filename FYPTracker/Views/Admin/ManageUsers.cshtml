@using FYPTracker.Common
@using FYPTracker.Helpers
@using FYPTracker.Models
@model FYPTracker.Controllers.ApplicationUserVM
@inject FYPTrackerContext DbContext
@{
    //ViewBag.Title = "Configuration>Users";
    ViewBag.Title = PageTitle.ManageUser;
    var departmentList = Departments.DepartmentListFromDb(DbContext);
    var userTypeList = new List<SelectListItem>();
    userTypeList = UserTypes.UserTypeFilterList();
    var createUserTypeList = new List<SelectListItem>
    {
        new SelectListItem { Text = "Student", Value = "Student" },
        new SelectListItem { Text = "Supervisor", Value = "Supervisor" }
    };
}
<style>
    .tableBorder {
        border-right: 2px solid #D3D3D3;
        color: black;
        font-size: 15px;
    }
</style>

<div class="container-fluid py-4">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
            <h4 class="fw-bolder text-dark mb-0"><i class="fas fa-users-cog text-primary me-2"></i>User Management</h4>

    <div class="card-header border-0">

        <div class="card-toolbar">
            <div class="d-flex flex-stack flex-wrap gap-4">
                <div class="d-flex align-items-center position-relative my-1">
                    <span class="svg-icon svg-icon-1 position-absolute px-1" style="margin-right:1.5rem !important;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                        </svg>
                    </span>
                    <input type="text" id="searchBar" class="form-control form-control-solid w-250px" placeholder="Search user" style="padding-left:2.8rem !important;" />
                </div>
                <div class="d-flex align-items-center fw-bolder">
                    <!--begin::Select-->
                    @Html.DropDownListFor(model => model.UserType, userTypeList, new {@class = "form-select form-select-solid form-select-lg fw-bold",id = "typeFilter"})
                    <!--end::Select-->
                </div>
            </div>
        </div>
        <div class="card-toolbar">
            <div class="d-flex align-items-center py-3 py-md-1">
                <div class="me-4">
                    <!--start:: Btn Create-->
                    <a href="#" id="btn-Create" class="btn btn-success " data-bs-toggle="modal" data-bs-target="#createAcc" value="Create">Create</a>
                    <!--end:: Btn Create-->
                </div>
            </div>
        </div>
    </div>

    <div class="card-body py-0">
        @* <label>@Html.ValidationMessageFor(model => model.EmplooyeeInfoID, "", new { @class = "text-danger" })</label>*@
        <div class="table-responsive">
            <table id="mytable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="text-start text-muted fw-bolder fs-7 text-uppercase gs-0">
                        <th class="w-25px">ID</th>
                        <th class="min-w-250px">User</th>
                        <th class="min-w-100px">User Type</th>
                        <th class="min-w-150px">Supervisor</th>
                        <th class="min-w-150px">Assigned Students</th>
                        <th class="min-w-150px">Date Created</th>
                        <th class="min-w-100px">Status</th>
                        <th class="min-w-100px text-end">Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createAcc" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-600px">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Create New User</h2>
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body p-5">
                <div class="form-horizontal">

                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="createFullName" class="form-control form-control-lg form-control-solid" placeholder="e.g. Ahmad bin Ali" />
                    </div>





                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">Phone</label>
                        <input type="text" id="createPhone" class="form-control form-control-lg form-control-solid" placeholder="e.g. 0123456789 or +60123456789" />
                    </div>

                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">Email <span class="text-danger">*</span></label>
                        <input type="email" id="createEmail" class="form-control form-control-lg form-control-solid" placeholder="xxx@gmail.com or xxx@student.newinti.edu.my" />
                    </div>

                    <div class="fv-row mb-5">
                        <label class="form-label fw-bolder text-dark fs-6">User Type <span class="text-danger">*</span></label>
                        <select id="createUserType" class="form-select form-select-solid form-select-lg fw-bold">
                            <option value="">-- Select Type --</option>
                            <option value="Student">Student</option>
                            <option value="Supervisor">Supervisor</option>
                        </select>
                    </div>

                    <div id="studentFields" style="display:none;">
                        <div class="fv-row mb-5">
                            <label class="form-label fw-bolder text-dark fs-6">Programme</label>
                            <select id="createProgramme" class="form-select form-select-solid form-select-lg fw-bold">
                                <option value="">-- Select Programme --</option>
                                <option value="BCSCUNP (Bachelor of Computer Science)">BCSCUNP (Bachelor of Computer Science)</option>
                                <option value="BIT (Bachelor of Information Technology)">BIT (Bachelor of Information Technology)</option>
                                <option value="BSE (Bachelor of Software Engineering)">BSE (Bachelor of Software Engineering)</option>
                                <option value="DIT (Diploma in Information Technology)">DIT (Diploma in Information Technology)</option>
                                <option value="FIC (Foundation in Computing)">FIC (Foundation in Computing)</option>
                                <option value="BCSC-CC (BSc Cloud Computing)">BCSC-CC (BSc Cloud Computing)</option>
                                <option value="BCSC-MC (BSc Mobile Computing)">BCSC-MC (BSc Mobile Computing)</option>
                                <option value="BCSC-BA (BSc Business Analytics)">BCSC-BA (BSc Business Analytics)</option>
                                <option value="BCSC-CS (BSc Cyber Security)">BCSC-CS (BSc Cyber Security)</option>
                            </select>
                        </div>
                        <div class="fv-row mb-5">
                            <label class="form-label fw-bolder text-dark fs-6">Academic Session</label>
                            <select id="createAcademicSession" class="form-select form-select-solid form-select-lg fw-bold">
                                <option value="">-- Select Session --</option>
                            </select>
                        </div>
                    </div>

                    <div id="supervisorFields" style="display:none;">
                        <div class="fv-row mb-5">
                            <label class="form-label fw-bolder text-dark fs-6">Title</label>
                            <input type="text" id="createTitle" class="form-control form-control-lg form-control-solid" placeholder="e.g. Dr." />
                        </div>


                        <div class="fv-row mb-5">
                            <label class="form-label fw-bolder text-dark fs-6">Department <span class="text-danger">*</span></label>
                            <select id="createDepartment" class="form-select form-select-solid form-select-lg fw-bold">
                                <option value="">-- Select Department --</option>
                                @foreach (var dept in departmentList)
                                {
                                    <option value="@dept.Value">@dept.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="button" id="kt_sign_up_submit" class="btn btn-lg btn-primary w-100">Create User</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>


    $(document).ready(function () {
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({
                title: 'Success!',
                text: '@Html.Raw(TempData["Success"].ToString().Replace("'", "\\'"))',
                icon: 'success',
                confirmButtonColor: '#3b82f6'
            });
            </text>
        }

        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({
                title: 'Error!',
                text: '@Html.Raw(TempData["Error"].ToString().Replace("'", "\\'"))',
                icon: 'error',
                confirmButtonColor: '#3b82f6'
            });
            </text>
        }

        // Dynamically populate Academic Session dropdown
        var currentYear = new Date().getFullYear();
        var intakes = ['Jan', 'April', 'Aug'];
        var sessionSelect = $('#createAcademicSession');
        for (var y = currentYear - 1; y <= currentYear + 2; y++) {
            intakes.forEach(function(intake) {
                var sessionText = y + ' ' + intake;
                sessionSelect.append(new Option(sessionText, sessionText));
            });
        }

        LoadTable();

        $('#createUserType').change(function () {
            var t = $(this).val();
            $('#studentFields').toggle(t === 'Student');
            $('#supervisorFields').toggle(t === 'Supervisor');
        });

        $('#createAcc').on('hidden.bs.modal', function () {
            $('#createFullName,#createEmail,#createProgramme,#createAcademicSession,#createTitle,#createPhone').val('');
            $('#createUserType,#createDepartment').val('');
            $('#studentFields,#supervisorFields').hide();
        });

        $('#kt_sign_up_submit').click(function () {
            var FullName = $('#createFullName').val().trim();
            var Email = $('#createEmail').val().trim();
            var UserType = $('#createUserType').val();
            var Department = $('#createDepartment').val();
            var Phone = $('#createPhone').val().trim();

            if (!FullName || !Email || !UserType) {
                Swal.fire({ text: "Please fill in all required fields.", icon: "warning", confirmButtonText: "Ok, got it!", buttonsStyling: false, customClass: { confirmButton: "btn btn-primary" } });
                return;
            }

            if (Phone) {
                var cleanPhone = Phone.replace(/[\s\-\(\)]/g, '');
                var phoneRegex = /^(?:\+?6?0)[1-9]\d{7,9}$/;
                if (!phoneRegex.test(cleanPhone)) {
                    Swal.fire({ text: "Invalid Malaysia phone number format (e.g. +60123456789 or 0123456789).", icon: "warning", confirmButtonText: "Ok, got it!", buttonsStyling: false, customClass: { confirmButton: "btn btn-primary" } });
                    return;
                }
            }
            if (UserType === 'Supervisor' && !Department) {
                Swal.fire({ text: "Please select a Department for Supervisors.", icon: "warning", confirmButtonText: "Ok, got it!", buttonsStyling: false, customClass: { confirmButton: "btn btn-primary" } });
                return;
            }
            if (Email.indexOf("gmail.com") < 0 && Email.indexOf("student.newinti.edu.my") < 0) {
                Swal.fire({ text: "Incorrect email format. Please use gmail.com or student.newinti.edu.my.", icon: "warning", confirmButtonText: "Ok, got it!", buttonsStyling: false, customClass: { confirmButton: "btn btn-primary" } });
                return;
            }

            $.ajax({
                url: "/Admin/Create", method: "POST",
                data: { newEmployee: {
                    FullName: FullName, PassCode: 'auto_generated', Email: Email, UserType: UserType,
                    Department: UserType === 'Supervisor' ? Department : '',
                    Programme: UserType === 'Student' ? $('#createProgramme').val().trim() : '',
                    AcademicSession: UserType === 'Student' ? $('#createAcademicSession').val().trim() : '',
                    Title: UserType === 'Supervisor' ? $('#createTitle').val().trim() : '',
                    Phone: $('#createPhone').val().trim()
                }},
                success: function (r) {
                    if (r.status) {
                        Swal.fire({ text: r.msg, icon: "success", confirmButtonText: "Ok, got it!", buttonsStyling: false, customClass: { confirmButton: "btn btn-primary" } })
                            .then(function () { window.location.reload(); });
                    } else {
                        Swal.fire({ text: r.msg, icon: "warning", confirmButtonText: "Ok, got it!", buttonsStyling: false, customClass: { confirmButton: "btn btn-primary" } });
                    }
                },
                error: function () {
                    Swal.fire({ text: "An error occurred. Please try again.", icon: "error", confirmButtonText: "Ok, got it!", buttonsStyling: false, customClass: { confirmButton: "btn btn-primary" } });
                }
            });
        });
    });

    $('#typeFilter').change(function (e) { $('#mytable').DataTable().columns(2).search(e.target.value).draw(); });

    function OpenEditModal(employeeId, isViewOnly) {
        var isView = false;
        EditableModal();
        if (isViewOnly == "View") {
            $("#modal-title").text("View");
            isView = true;
        }
        else {
            $("#modal-title").text("Edit");
        }

        $.ajax({
            type: "POST",
            url: '/User/Edit',
            data: {
                id: employeeId
            },
            success: function (data, row) {
                var imagePath = data.Image;
                $("#ApplicationUser_Id").val(data.Id);
                $("#ApplicationUser_FullName").val(data.FullName);
                $("#ApplicationUser_Email").val(data.Email);
                $("#ApplicationUser_PassCode").val(data.PassCode);
                if (data.Image != null) {
                    $("#UserImage").attr("value", data.Image);
                    $("#uploadedImg").attr("src", data.Image);
                    $("#backImg").css("background-image", "url(" + data.Image + ")");
                    $("#backImg1").css("background-image", "url(" + data.Image + ")");
                }
                else {
                    $("#UserImage").attr("value", '');
                    $("#uploadedImg").attr("src", '');
                    $("#backImg").css("background-image", "url(" + "assets/media/svg/avatars/blank.svg" + ")");
                    $("#backImg1").css("background-image", "url(" + "assets/media/svg/avatars/blank.svg" + ")");

                }
                $('#create_new_user_modal').modal('show');
                //CheckHasImage(isView);
            },
            error: function (data) {
            }

        });
        $("#div-submit").html('<input type="submit" value="Save" class="btn btn-primary" />');
    };


    $("#SearchDepartmentName").change(function (e) {
        e.stopPropagation();
        ReloadTable();
    });

    $('#searchBar').keyup(function () {
        $("#mytable").DataTable().search($(this).val()).draw();
    });

    function ReloadTable() {
        $("#mytable tbody").remove();
        LoadTable();
    }

    function LoadTable() {
        $.post("@Url.Action("ManageUsersData")", { DepartmentName: $('#SearchDepartmentName').val() }, function (d) {
            $("#mytable").DataTable(
                {
                    dom: 'ltip',
                    buttons: [],
                    processing: true,
                    searching: true,
                    destroy: true,
                    data: d.data,
                    columnDefs: [
                        {
                            "defaultContent": "-",
                            "targets": "_all"
                        }, 
                        {
                            targets: 1,
                            createdCell: function (td) {
                                // Default styling
                            }
                        },
                        {
                            targets: [2, 3, 4, 5, 6],
                            createdCell: function (td, cellData, rowData, row, col) {
                                // Default styling
                            }
                        },
                        {
                            targets: 7,
                            createdCell: function (td, cellData, rowData, row, col) {
                                $(td).addClass('text-end');
                            }
                        },
                        {
                            "targets": 5, "render": function (data, type, row, meta) {
                                return data ? moment(data.toString()).format('DD MMM YYYY HHmm') : '-';
                            }
                        }],
                    order: [[5, 'desc']],// order by date desc
                    aoColumns: [
                        { mData: "id", visible: false },
                        {
                            render: function (data, type, row, meta) {
                                let imageComponent = ""

                                if (row.image !== "") {
                                    imageComponent = '<div class="symbol symbol-45px me-5"><img alt="Pic" src="' + row.image + '" onerror="this.onerror=null;this.src=\'/assets/media/avatars/blank.svg\';" /></div>';
                                } else {
                                    imageComponent = '<div class="symbol symbol-45px me-5"><span class="symbol-label bg-light-danger text-danger fw-bolder">' + row.fullName.charAt(0).toUpperCase() + '</span></div>'
                                }

                                let detailComponent = '<div class="d-flex justify-content-start flex-column"><a style="cursor: pointer;" id="' + row.id + '" onclick="OpenViewModal(' + row.id + ')" class="text-muted fw-bold text-muted d-block fs-7"><span class="text-dark fw-bolder text-hover-primary fs-6" style="color:black">' + row.fullName + '</span></a><span class="text-gray-600 fw-bold fs-7">ID: ' + (row.employeeId || 'N/A') + '</span><a href="" class="text-dark fw-bold text-dark d-block fs-7" style="color:black"><span class="text-dark">Email</span>: ' + row.email + '</a></div>';

                                //Edit and Delete buttons
                                                                                                return '<div class="d-flex align-items-center">' + imageComponent + detailComponent + '</div>';
                            }
                        },
                        { mData: "userType" },
                        { 
                            render: function (data, type, row, meta) {
                                if(row.userType === 'Student') {
                                    return '<span class="text-dark fw-bold">' + (row.supervisorName || 'Not Assigned') + '</span>';
                                }
                                return '-';
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if(row.userType === 'Supervisor') {
                                    return '<span class="text-dark fw-bold">' + (row.assignedStudents || 'No Students') + '</span>';
                                }
                                return '-';
                            }
                        },
                        { mData: "dateCreated" },
                        {
                            render: function (data, type, row, meta) {
                                if(row.isResign){
                                    return '<div class="badge badge-light-danger">Inactive</div>';
                                }
                                else{
                                    return '<div class="badge badge-light-success">Active</div>';
                                }
                            }
                        },
                        {
                            render: function (data, type, row, meta) {
                                let buttonComponent = '<a id="' + row.id + '" onclick="Edit(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i class="bi bi-pencil-fill fs-4"></i></a>';
                                if (row.isResign) {
                                    buttonComponent += '<a id="' + row.id + '" onclick="Activate(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-success btn-sm" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Activate"><i class="bi bi-check-circle-fill fs-4 text-success"></i></a>';
                                } else {
                                    buttonComponent += '<a id="' + row.id + '" onclick="Delete(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Deactivate"><i class="bi bi-trash-fill fs-4 text-danger"></i></a>';
                                }
                                return buttonComponent;
                            }
                        }
                    ],
                }
            )

        });
    }

        function Activate(employeeId) {
        if (confirm("Confirm activate?")) {
            $.ajax({
                type: "POST",
                url: '/Admin/Activate',
                data: {
                    id: employeeId
                },
                success: function (data) {
                    if (data) {
                        toastr.success("User activated successfully");
                        LoadTable();
                    } else {
                        toastr.error("Failed to activate user");
                    }
                }
            });
        }
    }

    function Delete(employeeId) {
        if (confirm("Confirm delete?")) {
            $.ajax({
                type: "POST",
                url: '/Admin/Delete',
                data: {
                    id: employeeId
                },
                success: function (data) {
                    LoadTable();
                },
                error: function (data) {
                    LoadTable();
                }
            });
        }
    }

    function Edit(employeeId) {
        window.location.href = '/Admin/EditUser?id=' + employeeId;

    }

    function ResetModal() {
        $("#ApplicationUser_Id").val('');
        $("#ApplicationUser_FullName").val('');
        $("#ApplicationUser_Email").val('');
        $("#ApplicationUser_PassCode").val('');
        $("#UserImage").attr('value', '');
        $("#uploadedImg").attr('src', '');
    }

    function ViewModal() {
        $("#ApplicationUser_FullName").attr('readonly', true);
        $("#ApplicationUser_Email").attr('readonly', true);
        $("#ApplicationUser_PassCode").attr('readonly', true);
        //$("#UserImage").hide();
        $("#lbl-UserImage").hide();
        $("#btn-removeImg").hide();
        $("#div-submit").hide();
    }

    function EditableModal() {
        $("#ApplicationUser_FullName").attr('readonly', false);
        $("#ApplicationUser_Email").attr('readonly', false);
        $("#ApplicationUser_PassCode").attr('readonly', false);
        //$("#UserImage").show();
        $("#lbl-UserImage").show();
        //$("#btn-removeImg").show();
        $("#div-submit").show();
    }


    function RemoveImg() {
        $("#UserImage").attr('value', '');
        $("#uploadedImg").attr('src', '');
        $("#isImgChanged").val('false');
    }

    $("#UserImage").click(function () {
        $("#UserImage").attr('value', '');
        $("#uploadedImg").attr('src', '');
    });


    $("#UserImage").change(function () {
        $("#isImgChanged").val('true');
    });

    $("#UserImage").click(function () {
        this.value = null;
        //CheckHasImage();
    });

    function OpenViewModal(employeeId) {
        ResetModal();
        OpenEditModal(employeeId, "View");
        ViewModal();
    }

</script>
}











