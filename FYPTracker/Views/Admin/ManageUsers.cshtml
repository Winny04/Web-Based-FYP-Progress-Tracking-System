    function LoadTable() {
        $.post("@Url.Action("ManageUsersData")", { DepartmentName: $('#SearchDepartmentName').val() }, function (d) {
            $("#mytable").DataTable(
                {
                    dom: 'ltip',
                    buttons: [],
                    processing: true,
                    searching: true,
                    destroy: true,
                    data: d.data,
                    columnDefs: [
                        {
                            "defaultContent": "-",
                            "targets": "_all"
                        }, 
                        {
                            targets: 1,
                            createdCell: function (td) {
                                // Default styling
                            }
                        },
                        {
                            targets: [2, 3, 4, 5, 6, 7, 8],
                            createdCell: function (td, cellData, rowData, row, col) {
                                // Default styling
                            }
                        },
                        {
                            targets: 9,
                            createdCell: function (td, cellData, rowData, row, col) {
                                $(td).addClass('text-end');
                            }
                        },
                        {
                            "targets": 6, "render": function (data, type, row, meta) {
                                return data ? moment(data.toString()).format('DD MMM YYYY HHmm') : '-';
                            }
                        }],
                    order: [[0, 'desc']],// order by ID desc (newest first)
                    aoColumns: [
                        { mData: "id", visible: false },
                        {
                            render: function (data, type, row, meta) {
                                let imageComponent = ""

                                if (row.image !== "") {
                                    imageComponent = '<div class="symbol symbol-35px me-3"><img alt="Pic" src="' + row.image + '" onerror="this.onerror=null;this.src=\'/assets/media/avatars/blank.png\';" /></div>';
                                } else {
                                    imageComponent = '<div class="symbol symbol-35px me-3"><span class="symbol-label bg-light-danger text-danger fw-bolder">' + row.fullName.charAt(0).toUpperCase() + '</span></div>'
                                }

                                let detailComponent = '<div class="d-flex justify-content-start flex-column"><span class="text-dark fw-bolder fs-7">' + row.fullName + '</span><span class="text-muted fs-8">ID: ' + (row.employeeId || 'N/A') + '</span><span class="text-muted fs-8 text-truncate" style="max-width:180px;" title="' + row.email + '">' + row.email + '</span></div>';
                                let fullComponent = '<div class="d-flex align-items-center">' + imageComponent + detailComponent + '</div>';

                                return fullComponent;
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if (type === 'display') {
                                    let badge = '<span class="fw-bold">' + row.userType + '</span>';
                                    if (row.isProfileIncomplete) {
                                        badge += '<br><span class="badge badge-light-warning fs-8 mt-1 border border-warning" data-bs-toggle="tooltip" title="Missing required profile configuration"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Pending Config</span>';
                                    }
                                    return badge;
                                }
                                return row.userType;
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if(row.userType === 'Student') {
                                    return '<span class="text-dark fw-bold">' + (row.supervisorName || 'Not Assigned') + '</span>';
                                }
                                return '-';
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if(row.userType === 'Supervisor' || row.userType === 'Examiner') {
                                    return '<span class="text-dark fw-bold">' + (row.assignedStudents || 'No Students') + '</span>';
                                }
                                return '-';
                            }
                        },
                        { 
                            render: function (data, type, row, meta) {
                                if(row.userType === 'Supervisor' || row.userType === 'Examiner') {
                                    return '<span class="text-dark fw-bold">' + (row.assignedStudentCount || '0') + '</span>';
                                }
                                return '-';
                            }
                        },
                        { mData: "dateCreated" },
                        {
                            render: function (data, type, row, meta) {
                                if(row.isResign){
                                    return '<div class="badge badge-light-danger">Inactive</div>';
                                }
                                else{
                                    return '<div class="badge badge-light-success">Active</div>';
                                }
                            }
                        },
                        {
                            render: function (data, type, row, meta) {
                                if (row.requirePasswordChange) {
                                    return '<span class="badge badge-light-warning fw-bold fs-7"><i class="bi bi-clock-history text-warning me-1"></i>Not Logged In</span>';
                                } else {
                                    return '<span class="badge badge-light-success fw-bold fs-7"><i class="bi bi-check-circle-fill text-success me-1"></i>Logged In</span>';
                                }
                            }
                        },
                        {
                            render: function (data, type, row, meta) {
                                let buttonComponent = '<div class="action-btn-group justify-content-end">';
                                buttonComponent += '<a id="edit_' + row.id + '" onclick="Edit(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><i class="bi bi-pencil-fill fs-4"></i></a>';
                                // Resend invite button — only for users who haven't activated yet
                                if (row.requirePasswordChange) {
                                    buttonComponent += '<a id="resend_' + row.id + '" onclick="ResendInvite(' + row.id + ', \'' + row.fullName + '\')" class="btn btn-icon btn-bg-light btn-active-color-info btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Resend Login Credentials"><i class="bi bi-send-fill fs-4 text-info"></i></a>';
                                }
                                if (row.isResign) {
                                    buttonComponent += '<a id="activate_' + row.id + '" onclick="Activate(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-success btn-sm" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Activate"><i class="bi bi-check-circle-fill fs-4 text-success"></i></a>';
                                } else {
                                    buttonComponent += '<a id="deactivate_' + row.id + '" onclick="Delete(' + row.id + ')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Deactivate"><i class="bi bi-slash-circle-fill fs-4 text-warning"></i></a>';
                                }
                                buttonComponent += '<a id="harddelete_' + row.id + '" onclick="HardDeleteUser(' + row.id + ', \'' + row.fullName + '\')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Permanently Delete"><i class="bi bi-trash-fill fs-4 text-danger"></i></a>';
                                buttonComponent += '</div>';
                                return buttonComponent;
                            }
                        }
                    ],
                }
            )

        });
    }

