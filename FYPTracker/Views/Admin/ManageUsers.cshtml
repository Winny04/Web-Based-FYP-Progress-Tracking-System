    function Edit(employeeId) {
        $.ajax({
            type: "GET",
            url: '/Admin/GetUserDetails',
            data: { id: employeeId },
            success: function (data) {
                if (data.success) {
                    $('#editUserId').val(data.id);
                    $('#editUserType').val(data.userType);
                    $('#editFullName').val(data.fullName);
                    $('#editEmail').val(data.email);
                    $('#editPhone').val(data.phone);

                    var uType = (data.userType || "").toLowerCase();
                    var isStudent = uType.includes('student');
                    var isAcademicStaff = uType.includes('supervisor') || uType.includes('examiner');

                    if (isStudent || isAcademicStaff) {
                        $('#editLookupFields').show();

                        if (isStudent) {
                            $('#editDeptContainer').hide();
                            $('#editDepartment').val('');
                            $('#editSpecContainer').hide();
                            $('#editProgContainer').hide();
                            $('#editStudentFields').show();
                            // Programme: ensure option exists before selecting
                            if (data.programme) {
                                var $progSel = $('#editStudentProgramme');
                                if ($progSel.find('option[value="' + data.programme + '"]').length === 0) {
                                    $progSel.append(new Option(data.programme, data.programme));
                                }
                                $progSel.val(data.programme);
                            }
                            // Academic Session: ensure option exists before selecting
                            if (data.academicSession) {
                                var $sessSel = $('#editAcademicSession');
                                if ($sessSel.find('option[value="' + data.academicSession + '"]').length === 0) {
                                    $sessSel.append(new Option(data.academicSession, data.academicSession));
                                }
                                $sessSel.val(data.academicSession);
                            }
                        } else if (isAcademicStaff) {
                            $('#editDeptContainer').show();
                            $('#editSpecContainer').show();
                            $('#editProgContainer').show();
                        }

                        $('#editDepartment').val(data.department);
                        
                        var progArray = data.programme ? data.programme.split(',').map(s => s.trim()) : [];
                        $('#editProgramme').val(progArray).trigger('change');
                        
                        var specArray = data.specialization ? data.specialization.split(',').map(s => s.trim()) : [];
                        $('#editSpecialization').val(specArray).trigger('change');
                    } else {
                        $('#editLookupFields').hide();
                    }

                    if (isStudent) {
                        // editStudentFields already shown above
                        $('#editSupervisorFields').hide();
                    } else if (isAcademicStaff) {
                        $('#editStudentFields').hide();
                        $('#editSupervisorFields').show();
                        $('#editTitle').val(data.title);
                        $('#editMaxSlots').val(data.maxStudentSlots);
                        
                        // Populate checkboxes based on current roles
                        $('#editRoleSup').prop('checked', data.userType && data.userType.includes('Supervisor'));
                        $('#editRoleExm').prop('checked', data.userType && data.userType.includes('Examiner'));
                    } else {
                        $('#editStudentFields').hide();
                        $('#editSupervisorFields').hide();
                    }
                    
                    // Clear previous validation states
                    $('#editPhoneError').text("");
                    $('#editPhone').removeClass('is-invalid');
                    $('#editEmailError').text("");
                    $('#editEmail').removeClass('is-invalid');
                    
                    $('#editAccModal').modal('show');
                } else {
                    Swal.fire({ text: data.msg || "Could not fetch user details.", icon: "error", confirmButtonText: "Ok, got it!" });
                }
            },
            error: function () {
                Swal.fire({ text: "Server error while fetching user details.", icon: "error", confirmButtonText: "Ok, got it!" });
            }
        });
    }

    $('#btn_edit_submit').click(function () {
        var id = $('#editUserId').val();
        var fullName = $('#editFullName').val().trim();
        var email = $('#editEmail').val().trim();
        var phone = $('#editPhone').val().trim();
        var department = $('#editDepartment').val();
        
        var userType = $('#editUserType').val();
        
        // For students, read from the student-specific dropdowns
        var programme, specialization, academicSession;
        if (userType === 'Student' || userType === 'STUDENT') {
            programme = $('#editStudentProgramme').val() || '';
            specialization = '';
            academicSession = $('#editAcademicSession').val() || '';
        } else {
            var progVal = $('#editProgramme').val();
            programme = Array.isArray(progVal) ? progVal.join(', ') : (progVal || '');
            var specVal = $('#editSpecialization').val();
            specialization = Array.isArray(specVal) ? specVal.join(', ') : (specVal || '');
            academicSession = '';
        }
        
        var title = $('#editTitle').val().trim();

        // Clear previous inline errors
        $('#editEmailError').text('');
        $('#editStudentProgrammeError').text('');
        $('#editAcademicSessionError').text('');
        $('#editTitleError').text('');
        $('#editDepartmentError').text('');

        if (!fullName) {
            Swal.fire({ text: "Please enter a full name.", icon: "warning", confirmButtonText: "Ok, got it!" });
            return;
        }

        if (!email) {
            $('#editEmailError').text('Please enter an email.');
            return;
        }

        const emailPattern = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;
        if (!emailPattern.test(email)) {
            $('#editEmailError').text('Please enter a valid email address.');
            return;
        }


        if (userType === "Student" || userType === "STUDENT") {
            if (!programme) {
                $('#editStudentProgrammeError').text('Please select a Programme.');
                return;
            }
            if (!academicSession) {
                $('#editAcademicSessionError').text('Please select an Academic Session.');
                return;
            }
        }

        if (userType === "Supervisor") {
            if (!title) {
                $('#editTitleError').text('Please select a Title.');
                return;
            }
            if (!department) {
                $('#editDepartmentError').text('Please select a Department.');
                return;
            }
        }

        const phonePattern = /^01[0-9]-?\d{7,8}$/;
        if (phone && !phonePattern.test(phone)) {
            Swal.fire({ text: "Please enter a valid Malaysian mobile number (e.g. 012-3456789).", icon: "warning", confirmButtonText: "Ok, got it!" });
            return;
        }

        var roles = [];
        if (userType !== "Student" && userType !== "STUDENT") {
            if ($('input[name="editAcademicRoles"]:checked').length === 0) {
                $('#editAcademicRoleError').show();
                return;
            } else {
                $('#editAcademicRoleError').hide();
                $('input[name="editAcademicRoles"]:checked').each(function() {
                    roles.push($(this).val());
                });
            }
        }

        $.ajax({
            url: "/Admin/UpdateUserModal", method: "POST",
            data: { 
                id: id, 
                fullName: fullName,
                email: email, 
                phone: phone, 
                department: department, 
                programme: programme, 
                specialization: specialization, 
                academicSession: academicSession, 
                title: title,
                maxStudentSlots: $('#editMaxSlots').val(),
                roles: roles
            },
            success: function (r) {
                if (r.status) {
                    $('#editAccModal').modal('hide');
                    Swal.fire({ text: r.msg, icon: "success", confirmButtonText: "Ok, got it!" }).then(function () { LoadTable(); });
                } else {
                    Swal.fire({ text: r.msg, icon: "warning", confirmButtonText: "Ok, got it!" });
                }
            },
            error: function () {
                Swal.fire({ text: "An error occurred. Please try again.", icon: "error", confirmButtonText: "Ok, got it!" });
            }
        });
    });

    // Real-time email validation
    const editEmailInput = document.getElementById('editEmail');
    const editEmailError = document.getElementById('editEmailError');
    const editEmailPattern = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;

    if (editEmailInput) {
        editEmailInput.addEventListener('input', function() {
            if (this.value && !editEmailPattern.test(this.value)) {
                editEmailError.innerText = "Please enter a valid email format.";
                this.classList.add('is-invalid');
            } else {
                editEmailError.innerText = "";
                this.classList.remove('is-invalid');
            }
        });
    }

    // Real-time phone validation for Edit modal
    const editPhoneInput = document.getElementById('editPhone');
    const editPhoneError = document.getElementById('editPhoneError');
    const editPhonePattern = /^01[0-9]-?\d{7,8}$/;

    if (editPhoneInput) {
        editPhoneInput.addEventListener('input', function() {
            if (this.value && !editPhonePattern.test(this.value)) {
                editPhoneError.innerText = "Please enter a valid Malaysian mobile number (e.g. 012-3456789).";
                this.classList.add('is-invalid');
            } else {
                editPhoneError.innerText = "";
                this.classList.remove('is-invalid');
            }
        });
    }

    // Clear dropdown errors on change
    $(document).ready(function() {
        $('#editStudentProgramme, #editAcademicSession, #editTitle, #editDepartment').on('change', function() {
            $(this).siblings('.text-danger').text('');
        });
    });

    // ── Tab Filtering Logic ────────────────────────────────────
    function filterUserType(e, type) {
        e.preventDefault();
        const table = $("#mytable").DataTable();
        
        let searchRegex = '';
        if (type === 'AcademicStaff') {
            searchRegex = 'Supervisor|Examiner';
        } else if (type) {
            searchRegex = '\\b' + type + '\\b';
        }

        // Filter by user type column (index 2) using regex for exact or partial word match
        table.column(2).search(searchRegex, true, false).draw();
        
        // Dynamically hide/show columns based on the role
        // Column 3 is Supervisor (for Students), Column 4 is Assigned Students (for Supervisors/Examiners), Column 5 is Student Count
        if (type === 'Student') {
            table.column(3).visible(true);
            table.column(4).visible(false);
            table.column(5).visible(false);
        } else if (type === 'AcademicStaff' || type === 'Supervisor' || type === 'Examiner') {
            table.column(3).visible(false);
            table.column(4).visible(true);
            table.column(5).visible(true);
        } else {
            table.column(3).visible(true);
            table.column(4).visible(true);
            table.column(5).visible(true);
        }

        // Update active tab styling
        $('#userRoleTabs .nav-link').removeClass('active text-primary').addClass('text-muted');
        $(e.target).removeClass('text-muted').addClass('active text-primary');
    }

    $(document).ready(function () {
        // Toggle domain based on User Type
        $('#bulkUserType').on('change', function () {
            let type = $(this).val();
            let domain = type === 'Student' ? '@@student.newinti.edu.my' : '@@newinti.edu.my';
            $('#sharedDomain').val(domain);
            updateHiddenEmails();
            validateAllRows();
        });

        // Add Invitee Row
        $('#addInviteeBtn').click(function () {
            addInviteeRow();
        });

        // Remove Invitee Row
        $(document).on('click', '.remove-invitee', function () {
            if ($('.invitee-row').length > 1) {
                $(this).closest('.invitee-row').remove();
                updateRemoveButtons();
                updateHiddenEmails();
                validateAllRows();
            }
        });
        
        // Paste Multiple Handlers
        $('#pasteMultipleBtn').click(function() {
            $('#pasteMultipleSection').slideDown();
            $('#pasteMultipleArea').focus();
        });
        $('#cancelPasteBtn').click(function() {
            $('#pasteMultipleSection').slideUp();
            $('#pasteMultipleArea').val('');
        });
        $('#processPasteBtn').click(function() {
            let pasteData = $('#pasteMultipleArea').val();
            if (!pasteData) {
                $('#pasteMultipleSection').slideUp();
                return;
            }
            
            let rawItems = pasteData.split(/[\n\r,]+/).map(s => s.trim()).filter(s => s.length > 0);
            let extractedUsernames = [];

            rawItems.forEach(item => {
                if (item.includes('@@')) {
                    extractedUsernames.push(item.split('@@')[0]);
                } else {
                    extractedUsernames.push(item);
                }
            });

            if (extractedUsernames.length > 0) {
                // If there's only one empty row, fill it first
                let rows = $('.invitee-row');
                let firstRow = rows.first();
                let firstInput = firstRow.find('.username-input');
                let startIndex = 0;
                
                if (rows.length === 1 && !firstInput.val()) {
                    firstInput.val(extractedUsernames[0]);
                    startIndex = 1;
                }
                
                for (let i = startIndex; i < extractedUsernames.length; i++) {
                    let newRow = addInviteeRow();
                    newRow.find('.username-input').val(extractedUsernames[i]);
                }
                updateHiddenEmails();
                validateAllRows();
            }
            $('#pasteMultipleSection').slideUp();
            $('#pasteMultipleArea').val('');
        });

        // Validation on input
        $(document).on('input', '.username-input', function() {
            updateHiddenEmails();
            validateAllRows();
        });

        function updateHiddenEmails() {
            let domain = $('#sharedDomain').val();
            $('.invitee-row').each(function() {
                let username = $(this).find('.username-input').val().trim();
                let fullEmail = username ? username + domain : '';
                $(this).find('.full-email-hidden').val(fullEmail);
            });
        }

        let validationTimer = null;

        function validateAllRows() {
            clearTimeout(validationTimer);
            let usernames = [];
            let emailsToCheck = [];
            let localErrors = 0;
            let validRows = 0;
            let domain = $('#sharedDomain').val();
            
            $('.invitee-row').each(function() {
                let row = $(this);
                let input = row.find('.username-input');
                let username = input.val().trim();
                let type = $('#bulkUserType').val();
                
                if (type === 'Supervisor' || type === 'Examiner') {
                    username = username.toLowerCase();
                    if (input.val() !== username) {
                        input.val(username); // auto-normalize UI
                    }
                }
                
                let badge = row.find('.status-badge');
                
                if (!username) {
                    badge.removeClass().addClass('badge badge-light-danger status-badge w-100').text('Invalid Username');
                    row.find('.error-msg').remove();
                    input.addClass('is-invalid');
                    localErrors++;
                } else {
                    let isValid = true;
                    let errorMsg = '';
                    
                    if (type === 'Student') {
                        if (!/^p\d{8}$/.test(username)) {
                            isValid = false;
                            errorMsg = 'Student ID must be in the format p followed by 8 digits, e.g. p22014692.';
                        }
                    } else {
                        // Supervisor or Examiner
                        if (!/^[a-z0-9.-]+$/.test(username) || username.includes('@@') || username.includes(' ')) {
                            isValid = false;
                            errorMsg = 'Invalid username format';
                        }
                    }

                    if (!isValid) {
                        badge.removeClass().addClass('badge badge-light-danger status-badge w-100').text('Invalid Username');
                        if (row.find('.error-msg').length === 0) {
                            input.after(`<div class="text-danger fs-8 mt-1 error-msg">${errorMsg}</div>`);
                        } else {
                            row.find('.error-msg').text(errorMsg);
                        }
                        input.addClass('is-invalid');
                        localErrors++;
                    } else if (usernames.includes(username)) {
                        badge.removeClass().addClass('badge badge-light-warning status-badge w-100').text('Duplicate in List');
                        row.find('.error-msg').remove();
                        input.addClass('is-invalid');
                        localErrors++;
                    } else {
                        usernames.push(username);
                        emailsToCheck.push(username + domain);
                        badge.removeClass().addClass('badge badge-light-info status-badge w-100').text('Checking...');
                        row.find('.error-msg').remove();
                        input.removeClass('is-invalid');
                        validRows++;
                    }
                }
            });
            
            $('#bulkInviteSubmitBtn').prop('disabled', true);
            updateRemoveButtons(0); // Temporarily hide count during check

            if (emailsToCheck.length === 0) {
                $('#bulkInviteSubmitBtn').prop('disabled', localErrors > 0);
                return;
            }

            validationTimer = setTimeout(function() {
                $.ajax({
                    url: '/Admin/CheckBulkEmails',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(emailsToCheck),
                    success: function (results) {
                        let remoteErrors = 0;
                        let finalValidRows = 0;
                        $('.invitee-row').each(function() {
                            let row = $(this);
                            let input = row.find('.username-input');
                            let username = input.val().trim();
                            let badge = row.find('.status-badge');
                            
                            if (badge.text() === 'Checking...') {
                                // AJAX response keys might just be emails, but we normalized them to lowercase
                                let fullEmail = (username + domain).toLowerCase();
                                
                                // We check against results dictionary by matching keys
                                let foundResult = null;
                                for (let key in results) {
                                    if (key.toLowerCase() === fullEmail) {
                                        foundResult = results[key];
                                        break;
                                    }
                                }

                                if (foundResult) {
                                    input.addClass('is-invalid');
                                    remoteErrors++;
                                    if (foundResult === 'Pending') {
                                        badge.removeClass().addClass('badge badge-light-warning status-badge w-100').text('Invitation already sent');
                                    } else {
                                        badge.removeClass().addClass('badge badge-light-danger status-badge w-100').text('Already registered');
                                    }
                                } else {
                                    badge.removeClass().addClass('badge badge-light-success status-badge w-100').text('Ready');
                                    finalValidRows++;
                                }
                            }
                        });
                        
                        $('#bulkInviteSubmitBtn').prop('disabled', localErrors > 0 || remoteErrors > 0 || finalValidRows === 0);
                        updateRemoveButtons(finalValidRows);
                    },
                    error: function() {
                        // On error, let them submit but they will fail at backend validation
                        $('#bulkInviteSubmitBtn').prop('disabled', localErrors > 0);
                        updateRemoveButtons(validRows);
                    }
                });
            }, 300); // 300ms debounce
        }

        function addInviteeRow() {
            let rowHtml = `
                <tr class="invitee-row">
                    <td>
                        <input type="text" name="inviteNames" class="form-control form-control-solid form-control-sm fs-8" placeholder="Full Name (Optional)">
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-solid form-control-sm fs-8 username-input" placeholder="Username *" required>
                        <input type="hidden" name="inviteEmails" class="full-email-hidden">
                    </td>
                    <td class="text-center">
                        <span class="badge badge-light-secondary status-badge w-100 fs-8">Ready</span>
                    </td>
                    <td class="text-end pe-4">
                        <button type="button" class="btn btn-icon btn-light-danger btn-sm h-30px w-30px remove-invitee"><i class="bi bi-trash fs-7"></i></button>
                    </td>
                </tr>
            `;
            let newRow = $(rowHtml);
            $('#inviteesList').append(newRow);
            
            // Auto scroll to bottom
            let container = $('.bulk-invite-scroll');
            if (container.length) {
                container.scrollTop(container[0].scrollHeight);
            }
            
            updateRemoveButtons(0);
            return newRow;
        }

        function updateRemoveButtons(validCount = 0) {
            let count = $('.invitee-row').length;
            if (count === 1) {
                $('.remove-invitee').prop('disabled', true);
            } else {
                $('.remove-invitee').prop('disabled', false);
            }
            $('#inviteCountTitle').text(count);
            $('#bulkInviteSubmitBtn').text(`Send ${validCount} Invite${validCount !== 1 ? 's' : ''}`);
        }
        
        // Initial setup
        validateAllRows();
    });
</script>











