@{
    ViewData["Title"] = "Admin Dashboard";
    var currentUser = ViewBag.CurrentUser as ApplicationUser;
}

<div class="container-fluid py-4">


    @* ── Welcome Hero ───────────────────────────────────────── *@
    <div class="welcome-hero d-flex justify-content-between align-items-center flex-wrap gap-4 mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-2">Welcome back, @currentUser?.FullName!</h1>
            <!-- <div class="d-flex align-items-center gap-3 flex-wrap opacity-90" style="font-size: 0.9rem;">
                <span><strong>Role:</strong> Administrator</span>
                <span class="text-muted">|</span>
                <span><strong>Employee ID:</strong> @(currentUser?.EmployeeId ?? "—")</span>
            </div> -->
        </div>
    </div>

    @* ── Stats Grid ─────────────────────────────────────────── *@
    <div class="row g-4 mb-4">
        <!-- Students -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="opacity-75 fw-bold text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Total Students</h6>
                            <h2 class="fw-bolder mb-0">@ViewBag.TotalStudents</h2>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-3">
                            <i class="fas fa-user-graduate fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Supervisors -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="opacity-75 fw-bold text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Supervisors</h6>
                            <h2 class="fw-bolder mb-0">@ViewBag.TotalSupervisors</h2>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-3">
                            <i class="fas fa-chalkboard-teacher fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Projects -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="opacity-75 fw-bold text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Total Projects</h6>
                            <h2 class="fw-bolder mb-0">@ViewBag.TotalProjects</h2>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-3">
                            <i class="fas fa-project-diagram fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending Requests -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
                <div class="card-body p-4 text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="opacity-75 fw-bold text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Pending Requests</h6>
                            <h2 class="fw-bolder mb-0">@ViewBag.PendingRequests</h2>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded-3 p-3">
                            <i class="fas fa-clock fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    @* ── Quick Actions ──────────────────────────────────────── *@
    <div class="row g-4">
        <div class="col-12">
            <h4 class="fw-bold mb-3">Quick Actions</h4>
        </div>
        <div class="col-md-4">
            <a href="/Admin/ManageUsers" class="card border-0 shadow-sm text-decoration-none h-100 hover-elevate-up">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-light-primary text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fas fa-users fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Manage Users</h5>
                        <p class="text-muted mb-0 small">Add, edit, or remove system users</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Admin/ManageProjects" class="card border-0 shadow-sm text-decoration-none h-100 hover-elevate-up">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-light-success text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fas fa-project-diagram fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Manage Projects</h5>
                        <p class="text-muted mb-0 small">View all final year projects</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Admin/DefenseList" class="card border-0 shadow-sm text-decoration-none h-100 hover-elevate-up">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-light-danger text-danger rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fas fa-shield-alt fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Defense List</h5>
                        <p class="text-muted mb-0 small">Students requiring defense sessions</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .hover-elevate-up {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-elevate-up:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
