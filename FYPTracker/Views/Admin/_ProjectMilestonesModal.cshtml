@using FYPTracker.Models
@model FYPProject
@{
    var milestones = Model.Milestones?.ToList() ?? new List<FYPMilestone>();
    var currentExaminer = Model.AssignedExaminers?.FirstOrDefault()?.Examiner;

    var stage1Milestones = milestones
        .Where(m => m.Stage == 1)
        .OrderBy(m => m.DueDate ?? DateTime.MaxValue)
        .ToList();

    var stage2Milestones = milestones
        .Where(m => (m.Stage == 2 || (m.Stage != 1 && m.Title.StartsWith("Step", StringComparison.OrdinalIgnoreCase)))
                    && !FYPTracker.Utils.GradingHelper.IsObsoleteOrRetiredStage2Milestone(m))
        .OrderBy(m => m.DueDate ?? DateTime.MaxValue)
        .ToList();

    var otherMilestones = milestones
        .Where(m => !stage1Milestones.Contains(m) && !stage2Milestones.Contains(m) && !FYPTracker.Utils.GradingHelper.IsObsoleteOrRetiredStage2Milestone(m))
        .OrderBy(m => m.DueDate ?? DateTime.MaxValue)
        .ToList();

    bool IsApproved(FYPMilestone m) =>
        m.Status == "Approved" || m.Status == "Completed" || m.Status == "AdminApproved" || m.Status == "SupervisorSigned";

    bool IsUnderReview(FYPMilestone m) =>
        m.Status == "Submitted" || m.Status == "UnderReview" || m.Status == "PendingSupervisorReview";

    bool IsRejected(FYPMilestone m) =>
        m.Status == "Rejected" || m.Status == "Revision" || m.Status == "ReturnedForChanges" || m.Status == "ReturnedForEdits";

    int stage1Total = stage1Milestones.Count;
    int stage1Approved = stage1Milestones.Count(IsApproved);
    int stage2Total = stage2Milestones.Count;
    int stage2Approved = stage2Milestones.Count(IsApproved);

    string studentInitials = !string.IsNullOrWhiteSpace(Model.Student?.FullName)
        ? string.Join("", Model.Student.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]))
        : "ST";
}

<!-- Project & Stakeholders Overview -->
<div class="row g-3 mb-4">
    <!-- Student & Project Info -->
    <div class="col-lg-6">
        <div class="card border border-gray-200 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bolder d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.1rem;">
                        @studentInitials
                    </div>
                    <div class="overflow-hidden">
                        <div class="fw-bolder text-dark fs-5 text-truncate" title="@Model.Student?.FullName">@(Model.Student?.FullName ?? "Unknown Student")</div>
                        <div class="text-muted small">
                            <span class="me-2"><i class="fas fa-id-badge text-muted me-1"></i>@(Model.Student?.EmployeeId ?? "No ID")</span>
                            <span><i class="fas fa-envelope text-muted me-1"></i>@(Model.Student?.Email ?? "No Email")</span>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-bold text-uppercase">Project Title</span>
                        <span class="badge @(Model.Status == "Approved" || Model.Status == "Active" ? "bg-light-success text-success" : (Model.Status == "Completed" ? "bg-light-primary text-primary" : "bg-light-warning text-warning")) fw-bold px-3 py-1">
                            @Model.Status
                        </span>
                    </div>
                    <div class="fw-bold text-dark fs-6 mb-2">@Model.Title</div>
                    <div class="d-flex flex-wrap gap-3 text-muted small">
                        <span><i class="far fa-calendar text-muted me-1"></i>Session: <strong>@(Model.AcademicSession ?? "Default")</strong></span>
                        @if (Model.StartDate.HasValue)
                        {
                            <span><i class="far fa-clock text-muted me-1"></i>Started: <strong>@Model.StartDate.Value.ToString("dd MMM yyyy")</strong></span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Supervisor, Examiner & Viva -->
    <div class="col-lg-6">
        <div class="card border border-gray-200 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4">
                <div class="row g-3">
                    <!-- Supervisor -->
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-light h-100 border border-gray-100">
                            <div class="text-muted small fw-bold text-uppercase mb-1"><i class="fas fa-chalkboard-teacher text-primary me-1"></i> Supervisor</div>
                            @if (Model.Supervisor != null)
                            {
                                <div class="fw-bold text-dark fs-6 text-truncate" title="@Model.Supervisor.FullName">@Model.Supervisor.FullName</div>
                                <div class="text-muted small text-truncate" title="@Model.Supervisor.Email">@Model.Supervisor.Email</div>
                            }
                            else
                            {
                                <span class="badge bg-light-danger text-danger fw-bold">Not Assigned</span>
                            }
                        </div>
                    </div>

                    <!-- Examiner -->
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-light h-100 border border-gray-100">
                            <div class="text-muted small fw-bold text-uppercase mb-1"><i class="fas fa-user-check text-info me-1"></i> Examiner</div>
                            @if (currentExaminer != null)
                            {
                                <div class="fw-bold text-dark fs-6 text-truncate" title="@currentExaminer.FullName">@currentExaminer.FullName</div>
                                <div class="text-muted small text-truncate" title="@currentExaminer.Email">@currentExaminer.Email</div>
                            }
                            else
                            {
                                <span class="badge bg-light-danger text-danger fw-bold">Not Assigned</span>
                            }
                        </div>
                    </div>

                    <!-- Viva Oral Examination -->
                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-light border border-gray-100 d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <div class="text-muted small fw-bold text-uppercase mb-1"><i class="fas fa-calendar-check text-success me-1"></i> Viva Oral Examination</div>
                                @if (Model.VivaDate.HasValue)
                                {
                                    <div class="fw-bold text-success fs-6">@Model.VivaDate.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                                    <div class="text-muted small">Venue: <strong>@(string.IsNullOrWhiteSpace(Model.VivaVenue) ? "TBA" : Model.VivaVenue)</strong></div>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Not scheduled yet</span>
                                }
                            </div>
                            @if (Model.VivaDate.HasValue)
                            {
                                if (Model.VivaDate.Value <= DateTime.Now)
                                {
                                    <span class="badge bg-light-primary text-primary fw-bold px-3 py-2">Concluded</span>
                                }
                                else
                                {
                                    <span class="badge bg-light-success text-success fw-bold px-3 py-2">Upcoming</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Academic & Grading Status Cards -->
<div class="row g-3 mb-4">
    <!-- Stage 1 Grade & Marksheet -->
    <div class="col-md-4">
        <div class="card border border-gray-200 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase">Stage 1 Evaluation</span>
                    @if (Model.Stage1Grade == "Pass")
                    {
                        <span class="badge bg-success rounded-pill px-3 py-1"><i class="fas fa-check-circle me-1"></i>Pass</span>
                    }
                    else if (Model.Stage1Grade == "Fail")
                    {
                        <span class="badge bg-danger rounded-pill px-3 py-1"><i class="fas fa-times-circle me-1"></i>Fail</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill px-3 py-1 text-dark">@(Model.Stage1Grade ?? "Pending")</span>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-baseline">
                    <div>
                        <div class="text-muted small">Score</div>
                        <div class="fs-4 fw-bolder text-dark">@(Model.Stage1TotalScore.HasValue ? $"{Model.Stage1TotalScore.Value:0.00}%" : "—")</div>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small">Examiner Marksheet</div>
                        @if (!string.IsNullOrEmpty(Model.Stage1ExaminerMarksheetPath))
                        {
                            <span class="badge bg-light-success text-success fw-bold px-2 py-1"><i class="fas fa-file-check me-1"></i>Submitted</span>
                        }
                        else
                        {
                            <span class="badge bg-light-secondary text-muted fw-bold px-2 py-1">Pending</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stage 2 / Final Grade -->
    <div class="col-md-4">
        <div class="card border border-gray-200 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase">Final Completion Grade</span>
                    @if (!string.IsNullOrWhiteSpace(Model.FinalGrade))
                    {
                        <span class="badge bg-primary rounded-pill px-3 py-1"><i class="fas fa-award me-1"></i>@Model.FinalGrade</span>
                    }
                    else
                    {
                        <span class="badge bg-light-secondary text-muted rounded-pill px-3 py-1">In Progress</span>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-baseline">
                    <div>
                        <div class="text-muted small">Project Status</div>
                        <div class="fs-5 fw-bolder text-dark">@Model.Status</div>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small">Stage 2 Marksheets</div>
                        @if (!string.IsNullOrEmpty(Model.ExaminerMarksheetPath) || !string.IsNullOrEmpty(Model.Stage2ExaminerMarksheetData))
                        {
                            <span class="badge bg-light-success text-success fw-bold px-2 py-1"><i class="fas fa-check-circle me-1"></i>Graded</span>
                        }
                        else
                        {
                            <span class="badge bg-light-secondary text-muted fw-bold px-2 py-1">Pending</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Milestone Completion Progress -->
    <div class="col-md-4">
        <div class="card border border-gray-200 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3">
                <span class="text-muted small fw-bold text-uppercase d-block mb-2">Milestone Completion</span>
                <div class="mb-2">
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span>Stage 1</span>
                        <span>@stage1Approved / @stage1Total Approved</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @(stage1Total > 0 ? (stage1Approved * 100 / stage1Total) : 0)%"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span>Stage 2</span>
                        <span>@stage2Approved / @stage2Total Approved</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(stage2Total > 0 ? (stage2Approved * 100 / stage2Total) : 0)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Milestones Section with Tabs -->
<div class="card border border-gray-200 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-header bg-light border-bottom px-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <ul class="nav nav-pills card-header-pills" id="modalMilestoneTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold py-2 px-3 rounded-pill" id="stage1-tab" data-bs-toggle="pill" data-bs-target="#modalStage1Pane" type="button" role="tab" aria-selected="true">
                    <i class="fas fa-layer-group me-1"></i> Stage 1 Milestones
                    <span class="badge bg-light text-dark ms-1">@stage1Approved/@stage1Total</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-2 px-3 rounded-pill" id="stage2-tab" data-bs-toggle="pill" data-bs-target="#modalStage2Pane" type="button" role="tab" aria-selected="false">
                    <i class="fas fa-flag-checkered me-1"></i> Stage 2 Milestones
                    <span class="badge bg-light text-dark ms-1">@stage2Approved/@stage2Total</span>
                </button>
            </li>
            @if (otherMilestones.Any())
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold py-2 px-3 rounded-pill" id="other-tab" data-bs-toggle="pill" data-bs-target="#modalOtherPane" type="button" role="tab" aria-selected="false">
                        <i class="fas fa-ellipsis-h me-1"></i> Other Milestones
                        <span class="badge bg-light text-dark ms-1">@otherMilestones.Count</span>
                    </button>
                </li>
            }
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold py-2 px-3 rounded-pill" id="all-tab" data-bs-toggle="pill" data-bs-target="#modalAllPane" type="button" role="tab" aria-selected="false">
                    <i class="fas fa-list me-1"></i> All (@milestones.Count)
                </button>
            </li>
        </ul>
        <span class="text-muted small fw-semibold"><i class="fas fa-check-double text-success me-1"></i>Official FYP Tracking Records</span>
    </div>

    <div class="card-body p-0">
        <div class="tab-content" id="modalMilestoneTabsContent">
            <!-- Stage 1 Pane -->
            <div class="tab-pane fade show active" id="modalStage1Pane" role="tabpanel">
                @await Html.PartialAsync("_MilestonesTablePartial", stage1Milestones)
            </div>

            <!-- Stage 2 Pane -->
            <div class="tab-pane fade" id="modalStage2Pane" role="tabpanel">
                @await Html.PartialAsync("_MilestonesTablePartial", stage2Milestones)
            </div>

            <!-- Other Pane if exists -->
            @if (otherMilestones.Any())
            {
                <div class="tab-pane fade" id="modalOtherPane" role="tabpanel">
                    @await Html.PartialAsync("_MilestonesTablePartial", otherMilestones)
                </div>
            }

            <!-- All Milestones Pane -->
            <div class="tab-pane fade" id="modalAllPane" role="tabpanel">
                @await Html.PartialAsync("_MilestonesTablePartial", milestones)
            </div>
        </div>
    </div>
</div>
