@{
    ViewData["Title"] = "System Settings";
}

<style>
    .card {
        border: 1px solid rgba(0,0,0,0.08);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border-radius: 0.75rem;
    }
    .card-header {
        background-color: transparent;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    .form-control, .form-select {
        border-color: #dee2e6;
        border-radius: 0.375rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    /* Milestone Status Badges */
    .milestone-status-badge {
        display: inline-block;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        line-height: 1.4;
    }

    /* Active - Green */
    .milestone-status-badge.status-active {
        background-color: #d1e7dd !important;
        color: #0f5132 !important;
        border: 1px solid #a3cfbb !important;
    }

    /* Inactive - Gray */
    .milestone-status-badge.status-inactive {
        background-color: #e9ecef !important;
        color: #495057 !important;
        border: 1px solid #ced4da !important;
    }
</style>

<div class="container-xxl py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 fw-bold text-dark mb-1">System Settings</h1>
            <p class="text-muted mb-0">Manage academic deadlines, milestones, and system preferences.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["FYPSettingSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["FYPSettingSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["FYPSettingError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["FYPSettingError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["BulkUpdateSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateInfo"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["BulkUpdateInfo"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["BulkUpdateError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Global Session Filter -->
    <div class="card mb-4 border-primary border-opacity-25">
        <div class="card-body bg-light rounded bg-opacity-50 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-2 rounded">
                    <i class="fas fa-calendar-alt fs-5"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Academic Session Context</h6>
                    <small class="text-muted">Select a session to view and manage its specific milestones.</small>
                </div>
            </div>
            <form method="get" class="m-0">
                <select name="sessionFilter" class="form-select border-primary shadow-sm fw-bold" style="min-width: 200px;" onchange="this.form.submit()">
                    @if(ViewBag.DistinctSessions != null)
                    {
                        var hasSessions = false;
                        foreach (var sessionName in (IEnumerable<string>)ViewBag.DistinctSessions)
                        {
                            hasSessions = true;
                            if (ViewBag.CurrentSessionFilter == sessionName)
                            {
                                <option value="@sessionName" selected>@sessionName</option>
                            }
                            else
                            {
                                <option value="@sessionName">@sessionName</option>
                            }
                        }
                        if (!hasSessions)
                        {
                            <option value="">No Active Sessions</option>
                        }
                    }
                    else
                    {
                        <option value="">No Active Sessions</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <!-- First Row: Submission Dates & Right Tools -->
    <div class="row g-4 mb-4">
        
        <!-- Submission Dates -->
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header pt-4 pb-3">
                    <h5 class="card-title fw-bold mb-1"><i class="fas fa-calendar-check text-success me-2"></i>Submission Dates</h5>
                    <p class="text-muted small mb-0">Deadlines and request timeout</p>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateFYPSettings" method="post" class="h-100 d-flex flex-column">
                        @Html.AntiForgeryToken()
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">DPP Deadline</label>
                                <input type="date" name="dppDeadline" class="form-control" value="@ViewBag.DPPDeadline" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Exhibition Date</label>
                                <input type="date" name="exhibitionDate" class="form-control" value="@ViewBag.ExhibitionDate" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Exhibition Start Time</label>
                                <input type="time" name="exhibitionTimeStart" class="form-control" value="@ViewBag.ExhibitionTimeStart" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Exhibition End Time</label>
                                <input type="time" name="exhibitionTimeEnd" class="form-control" value="@ViewBag.ExhibitionTimeEnd" />
                            </div>
                        </div>
                        
                        <hr class="text-muted opacity-25" />
                        
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Supervisor Request Timeout</label>
                            <div class="input-group" style="max-width: 220px;">
                                <input type="number" name="supervisorRequestTimeoutDays" class="form-control" min="1" max="30" value="@ViewBag.SupervisorRequestTimeoutDays" />
                                <span class="input-group-text bg-light text-muted">days</span>
                            </div>
                            <div class="form-text mt-2 text-muted">
                                Pending requests with no response will be automatically rejected after this many days.
                            </div>
                        </div>

                        <div class="mt-auto text-end">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">Save Settings</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right side: Update Milestones & IAF -->
        <div class="col-lg-5 d-flex flex-column gap-4">
            
            <!-- Update Milestone Dates -->
            <div class="card flex-grow-1">
                <div class="card-header pt-4 pb-3">
                    <h5 class="card-title fw-bold mb-0"><i class="fas fa-sync-alt text-primary me-2"></i>Update Milestone Dates</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateDefaultMilestoneDate" method="post" id="bulkUpdateForm">
                        <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Academic Session</label>
                            <input type="text" class="form-control bg-light" value="@ViewBag.CurrentSessionFilter" disabled />
                            <div class="form-text text-muted">Updating for the session selected above.</div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Milestone</label>
                            <select name="milestoneTitle" class="form-select" required onchange="validateBulkUpdate()">
                                <option value="">Select milestone...</option>
                                <option value="IAF">FYP 1: Initial Assessment Form (IAF)</option>
                                <option value="Proposal">FYP 1: Stage 1 Final Submission</option>
                                <option value="Step 1:">Step 1: Turnitin Checking</option>
                                <option value="Step 2:">Step 2: Final Report Submission</option>
                                <option value="Step 3:">Step 3: Marksheet Submission</option>
                                <option value="Step 4:">Step 4: Record of Supervisor Meeting Form</option>
                                <option value="Step 5:">Step 5: Presentation Slides Submission</option>
                            </select>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">New Due Date</label>
                            <input type="date" name="deadline" id="bulkUpdateDate" class="form-control" required onchange="validateBulkUpdate()" />
                        </div>
                        
                        <button type="submit" id="btnBulkUpdate" class="btn btn-outline-primary w-100 shadow-sm" disabled onclick="return confirm('Are you sure you want to update deadlines for all students in this session?');">
                            Update Deadline
                        </button>
                    </form>
                </div>
            </div>

            <!-- Approved IAFs Directory -->
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div class="d-flex align-items-center gap-3 w-100">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                            <i class="fas fa-file-signature fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1">IAF Directory</h6>
                            <small class="text-muted d-block mb-3">View and manage IAF reviews and approvals.</small>
                            <a href="/Admin/ApprovedIafList" class="btn btn-sm btn-primary w-100 shadow-sm">View IAF Records</a>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>

    <!-- Default Milestones Section -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header pt-4 pb-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                    <div>
                        <h5 class="card-title fw-bold mb-1"><i class="fas fa-list-ol text-warning me-2"></i>Default Milestones — Stage 1</h5>
                        <p class="text-muted small mb-0">Manage milestones for each academic session</p>
                    </div>
                    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addTemplateModal">
                        <i class="fas fa-plus me-1"></i> Add Milestone
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 text-muted text-uppercase small fw-bold">Order</th>
                                    <th class="text-muted text-uppercase small fw-bold">Milestone</th>
                                    <th class="text-muted text-uppercase small fw-bold">Code</th>
                                    <th class="text-muted text-uppercase small fw-bold">Required</th>
                                    <th class="text-muted text-uppercase small fw-bold">Due Date</th>
                                    <th class="text-muted text-uppercase small fw-bold">Status</th>
                                    <th class="pe-4 text-end text-muted text-uppercase small fw-bold">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(ViewBag.DefaultMilestoneTemplates != null)
                                {
                                    var templates = (IEnumerable<FYPTracker.Models.DefaultMilestoneTemplate>)ViewBag.DefaultMilestoneTemplates;
                                    if(templates.Any())
                                    {
                                        foreach(var t in templates)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-bold text-muted">@t.DisplayOrder</td>
                                                <td class="fw-bold text-dark">@t.Title</td>
                                                <td><span class="badge bg-light text-dark border">@t.MilestoneCode</span></td>
                                                <td>
                                                    @if(t.IsRequired){ <span class="badge bg-primary text-white">Yes</span> }
                                                    else { <span class="badge bg-light text-dark border">No</span> }
                                                </td>
                                                <td>@(t.DueDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                                <td>
                                                    @if(t.IsActive){  <span class="badge milestone-status-badge status-active">Active</span> }
                                                    else { <span class="badge milestone-status-badge status-inactive">Inactive</span> }
                                                </td>
                                                <td class="pe-4 text-end">
                                                    <div class="d-inline-flex gap-2">
                                                        <button class="btn btn-sm btn-light border text-primary" data-bs-toggle="modal" data-bs-target="#editTemplateModal-@t.Id" title="Edit">
                                                            <i class="fas fa-pen"></i>
                                                        </button>
                                                        <form asp-action="ToggleDefaultMilestoneTemplate" method="post" class="m-0" onsubmit="return confirmToggle(this, '@t.IsActive');">
                                                            <input type="hidden" name="id" value="@t.Id" />
                                                            <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                                                            <button type="submit" class="btn btn-sm btn-light border @(t.IsActive ? "text-danger" : "text-success")" title="@(t.IsActive ? "Deactivate" : "Activate")">
                                                                <i class="fas @(t.IsActive ? "fa-power-off" : "fa-check")"></i>
                                                            </button>
                                                        </form>
                                                    </div>

                                                    <!-- Edit Modal -->
                                                    <div class="modal fade text-start" id="editTemplateModal-@t.Id" tabindex="-1">
                                                        <div class="modal-dialog">
                                                            <form asp-action="EditDefaultMilestoneTemplate" method="post" class="modal-content">
                                                                <input type="hidden" name="id" value="@t.Id" />
                                                                <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                                                                <input type="hidden" name="model.Stage" value="1" />
                                                                <input type="hidden" name="model.IsActive" value="@(t.IsActive ? "true" : "false")" />
                                                                
                                                                <div class="modal-header border-bottom-0">
                                                                    <h5 class="modal-title fw-bold">Edit Milestone</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="row g-3">
                                                                        <div class="col-md-4">
                                                                            <label class="form-label small fw-bold">Display Order</label>
                                                                            <input type="number" name="model.DisplayOrder" class="form-control" value="@t.DisplayOrder" required />
                                                                        </div>
                                                                        <div class="col-md-8">
                                                                            <label class="form-label small fw-bold">Milestone Type/Code</label>
                                                                            <select name="model.MilestoneCode" class="form-select" required>
                                                                                @if(t.MilestoneCode=="IAF"){<option value="IAF" selected>IAF</option>}else{<option value="IAF">IAF</option>}
                                                                                @if(t.MilestoneCode=="STAGE1_FINAL"){<option value="STAGE1_FINAL" selected>STAGE1_FINAL</option>}else{<option value="STAGE1_FINAL">STAGE1_FINAL</option>}
                                                                                @if(t.MilestoneCode=="GENERIC"){<option value="GENERIC" selected>GENERIC</option>}else{<option value="GENERIC">GENERIC</option>}
                                                                            </select>
                                                                        </div>
                                                                        <div class="col-12">
                                                                            <label class="form-label small fw-bold">Milestone Title</label>
                                                                            <input type="text" name="model.Title" class="form-control" value="@t.Title" required />
                                                                        </div>
                                                                        <div class="col-md-6">
                                                                            <label class="form-label small fw-bold">Due Date</label>
                                                                            <input type="date" name="model.DueDate" class="form-control" value="@t.DueDate?.ToString("yyyy-MM-dd")" />
                                                                        </div>
                                                                        <div class="col-md-6 d-flex flex-column justify-content-end pb-1">
                                                                            <div class="form-check form-switch mt-2">
                                                                                @if(t.IsRequired){ <input class="form-check-input" type="checkbox" name="model.IsRequired" value="true" checked> }
                                                                                else { <input class="form-check-input" type="checkbox" name="model.IsRequired" value="true"> }
                                                                                <label class="form-check-label ms-1">Required</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer bg-light border-top-0">
                                                                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">
                                                <i class="fas fa-inbox fs-2 mb-3 d-block text-secondary opacity-50"></i>
                                                No milestones found for the selected session.
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Milestone Modal -->
    <div class="modal fade text-start" id="addTemplateModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="AddDefaultMilestoneTemplate" method="post" class="modal-content">
                <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                <input type="hidden" name="model.Stage" value="1" />
                
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold">Add Milestone</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Display Order</label>
                            <input type="number" name="model.DisplayOrder" class="form-control" value="99" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Milestone Type/Code</label>
                            <select name="model.MilestoneCode" class="form-select" required>
                                <option value="GENERIC">GENERIC</option>
                                <option value="IAF">IAF</option>
                                <option value="STAGE1_FINAL">STAGE1_FINAL</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Milestone Title</label>
                            <input type="text" name="model.Title" class="form-control" placeholder="e.g. Project Proposal" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="model.DueDate" class="form-control" />
                        </div>
                        <div class="col-md-6 d-flex flex-column gap-3 justify-content-end pb-1">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="model.IsRequired" value="true" checked>
                                <label class="form-check-label ms-1">Required</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="model.IsActive" value="true" checked>
                                <label class="form-check-label ms-1">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Add Milestone</button>
                </div>
            </form>
        </div>
    </div>

</div>

<script>
    function validateBulkUpdate() {
        var milestone = document.querySelector('select[name="milestoneTitle"]').value;
        var date = document.getElementById('bulkUpdateDate').value;
        var btn = document.getElementById('btnBulkUpdate');
        
        if (milestone && date) {
            btn.disabled = false;
        } else {
            btn.disabled = true;
        }
    }
    
    function confirmToggle(form, isActive) {
        var actionText = (isActive === 'True' || isActive === 'true') ? 'disable' : 'enable';
        return confirm('Are you sure you want to ' + actionText + ' this milestone?');
    }
</script>
