@{
    ViewData["Title"] = "System Settings";
}

<style>
    .card {
        border: 1px solid rgba(0,0,0,0.08);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        border-radius: 0.75rem;
    }
    .card-header {
        background-color: transparent;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    .form-control, .form-select {
        border-color: #dee2e6;
        border-radius: 0.375rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    /* Milestone Status Badges */
    .milestone-status-badge {
        display: inline-block;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        line-height: 1.4;
    }

    /* Active - Green */
    .milestone-status-badge.status-active {
        background-color: #d1e7dd !important;
        color: #0f5132 !important;
        border: 1px solid #a3cfbb !important;
    }

    /* Inactive - Gray */
    .milestone-status-badge.status-inactive {
        background-color: #e9ecef !important;
        color: #495057 !important;
        border: 1px solid #ced4da !important;
    }
</style>

<div class="container-xxl py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 fw-bold text-dark mb-1">System Settings</h1>
            <p class="text-muted mb-0">Manage academic deadlines, milestones, and system preferences.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["FYPSettingSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["FYPSettingSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["FYPSettingError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["FYPSettingError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["BulkUpdateSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateInfo"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["BulkUpdateInfo"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["BulkUpdateError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Global Session Filter -->
    <div class="card mb-4 border-primary border-opacity-25">
        <div class="card-body bg-light rounded bg-opacity-50 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-2 rounded">
                    <i class="fas fa-calendar-alt fs-5"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Academic Session Context</h6>
                    <small class="text-muted">Select a session to view and manage its specific milestones.</small>
                </div>
            </div>
            <form method="get" class="m-0">
                <select name="sessionFilter" class="form-select border-primary shadow-sm fw-bold" style="min-width: 200px;" onchange="this.form.submit()">
                    @if(ViewBag.DistinctSessions != null)
                    {
                        var hasSessions = false;
                        foreach (var sessionName in (IEnumerable<string>)ViewBag.DistinctSessions)
                        {
                            hasSessions = true;
                            if (ViewBag.CurrentSessionFilter == sessionName)
                            {
                                <option value="@sessionName" selected>@sessionName</option>
                            }
                            else
                            {
                                <option value="@sessionName">@sessionName</option>
                            }
                        }
                        if (!hasSessions)
                        {
                            <option value="">No Active Sessions</option>
                        }
                    }
                    else
                    {
                        <option value="">No Active Sessions</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <!-- Default Milestones Section -->
    
<!-- ========================================================= -->
<!-- SECTION 1: MILESTONE DEADLINES (SESSION-SPECIFIC) -->
<!-- ========================================================= -->

<div class="row g-4 mb-4">

    <!-- Milestone Deadline Management -->
    <div class="col-lg-8">
        <div class="card h-100">

            <div class="card-header pt-4 pb-3">
                <h5 class="card-title fw-bold mb-1">
                    <i class="fas fa-calendar-check text-primary me-2"></i>
                    Milestone Deadlines
                </h5>

                <p class="text-muted small mb-0">
                    Manage academic milestone due dates for the selected session.
                </p>
            </div>

            <div class="card-body">

                <div class="alert alert-primary bg-primary bg-opacity-10 border-0 mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    You are managing milestone deadlines for
                    <strong>@ViewBag.CurrentSessionFilter</strong>.
                    Changes may affect multiple students in this session.
                </div>

                <form asp-controller="Admin"
                      asp-action="UpdateDefaultMilestoneDate"
                      method="post"
                      id="bulkUpdateForm"
                      onsubmit="return confirm('Are you sure you want to update this milestone deadline for all matching students in the selected academic session?');">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="sessionFilter"
                           value="@ViewBag.CurrentSessionFilter" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label for="milestoneTitleSelect"
                                   class="form-label small fw-bold text-muted text-uppercase">
                                Milestone
                            </label>

                            <select name="milestoneTitle"
                                    id="milestoneTitleSelect"
                                    class="form-select"
                                    required
                                    onchange="validateBulkUpdate()">

                                <option value="">
                                    Select milestone...
                                </option>

                                <option value="IAF">
                                    FYP I: Initial Assessment Form (IAF)
                                </option>

                                <option value="Proposal">
                                    FYP I: Stage 1 Final Submission
                                </option>

                                <option value="Step 1:">
                                    Step 1: Turnitin Checking
                                </option>

                                <option value="Step 2:">
                                    Step 2: Final Report Submission
                                </option>

                                <option value="Step 3:">
                                    Step 3: Marksheet Submission
                                </option>

                                <option value="Step 4:">
                                    Step 4: Record of Supervisor Meeting Form
                                </option>

                                <option value="Step 5:">
                                    Step 5: Presentation Slides Submission
                                </option>

                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="bulkUpdateDate"
                                   class="form-label small fw-bold text-muted text-uppercase">
                                New Due Date
                            </label>

                            <input type="date"
                                   name="deadline"
                                   id="bulkUpdateDate"
                                   class="form-control"
                                   required
                                   onchange="validateBulkUpdate()" />
                        </div>

                    </div>

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-between align-items-sm-center
                                gap-3 mt-4">

                        <small class="text-muted">
                            <i class="fas fa-exclamation-circle me-1"></i>
                            Verify the session, milestone and date before updating.
                        </small>

                        <button type="submit"
                                id="btnBulkUpdate"
                                class="btn btn-outline-primary px-4"
                                disabled>

                            <i class="fas fa-save me-2"></i>
                            Update Deadline

                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>

    <!-- IAF Directory -->
    <div class="col-lg-4">
        <div class="card h-100">

            <div class="card-header pt-4 pb-3">
                <h5 class="card-title fw-bold mb-1">
                    <i class="fas fa-folder-open text-primary me-2"></i>
                    IAF Directory
                </h5>

                <p class="text-muted small mb-0">
                    Initial Project Allocation Form records
                </p>
            </div>

            <div class="card-body d-flex flex-column">

                <div class="mb-4">
                    <p class="text-muted small">
                        View and manage submitted IAF records,
                        reviews and approval statuses.
                    </p>
                </div>

                <div class="mt-auto">
                    <a asp-controller="Admin"
                       asp-action="ApprovedIafList"
                       class="btn btn-outline-primary w-100">

                        <i class="fas fa-external-link-alt me-2"></i>
                        View IAF Records

                    </a>
                </div>

            </div>
        </div>
    </div>

</div>



<!-- ========================================================= -->
<!-- SECTION 2: GLOBAL SETTINGS - INDEPENDENT SAVE FORMS -->
<!-- ========================================================= -->

<div class="mb-3">

    <h5 class="fw-bold mb-1">
        <i class="fas fa-cogs text-primary me-2"></i>
        Global Settings
    </h5>

    <p class="text-muted small mb-0">
        Manage DPP, Exhibition and Workflow settings independently.
        Each section has its own Save button.
        These settings currently apply system-wide.
    </p>

</div>

<div class="row g-4 mb-4">

    <!-- ===================================================== -->
    <!-- DPP SETTINGS -->
    <!-- ===================================================== -->

    <div class="col-md-6 col-xl-4">

        <form asp-controller="Admin"
              asp-action="UpdateDppSettings"
              method="post"
              class="card h-100"
              id="dppSettingsForm"
              onsubmit="if (!this.querySelector('[name=dppDeadline]').value) return confirm('Clear the DPP deadline? The Thesis Cover Page will no longer have a configured date.'); return true;">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="sessionFilter"
                   value="@ViewBag.CurrentSessionFilter" />

            <div class="card-header pt-4 pb-3">

                <h5 class="card-title fw-bold mb-1">
                    <i class="fas fa-file-alt text-primary me-2"></i>
                    DPP Settings
                </h5>

                <p class="text-muted small mb-0">
                    Final DPP submission deadline
                </p>

            </div>

            <div class="card-body">

                <label for="dppDeadline"
                       class="form-label small fw-bold
                              text-muted text-uppercase">

                    DPP Submission Deadline

                </label>

                <input type="date"
                       id="dppDeadline"
                       name="dppDeadline"
                       class="form-control"
                       value="@ViewBag.DPPDeadline" />

                <div class="form-text mt-3">
                    Used as the date source for the
                    Thesis Cover Page.
                </div>

                <div class="small text-muted mt-3">
                    <i class="fas fa-info-circle me-1"></i>
                    Source: FYPSettings / DPPDeadline
                </div>

            </div>

            <div class="card-footer bg-white border-top-0 pb-4">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="fas fa-save me-2"></i>
                    Save DPP Settings

                </button>

            </div>

        </form>

    </div>


    <!-- ===================================================== -->
    <!-- EXHIBITION SETTINGS -->
    <!-- ===================================================== -->

    <div class="col-md-6 col-xl-4">

        <form asp-controller="Admin"
              asp-action="UpdateExhibitionSettings"
              method="post"
              class="card h-100"
              id="exhibitionSettingsForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="sessionFilter"
                   value="@ViewBag.CurrentSessionFilter" />

            <div class="card-header pt-4 pb-3">

                <h5 class="card-title fw-bold mb-1">
                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                    Exhibition Settings
                </h5>

                <p class="text-muted small mb-0">
                    Exhibition event schedule
                </p>

            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label for="exhibitionDate"
                           class="form-label small fw-bold
                                  text-muted text-uppercase">

                        Exhibition Date

                    </label>

                    <input type="date"
                           id="exhibitionDate"
                           name="exhibitionDate"
                           class="form-control"
                           value="@ViewBag.ExhibitionDate" />

                </div>

                <div class="row g-3">

                    <div class="col-sm-6">

                        <label for="exhibitionTimeStart"
                               class="form-label small fw-bold
                                      text-muted text-uppercase">

                            Start Time

                        </label>

                        <input type="time"
                               id="exhibitionTimeStart"
                               name="exhibitionTimeStart"
                               class="form-control"
                               value="@ViewBag.ExhibitionTimeStart" />

                    </div>

                    <div class="col-sm-6">

                        <label for="exhibitionTimeEnd"
                               class="form-label small fw-bold
                                      text-muted text-uppercase">

                            End Time

                        </label>

                        <input type="time"
                               id="exhibitionTimeEnd"
                               name="exhibitionTimeEnd"
                               class="form-control"
                               value="@ViewBag.ExhibitionTimeEnd" />

                    </div>

                </div>

                <div class="form-text mt-3">
                    Saving this section does not modify
                    DPP Deadline or Workflow Policies.
                </div>

            </div>

            <div class="card-footer bg-white border-top-0 pb-4">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="fas fa-save me-2"></i>
                    Save Exhibition Settings

                </button>

            </div>

        </form>

    </div>


    <!-- ===================================================== -->
    <!-- WORKFLOW POLICIES -->
    <!-- ===================================================== -->

    <div class="col-md-12 col-xl-4">

        <form asp-controller="Admin"
              asp-action="UpdateWorkflowPolicySettings"
              method="post"
              class="card h-100"
              id="workflowPolicyForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="sessionFilter"
                   value="@ViewBag.CurrentSessionFilter" />

            <div class="card-header pt-4 pb-3">

                <h5 class="card-title fw-bold mb-1">
                    <i class="fas fa-shield-alt text-primary me-2"></i>
                    Workflow Policies
                </h5>

                <p class="text-muted small mb-0">
                    Supervisor request management
                </p>

            </div>

            <div class="card-body">

                <label for="supervisorRequestTimeoutDays"
                       class="form-label small fw-bold
                              text-muted text-uppercase">

                    Supervisor Request Timeout

                </label>

                <div class="input-group"
                     style="max-width: 230px;">

                    <input type="number"
                           id="supervisorRequestTimeoutDays"
                           name="supervisorRequestTimeoutDays"
                           class="form-control"
                           min="1"
                           max="30"
                           required
                           value="@ViewBag.SupervisorRequestTimeoutDays" />

                    <span class="input-group-text">
                        days
                    </span>

                </div>

                <div class="form-text mt-3">
                    Pending supervisor requests without
                    a response will be automatically
                    rejected after the configured number
                    of days.
                </div>

                <div class="small text-muted mt-3">
                    This policy applies system-wide.
                </div>

            </div>

            <div class="card-footer bg-white border-top-0 pb-4">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="fas fa-save me-2"></i>
                    Save Workflow Policy

                </button>

            </div>

        </form>

    </div>

</div>



    <!-- Add Milestone Modal -->
    <div class="modal fade text-start" id="addTemplateModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="AddDefaultMilestoneTemplate" method="post" class="modal-content">
                <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                <input type="hidden" name="model.Stage" value="1" />
                
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold">Add Milestone</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Display Order</label>
                            <input type="number" name="model.DisplayOrder" class="form-control" value="99" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Milestone Type/Code</label>
                            <select name="model.MilestoneCode" class="form-select" required>
                                <option value="GENERIC">GENERIC</option>
                                <option value="IAF">IAF</option>
                                <option value="STAGE1_FINAL">STAGE1_FINAL</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Milestone Title</label>
                            <input type="text" name="model.Title" class="form-control" placeholder="e.g. Project Proposal" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="model.DueDate" class="form-control" />
                        </div>
                        <div class="col-md-6 d-flex flex-column gap-3 justify-content-end pb-1">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="model.IsRequired" value="true" checked>
                                <label class="form-check-label ms-1">Required</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="model.IsActive" value="true" checked>
                                <label class="form-check-label ms-1">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Add Milestone</button>
                </div>
            </form>
        </div>
    </div>

</div>

<script>
    function validateBulkUpdate() {
        var milestone = document.querySelector('select[name="milestoneTitle"]').value;
        var date = document.getElementById('bulkUpdateDate').value;
        var btn = document.getElementById('btnBulkUpdate');
        
        if (milestone && date) {
            btn.disabled = false;
        } else {
            btn.disabled = true;
        }
    }
    
    function confirmToggle(form, isActive) {
        var actionText = (isActive === 'True' || isActive === 'true') ? 'disable' : 'enable';
        return confirm('Are you sure you want to ' + actionText + ' this milestone?');
    }
</script>
