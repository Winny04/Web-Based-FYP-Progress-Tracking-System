@{
    ViewData["Title"] = "System Settings & Academic Configuration";
    string currentSession = ViewBag.CurrentSessionFilter as string ?? "2026 Jan";
    var currentSessionObj = ViewBag.CurrentSessionObj as FYPTracker.Models.AcademicSession;
    var defaultMilestones = ViewBag.DefaultMilestoneTemplates as IEnumerable<FYPTracker.Models.DefaultMilestoneTemplate> ?? Enumerable.Empty<FYPTracker.Models.DefaultMilestoneTemplate>();
    string defenseSupervisorPolicy = ViewBag.IAFDefenseSupervisorRequired as string ?? "false";
}

<style>
    /* Admin Settings Theme & Typography */
    .settings-container {
        max-width: 1320px;
        margin: 0 auto;
    }
    .settings-card {
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
        border-radius: 0.85rem;
        background-color: #ffffff;
        transition: box-shadow 0.2s ease-in-out;
    }
    .settings-card:hover {
        box-shadow: 0 6px 16px -2px rgba(0, 0, 0, 0.08), 0 3px 8px -1px rgba(0, 0, 0, 0.04);
    }
    .settings-card-header {
        background-color: transparent;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        padding: 1.25rem 1.5rem;
    }
    .settings-card-body {
        padding: 1.5rem;
    }
    .settings-card-footer {
        background-color: rgba(248, 249, 250, 0.6);
        border-top: 1px solid rgba(0, 0, 0, 0.06);
        padding: 1rem 1.5rem;
        border-bottom-left-radius: 0.85rem;
        border-bottom-right-radius: 0.85rem;
    }

    /* Modern Pill Navigation */
    .settings-nav-pills {
        gap: 0.5rem;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 0.5rem;
    }
    .settings-nav-pills .nav-link {
        color: #495057;
        font-weight: 600;
        font-size: 0.925rem;
        padding: 0.65rem 1.15rem;
        border-radius: 0.5rem;
        border: 1px solid transparent;
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background-color: #f8f9fa;
    }
    .settings-nav-pills .nav-link:hover {
        color: #0d6efd;
        background-color: #eef2ff;
        border-color: rgba(13, 110, 253, 0.15);
    }
    .settings-nav-pills .nav-link.active {
        color: #ffffff !important;
        background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%) !important;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3);
        border-color: #0d6efd;
    }

    /* Policy Radio Selection Cards */
    .policy-option-card {
        border: 2px solid #dee2e6;
        border-radius: 0.75rem;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.2s ease;
        background-color: #fafbfc;
        position: relative;
        height: 100%;
    }
    .policy-option-card:hover {
        border-color: #86b7fe;
        background-color: #ffffff;
    }
    .policy-option-card.selected {
        border-color: #0d6efd;
        background-color: #f0f7ff;
        box-shadow: 0 0 0 1px #0d6efd;
    }
    .policy-option-card input[type="radio"] {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        width: 1.2rem;
        height: 1.2rem;
    }

    /* Form & Input Styling */
    .form-control, .form-select {
        border-color: #dee2e6;
        border-radius: 0.5rem;
        padding: 0.6rem 0.85rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    .form-label-custom {
        font-size: 0.825rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6c757d;
        margin-bottom: 0.4rem;
    }

    /* Badges */
    .badge-session {
        background-color: #e0e7ff;
        color: #3730a3;
        font-weight: 700;
        padding: 0.4rem 0.85rem;
        border-radius: 2rem;
        font-size: 0.85rem;
        border: 1px solid #c7d2fe;
    }
</style>

<div class="container-xxl py-4 settings-container">
    <!-- Header & Quick Nav -->
    <div class="row align-items-center mb-4">
        <div class="col-lg-7 mb-3 mb-lg-0">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                    <i class="fas fa-sliders-h fs-4"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold text-dark mb-1">System Settings</h1>
                    <p class="text-muted mb-0">Manage academic session deadlines, defense attendance policies, and system-wide configurations.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-5 text-lg-end">
            <div class="d-inline-flex flex-wrap gap-2">
                <a asp-controller="Admin" asp-action="ApprovedIafList" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                    <i class="fas fa-folder-open me-1"></i> IAF Directory
                </a>
                <a asp-controller="Admin" asp-action="ManageDefenses" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                    <i class="fas fa-calendar-alt me-1"></i> Manage Defenses
                </a>
                <a asp-controller="Admin" asp-action="FormTemplateSettings" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm">
                    <i class="fas fa-file-code me-1"></i> Form Templates
                </a>
            </div>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-check-circle fs-5 me-3"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["FYPSettingSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-check-circle fs-5 me-3"></i>
            <div>@TempData["FYPSettingSuccess"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-check-circle fs-5 me-3"></i>
            <div>@TempData["BulkUpdateSuccess"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-exclamation-triangle fs-5 me-3"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["FYPSettingError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-exclamation-triangle fs-5 me-3"></i>
            <div>@TempData["FYPSettingError"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-exclamation-circle fs-5 me-3"></i>
            <div>@TempData["BulkUpdateError"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["BulkUpdateInfo"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-info-circle fs-5 me-3"></i>
            <div>@TempData["BulkUpdateInfo"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabbed Navigation Bar -->
    <ul class="nav nav-pills settings-nav-pills mb-4 flex-column flex-md-row" id="settingsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-session-btn" data-bs-toggle="pill" data-bs-target="#tab-session" type="button" role="tab" aria-controls="tab-session" aria-selected="true">
                <i class="fas fa-calendar-alt"></i>
                <span>Session Milestones</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-iaf-defense-btn" data-bs-toggle="pill" data-bs-target="#tab-iaf-defense" type="button" role="tab" aria-controls="tab-iaf-defense" aria-selected="false">
                <i class="fas fa-user-shield"></i>
                <span>IAF Defense</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-final-viva-btn" data-bs-toggle="pill" data-bs-target="#tab-final-viva" type="button" role="tab" aria-controls="tab-final-viva" aria-selected="false">
                <i class="fas fa-graduation-cap"></i>
                <span>Final Viva</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-supervisor-meetings-btn" data-bs-toggle="pill" data-bs-target="#tab-supervisor-meetings" type="button" role="tab" aria-controls="tab-supervisor-meetings" aria-selected="false">
                <i class="fas fa-handshake"></i>
                <span>Supervisor Meetings</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-dpp-exhibition-btn" data-bs-toggle="pill" data-bs-target="#tab-dpp-exhibition" type="button" role="tab" aria-controls="tab-dpp-exhibition" aria-selected="false">
                <i class="fas fa-award"></i>
                <span>DPP & Exhibition</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-workflow-policies-btn" data-bs-toggle="pill" data-bs-target="#tab-workflow-policies" type="button" role="tab" aria-controls="tab-workflow-policies" aria-selected="false">
                <i class="fas fa-shield-alt"></i>
                <span>Workflow Policies</span>
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="settingsTabsContent">

        <!-- ========================================================= -->
        <!-- TAB 1: ACADEMIC SESSION & MILESTONE DEADLINES -->
        <!-- ========================================================= -->
        <div class="tab-pane fade show active" id="tab-session" role="tabpanel" aria-labelledby="tab-session-btn">
            
            <!-- Session Context Card -->
            <div class="settings-card mb-4 border-primary border-opacity-25 bg-light bg-opacity-25">
                <div class="settings-card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary text-white p-3 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                            <i class="fas fa-calendar-check fs-5"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h5 class="fw-bold text-dark mb-0">Active Academic Session Context</h5>
                                <span class="badge-session">@currentSession</span>
                            </div>
                            <small class="text-muted">
                                All deadlines configured below strictly apply to students enrolled in this Academic Session.
                            </small>
                        </div>
                    </div>
                    <form method="get" class="m-0 d-flex align-items-center gap-2">
                        <label for="sessionFilterSelect" class="small fw-bold text-muted text-nowrap d-none d-sm-inline">Switch Session:</label>
                        <select name="sessionFilter" id="sessionFilterSelect" class="form-select border-primary shadow-sm fw-bold" style="min-width: 200px;" onchange="this.form.submit()">
                            @if (ViewBag.DistinctSessions != null)
                            {
                                foreach (var sessionName in (IEnumerable<string>)ViewBag.DistinctSessions)
                                {
                                    <option value="@sessionName" selected="@(ViewBag.CurrentSessionFilter == sessionName)">@sessionName</option>
                                }
                            }
                            else
                            {
                                <option value="">No Active Sessions</option>
                            }
                        </select>
                    </form>
                </div>
            </div>

            <!-- Single Source of Truth Notice -->
            <div class="alert alert-primary bg-primary bg-opacity-10 border-0 d-flex align-items-start gap-3 p-3 mb-4 rounded-3">
                <i class="fas fa-info-circle fs-5 text-primary mt-1"></i>
                <div class="small text-dark">
                    <strong>Authoritative Session Rule:</strong> Official academic deadlines are centrally managed per Academic Session. All students belonging to <strong>@currentSession</strong> share identical official due dates. Supervisors cannot modify official session deadlines. Optional supervisor-assigned DPP tasks have separate dates and are never overwritten.
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- Session Deadlines Overview Table -->
                <div class="col-lg-7">
                    <div class="settings-card h-100">
                        <div class="settings-card-header d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title fw-bold mb-0 text-dark">
                                    <i class="fas fa-list-check text-primary me-2"></i>Official Session Milestones
                                </h5>
                                <small class="text-muted">Current authoritative deadlines for @currentSession</small>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#addTemplateModal">
                                <i class="fas fa-plus me-1"></i> Add Milestone
                            </button>
                        </div>
                        <div class="settings-card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light text-muted small text-uppercase">
                                        <tr>
                                            <th class="ps-3 py-3">Stage</th>
                                            <th class="py-3">Milestone Name</th>
                                            <th class="py-3">Code</th>
                                            <th class="py-3 text-end pe-3">Official Due Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- IAF Milestone -->
                                        <tr>
                                            <td class="ps-3"><span class="badge bg-primary bg-opacity-10 text-primary fw-bold">Stage 1</span></td>
                                            <td>
                                                <div class="fw-bold text-dark">Initial Project Allocation Form (IAF)</div>
                                                <small class="text-muted">Supervisor assignment & project scope</small>
                                            </td>
                                            <td><code class="text-primary fw-bold">IAF</code></td>
                                            <td class="text-end pe-3">
                                                @if (!string.IsNullOrEmpty(ViewBag.IAFDeadline))
                                                {
                                                    <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-bold">@ViewBag.IAFDeadline</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-2 py-1">Not Set</span>
                                                }
                                            </td>
                                        </tr>
                                        <!-- Stage 1 Proposal -->
                                        <tr>
                                            <td class="ps-3"><span class="badge bg-primary bg-opacity-10 text-primary fw-bold">Stage 1</span></td>
                                            <td>
                                                <div class="fw-bold text-dark">Stage 1 Final / DPP Proposal</div>
                                                <small class="text-muted">Detailed project proposal submission</small>
                                            </td>
                                            <td><code class="text-primary fw-bold">STAGE1_FINAL</code></td>
                                            <td class="text-end pe-3">
                                                @if (!string.IsNullOrEmpty(ViewBag.ProposalDeadline))
                                                {
                                                    <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-bold">@ViewBag.ProposalDeadline</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-2 py-1">Not Set</span>
                                                }
                                            </td>
                                        </tr>
                                        <!-- Stage 2 Step 1 to 4 -->
                                        <tr>
                                            <td class="ps-3"><span class="badge bg-info bg-opacity-10 text-info fw-bold">Stage 2</span></td>
                                            <td>
                                                <div class="fw-bold text-dark">Steps 1–4: Reports & Marksheet</div>
                                                <small class="text-muted">Turnitin, final report, marksheet, meeting records</small>
                                            </td>
                                            <td><code class="text-info fw-bold">STAGE2_STEP1-4</code></td>
                                            <td class="text-end pe-3">
                                                @if (!string.IsNullOrEmpty(ViewBag.Step1to4Deadline))
                                                {
                                                    <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-bold">@ViewBag.Step1to4Deadline</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Not Set</span>
                                                }
                                            </td>
                                        </tr>
                                        <!-- Stage 2 Step 5 -->
                                        <tr>
                                            <td class="ps-3"><span class="badge bg-info bg-opacity-10 text-info fw-bold">Stage 2</span></td>
                                            <td>
                                                <div class="fw-bold text-dark">Step 5: Presentation Slides</div>
                                                <small class="text-muted">Final Viva presentation slides</small>
                                            </td>
                                            <td><code class="text-info fw-bold">STAGE2_STEP5</code></td>
                                            <td class="text-end pe-3">
                                                @if (!string.IsNullOrEmpty(ViewBag.Step5Deadline))
                                                {
                                                    <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-bold">@ViewBag.Step5Deadline</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Not Set</span>
                                                }
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Update Official Deadline Form -->
                <div class="col-lg-5">
                    <form asp-controller="Admin"
                          asp-action="UpdateDefaultMilestoneDate"
                          method="post"
                          class="settings-card h-100 d-flex flex-column"
                          id="bulkUpdateForm"
                          onsubmit="return handleSettingsFormSubmit(this, 'Update official deadline for selected milestone across session @currentSession?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sessionFilter" value="@currentSession" />

                        <div class="settings-card-header">
                            <h5 class="card-title fw-bold mb-1 text-dark">
                                <i class="fas fa-edit text-primary me-2"></i>Update Session Deadline
                            </h5>
                            <small class="text-muted">Centrally modify a milestone deadline for all enrolled students</small>
                        </div>

                        <div class="settings-card-body flex-grow-1">
                            <div class="mb-3">
                                <label for="milestoneTitleSelect" class="form-label form-label-custom">Select Milestone Target</label>
                                <select name="milestoneTitle" id="milestoneTitleSelect" class="form-select" required onchange="validateBulkUpdate()">
                                    <option value="">-- Choose academic milestone --</option>
                                    <option value="IAF">Stage 1: Initial Project Allocation Form (IAF)</option>
                                    <option value="Proposal">Stage 1: Final Submission / DPP Proposal</option>
                                    <option value="Step 1:">Stage 2: Step 1 Turnitin Checking</option>
                                    <option value="Step 2:">Stage 2: Step 2 Final Report Submission</option>
                                    <option value="Presentation">Stage 2: Presentation Slides Submission</option>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label for="bulkUpdateDate" class="form-label form-label-custom">New Authoritative Due Date</label>
                                <input type="date" name="deadline" id="bulkUpdateDate" class="form-control" required onchange="validateBulkUpdate()" />
                                <div class="form-text mt-2 small text-muted">
                                    <i class="fas fa-clock me-1"></i> Due date will be registered at 23:59:59 on the selected date.
                                </div>
                            </div>

                            <div class="alert alert-light border small text-muted p-3 mb-0">
                                <i class="fas fa-shield-alt text-primary me-1"></i>
                                <strong>Safety Rule:</strong> Existing student submissions, grades, and audit trail are preserved. Only official submission deadlines are updated.
                            </div>
                        </div>

                        <div class="settings-card-footer">
                            <button type="submit" id="btnBulkUpdate" class="btn btn-primary w-100 py-2 fw-semibold" disabled>
                                <i class="fas fa-save me-2"></i> Update Session Deadline
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 2: IAF DEFENSE SETTINGS -->
        <!-- ========================================================= -->
        <div class="tab-pane fade" id="tab-iaf-defense" role="tabpanel" aria-labelledby="tab-iaf-defense-btn">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-9">
                    <form asp-controller="Admin"
                          asp-action="UpdateIafDefenseSettings"
                          method="post"
                          class="settings-card"
                          id="iafDefenseSettingsForm"
                          onsubmit="return handleSettingsFormSubmit(this);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sessionFilter" value="@currentSession" />

                        <div class="settings-card-header d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title fw-bold mb-1 text-dark">
                                    <i class="fas fa-user-shield text-primary me-2"></i>IAF Defense & Scheduling Settings
                                </h5>
                                <small class="text-muted">Configure Stage 1 Face-to-Face defense duration, supervisor attendance policy, and working hours.</small>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                Stage 1 Defense
                            </span>
                        </div>

                        <div class="settings-card-body">
                            <!-- Defense Duration Field -->
                            <div class="mb-4 pb-3 border-bottom">
                                <label for="durationMinutes" class="form-label form-label-custom">
                                    Defense Slot Duration (Minutes) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group" style="max-width: 260px;">
                                    <input type="number"
                                           id="durationMinutes"
                                           name="durationMinutes"
                                           class="form-control"
                                           min="15"
                                           max="180"
                                           required
                                           value="@(ViewBag.IAFDefenseDurationMinutes ?? "45")" />
                                    <span class="input-group-text bg-light text-muted">minutes</span>
                                </div>
                                <div class="form-text mt-2 small text-muted">
                                    Authoritative length per scheduled student defense. Recommended value: <strong>45 minutes</strong> (permitted range: 15–180 mins).
                                </div>
                            </div>

                            <!-- Original Supervisor Attendance Policy -->
                            <div class="mb-4 pb-3 border-bottom">
                                <label class="form-label form-label-custom d-block mb-3">
                                    Original Supervisor Attendance Policy <span class="text-danger">*</span>
                                </label>

                                <div class="row g-3">
                                    <!-- Option 1: Optional -->
                                    <div class="col-md-6">
                                        <label class="policy-option-card d-block @(defenseSupervisorPolicy == "false" ? "selected" : "")" id="policyCardOptional">
                                            <input type="radio"
                                                   name="supervisorRequired"
                                                   id="policyRadioOptional"
                                                   value="false"
                                                   checked="@(defenseSupervisorPolicy == "false")"
                                                   onchange="updatePolicyCardSelection()" />
