<script>
    // Tab Persistence (URL Hash & SessionStorage)
    document.addEventListener("DOMContentLoaded", function () {
        var activeTab = window.location.hash || sessionStorage.getItem('activeSettingsTab');
        if (activeTab) {
            var triggerEl = document.querySelector('button[data-bs-target="' + activeTab + '"]');
            if (triggerEl) {
                var tab = new bootstrap.Tab(triggerEl);
                tab.show();
            }
        }

        var tabButtons = document.querySelectorAll('#settingsTabs button[data-bs-toggle="pill"]');
        tabButtons.forEach(function (btn) {
            btn.addEventListener('shown.bs.tab', function (e) {
                var target = e.target.getAttribute('data-bs-target');
                window.location.hash = target;
                sessionStorage.setItem('activeSettingsTab', target);
            });
        });

        // Initialize policy card selection styling
        updatePolicyCardSelection();
    });

    // Milestone update validation
    function validateBulkUpdate() {
        var milestone = document.getElementById('milestoneTitleSelect').value;
        var date = document.getElementById('bulkUpdateDate').value;
        var btn = document.getElementById('btnBulkUpdate');
        btn.disabled = !(milestone && date);
    }

    // Policy Radio Card Visual Styling
    function updatePolicyCardSelection() {
        var isRequired = document.getElementById('policyRadioRequired')?.checked;
        var cardRequired = document.getElementById('policyCardRequired');
        var cardOptional = document.getElementById('policyCardOptional');

        if (isRequired) {
            cardRequired?.classList.add('selected');
            cardOptional?.classList.remove('selected');
        } else {
            cardOptional?.classList.add('selected');
            cardRequired?.classList.remove('selected');
        }
    }

    // Submit handler: prevent double submissions & show spinner
    function handleSettingsFormSubmit(form, confirmMessage) {
        if (confirmMessage && !confirm(confirmMessage)) {
            return false;
        }

        var submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            var originalHtml = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
            
            // Safety timeout to re-enable button if response takes unexpectedly long
            setTimeout(function () {
                if (submitBtn.disabled) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalHtml;
                }
            }, 10000);
        }
        return true;
    }
</script>
