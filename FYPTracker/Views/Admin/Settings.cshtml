@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-cogs me-2 text-primary"></i>System Settings</h2>
            <p class="text-muted mb-0">Manage global system configurations and preferences.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="fas fa-calendar-alt text-primary me-2"></i>IAF Submission Deadline</h5>
                    
                    @if (ViewBag.DistinctSessions != null && ((IEnumerable<string>)ViewBag.DistinctSessions).Any())
                    {
                        <form method="get" asp-action="Settings" id="sessionFilterForm" class="ms-2">
                            <select name="sessionFilter" class="form-select form-select-sm" onchange="document.getElementById('sessionFilterForm').submit()">
                                @foreach (var sessionName in (IEnumerable<string>)ViewBag.DistinctSessions)
                                {
                                    if (ViewBag.CurrentSessionFilter == sessionName)
                                    {
                                        <option value="@sessionName" selected>@sessionName</option>
                                    }
                                    else
                                    {
                                        <option value="@sessionName">@sessionName</option>
                                    }
                                }
                            </select>
                        </form>
                    }
                </div>
                
                <p class="text-muted small mb-4">Configure the submission deadline date visible to students on their forms page for the selected session.</p>
                <form asp-action="UpdateIAFDeadline" method="post" class="mt-auto">
                    <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success border-0 p-2 small mb-3">@TempData["Success"]</div>
                    }
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info border-0 p-2 small mb-3">@TempData["Info"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 p-2 small mb-3">@TempData["Error"]</div>
                    }
                    
                    @if(string.IsNullOrEmpty(ViewBag.CurrentSessionFilter))
                    {
                        <div class="alert alert-warning border-0 p-2 small mb-3">No active academic session found. Students must register first.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <input type="date" name="deadline" class="form-control bg-light" value="@ViewBag.IAFDeadline" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <div class="form-text text-muted small mt-1"><i class="fas fa-info-circle me-1"></i>Time will be automatically set to 11:59 PM.</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Save Deadline</button>
                    }
                </form>
            </div>
        </div>

        @* ── STAGE 2: Final Evaluation Cards (commented out — uncomment when ready) ────────────
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100 border-top border-4" style="border-top-color: #8b5cf6 !important;">
                <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-graduation-cap me-2 text-purple"></i>Final Evaluation Dates</h5>
                <p class="text-muted small mb-4">Set the global due dates for the FYP 2 Final Evaluation submission steps for the current session.</p>
                <form asp-action="UpdateFinalEvaluationDeadlines" method="post" class="mt-auto">
                    <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                    
                    @if(string.IsNullOrEmpty(ViewBag.CurrentSessionFilter))
                    {
                        <div class="alert alert-warning border-0 p-2 small mb-3">No active academic session found.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Steps 1-4 Deadline</label>
                            <input type="date" name="step1to4Deadline" class="form-control bg-light" value="@ViewBag.Step1to4Deadline" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Step 5 (Slides) Deadline</label>
                            <input type="date" name="step5Deadline" class="form-control bg-light" value="@ViewBag.Step5Deadline" required />
                        </div>
                        <button type="submit" class="btn text-white w-100 fw-bold" style="background: #8b5cf6;">Save Deadlines</button>
                    }
                </form>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100 border-top border-4" style="border-top-color: #f59e0b !important;">
                <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-magic me-2 text-warning"></i>Generate Step Milestones</h5>
                <p class="text-muted small mb-4">Retroactively create the 5 Final Evaluation steps for all existing projects with an approved Final/Thesis milestone that don't have steps yet.</p>
                <form asp-action="SeedFinalEvaluationSteps" method="post" class="mt-auto">
                    <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                    <button type="submit" class="btn w-100 fw-bold text-dark" style="background: #fef3c7; border: 2px solid #f59e0b;"
                        onclick="return confirm('This will create Step 1-5 milestones for all eligible projects in @ViewBag.CurrentSessionFilter. Continue?')">
                        <i class="fas fa-bolt me-1 text-warning"></i>Generate Step Milestones Now
                    </button>
                </form>
            </div>
        </div>
        ── END STAGE 2 ── *@

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                <h5 class="fw-bold mb-3 text-danger"><i class="fas fa-shield-alt me-2"></i>Defense List</h5>
                <p class="text-muted small mb-4">View and notify students who have had their Initial Project Allocation Form (IAF) rejected 3 times.</p>
                <div class="mt-auto">
                    <a href="/Admin/DefenseList" class="btn btn-outline-danger w-100 fw-bold">View Defense List</a>
                </div>
            </div>
        </div>
    </div>

        @* ── FYP Submission Dates (DPP, Exhibition) ── *@
        <div class="col-12 mt-2">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h5 class="fw-bold mb-1"><i class="fas fa-calendar-check text-success me-2"></i>FYP Key Submission Dates</h5>
                <p class="text-muted small mb-4">These dates are displayed on the student dashboard timeline and used in downloadable templates.</p>

                @if (TempData["FYPSettingSuccess"] != null)
                {
                    <div class="alert alert-success border-0 p-2 small mb-3">@TempData["FYPSettingSuccess"]</div>
                }
                @if (TempData["FYPSettingError"] != null)
                {
                    <div class="alert alert-danger border-0 p-2 small mb-3">@TempData["FYPSettingError"]</div>
                }

                <form asp-action="UpdateFYPSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="fas fa-file-alt text-primary me-1"></i>DPP Submission Deadline
                            </label>
                            <input type="date" name="dppDeadline" class="form-control" value="@ViewBag.DPPDeadline" />
                            <div class="form-text small">e.g. 19th June 2026 before 11.59pm</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="fas fa-star text-warning me-1"></i>FYP Exhibition Date
                            </label>
                            <input type="date" name="exhibitionDate" class="form-control" value="@ViewBag.ExhibitionDate" />
                            <div class="form-text small">e.g. 25th June 2026</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="far fa-clock text-info me-1"></i>Exhibition Start Time
                            </label>
                            <input type="time" name="exhibitionTimeStart" class="form-control" value="@ViewBag.ExhibitionTimeStart" />
                            <div class="form-text small">e.g. 09:00 (9am)</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="far fa-clock text-secondary me-1"></i>Exhibition End Time
                            </label>
                            <input type="time" name="exhibitionTimeEnd" class="form-control" value="@ViewBag.ExhibitionTimeEnd" />
                            <div class="form-text small">e.g. 13:00 (1pm)</div>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="fas fa-save me-2"></i>Save Dates
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


