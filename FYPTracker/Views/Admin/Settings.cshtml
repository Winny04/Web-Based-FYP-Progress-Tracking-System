@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-cogs me-2 text-primary"></i>System Settings</h2>
            <p class="text-muted mb-0">Manage global system configurations and preferences.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100 border-top border-4" style="border-top-color: #8b5cf6 !important;">
                <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-graduation-cap me-2 text-purple"></i>Update Milestone Dates</h5>
                <p class="text-muted small mb-4">Set the global due date for a specific default milestone across all students in the current session.</p>
                <form asp-action="UpdateDefaultMilestoneDate" method="post" class="mt-auto">
                    @if (TempData["BulkUpdateSuccess"] != null)
                    {
                        <div class="alert alert-success border-0 p-2 small mb-3">@TempData["BulkUpdateSuccess"]</div>
                    }
                    @if (TempData["BulkUpdateInfo"] != null)
                    {
                        <div class="alert alert-info border-0 p-2 small mb-3">@TempData["BulkUpdateInfo"]</div>
                    }
                    @if (TempData["BulkUpdateError"] != null)
                    {
                        <div class="alert alert-danger border-0 p-2 small mb-3">@TempData["BulkUpdateError"]</div>
                    }
                    @if(ViewBag.DistinctSessions == null || !((IEnumerable<string>)ViewBag.DistinctSessions).Any())
                    {
                        <div class="alert alert-warning border-0 p-2 small mb-3">No active academic session found.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Select Academic Session</label>
                            <select name="sessionFilter" class="form-select bg-light" required>
                                <option value="">-- Choose Session --</option>
                                @foreach (var sessionName in (IEnumerable<string>)ViewBag.DistinctSessions)
                                {
                                    if (ViewBag.CurrentSessionFilter == sessionName)
                                    {
                                        <option value="@sessionName" selected>@sessionName</option>
                                    }
                                    else
                                    {
                                        <option value="@sessionName">@sessionName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Select Milestone</label>
                            <select name="milestoneTitle" class="form-select bg-light" required>
                                <option value="">-- Choose Milestone --</option>
                                <option value="IAF">FYP 1: Initial Assessment Form (IAF)</option>
                                <option value="Proposal">FYP 1: Stage 1 Final Submission</option>
                                <option value="Step 1:">Step 1: Turnitin Checking</option>
                                <option value="Step 2:">Step 2: Final Report Submission</option>
                                <option value="Step 3:">Step 3: Marksheet Submission</option>
                                <option value="Step 4:">Step 4: Record of Supervisor Meeting Form</option>
                                <option value="Step 5:">Step 5: Presentation Slides Submission</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">New Due Date</label>
                            <input type="date" name="deadline" class="form-control bg-light" required />
                            <div class="form-text text-muted small mt-1"><i class="fas fa-info-circle me-1"></i>Time will be set to 11:59 PM.</div>
                        </div>
                        <button type="submit" class="btn text-white w-100 fw-bold" style="background: #8b5cf6;">Update Deadlines</button>
                    }
                </form>
            </div>
        </div>
        


        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                <h5 class="fw-bold mb-3 text-danger"><i class="fas fa-shield-alt me-2"></i>Defense List</h5>
                <p class="text-muted small mb-4">View and notify students who have had their Initial Project Allocation Form (IAF) rejected 3 times.</p>
                <div class="mt-auto">
                    <a href="/Admin/DefenseList" class="btn btn-outline-danger w-100 fw-bold">View Defense List</a>
                </div>
            </div>
        </div>
    </div>

        @* ── FYP Submission Dates (DPP, Exhibition) ── *@
        <div class="col-12 mt-2">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h5 class="fw-bold mb-1"><i class="fas fa-calendar-check text-success me-2"></i>FYP Key Submission Dates</h5>
                <p class="text-muted small mb-4">These dates are displayed on the student dashboard timeline and used in downloadable templates.</p>

                @if (TempData["FYPSettingSuccess"] != null)
                {
                    <div class="alert alert-success border-0 p-2 small mb-3">@TempData["FYPSettingSuccess"]</div>
                }
                @if (TempData["FYPSettingError"] != null)
                {
                    <div class="alert alert-danger border-0 p-2 small mb-3">@TempData["FYPSettingError"]</div>
                }

                <form asp-action="UpdateFYPSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="fas fa-file-alt text-primary me-1"></i>DPP Submission Deadline
                            </label>
                            <input type="date" name="dppDeadline" class="form-control" value="@ViewBag.DPPDeadline" />
                            <div class="form-text small">e.g. 19th June 2026 before 11.59pm</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="fas fa-star text-warning me-1"></i>FYP Exhibition Date
                            </label>
                            <input type="date" name="exhibitionDate" class="form-control" value="@ViewBag.ExhibitionDate" />
                            <div class="form-text small">e.g. 25th June 2026</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="far fa-clock text-info me-1"></i>Exhibition Start Time
                            </label>
                            <input type="time" name="exhibitionTimeStart" class="form-control" value="@ViewBag.ExhibitionTimeStart" />
                            <div class="form-text small">e.g. 09:00 (9am)</div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="far fa-clock text-secondary me-1"></i>Exhibition End Time
                            </label>
                            <input type="time" name="exhibitionTimeEnd" class="form-control" value="@ViewBag.ExhibitionTimeEnd" />
                            <div class="form-text small">e.g. 13:00 (1pm)</div>
                        </div>
                    </div>

                    @* ── Supervisor Request Timeout Setting ── *@
                    <hr class="my-4" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-semibold small text-muted text-uppercase">
                                <i class="fas fa-hourglass-half text-danger me-1"></i>Supervisor Request Timeout (Days)
                            </label>
                            <input type="number" name="supervisorRequestTimeoutDays"
                                   class="form-control" min="1" max="30"
                                   value="@ViewBag.SupervisorRequestTimeoutDays" />
                            <div class="form-text small text-muted">
                                Pending requests with no supervisor response after this many days are
                                <strong>automatically rejected</strong> and the student is notified.
                                Current requirement: <strong>3 days</strong>.
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="fas fa-save me-2"></i>Save Dates &amp; Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


