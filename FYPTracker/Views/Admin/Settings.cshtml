@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-cogs me-2 text-primary"></i>System Settings</h2>
            <p class="text-muted mb-0">Manage global system configurations and preferences.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="fas fa-calendar-alt text-primary me-2"></i>IAF Submission Deadline</h5>
                    
                    @if (ViewBag.DistinctSessions != null && ((IEnumerable<string>)ViewBag.DistinctSessions).Any())
                    {
                        <form method="get" asp-action="Settings" id="sessionFilterForm" class="ms-2">
                            <select name="sessionFilter" class="form-select form-select-sm" onchange="document.getElementById('sessionFilterForm').submit()">
                                @foreach (var sessionName in (IEnumerable<string>)ViewBag.DistinctSessions)
                                {
                                    if (ViewBag.CurrentSessionFilter == sessionName)
                                    {
                                        <option value="@sessionName" selected>@sessionName</option>
                                    }
                                    else
                                    {
                                        <option value="@sessionName">@sessionName</option>
                                    }
                                }
                            </select>
                        </form>
                    }
                </div>
                
                <p class="text-muted small mb-4">Configure the submission deadline date visible to students on their forms page for the selected session.</p>
                <form asp-action="UpdateIAFDeadline" method="post" class="mt-auto">
                    <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success border-0 p-2 small mb-3">@TempData["Success"]</div>
                    }
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info border-0 p-2 small mb-3">@TempData["Info"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 p-2 small mb-3">@TempData["Error"]</div>
                    }
                    
                    @if(string.IsNullOrEmpty(ViewBag.CurrentSessionFilter))
                    {
                        <div class="alert alert-warning border-0 p-2 small mb-3">No active academic session found. Students must register first.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <input type="date" name="deadline" class="form-control bg-light" value="@ViewBag.IAFDeadline" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <div class="form-text text-muted small mt-1"><i class="fas fa-info-circle me-1"></i>Time will be automatically set to 11:59 PM.</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Save Deadline</button>
                    }
                </form>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="fas fa-lock text-warning me-2"></i>Grade Submission Lock</h5>
                    
                    @if (ViewBag.DistinctSessions != null && ((IEnumerable<string>)ViewBag.DistinctSessions).Any())
                    {
                        <form method="get" asp-action="Settings" id="gradeSessionFilterForm" class="ms-2">
                            <select name="sessionFilter" class="form-select form-select-sm" onchange="document.getElementById('gradeSessionFilterForm').submit()">
                                @foreach (var sessionName in (IEnumerable<string>)ViewBag.DistinctSessions)
                                {
                                    if (ViewBag.CurrentSessionFilter == sessionName)
                                    {
                                        <option value="@sessionName" selected>@sessionName</option>
                                    }
                                    else
                                    {
                                        <option value="@sessionName">@sessionName</option>
                                    }
                                }
                            </select>
                        </form>
                    }
                </div>
                
                <p class="text-muted small mb-4">Lock final grade submissions for the selected session. Supervisors will no longer be able to edit grades once locked.</p>
                
                <div class="mt-auto">
                    @if(string.IsNullOrEmpty(ViewBag.CurrentSessionFilter))
                    {
                        <div class="alert alert-warning border-0 p-2 small mb-3">No active academic session found.</div>
                    }
                    else if (ViewBag.SessionProjectCount == 0)
                    {
                        <div class="alert alert-info border-0 p-2 small mb-3">No projects exist in this session yet.</div>
                    }
                    else
                    {
                        <form asp-action="ToggleGradeLock" method="post">
                            <input type="hidden" name="sessionFilter" value="@ViewBag.CurrentSessionFilter" />
                            
                            @if (ViewBag.IsSessionLocked)
                            {
                                <div class="alert alert-danger bg-light-danger border-0 p-3 mb-4 text-center rounded-3">
                                    <i class="fas fa-lock fs-1 text-danger mb-2"></i>
                                    <h6 class="fw-bold text-danger mb-0">Grading is Locked</h6>
                                    <small class="text-danger">for @ViewBag.CurrentSessionFilter</small>
                                </div>
                                <input type="hidden" name="lockState" value="false" />
                                <button type="submit" class="btn btn-outline-danger w-100 fw-bold">Unlock Grading</button>
                            }
                            else if (ViewBag.IsSessionPartiallyLocked)
                            {
                                <div class="alert alert-warning bg-light-warning border-0 p-3 mb-4 text-center rounded-3">
                                    <i class="fas fa-exclamation-triangle fs-1 text-warning mb-2"></i>
                                    <h6 class="fw-bold text-warning mb-0">Partially Locked</h6>
                                    <small class="text-warning">Some projects are locked</small>
                                </div>
                                <input type="hidden" name="lockState" value="true" />
                                <button type="submit" class="btn btn-warning w-100 fw-bold text-dark">Lock All Grading</button>
                            }
                            else
                            {
                                <div class="alert alert-success bg-light-success border-0 p-3 mb-4 text-center rounded-3">
                                    <i class="fas fa-lock-open fs-1 text-success mb-2"></i>
                                    <h6 class="fw-bold text-success mb-0">Grading is Open</h6>
                                    <small class="text-success">for @ViewBag.CurrentSessionFilter</small>
                                </div>
                                <input type="hidden" name="lockState" value="true" />
                                <button type="submit" class="btn btn-warning w-100 fw-bold text-dark">Lock Grading</button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                <h5 class="fw-bold mb-3 text-danger"><i class="fas fa-shield-alt me-2"></i>Defense List</h5>
                <p class="text-muted small mb-4">View and notify students who have had their Initial Project Allocation Form (IAF) rejected 3 times.</p>
                <div class="mt-auto">
                    <a href="/Admin/DefenseList" class="btn btn-outline-danger w-100 fw-bold">View Defense List</a>
                </div>
            </div>
        </div>
    </div>
</div>
