@using FYPTracker.Models
@model FYPProject
@{
    ViewData["Title"] = "Project Milestones";
}

<style>
    :root { --blue-grad: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); }

    .page-hero {
        background: var(--blue-grad);
        border-radius: 24px;
        padding: 40px 48px;
        color: white;
        margin-bottom: 32px;
        box-shadow: 0 15px 35px -5px rgba(15, 23, 42, 0.4);
        position: relative;
        overflow: hidden;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        padding: 24px;
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        border-color: rgba(37, 99, 235, 0.2);
    }

    .milestone-item {
        border-left: 4px solid #3b82f6;
        background: #f8fafc;
        border-radius: 0 12px 12px 0;
        padding: 16px 20px;
        margin-bottom: 16px;
        transition: all 0.2s ease;
    }
    .milestone-item:hover {
        background: #f1f5f9;
        transform: translateX(4px);
    }

    .btn-action {
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
        transition: all 0.2s;
    }
    .btn-edit { background: #e0e7ff; color: #4f46e5; }
    .btn-edit:hover { background: #c7d2fe; }
    .btn-delete { background: #fee2e2; color: #dc2626; }
    .btn-delete:hover { background: #fecaca; }
    .btn-add { background: #2563eb; color: white; border-radius: 10px; padding: 10px 20px; font-weight: 600; }
    .btn-add:hover { background: #1d4ed8; color: white;}
    .z-index-1 { z-index: 1; }
</style>

<div class="container-fluid py-4">
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-light-success border border-success border-opacity-25 shadow-sm p-4 mb-4 rounded-4 d-flex align-items-center">
            <i class="fas fa-check-circle text-success fs-2 me-3"></i>
            <div class="fs-6 fw-bold text-dark">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-light-danger border border-danger border-opacity-25 shadow-sm p-4 mb-4 rounded-4 d-flex align-items-center">
            <i class="fas fa-exclamation-circle text-danger fs-2 me-3"></i>
            <div class="fs-6 fw-bold text-dark">@TempData["Error"]</div>
        </div>
    }

    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-4 position-relative">
        <div class="position-absolute top-0 end-0 opacity-10 pe-none" style="transform: translate(10%, -10%);">
            <i class="fas fa-project-diagram" style="font-size: 15rem; color: #ffffff;"></i>
        </div>
        <div class="position-relative z-index-1">
            <a href="/Admin/ManageProjects" class="text-white text-decoration-none opacity-75 mb-3 d-inline-block"><i class="fas fa-arrow-left me-2"></i>Back to Projects</a>
            <h1 class="display-5 fw-bolder mb-2 text-white" style="letter-spacing: -1px;">
                Milestone <span style="background: linear-gradient(to right, #60a5fa, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Management</span>
            </h1>
            <p class="text-white-50 fs-5 mt-1 mb-0" style="font-weight: 300;">Configure tracking milestones for this student.</p>
        </div>
        <div class="text-end position-relative z-index-1">
            <button class="btn btn-light text-primary fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addMilestoneModal">
                <i class="fas fa-plus me-1"></i> Add Milestone
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="glass-card">
                <h6 class="fw-bold text-dark mb-4"><i class="fas fa-user-graduate text-primary me-2"></i>Student Details</h6>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div style="width:50px;height:50px;border-radius:50%;background:#e0e7ff;display:flex;align-items:center;justify-content:center;color:#4f46e5;font-weight:700;font-size:18px;">
                        @(Model.Student?.FullName?.Substring(0, 1) ?? "S")
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-5">@Model.Student?.FullName</div>
                        <div class="text-muted small">@Model.Student?.Email</div>
                    </div>
                </div>
                
                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-project-diagram text-primary me-2"></i>Project Info</h6>
                <div class="mb-3">
                    <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Project Title</small>
                    <span class="fw-semibold text-dark">@Model.Title</span>
                </div>
                <div>
                    <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Status</small>
                    <span class="badge bg-success rounded-pill px-3">@Model.Status</span>
                </div>
            </div>
        </div>

        <!-- Viva Scheduling Card (Admin only) -->
        <div class="col-lg-4">
            <div class="glass-card" style="border-left: 4px solid #10b981;">
                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-calendar-check text-success me-2"></i>Viva Scheduling</h6>
                @if (Model.VivaDate.HasValue)
                {
                    <div class="alert alert-success border-0 rounded-3 p-3 mb-3 d-flex align-items-center gap-3">
                        <i class="fas fa-calendar-alt fs-4 text-success"></i>
                        <div>
                            <div class="fw-bold text-muted text-uppercase" style="font-size:0.7rem;">Current Viva Date</div>
                            <div class="fw-bold text-success">@Model.VivaDate.Value.ToString("dd MMMM yyyy, hh:mm tt")</div>
                            @if (!string.IsNullOrEmpty(Model.VivaVenue))
                            {
                                <div class="fw-bold text-muted text-uppercase mt-1" style="font-size:0.7rem;">Venue</div>
                                <div class="fw-bold text-success" style="font-size:0.85rem;">@Model.VivaVenue</div>
                            }
                        </div>
                    </div>
                }
                <form asp-action="SetVivaDate" asp-controller="Admin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase" style="font-size:0.75rem;">
                            @(Model.VivaDate.HasValue ? "Change Viva Date & Time" : "Set Viva Date & Time")
                        </label>
                        <input type="datetime-local"
                               name="vivaDate"
                               class="form-control rounded-3 mb-2"
                               value="@(Model.VivaDate?.ToString("yyyy-MM-ddTHH:mm"))"
                               required />
                        <label class="form-label fw-bold text-muted small text-uppercase" style="font-size:0.75rem;">Venue</label>
                        <input type="text"
                               name="vivaVenue"
                               class="form-control rounded-3"
                               placeholder="e.g. DK1 or Zoom Link"
                               value="@Model.VivaVenue" />
                        <div class="form-text text-muted mt-1">
                            <i class="fas fa-info-circle me-1"></i>Student, Supervisor &amp; Examiner will be notified by email and in-app.
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success w-100 rounded-3 fw-bold">
                        <i class="fas fa-calendar-check me-2"></i>@(Model.VivaDate.HasValue ? "Update Viva Date" : "Schedule Viva")
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="glass-card">
                <h5 class="fw-bold text-dark mb-4"><i class="fas fa-stream text-primary me-2"></i>Project Milestones</h5>
                
                @if (!Model.Milestones.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-folder-open fs-1 opacity-25 d-block mb-3"></i>
                        No milestones configured yet.
                    </div>
                }
                else
                {
                    <div class="milestone-list">
                        @foreach (var m in Model.Milestones.OrderBy(x => x.DueDate))
                        {
                            <div class="milestone-item d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@m.Title</h6>
                                    @if (!string.IsNullOrEmpty(m.Description))
                                    {
                                        <p class="text-muted small mb-2" style="max-width: 500px;">@m.Description</p>
                                    }
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge @(m.Status == "Approved" ? "bg-success" : (m.Status == "Pending" ? "bg-warning text-dark" : "bg-primary")) rounded-pill">@m.Status</span>
                                        @if (m.DueDate.HasValue)
                                        {
                                            <small class="text-muted fw-semibold"><i class="far fa-calendar-alt me-1"></i>Due: @m.DueDate.Value.ToString("dd MMM yyyy")</small>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (m.Status != "Approved")
                                    {
                                        <button class="btn-action btn-edit" data-bs-toggle="modal" data-bs-target="#editMilestoneModal_@m.Id">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                    }
                                    @if (m.Status == "Pending" && !m.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase) && !m.Title.Contains("Final", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-action="DeleteMilestone" method="post" onsubmit="confirmDelete(event, this)">
                                            <input type="hidden" name="milestoneId" value="@m.Id" />
                                            <button type="submit" class="btn-action btn-delete">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>

                            <!-- Edit Modal for @m.Id -->
                            <div class="modal fade" id="editMilestoneModal_@m.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg rounded-4">
                                        <form asp-action="EditMilestone" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="milestoneId" value="@m.Id" />
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="fw-bold text-primary"><i class="fas fa-edit me-2"></i>Edit Milestone</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body py-4">
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold text-muted">Milestone Title</label>
                                                    @if (m.Status != "Pending")
                                                    {
                                                        <input type="text" name="title" class="form-control rounded-3 bg-light" value="@m.Title" readonly required />
                                                    }
                                                    else
                                                    {
                                                        <input type="text" name="title" class="form-control rounded-3" value="@m.Title" required />
                                                    }
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold text-muted">Description</label>
                                                    @if (m.Status != "Pending")
                                                    {
                                                        <textarea name="description" class="form-control rounded-3 bg-light" rows="3" readonly>@m.Description</textarea>
                                                        <small class="text-info mt-1 d-block"><i class="fas fa-info-circle me-1"></i>Only the due date can be updated for active submissions.</small>
                                                    }
                                                    else
                                                    {
                                                        <textarea name="description" class="form-control rounded-3" rows="3">@m.Description</textarea>
                                                    }
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold text-muted">Due Date</label>
                                                    <input type="date" name="dueDate" class="form-control rounded-3" value="@(m.DueDate?.ToString("yyyy-MM-dd"))" />
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-light rounded-3 fw-bold" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addMilestoneModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form asp-action="AddMilestone" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Id" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-primary"><i class="fas fa-plus-circle me-2"></i>Add Custom Milestone</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Milestone Title</label>
                        <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Hardware Prototype Demo" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Description</label>
                        <textarea name="description" class="form-control rounded-3" rows="3" placeholder="Explain the requirements..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Due Date</label>
                        <input type="date" name="dueDate" class="form-control rounded-3" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4">Add Milestone</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(e, form) {
            e.preventDefault();
            Swal.fire({
                title: 'Delete Milestone?',
                text: "Are you sure you want to delete this milestone? This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, delete it!',
                background: '#ffffff',
                customClass: { popup: 'rounded-4 shadow-lg border-0' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        }
    </script>
}
