@{
    ViewData["Title"] = "Global Analytics";
}

<style>
    :root { --hero-grad-admin: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); }

    .page-hero {
        background: var(--hero-grad-admin);
        border-radius: 24px;
        padding: 40px 48px;
        color: white;
        margin-bottom: 32px;
        box-shadow: 0 15px 35px -5px rgba(15, 23, 42, 0.4);
        position: relative;
        overflow: hidden;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        padding: 24px;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        border-color: rgba(37, 99, 235, 0.2);
    }

    .chart-container {
        position: relative;
        flex-grow: 1;
        min-height: 300px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .z-index-1 { z-index: 1; }
</style>

<div class="container-fluid py-4">

    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-4 position-relative">
        <!-- Abstract background elements for premium feel -->
        <div class="position-absolute top-0 end-0 opacity-10 pe-none" style="transform: translate(10%, -10%);">
            <i class="fas fa-chart-pie" style="font-size: 15rem; color: #ffffff;"></i>
        </div>
        <div class="position-relative z-index-1 flex-grow-1">
            <h1 class="display-5 fw-bolder mb-2 text-white" style="letter-spacing: -1px;">
                Global <span style="background: linear-gradient(to right, #60a5fa, #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Analytics</span>
            </h1>
            <p class="text-white-50 fs-5 mt-1 mb-0" style="font-weight: 300;">System-wide overview of student allocation, supervisor capacity, and academic bottlenecks.</p>
        </div>
        
        <div class="position-relative z-index-1 mt-3 mt-md-0 d-flex gap-2">
            <form method="get" asp-action="Reporting" class="d-flex align-items-center gap-2 bg-white p-2 rounded-3 shadow-sm border-0">
                <i class="fas fa-filter text-primary ms-2"></i>
                <select name="sessionFilter" class="form-select form-select-sm border-0 fw-bold shadow-none text-dark bg-white" onchange="this.form.submit()" style="cursor: pointer; width: auto; min-width: 180px; font-size: 0.95rem;">
                    <option value="">All Sessions (Global)</option>
                    @if(ViewBag.DistinctSessions != null)
                    {
                        foreach(var s in (IEnumerable<string>)ViewBag.DistinctSessions)
                        {
                            if(ViewBag.CurrentSessionFilter == s)
                            {
                                <option value="@s" selected>Session: @s</option>
                            }
                            else
                            {
                                <option value="@s">Session: @s</option>
                            }
                        }
                    }
                </select>
            </form>
            <a href="/Admin/ExportSummary" class="btn btn-sm btn-success shadow-sm fw-bold align-self-center h-40px d-flex align-items-center bg-white text-success border-0" style="border-radius: 10px;">
                <i class="bi bi-file-earmark-spreadsheet fs-5 me-2"></i> Export Report
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Student Allocation Doughnut -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card">
                <h6 class="fw-bold text-dark text-uppercase mb-4" style="letter-spacing: 0.5px; font-size: 0.85rem;">Global Project Allocation</h6>
                <div class="chart-container">
                    <canvas id="allocationChart"></canvas>
                </div>
                <div id="allocationInsight"></div>
            </div>
        </div>

        <!-- Faculty Demographics Pie -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card">
                <h6 class="fw-bold text-dark text-uppercase mb-4" style="letter-spacing: 0.5px; font-size: 0.85rem;">Student Demographics (Program)</h6>
                <div class="chart-container">
                    <canvas id="programChart"></canvas>
                </div>
                <div id="programInsight"></div>
            </div>
        </div>

        <!-- Milestone Bottlenecks Stacked Bar -->
        <div class="col-md-12 col-lg-4">
            <div class="glass-card">
                <h6 class="fw-bold text-dark text-uppercase mb-4" style="letter-spacing: 0.5px; font-size: 0.85rem;">Milestone Health</h6>
                <div class="chart-container">
                    <canvas id="milestoneChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Supervisor Capacity Horizontal Bar Chart -->
        <div class="col-12">
            <div class="glass-card">
                <h6 class="fw-bold text-dark text-uppercase mb-4" style="letter-spacing: 0.5px; font-size: 0.85rem;">Supervisor Capacity vs. Workload</h6>
                <div class="chart-container" style="min-height: 500px;">
                    <canvas id="capacityChart"></canvas>
                </div>
                <div id="capacityInsight"></div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // Shared Color Palette 
            const colors = {
                success: 'rgba(16, 185, 129, 0.8)', // Emerald
                warning: 'rgba(245, 158, 11, 0.8)',  // Amber
                danger: 'rgba(239, 68, 68, 0.8)',    // Red
                info: 'rgba(59, 130, 246, 0.8)',     // Blue
                purple: 'rgba(139, 92, 246, 0.8)',   // Purple
                slate1: 'rgba(100, 116, 139, 0.8)',  // Slate
                slate2: 'rgba(203, 213, 225, 0.8)'   // Light Slate
            };

            const bgColors = [colors.info, colors.purple, colors.success, colors.warning, colors.danger, colors.slate1];

            // 1. Allocation Chart (Doughnut)
            const rawAllocation = @Html.Raw(ViewBag.AllocationStatsJson ?? "[]");
            if(rawAllocation.length > 0) {
                const ctx1 = document.getElementById('allocationChart').getContext('2d');
                new Chart(ctx1, {
                    type: 'doughnut',
                    data: {
                        labels: rawAllocation.map(x => x.Status),
                        datasets: [{
                            data: rawAllocation.map(x => x.Count),
                            backgroundColor: [
                                colors.success, // Allocated
                                colors.warning, // Pending
                                colors.danger   // No Project
                            ],
                            borderWidth: 0
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
                });
                
                let totalStudents = rawAllocation.reduce((sum, x) => sum + x.Count, 0);
                let allocated = rawAllocation.find(x => x.Status === "Allocated")?.Count || 0;
                let pct = totalStudents > 0 ? Math.round((allocated / totalStudents) * 100) : 0;
                document.getElementById('allocationInsight').innerHTML = `<div class="text-muted small mt-3 fw-bold text-center"><i class="fas fa-lightbulb text-warning me-1"></i> ${pct}% of students are fully allocated to a project.</div>`;
            } else {
                document.getElementById('allocationChart').outerHTML = `<div class="text-center py-5 w-100"><i class="fas fa-chart-pie fa-3x text-muted mb-3 opacity-50"></i><div class="text-muted fw-bold fs-6">No data available</div></div>`;
            }

            // 2. Program Demographics (Pie)
            const rawPrograms = @Html.Raw(ViewBag.ProgramStatsJson ?? "[]");
            if(rawPrograms.length > 0) {
                const ctx2 = document.getElementById('programChart').getContext('2d');
                new Chart(ctx2, {
                    type: 'pie',
                    data: {
                        labels: rawPrograms.map(x => x.Program),
                        datasets: [{
                            data: rawPrograms.map(x => x.Count),
                            backgroundColor: bgColors,
                            borderWidth: 0
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
                });
                
                let topProg = rawPrograms.reduce((prev, current) => (prev.Count > current.Count) ? prev : current, rawPrograms[0]);
                if (topProg) {
                    document.getElementById('programInsight').innerHTML = `<div class="text-muted small mt-3 fw-bold text-center"><i class="fas fa-lightbulb text-warning me-1"></i> ${topProg.Program} is the most common program.</div>`;
                }
            } else {
                document.getElementById('programChart').outerHTML = `<div class="text-center py-5 w-100"><i class="fas fa-chart-pie fa-3x text-muted mb-3 opacity-50"></i><div class="text-muted fw-bold fs-6">No data available</div></div>`;
            }

            // 3. Milestone Health (Stacked Bar)
            // JSON format: [{Category: "IAF", Status: "Approved", Count: 5}, ...]
            const rawMilestones = @Html.Raw(ViewBag.MilestoneBottlenecksJson ?? "[]");
            if(rawMilestones.length > 0) {
                const categories = ["IAF", "Proposal", "Final Report"];
                
                // Helper to get count for a specific category and status
                const getCount = (cat, stat) => {
                    const match = rawMilestones.find(m => m.Category === cat && m.Status === stat);
                    return match ? match.Count : 0;
                };

                const approvedData = categories.map(c => getCount(c, "Approved"));
                const pendingData = categories.map(c => getCount(c, "Pending") + getCount(c, "UnderReview") + getCount(c, "Submitted"));
                const rejectedData = categories.map(c => getCount(c, "Rejected") + getCount(c, "NeedRevision"));

                const ctx3 = document.getElementById('milestoneChart').getContext('2d');
                new Chart(ctx3, {
                    type: 'bar',
                    data: {
                        labels: categories,
                        datasets: [
                            { label: 'Approved', data: approvedData, backgroundColor: colors.success },
                            { label: 'In Progress/Pending', data: pendingData, backgroundColor: colors.warning },
                            { label: 'Rejected/Revision', data: rejectedData, backgroundColor: colors.danger }
                        ]
                    },
                    options: { 
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } },
                        scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            } else {
                document.getElementById('milestoneChart').outerHTML = `<div class="text-center py-5 w-100"><i class="fas fa-chart-bar fa-3x text-muted mb-3 opacity-50"></i><div class="text-muted fw-bold fs-6">No data available</div></div>`;
            }

            // 4. Supervisor Capacity (Horizontal Bar)
            // JSON format: [{Name: "Dr. A", MaxSlots: 5, CurrentStudents: 3}, ...]
            const rawSupervisors = @Html.Raw(ViewBag.SupervisorCapacityJson ?? "[]");
            if(rawSupervisors.length > 0) {
                // Sort by Most loaded to least loaded
                rawSupervisors.sort((a,b) => b.CurrentStudents - a.CurrentStudents);

                const ctx4 = document.getElementById('capacityChart').getContext('2d');
                new Chart(ctx4, {
                    type: 'bar',
                    data: {
                        labels: rawSupervisors.map(s => s.Name),
                        datasets: [
                            {
                                label: 'Current Assigned Students',
                                data: rawSupervisors.map(s => s.CurrentStudents),
                                backgroundColor: colors.info,
                                borderRadius: 4
                            },
                            {
                                label: 'Remaining Capacity (Max Slots)',
                                data: rawSupervisors.map(s => Math.max(0, s.MaxSlots - s.CurrentStudents)),
                                backgroundColor: colors.slate2,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        indexAxis: 'y', // Makes it horizontal
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'top' } },
                        scales: { 
                            x: { stacked: true, beginAtZero: true, ticks: { stepSize: 1 } },
                            y: { stacked: true }
                        }
                    }
                });

                let overbooked = rawSupervisors.filter(s => s.CurrentStudents >= s.MaxSlots).length;
                if (overbooked > 0) {
                    document.getElementById('capacityInsight').innerHTML = `<div class="text-muted small mt-3 fw-bold text-center"><i class="fas fa-exclamation-circle text-danger me-1"></i> ${overbooked} supervisor(s) have reached or exceeded maximum capacity.</div>`;
                } else {
                    document.getElementById('capacityInsight').innerHTML = `<div class="text-muted small mt-3 fw-bold text-center"><i class="fas fa-check-circle text-success me-1"></i> All supervisors are within their maximum capacity limits.</div>`;
                }
            } else {
                document.getElementById('capacityChart').outerHTML = `<div class="text-center py-5 w-100"><i class="fas fa-chart-bar fa-3x text-muted mb-3 opacity-50"></i><div class="text-muted fw-bold fs-6">No data available</div></div>`;
            }

        });
    </script>
}
