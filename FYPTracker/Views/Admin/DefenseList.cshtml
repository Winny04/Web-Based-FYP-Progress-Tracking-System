@model IEnumerable<FYPTracker.Models.FYPMilestone>

@{
    ViewData["Title"] = "Defense List";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-shield-alt me-2 text-danger"></i>Defense List</h2>
            <p class="text-muted mb-0">Students who have had their Initial Project Allocation Form (IAF) rejected 3 times.</p>
        </div>
        <div>
            @if(Model.Any())
            {
                <form asp-action="NotifyDefenseList" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger fw-bold shadow-sm">
                        <i class="fas fa-bell me-2"></i>Notify All Students
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm p-3 mb-4 rounded-3">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 fw-bold text-uppercase text-secondary small py-3">Student Name</th>
                            <th class="fw-bold text-uppercase text-secondary small py-3">Student ID</th>
                            <th class="fw-bold text-uppercase text-secondary small py-3">Project Title</th>
                            <th class="fw-bold text-uppercase text-secondary small py-3">Supervisor</th>
                            <th class="text-center fw-bold text-uppercase text-secondary small py-3 pe-4">Rejection Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fas fa-check-circle fs-2 text-success mb-3 d-block"></i>
                                    No students are currently on the Defense List.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var milestone in Model)
                            {
                                var student = milestone.Project?.Student;
                                var supervisor = milestone.Project?.Supervisor;

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@(student?.FullName ?? "Unknown")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(student?.EmployeeId ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">@(milestone.Project?.Title ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="symbol symbol-30px symbol-circle me-2 bg-primary text-white d-flex align-items-center justify-content-center fw-bold">
                                                @(supervisor?.FullName?.Substring(0,1) ?? "?")
                                            </div>
                                            <span class="fw-semibold text-gray-800">@(supervisor?.FullName ?? "Unassigned")</span>
                                        </div>
                                    </td>
                                    <td class="text-center pe-4">
                                        <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold shadow-sm fs-6">@milestone.RejectionCount</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
