@model IEnumerable<FYPTracker.Models.FYPMilestone>

@{
    ViewData["Title"] = "Defense List";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-shield-alt me-2 text-danger"></i>Defense List</h2>
            <p class="text-muted mb-0">Students who have had their Initial Project Allocation Form (IAF) rejected 3 times.</p>
        </div>
        <div>
            @if(Model.Any())
            {
                <button type="button" class="btn btn-danger fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#scheduleDefenseModal">
                    <i class="fas fa-calendar-alt me-2"></i>Schedule Defense
                </button>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm p-3 mb-4 rounded-3">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 fw-bold text-uppercase text-secondary small py-3">Student Name</th>
                            <th class="fw-bold text-uppercase text-secondary small py-3">Matric ID</th>
                            <th class="fw-bold text-uppercase text-secondary small py-3">Project Title</th>
                            <th class="fw-bold text-uppercase text-secondary small py-3">Supervisor</th>
                            <th class="text-center fw-bold text-uppercase text-secondary small py-3">Rejection Count</th>
                            <th class="fw-bold text-uppercase text-secondary small py-3">Defense Schedule</th>
                            <th class="text-end fw-bold text-uppercase text-secondary small py-3 pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-check-circle fs-2 text-success mb-3 d-block"></i>
                                    No students are currently on the Defense List.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var milestone in Model)
                            {
                                var student = milestone.Project?.Student;
                                var supervisor = milestone.Project?.Supervisor;

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@(student?.FullName ?? "Unknown")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(student?.EmployeeId ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">@(milestone.Project?.Title ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="symbol symbol-30px symbol-circle me-2 bg-primary text-white d-flex align-items-center justify-content-center fw-bold">
                                                @(supervisor?.FullName?.Substring(0,1) ?? "?")
                                            </div>
                                            <span class="fw-semibold text-gray-800">@(supervisor?.FullName ?? "Unassigned")</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold shadow-sm fs-6">@milestone.RejectionCount</span>
                                    </td>
                                    <td>
                                        @if (milestone.DefenseDate.HasValue)
                                        {
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-dark"><i class="fas fa-calendar-day text-primary me-1"></i>@(milestone.DefenseDate.Value.ToString("dd MMM yyyy"))</span>
                                                <span class="text-muted small"><i class="fas fa-clock text-warning me-1"></i>@milestone.DefenseTime</span>
                                                <span class="text-muted small"><i class="fas fa-map-marker-alt text-success me-1"></i>@milestone.DefenseVenue</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Not Scheduled</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="AllowIafResubmission" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to allow this student to resubmit their IAF form?');">
                                            <input type="hidden" name="milestoneId" value="@milestone.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold">
                                                <i class="fas fa-undo me-1"></i>Allow Resubmit
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Schedule Defense Modal -->
    <div class="modal fade" id="scheduleDefenseModal" tabindex="-1" aria-labelledby="scheduleDefenseModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <form asp-action="NotifyDefenseList" method="post">
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" id="scheduleDefenseModalLabel"><i class="fas fa-calendar-check text-primary me-2"></i>Schedule Defense</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info border-0 mb-4">
                            <i class="fas fa-info-circle me-2"></i> Each student will be allocated a 15-minute slot sequentially starting from the time you specify below.
                        </div>
                        <div class="mb-3">
                            <label for="defenseDate" class="form-label fw-bold">Defense Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="defenseDate" name="defenseDate" required>
                        </div>
                        <div class="mb-3">
                            <label for="startTime" class="form-label fw-bold">Start Time <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" id="startTime" name="startTime" required>
                        </div>
                        <div class="mb-4">
                            <label for="venue" class="form-label fw-bold">Venue / Link <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="venue" name="venue" placeholder="e.g. Room 101 or Teams Link" required>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-paper-plane me-2"></i>Schedule & Notify</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
