@using System.Text.Json
@model IEnumerable<FYPTracker.Models.FYPMilestone>
@{
    ViewData["Title"] = "Defense List";
    var rowData = Model.Select(m => new {
        Id = m.Id,
        StudentName = m.Project?.Student?.FullName ?? "Unknown",
        MatricId = m.Project?.Student?.EmployeeId ?? "N/A",
        ProjectTitle = m.Project?.Title ?? "N/A",
        SupervisorName = m.Project?.Supervisor?.FullName ?? "Unassigned",
        ExaminerName = m.Project?.AssignedExaminers?.FirstOrDefault()?.Examiner?.FullName ?? "Unassigned",
        RejectionCount = m.RejectionCount,
        DefenseDate = m.DefenseDate?.ToString("dd MMM yyyy"),
        DefenseTime = m.DefenseTime,
        DefenseVenue = m.DefenseVenue,
        IsScheduled = m.DefenseDate.HasValue
    }).ToList();
    
    var jsonRowData = JsonSerializer.Serialize(rowData);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.2/styles/ag-grid.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.2/styles/ag-theme-quartz.css" />
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-shield-alt me-2 text-danger"></i>Defense List</h2>
            <p class="text-muted mb-0">Students who have had their Initial Project Allocation Form (IAF) rejected 3 times.</p>
        </div>
        <div>
            @if(Model.Any())
            {
                <button type="button" class="btn btn-danger fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#scheduleDefenseModal">
                    <i class="fas fa-calendar-alt me-2"></i>Schedule Defense
                </button>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm p-3 mb-4 rounded-3">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div id="defenseGrid" class="ag-theme-quartz" style="height: 600px; width: 100%;"></div>
        </div>
    </div>
    
    <!-- Hidden form for Resubmit -->
    <form id="resubmitForm" asp-action="AllowIafResubmission" method="post" style="display:none;">
        <input type="hidden" name="milestoneId" id="resubmitMilestoneId" />
    </form>

    <!-- Schedule Defense Modal -->
    <div class="modal fade" id="scheduleDefenseModal" tabindex="-1" aria-labelledby="scheduleDefenseModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <form asp-action="NotifyDefenseList" method="post" id="defenseScheduleForm">
                    <div id="hiddenMilestonesContainer"></div>
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" id="scheduleDefenseModalLabel"><i class="fas fa-calendar-check text-primary me-2"></i>Schedule Defense</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info border-0 mb-4">
                            <i class="fas fa-info-circle me-2"></i> The selected students will be allocated a 15-minute slot sequentially starting from the time you specify below.
                        </div>
                        <div class="mb-3">
                            <label for="defenseDate" class="form-label fw-bold">Defense Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="defenseDate" name="defenseDate" min="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="mb-3">
                            <label for="startTime" class="form-label fw-bold">Start Time <span class="text-danger">*</span></label>
                            <select class="form-select" id="startTime" name="startTime" required>
                                <option value="" disabled selected>Select a time slot...</option>
                                <option value="09:00">09:00 AM</option>
                                <option value="09:30">09:30 AM</option>
                                <option value="10:00">10:00 AM</option>
                                <option value="10:30">10:30 AM</option>
                                <option value="11:00">11:00 AM</option>
                                <option value="11:30">11:30 AM</option>
                                <option value="12:00">12:00 PM</option>
                                <option value="12:30">12:30 PM</option>
                                <option value="13:00">01:00 PM</option>
                                <option value="13:30">01:30 PM</option>
                                <option value="14:00">02:00 PM</option>
                                <option value="14:30">02:30 PM</option>
                                <option value="15:00">03:00 PM</option>
                                <option value="15:30">03:30 PM</option>
                                <option value="16:00">04:00 PM</option>
                                <option value="16:30">04:30 PM</option>
                                <option value="17:00">05:00 PM</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="venue" class="form-label fw-bold">Venue / Link <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="venue" name="venue" placeholder="e.g. Room 101 or Teams Link" required>
                                <button class="btn btn-outline-primary fw-bold" type="button" onclick="generateMeetingLink()">
                                    <i class="fas fa-video me-1"></i> Generate Link
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-paper-plane me-2"></i>Schedule & Notify</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.2/dist/ag-grid-community.min.js"></script>
    <script>
        var rowData = @Html.Raw(jsonRowData);
        var gridApi;

        function submitResubmit(id) {
            if(confirm('Are you sure you want to allow this student to resubmit their IAF form?')) {
                document.getElementById('resubmitMilestoneId').value = id;
                document.getElementById('resubmitForm').submit();
            }
        }

        function generateMeetingLink() {
            const randomId = Math.random().toString(36).substring(2, 10);
            const link = "https://meet.jit.si/FYP-Defense-" + randomId;
            document.getElementById('venue').value = link;
        }

        function scheduleSingle(id) {
            gridApi.deselectAll();
            
            // Select the specific row
            gridApi.forEachNode((node) => {
                if (node.data.Id === id) {
                    node.setSelected(true);
                }
            });
            
            var myModal = new bootstrap.Modal(document.getElementById('scheduleDefenseModal'));
            myModal.show();
        }

        document.addEventListener('DOMContentLoaded', function() {
            const gridOptions = {
                rowData: rowData,
                columnDefs: [
                    { 
                        headerName: "", 
                        field: "Id", 
                        checkboxSelection: true, 
                        headerCheckboxSelection: true, 
                        width: 50,
                        pinned: 'left',
                        sortable: false,
                        filter: false
                    },
                    { field: "StudentName", headerName: "Student Name", flex: 1, filter: true },
                    { field: "MatricId", headerName: "Matric ID", width: 130, filter: true, cellRenderer: params => `<span class="badge bg-light text-dark border">${params.value}</span>` },
                    { field: "ProjectTitle", headerName: "Project Title", flex: 1, filter: true, cellRenderer: params => `<span class="text-muted">${params.value}</span>` },
                    { field: "SupervisorName", headerName: "Supervisor", flex: 1, filter: true, cellRenderer: params => `<span class="fw-semibold text-gray-800"><i class="fas fa-user-tie text-muted me-2"></i>${params.value}</span>` },
                    { field: "ExaminerName", headerName: "Examiner", flex: 1, filter: true, cellRenderer: params => `<span class="fw-semibold text-gray-800"><i class="fas fa-user-tie text-muted me-2"></i>${params.value}</span>` },
                    { field: "RejectionCount", headerName: "Rej. Count", width: 120, cellRenderer: params => `<span class="badge bg-danger rounded-pill px-3 py-2 fw-bold shadow-sm fs-6">${params.value}</span>` },
                    { 
                        field: "DefenseSchedule", 
                        headerName: "Defense Schedule", 
                        width: 200, 
                        cellRenderer: params => {
                            if (params.data.IsScheduled) {
                                return `<div class="d-flex flex-column lh-sm mt-2">
                                            <span class="fw-bold text-dark"><i class="fas fa-calendar-day text-primary me-1"></i>${params.data.DefenseDate}</span>
                                            <span class="text-muted small"><i class="fas fa-clock text-warning me-1"></i>${params.data.DefenseTime}</span>
                                            ${params.data.DefenseVenue.startsWith('http') 
                                                ? `<a href="${params.data.DefenseVenue}" target="_blank" class="btn btn-sm btn-light-primary text-primary border py-1 px-2 mt-1 align-self-start fw-bold" style="font-size: 0.75rem;"><i class="fas fa-video me-1"></i>Join Meeting</a>` 
                                                : `<span class="text-muted small mt-1"><i class="fas fa-map-marker-alt text-success me-1"></i>${params.data.DefenseVenue}</span>`}
                                        </div>`;
                            } else {
                                return `<span class="badge bg-light text-muted border mt-3">Not Scheduled</span>`;
                            }
                        }
                    },
                    { 
                        headerName: "Actions", 
                        minWidth: 280, flex: 0, 
                        pinned: 'right',
                        sortable: false,
                        filter: false,
                        cellRenderer: params => `
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="scheduleSingle(${params.data.Id})">
                                    <i class="fas fa-calendar-alt me-1"></i>Schedule
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success fw-bold" onclick="submitResubmit(${params.data.Id})">
                                    <i class="fas fa-undo me-1"></i>Resubmit
                                </button>
                            </div>
                        `
                    }
                ],
                defaultColDef: {
                    sortable: true,
                    resizable: true,
                    suppressMovable: true
                },
                pagination: true,
                paginationPageSize: 10,
                paginationPageSizeSelector: [10, 20, 50, 100],
                rowHeight: 70,
                rowSelection: 'multiple',
                autoSizeStrategy: { type: 'fitGridColumns' }
            };

            const gridDiv = document.querySelector('#defenseGrid');
            gridApi = agGrid.createGrid(gridDiv, gridOptions);

            const form = document.getElementById('defenseScheduleForm');
            const container = document.getElementById('hiddenMilestonesContainer');

            if (form) {
                form.addEventListener('submit', function(e) {
                    container.innerHTML = '';
                    const selectedRows = gridApi.getSelectedRows();
                    
                    if (selectedRows.length === 0) {
                        e.preventDefault();
                        alert('Please select at least one student to schedule a defense for.');
                        return;
                    }
                    
                    selectedRows.forEach(row => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'selectedMilestones';
                        input.value = row.Id;
                        container.appendChild(input);
                    });
                });
            }
        });
    </script>
}








