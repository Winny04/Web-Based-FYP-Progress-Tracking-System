@model IEnumerable<FYPTracker.ViewModels.ManageProjectItemVM>
@{
    ViewData["Title"] = "Project Management";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header border-0 pt-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3 class="fw-bolder text-dark mb-0"><i class="fas fa-project-diagram text-warning me-2"></i>All FYP Projects</h3>
                <p class="text-muted small mb-0">Monitor and manage all final year projects across the system.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <div class="d-flex align-items-center position-relative my-1">
                    <span class="svg-icon svg-icon-1 position-absolute ms-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black"></rect>
                            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.68629 5 5 7.68629 5 11C5 14.3137 7.68629 17 11 17C14.3137 17 17 14.3137 17 11C17 7.68629 14.3137 5 11 5Z" fill="black"></path>
                        </svg>
                    </span>
                    <input type="text" id="customSearch" class="form-control form-control-solid w-250px" style="padding-left: 2.8rem !important;" placeholder="Search projects...">
                </div>
                <a href="/Admin/ExportProjectsExcel" class="btn btn-sm btn-success rounded-3 fw-bold align-self-center h-40px d-flex align-items-center">
                    <i class="bi bi-file-earmark-spreadsheet fs-4 me-1"></i> Export Excel
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="projectsTable" class="table table-hover align-middle">
                    <thead class="bg-light text-muted text-uppercase fs-7 fw-bold">
                        <tr>
                            <th>Student</th>
                            <th>Supervisor</th>
                            <th>Project Title</th>
                            <th>Status</th>
                            <th>Started</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var student = item.Student;
                            var project = item.Project;
                            <tr>
                                <td>
                                    <div class="fw-bold">@student.FullName</div>
                                    <div class="text-muted small">@student.UserName</div>
                                </td>
                                <td>
                                    @if (project != null && project.Supervisor != null)
                                    {
                                        <div class="badge badge-light-primary">@project.Supervisor.FullName</div>
                                    }
                                    else
                                    {
                                        <span class="text-danger small"><i class="fas fa-exclamation-triangle me-1"></i> Not Assigned</span>
                                    }
                                </td>
                                <td class="fw-bold text-dark">@(project?.Title ?? "No Project")</td>
                                <td>
                                    @if(student.IsResign)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 text-white">Inactive</span>
                                    }
                                    else if(project != null)
                                    {
                                        @switch (project.Status)
                                        {
                                            case "Approved": <span class="badge bg-success rounded-pill px-3">Active</span> break;
                                            case "Proposed": <span class="badge bg-info rounded-pill px-3">Proposed</span> break;
                                            case "Completed": <span class="badge bg-primary rounded-pill px-3">Completed</span> break;
                                            default: <span class="badge bg-secondary rounded-pill px-3">@project.Status</span> break;
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 text-white">Inactive</span>
                                    }
                                </td>
                                <td>@(project?.StartDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td class="text-end">
                                    @if(project != null)
                                    {
                                        <button type="button" class="btn btn-sm btn-light-primary rounded-3" data-bs-toggle="modal" data-bs-target="#projectModal-@project.Id">Details</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light rounded-3 text-muted" disabled>No Details</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var item in Model.Where(m => m.Project != null))
{
    var p = item.Project;
    <!-- Modal for Project @p.Id -->
    <div class="modal fade" id="projectModal-@p.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bolder text-dark">Project Details</h5>
                    <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                        <i class="bi bi-x fs-2"></i>
                    </div>
                </div>
                <div class="modal-body pt-4 px-5 pb-5">
                    <div class="mb-5">
                        <label class="fw-bolder text-muted text-uppercase small mb-1">Student Name</label>
                        <div class="fs-4 text-dark fw-bold">@(item.Student.FullName ?? "Unknown Student")</div>
                    </div>
                    
                    <div class="mb-5">
                        <label class="fw-bolder text-muted text-uppercase small mb-1">Supervisor Name</label>
                        <div class="fs-4 text-dark fw-bold">
                            @if(p!.Supervisor != null)
                            {
                                @p.Supervisor.FullName
                            }
                            else
                            {
                                <span class="text-danger fst-italic">Not Assigned</span>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="fw-bolder text-muted text-uppercase small mb-1">Project Title</label>
                        <div class="fs-4 text-dark fw-bold">@p.Title</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



@section Scripts {
    <script>
        $(document).ready(function () {
            $('#projectsTable').DataTable({
                "pageLength": 10,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search projects..."
                },
                "columnDefs": [
                    { "orderable": false, "targets": 5 }
                ]
            });

            $('#customSearch').keyup(function () {
                $('#projectsTable').DataTable().search($(this).val()).draw();
            });
            
            $('.dataTables_filter').hide();
            $('.dataTables_length select').addClass('form-select form-select-solid');
        });
    </script>
}

