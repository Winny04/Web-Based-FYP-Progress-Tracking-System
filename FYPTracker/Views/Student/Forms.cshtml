                                            @if (!string.IsNullOrEmpty(defensePanelComments))
                                            {
                                                <div class="mt-2 p-2 bg-white rounded border border-danger small text-dark">
                                                    <strong>Panel Comments:</strong> @defensePanelComments
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (iafMilestone?.Status == "DefenseScheduled")
                                {
                                    var scheduledBooking = ViewBag.ScheduledIafBooking as IAFDefenseBooking;
                                    var displayDefenseDate = scheduledBooking != null ? (DateTime?)scheduledBooking.DefenseDate : iafMilestone.DefenseDate;
                                    var displayDefenseVenue = scheduledBooking != null ? scheduledBooking.Venue : iafMilestone.DefenseVenue;
                                    string displayDefenseTime = "";
                                    if (scheduledBooking != null)
                                    {
                                        string sAmPm = DateTime.Today.Add(scheduledBooking.StartTime).ToString("tt");
                                        string eAmPm = DateTime.Today.Add(scheduledBooking.EndTime).ToString("tt");
                                        displayDefenseTime = sAmPm == eAmPm
                                            ? $"{DateTime.Today.Add(scheduledBooking.StartTime):hh:mm}–{DateTime.Today.Add(scheduledBooking.EndTime):hh:mm tt}"
                                            : $"{DateTime.Today.Add(scheduledBooking.StartTime):hh:mm tt}–{DateTime.Today.Add(scheduledBooking.EndTime):hh:mm tt}";
                                    }
                                    else if (!string.IsNullOrEmpty(iafMilestone.DefenseTime))
                                    {
                                        displayDefenseTime = iafMilestone.DefenseTime;
                                    }

                                    <div class="alert alert-info d-flex align-items-start mt-3 border-info mb-4">
                                        <i class="fas fa-calendar-check fs-2 me-3 text-info mt-1"></i>
                                        <div class="w-100">
                                            <h5 class="fw-bold text-dark mb-1">IAF Defense Scheduled</h5>
                                            <p class="mb-0 text-muted">Your IAF Defense session is scheduled and awaiting assessment. Your signed IAF is locked until the defense outcome is recorded.</p>
                                            
                                            @if (displayDefenseDate.HasValue)
                                            {
                                                <div class="mt-3 p-3 bg-white rounded border border-info">
                                                    <h6 class="fw-bold text-info mb-2"><i class="fas fa-calendar-alt me-1"></i> Your Scheduled Session:</h6>
                                                    <ul class="mb-0 text-dark fw-bold ps-3">
                                                        <li>Date: @displayDefenseDate.Value.ToString("dd MMMM yyyy")</li>
                                                        <li>Time: @displayDefenseTime</li>
                                                        <li>Venue: 
                                                            @if (!string.IsNullOrEmpty(displayDefenseVenue) && displayDefenseVenue.Contains("http"))
                                                            {
                                                                <a href="@displayDefenseVenue.Substring(displayDefenseVenue.IndexOf("http"))" target="_blank" class="text-primary text-decoration-underline">Join Online Defense Meeting</a>
                                                            }
                                                            else
                                                            {
                                                                @displayDefenseVenue
                                                            }
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    string displayStatus = iafMilestone.Status;
                                    string alertColor = "info";
                                    string icon = "fa-lock";
                                    string statusSubText = "Your Initial Project Allocation Form has been submitted.";
                                    
                                    if (iafMilestone.Status == "PendingSupervisorReview") {
                                        displayStatus = "Pending Supervisor Review";
                                        alertColor = "info";
                                        icon = "fa-hourglass-half";
                                        statusSubText = "Your IAF has been sent to your supervisor for review.";
                                    } else if (iafMilestone.Status == "PendingPanelReview") {
                                        displayStatus = "Pending Panel Review";
                                        alertColor = "success";
                                        icon = "fa-check-circle";
                                        statusSubText = "Your IAF has been signed by your Supervisor and automatically submitted for Admin Review.";
                                    } else if (iafMilestone.Status == "SupervisorSigned") {
                                        displayStatus = "Supervisor Signed — Pending Panel Review";
                                        alertColor = "success";
                                        icon = "fa-check-circle";
                                        statusSubText = "Your IAF has been signed by your Supervisor and automatically forwarded for Admin Review.";
                                    } else if (iafMilestone.Status == "AdminApproved") {
                                        displayStatus = "Fully Approved";
                                        alertColor = "success";
                                        icon = "fa-check-circle";
                                        statusSubText = "Your Initial Project Allocation Form has been officially approved by Administration.";
                                    }

                                    <div class="alert alert-@alertColor d-flex align-items-center mt-3 border-@alertColor mb-4 shadow-sm">
                                        <i class="fas @icon fs-2 me-3 text-@alertColor"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">IAF Form Status</h5>
                                            <p class="mb-0 text-muted">@statusSubText <span class="d-block mt-1">Current Status: <span class="badge bg-white text-dark ms-1 shadow-sm border">@displayStatus</span></span></p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                @if (iafMilestone != null && (iafMilestone.Status == "Rejected" || iafMilestone.Status == "ReturnedForEdits"))
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger mb-4">
                                        <i class="fas fa-times-circle fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">IAF Returned for Edits</h5>
                                            <p class="mb-0 text-muted"><strong>Feedback:</strong> @iafMilestone.SupervisorFeedback</p>
                                        </div>
                                    </div>
                                }
                                else if (iafMilestone != null && iafMilestone.Status == "PanelRevisionRequired")
                                {
                                    string panelComments = "No comments provided.";
                                    if (!string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: "))
                                    {
                                        try {
                                            var history = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None)[1]);
                                            var currentAttempt = history.Attempts.FirstOrDefault(a => a.AttemptNumber == history.CurrentAttempt);
                                            if (currentAttempt != null && !string.IsNullOrEmpty(currentAttempt.PanelComments)) {
                                                panelComments = currentAttempt.PanelComments;
                                            }
                                        } catch {}
                                    }

                                    <div class="alert alert-warning d-flex align-items-center mt-3 border-warning mb-4">
                                        <i class="fas fa-exclamation-triangle fs-2 me-3 text-warning"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Panel Revision Required</h5>
                                            <p class="mb-0 text-muted">Please update your IAF based on the panel's comments.</p>
                                            <div class="mt-2 p-2 bg-white rounded border border-warning">
                                                <strong>Panel Comments:</strong> @panelComments
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (iafMilestone != null && iafMilestone.Status == "ChangeOfTopicRequired")
                                {
                                    string panelComments = "No comments provided.";
                                    if (!string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: "))
                                    {
                                        try {
                                            var history = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None)[1]);
                                            var currentAttempt = history.Attempts.FirstOrDefault(a => a.AttemptNumber == history.CurrentAttempt);
                                            if (currentAttempt != null && !string.IsNullOrEmpty(currentAttempt.PanelComments)) {
                                                panelComments = currentAttempt.PanelComments;
                                            }
                                        } catch {}
                                    }

                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger mb-4">
                                        <i class="fas fa-sync fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Defense Failed - Change of Topic Required</h5>
                                            <p class="mb-0 text-muted">You must submit a new Initial Allocation Form with a different topic.</p>
                                            <div class="mt-2 p-2 bg-white rounded border border-danger">
                                                <strong>Feedback:</strong> @panelComments
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                                
                                @{
                                    bool enforceReferencesValidation = Model != null && FYPTracker.Helpers.DemoUiOverrideHelper.ShouldEnforceIafReferencesValidationForProject(Model.Id, _env, _configuration);
                                }
                                <form id="iafFormElement" asp-action="SubmitDigitalForm" method="post" class="needs-validation" novalidate data-is-locked="@(isIafLocked.ToString().ToLower())" data-enforce-references="@(enforceReferencesValidation.ToString().ToLower())">
                                    <input type="hidden" name="formType" value="Initial Project Allocation Form (IAF)" />
                                    <input type="hidden" name="milestoneId" value="@iafMilestoneId" />
                                    
                                    <!-- IAF Validation Summary -->
                                    <div id="iafValidationSummary"
                                        class="alert alert-danger border-danger d-none mb-4"
                                        role="alert"
                                        tabindex="-1">

                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fas fa-exclamation-circle fs-4 mt-1"></i>

                                            <div>
                                                <h6 class="fw-bold mb-2">
                                                    Please review your IAF form
                                                </h6>
                                                <p class="mb-2 small">
                                                    Correct the following fields before submitting.
                                                </p>
                                                <ul id="iafValidationList" class="mb-0 small ps-3"></ul>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="card mb-0 border-0 shadow-none iaf-document-card">
                                        <div class="card-body p-2 p-md-3" style="font-family: Arial, sans-serif; font-size: 14px; color: #000;">
                                            <style>
                                                .iaf-table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px; }
                                                .iaf-table, .iaf-table th, .iaf-table td { border: 1px solid #ccc; }
                                                .iaf-table th, .iaf-table td { padding: 8px; vertical-align: top; text-align: left; }
                                                .iaf-label { font-weight: bold; width: 30%; }
                                                .iaf-value { width: 70%; white-space: normal; }
                                                .iaf-attempt-card { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; padding: 12px 16px; border: 1px solid #e4e6ef; background-color: #fff; border-radius: 10px; transition: box-shadow .2s ease, transform .2s ease; }
                                                .iaf-attempt-card:hover { box-shadow: 0 4px 14px rgba(13,110,253,0.10); transform: translateY(-1px); }
                                                .iaf-attempt-card .iaf-attempt-title { font-weight: 700; color: #0d6efd; margin: 0; }
                                                .iaf-attempt-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 12px; }
                                                .iaf-readonly-view .iaf-value { background: #fff; white-space: pre-wrap }
                                                @@media print {
                                                    .iaf-attempt-card { box-shadow: none; }
                                                }
                                            </style>

                                            @* Unified IAF: use current Admin JSON for all 11 fields. *@
                                            @{
                                                var currentIafTemplate = iafTemplate; // Default to published
                                                string supervisorSignature = "";
                                                string supervisorFeedback = iafMilestone?.SupervisorFeedback ?? "";
                                                int? attemptNumber = null;
                                                
                                                var formDataMap = new Dictionary<string, string>();

                                                if (!string.IsNullOrEmpty(iafMilestone?.Remarks)
                                                    && iafMilestone.Remarks.Contains("JSON: "))
                                                {
                                                    try
                                                    {
                                                        var rawHistory = iafMilestone.Remarks.Split(
                                                            new[] { "JSON: " }, 2, StringSplitOptions.None)[1];
                                                        var historyForFields = IafAttemptHistory.ParseOrMigrate(rawHistory);
                                                        var currentAttemptForFields = historyForFields.Attempts
                                                            .FirstOrDefault(a => a.AttemptNumber == historyForFields.CurrentAttempt);
                                                            
                                                        if (currentAttemptForFields != null)
                                                        {
                                                            attemptNumber = currentAttemptForFields.AttemptNumber;
                                                            var data = currentAttemptForFields.FormData
                                                                ?? new Dictionary<string, string>();
                                                            
                                                            formDataMap = new Dictionary<string, string>(data);

                                                            // Load the frozen template for this attempt.
                                                            if (data.TryGetValue("__iafTemplateSnapshot", out var snapJson)
                                                                && !string.IsNullOrWhiteSpace(snapJson))
                                                            {
                                                                var deserialized =
                                                                    System.Text.Json.JsonSerializer.Deserialize<
                                                                        FYPTracker.ViewModels.MeetingRecordTemplateVM>(
                                                                            snapJson,
                                                                            new System.Text.Json.JsonSerializerOptions
                                                                            {
                                                                                PropertyNameCaseInsensitive = true
                                                                            });

                                                                var requiredKeys = new[]
                                                                {
                                                                    "StudentName", "CoventryId", "Program", "ProjectTitle",
                                                                    "ScopeOfProject", "ProblemStatement", "References",
                                                                    "Objectives", "SupervisorName", "SupervisorSignature",
                                                                    "CommentFeedback"
                                                                };

                                                                if (deserialized?.Fields == null ||
                                                                    deserialized.Fields.Count != requiredKeys.Length ||
                                                                    requiredKeys.Any(key =>
                                                                        deserialized.Fields.Count(f => f.Key == key) != 1))
                                                                {
                                                                    throw new InvalidOperationException(
                                                                        "The saved IAF template snapshot is incomplete.");
                                                                }

                                                                currentIafTemplate = deserialized;
                                                            }

                                                            supervisorSignature = currentAttemptForFields.SupervisorSignature ?? "";
                                                            if (!string.IsNullOrWhiteSpace(currentAttemptForFields.SupervisorFeedback))
                                                                supervisorFeedback = currentAttemptForFields.SupervisorFeedback;
                                                        }
                                                    }
                                                    catch (Exception)
                                                    {
                                                        // Preserve existing editable project fields if old history cannot be parsed.
                                                    }
                                                }
                                                
                                                // Fallback to project defaults if not found in FormData
                                                if (!formDataMap.ContainsKey("scope") && !string.IsNullOrEmpty(Model.Scope)) formDataMap["scope"] = Model.Scope;
                                                if (!formDataMap.ContainsKey("problem") && !string.IsNullOrEmpty(Model.ProblemStatement)) formDataMap["problem"] = Model.ProblemStatement;
                                                if (!formDataMap.ContainsKey("obj1") && !string.IsNullOrEmpty(Model.Objective1)) formDataMap["obj1"] = Model.Objective1;
                                                if (!formDataMap.ContainsKey("obj2") && !string.IsNullOrEmpty(Model.Objective2)) formDataMap["obj2"] = Model.Objective2;
                                                if (!formDataMap.ContainsKey("obj3") && !string.IsNullOrEmpty(Model.Objective3)) formDataMap["obj3"] = Model.Objective3;
                                                
                                                // Map old keys to new normalized keys
                                                if (!formDataMap.ContainsKey("references") && formDataMap.ContainsKey("References")) formDataMap["references"] = formDataMap["References"];
                                                if (!formDataMap.ContainsKey("agreedSupervisor") && formDataMap.ContainsKey("Agreed Supervisor Name")) formDataMap["agreedSupervisor"] = formDataMap["Agreed Supervisor Name"];

                                                var iafViewModel = new FYPTracker.ViewModels.IafDocumentViewModel
                                                {
                                                    Template = currentIafTemplate,
                                                    FormData = formDataMap,
                                                    RenderMode = "StudentEdit",
                                                    IsLocked = isIafLocked,
                                                    AttemptNumber = attemptNumber,
                                                    MilestoneId = iafMilestoneId,
                                                    Status = iafMilestone?.Status ?? "Pending",
                                                    StudentName = currentUser?.FullName ?? "",
                                                    CoventryId = currentUser?.CoventryId ?? "",
                                                    Program = currentUser?.Programme ?? "",
                                                    ProjectTitle = Model.Title ?? "",
                                                    SupervisorName = formDataMap.ContainsKey("agreedSupervisor") ? formDataMap["agreedSupervisor"] : "",
                                                    SupervisorSignature = supervisorSignature,
                                                    SupervisorFeedback = supervisorFeedback
                                                };
                                            }

                                            <div id="iafJsonFields" class="w-100">
                                                @await Html.PartialAsync("_IafDocument", iafViewModel)
                                            </div>
                                        </div>

                                    @{
                                        string parsedJson = "";
                                        if (iafMilestone != null && !string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: "))
                                        {
                                            var parts = iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None);
                                            parsedJson = parts[1];
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(parsedJson))
                                    {
                                        try {
                                            var history = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(parsedJson);
                                            var signedAttempts = history.Attempts.Where(a => !string.IsNullOrEmpty(a.SupervisorSignature)).OrderByDescending(a => a.AttemptNumber).ToList();
                                            var latestSignedAttempt = signedAttempts.FirstOrDefault();
                                            
                                            if (latestSignedAttempt != null)
                                            {
                                                var snapshotFile = iafMilestone.SubmissionFiles?.FirstOrDefault(f => f.AttemptNumber == latestSignedAttempt.AttemptNumber && f.FileName.StartsWith("Signed IAF", StringComparison.OrdinalIgnoreCase));
                                                var attStatus = string.IsNullOrEmpty(latestSignedAttempt.Status) ? (iafMilestone.Status ?? "Pending") : latestSignedAttempt.Status;
                                                var statusBadge = attStatus switch {
                                                    "Approved" or "AdminApproved" => "badge-light-success",
                                                    "PendingPanelReview" => "badge-light-warning text-dark",
                                                    "SupervisorSigned" => "badge-light-info text-primary",
                                                    "Rejected" or "PanelRevisionRequired" or "ChangeOfTopicRequired" => "badge-light-danger",
                                                    "Draft" => "badge-light-secondary",
                                                    _ => "badge-light-warning"
                                                };

                                                <div class="mb-4 mt-4" id="signedIafDocumentsSection">
                                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                                        <h6 class="fw-bold text-success mb-0">
                                                            <i class="fas fa-file-signature text-success me-2"></i>Signed IAF Documents
                                                        </h6>
                                                        <span class="badge bg-light-success text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold">
                                                            <i class="fas fa-check-circle me-1"></i>Supervisor Signed Form
                                                        </span>
                                                    </div>
                                                    <div class="d-flex flex-column gap-3">
                                                        <div class="card border border-success border-opacity-25 shadow-sm rounded-3 p-3 bg-white" id="signedIafCard@(latestSignedAttempt.AttemptNumber)">
                                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                                                <div>
                                                                    <div class="d-flex align-items-center gap-2">
                                                                        <i class="fas fa-file-pdf text-danger fs-4"></i>
                                                                        <span class="fw-bold text-dark fs-6">Signed IAF — Attempt @latestSignedAttempt.AttemptNumber</span>
                                                                        @if (latestSignedAttempt.AttemptNumber == history.CurrentAttempt)
                                                                        {
                                                                            <span class="badge bg-primary text-white rounded-pill px-2">Latest</span>
                                                                        }
                                                                    </div>
                                                                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2 small">
                                                                        <span class="badge badge-light-success border">
                                                                            <i class="fas fa-signature me-1 text-success"></i>Supervisor Signed
                                                                        </span>
                                                                        <span class="badge @statusBadge border">
                                                                            Academic Status: @attStatus
                                                                        </span>
                                                                        @if (latestSignedAttempt.SupervisorReviewedAt.HasValue)
                                                                        {
                                                                            <span class="text-muted">
                                                                                <i class="far fa-calendar-check me-1 text-primary"></i>Reviewed: @latestSignedAttempt.SupervisorReviewedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <div class="d-flex gap-2">
                                                                    <a href="@Url.Action("ViewDigitalForm", "Student", new {
                                                                        milestoneId = iafMilestone.Id,
                                                                        attemptNumber = latestSignedAttempt.AttemptNumber
                                                                    })"
                                                                    id="btnViewSignedIaf@(latestSignedAttempt.AttemptNumber)"
                                                                    class="btn btn-sm btn-outline-primary fw-semibold px-3"
                                                                    target="_blank"
                                                                    rel="noopener noreferrer">
                                                                        <i class="fas fa-eye me-1"></i>
                                                                        View IAF
                                                                    </a>
                                                                    @if (snapshotFile != null) {
                                                                        <a class="btn btn-sm btn-success fw-semibold px-3 shadow-sm text-white" 
                                                                           id="btnDownloadSignedIaf@(latestSignedAttempt.AttemptNumber)" 
                                                                           href="@Url.Action("DownloadFile", "Student", new { fileId = snapshotFile.Id })">
                                                                            <i class="fas fa-file-download me-1"></i>Download PDF
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            <div class="mb-4 mt-4" id="iafAttemptHistorySection">
                                                <h6 class="fw-bold text-primary mb-3"><i class="fas fa-history me-2"></i>IAF Attempt History</h6>
                                                @foreach (var attempt in history.Attempts.OrderByDescending(a => a.AttemptNumber)) {
                                                    var snapshotFile = iafMilestone.SubmissionFiles?.FirstOrDefault(f => f.AttemptNumber == attempt.AttemptNumber && f.FileName.StartsWith("Signed IAF", StringComparison.OrdinalIgnoreCase));
                                                    var fd = attempt.FormData ?? new Dictionary<string, string>();
                                                    string Fv(string k) => fd.TryGetValue(k, out var v) ? v : "";
                                                    var isSigned = !string.IsNullOrEmpty(attempt.SupervisorSignature);
                                                    var modalId = $"iafAttemptModal{attempt.AttemptNumber}";
                                                    var attStatus = string.IsNullOrEmpty(attempt.Status) ? "Pending" : attempt.Status;
                                                    var statusBadge = attStatus switch {
                                                        "Approved" or "AdminApproved" or "PendingPanelReview" or "SupervisorSigned" => "badge-light-success",
                                                        "Rejected" or "PanelRevisionRequired" or "ChangeOfTopicRequired" => "badge-light-danger",
                                                        "Draft" => "badge-light-secondary",
                                                        _ => "badge-light-warning"
                                                    };
                                                    var isDisplayedInSignedSection = (latestSignedAttempt != null && attempt.AttemptNumber == latestSignedAttempt.AttemptNumber);

                                                    <div class="iaf-attempt-card" id="iafAttemptCard@(attempt.AttemptNumber)">
                                                        <div>
                                                            <p class="iaf-attempt-title">Attempt @attempt.AttemptNumber @(attempt.AttemptNumber == history.CurrentAttempt ? "(Latest)" : "")</p>
                                                            <div class="iaf-attempt-meta mt-1">
                                                                <span class="badge @statusBadge">@attStatus</span>
                                                                @if (isSigned) {
                                                                    <span class="badge badge-light-success"><i class="fas fa-signature me-1 text-success"></i>Supervisor Signed</span>
                                                                } else {
                                                                    <span class="badge badge-light-secondary"><i class="fas fa-hourglass-half me-1"></i>Not Signed</span>
                                                                }
                                                                <span class="text-muted"><i class="far fa-calendar me-1"></i>Reviewed: @(attempt.SupervisorReviewedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")</span>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            @if (isDisplayedInSignedSection) {
                                                                <span class="badge bg-light text-muted border px-3 py-2 d-inline-flex align-items-center" title="Access the latest signed IAF document above">
                                                                    <i class="fas fa-arrow-up me-1 text-primary"></i>Available above
                                                                </span>
                                                            } else {
                                                                <div class="d-flex gap-2">    
                                                                    <a href="@Url.Action("ViewDigitalForm", "Student", new {
                                                                        milestoneId = iafMilestone.Id,
                                                                        attemptNumber = attempt.AttemptNumber
                                                                    })"
                                                                    id="btnViewIaf@(attempt.AttemptNumber)"
                                                                    class="btn btn-sm btn-light-primary"
                                                                    target="_blank"
                                                                    rel="noopener noreferrer">
                                                                        <i class="fas fa-eye me-1"></i>
                                                                        View IAF
                                                                    </a>
                                                                    @if (snapshotFile != null) {
                                                                        <a class="btn btn-sm btn-light" id="btnDownloadIaf@(attempt.AttemptNumber)" href="@Url.Action("DownloadFile", "Student", new { fileId = snapshotFile.Id })"><i class="fas fa-download me-1"></i>Download PDF</a>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title">Initial Project Allocation Form — Attempt @attempt.AttemptNumber</h5>
                                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                                </div>
                                                                <div class="modal-body iaf-readonly-view">
                                                                    <table class="iaf-table">
                                                                        <tr><td class="iaf-label">Course Code</td><td class="iaf-value">6002CMD</td></tr>
                                                        <tr><td class="iaf-label">Module Leader Name</td><td class="iaf-value">@moduleLeaderName</td></tr>
                                                        <tr><td class="iaf-label">Project Title</td><td class="iaf-value">@Fv("title")</td></tr>
                                                                        <tr><td class="iaf-label">Scope of Project</td><td class="iaf-value">@Fv("scope")</td></tr>
                                                                        <tr><td class="iaf-label">Problem Statement</td><td class="iaf-value">@Fv("problem")</td></tr>
                                                                        <tr><td class="iaf-label">Objective 1</td><td class="iaf-value">@Fv("obj1")</td></tr>
                                                                        <tr><td class="iaf-label">Objective 2</td><td class="iaf-value">@Fv("obj2")</td></tr>
                                                                        <tr><td class="iaf-label">Objective 3</td><td class="iaf-value">@Fv("obj3")</td></tr>
                                                                        <tr><td class="iaf-label">Agreed Supervisor Name</td><td class="iaf-value">@Fv("agreedSupervisor")</td></tr>
                                                                        <tr><td class="iaf-label">Supervisor's name</td><td class="iaf-value" style="background-color: #DBE5F1;">@(isSigned ? (!string.IsNullOrWhiteSpace(Fv("__iafSignedByName")) ? Fv("__iafSignedByName") : (Model.Supervisor?.FullName ?? "None specified")) : (!string.IsNullOrWhiteSpace(Fv("agreedSupervisor")) ? Fv("agreedSupervisor") : "None specified"))</td></tr>
                                                                        <tr>
                                                                            <td class="iaf-label">Supervisor's signature</td>
                                                                            <td class="iaf-value" style="background-color: #DBE5F1;">
                                                                                @if (isSigned) {
                                                                                    if (attempt.SupervisorSignature.StartsWith("data:image/")) {
                                                                                        <img src="@attempt.SupervisorSignature" alt="Supervisor Signature" style="max-height: 80px; max-width: 250px;" />
                                                                                    } else {
                                                                                        <span style="font-family: 'Brush Script MT', cursive; font-size: 24px; color: #00008B;">@attempt.SupervisorSignature</span>
                                                                                    }
                                                                                } else {
                                                                                    <span class="text-muted fst-italic">Not signed</span>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                        <tr><td class="iaf-label">Comment/Feedback</td><td class="iaf-value">@attempt.SupervisorFeedback</td></tr>
                                                                        @if (!string.IsNullOrEmpty(attempt.PanelComments)) {
                                                                            <tr><td class="iaf-label">Panel Comments</td><td class="iaf-value">@attempt.PanelComments</td></tr>
                                                                        }
                                                                    </table>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    @if (snapshotFile != null) {
                                                                        <a class="btn btn-sm btn-light" href="@Url.Action("DownloadFile", "Student", new { fileId = snapshotFile.Id })"><i class="fas fa-download me-1"></i>Download PDF</a>
                                                                    }
                                                                    <button type="button" class="btn btn-sm btn-primary" data-dismiss="modal">Close</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        } catch (Exception ex) {
                                            <div class="alert alert-danger font-monospace">
                                                <strong>Error parsing JSON:</strong> @ex.Message
                                            </div>
                                        }
                                    }

                                    @{
                                        var genuineFeedbackFiles = (iafMilestone != null && iafMilestone.SubmissionFiles != null)
                                            ? iafMilestone.SubmissionFiles.Where(f => f.UploadedBy != Model.StudentId && !f.FileName.StartsWith("Signed IAF", StringComparison.OrdinalIgnoreCase)).ToList()
                                            : new List<FYPTracker.Models.FYPSubmissionFile>();
                                    }
                                    @if (genuineFeedbackFiles.Any())
                                    {
                                        <div class="mb-4">
                                            <h6 class="fw-bold text-primary mb-3"><i class="fas fa-paperclip me-2"></i>Feedback Attachments / Graded Files</h6>
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var file in genuineFeedbackFiles)
                                                {
                                                    <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" target="_blank" class="btn btn-outline-primary text-start d-flex align-items-center rounded-3 p-3 text-decoration-none bg-light-primary border-primary border-opacity-25 shadow-sm transition">
                                                        <i class="fas fa-file-alt text-primary me-3 fs-4"></i>
                                                        <span class="text-dark fw-bold text-truncate flex-grow-1">@file.FileName</span>
                                                        <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (!isIafLocked)
                                    {
                                        <div class="card-footer bg-light border-top p-3 mt-3 iaf-action-footer">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <div class="text-muted small fw-semibold">
                                                    <span id="autosaveIndicator"><i class="fas fa-check-circle text-success me-1"></i>Auto-saved locally</span>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    @if (iafMilestone?.Status == "Draft" || iafMilestone?.Status == "ReturnedForEdits" || string.IsNullOrEmpty(iafMilestone?.Status) || iafMilestone?.Status == "Pending")
                                                    {
                                                        <button type="submit" name="iafAction" value="draft" class="btn btn-light fw-bold px-4 border shadow-sm" formnovalidate><i class="fas fa-save me-2 text-muted"></i>Save Draft</button>
                                                        <button type="submit" name="iafAction" value="supervisor_review" class="btn btn-info px-4 shadow-sm text-white fw-bold"><i class="fas fa-user-tie me-2"></i>Send for Supervisor Review</button>
                                                    }
                                                    else if (iafMilestone?.Status == "PanelRevisionRequired")
                                                    {
                                                        <button type="submit" name="iafAction" value="draft" class="btn btn-light fw-bold px-4 border shadow-sm" formnovalidate><i class="fas fa-save me-2 text-muted"></i>Save Draft</button>
                                                        <button type="submit" name="iafAction" value="supervisor_review" class="btn btn-info px-4 shadow-sm text-white fw-bold"><i class="fas fa-user-tie me-2"></i>Send for Supervisor Review</button>
                                                    }
                                                    else if (iafMilestone?.Status == "ChangeOfTopicRequired")
                                                    {
                                                        <button type="submit" name="iafAction" value="draft" class="btn btn-light fw-bold px-4 border shadow-sm" formnovalidate><i class="fas fa-save me-2 text-muted"></i>Save Draft</button>
                                                        <button type="submit" name="iafAction" value="supervisor_review" class="btn btn-info px-4 shadow-sm text-white fw-bold"><i class="fas fa-user-tie me-2"></i>Send for Supervisor Review</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    </div>
                                </form>
                            
                        </div>
                    </div>

                    
                    @* -- A. PROPOSAL FORM ------------------------------ *@
                    <div class="tab-pane fade @(isPropTabActive ? "show active" : "")" id="proposal-form-pane" role="tabpanel" tabindex="0">
                        <div class="card border-0 shadow-sm rounded-3 p-4">
                            <h4 class="fw-bold text-dark mb-4"><i class="fas fa-file-signature text-orange me-2"></i>B. Stage 1 Detailed Project Proposal (DPP)</h4>
                            
                                @* Select corresponding Milestone *@
                                @{
                                    var propMilestone = FYPTracker.Utils.GradingHelper.GetStage1FinalMilestone(milestones);
                                    int propMilestoneId = propMilestone?.Id ?? 0;
                                    bool isStage1PassedNow = Model?.Stage1Grade == "Pass";
                                    bool isPropLocked = FYPTracker.Utils.GradingHelper.IsStage1ProposalLocked(propMilestone, Model?.Stage1Grade);
                                    bool canProgressToDpp = FYPTracker.Utils.GradingHelper.CanProgressToStage1Dpp(iafMilestone, ViewBag.ScheduledIafBooking as IAFDefenseBooking);
                                }
                                
                                @if (!canProgressToDpp)
                                {
                                    <div class="alert alert-warning d-flex align-items-start mt-3 border-warning shadow-sm mb-4">
                                        <i class="fas fa-lock fs-2 me-3 text-warning mt-1"></i>
                                        <div class="w-100">
                                            <h5 class="fw-bold text-dark mb-1">Stage 1 DPP Submission Locked — IAF Prerequisite Pending</h5>
                                            <p class="mb-0 text-muted">
                                                @if (iafMilestone?.Status == "DefenseScheduled")
                                                {
                                                    <span>Your IAF Defense session is currently scheduled and awaiting assessment. You cannot submit your Detailed Project Proposal (DPP) until your IAF Defense has been conducted and passed.</span>
                                                }
                                                else if (iafMilestone?.Status == "DefenseRequired")
                                                {
                                                    <span>An IAF Defense is required and awaiting scheduling by the administrator. Stage 1 DPP submission will unlock once your IAF Defense is scheduled, conducted, and marked as Passed.</span>
                                                }
                                                else if (iafMilestone?.Status == "ChangeOfTopicRequired")
                                                {
                                                    <span>Your IAF defense was unsuccessful. You must submit a revised IAF with a change of topic before proceeding with Stage 1 submissions.</span>
                                                }
                                                else
                                                {
                                                    <span>Your Initial Project Allocation Form (IAF) has not yet been approved. Stage 1 DPP submission will unlock once your IAF is fully approved.</span>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                }
                                else if (!canSubmitStage1FinalDpp && !isPropLocked)
                                {
                                    @if (!hasProgressMilestones)
                                    {
                                        <div class="alert alert-warning d-flex align-items-start mt-3 border-warning shadow-sm mb-4">
                                            <i class="fas fa-lock fs-2 me-3 text-warning mt-1"></i>
                                            <div class="w-100">
                                                <h5 class="fw-bold text-dark mb-1">DPP Submission Locked — Waiting for your Supervisor to assign Stage 1 DPP progress tasks.</h5>
                                                <p class="mb-0 text-muted">Supervisor-assigned Stage 1 DPP progress milestone tasks are mandatory. You may review the submission guidelines below and save your DPP draft, but formal submission cannot be made until your supervisor assigns and approves all required progress tasks.</p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning d-flex align-items-start mt-3 border-warning shadow-sm mb-4">
                                            <i class="fas fa-lock fs-2 me-3 text-warning mt-1"></i>
                                            <div class="w-100">
                                                <h5 class="fw-bold text-dark mb-1">DPP Submission Locked — Waiting for Supervisor approval of all required Stage 1 progress tasks.</h5>
                                                <p class="mb-0 text-muted">All mandatory Stage 1 DPP progress tasks must be completed and approved by your assigned Supervisor before final DPP submission is allowed. You can save your draft proposal while waiting for approval.</p>
                                            </div>
                                        </div>
                                    }
                                }
                                else if (propMilestone != null && propMilestone.Status == "Rejected" && !isStage1PassedNow)
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger shadow-sm">
                                        <i class="fas fa-exclamation-circle fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Stage 1 Final Submission Rejected (Needs Revision)</h5>
                                            <p class="mb-0 text-muted"><strong>Feedback:</strong> @propMilestone.SupervisorFeedback</p>
                                        </div>
                                    </div>
                                }
                                else if (isPropLocked)
                                {
                                    <div class="alert alert-info d-flex align-items-start mt-3 border-info shadow-sm">
                                        <i class="fas fa-lock fs-2 me-3 text-info mt-1"></i>
                                        <div class="w-100">
                                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                                <h5 class="fw-bold text-dark mb-0">Stage 1 DPP — Submission Completed</h5>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (isStage1PassedNow)
                                                    {
                                                        <span class="badge bg-success text-white shadow-sm px-3 py-1 fw-bold"><i class="fas fa-check-circle me-1"></i>Stage 1 Passed</span>
                                                    }
                                                    <span class="badge bg-white text-dark shadow-sm border px-3 py-1"><i class="fas fa-lock me-1 text-muted"></i>Read-Only</span>
                                                </div>
                                            </div>
                                            <p class="mb-2 text-muted">
                                                <strong>Project Title:</strong> @Model.Title<br />
                                                <strong>Submission Status:</strong> <span class="badge bg-primary text-white ms-1 shadow-sm">@(propMilestone?.Status ?? "Completed")</span>
                                            </p>

                                            @* Submitted Proposal Files (Student upload) *@
                                            @{
                                                var studentSubmittedFiles = propMilestone?.SubmissionFiles?
                                                    .Where(f => !f.IsDeleted && (f.UploadedBy == Model.StudentId || f.UploadedBy == ViewBag.CurrentUser?.Id || (propMilestone.SubmissionFiles.All(sf => sf.UploadedBy == f.UploadedBy))))
                                                    .OrderByDescending(f => f.UploadedDate)
                                                    .ToList();
                                                
                                                if (studentSubmittedFiles == null || !studentSubmittedFiles.Any())
                                                {
                                                    // Fallback to any non-deleted file on the proposal milestone
                                                    studentSubmittedFiles = propMilestone?.SubmissionFiles?
                                                        .Where(f => !f.IsDeleted)
                                                        .OrderByDescending(f => f.UploadedDate)
                                                        .ToList();
                                                }
                                            }

                                            @if (studentSubmittedFiles != null && studentSubmittedFiles.Any())
                                            {
                                                <hr class="my-3 border-info opacity-25">
                                                <h6 class="fw-bold text-dark mb-2"><i class="fas fa-file-pdf text-danger me-2"></i>Submitted Final Proposal (DPP)</h6>
                                                <div class="d-flex flex-column gap-2 mb-3">
                                                    @foreach (var file in studentSubmittedFiles)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between rounded-3 p-2 bg-white border border-info border-opacity-25 shadow-sm">
                                                            <div class="d-flex align-items-center text-truncate me-3">
                                                                <i class="fas fa-file-pdf text-danger fs-5 me-3"></i>
                                                                <div class="d-flex flex-column text-truncate">
                                                                    <span class="text-dark fw-bold text-truncate">@file.FileName</span>
                                                                    <small class="text-muted">Submitted on @(file.UploadedDate.ToString("dd MMM yyyy, hh:mm tt"))</small>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex gap-2 flex-shrink-0">
                                                                <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" target="_blank" class="btn btn-sm btn-outline-primary fw-semibold">
                                                                    <i class="fas fa-eye me-1"></i>View
                                                                </a>
                                                                <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" download="@file.FileName" class="btn btn-sm btn-outline-secondary fw-semibold">
                                                                    <i class="fas fa-download me-1"></i>Download
                                                                </a>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @* Supervisor Feedback / Evaluation Marksheet *@
                                            <hr class="my-3 border-info opacity-25">
                                            <h6 class="fw-bold text-primary mb-2"><i class="fas fa-user-tie me-2"></i>Supervisor Evaluation &amp; Feedback</h6>
                                            @{
                                                string supStrengths = "", supImprovements = "", supComments = "";
                                                if (propMilestone != null && !string.IsNullOrWhiteSpace(propMilestone.SupervisorMarksheetData) && !FYPTracker.Utils.GradingHelper.IsMarksheetDraft(propMilestone.SupervisorMarksheetData))
                                                {
                                                    try
                                                    {
                                                        using var sDoc = System.Text.Json.JsonDocument.Parse(propMilestone.SupervisorMarksheetData);
                                                        if (sDoc.RootElement.TryGetProperty("Strengths", out var sp) && !string.IsNullOrWhiteSpace(sp.GetString())) supStrengths = sp.GetString()!.Trim();
                                                        if (sDoc.RootElement.TryGetProperty("Improvements", out var ip) && !string.IsNullOrWhiteSpace(ip.GetString())) supImprovements = ip.GetString()!.Trim();
                                                        if (sDoc.RootElement.TryGetProperty("Comments", out var cp) && !string.IsNullOrWhiteSpace(cp.GetString())) supComments = cp.GetString()!.Trim();
                                                    }
                                                    catch { }
                                                }
                                                bool hasSupRubricText = !string.IsNullOrEmpty(supStrengths) || !string.IsNullOrEmpty(supImprovements) || !string.IsNullOrEmpty(supComments);
                                                string directSupFeedback = propMilestone?.SupervisorFeedback?.Trim() ?? "";
                                            }

                                            @if (hasSupRubricText)
                                            {
                                                <div class="d-flex flex-column gap-2 mb-3">
                                                    @if (!string.IsNullOrEmpty(supStrengths))
                                                    {
                                                        <div class="p-2 bg-light rounded text-dark fs-7">
                                                            <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Strengths of Proposal:</small>
                                                            <span>@supStrengths</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(supImprovements))
                                                    {
                                                        <div class="p-2 bg-light rounded text-dark fs-7">
                                                            <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Areas for Improvement:</small>
                                                            <span>@supImprovements</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(supComments))
                                                    {
                                                        <div class="p-2 bg-light rounded text-dark fs-7">
                                                            <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Supervisor Comments:</small>
                                                            <span>@supComments</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(directSupFeedback))
                                            {
                                                <div class="p-2 bg-light rounded text-dark fs-7 mb-3">
                                                    <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Supervisor Remarks:</small>
                                                    <span>@directSupFeedback</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="mb-3 text-muted fst-italic fs-7">Feedback not available</p>
                                            }

                                            @* Supervisor Feedback / Graded Files *@
                                            @if (propMilestone?.SubmissionFiles != null && propMilestone.SubmissionFiles.Any(f => f.UploadedBy != Model.StudentId && !f.IsDeleted))
                                            {
                                                var gFiles = propMilestone.SubmissionFiles.Where(f => f.UploadedBy != Model.StudentId && !f.IsDeleted).ToList();
                                                if (gFiles.Any())
                                                {
                                                    <hr class="my-3 border-info opacity-25">
                                                    <h6 class="fw-bold text-primary mb-2"><i class="fas fa-file-pdf me-2"></i>Supervisor Graded / Feedback Files</h6>
                                                    <div class="d-flex flex-column gap-2 mb-3">
                                                        @foreach (var file in gFiles)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between rounded-3 p-2 bg-white border border-primary border-opacity-25 shadow-sm">
                                                                <div class="d-flex align-items-center text-truncate me-3">
                                                                    <i class="fas fa-file-pdf text-primary me-3"></i>
                                                                    <span class="text-dark fw-bold text-truncate">@file.FileName</span>
                                                                </div>
                                                                <div class="d-flex gap-2 flex-shrink-0">
                                                                    <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" target="_blank" class="btn btn-sm btn-outline-primary fw-semibold">
                                                                        <i class="fas fa-eye me-1"></i>View
                                                                    </a>
                                                                    <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" download="@file.FileName" class="btn btn-sm btn-outline-secondary fw-semibold">
                                                                        <i class="fas fa-download me-1"></i>Download
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }

                                            @* Examiner Feedback / Marksheet *@
                                            <hr class="my-3 border-info opacity-25">
                                            <h6 class="fw-bold text-success mb-2"><i class="fas fa-user-graduate me-2"></i>Examiner Evaluation &amp; Feedback</h6>
                                            @{
                                                string exStrengths = "", exImprovements = "", exComments = "";
                                                if (propMilestone != null && !string.IsNullOrWhiteSpace(propMilestone.ExaminerMarksheetData) && !FYPTracker.Utils.GradingHelper.IsMarksheetDraft(propMilestone.ExaminerMarksheetData))
                                                {
                                                    try
                                                    {
                                                        using var eDoc = System.Text.Json.JsonDocument.Parse(propMilestone.ExaminerMarksheetData);
                                                        if (eDoc.RootElement.TryGetProperty("Strengths", out var esp) && !string.IsNullOrWhiteSpace(esp.GetString())) exStrengths = esp.GetString()!.Trim();
                                                        if (eDoc.RootElement.TryGetProperty("Improvements", out var eip) && !string.IsNullOrWhiteSpace(eip.GetString())) exImprovements = eip.GetString()!.Trim();
                                                        if (eDoc.RootElement.TryGetProperty("Comments", out var ecp) && !string.IsNullOrWhiteSpace(ecp.GetString())) exComments = ecp.GetString()!.Trim();
                                                    }
                                                    catch { }
                                                }
                                                bool hasExRubricText = !string.IsNullOrEmpty(exStrengths) || !string.IsNullOrEmpty(exImprovements) || !string.IsNullOrEmpty(exComments);
                                                bool hasExMarksheetFile = !string.IsNullOrWhiteSpace(Model.Stage1ExaminerMarksheetPath);
                                                bool isExGraded = exStage1Score.HasValue || hasExRubricText || hasExMarksheetFile || !string.IsNullOrEmpty(Model.Stage1Grade);
                                            }

                                            @if (hasExRubricText)
                                            {
                                                <div class="d-flex flex-column gap-2 mb-3">
                                                    @if (!string.IsNullOrEmpty(exStrengths))
                                                    {
                                                        <div class="p-2 bg-light rounded text-dark fs-7">
                                                            <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Strengths of Proposal:</small>
                                                            <span>@exStrengths</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(exImprovements))
                                                    {
                                                        <div class="p-2 bg-light rounded text-dark fs-7">
                                                            <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Areas for Improvement:</small>
                                                            <span>@exImprovements</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(exComments))
                                                    {
                                                        <div class="p-2 bg-light rounded text-dark fs-7">
                                                            <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.72rem;">Examiner Comments:</small>
                                                            <span>@exComments</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else if (!isExGraded)
                                            {
                                                <div class="p-2 bg-light rounded text-muted small d-flex align-items-center mb-3">
                                                    <i class="fas fa-clock text-warning me-2"></i>
                                                    <span>Examiner evaluation is currently <strong>Pending / Not Released</strong>.</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="mb-3 text-muted fst-italic fs-7">Feedback not available</p>
                                            }

                                            @if (hasExMarksheetFile)
                                            {
                                                <div class="d-flex flex-column gap-2 mb-2">
                                                    <a href="@Url.Action("DownloadStage1ExaminerMarksheet", "Student", new { projectId = Model.Id })" target="_blank" class="btn btn-outline-success text-start d-flex align-items-center rounded-3 p-2 text-decoration-none bg-white border-success border-opacity-25 shadow-sm">
                                                        <i class="fas fa-file-excel text-success me-3"></i>
                                                        <div class="d-flex flex-column flex-grow-1 text-truncate">
                                                            <span class="text-dark fw-bold text-truncate">Stage 1 Examiner Marksheet</span>
                                                            <small class="text-muted">Completed evaluation marksheet file</small>
                                                        </div>
                                                        <i class="fas fa-download text-success ms-3"></i>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (canProgressToDpp && !isPropLocked)
                                {
                                <form id="proposalForm" asp-action="SubmitDigitalForm" method="post" enctype="multipart/form-data" asp-antiforgery="true">
                                    <input type="hidden" name="formType" value="Proposal Form" />
                                    <input type="hidden" name="milestoneId" value="@propMilestoneId" />

                                    <div class="form-section-title">Part 1: Proposal Details</div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Project Title</label>
                                    <input type="text" name="title" class="form-control bg-light" value="@Model.Title" readonly required />
                                </div>

                                <div class="mb-4 p-4 rounded-3 border" style="background: #f8fafc; border-color: #e2e8f0 !important;">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3 pb-3 border-bottom">
                                        <div>
                                            <div class="fw-bold text-dark fs-6 mb-1">
                                                <i class="fas fa-file-word text-primary me-2"></i>Official Thesis Cover Page
                                            </div>
                                            <div class="text-muted small">
                                                Download the official editable Microsoft Word (.docx) cover page pre-populated with your student and project details.
                                            </div>
                                        </div>
                                        <a href="@Url.Action("DownloadThesisCoverPage", "Student")"
                                           class="btn btn-outline-primary fw-bold rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm text-decoration-none">
                                            <i class="fas fa-download"></i> Download Official Thesis Cover Page (.docx)
                                        </a>
                                    </div>

                                    <div class="fw-bold text-dark mb-2">
                                        <i class="fas fa-list-ol text-primary me-2"></i>Stage 1 Final DPP Submission Workflow
                                    </div>
                                    <div class="text-muted small mb-3">
                                        Please follow these 5 steps to prepare and complete your Stage 1 Detailed Project Proposal submission:
                                    </div>

                                    <ol class="small text-dark mb-3 ps-3" style="line-height: 1.8;">
                                        <li><strong>Download the official DOCX Cover Page</strong> using the button above.</li>
                                        <li><strong>Combine</strong> the Cover Page, Chapter 1 (Introduction), Chapter 2 (Literature Review), Chapter 3 (Methodology), References, and Appendices where applicable.</li>
                                        <li><strong>Export</strong> the complete combined document as <strong>ONE PDF</strong>.</li>
                                        <li><strong>Upload the final PDF</strong> in Part 2 below. (Only valid PDF documents are accepted).</li>
                                        <li><strong>Submit Stage 1 Final DPP</strong> for supervisor and examiner evaluation.</li>
                                    </ol>

                                    <div class="alert alert-secondary py-2 px-3 rounded-2 small text-muted mb-0 d-flex align-items-center gap-2">
                                        <i class="fas fa-info-circle text-primary"></i>
                                        <span><strong>Note:</strong> Downloading the cover page does not complete your milestone. You can save your draft at any time. Formal submission unlocks once your supervisor approves all assigned Stage 1 progress tasks.</span>
                                    </div>
                                </div>

                                <div class="form-section-title">Part 2: Document Attachment</div>
                                <div class="mb-4">
                                    <label for="proposalDocument" class="form-label fw-semibold">Upload Final Proposal <span class="text-danger">*</span></label>
                                    <input class="form-control" type="file" id="proposalDocument" name="attachedFile" accept=".pdf" required />
                                    <div class="form-text text-muted">Accepted formats: <strong>PDF only</strong>. Word documents (.docx) and other non-PDF file formats are strictly rejected by the server.</div>
                                </div>

                                @if (proposalMilestone?.Status == "Rejected")
                                {
                                    <div class="form-section-title text-danger"><i class="fas fa-history me-2"></i>Part 3: Revision Notes</div>
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">What did you change in this version?</label>
                                        <textarea name="revisionNotes" class="form-control" rows="3" placeholder="I fixed the diagrams on page 4 and updated the literature review..." required></textarea>
                                        <div class="text-danger fw-bold small mt-1">* Revision Notes are required for resubmissions.</div>
                                    </div>
                                }

                                <div class="d-flex gap-3 justify-content-end align-items-center">
                                    <button type="submit" name="isDraft" value="true" class="btn-draft" formnovalidate onclick="saveDraftAlert()">Save Draft</button>
                                    @if (canSubmitStage1FinalDpp)
                                    {
                                        <button type="submit" name="isDraft" value="false" class="btn-submit" onclick="return validateProposalForm()">Submit Stage 1 Final Submission</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-submit" disabled title="@stage1DppPrereq.Reason" style="opacity: 0.6; cursor: not-allowed;">
                                            <i class="fas fa-lock me-1"></i> Submit Stage 1 Final Submission (Locked)
                                        </button>
                                    }
                                </div>
                            </form>
                            }
                        </div>
                    </div>

                    @* -- A. DPP WORK & PROGRESS ----------------------- *@


                    <div class="tab-pane fade @(isProgressTabActive ? "show active" : "")"
                        id="progress-form-pane"
                        role="tabpanel"
                        tabindex="0">
                        <div class="card border-0 shadow-sm rounded-3 p-4">
                            <h4 class="fw-bold text-dark mb-4"><i class="fas fa-chart-line text-orange me-2"></i>A. DPP Work & Progress</h4>
                            
                            @{
                                var activeProgressMilestones = allProgressMilestones.Where(x =>
                                    x.Status == "Draft" || x.Status == "ReturnedForChanges").ToList();
                            }
                            
                            @if (!hasProgressMilestones)
                            {
                                <div class="alert alert-warning d-flex align-items-start mt-3 border-warning shadow-sm">
                                    <i class="fas fa-lock fs-2 me-3 text-warning mt-1"></i>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">DPP Submission Locked — Waiting for your Supervisor to assign Stage 1 DPP progress tasks.</h5>
                                        <p class="mb-0 text-muted">Supervisor-assigned Stage 1 DPP progress milestone tasks are mandatory. Your supervisor must create your Stage 1 progress tasks before you can proceed with final DPP submission.</p>
                                    </div>
                                </div>
                            }
                            else if (!activeProgressMilestones.Any() && !isAllProgressCompleted)
                            {
                                <div class="alert alert-info d-flex align-items-start mt-3 border-info shadow-sm">
                                    <i class="fas fa-clock fs-2 me-3 text-info mt-1"></i>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">DPP Submission Locked — Waiting for Supervisor approval of all required Stage 1 progress tasks.</h5>
                                        <p class="mb-0 text-muted">All assigned Stage 1 progress tasks have been submitted and are awaiting supervisor review. Final DPP submission will unlock once your supervisor approves all tasks.</p>
                                    </div>
                                </div>
                            }
                            else if (isAllProgressCompleted)
                            {
                                <div class="alert alert-success d-flex align-items-start mt-3 border-success shadow-sm">
                                    <i class="fas fa-check-circle fs-2 me-3 text-success mt-1"></i>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">All Required Stage 1 Progress Tasks Approved</h5>
                                        <p class="mb-0 text-muted">All assigned Stage 1 progress tasks have been completed and approved by your supervisor. Your Stage 1 Final DPP submission is now unlocked!</p>
                                    </div>
                                </div>
                            }

                            @if (activeProgressMilestones.Any())
                            {
                                <form asp-action="SubmitDigitalForm" method="post" enctype="multipart/form-data" class="needs-validation" novalidate id="progressForm" data-student-id="@(currentUser?.Id ?? Model?.StudentId ?? 0)" data-project-id="@(Model?.Id ?? 0)">
                                    <input type="hidden" name="formType" value="DPP Work & Progress" />

                                    <div class="mb-4 progress-milestone-field-group">
                                        <label class="form-label fw-bold text-dark fs-6 mb-2">Select Progress Milestone</label>
                                        <select name="milestoneId" id="progressMilestoneSelect" class="form-select" required onchange="toggleProgressTemplate(this)">
                                            <option value="">-- Choose a Milestone --</option>
                                            @foreach (var m in activeProgressMilestones.OrderBy(x => x.Id))
                                            {
                                                string mStartDate = "";
                                                string mEndDate = "";
                                                if (!string.IsNullOrEmpty(m.Remarks) && m.Remarks.Contains("JSON: "))
                                                {
                                                    try
                                                    {
                                                        var jsonPart = m.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None)[1];
                                                        var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(jsonPart);
                                                        if (dict != null)
                                                        {
                                                            if (dict.TryGetValue("Start Period", out var s) && !string.IsNullOrWhiteSpace(s))
                                                            {
                                                                if (DateTime.TryParse(s, out var dtStart))
                                                                    mStartDate = dtStart.ToString("yyyy-MM-dd");
                                                                else if (System.Text.RegularExpressions.Regex.IsMatch(s, @"^\d{4}-\d{2}-\d{2}$"))
                                                                    mStartDate = s;
                                                            }
                                                            if (dict.TryGetValue("End Period", out var e) && !string.IsNullOrWhiteSpace(e))
                                                            {
                                                                if (DateTime.TryParse(e, out var dtEnd))
                                                                    mEndDate = dtEnd.ToString("yyyy-MM-dd");
                                                                else if (System.Text.RegularExpressions.Regex.IsMatch(e, @"^\d{4}-\d{2}-\d{2}$"))
                                                                    mEndDate = e;
                                                            }
                                                        }
                                                    }
                                                    catch {}
                                                }
                                                string mDueDate = m.DueDate?.ToString("yyyy-MM-dd") ?? "";
                                                string mDueDateDisplay = m.DueDate.HasValue ? m.DueDate.Value.ToString("dd MMM yyyy") : "";
                                                
                                                string statusBadgeText = m.Status switch
                                                {
                                                    "ReturnedForChanges" => " [Needs Revision]",
                                                    _ => ""
                                                };
                                                
                                                <option value="@m.Id" 
                                                        data-status="@m.Status" 
                                                        data-feedback="@(m.SupervisorFeedback ?? "")" 
                                                        data-start-date="@mStartDate" 
                                                        data-end-date="@mEndDate" 
                                                        data-due-date="@mDueDate" 
                                                        data-due-date-display="@mDueDateDisplay">
                                                    @m.Title@statusBadgeText@(m.DueDate.HasValue ? $" (Due: {mDueDateDisplay})" : "")
                                                </option>
                                            }
                                        </select>
                                        <div class="invalid-feedback">Please select a milestone.</div>
                                    </div>

                                        <div id="progressStatusInfo" class="d-none mb-4">
                                            <div class="card border border-primary border-opacity-25 shadow-sm rounded-4 overflow-hidden" style="background: #f4f8ff;">
                                                <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                            <h5 class="fw-bolder text-dark mb-0" id="progressStatusTitle">Milestone Title</h5>
                                                            <span class="badge bg-primary text-white px-2 py-1 rounded-pill small" id="progressStatusBadge">Draft</span>
                                                            <span class="badge bg-light text-dark border border-secondary border-opacity-25 px-2 py-1 rounded-pill small d-none" id="progressDueDateBadge"><i class="fas fa-calendar-alt text-primary me-1"></i>Due: <span id="progressDueDateText"></span></span>
                                                        </div>
                                                        <p class="text-muted small mb-0 fw-semibold">DPP Work & Progress</p>
                                                        <p class="text-muted small mb-0 mt-2">Complete and submit this work for review.</p>
                                                    </div>
                                                    <a href="#"
                                                       id="btnDownloadProgress"
                                                       class="btn btn-sm btn-outline-primary fw-bold rounded-3 px-3 d-flex align-items-center gap-2">
                                                        <i class="fas fa-download"></i> Download Format of Part 1 Report
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                        <div id="progressFeedbackInfo" class="d-none mb-4">
                                            <div class="card border border-danger border-opacity-25 shadow-sm rounded-4" style="background: #fff5f5;">
                                                <div class="card-body p-4">
                                                    <div class="d-flex align-items-center mb-2">
                                                        <i class="fas fa-exclamation-circle fs-3 text-danger me-2"></i>
                                                        <h6 class="fw-bolder text-danger mb-0">Returned for Changes</h6>
                                                    </div>
                                                    <p class="text-dark small mb-0 fw-semibold">Supervisor Feedback:</p>
                                                    <p class="text-muted small mb-0 mt-1" id="progressFeedbackText"></p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Section 1 -->
                                        <div class="saas-card mb-3">
                                            <div class="saas-card-body p-3">
                                                <div class="d-flex align-items-center mb-2">
                                                    <span class="text-primary fw-bolder fs-5 me-2">01</span>
                                                    <h6 class="fw-bold text-dark mb-0">Reporting Period</h6>
                                                </div>
                                                
                                                <div class="row ms-4 mt-2 g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label text-dark small fw-semibold">Start Period</label>
                                                        <input type="date" name="startDate" id="progressStartDate" class="form-control saas-input" required oninput="validateProgressSubmitBtn(); if(typeof saveCurrentProgressDraft === 'function') saveCurrentProgressDraft();" onchange="validateProgressSubmitBtn(); if(typeof saveCurrentProgressDraft === 'function') saveCurrentProgressDraft();" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label text-dark small fw-semibold">End Period</label>
                                                        <input type="date" name="endDate" id="progressEndDate" class="form-control saas-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" required oninput="validateProgressSubmitBtn(); if(typeof saveCurrentProgressDraft === 'function') saveCurrentProgressDraft();" onchange="validateProgressSubmitBtn(); if(typeof saveCurrentProgressDraft === 'function') saveCurrentProgressDraft();" />
                                                    </div>
                                                    <div class="col-12 mt-1">
                                                        <div id="progressDateError" class="text-danger fw-bold small d-none"><i class="fas fa-exclamation-triangle me-1"></i>End Period must be equal to or after the Start Period.</div>
                                                        <div id="progressDueDateError" class="text-danger fw-bold small d-none mt-1"><i class="fas fa-exclamation-circle me-1"></i>End Period cannot exceed the Milestone Due Date (<span id="progressDueDateErrorText"></span>).</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Section 2 -->
                                        <div class="saas-card mb-3">
                                            <div class="saas-card-body p-3">
                                                <div class="d-flex align-items-center mb-2">
                                                    <span class="text-primary fw-bolder fs-5 me-2">02</span>
                                                    <h6 class="fw-bold text-dark mb-0">Progress Document (PDF)</h6>
                                                </div>
                                                
                                                <div class="ms-4 mt-2">
                                                    <div class="mb-3">
                                                        <label for="progressFiles" class="form-label fw-semibold">Upload Supporting Documents</label>
                                                        <input class="form-control" type="file" id="progressFiles" name="attachedFiles" accept=".pdf" multiple onchange="validateProgressSubmitBtn();" oninput="validateProgressSubmitBtn();" />
                                                        <div class="form-text">Accepted formats: PDF only. You can select multiple files.</div>
                                                        <div id="progressFileError" class="text-danger fw-bold small d-none mt-1"><i class="fas fa-exclamation-triangle me-1"></i>Please upload a valid PDF document.</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Section 3 -->
                                        <div id="progressRevisionSection" class="d-none mb-3">
                                            <div class="saas-card" style="border-left: 3px solid #F59E0B; background: #FEF3C7;">
                                                <div class="saas-card-body p-3">
                                                    <div class="d-flex align-items-center mb-2">
                                                        <span class="text-warning fw-bolder fs-5 me-2" style="color: #F59E0B !important;">03</span>
                                                        <h6 class="fw-bold text-dark mb-0">Revision Details</h6>
                                                    </div>
                                                    <div class="ms-4 mt-2">
                                                        <textarea name="revisionNotes" id="progressRevisionNotes" class="form-control saas-input" rows="2" placeholder="Briefly explain your changes based on feedback..." oninput="validateProgressSubmitBtn(); if(typeof saveCurrentProgressDraft === 'function') saveCurrentProgressDraft();" onchange="validateProgressSubmitBtn(); if(typeof saveCurrentProgressDraft === 'function') saveCurrentProgressDraft();"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Action Area -->
                                        <div class="d-flex flex-wrap align-items-center justify-content-between mt-4 p-3 saas-card bg-white position-sticky bottom-0 shadow-sm" style="z-index:100; border-radius: 8px;">
                                            <div class="text-muted small fw-medium"><i class="fas fa-save me-1"></i>Your work can be saved as a draft locally.</div>
                                            <div class="d-flex gap-2 mt-2 mt-md-0">
                                                <button type="submit" name="isDraft" value="true" class="btn-saas-secondary" formnovalidate onclick="if(typeof saveCurrentProgressDraft === 'function') saveCurrentProgressDraft();">Save Draft</button>
                                                <button type="submit" class="btn-saas-primary" id="btnProgressSubmit" onclick="return validateProgressForm(event)" disabled>Send for Supervisor Review</button>
                                            </div>
                                        </div>
                                    </form>
                                }
                        </div>
                    </div>



                </div>
            </div>
            
        </div>
    }

</div>

<script>
    function saveDraftAlert() {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'info',
                title: 'Draft Saved',
                text: 'Draft saved successfully in the session! You can continue editing later.',
                confirmButtonColor: '#3b82f6',
                background: '#ffffff',
                customClass: { popup: 'rounded-4 shadow-sm border-0' }
            });
        } else {
            alert("Draft saved successfully in the session! You can continue editing later.");
        }
    }
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Drag and Drop Logic
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('proposalDocument');
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, preventDefaults, false);
        });
        
        function preventDefaults (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        
        ['dragenter', 'dragover'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, () => dropZone.style.borderColor = 'var(--primary-orange)', false);
        });
        
        ['dragleave', 'drop'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, () => dropZone.style.borderColor = '#cbd5e1', false);
        });
        
        if(dropZone) {
            dropZone.addEventListener('drop', (e) => {
                let dt = e.dataTransfer;
                let files = dt.files;
                fileInput.files = files;
                updateFileName(fileInput);
            }, false);
        }

        function updateFileName(input) {
            const display = document.getElementById('fileNameDisplay');
            const fName = document.getElementById('fName');
            if (input.files && input.files.length > 0) {
                fName.textContent = input.files[0].name;
                display.style.display = 'block';
            } else {
                display.style.display = 'none';
            }
        }
        
        function updateFileNameForFinal(input) {
            const display = document.getElementById('finalFileNameDisplay');
            const fName = document.getElementById('fFinalName');
            const errorLabel = document.getElementById('finalFileError');
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
                    errorLabel.textContent = "Only PDF files are allowed.";
                    errorLabel.style.display = 'block';
                    input.value = "";
                    display.style.display = 'none';
                    return;
                }
                if (file.size > 20 * 1024 * 1024) {
                    errorLabel.textContent = "File size exceeds 20MB limit.";
                    errorLabel.style.display = 'block';
                    input.value = "";
                    display.style.display = 'none';
                    return;
                }
                
                errorLabel.style.display = 'none';
                fName.textContent = file.name;
                display.style.display = 'block';
            } else {
                display.style.display = 'none';
            }
        }
        
        function updateFileNameForTurnitin(input) {
            const display = document.getElementById('turnitinFileNameDisplay');
            const fName = document.getElementById('fTurnitinName');
            const errorLabel = document.getElementById('turnitinFileError');
            if (input.files && input.files.length > 0) {
                fName.textContent = input.files[0].name;
                display.style.display = 'block';
                if (errorLabel) errorLabel.classList.add('d-none');
            } else {
                display.style.display = 'none';
            }
        }

        function updateFileNameForEthics(input) {
            const display = document.getElementById('ethicsFileNameDisplay');
            const fName = document.getElementById('fEthicsName');
            const errorLabel = document.getElementById('ethicsFileError');
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
                    errorLabel.textContent = "Only PDF files are allowed.";
                    errorLabel.style.display = 'block';
                    input.value = "";
                    display.style.display = 'none';
                    return;
                }
                
                errorLabel.style.display = 'none';
                fName.textContent = file.name;
                display.style.display = 'block';
            } else {
                display.style.display = 'none';
            }
        }
        
        function updateMultiFileNames(input, listId) {
            const display = document.getElementById(listId);
            const dropZone = document.getElementById('progressDropZone');
            display.innerHTML = '';
            if (input.files && input.files.length > 0) {
                dropZone.style.display = 'none';
                display.style.display = 'block';
                Array.from(input.files).forEach(file => {
                    const fileDiv = document.createElement('div');
                    fileDiv.className = 'd-flex justify-content-between align-items-center p-3 rounded-3 bg-white border shadow-sm';
                    const fileSize = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
                    fileDiv.innerHTML = '<div class="d-flex align-items-center"><i class="fas fa-file-pdf fs-1 text-danger me-3"></i><div><h6 class="mb-0 text-dark fw-bold">' + file.name + '</h6><small class="text-muted">' + fileSize + '</small></div></div>' +
                        '<button type="button" class="btn btn-sm btn-light-danger fw-bold rounded-pill px-3" onclick="clearFileInput(\'' + input.id + '\', \'' + listId + '\', event)">Remove</button>';
                    display.appendChild(fileDiv);
                });
            } else {
                display.style.display = 'none';
                dropZone.style.display = 'block';
            }
            if (typeof validateProgressSubmitBtn === 'function') validateProgressSubmitBtn();
        }

        function clearFileInput(inputId, listId, event) {
            event.stopPropagation();
            const input = document.getElementById(inputId);
            if (input) {
                input.value = '';
                updateMultiFileNames(input, listId);
            }
        }
        
        // Setup Progress Drop Zone
        const progDropZone = document.getElementById('progressDropZone');
        const progFileInput = document.getElementById('progressFiles');
        if (progDropZone && progFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                progDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                progDropZone.addEventListener(eventName, () => progDropZone.style.borderColor = '#3b82f6', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                progDropZone.addEventListener(eventName, () => progDropZone.style.borderColor = '#cbd5e1', false);
            });
            progDropZone.addEventListener('drop', (e) => {
                progFileInput.files = e.dataTransfer.files;
                updateMultiFileNames(progFileInput, 'progressFileList');
            }, false);
        }

        // Setup Final Drop Zone
        const finalDropZone = document.getElementById('finalDropZone');
        const finalFileInput = document.getElementById('finalDocument');
        if (finalDropZone && finalFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, () => finalDropZone.style.borderColor = '#ef4444', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, () => finalDropZone.style.borderColor = '#cbd5e1', false);
            });
            finalDropZone.addEventListener('drop', (e) => {
                finalFileInput.files = e.dataTransfer.files;
                updateFileNameForFinal(finalFileInput);
            }, false);
        }
        
        // Setup Turnitin Drop Zone
        const turnitinDropZone = document.getElementById('turnitinDropZone');
        const turnitinFileInput = document.getElementById('turnitinDocument');
        if (turnitinDropZone && turnitinFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                turnitinDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                turnitinDropZone.addEventListener(eventName, () => turnitinDropZone.style.borderColor = '#10b981', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                turnitinDropZone.addEventListener(eventName, () => turnitinDropZone.style.borderColor = '#cbd5e1', false);
            });
            turnitinDropZone.addEventListener('drop', (e) => {
                turnitinFileInput.files = e.dataTransfer.files;
                updateFileNameForTurnitin(turnitinFileInput);
            }, false);
        }

        // Setup Ethics Drop Zone
        const ethicsDropZone = document.getElementById('ethicsDropZone');
        const ethicsFileInput = document.getElementById('ethicsDocument');
        if (ethicsDropZone && ethicsFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                ethicsDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                ethicsDropZone.addEventListener(eventName, () => ethicsDropZone.style.borderColor = '#3b82f6', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                ethicsDropZone.addEventListener(eventName, () => ethicsDropZone.style.borderColor = '#cbd5e1', false);
            });
            ethicsDropZone.addEventListener('drop', (e) => {
                ethicsFileInput.files = e.dataTransfer.files;
                updateFileNameForEthics(ethicsFileInput);
            }, false);
        }
        
        (function() {
            var successMsg = '@Html.Raw(TempData["Success"])';
            var errorMsg = '@Html.Raw(TempData["Error"])';
            
            if (successMsg && successMsg.trim() !== '') {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: successMsg,
                    confirmButtonColor: '#f97316',
                    background: '#ffffff',
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            }
            
            if (errorMsg && errorMsg.trim() !== '') {
                Swal.fire({
                    icon: 'error',
                    title: 'Submission Failed',
                    text: errorMsg,
                    confirmButtonColor: '#ef4444',
                    background: '#ffffff',
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            }

            // Bootstrap Form Validation
            var forms = document.querySelectorAll('.needs-validation');

            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {

                    // Allow IAF Save Draft without required-field validation
                    const isIafDraft =
                        form.id === 'iafFormElement' &&
                        event.submitter?.name === 'iafAction' &&
                        event.submitter?.value === 'draft';

                    if (isIafDraft) {
                        return;
                    }

                    // Validate normal submissions
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    form.classList.add('was-validated');

                }, false);
            });

            // --- AUTO SAVE FEATURE ---
            const formsToSave = document.querySelectorAll('form.needs-validation');
            formsToSave.forEach(form => {
                // If form is locked, do not restore drafts and do not record new drafts
                if (form.dataset.isLocked === 'true') {
                    form.querySelectorAll('input:not([type="hidden"]), textarea').forEach(el => {
                        el.readOnly = true;
                    });
                    form.querySelectorAll('select').forEach(el => {
                        el.disabled = true;
                    });
                    return;
                }

                const formTypeInput = form.querySelector('input[name="formType"]');
                if(!formTypeInput) return;

                if (form.id === 'progressForm') {
                    // Handled by dedicated milestone-scoped progress draft logic
                    return;
                }
                
                const storageKey = 'fyp_draft_' + formTypeInput.value.replace(/\s+/g, '_');
                
                // 1. Restore from Draft
                const savedDraft = localStorage.getItem(storageKey);
                if (savedDraft) {
                    try {
                        const data = JSON.parse(savedDraft);
                        for (const key in data) {
                            const field = form.querySelector(`[name="${key}"]`);
                            if (field && !field.readOnly && !field.disabled && field.type !== 'file' && field.type !== 'hidden') {
                                field.value = data[key];
                            }
                        }
                    } catch(e) {}
                }
                
                // 2. Save to Draft on Input (debounced)
                let timeout;
                form.addEventListener('input', function(e) {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        const data = {};
                        const formData = new FormData(form);
                        for (let [key, value] of formData.entries()) {
                            const field = form.querySelector(`[name="${key}"]`);
                            if (field && !field.readOnly && !field.disabled && field.type !== 'file' && field.type !== 'hidden') {
                                data[key] = value;
                            }
                        }
                        localStorage.setItem(storageKey, JSON.stringify(data));
                    }, 1000);
                });
                
                // 3. Clear Draft only for a valid, non-draft submission
                form.addEventListener('submit', function(e) {

                    const isDraftSubmit =
                        (form.id === 'iafFormElement' && e.submitter?.name === 'iafAction' && e.submitter?.value === 'draft') ||
                        (e.submitter?.name === 'isDraft' && e.submitter?.value === 'true');

                    if (isDraftSubmit || e.defaultPrevented) {
                        return;
                    }

                    if (form.checkValidity()) {
                        localStorage.removeItem(storageKey);
                    }

                });
            });
            // Initialize Tooltips using jQuery (Bootstrap 4 compatibility)
            try {
                $('[data-toggle="tooltip"]').tooltip();
                $('[data-bs-toggle="tooltip"]').tooltip();
            } catch(e) {}
            
        })();

        // Real-time validation for IAF
        const scopeSelect = document.getElementById('scope');
        if (scopeSelect) {
            scopeSelect.addEventListener('change', function() {
                if (this.value === "") {
                    this.classList.add('is-invalid');
                    this.setCustomValidity('Please select a project scope');
                } else {
                    this.classList.remove('is-invalid');
                    this.setCustomValidity('');
                }
            });
        }

        const probStmt = document.getElementById('problemStatement');
        const probStmtErr = document.getElementById('problemStatementError');
        
        function insertCitation(type) {
            if (!probStmt || probStmt.readOnly) return;
            const start = probStmt.selectionStart;
            const end = probStmt.selectionEnd;
            const text = probStmt.value;
            let insertion = type === '()' ? " (Author, Year)" : " [1]";
            
            probStmt.value = text.substring(0, start) + insertion + text.substring(end);
            probStmt.selectionStart = probStmt.selectionEnd = start + insertion.length;
            probStmt.focus();
            probStmt.dispatchEvent(new Event('input'));
        }

        if (probStmt) {
            probStmt.addEventListener('input', function() {
                const val = this.value.trim();
                const hasCitation = val.includes('(') || val.includes('[');
                const hasLength = val.length >= 50;
                
                if (val.length > 0 && (!hasCitation || !hasLength)) {
                    probStmtErr.classList.remove('d-none');
                    this.classList.add('is-invalid');
                    let errMsg = "Please fix the following: ";
                    if (!hasLength) errMsg += "Must be at least 50 characters. ";
                    if (!hasCitation) errMsg += "Must include in-text citations (e.g. (Author, 2024) or [1]).";
                    probStmtErr.innerText = errMsg;
                    this.setCustomValidity('Invalid problem statement');
                } else {
                    probStmtErr.classList.add('d-none');
                    this.classList.remove('is-invalid');
                    this.setCustomValidity('');
                }
            });
        }

        function validateObjective(input, errDiv) {
            if (!input) return;
            input.addEventListener('input', function() {
                const val = this.value.trim();
                const hasLength = val.length >= 10;
                
                if (val.length > 0 && !hasLength) {
                    errDiv.classList.remove('d-none');
                    this.classList.add('is-invalid');
                    errDiv.innerText = "Objective must be at least 10 characters long.";
                    this.setCustomValidity('Invalid objective format');
                } else {
                    errDiv.classList.add('d-none');
                    this.classList.remove('is-invalid');
                    this.setCustomValidity('');
                }
            });
        }

        validateObjective(document.getElementById('objective1'), document.getElementById('objective1Error'));
        validateObjective(document.getElementById('objective2'), document.getElementById('objective2Error'));
        validateObjective(document.getElementById('objective3'), document.getElementById('objective3Error'));

        document.addEventListener("DOMContentLoaded", async function() {
            // Enable Bootstrap validation was duplicating the validation, removed to fix "Save Draft"

            // Final Form Real-time Validation
            const finalAbstract = document.getElementById('finalAbstract');
            const finalAbstractError = document.getElementById('finalAbstractError');
            if (finalAbstract && finalAbstractError) {
                finalAbstract.addEventListener('input', function() {
                    if (this.value.trim().length >= 50) {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                        finalAbstractError.classList.add('d-none');
                    } else {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                        finalAbstractError.classList.remove('d-none');
                    }
                });
            }

            const finalAck = document.getElementById('finalAck');
            const finalAckError = document.getElementById('finalAckError');
            if (finalAck && finalAckError) {
                finalAck.addEventListener('input', function() {
                    const val = this.value.trim();
                    if (val === "" || val.length >= 10) {
                        this.classList.remove('is-invalid');
                        this.classList.add(val !== "" ? 'is-valid' : '');
                        finalAckError.classList.add('d-none');
                    } else {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                        finalAckError.classList.remove('d-none');
                    }
                });
            }

            const finalRepo = document.getElementById('finalRepo');
            const finalRepoError = document.getElementById('finalRepoError');
            if (finalRepo && finalRepoError) {
                finalRepo.addEventListener('input', function() {
                    const val = this.value.trim();
                    let isValidUrl = true;
                    if (val !== "") {
                        try {
                            new URL(val);
                        } catch (_) {
                            isValidUrl = false;  
                        }
                    }
                    if (val === "" || isValidUrl) {
                        this.classList.remove('is-invalid');
                        this.classList.add(val !== "" ? 'is-valid' : '');
                        finalRepoError.classList.add('d-none');
                    } else {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                        finalRepoError.classList.remove('d-none');
                    }
                });
            }

        });

        function getProgressDraftKey(milestoneId) {
            const form = document.getElementById('progressForm');
            const studentId = form?.dataset.studentId || '@(currentUser?.Id ?? Model?.StudentId ?? 0)';
            const projectId = form?.dataset.projectId || '@(Model?.Id ?? 0)';
            return `fyp_draft_progress_${studentId}_${projectId}_${milestoneId}`;
        }

        function saveCurrentProgressDraft() {
            const selectObj = document.getElementById('progressMilestoneSelect');
            if (!selectObj || !selectObj.value) return;
            const milestoneId = selectObj.value;
            const key = getProgressDraftKey(milestoneId);
            const startDateInput = document.getElementById('progressStartDate');
            const endDateInput = document.getElementById('progressEndDate');
            const revisionNotesInput = document.getElementById('progressRevisionNotes');

            const data = {
                milestoneId: milestoneId,
                startDate: startDateInput ? startDateInput.value : '',
                endDate: endDateInput ? endDateInput.value : '',
                revisionNotes: revisionNotesInput ? revisionNotesInput.value : ''
            };
            try {
                localStorage.setItem(key, JSON.stringify(data));
                const form = document.getElementById('progressForm');
                const studentId = form?.dataset.studentId || '@(currentUser?.Id ?? Model?.StudentId ?? 0)';
                const projectId = form?.dataset.projectId || '@(Model?.Id ?? 0)';
                localStorage.setItem(`fyp_last_progress_milestone_${studentId}_${projectId}`, milestoneId);
            } catch (e) {}
        }

        function restoreProgressMilestoneDraft(milestoneId) {
            const startDateInput = document.getElementById('progressStartDate');
            const endDateInput = document.getElementById('progressEndDate');
            const revisionNotesInput = document.getElementById('progressRevisionNotes');
            const selectObj = document.getElementById('progressMilestoneSelect');
            if (!startDateInput || !endDateInput) return;

            if (!milestoneId) {
                startDateInput.value = '';
                endDateInput.value = '@DateTime.Today.ToString("yyyy-MM-dd")';
                if (revisionNotesInput) revisionNotesInput.value = '';
                return;
            }

            const key = getProgressDraftKey(milestoneId);
            let restoredStart = false;
            let restoredEnd = false;

            // 1. Try local storage first
            try {
                const saved = localStorage.getItem(key);
                if (saved) {
                    const data = JSON.parse(saved);
                    if (data) {
                        if (data.startDate) {
                            startDateInput.value = data.startDate;
                            restoredStart = true;
                        }
                        if (data.endDate) {
                            endDateInput.value = data.endDate;
                            restoredEnd = true;
                        }
                        if (data.revisionNotes && revisionNotesInput) {
                            revisionNotesInput.value = data.revisionNotes;
                        }
                    }
                }
            } catch (e) {}

            // 2. Fall back to server-persisted data attributes
            if (selectObj && selectObj.selectedIndex >= 0) {
                const option = selectObj.options[selectObj.selectedIndex];
                const serverStart = option.getAttribute('data-start-date');
                const serverEnd = option.getAttribute('data-end-date');

                if (!restoredStart) {
                    startDateInput.value = serverStart || '';
                }
                if (!restoredEnd) {
                    endDateInput.value = serverEnd || '@DateTime.Today.ToString("yyyy-MM-dd")';
                }
            }
            if (typeof validateProgressSubmitBtn === 'function') validateProgressSubmitBtn();
        }

        function toggleProgressTemplate(selectObj) {
            const statusInfo = document.getElementById('progressStatusInfo');
            const statusTitle = document.getElementById('progressStatusTitle');
            const statusBadge = document.getElementById('progressStatusBadge');
            const downloadBtn = document.getElementById('btnDownloadProgress');
            const feedbackInfo = document.getElementById('progressFeedbackInfo');
            const feedbackText = document.getElementById('progressFeedbackText');
            const revisionSection = document.getElementById('progressRevisionSection');
            const revisionNotes = document.getElementById('progressRevisionNotes');
            const submitBtn = document.getElementById('btnProgressSubmit');
            
            if (selectObj.value) {
                downloadBtn.href = '/Student/DownloadProgressTemplate?milestoneId=' + selectObj.value;
                downloadBtn.classList.remove('disabled');
                
                const selectedOption = selectObj.options[selectObj.selectedIndex];
                const status = selectedOption.getAttribute('data-status');
                const feedback = selectedOption.getAttribute('data-feedback');
                const dueDate = selectedOption.getAttribute('data-due-date');
                const dueDateDisplay = selectedOption.getAttribute('data-due-date-display');
                let title = selectedOption.text;

                statusInfo.classList.remove('d-none');
                statusTitle.innerText = title;

                const dueDateBadge = document.getElementById('progressDueDateBadge');
                const dueDateText = document.getElementById('progressDueDateText');
                const endDateInput = document.getElementById('progressEndDate');
                if (dueDate && dueDateDisplay) {
                    if (dueDateBadge) dueDateBadge.classList.remove('d-none');
                    if (dueDateText) dueDateText.innerText = dueDateDisplay;
                    if (endDateInput) endDateInput.setAttribute('max', dueDate);
                } else {
                    if (dueDateBadge) dueDateBadge.classList.add('d-none');
                    if (endDateInput) endDateInput.removeAttribute('max');
                }
                
                if (status === 'ReturnedForChanges') {
                    statusBadge.innerText = 'Returned for Changes';
                    statusBadge.className = 'badge bg-danger text-white px-3 py-1 rounded-pill small';
                    
                    feedbackInfo.classList.remove('d-none');
                    feedbackText.innerText = feedback;
                    revisionSection.classList.remove('d-none');
                    revisionNotes.setAttribute('required', 'required');
                    if (submitBtn) submitBtn.innerText = 'Resubmit for Supervisor Review';
                } else {
                    statusBadge.innerText = status || 'Draft';
                    statusBadge.className = 'badge bg-primary text-white px-3 py-1 rounded-pill small';
                    
                    feedbackInfo.classList.add('d-none');
                    revisionSection.classList.add('d-none');
                    revisionNotes.removeAttribute('required');
                    if (submitBtn) submitBtn.innerText = 'Send for Supervisor Review';
                }

                restoreProgressMilestoneDraft(selectObj.value);
            } else {
                downloadBtn.removeAttribute('href');
                downloadBtn.classList.add('disabled');
                statusInfo.classList.add('d-none');
                feedbackInfo.classList.add('d-none');
                revisionSection.classList.add('d-none');
                revisionNotes.removeAttribute('required');
                const dueDateBadge = document.getElementById('progressDueDateBadge');
                if (dueDateBadge) dueDateBadge.classList.add('d-none');
                const endDateInput = document.getElementById('progressEndDate');
                if (endDateInput) endDateInput.removeAttribute('max');
                if (submitBtn) submitBtn.innerText = 'Send for Supervisor Review';

                restoreProgressMilestoneDraft('');
            }
            if (typeof validateProgressSubmitBtn === 'function') validateProgressSubmitBtn();
        }

        // Initialize progress draft submit listener and restore last selected milestone on refresh
        (function() {
            const progressForm = document.getElementById('progressForm');
            if (progressForm) {
                progressForm.addEventListener('submit', function(e) {
                    const isDraft = e.submitter?.name === 'isDraft' && e.submitter?.value === 'true';
                    if (isDraft || e.defaultPrevented) {
                        saveCurrentProgressDraft();
                        return;
                    }

                    if (progressForm.checkValidity()) {
                        const selectObj = document.getElementById('progressMilestoneSelect');
                        if (selectObj && selectObj.value) {
                            try {
                                localStorage.removeItem(getProgressDraftKey(selectObj.value));
                            } catch(e) {}
                        }
                    }
                });
            }

            const progressSelect = document.getElementById('progressMilestoneSelect');
            if (progressSelect && !progressSelect.value) {
                const form = document.getElementById('progressForm');
                const studentId = form?.dataset.studentId || '@(currentUser?.Id ?? Model?.StudentId ?? 0)';
                const projectId = form?.dataset.projectId || '@(Model?.Id ?? 0)';
                const lastMilestoneKey = `fyp_last_progress_milestone_${studentId}_${projectId}`;
                try {
                    const lastMilestoneId = localStorage.getItem(lastMilestoneKey);
                    if (lastMilestoneId) {
                        const opt = progressSelect.querySelector(`option[value="${lastMilestoneId}"]`);
                        if (opt) {
                            progressSelect.value = lastMilestoneId;
                            toggleProgressTemplate(progressSelect);
                        }
                    }
                } catch (e) {}
            }

            // Bind change and input event listeners on all relevant inputs to recalculate submit button state immediately
            ['change', 'input'].forEach(function(evt) {
                document.getElementById('progressMilestoneSelect')?.addEventListener(evt, validateProgressSubmitBtn);
                document.getElementById('progressStartDate')?.addEventListener(evt, validateProgressSubmitBtn);
                document.getElementById('progressEndDate')?.addEventListener(evt, validateProgressSubmitBtn);
                document.getElementById('progressFiles')?.addEventListener(evt, validateProgressSubmitBtn);
                document.getElementById('progressRevisionNotes')?.addEventListener(evt, validateProgressSubmitBtn);
            });

            // Initial button state evaluation
            validateProgressSubmitBtn();
        })();

        function validateProgressSubmitBtn() {
            const milestoneSelect = document.getElementById('progressMilestoneSelect');
            const startDate = document.getElementById('progressStartDate');
            const endDate = document.getElementById('progressEndDate');
            const fileInput = document.getElementById('progressFiles');
            const submitBtn = document.getElementById('btnProgressSubmit');
            const revisionNotes = document.getElementById('progressRevisionNotes');
            const revisionSection = document.getElementById('progressRevisionSection');
            const dateErrorDiv = document.getElementById('progressDateError');
            const dueDateErrorDiv = document.getElementById('progressDueDateError');
            const dueDateErrorText = document.getElementById('progressDueDateErrorText');
            const fileErrorDiv = document.getElementById('progressFileError');
            
            if (!submitBtn) return;
            
            let isValid = true;

            // 1. Milestone selection required
            if (!milestoneSelect || !milestoneSelect.value) {
                isValid = false;
            }

            // 2. Reporting period required: both startDate and endDate must be filled
            if (!startDate || !startDate.value || !endDate || !endDate.value) {
                isValid = false;
                if (dateErrorDiv) dateErrorDiv.classList.add('d-none');
                if (dueDateErrorDiv) dueDateErrorDiv.classList.add('d-none');
            } else {
                // End period must be equal to or after Start period.
                if (endDate.value < startDate.value) {
                    isValid = false;
                    if (dateErrorDiv) dateErrorDiv.classList.remove('d-none');
                } else {
                    if (dateErrorDiv) dateErrorDiv.classList.add('d-none');
                }

                // Check Due Date constraint: End Period cannot exceed Milestone Due Date
                const selectedOpt = milestoneSelect && milestoneSelect.selectedIndex >= 0 ? milestoneSelect.options[milestoneSelect.selectedIndex] : null;
                const dueDate = selectedOpt?.getAttribute('data-due-date');
                const dueDateDisplay = selectedOpt?.getAttribute('data-due-date-display');
                if (dueDate && endDate.value > dueDate) {
                    isValid = false;
                    if (dueDateErrorDiv) {
                        if (dueDateErrorText) dueDateErrorText.innerText = dueDateDisplay || dueDate;
                        dueDateErrorDiv.classList.remove('d-none');
                    }
                } else {
                    if (dueDateErrorDiv) dueDateErrorDiv.classList.add('d-none');
                }
            }

            // 3. PDF file selection required
            let hasValidPdf = false;
            if (fileInput && fileInput.files && fileInput.files.length > 0) {
                const files = Array.from(fileInput.files);
                const allPdf = files.every(function(f) {
                    const name = f.name ? f.name.toLowerCase() : '';
                    return name.endsWith('.pdf') || f.type === 'application/pdf';
                });
                if (allPdf) {
                    hasValidPdf = true;
                    if (fileErrorDiv) fileErrorDiv.classList.add('d-none');
                } else {
                    if (fileErrorDiv) {
                        fileErrorDiv.textContent = 'Please select PDF files only.';
                        fileErrorDiv.classList.remove('d-none');
                    }
                }
            } else {
                if (fileErrorDiv) fileErrorDiv.classList.add('d-none');
            }

            if (!hasValidPdf) {
                isValid = false;
            }
            
            // 4. For ReturnedForChanges, require non-empty Revision Details
            const selectedOption = milestoneSelect && milestoneSelect.selectedIndex >= 0 ? milestoneSelect.options[milestoneSelect.selectedIndex] : null;
            const isReturned = (selectedOption && selectedOption.getAttribute('data-status') === 'ReturnedForChanges') ||
                               (revisionSection && !revisionSection.classList.contains('d-none'));

            if (isReturned) {
                if (!revisionNotes || !revisionNotes.value.trim()) {
                    isValid = false;
                }
            }

            if (isValid) {
                submitBtn.removeAttribute('disabled');
            } else {
                submitBtn.setAttribute('disabled', 'disabled');
            }
        }

        function validateProposalForm() {
            var fileInput = document.getElementById('proposalDocument');
            var errorDiv = document.getElementById('proposalFileError');
            if (fileInput && fileInput.files.length === 0) {
                errorDiv.classList.remove('d-none');
                return false; // Prevent form submission
            }
            errorDiv.classList.add('d-none');
            return true; // Allow form submission
        }

        function validateProgressForm(event) {
            var isValid = true;
            
            // Validate File
            var fileInput = document.getElementById('progressFiles');
            var fileErrorDiv = document.getElementById('progressFileError');
            var hasValidPdf = false;
            if (fileInput && fileInput.files && fileInput.files.length > 0) {
                hasValidPdf = Array.from(fileInput.files).every(function(f) {
                    var name = f.name ? f.name.toLowerCase() : '';
                    return name.endsWith('.pdf') || f.type === 'application/pdf';
                });
            }
            if (!hasValidPdf) {
                if (fileErrorDiv) {
                    fileErrorDiv.textContent = 'Please upload a valid PDF document.';
                    fileErrorDiv.classList.remove('d-none');
                }
                isValid = false;
            } else {
                if (fileErrorDiv) fileErrorDiv.classList.add('d-none');
            }
            
            // Validate Dates
            var startDateInput = document.getElementById('progressStartDate');
            var endDateInput = document.getElementById('progressEndDate');
            var dateErrorDiv = document.getElementById('progressDateError');
            var dueDateErrorDiv = document.getElementById('progressDueDateError');
            var dueDateErrorText = document.getElementById('progressDueDateErrorText');
            var selectObj = document.getElementById('progressMilestoneSelect');
            var selectedOpt = selectObj && selectObj.selectedIndex >= 0 ? selectObj.options[selectObj.selectedIndex] : null;
            
            if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
                if (endDateInput.value < startDateInput.value) {
                    if (dateErrorDiv) dateErrorDiv.classList.remove('d-none');
                    isValid = false;
                } else {
                    if (dateErrorDiv) dateErrorDiv.classList.add('d-none');
                }

                // Check Due Date
                var dueDate = selectedOpt?.getAttribute('data-due-date');
                var dueDateDisplay = selectedOpt?.getAttribute('data-due-date-display');
                if (dueDate && endDateInput.value > dueDate) {
                    if (dueDateErrorDiv) {
                        if (dueDateErrorText) dueDateErrorText.innerText = dueDateDisplay || dueDate;
                        dueDateErrorDiv.classList.remove('d-none');
                    }
                    isValid = false;
                } else {
                    if (dueDateErrorDiv) dueDateErrorDiv.classList.add('d-none');
                }
            } else {
                if (dateErrorDiv) dateErrorDiv.classList.add('d-none');
                if (dueDateErrorDiv) dueDateErrorDiv.classList.add('d-none');
                if (!startDateInput?.value || !endDateInput?.value) isValid = false;
            }

            // Validate Revision Details if ReturnedForChanges
            var selectObj = document.getElementById('progressMilestoneSelect');
            var selectedOpt = selectObj && selectObj.selectedIndex >= 0 ? selectObj.options[selectObj.selectedIndex] : null;
            var revSection = document.getElementById('progressRevisionSection');
            var revNotes = document.getElementById('progressRevisionNotes');
            var isReturned = (selectedOpt && selectedOpt.getAttribute('data-status') === 'ReturnedForChanges') ||
                             (revSection && !revSection.classList.contains('d-none'));
            if (isReturned && (!revNotes || !revNotes.value.trim())) {
                isValid = false;
            }

            if (!isValid) {
                if (event) event.preventDefault();
                return false;
            }

            // Turnitin Mock Scan
            var selectObj = document.getElementById('progressMilestoneSelect');
            if (isValid && selectObj) {
                var selectedText = selectObj.options[selectObj.selectedIndex].text;
                if (selectedText.includes("Turnitin")) {
                    if (event) event.preventDefault();
                    Swal.fire({
                        title: 'Turnitin AI Scanner',
                        html: '<div class="text-start mt-3 fw-semibold text-secondary" style="font-size:0.95rem;">' +
                              '<i class="fas fa-satellite-dish me-2 text-primary"></i>Connecting to Turnitin Core API...<br><br>' +
                              '<i class="fas fa-search me-2 text-info"></i>Scanning document for similarity...<br><br>' +
                              '<i class="fas fa-globe me-2 text-success"></i>Cross-referencing global databases...<br><br>' +
                              '<div class="progress mt-3"><div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: 100%"></div></div>' +
                              '</div>',
                        showConfirmButton: false,
                        allowOutsideClick: false,
                        timer: 4500
                    }).then(() => {
                        var randScore = Math.floor(Math.random() * 15) + 4; // 4% to 18%
                        Swal.fire({
                            title: 'Scan Complete!',
                            html: '<h2 class="text-success fw-bold mb-3">' + randScore + '%</h2><p class="mb-0 text-muted">Similarity Index (Acceptable)</p>',
                            icon: 'success',
                            confirmButtonText: 'Upload Report to Supervisor',
                            confirmButtonColor: '#10b981'
                        }).then((result) => {
                            if(result.isConfirmed) {
                                selectObj.form.submit();
                            }
                        });
                    });
                    return false; // Wait for sweetalert to finish
                }
            }

            return isValid;
        }

        function validateFinalForm() {
            var isValid = true;

            var fileInput = document.getElementById('finalDocument');
            var errorDiv = document.getElementById('finalFileError');
            if (fileInput && fileInput.files.length === 0) {
                errorDiv.classList.remove('d-none');
                isValid = false;
            } else {
                errorDiv.classList.add('d-none');
            }

            var turnitinInput = document.getElementById('turnitinDocument');
            var turnitinErrorDiv = document.getElementById('turnitinFileError');
            if (turnitinInput && turnitinInput.files.length === 0) {
                turnitinErrorDiv.classList.remove('d-none');
                isValid = false;
            } else if (turnitinErrorDiv) {
                turnitinErrorDiv.classList.add('d-none');
            }

            var ethicsInput = document.getElementById('ethicsDocument');
            var ethicsErrorDiv = document.getElementById('ethicsFileError');
            if (ethicsInput && ethicsInput.files.length === 0) {
                ethicsErrorDiv.classList.remove('d-none');
                isValid = false;
            } else {
                ethicsErrorDiv.classList.add('d-none');
            }

            const abstract = document.getElementById('finalAbstract');
            const abstractError = document.getElementById('finalAbstractError');
            if (abstract && abstract.value.trim().length < 50) {
                abstract.classList.add('is-invalid');
                abstractError.classList.remove('d-none');
                isValid = false;
            }

            const ack = document.getElementById('finalAck');
            const ackError = document.getElementById('finalAckError');
            if (ack && ack.value.trim() !== "" && ack.value.trim().length < 10) {
                ack.classList.add('is-invalid');
                ackError.classList.remove('d-none');
                isValid = false;
            }

            const repo = document.getElementById('finalRepo');
            const repoError = document.getElementById('finalRepoError');
            if (repo && repo.value.trim() !== "") {
                try {
                    new URL(repo.value.trim());
                } catch (_) {
                    repo.classList.add('is-invalid');
                    repoError.classList.remove('d-none');
                    isValid = false;
                }
            }

            return isValid;
        }

        document.addEventListener('MilestoneUpdateEvent', function(e) {
            const payload = e.detail;
            payload._handled = true;
            Swal.fire({
                title: payload.title,
                text: payload.message,
                icon: (payload.status === 'Approved') ? 'success' : 'info',
                showCancelButton: true,
                confirmButtonText: 'Refresh Page',
                cancelButtonText: 'Later'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.reload();
                }
            });
        });
    $('[id^="iafAttemptModal"]').appendTo('body');
    
    /* ===== IAF FORM VALIDATION ===== */
    (function () {
        const form = document.getElementById('iafFormElement');
        if (!form) return;

        const summary = document.getElementById('iafValidationSummary');
        const errorList = document.getElementById('iafValidationList');

        let attemptedSubmit = false;

        // Each rule applies only to the IAF form.
        const rules = [
            {
                selector: '[name="coventryId"]',
                label: 'Coventry ID',
                check: v => v ? '' : 'Coventry ID is required.'
            },
            {
                selector: '[name="title"]',
                label: 'Project Title',
                check: v => v ? '' : 'Project Title is required.'
            },
            {
                selector: '#scope',
                label: 'Scope of Project',
                check: v => v ? '' : 'Please select a project scope.'
            },
            {
                selector: '#problemStatement',
                label: 'Problem Statement',
                errorId: 'problemStatementError',
                check: v => {
                    if (v.length < 50) {
                        return 'Problem Statement must contain at least 50 characters.';
                    }

                    const hasCitation =
                        /\([^)]+,\s*(19|20)\d{2}\)|\[\d+\]/.test(v);

                    if (!hasCitation) {
                        return 'Please include an in-text citation, e.g. (Author, 2024) or [1].';
                    }

                    return '';
                }
            },
            {
                selector: '#objective1',
                label: 'Objective 1',
                errorId: 'objective1Error',
                check: v => {
                    if (v.length < 10 || v.split(/\s+/).length < 3) {
                        return 'Objective 1 requires at least 10 characters and 3 words.';
                    }
                    return '';
                }
            },
            {
                selector: '#objective2',
                label: 'Objective 2',
                errorId: 'objective2Error',
                check: v => {
                    if (v.length < 10 || v.split(/\s+/).length < 3) {
                        return 'Objective 2 requires at least 10 characters and 3 words.';
                    }
                    return '';
                }
            },
            {
                selector: '#objective3',
                label: 'Objective 3',
                errorId: 'objective3Error',
                check: v => {
                    // Objective 3 is optional in the existing form.
                    if (!v) return '';

                    if (v.length < 10 || v.split(/\s+/).length < 3) {
                        return 'Objective 3 requires at least 10 characters and 3 words when provided.';
                    }
                    return '';
                }
            },
            {
                selector: '#iafReferences',
                label: 'References Listing',
                errorId: 'iafReferencesError',
                check: v => {
                    const shouldEnforce = form.getAttribute('data-enforce-references') === 'true';
                    if (!shouldEnforce) return '';

                    if (!v) {
                        return 'At least one academic reference is required.';
                    }

                    const lines = v.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
                    if (lines.length === 0) {
                        return 'At least one academic reference is required.';
                    }

                    const yearRegex = /(?:^|\D)(20\d{2})(?:\D|$)/;
                    let validCount = 0;

                    for (let i = 0; i < lines.length; i++) {
                        const line = lines[i];
                        if (line.toLowerCase() === 'references' || line.toLowerCase() === 'references:' || line.toLowerCase() === 'reference:' || line.length < 10) {
                            continue;
                        }

                        const match = line.match(yearRegex);
                        if (!match) {
                            const snippet = line.length > 35 ? line.substring(0, 32) + '...' : line;
                            return `Reference "${snippet}" is missing a publication year.`;
                        }

                        const year = parseInt(match[1], 10);
                        if (year < 2021 || year > 2026) {
                            return `Publication year ${year} is outside the allowed 2021–2026 range. Academic references must be published between 2021 and 2026.`;
                        }

                        const stripped = line.replace(yearRegex, ' ').trim();
                        const words = stripped.split(/[\s,\.;:\(\)\[\]"“”]+/).filter(w => w.length > 0);
                        if (words.length < 3 || stripped.length < 15) {
                            return 'Each reference must include identifiable author/organization and title details.';
                        }

                        validCount++;
                    }

                    if (validCount === 0) {
                        return 'At least one complete academic reference with author, title, and publication year (2021–2026) is required.';
                    }

                    return '';
                }
            }
        ];

        function checkField(rule, showFeedback) {
            const field = form.querySelector(rule.selector);
            if (!field || field.disabled || field.readOnly) return '';

            const message = rule.check(field.value.trim());

            field.setCustomValidity(message);

            if (showFeedback) {
                field.classList.toggle('is-invalid', !!message);
                field.classList.toggle(
                    'is-valid',
                    !message && field.value.trim().length > 0
                );

                if (rule.errorId) {
                    const error = document.getElementById(rule.errorId);
                    if (error) {
                        error.textContent = message;
                        error.classList.toggle('d-none', !message);
                    }
                }
            }

            return message;
        }

        function getErrors(showFeedback) {
            const errors = [];

            rules.forEach(rule => {
                const message = checkField(rule, showFeedback);
                if (message) {
                    errors.push({
                        rule: rule,
                        message: message
                    });
                }
            });

            return errors;
        }

        function renderSummary(errors) {
            if (!summary || !errorList) return;

            errorList.replaceChildren();

            errors.forEach(error => {
                const li = document.createElement('li');
                li.textContent = error.message;
                errorList.appendChild(li);
            });

            summary.classList.toggle('d-none', errors.length === 0);
        }

        // Real-time and blur validation.
        rules.forEach(rule => {
            const field = form.querySelector(rule.selector);
            if (!field) return;

            function revalidate() {
                checkField(rule, attemptedSubmit || field.dataset.touched === '1');

                if (attemptedSubmit) {
                    renderSummary(getErrors(true));
                }
            }

            field.addEventListener('input', revalidate);
            field.addEventListener('change', revalidate);

            field.addEventListener('blur', function () {
                field.dataset.touched = '1';
                revalidate();
            });
        });

        // Validate only formal IAF submissions.
        // Keep Save Draft and other workflow actions unchanged.
        form.addEventListener('submit', function (event) {
            const submitter = event.submitter;
            const action = submitter?.name === 'iafAction'
                ? submitter.value
                : '';

            if (!['supervisor_review', 'submit', 'submit_new'].includes(action)) {
                return;
            }

            attemptedSubmit = true;

            const errors = getErrors(true);
            renderSummary(errors);

            if (errors.length > 0 || !form.checkValidity()) {
                event.preventDefault();

                if (errors.length > 0) {
                    const firstField = form.querySelector(
                        errors[0].rule.selector
                    );

                    if (firstField) {
                        firstField.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });

                        firstField.focus({ preventScroll: true });
                    }
                } else {
                    form.querySelector(':invalid')?.focus();
                }
            }

            // If valid, existing submission handling continues.
        }, true);
    })();


    </script>
