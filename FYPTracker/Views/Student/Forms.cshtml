                                                    <div class="col-12 mt-1">
                                                        <div id="progressDateError" class="text-danger fw-bold small d-none"><i class="fas fa-exclamation-triangle me-1"></i>End Period must be equal to or after the Start Period.</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Section 2 -->
                                        <div class="saas-card mb-3">
                                            <div class="saas-card-body p-3">
                                                <div class="d-flex align-items-center mb-2">
                                                    <span class="text-primary fw-bolder fs-5 me-2">02</span>
                                                    <h6 class="fw-bold text-dark mb-0">Progress Document (PDF)</h6>
                                                </div>
                                                
                                                <div class="ms-4 mt-2">
                                                    <div class="mb-3">
                                                        <label for="progressFiles" class="form-label fw-semibold">Upload Supporting Documents</label>
                                                        <input class="form-control" type="file" id="progressFiles" name="attachedFiles" accept=".pdf" multiple />
                                                        <div class="form-text">Accepted formats: PDF only. You can select multiple files.</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Section 3 -->
                                        <div id="progressRevisionSection" class="d-none mb-3">
                                            <div class="saas-card" style="border-left: 3px solid #F59E0B; background: #FEF3C7;">
                                                <div class="saas-card-body p-3">
                                                    <div class="d-flex align-items-center mb-2">
                                                        <span class="text-warning fw-bolder fs-5 me-2" style="color: #F59E0B !important;">03</span>
                                                        <h6 class="fw-bold text-dark mb-0">Revision Details</h6>
                                                    </div>
                                                    <div class="ms-4 mt-2">
                                                        <textarea name="revisionNotes" id="progressRevisionNotes" class="form-control saas-input" rows="2" placeholder="Briefly explain your changes based on feedback..." oninput="validateProgressSubmitBtn()"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Action Area -->
                                        <div class="d-flex flex-wrap align-items-center justify-content-between mt-4 p-3 saas-card bg-white position-sticky bottom-0 shadow-sm" style="z-index:100; border-radius: 8px;">
                                            <div class="text-muted small fw-medium"><i class="fas fa-save me-1"></i>Your work can be saved as a draft locally.</div>
                                            <div class="d-flex gap-2 mt-2 mt-md-0">
                                                <button type="submit" name="isDraft" value="true" class="btn-saas-secondary" formnovalidate>Save Draft</button>
                                                <button type="submit" class="btn-saas-primary" id="btnProgressSubmit" onclick="return validateProgressForm(event)" disabled>Send for Supervisor Review</button>
                                            </div>
                                        </div>
                                    </form>
                                }
                            }
                        </div>
                    </div>



                </div>
            </div>
            }
            
        </div>
    }

</div>

<script>
    function saveDraftAlert() {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'info',
                title: 'Draft Saved',
                text: 'Draft saved successfully in the session! You can continue editing later.',
                confirmButtonColor: '#3b82f6',
                background: '#ffffff',
                customClass: { popup: 'rounded-4 shadow-sm border-0' }
            });
        } else {
            alert("Draft saved successfully in the session! You can continue editing later.");
        }
    }
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Drag and Drop Logic
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('proposalDocument');
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, preventDefaults, false);
        });
        
        function preventDefaults (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        
        ['dragenter', 'dragover'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, () => dropZone.style.borderColor = 'var(--primary-orange)', false);
        });
        
        ['dragleave', 'drop'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, () => dropZone.style.borderColor = '#cbd5e1', false);
        });
        
        if(dropZone) {
            dropZone.addEventListener('drop', (e) => {
                let dt = e.dataTransfer;
                let files = dt.files;
                fileInput.files = files;
                updateFileName(fileInput);
            }, false);
        }

        function updateFileName(input) {
            const display = document.getElementById('fileNameDisplay');
            const fName = document.getElementById('fName');
            if (input.files && input.files.length > 0) {
                fName.textContent = input.files[0].name;
                display.style.display = 'block';
            } else {
                display.style.display = 'none';
            }
        }
        
        function updateFileNameForFinal(input) {
            const display = document.getElementById('finalFileNameDisplay');
            const fName = document.getElementById('fFinalName');
            const errorLabel = document.getElementById('finalFileError');
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
                    errorLabel.textContent = "Only PDF files are allowed.";
                    errorLabel.style.display = 'block';
                    input.value = "";
                    display.style.display = 'none';
                    return;
                }
                if (file.size > 20 * 1024 * 1024) {
                    errorLabel.textContent = "File size exceeds 20MB limit.";
                    errorLabel.style.display = 'block';
                    input.value = "";
                    display.style.display = 'none';
                    return;
                }
                
                errorLabel.style.display = 'none';
                fName.textContent = file.name;
                display.style.display = 'block';
            } else {
                display.style.display = 'none';
            }
        }
        
        function updateFileNameForTurnitin(input) {
            const display = document.getElementById('turnitinFileNameDisplay');
            const fName = document.getElementById('fTurnitinName');
            const errorLabel = document.getElementById('turnitinFileError');
            if (input.files && input.files.length > 0) {
                fName.textContent = input.files[0].name;
                display.style.display = 'block';
                if (errorLabel) errorLabel.classList.add('d-none');
            } else {
                display.style.display = 'none';
            }
        }

        function updateFileNameForEthics(input) {
            const display = document.getElementById('ethicsFileNameDisplay');
            const fName = document.getElementById('fEthicsName');
            const errorLabel = document.getElementById('ethicsFileError');
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
                    errorLabel.textContent = "Only PDF files are allowed.";
                    errorLabel.style.display = 'block';
                    input.value = "";
                    display.style.display = 'none';
                    return;
                }
                
                errorLabel.style.display = 'none';
                fName.textContent = file.name;
                display.style.display = 'block';
            } else {
                display.style.display = 'none';
            }
        }
        
        function updateMultiFileNames(input, listId) {
            const display = document.getElementById(listId);
            const dropZone = document.getElementById('progressDropZone');
            display.innerHTML = '';
            if (input.files && input.files.length > 0) {
                dropZone.style.display = 'none';
                display.style.display = 'block';
                Array.from(input.files).forEach(file => {
                    const fileDiv = document.createElement('div');
                    fileDiv.className = 'd-flex justify-content-between align-items-center p-3 rounded-3 bg-white border shadow-sm';
                    const fileSize = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
                    fileDiv.innerHTML = '<div class="d-flex align-items-center"><i class="fas fa-file-pdf fs-1 text-danger me-3"></i><div><h6 class="mb-0 text-dark fw-bold">' + file.name + '</h6><small class="text-muted">' + fileSize + '</small></div></div>' +
                        '<button type="button" class="btn btn-sm btn-light-danger fw-bold rounded-pill px-3" onclick="clearFileInput(\'' + input.id + '\', \'' + listId + '\', event)">Remove</button>';
                    display.appendChild(fileDiv);
                });
            } else {
                display.style.display = 'none';
                dropZone.style.display = 'block';
            }
            if (typeof validateProgressSubmitBtn === 'function') validateProgressSubmitBtn();
        }

        function clearFileInput(inputId, listId, event) {
            event.stopPropagation();
            const input = document.getElementById(inputId);
            if (input) {
                input.value = '';
                updateMultiFileNames(input, listId);
            }
        }
        
        // Setup Progress Drop Zone
        const progDropZone = document.getElementById('progressDropZone');
        const progFileInput = document.getElementById('progressFiles');
        if (progDropZone && progFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                progDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                progDropZone.addEventListener(eventName, () => progDropZone.style.borderColor = '#3b82f6', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                progDropZone.addEventListener(eventName, () => progDropZone.style.borderColor = '#cbd5e1', false);
            });
            progDropZone.addEventListener('drop', (e) => {
                progFileInput.files = e.dataTransfer.files;
                updateMultiFileNames(progFileInput, 'progressFileList');
            }, false);
        }

        // Setup Final Drop Zone
        const finalDropZone = document.getElementById('finalDropZone');
        const finalFileInput = document.getElementById('finalDocument');
        if (finalDropZone && finalFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, () => finalDropZone.style.borderColor = '#ef4444', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, () => finalDropZone.style.borderColor = '#cbd5e1', false);
            });
            finalDropZone.addEventListener('drop', (e) => {
                finalFileInput.files = e.dataTransfer.files;
                updateFileNameForFinal(finalFileInput);
            }, false);
        }
        
        // Setup Turnitin Drop Zone
        const turnitinDropZone = document.getElementById('turnitinDropZone');
        const turnitinFileInput = document.getElementById('turnitinDocument');
        if (turnitinDropZone && turnitinFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                turnitinDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                turnitinDropZone.addEventListener(eventName, () => turnitinDropZone.style.borderColor = '#10b981', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                turnitinDropZone.addEventListener(eventName, () => turnitinDropZone.style.borderColor = '#cbd5e1', false);
            });
            turnitinDropZone.addEventListener('drop', (e) => {
                turnitinFileInput.files = e.dataTransfer.files;
                updateFileNameForTurnitin(turnitinFileInput);
            }, false);
        }

        // Setup Ethics Drop Zone
        const ethicsDropZone = document.getElementById('ethicsDropZone');
        const ethicsFileInput = document.getElementById('ethicsDocument');
        if (ethicsDropZone && ethicsFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                ethicsDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                ethicsDropZone.addEventListener(eventName, () => ethicsDropZone.style.borderColor = '#3b82f6', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                ethicsDropZone.addEventListener(eventName, () => ethicsDropZone.style.borderColor = '#cbd5e1', false);
            });
            ethicsDropZone.addEventListener('drop', (e) => {
                ethicsFileInput.files = e.dataTransfer.files;
                updateFileNameForEthics(ethicsFileInput);
            }, false);
        }
        
        (function() {
            var successMsg = '@Html.Raw(TempData["Success"])';
            var errorMsg = '@Html.Raw(TempData["Error"])';
            
            if (successMsg && successMsg.trim() !== '') {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: successMsg,
                    confirmButtonColor: '#f97316',
                    background: '#ffffff',
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            }
            
            if (errorMsg && errorMsg.trim() !== '') {
                Swal.fire({
                    icon: 'error',
                    title: 'Submission Failed',
                    text: errorMsg,
                    confirmButtonColor: '#ef4444',
                    background: '#ffffff',
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            }

            // Bootstrap Form Validation
            var forms = document.querySelectorAll('.needs-validation');

            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {

                    // Allow IAF Save Draft without required-field validation
                    const isIafDraft =
                        form.id === 'iafFormElement' &&
                        event.submitter?.name === 'iafAction' &&
                        event.submitter?.value === 'draft';

                    if (isIafDraft) {
                        return;
                    }

                    // Validate normal submissions
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    form.classList.add('was-validated');

                }, false);
            });

            // --- AUTO SAVE FEATURE ---
            const formsToSave = document.querySelectorAll('form.needs-validation');
            formsToSave.forEach(form => {
                const formTypeInput = form.querySelector('input[name="formType"]');
                if(!formTypeInput) return;
                
                const storageKey = 'fyp_draft_' + formTypeInput.value.replace(/\s+/g, '_');
                
                // 1. Restore from Draft
                const savedDraft = localStorage.getItem(storageKey);
                if (savedDraft) {
                    try {
                        const data = JSON.parse(savedDraft);
                        for (const key in data) {
                            const field = form.querySelector(`[name="${key}"]`);
                            if (field && !field.readOnly && field.type !== 'file' && field.type !== 'hidden') {
                                field.value = data[key];
                            }
                        }
                    } catch(e) {}
                }
                
                // 2. Save to Draft on Input (debounced)
                let timeout;
                form.addEventListener('input', function(e) {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        const data = {};
                        const formData = new FormData(form);
                        for (let [key, value] of formData.entries()) {
                            const field = form.querySelector(`[name="${key}"]`);
                            if (field && !field.readOnly && field.type !== 'file' && field.type !== 'hidden') {
                                data[key] = value;
                            }
                        }
                        localStorage.setItem(storageKey, JSON.stringify(data));
                    }, 1000);
                });
                
                // 3. Clear Draft only for a valid, non-draft submission
                form.addEventListener('submit', function(e) {

                    const isIafDraft =
                        form.id === 'iafFormElement' &&
                        e.submitter?.name === 'iafAction' &&
                        e.submitter?.value === 'draft';

                    if (isIafDraft || e.defaultPrevented) {
                        return;
                    }

                    if (form.checkValidity()) {
                        localStorage.removeItem(storageKey);
                    }

                });
            });
            // Initialize Tooltips using jQuery (Bootstrap 4 compatibility)
            try {
                $('[data-toggle="tooltip"]').tooltip();
                $('[data-bs-toggle="tooltip"]').tooltip();
            } catch(e) {}
            
        })();

        // Real-time validation for IAF
        const scopeSelect = document.getElementById('scope');
        if (scopeSelect) {
            scopeSelect.addEventListener('change', function() {
                if (this.value === "") {
                    this.classList.add('is-invalid');
                    this.setCustomValidity('Please select a project scope');
                } else {
                    this.classList.remove('is-invalid');
                    this.setCustomValidity('');
                }
            });
        }

        const probStmt = document.getElementById('problemStatement');
        const probStmtErr = document.getElementById('problemStatementError');
        
        function insertCitation(type) {
            if (!probStmt || probStmt.readOnly) return;
            const start = probStmt.selectionStart;
            const end = probStmt.selectionEnd;
            const text = probStmt.value;
            let insertion = type === '()' ? " (Author, Year)" : " [1]";
            
            probStmt.value = text.substring(0, start) + insertion + text.substring(end);
            probStmt.selectionStart = probStmt.selectionEnd = start + insertion.length;
            probStmt.focus();
            probStmt.dispatchEvent(new Event('input'));
        }

        if (probStmt) {
            probStmt.addEventListener('input', function() {
                const val = this.value.trim();
                const hasCitation = val.includes('(') || val.includes('[');
                const hasLength = val.length >= 50;
                
                if (val.length > 0 && (!hasCitation || !hasLength)) {
                    probStmtErr.classList.remove('d-none');
                    this.classList.add('is-invalid');
                    let errMsg = "Please fix the following: ";
                    if (!hasLength) errMsg += "Must be at least 50 characters. ";
                    if (!hasCitation) errMsg += "Must include in-text citations (e.g. (Author, 2024) or [1]).";
                    probStmtErr.innerText = errMsg;
                    this.setCustomValidity('Invalid problem statement');
                } else {
                    probStmtErr.classList.add('d-none');
                    this.classList.remove('is-invalid');
                    this.setCustomValidity('');
                }
            });
        }

        function validateObjective(input, errDiv) {
            if (!input) return;
            input.addEventListener('input', function() {
                const val = this.value.trim();
                const hasLength = val.length >= 10;
                
                if (val.length > 0 && !hasLength) {
                    errDiv.classList.remove('d-none');
                    this.classList.add('is-invalid');
                    errDiv.innerText = "Objective must be at least 10 characters long.";
                    this.setCustomValidity('Invalid objective format');
                } else {
                    errDiv.classList.add('d-none');
                    this.classList.remove('is-invalid');
                    this.setCustomValidity('');
                }
            });
        }

        validateObjective(document.getElementById('objective1'), document.getElementById('objective1Error'));
        validateObjective(document.getElementById('objective2'), document.getElementById('objective2Error'));
        validateObjective(document.getElementById('objective3'), document.getElementById('objective3Error'));

        document.addEventListener("DOMContentLoaded", async function() {
            // Enable Bootstrap validation
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });

            // Final Form Real-time Validation
            const finalAbstract = document.getElementById('finalAbstract');
            const finalAbstractError = document.getElementById('finalAbstractError');
            if (finalAbstract && finalAbstractError) {
                finalAbstract.addEventListener('input', function() {
                    if (this.value.trim().length >= 50) {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                        finalAbstractError.classList.add('d-none');
                    } else {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                        finalAbstractError.classList.remove('d-none');
                    }
                });
            }

            const finalAck = document.getElementById('finalAck');
            const finalAckError = document.getElementById('finalAckError');
            if (finalAck && finalAckError) {
                finalAck.addEventListener('input', function() {
                    const val = this.value.trim();
                    if (val === "" || val.length >= 10) {
                        this.classList.remove('is-invalid');
                        this.classList.add(val !== "" ? 'is-valid' : '');
                        finalAckError.classList.add('d-none');
                    } else {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                        finalAckError.classList.remove('d-none');
                    }
                });
            }

            const finalRepo = document.getElementById('finalRepo');
            const finalRepoError = document.getElementById('finalRepoError');
            if (finalRepo && finalRepoError) {
                finalRepo.addEventListener('input', function() {
                    const val = this.value.trim();
                    let isValidUrl = true;
                    if (val !== "") {
                        try {
                            new URL(val);
                        } catch (_) {
                            isValidUrl = false;  
                        }
                    }
                    if (val === "" || isValidUrl) {
                        this.classList.remove('is-invalid');
                        this.classList.add(val !== "" ? 'is-valid' : '');
                        finalRepoError.classList.add('d-none');
                    } else {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                        finalRepoError.classList.remove('d-none');
                    }
                });
            }

        });

        function toggleProgressTemplate(selectObj) {
            const statusInfo = document.getElementById('progressStatusInfo');
            const statusTitle = document.getElementById('progressStatusTitle');
            const statusBadge = document.getElementById('progressStatusBadge');
            const downloadBtn = document.getElementById('btnDownloadProgress');
            const feedbackInfo = document.getElementById('progressFeedbackInfo');
            const feedbackText = document.getElementById('progressFeedbackText');
            const revisionSection = document.getElementById('progressRevisionSection');
            const revisionNotes = document.getElementById('progressRevisionNotes');
            const submitBtn = document.getElementById('btnProgressSubmit');
            
            if (selectObj.value) {
                downloadBtn.href = '/Student/DownloadProgressTemplate?milestoneId=' + selectObj.value;
                downloadBtn.classList.remove('disabled');
                
                const selectedOption = selectObj.options[selectObj.selectedIndex];
                const status = selectedOption.getAttribute('data-status');
                const feedback = selectedOption.getAttribute('data-feedback');
                let title = selectedOption.text;
                
                statusInfo.classList.remove('d-none');
                statusTitle.innerText = title;
                
                if (status === 'ReturnedForChanges') {
                    statusBadge.innerText = 'Returned for Changes';
                    statusBadge.className = 'badge bg-danger text-white px-3 py-1 rounded-pill small';
                    
                    feedbackInfo.classList.remove('d-none');
                    feedbackText.innerText = feedback;
                    revisionSection.classList.remove('d-none');
                    revisionNotes.setAttribute('required', 'required');
                    if (submitBtn) submitBtn.innerText = 'Resubmit for Supervisor Review';
                } else {
                    statusBadge.innerText = status || 'Draft';
                    statusBadge.className = 'badge bg-primary text-white px-3 py-1 rounded-pill small';
                    
                    feedbackInfo.classList.add('d-none');
                    revisionSection.classList.add('d-none');
                    revisionNotes.removeAttribute('required');
                    if (submitBtn) submitBtn.innerText = 'Send for Supervisor Review';
                }
            } else {
                downloadBtn.removeAttribute('href');
                downloadBtn.classList.add('disabled');
                statusInfo.classList.add('d-none');
                feedbackInfo.classList.add('d-none');
                revisionSection.classList.add('d-none');
                revisionNotes.removeAttribute('required');
                if (submitBtn) submitBtn.innerText = 'Send for Supervisor Review';
            }
            if (typeof validateProgressSubmitBtn === 'function') validateProgressSubmitBtn();
        }

        function validateProgressSubmitBtn() {
            const milestoneSelect = document.getElementById('progressMilestoneSelect');
            const startDate = document.getElementById('progressStartDate');
            const endDate = document.getElementById('progressEndDate');
            const fileInput = document.getElementById('progressFiles');
            const submitBtn = document.getElementById('btnProgressSubmit');
            const revisionNotes = document.getElementById('progressRevisionNotes');
            const revisionSection = document.getElementById('progressRevisionSection');
            
            if (!submitBtn) return;
            
            let isValid = true;
            if (!milestoneSelect || !milestoneSelect.value) isValid = false;
            if (!startDate || !startDate.value) isValid = false;
            if (!endDate || !endDate.value) isValid = false;
            if (startDate && endDate && startDate.value && endDate.value) {
                if (new Date(endDate.value) < new Date(startDate.value)) isValid = false;
            }
            if (!fileInput || fileInput.files.length === 0) isValid = false;
            
            if (revisionSection && !revisionSection.classList.contains('d-none')) {
                if (revisionNotes && !revisionNotes.value.trim()) isValid = false;
            }

            if (isValid) {
                submitBtn.removeAttribute('disabled');
            } else {
                submitBtn.setAttribute('disabled', 'disabled');
            }
        }

        function validateProposalForm() {
            var fileInput = document.getElementById('proposalDocument');
            var errorDiv = document.getElementById('proposalFileError');
            if (fileInput && fileInput.files.length === 0) {
                errorDiv.classList.remove('d-none');
                return false; // Prevent form submission
            }
            errorDiv.classList.add('d-none');
            return true; // Allow form submission
        }

        function validateProgressForm(event) {
            var isValid = true;
            
            // Validate File
            var fileInput = document.getElementById('progressFiles');
            var fileErrorDiv = document.getElementById('progressFileError');
            if (fileInput && fileInput.files.length === 0) {
                fileErrorDiv.classList.remove('d-none');
                isValid = false;
            } else {
                fileErrorDiv.classList.add('d-none');
            }
            
            // Validate Dates
            var startDateInput = document.getElementById('progressStartDate');
            var endDateInput = document.getElementById('progressEndDate');
            var dateErrorDiv = document.getElementById('progressDateError');
            
            if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
                var start = new Date(startDateInput.value);
                var end = new Date(endDateInput.value);
                if (end < start) {
                    dateErrorDiv.classList.remove('d-none');
                    isValid = false;
                } else {
                    dateErrorDiv.classList.add('d-none');
                }
            } else {
                dateErrorDiv.classList.add('d-none');
            }

            // Turnitin Mock Scan
            var selectObj = document.getElementById('progressMilestoneSelect');
            if (isValid && selectObj) {
                var selectedText = selectObj.options[selectObj.selectedIndex].text;
                if (selectedText.includes("Turnitin")) {
                    if (event) event.preventDefault();
                    Swal.fire({
                        title: 'Turnitin AI Scanner',
                        html: '<div class="text-start mt-3 fw-semibold text-secondary" style="font-size:0.95rem;">' +
                              '<i class="fas fa-satellite-dish me-2 text-primary"></i>Connecting to Turnitin Core API...<br><br>' +
                              '<i class="fas fa-search me-2 text-info"></i>Scanning document for similarity...<br><br>' +
                              '<i class="fas fa-globe me-2 text-success"></i>Cross-referencing global databases...<br><br>' +
                              '<div class="progress mt-3"><div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: 100%"></div></div>' +
                              '</div>',
                        showConfirmButton: false,
                        allowOutsideClick: false,
                        timer: 4500
                    }).then(() => {
                        var randScore = Math.floor(Math.random() * 15) + 4; // 4% to 18%
                        Swal.fire({
                            title: 'Scan Complete!',
                            html: '<h2 class="text-success fw-bold mb-3">' + randScore + '%</h2><p class="mb-0 text-muted">Similarity Index (Acceptable)</p>',
                            icon: 'success',
                            confirmButtonText: 'Upload Report to Supervisor',
                            confirmButtonColor: '#10b981'
                        }).then((result) => {
                            if(result.isConfirmed) {
                                selectObj.form.submit();
                            }
                        });
                    });
                    return false; // Wait for sweetalert to finish
                }
            }

            return isValid;
        }

        function validateFinalForm() {
            var isValid = true;

            var fileInput = document.getElementById('finalDocument');
            var errorDiv = document.getElementById('finalFileError');
            if (fileInput && fileInput.files.length === 0) {
                errorDiv.classList.remove('d-none');
                isValid = false;
            } else {
                errorDiv.classList.add('d-none');
            }

            var turnitinInput = document.getElementById('turnitinDocument');
            var turnitinErrorDiv = document.getElementById('turnitinFileError');
            if (turnitinInput && turnitinInput.files.length === 0) {
                turnitinErrorDiv.classList.remove('d-none');
                isValid = false;
            } else if (turnitinErrorDiv) {
                turnitinErrorDiv.classList.add('d-none');
            }

            var ethicsInput = document.getElementById('ethicsDocument');
            var ethicsErrorDiv = document.getElementById('ethicsFileError');
            if (ethicsInput && ethicsInput.files.length === 0) {
                ethicsErrorDiv.classList.remove('d-none');
                isValid = false;
            } else {
                ethicsErrorDiv.classList.add('d-none');
            }

            const abstract = document.getElementById('finalAbstract');
            const abstractError = document.getElementById('finalAbstractError');
            if (abstract && abstract.value.trim().length < 50) {
                abstract.classList.add('is-invalid');
                abstractError.classList.remove('d-none');
                isValid = false;
            }

            const ack = document.getElementById('finalAck');
            const ackError = document.getElementById('finalAckError');
            if (ack && ack.value.trim() !== "" && ack.value.trim().length < 10) {
                ack.classList.add('is-invalid');
                ackError.classList.remove('d-none');
                isValid = false;
            }

            const repo = document.getElementById('finalRepo');
            const repoError = document.getElementById('finalRepoError');
            if (repo && repo.value.trim() !== "") {
                try {
                    new URL(repo.value.trim());
                } catch (_) {
                    repo.classList.add('is-invalid');
                    repoError.classList.remove('d-none');
                    isValid = false;
                }
            }

            return isValid;
        }

        document.addEventListener('MilestoneUpdateEvent', function(e) {
            const payload = e.detail;
            payload._handled = true;
            Swal.fire({
                title: payload.title,
                text: payload.message,
                icon: (payload.status === 'Approved') ? 'success' : 'info',
                showCancelButton: true,
                confirmButtonText: 'Refresh Page',
                cancelButtonText: 'Later'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.reload();
                }
            });
        });
    $('[id^="iafAttemptModal"]').appendTo('body');
    
    /* ===== IAF FORM VALIDATION ===== */
    (function () {
        const form = document.getElementById('iafFormElement');
        if (!form) return;

        const summary = document.getElementById('iafValidationSummary');
        const errorList = document.getElementById('iafValidationList');

        let attemptedSubmit = false;

        // Each rule applies only to the IAF form.
        const rules = [
            {
                selector: '[name="coventryId"]',
                label: 'Coventry ID',
                check: v => v ? '' : 'Coventry ID is required.'
            },
            {
                selector: '[name="title"]',
                label: 'Project Title',
                check: v => v ? '' : 'Project Title is required.'
            },
            {
                selector: '#scope',
                label: 'Scope of Project',
                check: v => v ? '' : 'Please select a project scope.'
            },
            {
                selector: '#problemStatement',
                label: 'Problem Statement',
                errorId: 'problemStatementError',
                check: v => {
                    if (v.length < 50) {
                        return 'Problem Statement must contain at least 50 characters.';
                    }

                    const hasCitation =
                        /\([^)]+,\s*(19|20)\d{2}\)|\[\d+\]/.test(v);

                    if (!hasCitation) {
                        return 'Please include an in-text citation, e.g. (Author, 2024) or [1].';
                    }

                    return '';
                }
            },
            {
                selector: '#objective1',
                label: 'Objective 1',
                errorId: 'objective1Error',
                check: v => {
                    if (v.length < 10 || v.split(/\s+/).length < 3) {
                        return 'Objective 1 requires at least 10 characters and 3 words.';
                    }
                    return '';
                }
            },
            {
                selector: '#objective2',
                label: 'Objective 2',
                errorId: 'objective2Error',
                check: v => {
                    if (v.length < 10 || v.split(/\s+/).length < 3) {
                        return 'Objective 2 requires at least 10 characters and 3 words.';
                    }
                    return '';
                }
            },
            {
                selector: '#objective3',
                label: 'Objective 3',
                errorId: 'objective3Error',
                check: v => {
                    // Objective 3 is optional in the existing form.
                    if (!v) return '';

                    if (v.length < 10 || v.split(/\s+/).length < 3) {
                        return 'Objective 3 requires at least 10 characters and 3 words when provided.';
                    }
                    return '';
                }
            }
        ];

        function checkField(rule, showFeedback) {
            const field = form.querySelector(rule.selector);
            if (!field || field.disabled || field.readOnly) return '';

            const message = rule.check(field.value.trim());

            field.setCustomValidity(message);

            if (showFeedback) {
                field.classList.toggle('is-invalid', !!message);
                field.classList.toggle(
                    'is-valid',
                    !message && field.value.trim().length > 0
                );

                if (rule.errorId) {
                    const error = document.getElementById(rule.errorId);
                    if (error) {
                        error.textContent = message;
                        error.classList.toggle('d-none', !message);
                    }
                }
            }

            return message;
        }

        function getErrors(showFeedback) {
            const errors = [];

            rules.forEach(rule => {
                const message = checkField(rule, showFeedback);
                if (message) {
                    errors.push({
                        rule: rule,
                        message: message
                    });
                }
            });

            return errors;
        }

        function renderSummary(errors) {
            if (!summary || !errorList) return;

            errorList.replaceChildren();

            errors.forEach(error => {
                const li = document.createElement('li');
                li.textContent = error.message;
                errorList.appendChild(li);
            });

            summary.classList.toggle('d-none', errors.length === 0);
        }

        // Real-time and blur validation.
        rules.forEach(rule => {
            const field = form.querySelector(rule.selector);
            if (!field) return;

            function revalidate() {
                checkField(rule, attemptedSubmit || field.dataset.touched === '1');

                if (attemptedSubmit) {
                    renderSummary(getErrors(true));
                }
            }

            field.addEventListener('input', revalidate);
            field.addEventListener('change', revalidate);

            field.addEventListener('blur', function () {
                field.dataset.touched = '1';
                revalidate();
            });
        });

        // Validate only formal IAF submissions.
        // Keep Save Draft and other workflow actions unchanged.
        form.addEventListener('submit', function (event) {
            const submitter = event.submitter;
            const action = submitter?.name === 'iafAction'
                ? submitter.value
                : '';

            if (!['supervisor_review', 'submit', 'submit_new'].includes(action)) {
                return;
            }

            attemptedSubmit = true;

            const errors = getErrors(true);
            renderSummary(errors);

            if (errors.length > 0 || !form.checkValidity()) {
                event.preventDefault();

                if (errors.length > 0) {
                    const firstField = form.querySelector(
                        errors[0].rule.selector
                    );

                    if (firstField) {
                        firstField.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });

                        firstField.focus({ preventScroll: true });
                    }
                } else {
                    form.querySelector(':invalid')?.focus();
                }
            }

            // If valid, existing submission handling continues.
        }, true);
    })();


    </script>
