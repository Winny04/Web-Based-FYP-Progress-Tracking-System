@using FYPTracker.Models
@inject FYPTrackerContext _context
@model FYPProject?
@inject FYPTracker.Services.Forms.IafFormTemplateService IafTemplateService
@{
    ViewData["Title"] = "Digital Submission Forms";
    var currentUser = ViewBag.CurrentUser as ApplicationUser;
    var milestones  = Model?.Milestones?.ToList() ?? new List<FYPMilestone>();
    var adminUser = _context.ApplicationUsers.FirstOrDefault(u => u.UserRoles.Any(r => r.Role.Name == "Admin"));
    var moduleLeaderName = adminUser?.FullName ?? "Admin";
    var iafTemplate = await IafTemplateService.LoadAsync();

    string IafLabel(string key, string fallback)
    {
        return iafTemplate.Fields
            .FirstOrDefault(f => f.Key == key)?.Label
            ?? fallback;
    }
}

<style>
    :root {
        --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }
    
    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .premium-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid rgba(249, 115, 22, 0.1);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        font-size: 0.9rem;
        padding: 9px 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #334155;
        box-shadow: 0 0 0 3px rgba(51, 65, 85, 0.15);
    }



    .btn-submit {
        background: #1e293b;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 700;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: scale(1.03);
        color: white;
    }
    
    .btn-draft {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
        transition: background-color 0.2s;
    }
    
    .btn-draft:hover {
        background-color: #e2e8f0;
    }

    .form-section-title {
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        color: var(--primary-orange);
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 8px;
        margin-bottom: 20px;
    }

    /* Wizard Stepper Styles */
    .wizard-stepper {
        display: flex;
        justify-content: space-between;
        background: #fff;
        border-radius: 12px;
        padding: 10px 0;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
        margin-bottom: 16px;
        position: relative;
    }
    .stepper-item {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 2;
    }
    .stepper-item:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 20px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e5e7eb;
        z-index: -1;
    }
    .stepper-btn {
        background: transparent !important;
        border: none !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        color: #6b7280;
        transition: all 0.3s;
        padding: 0;
    }
    .stepper-btn:disabled {
        pointer-events: none;
        opacity: 0.6;
    }
    .stepper-btn.active .step-icon {
        background: var(--hero-grad);
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(30,41,59,0.3);
    }
    .stepper-btn.active .step-text {
        color: #1e293b;
        font-weight: 700;
    }
    .step-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        margin-bottom: 4px;
        transition: all 0.3s;
        pointer-events: none;
    }
    .step-text { font-size: 0.85rem; font-weight: 600; margin-top: 4px; pointer-events: none; }
    .stepper-btn:hover:not([disabled]) .step-icon { border-color: #f97316; color: #f97316; }

    /* ===== IAF Card ===== */
    .iaf-main-card {
        border-radius: 12px !important;
    }

    /* IAF heading */
    .iaf-main-card .iaf-card-heading {
        padding-bottom: 16px;
        margin-bottom: 20px;
        border-bottom: 1px solid #e2e8f0;
    }

    /* Form table */
    .iaf-main-card .iaf-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 12px;
        margin-bottom: 16px;
    }

    /* Compact table cells */
    .iaf-main-card .iaf-table td {
        padding: 12px 14px;
        vertical-align: middle;
        border-color: #e2e8f0;
    }

    /* Left label column */
    .iaf-main-card .iaf-table .iaf-label {
        width: 30%;
        background-color: #f8fafc;
        color: #334155;
        font-weight: 700;
    }

    /* Right value column */
    .iaf-main-card .iaf-table .iaf-value {
        width: 70%;
        white-space: normal;
    }

    /* Inputs */
    .iaf-main-card .iaf-table .form-control,
    .iaf-main-card .iaf-table .form-select {
        min-height: 40px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
    }

    /* Problem Statement */
    .iaf-main-card .iaf-table textarea.form-control {
        min-height: 140px;
        resize: vertical;
    }

    /* Preserve formatting in history modal */
    .iaf-main-card .iaf-readonly-view .iaf-value {
        white-space: pre-wrap;
    }

    /* Action footer */
    .iaf-main-card .iaf-action-footer {
        border-radius: 0 0 12px 12px;
    }

    /* IAF primary submission button */
    .iaf-main-card #iafFormElement button[name="iafAction"][value="supervisor_review"] {
        background-color: #0f172a;
        border-color: #0f172a;
        color: #ffffff;
        border-radius: 8px;
    }

    .iaf-main-card #iafFormElement button[name="iafAction"][value="supervisor_review"]:hover {
        background-color: #1e293b;
        border-color: #1e293b;
        color: #ffffff;
    }

    /* ===== IAF Student Information ===== */
    .iaf-main-card .iaf-student-info {
        padding: 16px;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .iaf-main-card .iaf-student-info .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }

    .iaf-main-card .iaf-info-value {
        min-height: 42px;
        display: flex;
        align-items: center;
        padding: 10px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background-color: #f8fafc;
        color: #1e293b;
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    /* Match editable Coventry ID field */
    .iaf-main-card .iaf-student-info .form-control {
        min-height: 42px;
        border-radius: 8px;
    }

    /* Mobile responsiveness */
    @@media (max-width: 767.98px) {
        .iaf-main-card .iaf-student-info {
            padding: 12px;
        }
    }

    /* ===== IAF MOBILE RESPONSIVENESS ===== */

    @@media screen and (max-width: 767.98px) {

        /* Stack label and input vertically */
        .iaf-main-card .iaf-form-table,
        .iaf-main-card .iaf-form-table tbody,
        .iaf-main-card .iaf-form-table tr,
        .iaf-main-card .iaf-form-table td {
            display: block;
            width: 100% !important;
        }

        .iaf-main-card .iaf-form-table tr {
            margin-bottom: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            overflow: hidden;
        }

        /* Field labels */
        .iaf-main-card .iaf-form-table td.iaf-label {
            width: 100% !important;
            padding: 10px 12px;
            border: 0;
            border-bottom: 1px solid #e2e8f0;
        }

        /* Input container */
        .iaf-main-card .iaf-form-table td.iaf-value {
            width: 100% !important;
            padding: 12px;
            border: 0;
            overflow-wrap: anywhere;
        }

        /* Prevent input overflow */
        .iaf-main-card .iaf-form-table .form-control,
        .iaf-main-card .iaf-form-table .form-select {
            max-width: 100%;
            min-width: 0;
        }

        /* Objective input group */
        .iaf-main-card .iaf-form-table .input-group {
            width: 100%;
            flex-wrap: nowrap;
        }

        .iaf-main-card .iaf-form-table .input-group .form-control {
            min-width: 0;
            flex: 1 1 auto;
        }

        /* Action footer */
        .iaf-main-card .iaf-action-footer > .d-flex {
            flex-direction: column;
            align-items: stretch !important;
        }

        .iaf-main-card .iaf-action-footer > .d-flex > .d-flex {
            flex-direction: column;
            width: 100%;
        }

        .iaf-main-card .iaf-action-footer button {
            width: 100%;
        }

        /* IAF Attempt History */
        .iaf-main-card .iaf-attempt-card {
            flex-direction: column;
            align-items: stretch;
        }

        .iaf-main-card .iaf-attempt-card > .d-flex {
            flex-wrap: wrap;
        }

        /* Wizard Stepper */
        .wizard-stepper .stepper-item {
            min-width: 0;
        }

        .wizard-stepper .step-text {
            font-size: 0.72rem;
            line-height: 1.35;
            text-align: center;
            white-space: normal;
            overflow-wrap: anywhere;
            padding: 0 4px;
        }
    }
</style>

<div class="container-xxl py-4">

    <!-- Welcome Header (Navy-blue matching Dashboard) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background-color: #0f172a; color: white;">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bolder mb-1"><i class="fas fa-file-contract me-2"></i>Digital Submission Forms</h4>
                <p class="mb-0 text-white-50 fs-7 fw-bold">Fill and submit your academic milestones digitally. Status updates are pushed instantly to your supervisor.</p>
            </div>
        </div>
    </div>

    @if (Model == null)
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center">
            <i class="fas fa-exclamation-triangle text-warning fs-1 mb-4 d-block"></i>
            <h4 class="fw-bold text-dark">No Active Project</h4>
            <p class="text-muted mb-0">Please request a supervisor and secure an active project before submitting academic forms.</p>
        </div>
    }
    else
    {
        var iafMilestone = milestones.FirstOrDefault(m => (m.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || m.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)) && !m.Title.Contains("Industrial", StringComparison.OrdinalIgnoreCase));
        bool isIafApproved = iafMilestone != null && iafMilestone.Status == "AdminApproved";
        int iafMilestoneId = iafMilestone?.Id ?? 0;
        bool isIafLocked = iafMilestone != null && (iafMilestone.Status == "PendingSupervisorReview" || iafMilestone.Status == "SupervisorSigned" || iafMilestone.Status == "PendingPanelReview" || iafMilestone.Status == "AdminApproved");

        var proposalMilestone = milestones.FirstOrDefault(m => m.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase));
        bool isProposalApproved = proposalMilestone != null && proposalMilestone.Status == "Approved";
        
        var stage2Milestones = milestones.Where(m => m.Title.StartsWith("Step", StringComparison.OrdinalIgnoreCase)).ToList();

        // DPP Work & Progress: ONLY Supervisor-added Stage 1 milestones (persistent DB classification)
        var allProgressMilestones = milestones.Where(m => m.MilestoneSource == "Supervisor" && m.Stage == 1).ToList();
            
        // Must have at least one supervisor milestone AND all must be completed
        bool hasProgressMilestones = allProgressMilestones.Any();
        bool isAllProgressCompleted = hasProgressMilestones && allProgressMilestones.All(m => m.Status == "Completed");

        // NEW: Stage 2 unlock logic depends on Stage1Grade == "Pass"
        bool isStage2Unlocked = Model?.Stage1Grade == "Pass";
        bool isStage1Failed = Model?.Stage1Grade == "Fail";

        string iafTooltip = isIafApproved ? "data-toggle=\"tooltip\" title=\"IAF Form has been approved and locked\"" : "";
        
        string progressTooltip = "";
        if (!isIafApproved) progressTooltip = "data-toggle=\"tooltip\" title=\"Requires IAF Approval first\"";
        else if (isAllProgressCompleted && allProgressMilestones.Any()) progressTooltip = "data-toggle=\"tooltip\" title=\"All DPP progress milestones are completed\"";

        string proposalTooltip = "";
        if (!isIafApproved || !isAllProgressCompleted) proposalTooltip = "data-toggle=\"tooltip\" title=\"Requires IAF approval and all DPP progress milestones to be completed first\"";
        else if (isProposalApproved) proposalTooltip = "data-toggle=\"tooltip\" title=\"Proposal Form has been approved and locked\"";

        string finalTooltip = "";
        if (!isAllProgressCompleted) finalTooltip = "data-toggle=\"tooltip\" title=\"Requires all DPP progress milestones to be completed by Supervisor\"";

        <div class="row g-4">
            
            @* -- STAGE 1 STATUS BANNER ------------------------ *@
            @if (isStage1Failed)
            {
                <div class="col-12 mb-2">
                    <div class="alert alert-warning d-flex justify-content-between align-items-center shadow-sm" role="alert" style="border-left: 5px solid #f59e0b;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle fs-3 me-3 text-warning"></i>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1 text-dark">Stage 1 Failed (Repeat Required)</h5>
                                <p class="mb-0 text-dark">You have failed Stage 1. However, you are permitted to proceed to Stage 2 concurrently while you retake Stage 1.</p>
                            </div>
                        </div>
                        <div>
                            <a href="@Url.Action("Stage2", "Student")" class="btn btn-warning btn-lg shadow-sm fw-bold rounded-pill px-4 text-dark">
                                Proceed to Stage 2 <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
            else if (isStage2Unlocked)
            {
                <div class="col-12 mb-2">
                    <div class="alert alert-success d-flex justify-content-between align-items-center shadow-sm" role="alert" style="border-left: 5px solid #10b981;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle fs-3 me-3 text-success"></i>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1 text-success">Stage 1 Passed!</h5>
                                <p class="mb-0 text-dark">Congratulations! You have successfully passed Stage 1. You may now proceed to Stage 2.</p>
                            </div>
                        </div>
                        <div>
                            <a href="@Url.Action("Stage2", "Student")" class="btn btn-success btn-lg shadow-sm fw-bold rounded-pill px-4">
                                Proceed to Stage 2 <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @* -- WIZARD STEPPER (Navigation) ------------------ *@
            @if (!isStage2Unlocked)
            {
                <div class="col-12">
                    <ul class="wizard-stepper nav nav-pills m-0 p-0" style="list-style: none;" id="forms-tab" role="tablist">
                        <li class="stepper-item nav-item" role="presentation" tabindex="0" @Html.Raw(iafTooltip)>
                            <button class="stepper-btn nav-link @(!isIafApproved && !isProposalApproved && !isAllProgressCompleted ? "active" : "")" id="iaf-form-tab" data-toggle="pill" data-target="#iaf-form-pane" type="button" role="tab">
                                <div class="step-icon"><i class="fas fa-clipboard-list"></i></div>
                                <div class="step-text">1. IAF Form</div>
                            </button>
                        </li>
                        <li class="stepper-item nav-item" role="presentation" tabindex="0" @Html.Raw(progressTooltip)>
                            <button class="stepper-btn nav-link @(isIafApproved && !isAllProgressCompleted ? "active" : "")" id="progress-form-tab" data-toggle="pill" data-target="#progress-form-pane" type="button" role="tab" @(!isIafApproved ? "disabled" : "") style="@(!isIafApproved ? "pointer-events: none;" : "")">
                                <div class="step-icon"><i class="fas fa-tasks"></i></div>
                                <div class="step-text">A. DPP Work & Progress</div>
                            </button>
                        </li>
                        <li class="stepper-item nav-item" role="presentation" tabindex="0" @Html.Raw(proposalTooltip)>
                            <button class="stepper-btn nav-link @(isIafApproved && isAllProgressCompleted && !isProposalApproved ? "active" : "")" id="proposal-form-tab" data-toggle="pill" data-target="#proposal-form-pane" type="button" role="tab" @(!isIafApproved || !isAllProgressCompleted ? "disabled" : "") style="@(!isIafApproved || !isAllProgressCompleted ? "pointer-events: none;" : "")">
                                <div class="step-icon"><i class="fas fa-feather-alt"></i></div>
                                <div class="step-text">B. Stage 1 Required Submissions</div>
                            </button>
                        </li>
                        <!-- Stage 2 is now a separate page, Final Submission tab removed -->
                    </ul>

                    <div class="card border-0 shadow-sm rounded-3 p-3 mb-2 bg-light d-flex flex-row align-items-start gap-2">
                        <i class="fas fa-info-circle text-primary fs-5 mt-1 flex-shrink-0"></i>
                        <div class="small text-muted">
                            <strong>Guidelines:</strong> Ensure all mandatory fields are fully populated before submission. 
                            <span class="text-success fw-bold"><i class="fas fa-save ms-2 me-1"></i>Auto-Save is active.</span> Your progress is automatically stored locally in your browser.
                        </div>
                    </div>
                </div>
            }

            @* -- FORM DETAILED PANES ------------------------------ *@
            @if (!isStage2Unlocked)
            {
                <div class="col-12">
                <style>
                    #forms-tabContent > .tab-pane {
                        display: none;
                    }

                    #forms-tabContent > .tab-pane.active {
                        display: block !important;
                        opacity: 1 !important;
                    }
                </style>
                <div class="tab-content" id="forms-tabContent">

                    @* -- 1. INITIAL PROJECT ALLOCATION FORM (IAF) -------- *@
                    <div class="tab-pane fade @(isIafApproved ? "" : "show active")" id="iaf-form-pane" role="tabpanel" tabindex="0">
                        <div class="card border-0 shadow-sm rounded-3 p-3 p-md-4 iaf-main-card">
                            <div class="iaf-card-heading">
                                <h4 class="fw-bold text-dark mb-2">
                                    <i class="fas fa-clipboard-list text-primary me-2"></i>
                                    1. Initial Project Allocation Form (IAF)
                                </h4>

                                <p class="text-danger fw-semibold mb-0">
                                    <i class="far fa-clock me-1"></i>
                                    Please complete and submit this form before @ViewBag.IAFDeadline.
                                </p>
                            </div>
                            
                            @if (isIafLocked)
                            {
                                if (iafMilestone?.Status == "DefenseScheduled")
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger mb-4">
                                        <i class="fas fa-gavel fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">IAF Rejected by Admin (Defense Required)</h5>
                                            <p class="mb-0 text-muted">The administrator has rejected your approved IAF and mandated a defense session.</p>
                                            
                                            @if (iafMilestone.DefenseDate.HasValue)
                                            {
                                                <div class="mt-3 p-3 bg-white rounded border border-danger">
                                                    <h6 class="fw-bold text-danger mb-2">Your Scheduled Session:</h6>
                                                    <ul class="mb-0 text-dark fw-bold ps-3">
                                                        <li>Date: @iafMilestone.DefenseDate.Value.ToString("dd MMM yyyy")</li>
                                                        <li>Time: @iafMilestone.DefenseTime</li>
                                                        <li>Venue: 
                                                            @if (!string.IsNullOrEmpty(iafMilestone.DefenseVenue) && iafMilestone.DefenseVenue.Contains("http"))
                                                            {
                                                                <a href="@iafMilestone.DefenseVenue.Substring(iafMilestone.DefenseVenue.IndexOf("http"))" target="_blank" class="text-primary text-decoration-underline">Join Online Defense Meeting</a>
                                                            }
                                                            else
                                                            {
                                                                @iafMilestone.DefenseVenue
                                                            }
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    string displayStatus = iafMilestone.Status;
                                    string alertColor = "info";
                                    string icon = "fa-lock";
                                    
                                    if(iafMilestone.Status == "Approved") {
                                        displayStatus = "Approved by Supervisor, Pending Admin";
                                        alertColor = "warning";
                                        icon = "fa-hourglass-half";
                                    } else if (iafMilestone.Status == "SupervisorSigned") {
                                        displayStatus = "Supervisor Signed, Pending Admin View";
                                        alertColor = "warning";
                                        icon = "fa-hourglass-half";
                                    } else if (iafMilestone.Status == "AdminApproved") {
                                        displayStatus = "Fully Approved";
                                        alertColor = "success";
                                        icon = "fa-check-circle";
                                    }

                                    <div class="alert alert-@alertColor d-flex align-items-center mt-3 border-@alertColor mb-4 shadow-sm">
                                        <i class="fas @icon fs-2 me-3 text-@alertColor"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">IAF Form Status</h5>
                                            <p class="mb-0 text-muted">Your Initial Project Allocation Form has been submitted. Current Status: <span class="badge bg-white text-dark ms-1 shadow-sm border">@displayStatus</span></p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                @if (iafMilestone != null && (iafMilestone.Status == "Rejected" || iafMilestone.Status == "ReturnedForEdits"))
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger mb-4">
                                        <i class="fas fa-times-circle fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">IAF Returned for Edits</h5>
                                            <p class="mb-0 text-muted"><strong>Feedback:</strong> @iafMilestone.SupervisorFeedback</p>
                                        </div>
                                    </div>
                                }
                                else if (iafMilestone != null && iafMilestone.Status == "PanelRevisionRequired")
                                {
                                    string panelComments = "No comments provided.";
                                    if (!string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: "))
                                    {
                                        try {
                                            var history = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None)[1]);
                                            var currentAttempt = history.Attempts.FirstOrDefault(a => a.AttemptNumber == history.CurrentAttempt);
                                            if (currentAttempt != null && !string.IsNullOrEmpty(currentAttempt.PanelComments)) {
                                                panelComments = currentAttempt.PanelComments;
                                            }
                                        } catch {}
                                    }

                                    <div class="alert alert-warning d-flex align-items-center mt-3 border-warning mb-4">
                                        <i class="fas fa-exclamation-triangle fs-2 me-3 text-warning"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Panel Revision Required</h5>
                                            <p class="mb-0 text-muted">Please update your IAF based on the panel's comments.</p>
                                            <div class="mt-2 p-2 bg-white rounded border border-warning">
                                                <strong>Panel Comments:</strong> @panelComments
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (iafMilestone != null && iafMilestone.Status == "ChangeOfTopicRequired")
                                {
                                    string panelComments = "No comments provided.";
                                    if (!string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: "))
                                    {
                                        try {
                                            var history = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None)[1]);
                                            var currentAttempt = history.Attempts.FirstOrDefault(a => a.AttemptNumber == history.CurrentAttempt);
                                            if (currentAttempt != null && !string.IsNullOrEmpty(currentAttempt.PanelComments)) {
                                                panelComments = currentAttempt.PanelComments;
                                            }
                                        } catch {}
                                    }

                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger mb-4">
                                        <i class="fas fa-sync fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Defense Failed - Change of Topic Required</h5>
                                            <p class="mb-0 text-muted">You must submit a new Initial Allocation Form with a different topic.</p>
                                            <div class="mt-2 p-2 bg-white rounded border border-danger">
                                                <strong>Feedback:</strong> @panelComments
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                                
                                <form id="iafFormElement" asp-action="SubmitDigitalForm" method="post" class="needs-validation" novalidate>
                                    <input type="hidden" name="formType" value="Initial Project Allocation Form (IAF)" />
                                    <input type="hidden" name="milestoneId" value="@iafMilestoneId" />
                                    
                                    <!-- IAF Validation Summary -->
                                    <div id="iafValidationSummary"
                                        class="alert alert-danger border-danger d-none mb-4"
                                        role="alert"
                                        tabindex="-1">

                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fas fa-exclamation-circle fs-4 mt-1"></i>

                                            <div>
                                                <h6 class="fw-bold mb-2">
                                                    Please review your IAF form
                                                </h6>
                                                <p class="mb-2 small">
                                                    Correct the following fields before submitting.
                                                </p>
                                                <ul id="iafValidationList" class="mb-0 small ps-3"></ul>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="card mb-0 border-0 shadow-none iaf-document-card">
                                        <div class="card-body p-2 p-md-3" style="font-family: Arial, sans-serif; font-size: 14px; color: #000;">
                                            <h2 class="text-center fw-bold mb-1"
                                                style="font-size: 18px;">
                                                @iafTemplate.Title
                                            </h2>

                                            <p class="text-center text-muted small mb-4">
                                                Template Version @iafTemplate.Version
                                            </p>
                                            
                                            <style>
                                                .iaf-table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px; }
                                                .iaf-table, .iaf-table th, .iaf-table td { border: 1px solid #ccc; }
                                                .iaf-table th, .iaf-table td { padding: 8px; vertical-align: top; text-align: left; }
                                                .iaf-label { font-weight: bold; width: 30%; }
                                                .iaf-value { width: 70%; white-space: normal; }
                                                .iaf-attempt-card { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; padding: 12px 16px; border: 1px solid #e4e6ef; background-color: #fff; border-radius: 10px; transition: box-shadow .2s ease, transform .2s ease; }
                                                .iaf-attempt-card:hover { box-shadow: 0 4px 14px rgba(13,110,253,0.10); transform: translateY(-1px); }
                                                .iaf-attempt-card .iaf-attempt-title { font-weight: 700; color: #0d6efd; margin: 0; }
                                                .iaf-attempt-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 12px; }
                                                .iaf-readonly-view .iaf-value { background: #fff; white-space: pre-wrap }
                                                @@media print {
                                                    .iaf-attempt-card { box-shadow: none; }
                                                }
                                            </style>

                                            @* Unified IAF: use current Admin JSON for all 11 fields. *@
                                            @{
                                                var requiredIafKeys = new[]
                                                {
                                                    "StudentName", "CoventryId", "Program", "ProjectTitle",
                                                    "ScopeOfProject", "ProblemStatement", "References",
                                                    "Objectives", "SupervisorName", "SupervisorSignature",
                                                    "CommentFeedback"
                                                };
                                                var orderedIafFields = iafTemplate.Fields
                                                    .OrderBy(f => f.Order)
                                                    .ToList();
                                                if (requiredIafKeys.Any(k => orderedIafFields.Count(f => f.Key == k) != 1)
                                                    || orderedIafFields.Count != requiredIafKeys.Length)
                                                {
                                                    throw new InvalidOperationException(
                                                        "The IAF template must contain the expected 11 unique fields.");
                                                }

                                                string iafReferences = "";
                                                string agreedSup = "";
                                                string supervisorSignature = "";
                                                string supervisorFeedback = iafMilestone?.SupervisorFeedback ?? "";

                                                if (!string.IsNullOrEmpty(iafMilestone?.Remarks)
                                                    && iafMilestone.Remarks.Contains("JSON: "))
                                                {
                                                    try
                                                    {
                                                        var rawHistory = iafMilestone.Remarks.Split(
                                                            new[] { "JSON: " }, 2, StringSplitOptions.None)[1];
                                                        var historyForFields = IafAttemptHistory.ParseOrMigrate(rawHistory);
                                                        var currentAttemptForFields = historyForFields.Attempts
                                                            .FirstOrDefault(a => a.AttemptNumber == historyForFields.CurrentAttempt);
                                                        if (currentAttemptForFields != null)
                                                        {
                                                            var data = currentAttemptForFields.FormData
                                                                ?? new Dictionary<string, string>();
                                                            if (!data.TryGetValue("references", out iafReferences))
                                                                data.TryGetValue("References", out iafReferences);
                                                            if (!data.TryGetValue("agreedSupervisor", out agreedSup))
                                                                data.TryGetValue("Agreed Supervisor Name", out agreedSup);
                                                            supervisorSignature = currentAttemptForFields.SupervisorSignature ?? "";
                                                            if (!string.IsNullOrWhiteSpace(currentAttemptForFields.SupervisorFeedback))
                                                                supervisorFeedback = currentAttemptForFields.SupervisorFeedback;
                                                        }
                                                    }
                                                    catch (Exception)
                                                    {
                                                        // Preserve existing editable project fields if old history cannot be parsed.
                                                    }
                                                }
                                                iafReferences ??= "";
                                                agreedSup ??= "";

                                                var cleanObj1 = Model.Objective1?.StartsWith("1. To ", StringComparison.OrdinalIgnoreCase) == true
                                                    ? Model.Objective1.Substring(6).TrimStart() : Model.Objective1;
                                                var cleanObj2 = Model.Objective2?.StartsWith("2. To ", StringComparison.OrdinalIgnoreCase) == true
                                                    ? Model.Objective2.Substring(6).TrimStart() : Model.Objective2;
                                                var cleanObj3 = Model.Objective3?.StartsWith("3. To ", StringComparison.OrdinalIgnoreCase) == true
                                                    ? Model.Objective3.Substring(6).TrimStart() : Model.Objective3;
                                            }

                                            <div class="row g-3 mb-4" id="iafJsonFields">
                                                @foreach (var field in orderedIafFields)
                                                {
                                                    int width = field.Columns >= 1 && field.Columns <= 12
                                                        ? field.Columns : 12;
                                                    int textAreaHeight = field.MinHeightMm > 0 ? field.MinHeightMm : 30;

                                                    <div class="col-12 col-md-@(width)" data-field-key="@field.Key">
                                                        <div class="form-label fw-semibold mb-2">@field.Label</div>

                                                        @if (field.Key == "StudentName")
                                                        {
                                                            <div class="iaf-info-value">@currentUser?.FullName</div>
                                                        }
                                                        else if (field.Key == "CoventryId")
                                                        {
                                                            <input type="text" id="iafCoventryId" name="coventryId"
                                                                   class="form-control @(isIafLocked ? "bg-light border-0 fw-bold" : "")"
                                                                   value="@currentUser?.CoventryId"
                                                                   @(isIafLocked ? "readonly" : "") required />
                                                        }
                                                        else if (field.Key == "Program")
                                                        {
                                                            <div class="iaf-info-value">@(string.IsNullOrWhiteSpace(currentUser?.Programme) ? "Not configured" : currentUser.Programme)</div>
                                                        }
                                                        else if (field.Key == "ProjectTitle")
                                                        {
                                                            <input type="text" id="iafProjectTitle" name="title"
                                                                   class="form-control @(isIafLocked ? "bg-light border-0 fw-bold" : "")"
                                                                   value="@Model.Title" @(isIafLocked ? "readonly" : "") required />
                                                        }
                                                        else if (field.Key == "ScopeOfProject")
                                                        {
                                                            <select name="scope" id="scope"
                                                                    class="form-select @(isIafLocked ? "bg-light border-0 fw-bold" : "")"
                                                                    @(isIafLocked ? "disabled" : "") required>
                                                                <option value="">-- Select Scope --</option>
                                                                <option value="Development" selected="@(Model.Scope == "Development")">Development</option>
                                                                <option value="Research Based Project" selected="@(Model.Scope == "Research Based Project")">Research Based Project</option>
                                                                <option value="Hybrid" selected="@(Model.Scope == "Hybrid")">Hybrid</option>
                                                            </select>
                                                        }
                                                        else if (field.Key == "ProblemStatement")
                                                        {
                                                            <textarea name="problemStatement" id="problemStatement"
                                                                      class="form-control @(isIafLocked ? "bg-light border-0" : "")"
                                                                      rows="5" style="min-height:@(textAreaHeight)mm;"
                                                                      @(isIafLocked ? "readonly" : "") required
                                                                      placeholder="Provide a problem statement supported with statistics and journal paper references...">@Model.ProblemStatement</textarea>
                                                            <div id="problemStatementError" class="text-danger small mt-1 d-none"
                                                                 role="status">Please include in-text citations.</div>
                                                        }
                                                        else if (field.Key == "References")
                                                        {
                                                            <textarea name="references" id="iafReferences"
                                                                      class="form-control @(isIafLocked ? "bg-light border-0" : "")"
                                                                      rows="4" style="min-height:@(textAreaHeight)mm;"
                                                                      @(isIafLocked ? "readonly" : "")
                                                                      placeholder="List the references used in your IAF.">@iafReferences</textarea>
                                                        }
                                                        else if (field.Key == "Objectives")
                                                        {
                                                            <div class="d-grid gap-3">
                                                                <div>
                                                                    <label class="form-label small" for="objective1">Objective 1 (required)</label>
                                                                    <div class="input-group">
                                                                        <span class="input-group-text">1. To</span>
                                                                        <input type="text" name="objective1" id="objective1"
                                                                               class="form-control @(isIafLocked ? "bg-light" : "")"
                                                                               value="@cleanObj1" @(isIafLocked ? "readonly" : "")
                                                                               placeholder="develop a system..." required />
                                                                    </div>
                                                                    <div id="objective1Error" class="text-danger small mt-1 d-none" role="status"></div>
                                                                </div>
                                                                <div>
                                                                    <label class="form-label small" for="objective2">Objective 2 (required)</label>
                                                                    <div class="input-group">
                                                                        <span class="input-group-text">2. To</span>
                                                                        <input type="text" name="objective2" id="objective2"
                                                                               class="form-control @(isIafLocked ? "bg-light" : "")"
                                                                               value="@cleanObj2" @(isIafLocked ? "readonly" : "")
                                                                               placeholder="analyse the requirements..." required />
                                                                    </div>
                                                                    <div id="objective2Error" class="text-danger small mt-1 d-none" role="status"></div>
                                                                </div>
                                                                <div>
                                                                    <label class="form-label small" for="objective3">Objective 3 (optional)</label>
                                                                    <div class="input-group">
                                                                        <span class="input-group-text">3. To</span>
                                                                        <input type="text" name="objective3" id="objective3"
                                                                               class="form-control @(isIafLocked ? "bg-light" : "")"
                                                                               value="@cleanObj3" @(isIafLocked ? "readonly" : "")
                                                                               placeholder="evaluate the results..." />
                                                                    </div>
                                                                    <div id="objective3Error" class="text-danger small mt-1 d-none" role="status"></div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (field.Key == "SupervisorName")
                                                        {
                                                            <input type="text" id="iafSupervisorName" name="supervisorName"
                                                                   class="form-control @(isIafLocked ? "bg-light" : "")"
                                                                   value="@agreedSup" @(isIafLocked ? "readonly" : "")
                                                                   placeholder="Optional - only if previously agreed" />
                                                        }
                                                        else if (field.Key == "SupervisorSignature")
                                                        {
                                                            <div class="iaf-info-value" style="min-height:@(textAreaHeight)mm;">
                                                                @if (supervisorSignature.StartsWith("data:image/png;base64,", StringComparison.OrdinalIgnoreCase)
                                                                    || supervisorSignature.StartsWith("data:image/jpeg;base64,", StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    <img src="@supervisorSignature" alt="Supervisor signature"
                                                                         style="max-width:250px;max-height:80px;" />
                                                                }
                                                                else if (!string.IsNullOrWhiteSpace(supervisorSignature))
                                                                {
                                                                    <span>@supervisorSignature</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">Pending supervisor signature</span>
                                                                }
                                                            </div>
                                                        }
                                                        else if (field.Key == "CommentFeedback")
                                                        {
                                                           <div class="iaf-feedback-display @(string.IsNullOrWhiteSpace(supervisorFeedback) ? "text-muted fst-italic" : "")"
                                                            style="min-height:@(textAreaHeight)mm;">@(string.IsNullOrWhiteSpace(supervisorFeedback) ? "No feedback yet." : supervisorFeedback.Trim())</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                    @{
                                        string parsedJson = "";
                                        if (iafMilestone != null && !string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: "))
                                        {
                                            var parts = iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None);
                                            parsedJson = parts[1];
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(parsedJson))
                                    {
                                        <div class="mb-4 mt-4">
                                            <h6 class="fw-bold text-primary mb-3">IAF Attempt History</h6>
                                            @{
                                                try {
                                                    var history = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(parsedJson);
                                                    foreach (var attempt in history.Attempts.OrderByDescending(a => a.AttemptNumber)) {
                                                        var snapshotFile = iafMilestone.SubmissionFiles?.FirstOrDefault(f => f.AttemptNumber == attempt.AttemptNumber && f.FileName.StartsWith("Signed IAF"));
                                                        var fd = attempt.FormData ?? new Dictionary<string, string>();
                                                        string Fv(string k) => fd.TryGetValue(k, out var v) ? v : "";
                                                        var isSigned = !string.IsNullOrEmpty(attempt.SupervisorSignature);
                                                        var modalId = $"iafAttemptModal{attempt.AttemptNumber}";
                                                        var attStatus = string.IsNullOrEmpty(attempt.Status) ? "Pending" : attempt.Status;
                                                        var statusBadge = attStatus switch {
                                                            "Approved" or "AdminApproved" => "badge-light-success",
                                                            "Rejected" or "PanelRevisionRequired" or "ChangeOfTopicRequired" => "badge-light-danger",
                                                            "Draft" => "badge-light-secondary",
                                                            _ => "badge-light-warning"
                                                        };

                                                        <div class="iaf-attempt-card" id="iafAttemptCard@(attempt.AttemptNumber)">
                                                            <div>
                                                                <p class="iaf-attempt-title">Attempt @attempt.AttemptNumber @(attempt.AttemptNumber == history.CurrentAttempt ? "(Latest)" : "")</p>
                                                                <div class="iaf-attempt-meta mt-1">
                                                                    <span class="badge @statusBadge">@attStatus</span>
                                                                    @if (isSigned) {
                                                                        <span class="badge badge-light-success"><i class="fas fa-signature me-1 text-success"></i>Supervisor Signed</span>
                                                                    } else {
                                                                        <span class="badge badge-light-secondary"><i class="fas fa-hourglass-half me-1"></i>Not Signed</span>
                                                                    }
                                                                    <span class="text-muted"><i class="far fa-calendar me-1"></i>Reviewed: @(attempt.SupervisorReviewedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "�")</span>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex gap-2">
                                                                <button type="button" class="btn btn-sm btn-light-primary" id="btnViewIaf@(attempt.AttemptNumber)" data-toggle="modal" data-target="#@modalId"><i class="fas fa-eye me-1"></i>View IAF</button>
                                                                @if (snapshotFile != null) {
                                                                    <a class="btn btn-sm btn-light" id="btnDownloadIaf@(attempt.AttemptNumber)" href="@Url.Action("DownloadFile", "Student", new { fileId = snapshotFile.Id })"><i class="fas fa-download me-1"></i>Download PDF</a>
                                                                }
                                                            </div>
                                                        </div>

                                                        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">Initial Project Allocation Form � Attempt @attempt.AttemptNumber</h5>
                                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                                    </div>
                                                                    <div class="modal-body iaf-readonly-view">
                                                                        <table class="iaf-table">
                                                                            <tr><td class="iaf-label">Course Code</td><td class="iaf-value">6002CMD</td></tr>
                                                            <tr><td class="iaf-label">Module Leader Name</td><td class="iaf-value">@moduleLeaderName</td></tr>
                                                            <tr><td class="iaf-label">Project Title</td><td class="iaf-value">@Fv("title")</td></tr>
                                                                            <tr><td class="iaf-label">Scope of Project</td><td class="iaf-value">@Fv("scope")</td></tr>
                                                                            <tr><td class="iaf-label">Problem Statement</td><td class="iaf-value">@Fv("problem")</td></tr>
                                                                            <tr><td class="iaf-label">Objective 1</td><td class="iaf-value">@Fv("obj1")</td></tr>
                                                                            <tr><td class="iaf-label">Objective 2</td><td class="iaf-value">@Fv("obj2")</td></tr>
                                                                            <tr><td class="iaf-label">Objective 3</td><td class="iaf-value">@Fv("obj3")</td></tr>
                                                                            <tr><td class="iaf-label">Agreed Supervisor Name</td><td class="iaf-value">@Fv("agreedSupervisor")</td></tr>
                                                                            <tr><td class="iaf-label">Supervisor's name</td><td class="iaf-value" style="background-color: #DBE5F1;">@Model.Supervisor?.FullName</td></tr>
                                                                            <tr>
                                                                                <td class="iaf-label">Supervisor's signature</td>
                                                                                <td class="iaf-value" style="background-color: #DBE5F1;">
                                                                                    @if (isSigned) {
                                                                                        if (attempt.SupervisorSignature.StartsWith("data:image/")) {
                                                                                            <img src="@attempt.SupervisorSignature" alt="Supervisor Signature" style="max-height: 80px; max-width: 250px;" />
                                                                                        } else {
                                                                                            <span style="font-family: 'Brush Script MT', cursive; font-size: 24px; color: #00008B;">@attempt.SupervisorSignature</span>
                                                                                        }
                                                                                    } else {
                                                                                        <span class="text-muted fst-italic">Not signed</span>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                            <tr><td class="iaf-label">Comment/Feedback</td><td class="iaf-value">@attempt.SupervisorFeedback</td></tr>
                                                                            @if (!string.IsNullOrEmpty(attempt.PanelComments)) {
                                                                                <tr><td class="iaf-label">Panel Comments</td><td class="iaf-value">@attempt.PanelComments</td></tr>
                                                                            }
                                                                        </table>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        @if (snapshotFile != null) {
                                                                            <a class="btn btn-sm btn-light" href="@Url.Action("DownloadFile", "Student", new { fileId = snapshotFile.Id })"><i class="fas fa-download me-1"></i>Download PDF</a>
                                                                        }
                                                                        <button type="button" class="btn btn-sm btn-primary" data-dismiss="modal">Close</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                } catch (Exception ex) {
                                                    <div class="alert alert-danger font-monospace">
                                                        <strong>Error parsing JSON:</strong> @ex.Message
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }



                                    @if (iafMilestone != null && iafMilestone.SubmissionFiles != null && iafMilestone.SubmissionFiles.Any(f => f.UploadedBy != Model.StudentId))
                                    {
                                        var gFiles = iafMilestone.SubmissionFiles.Where(f => f.UploadedBy != Model.StudentId).ToList();
                                        <div class="mb-4">
                                            <h6 class="fw-bold text-primary mb-3"><i class="fas fa-file-pdf me-2"></i>Graded / Feedback Files</h6>
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var file in gFiles)
                                                {
                                                    <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" target="_blank" class="btn btn-outline-primary text-start d-flex align-items-center rounded-3 p-3 text-decoration-none bg-light-primary border-primary border-opacity-25 shadow-sm transition">
                                                        <i class="fas fa-file-pdf text-primary me-3 fs-4"></i>
                                                        <span class="text-dark fw-bold text-truncate flex-grow-1">@file.FileName</span>
                                                        <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (!isIafLocked)
                                    {
                                        <div class="card-footer bg-light border-top p-3 mt-3 iaf-action-footer">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <div class="text-muted small fw-semibold">
                                                    <span id="autosaveIndicator"><i class="fas fa-check-circle text-success me-1"></i>Auto-saved locally</span>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    @if (iafMilestone?.Status == "Draft" || iafMilestone?.Status == "ReturnedForEdits" || string.IsNullOrEmpty(iafMilestone?.Status) || iafMilestone?.Status == "Pending")
                                                    {
                                                        <button type="submit" name="iafAction" value="draft" class="btn btn-light fw-bold px-4 border shadow-sm" formnovalidate><i class="fas fa-save me-2 text-muted"></i>Save Draft</button>
                                                        <button type="submit" name="iafAction" value="supervisor_review" class="btn btn-info px-4 shadow-sm text-white fw-bold"><i class="fas fa-user-tie me-2"></i>Send for Supervisor Review</button>
                                                    }
                                                    else if (iafMilestone?.Status == "SupervisorSigned")
                                                    {
                                                        bool isChangeOfTopic = false;
                                                        if (!string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: ")) {
                                                            var parts = iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None);
                                                            var history = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(parts[1]);
                                                            if (history.Attempts.Any(a => a.Status == "ChangeOfTopicRequired" || (a.PanelComments != null && a.PanelComments.Contains("Change of Topic"))) || history.CurrentAttempt > 1) {
                                                                isChangeOfTopic = true;
                                                            }
                                                        }
                                                        
                                                        if (isChangeOfTopic) {
                                                            <button type="submit" name="iafAction" value="submit_new" class="btn btn-success btn-submit px-4 shadow-sm" onclick="return confirm('Are you sure you want to officially submit your NEW IAF? This will be your final IAF submission and you will proceed to DPP.')"><i class="fas fa-paper-plane me-2"></i>Submit New IAF</button>
                                                        } else {
                                                            <button type="submit" name="iafAction" value="submit" class="btn btn-primary btn-submit px-4 shadow-sm" onclick="return confirm('Are you sure you want to officially submit your IAF? It will be sent to the Panel.')"><i class="fas fa-paper-plane me-2"></i>Submit IAF</button>
                                                        }
                                                    }
                                                    else if (iafMilestone?.Status == "PanelRevisionRequired")
                                                    {
                                                        <button type="submit" name="iafAction" value="draft" class="btn btn-light fw-bold px-4 border shadow-sm" formnovalidate><i class="fas fa-save me-2 text-muted"></i>Save Draft</button>
                                                        <button type="submit" name="iafAction" value="ready_defense" class="btn btn-warning text-dark px-4 shadow-sm fw-bold"><i class="fas fa-calendar-check me-2"></i>Ready for Defence</button>
                                                    }
                                                    else if (iafMilestone?.Status == "ChangeOfTopicRequired")
                                                    {
                                                        <button type="submit" name="iafAction" value="draft" class="btn btn-light fw-bold px-4 border shadow-sm" formnovalidate><i class="fas fa-save me-2 text-muted"></i>Save Draft</button>
                                                        <button type="submit" name="iafAction" value="supervisor_review" class="btn btn-info px-4 shadow-sm text-white fw-bold"><i class="fas fa-user-tie me-2"></i>Send for Supervisor Review</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    </div>
                                </form>
                            
                        </div>
                    </div>

                    
                    @* -- A. PROPOSAL FORM ------------------------------ *@
                    <div class="tab-pane fade @(isIafApproved && isAllProgressCompleted && !isProposalApproved ? "show active" : "")" id="proposal-form-pane" role="tabpanel" tabindex="0">
                        <div class="card border-0 shadow-sm rounded-3 p-4">
                            <h4 class="fw-bold text-dark mb-4"><i class="fas fa-file-signature text-orange me-2"></i>B. Stage 1 Detailed Project Proposal (DPP)</h4>
                            
                                @* Select corresponding Milestone *@
                                @{
                                    var propMilestone = milestones.FirstOrDefault(m => m.Title.Contains("Stage 1 Final Submission", StringComparison.OrdinalIgnoreCase)) ?? milestones.FirstOrDefault();
                                    int propMilestoneId = propMilestone?.Id ?? 0;
                                    bool isPropLocked = propMilestone != null && (propMilestone.Status == "Submitted" || propMilestone.Status == "UnderReview" || propMilestone.Status == "Approved");
                                }
                                
                                @if (propMilestone != null && propMilestone.Status == "Rejected")
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger shadow-sm">
                                        <i class="fas fa-exclamation-circle fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Stage 1 Final Submission Rejected (Needs Revision)</h5>
                                            <p class="mb-0 text-muted"><strong>Feedback:</strong> @propMilestone.SupervisorFeedback</p>
                                        </div>
                                    </div>
                                }
                                else if (isPropLocked)
                                {
                                    <div class="alert alert-info d-flex align-items-center mt-3 border-info shadow-sm">
                                        <i class="fas fa-lock fs-2 me-3 text-info"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Stage 1 Final Submission Locked</h5>
                                            <p class="mb-0 text-muted">Your proposal has already been submitted. Current Status: <span class="badge bg-white text-dark ms-1 shadow-sm border">@propMilestone.Status</span></p>
                                            @if (!string.IsNullOrEmpty(propMilestone?.SupervisorFeedback))
                                            {
                                                <hr class="my-2 border-info opacity-25">
                                                <p class="mb-0 text-dark"><strong>Feedback:</strong> @propMilestone.SupervisorFeedback</p>
                                            }

                                            @if (propMilestone?.SubmissionFiles != null && propMilestone.SubmissionFiles.Any(f => f.UploadedBy != Model.StudentId))
                                            {
                                                var gFiles = propMilestone.SubmissionFiles.Where(f => f.UploadedBy != Model.StudentId).ToList();
                                                <hr class="my-3 border-info opacity-25">
                                                <h6 class="fw-bold text-primary mb-2"><i class="fas fa-file-pdf me-2"></i>Graded / Feedback Files</h6>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var file in gFiles)
                                                    {
                                                        <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" target="_blank" class="btn btn-outline-primary text-start d-flex align-items-center rounded-3 p-2 text-decoration-none bg-white border-primary border-opacity-25 shadow-sm">
                                                            <i class="fas fa-file-pdf text-primary me-3"></i>
                                                            <span class="text-dark fw-bold text-truncate flex-grow-1">@file.FileName</span>
                                                            <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (!isPropLocked)
                                {
                                <form id="proposalForm" asp-action="SubmitDigitalForm" method="post" enctype="multipart/form-data" asp-antiforgery="true">
                                    <input type="hidden" name="formType" value="Proposal Form" />
                                    <input type="hidden" name="milestoneId" value="@propMilestoneId" />

                                    @* Stage 1 Submission Guide *@
                                    <div class="alert alert-info border-0 rounded-3 shadow-sm mb-4">
                                        <h6 class="fw-bold text-dark mb-2"><i class="fas fa-list-check me-2"></i>Detailed Project Proposal Submission</h6>
                                        <p class="small text-dark mb-2">Please ensure you have completed the following before the deadline. Each submission requires the correct template:</p>
                                        <ul class="small text-dark mb-0 ps-3" style="line-height: 1.6;">
                                            <li><strong>Submission of Detail Project Proposal (DPP)</strong> - Complete the word template below and upload.</li>
                                            <li><strong>Turnitin Checking</strong> - Ensure similarity is below the accepted threshold.</li>
                                            <li><strong>Submission of Marksheet</strong></li>
                                        </ul>
                                    </div>

                                <div class="form-section-title">Part 1: Proposal Details</div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Project Title</label>
                                    <input type="text" name="title" class="form-control bg-light" value="@Model.Title" readonly required />
                                </div>

                                <div class="mb-4 p-3 rounded-3"
                                    style="background: #f8fafc; border: 1px solid #e2e8f0;">

                                    <div class="fw-bold text-dark mb-2">
                                        <i class="fas fa-file-pdf text-danger me-2"></i>
                                        Detailed Project Proposal (DPP) Submission
                                    </div>

                                    <div class="text-muted small mb-3">
                                        Combine your completed Part 1 work into <strong>ONE PDF</strong> before submitting.
                                    </div>

                                    <ul class="small text-dark mb-3 ps-3" style="line-height: 1.7;">
                                        <li>Cover Page</li>
                                        <li>Chapter 1: Introduction</li>
                                        <li>Chapter 2: Literature Review</li>
                                        <li>Chapter 3: Software Methodology</li>
                                        <li>References</li>
                                        <li>Appendices (if applicable)</li>
                                    </ul>
                                    <div class="small text-muted">
                                        Upload the final combined PDF using the document upload section below.
                                    </div>
                                    
                                </div>

                                <div class="form-section-title">Part 2: Document Attachment</div>
                                <div class="mb-4">
                                    <label for="proposalDocument" class="form-label fw-semibold">Upload Final Proposal <span class="text-danger">*</span></label>
                                    <input class="form-control" type="file" id="proposalDocument" name="attachedFile" accept=".pdf" required />
                                    <div class="form-text">Accepted formats: PDF only.</div>
                                </div>

                                @if (proposalMilestone?.Status == "Rejected")
                                {
                                    <div class="form-section-title text-danger"><i class="fas fa-history me-2"></i>Part 3: Revision Notes</div>
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">What did you change in this version?</label>
                                        <textarea name="revisionNotes" class="form-control" rows="3" placeholder="I fixed the diagrams on page 4 and updated the literature review..." required></textarea>
                                        <div class="text-danger fw-bold small mt-1">* Revision Notes are required for resubmissions.</div>
                                    </div>
                                }

                                <div class="d-flex gap-3 justify-content-end">
                                    <button type="button" class="btn-draft" onclick="saveDraftAlert()">Save Draft</button>
                                    <button type="submit" class="btn-submit" onclick="return validateProposalForm()">Submit Stage 1 Final Submission</button>
                                </div>
                            </form>
                            }
                        </div>
                    </div>

                    @* -- A. DPP WORK & PROGRESS ----------------------- *@


                    <div class="tab-pane fade @(isIafApproved && !isAllProgressCompleted ? "show active" : "")"
                        id="progress-form-pane"
                        role="tabpanel"
                        tabindex="0">
                        <div class="card border-0 shadow-sm rounded-3 p-4">
                            <h4 class="fw-bold text-dark mb-4"><i class="fas fa-chart-line text-orange me-2"></i>A. DPP Work & Progress</h4>
                            
                            @{
                                var progressMilestones = allProgressMilestones.Where(x => 
                                    x.Status == "Draft" || x.Status == "ReturnedForChanges").ToList();
                                    
                                var submittedProgress = allProgressMilestones.Where(x => 
                                    x.Status == "PendingSupervisorReview" || x.Status == "Completed").ToList();
                            }
                            
                            @if (!allProgressMilestones.Any())
                            {
                                <div class="alert alert-info d-flex align-items-center mt-3 border-info shadow-sm">
                                    <i class="fas fa-lock fs-2 me-3 text-info"></i>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">DPP Work & Progress Locked</h5>
                                        <p class="mb-0 text-muted">Waiting for your supervisor to add DPP work milestones.</p>
                                    </div>
                                </div>
                            }
                            else if (!progressMilestones.Any())
                            {
                                <div class="alert alert-info d-flex align-items-center mt-3 border-info shadow-sm">
                                    <i class="fas fa-clock fs-2 me-3 text-info"></i>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">Awaiting Supervisor Review</h5>
                                        <p class="mb-0 text-muted">You have no editable Stage 1 progress milestones to submit. They are all pending supervisor review or already completed.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (progressMilestones.Any())
                                {
                                    <form asp-action="SubmitDigitalForm" method="post" enctype="multipart/form-data" class="needs-validation" novalidate id="progressForm">
                                        <input type="hidden" name="formType" value="DPP Work & Progress" />

                                        <div class="mb-4">
                                            <label class="form-label fw-bold text-dark fs-6 mb-2">Select Progress Milestone</label>
                                            <select name="milestoneId" id="progressMilestoneSelect" class="form-select form-select-lg form-select-solid bg-light" required onchange="toggleProgressTemplate(this)">
                                                <option value="">-- Choose a Milestone --</option>
                                                @foreach (var m in progressMilestones)
                                                {
                                                    <option value="@m.Id" data-status="@m.Status" data-feedback="@(m.SupervisorFeedback ?? "")">@m.Title</option>
                                                }
                                            </select>
                                            <div class="invalid-feedback">Please select a milestone.</div>
                                        </div>

                                        <div id="progressStatusInfo" class="d-none mb-4">
                                            <div class="card border border-primary border-opacity-25 shadow-sm rounded-4 overflow-hidden" style="background: #f4f8ff;">
                                                <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                            <h5 class="fw-bolder text-dark mb-0" id="progressStatusTitle">Milestone Title</h5>
                                                            <span class="badge bg-primary text-white px-2 py-1 rounded-pill small" id="progressStatusBadge">Draft</span>
                                                        </div>
                                                        <p class="text-muted small mb-0 fw-semibold">DPP Work & Progress</p>
                                                        <p class="text-muted small mb-0 mt-2">Complete and submit this work for review.</p>
                                                    </div>
                                                    <a href="#"
                                                       id="btnDownloadProgress"
                                                       class="btn btn-sm btn-outline-primary fw-bold rounded-3 px-3 d-flex align-items-center gap-2">
                                                        <i class="fas fa-download"></i> Download Format of Part 1 Report
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                        <div id="progressFeedbackInfo" class="d-none mb-4">
                                            <div class="card border border-danger border-opacity-25 shadow-sm rounded-4" style="background: #fff5f5;">
                                                <div class="card-body p-4">
                                                    <div class="d-flex align-items-center mb-2">
                                                        <i class="fas fa-exclamation-circle fs-3 text-danger me-2"></i>
                                                        <h6 class="fw-bolder text-danger mb-0">Returned for Changes</h6>
                                                    </div>
                                                    <p class="text-dark small mb-0 fw-semibold">Supervisor Feedback:</p>
                                                    <p class="text-muted small mb-0 mt-1" id="progressFeedbackText"></p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Section 1 -->
                                        <div class="saas-card mb-3">
                                            <div class="saas-card-body p-3">
                                                <div class="d-flex align-items-center mb-2">
                                                    <span class="text-primary fw-bolder fs-5 me-2">01</span>
                                                    <h6 class="fw-bold text-dark mb-0">Reporting Period</h6>
                                                </div>
                                                
                                                <div class="row ms-4 mt-2 g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label text-dark small fw-semibold">Start Period</label>
                                                        <input type="date" name="startDate" id="progressStartDate" class="form-control saas-input" required oninput="validateProgressSubmitBtn()" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label text-dark small fw-semibold">End Period</label>
                                                        <input type="date" name="endDate" id="progressEndDate" class="form-control saas-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" required oninput="validateProgressSubmitBtn()" />
