@using FYPTracker.Models
@inject FYPTrackerContext _context
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@inject Microsoft.Extensions.Configuration.IConfiguration _configuration
@model FYPProject?
@inject FYPTracker.Services.Forms.IafFormTemplateService IafTemplateService
@{
    ViewData["Title"] = "Digital Submission Forms";
    var currentUser = ViewBag.CurrentUser as ApplicationUser;
    var milestones  = Model?.Milestones?.ToList() ?? new List<FYPMilestone>();
    var adminUser = _context.ApplicationUsers.FirstOrDefault(u => u.UserRoles.Any(r => r.Role.Name == "Admin"));
    var moduleLeaderName = adminUser?.FullName ?? "Admin";
    var iafTemplate = await IafTemplateService.LoadAsync();

    string IafLabel(string key, string fallback)
    {
        return iafTemplate.Fields
            .FirstOrDefault(f => f.Key == key)?.Label
            ?? fallback;
    }
}

<style>
    :root {
        --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }
    
    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .premium-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid rgba(249, 115, 22, 0.1);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        font-size: 0.9rem;
        padding: 9px 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #334155;
        box-shadow: 0 0 0 3px rgba(51, 65, 85, 0.15);
    }

    /* Scoped styling for Progress Milestone Select Dropdown */
    .progress-milestone-field-group,
    #progressMilestoneSelect {
        width: 100%;
        max-width: 680px;
    }

    #progressMilestoneSelect {
        background-color: #ffffff;
        color: #1e293b;
        font-size: 0.95rem;
        font-weight: 500;
        line-height: 1.5;
        padding: 9px 36px 9px 12px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        cursor: pointer;
        display: block;
        box-sizing: border-box;
    }

    #progressMilestoneSelect:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        background-color: #ffffff;
        outline: none;
    }

    @@media (max-width: 767.98px) {
        .progress-milestone-field-group,
        #progressMilestoneSelect {
            max-width: 100%;
        }
    }



    .btn-submit {
        background: #1e293b;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 700;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: scale(1.03);
        color: white;
    }
    
    .btn-draft {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
        transition: background-color 0.2s;
    }
    
    .btn-draft:hover {
        background-color: #e2e8f0;
    }

    .form-section-title {
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        color: var(--primary-orange);
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 8px;
        margin-bottom: 20px;
    }

    /* Wizard Stepper Styles */
    .wizard-stepper {
        display: flex;
        justify-content: space-between;
        background: #fff;
        border-radius: 12px;
        padding: 10px 0;
        box-shadow: 0 2px 10px rgba(0,0,0,.04);
        margin-bottom: 16px;
        position: relative;
    }
    .stepper-item {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 2;
    }
    .stepper-item:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 20px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e5e7eb;
        z-index: -1;
    }
    .stepper-btn {
        background: transparent !important;
        border: none !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        color: #6b7280;
        transition: all 0.3s;
        padding: 0;
    }
    .stepper-btn:disabled {
        pointer-events: none;
        opacity: 0.6;
    }
    .stepper-btn.active .step-icon {
        background: var(--hero-grad);
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(30,41,59,0.3);
    }
    .stepper-btn.active .step-text {
        color: #1e293b;
        font-weight: 700;
    }
    .step-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        margin-bottom: 4px;
        transition: all 0.3s;
        pointer-events: none;
    }
    .step-text { font-size: 0.85rem; font-weight: 600; margin-top: 4px; pointer-events: none; }
    .stepper-btn:hover:not([disabled]) .step-icon { border-color: #f97316; color: #f97316; }

    /* ===== IAF Card ===== */
    .iaf-main-card {
        border-radius: 12px !important;
    }

    /* IAF heading */
    .iaf-main-card .iaf-card-heading {
        padding-bottom: 16px;
        margin-bottom: 20px;
        border-bottom: 1px solid #e2e8f0;
    }

    /* Form table */
    .iaf-main-card .iaf-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 12px;
        margin-bottom: 16px;
    }

    /* Compact table cells */
    .iaf-main-card .iaf-table td {
        padding: 12px 14px;
        vertical-align: middle;
        border-color: #e2e8f0;
    }

    /* Left label column */
    .iaf-main-card .iaf-table .iaf-label {
        width: 30%;
        background-color: #f8fafc;
        color: #334155;
        font-weight: 700;
    }

    /* Right value column */
    .iaf-main-card .iaf-table .iaf-value {
        width: 70%;
        white-space: normal;
    }

    /* Inputs */
    .iaf-main-card .iaf-table .form-control,
    .iaf-main-card .iaf-table .form-select {
        min-height: 40px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
    }

    /* Problem Statement */
    .iaf-main-card .iaf-table textarea.form-control {
        min-height: 140px;
        resize: vertical;
    }

    /* Preserve formatting in history modal */
    .iaf-main-card .iaf-readonly-view .iaf-value {
        white-space: pre-wrap;
    }

    /* Action footer */
    .iaf-main-card .iaf-action-footer {
        border-radius: 0 0 12px 12px;
    }

    /* IAF primary submission button */
    .iaf-main-card #iafFormElement button[name="iafAction"][value="supervisor_review"] {
        background-color: #0f172a;
        border-color: #0f172a;
        color: #ffffff;
        border-radius: 8px;
    }

    .iaf-main-card #iafFormElement button[name="iafAction"][value="supervisor_review"]:hover {
        background-color: #1e293b;
        border-color: #1e293b;
        color: #ffffff;
    }

    /* ===== IAF Student Information ===== */
    .iaf-main-card .iaf-student-info {
        padding: 16px;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .iaf-main-card .iaf-student-info .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }

    .iaf-main-card .iaf-info-value {
        min-height: 42px;
        display: flex;
        align-items: center;
        padding: 10px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background-color: #f8fafc;
        color: #1e293b;
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    /* Match editable Coventry ID field */
    .iaf-main-card .iaf-student-info .form-control {
        min-height: 42px;
        border-radius: 8px;
    }

    /* Mobile responsiveness */
    @@media (max-width: 767.98px) {
        .iaf-main-card .iaf-student-info {
            padding: 12px;
        }
    }

    /* ===== IAF MOBILE RESPONSIVENESS ===== */

    @@media screen and (max-width: 767.98px) {

        /* Stack label and input vertically */
        .iaf-main-card .iaf-form-table,
        .iaf-main-card .iaf-form-table tbody,
        .iaf-main-card .iaf-form-table tr,
        .iaf-main-card .iaf-form-table td {
            display: block;
            width: 100% !important;
        }

        .iaf-main-card .iaf-form-table tr {
            margin-bottom: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            overflow: hidden;
        }

        /* Field labels */
        .iaf-main-card .iaf-form-table td.iaf-label {
            width: 100% !important;
            padding: 10px 12px;
            border: 0;
            border-bottom: 1px solid #e2e8f0;
        }

        /* Input container */
        .iaf-main-card .iaf-form-table td.iaf-value {
            width: 100% !important;
            padding: 12px;
            border: 0;
            overflow-wrap: anywhere;
        }

        /* Prevent input overflow */
        .iaf-main-card .iaf-form-table .form-control,
        .iaf-main-card .iaf-form-table .form-select {
            max-width: 100%;
            min-width: 0;
        }

        /* Objective input group */
        .iaf-main-card .iaf-form-table .input-group {
            width: 100%;
            flex-wrap: nowrap;
        }

        .iaf-main-card .iaf-form-table .input-group .form-control {
            min-width: 0;
            flex: 1 1 auto;
        }

        /* Action footer */
        .iaf-main-card .iaf-action-footer > .d-flex {
            flex-direction: column;
            align-items: stretch !important;
        }

        .iaf-main-card .iaf-action-footer > .d-flex > .d-flex {
            flex-direction: column;
            width: 100%;
        }

        .iaf-main-card .iaf-action-footer button {
            width: 100%;
        }

        /* IAF Attempt History */
        .iaf-main-card .iaf-attempt-card {
            flex-direction: column;
            align-items: stretch;
        }

        .iaf-main-card .iaf-attempt-card > .d-flex {
            flex-wrap: wrap;
        }

        /* Wizard Stepper */
        .wizard-stepper .stepper-item {
            min-width: 0;
        }

        .wizard-stepper .step-text {
            font-size: 0.72rem;
            line-height: 1.35;
            text-align: center;
            white-space: normal;
            overflow-wrap: anywhere;
            padding: 0 4px;
        }
    }
</style>

<div class="container-xxl py-4">

    <!-- Welcome Header (Navy-blue matching Dashboard) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background-color: #0f172a; color: white;">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bolder mb-1"><i class="fas fa-file-contract me-2"></i>Digital Submission Forms</h4>
                <p class="mb-0 text-white-50 fs-7 fw-bold">Fill and submit your academic milestones digitally. Status updates are pushed instantly to your supervisor.</p>
            </div>
        </div>
    </div>

    @if (Model == null)
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center">
            <i class="fas fa-exclamation-triangle text-warning fs-1 mb-4 d-block"></i>
            <h4 class="fw-bold text-dark">No Active Project</h4>
            <p class="text-muted mb-0">Please request a supervisor and secure an active project before submitting academic forms.</p>
        </div>
    }
    else
    {
        var iafMilestone = milestones.FirstOrDefault(m => (m.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || m.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)) && !m.Title.Contains("Industrial", StringComparison.OrdinalIgnoreCase));
        bool isIafApproved = iafMilestone != null && iafMilestone.Status == "AdminApproved";
        int iafMilestoneId = iafMilestone?.Id ?? 0;
        bool isAttempt2Failed = false;
        string attempt2Feedback = "";
        if (iafMilestone != null && iafMilestone.Status == "ChangeOfTopicRequired" && !string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: "))
        {
            try {
                var h = FYPTracker.Models.IafAttemptHistory.ParseOrMigrate(iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None)[1]);
                if (h.CurrentAttempt >= 2)
                {
                    isAttempt2Failed = true;
                    var a2 = h.Attempts.FirstOrDefault(a => a.AttemptNumber == h.CurrentAttempt);
                    if (a2 != null && !string.IsNullOrEmpty(a2.PanelComments))
                    {
                        attempt2Feedback = a2.PanelComments;
                    }
                }
            } catch {}
        }

        bool isIafLocked = isAttempt2Failed || (iafMilestone != null && (
            iafMilestone.Status == "PendingSupervisorReview" ||
            iafMilestone.Status == "SupervisorSigned" ||
            iafMilestone.Status == "PendingPanelReview" ||
            iafMilestone.Status == "AdminApproved" ||
            iafMilestone.Status == "DefenseRequired" ||
            iafMilestone.Status == "DefenseScheduled" ||
            iafMilestone.Status == "Completed" ||
            (iafMilestone.Status != "Draft" && iafMilestone.Status != "Pending" && iafMilestone.Status != "ReturnedForEdits" && iafMilestone.Status != "PanelRevisionRequired" && iafMilestone.Status != "ChangeOfTopicRequired" && !string.IsNullOrEmpty(iafMilestone.Status))
        ));

        var proposalMilestone = FYPTracker.Utils.GradingHelper.GetStage1FinalMilestone(milestones);
        bool isProposalApproved = proposalMilestone != null && FYPTracker.Utils.GradingHelper.IsStage1DppApproved(proposalMilestone);
        
        // Stage 1 Individual Scores (Supervisor and Examiner)
        double? supStage1Score = null;
        if (proposalMilestone != null && !string.IsNullOrWhiteSpace(proposalMilestone.SupervisorMarksheetData) && !FYPTracker.Utils.GradingHelper.IsMarksheetDraft(proposalMilestone.SupervisorMarksheetData))
        {
            supStage1Score = FYPTracker.Utils.GradingHelper.CalculateStage1Score(proposalMilestone.SupervisorMarksheetData, "Supervisor");
        }
        double? exStage1Score = null;
        if (proposalMilestone != null && !string.IsNullOrWhiteSpace(proposalMilestone.ExaminerMarksheetData) && !FYPTracker.Utils.GradingHelper.IsMarksheetDraft(proposalMilestone.ExaminerMarksheetData))
        {
            exStage1Score = FYPTracker.Utils.GradingHelper.CalculateStage1Score(proposalMilestone.ExaminerMarksheetData, "Examiner");
        }
        
        var stage2Milestones = milestones.Where(m => (m.Stage == 2 || m.Title.StartsWith("Step", StringComparison.OrdinalIgnoreCase)) && !FYPTracker.Utils.GradingHelper.IsObsoleteOrRetiredStage2Milestone(m)).ToList();

        // DPP Work & Progress: ONLY Supervisor-added Stage 1 milestones (persistent DB classification)
        var allProgressMilestones = milestones.Where(m => m.MilestoneSource == "Supervisor" && m.Stage == 1).ToList();
            
        var stage1Booking = ViewBag.ScheduledIafBooking as IAFDefenseBooking;
        var stage1DppPrereq = FYPTracker.Utils.GradingHelper.CanSubmitStage1FinalDpp(milestones, iafMilestone, stage1Booking);
        bool hasProgressMilestones = stage1DppPrereq.HasTasks;
        bool isAllProgressCompleted = stage1DppPrereq.AllApproved;
        bool canSubmitStage1FinalDpp = stage1DppPrereq.Allowed;

        // NEW: Stage 2 unlock logic depends on Stage1Grade == "Pass"
        bool isStage2Unlocked = Model?.Stage1Grade == "Pass";
        bool isStage1Failed = Model?.Stage1Grade == "Fail";

        string iafTooltip = isIafApproved ? "data-toggle=\"tooltip\" title=\"IAF Form has been approved and locked\"" : "";
        
        string progressTooltip = "";
        if (!isIafApproved) progressTooltip = "data-toggle=\"tooltip\" title=\"Requires IAF Approval first\"";
        else if (!hasProgressMilestones) progressTooltip = "data-toggle=\"tooltip\" title=\"Waiting for your Supervisor to assign Stage 1 DPP progress tasks\"";
        else if (isAllProgressCompleted) progressTooltip = "data-toggle=\"tooltip\" title=\"All DPP progress milestones are completed and approved\"";
        else progressTooltip = "data-toggle=\"tooltip\" title=\"Waiting for Supervisor approval of all required Stage 1 progress tasks\"";

        string proposalTooltip = "";
        if (!isIafApproved) proposalTooltip = "data-toggle=\"tooltip\" title=\"Requires IAF approval first\"";
        else if (!hasProgressMilestones) proposalTooltip = "data-toggle=\"tooltip\" title=\"Waiting for your Supervisor to assign Stage 1 DPP progress tasks\"";
        else if (!isAllProgressCompleted) proposalTooltip = "data-toggle=\"tooltip\" title=\"Waiting for Supervisor approval of all required Stage 1 progress tasks\"";
        else if (isProposalApproved) proposalTooltip = "data-toggle=\"tooltip\" title=\"Proposal Form has been approved and locked\"";

        string finalTooltip = "";
        if (!isAllProgressCompleted) finalTooltip = "data-toggle=\"tooltip\" title=\"Requires all assigned DPP progress tasks to be completed and approved by Supervisor\"";

        <div class="row g-4">
            
            @* -- STAGE 1 STATUS BANNER ------------------------ *@
            @if (isStage1Failed)
            {
                <div class="col-12 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border-left: 6px solid #dc3545;">
                        <div class="card-body p-5 bg-white">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-4 border-bottom">
                                <div class="d-flex align-items-center">
                                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 60px; height: 60px;">
                                        <i class="fas fa-redo-alt fs-2"></i>
                                    </div>
                                    <div>
                                        <h3 class="fw-bolder mb-1 text-dark">Stage 1 Remediation Required</h3>
                                        <p class="mb-0 text-muted fs-6">You have been permitted to proceed with your Stage 2 project milestones while remediating your Stage 1 requirements.</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row g-4">
                                <!-- Stage 1 Original -->
                                <div class="col-md-4">
                                    <div class="p-4 rounded-4 h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                        <h5 class="fw-bold text-dark mb-2"><i class="fas fa-history text-secondary me-2"></i>Stage 1 Original</h5>
                                        <p class="text-muted small mb-3">View your original Stage 1 submissions and evaluation feedback below.</p>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2">Scroll Down to View</span>
                                    </div>
                                </div>
                                
                                <!-- Stage 1 Remediation -->
                                <div class="col-md-4">
                                    <div class="p-4 rounded-4 h-100" style="background-color: #fffbeb; border: 1px solid #fde68a;">
                                        <h5 class="fw-bold text-dark mb-2"><i class="fas fa-file-signature text-warning me-2"></i>Stage 1 Remediation</h5>
                                        <p class="text-muted small mb-3">Consult your supervisor to complete your revised Stage 1 deliverables.</p>
                                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-3 py-2"><i class="fas fa-clipboard-check me-1"></i> Active Remediation</span>
                                    </div>
                                </div>

                                <!-- Stage 2 -->
                                <div class="col-md-4">
                                    <div class="p-4 rounded-4 h-100 position-relative overflow-hidden" style="background-color: #f0fdf4; border: 1px solid #bbf7d0;">
                                        <h5 class="fw-bold text-dark mb-2"><i class="fas fa-graduation-cap text-success me-2"></i>Stage 2</h5>
                                        <p class="text-muted small mb-3">Proceed with your Final Submission for Stage 2.</p>
                                        <a href="@Url.Action("Stage2", "Student")" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm w-100">
                                            Go to Stage 2 <i class="fas fa-arrow-right ms-2"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (isStage2Unlocked)
            {
                <div class="col-12 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border-left: 6px solid #10b981; background: #ffffff;">
                        <div class="card-body p-4 p-md-5">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-4 mb-4 border-bottom">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 56px; height: 56px; background-color: #ecfdf5; color: #10b981;">
                                        <i class="fas fa-check-circle fs-2"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h4 class="fw-bolder mb-0 text-dark">Stage 1 Passed</h4>
                                            <span class="badge bg-success rounded-pill px-3 py-1 fs-8 fw-bold">Official Pass</span>
                                        </div>
                                        <p class="mb-0 text-muted">Congratulations! You have successfully passed Stage 1. You may now proceed to Stage 2.</p>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <a href="#stage1HistorySection" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                                        <i class="fas fa-history me-1"></i> View Stage 1 Results
                                    </a>
                                    <a href="@Url.Action("Stage2", "Student")" class="btn btn-success btn-lg shadow-sm fw-bold rounded-pill px-4">
                                        Proceed to Stage 2 <i class="fas fa-arrow-right ms-2"></i>
                                    </a>
                                </div>
                            </div>

                            <!-- Stage 1 Results Summary Cards -->
                            <div class="row g-3" id="stage1ResultsSummary">
                                <div class="col-md-3">
                                    <div class="p-3 rounded-3 h-100 bg-light border border-light-subtle d-flex flex-column justify-content-between">
                                        <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Stage 1 Result</span>
                                        <div class="d-flex align-items-baseline gap-2 mt-2">
                                            <h3 class="fw-bolder @(Model?.Stage1Grade == "Pass" ? "text-success" : (Model?.Stage1Grade == "Fail" ? "text-danger" : "text-dark")) mb-0">@(Model?.Stage1Grade ?? "N/A")</h3>
                                            <small class="text-muted">Official Status</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 rounded-3 h-100 bg-light border border-light-subtle d-flex flex-column justify-content-between">
                                        <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Stage 1 Total Score</span>
                                        <div class="d-flex align-items-baseline gap-2 mt-2">
                                            <h3 class="fw-bolder text-primary mb-0">@(Model?.Stage1TotalScore.HasValue == true ? $"{Model.Stage1TotalScore.Value:0.00}%" : "N/A")</h3>
                                            <small class="text-muted">Combined Evaluation</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
