@using FYPTracker.Models
@model FYPProject?
@{
    ViewData["Title"] = "Digital Submission Forms";
    var currentUser = ViewBag.CurrentUser as ApplicationUser;
    var milestones  = Model?.Milestones?.ToList() ?? new List<FYPMilestone>();
}

<style>
    :root {
        --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }
    
    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .premium-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid rgba(249, 115, 22, 0.1);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        font-size: 0.9rem;
        padding: 9px 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #334155;
        box-shadow: 0 0 0 3px rgba(51, 65, 85, 0.15);
    }



    .btn-submit {
        background: #1e293b;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 700;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: scale(1.03);
        color: white;
    }
    
    .btn-draft {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
        transition: background-color 0.2s;
    }
    
    .btn-draft:hover {
        background-color: #e2e8f0;
    }

    .form-section-title {
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        color: var(--primary-orange);
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 8px;
        margin-bottom: 20px;
    }

    /* Wizard Stepper Styles */
    .wizard-stepper {
        display: flex;
        justify-content: space-between;
        background: #fff;
        border-radius: 16px;
        padding: 20px 0;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
        margin-bottom: 24px;
        position: relative;
    }
    .stepper-item {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 2;
    }
    .stepper-item:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 24px;
        left: 50%;
        width: 100%;
        height: 3px;
        background: #e5e7eb;
        z-index: -1;
    }
    .stepper-btn {
        background: transparent !important;
        border: none !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        color: #6b7280;
        transition: all 0.3s;
        padding: 0;
    }
    .stepper-btn:disabled {
        pointer-events: none;
        opacity: 0.6;
    }
    .stepper-btn.active .step-icon {
        background: var(--hero-grad);
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(30,41,59,0.3);
    }
    .stepper-btn.active .step-text {
        color: #1e293b;
        font-weight: 700;
    }
    .step-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 8px;
        transition: all 0.3s;
        pointer-events: none;
    }
    .step-text { font-size: 0.85rem; font-weight: 600; margin-top: 4px; pointer-events: none; }
    .stepper-btn:hover:not([disabled]) .step-icon { border-color: #f97316; color: #f97316; }
</style>

<div class="container-fluid py-4">



    @* ── Page Title & Hero ──────────────────────────────────── *@
    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="display-6 fw-bold mb-2"><i class="fas fa-file-invoice me-2"></i>Digital Submission Forms</h2>
            <p class="mb-0 opacity-90">Fill and submit your academic milestones digitally. Status updates are pushed instantly to your supervisor.</p>
        </div>
    </div>

    @if (Model == null)
    {
        <div class="premium-card p-5 text-center">
            <i class="fas fa-exclamation-triangle text-warning fs-1 mb-4 d-block"></i>
            <h4 class="fw-bold text-dark">No Active Project</h4>
            <p class="text-muted mb-0">Please request a supervisor and secure an active project before submitting academic forms.</p>
        </div>
    }
    else
    {
        var iafMilestone = milestones.FirstOrDefault(m => (m.Title.Contains("Initial Project Allocation", StringComparison.OrdinalIgnoreCase) || m.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)) && !m.Title.Contains("Industrial", StringComparison.OrdinalIgnoreCase));
        bool isIafApproved = iafMilestone != null && iafMilestone.Status == "Approved";
        int iafMilestoneId = iafMilestone?.Id ?? 0;
        bool isIafLocked = iafMilestone != null && (iafMilestone.Status == "Submitted" || iafMilestone.Status == "UnderReview" || iafMilestone.Status == "Approved");

        var proposalMilestone = milestones.FirstOrDefault(m => m.Title.Contains("Proposal", StringComparison.OrdinalIgnoreCase));
        bool isProposalApproved = proposalMilestone != null && proposalMilestone.Status == "Approved";
        
        var finalMsRef = milestones.FirstOrDefault(m => m.Title.Contains("Final", StringComparison.OrdinalIgnoreCase) || m.Title.Contains("Thesis", StringComparison.OrdinalIgnoreCase));

        // Any milestone that isn't IAF, Proposal, or Final is considered an intermediate "Progress" milestone
        var allProgressMilestones = milestones.Where(m => 
            m.Id != (iafMilestone?.Id ?? -1) && 
            m.Id != (proposalMilestone?.Id ?? -1) && 
            m.Id != (finalMsRef?.Id ?? -1)).ToList();
            
        // If there are intermediate milestones, they must all be approved. If none exist, it is true by default.
        bool isAllProgressApproved = allProgressMilestones.Any() ? allProgressMilestones.All(m => m.Status == "Approved") : true;

        // Force logical cascade: if a later milestone is approved, logically treat the previous ones as approved
        // so the UI doesn't break into multiple active tabs.
        if (isAllProgressApproved) { isProposalApproved = true; }
        if (isProposalApproved) { isIafApproved = true; }

        string iafTooltip = isIafApproved ? "data-toggle=\"tooltip\" title=\"IAF Form has been approved and locked\"" : "";
        
        string proposalTooltip = "";
        if (!isIafApproved) proposalTooltip = "data-toggle=\"tooltip\" title=\"Requires IAF Approval first\"";
        else if (isProposalApproved) proposalTooltip = "data-toggle=\"tooltip\" title=\"Proposal Form has been approved and locked\"";

        string progressTooltip = "";
        if (!isProposalApproved) progressTooltip = "data-toggle=\"tooltip\" title=\"Requires Proposal Approval first\"";

        string finalTooltip = "";
        if (!isAllProgressApproved) finalTooltip = "data-toggle=\"tooltip\" title=\"Requires all Progress Reports to be Approved first\"";

        <div class="row g-4">
            
            @* ── WIZARD STEPPER (Navigation) ────────────────── *@
            <div class="col-12">
                <ul class="wizard-stepper nav nav-pills m-0 p-0" style="list-style: none;" id="forms-tab" role="tablist">
                    <li class="stepper-item nav-item" role="presentation" tabindex="0" @Html.Raw(iafTooltip)>
                        <button class="stepper-btn nav-link @(!isIafApproved && !isProposalApproved && !isAllProgressApproved ? "active" : "")" id="iaf-form-tab" data-toggle="pill" data-target="#iaf-form-pane" type="button" role="tab">
                            <div class="step-icon"><i class="fas fa-clipboard-list"></i></div>
                            <div class="step-text">1. IAF Form</div>
                        </button>
                    </li>
                    <li class="stepper-item nav-item" role="presentation" tabindex="0" @Html.Raw(proposalTooltip)>
                        <button class="stepper-btn nav-link @(isIafApproved && !isProposalApproved && !isAllProgressApproved ? "active" : "")" id="proposal-form-tab" data-toggle="pill" data-target="#proposal-form-pane" type="button" role="tab" @(!isIafApproved ? "disabled" : "") style="@(!isIafApproved ? "pointer-events: none;" : "")">
                            <div class="step-icon"><i class="fas fa-feather-alt"></i></div>
                            <div class="step-text">A. Proposal Form</div>
                        </button>
                    </li>
                    <li class="stepper-item nav-item" role="presentation" tabindex="0" @Html.Raw(progressTooltip)>
                        <button class="stepper-btn nav-link @(isProposalApproved && !isAllProgressApproved ? "active" : "")" id="progress-form-tab" data-toggle="pill" data-target="#progress-form-pane" type="button" role="tab" @(!isProposalApproved ? "disabled" : "") style="@(!isProposalApproved ? "pointer-events: none;" : "")">
                            <div class="step-icon"><i class="fas fa-tasks"></i></div>
                            <div class="step-text">B. Progress Report</div>
                        </button>
                    </li>
                    <li class="stepper-item nav-item" role="presentation" tabindex="0" @Html.Raw(finalTooltip)>
                        <button class="stepper-btn nav-link @(isAllProgressApproved ? "active" : "")" id="final-form-tab" data-toggle="pill" data-target="#final-form-pane" type="button" role="tab" @(!isAllProgressApproved ? "disabled" : "") style="@(!isAllProgressApproved ? "pointer-events: none;" : "")">
                            <div class="step-icon"><i class="fas fa-graduation-cap"></i></div>
                            <div class="step-text">C. Final Submission</div>
                        </button>
                    </li>
                </ul>

                <div class="premium-card p-3 mb-2 bg-light d-flex align-items-center gap-3">
                    <i class="fas fa-info-circle text-orange fs-4" style="color:var(--primary-orange);"></i>
                    <div class="small text-muted">
                        <strong>Guidelines:</strong> Ensure all mandatory fields are fully populated before submission. 
                        <span class="text-success fw-bold"><i class="fas fa-save ms-2 me-1"></i>Auto-Save is active.</span> Your progress is automatically stored locally in your browser.
                    </div>
                </div>
            </div>

            @* ── FORM DETAILED PANES ────────────────────────────── *@
            <div class="col-12">
                <div class="tab-content" id="forms-tabContent">

                    @* ── 1. INITIAL PROJECT ALLOCATION FORM (IAF) ──────── *@
                    <div class="tab-pane fade @(isIafApproved ? "" : "show active")" id="iaf-form-pane" role="tabpanel" tabindex="0">
                        <div class="premium-card p-4">
                            <h4 class="fw-bold text-dark mb-2"><i class="fas fa-clipboard-list text-orange me-2"></i>1. Initial Project Allocation Form (IAF)</h4>
                            <p class="text-danger fw-bold mb-4"><i class="far fa-clock me-1"></i> Please complete this form and submit to Blackboard by @ViewBag.IAFDeadline.</p>
                            
                            @if (isIafLocked)
                            {
                                <div class="alert alert-info d-flex align-items-center mt-3 border-info mb-4">
                                    <i class="fas fa-lock fs-2 me-3 text-info"></i>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">IAF Form Submitted / Locked</h5>
                                        <p class="mb-0 text-muted">Your Initial Project Allocation Form has been submitted. Current Status: <span class="badge bg-white text-dark ms-1 shadow-sm border">@iafMilestone.Status</span></p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (iafMilestone != null && iafMilestone.Status == "Rejected")
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger mb-4">
                                        <i class="fas fa-times-circle fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">IAF Form Rejected (Needs Revision)</h5>
                                            <p class="mb-0 text-muted"><strong>Feedback:</strong> @iafMilestone.SupervisorFeedback</p>
                                        </div>
                                    </div>
                                }
                            }
                                
                                <form id="iafFormElement" asp-action="SubmitDigitalForm" method="post" class="needs-validation" novalidate>
                                    <input type="hidden" name="formType" value="Initial Project Allocation Form (IAF)" />
                                    <input type="hidden" name="milestoneId" value="@iafMilestoneId" />

                                    <div class="form-section-title">Part 1: Student & Project Info</div>
                                    
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Name</label>
                                            <input type="text" class="form-control bg-light" value="@currentUser?.FullName" readonly />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Coventry ID</label>
                                            <input type="text" class="form-control bg-light" value="@currentUser?.EmployeeId" readonly />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Program</label>
                                            <input type="text" class="form-control bg-light" value="@currentUser?.Programme" readonly />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Project Title</label>
                                            <input type="text" name="title" class="form-control bg-light" value="@Model.Title" readonly required />
                                        </div>
                                    </div>

                                    <div class="form-section-title">Part 2: Project Scope & Problem Statement</div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Scope of Project</label>
                                        <select name="scope" class="form-select" @(isIafLocked ? "disabled" : "") required>
                                            <option value="">-- Select Scope --</option>
                                            <option value="Development" selected="@(Model.Scope == "Development")">Development</option>
                                            <option value="Research Based Project" selected="@(Model.Scope == "Research Based Project")">Research Based Project</option>
                                            <option value="Hybrid" selected="@(Model.Scope == "Hybrid")">Hybrid</option>
                                        </select>
                                        <div class="invalid-feedback">Please select a project scope.</div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Problem Statement (supported with statistics and journal paper. Please make sure its included with in-text citation.)</label>
                                        <textarea name="problemStatement" class="form-control" rows="5" @(isIafLocked ? "readonly" : "") required placeholder="Provide a problem statement supported with statistics and journal paper references with in-text citation...">@Model.ProblemStatement</textarea>
                                        <div class="invalid-feedback">Problem statement is required.</div>
                                        <span class="text-danger fw-bold small">* Please include the references listing as well</span>
                                    </div>

                                    <div class="form-section-title">Part 3: Objectives (hint: must be in point form, must contain action verb and must be measurable)</div>
                                    <p class="text-muted small mb-2">The number of objectives should be more than 1 and less than or equal to 3. Example: 1. To (verb) indicate the platform and detailed out the project scope and feature</p>
                                    
                                    <div class="mb-3">
                                        <input type="text" name="objective1" class="form-control mb-2" value="@Model.Objective1" @(isIafLocked ? "readonly" : "") placeholder="1. Objective 1" required />
                                        <input type="text" name="objective2" class="form-control mb-2" value="@Model.Objective2" @(isIafLocked ? "readonly" : "") placeholder="2. Objective 2" required />
                                        <input type="text" name="objective3" class="form-control" value="@Model.Objective3" @(isIafLocked ? "readonly" : "") placeholder="3. Objective 3 (Optional)" />
                                        <div class="invalid-feedback">At least 2 objectives are required.</div>
                                    </div>

                                    <div class="form-section-title">Part 4: Supervisor Agreement</div>
                                    
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Supervisor's Name</label>
                                            <input type="text" name="supervisorName" class="form-control bg-light" placeholder="Supervisor Name" value="@Model.Supervisor?.FullName" readonly />
                                        </div>
                                        @if (iafMilestone == null || iafMilestone.Status != "Rejected")
                                        {
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Supervisor's Signature</label>
                                                @{
                                                    string sigName = "";
                                                    if (iafMilestone != null && !string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: ")) {
                                                        try {
                                                            var parts = iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None);
                                                            var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(parts[1]);
                                                            if (dict != null && dict.TryGetValue("Supervisor Signature", out var sig)) {
                                                                sigName = sig;
                                                            }
                                                        } catch {}
                                                    }
                                                }
                                                <input type="text" class="form-control bg-light @(string.IsNullOrEmpty(sigName) ? "text-danger" : "text-success fw-bold")" value="@(string.IsNullOrEmpty(sigName) ? "Awaiting Signature" : sigName)" readonly />
                                                <span class="text-muted small">* Note: the supervisor has to sign the form in order to acknowledge that they are the supervisor.</span>
                                            </div>
                                        }
                                    </div>

                                    @if (iafMilestone != null && !string.IsNullOrEmpty(iafMilestone.Remarks) && iafMilestone.Remarks.Contains("JSON: "))
                                    {
                                        var parts = iafMilestone.Remarks.Split(new[] { "JSON: " }, StringSplitOptions.None);
                                        var parsedJson = parts[1];

                                        <!-- The iframe to display the generated PDF -->
                                        <div class="bg-light rounded-4 border border-secondary border-opacity-25 shadow-sm p-2 mb-4 mt-4" style="height: 900px;">
                                            <h6 class="fw-bold text-primary mb-2 px-2 pt-2">Form Details (PDF)</h6>
                                            <iframe id="iafPdfIframe" style="width: 100%; height: 90%; border: none; border-radius: 8px;"></iframe>
                                        </div>

                                        <!-- Off-screen container for HTML2PDF to read -->
                                        <div id="iafPdfSource" style="display: none;">
                                            <h4 style="color: #0d6efd; margin-bottom: 20px; font-family: sans-serif;">@iafMilestone.Title</h4>
                                            <p style="font-family: sans-serif; color: #555;">Student: @(currentUser?.FullName) (@(currentUser?.EmployeeId))</p>
                                            <hr style="border: 1px solid #ddd; margin-bottom: 20px;" />
                                            @{
                                                try {
                                                    var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(parsedJson);
                                                    if (dict != null) {
                                                        <table style="width: 100%; font-family: sans-serif; font-size: 14px; border-collapse: collapse;">
                                                            @foreach (var kvp in dict) {
                                                                if (!string.IsNullOrEmpty(kvp.Value)) {
                                                                    <tr>
                                                                        <td style="width: 30%; font-weight: bold; padding: 8px; border-bottom: 1px solid #eee; vertical-align: top;">@kvp.Key:</td>
                                                                        <td style="padding: 8px; border-bottom: 1px solid #eee; white-space: pre-wrap;">
                                                                            @if (kvp.Key == "Supervisor Signature") {
                                                                                <span style="font-family: 'Brush Script MT', cursive; font-size: 24px; color: #00008B;">@kvp.Value</span>
                                                                            } else {
                                                                                @kvp.Value
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                        </table>
                                                    }
                                                } catch {
                                                    <div style="font-family: monospace; white-space: pre-wrap;">@parsedJson</div>
                                                }
                                            }

                                            @if (!string.IsNullOrEmpty(iafMilestone.SupervisorFeedback))
                                            {
                                                <hr style="border: 1px solid #ddd; margin: 20px 0;" />
                                                <h5 style="color: #0d6efd; font-family: sans-serif;">Supervisor's Feedback</h5>
                                                <p style="font-family: sans-serif; font-size: 14px; white-space: pre-wrap; background-color: #f8f9fa; padding: 15px; border-left: 4px solid #198754; color: #333;">@iafMilestone.SupervisorFeedback</p>
                                            }
                                        </div>
                                    }

                                    @if (iafMilestone != null && !string.IsNullOrEmpty(iafMilestone.SupervisorFeedback) && iafMilestone.Status == "Approved")
                                    {
                                        <div class="form-section-title">Comment/Feedback</div>
                                        <div class="mb-4 p-3 bg-light rounded border border-success">
                                            <p class="mb-0 text-dark fw-semibold">@iafMilestone.SupervisorFeedback</p>
                                        </div>
                                    }

                                    @if (iafMilestone != null && iafMilestone.SubmissionFiles != null && iafMilestone.SubmissionFiles.Any(f => f.UploadedBy != Model.StudentId))
                                    {
                                        var gFiles = iafMilestone.SubmissionFiles.Where(f => f.UploadedBy != Model.StudentId).ToList();
                                        <div class="mb-4">
                                            <h6 class="fw-bold text-primary mb-2"><i class="fas fa-file-pdf me-2"></i>Graded / Feedback Files</h6>
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var file in gFiles)
                                                {
                                                    <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" target="_blank" class="btn btn-outline-primary text-start d-flex align-items-center rounded-3 p-3 text-decoration-none bg-light-primary border-primary border-opacity-25">
                                                        <i class="fas fa-file-pdf text-primary me-3"></i>
                                                        <span class="text-dark fw-bold text-truncate flex-grow-1">@file.FileName</span>
                                                        <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (!isIafLocked)
                                    {
                                        <div class="d-flex gap-3 justify-content-end">
                                            <button type="button" class="btn-draft" onclick="saveDraftAlert()">Save Draft</button>
                                            <button type="submit" class="btn-submit">Submit IAF Form</button>
                                        </div>
                                    }
                                </form>
                            
                        </div>
                    </div>

                    
                    @* ── A. PROPOSAL FORM ────────────────────────────── *@
                    <div class="tab-pane fade @(isIafApproved && !isProposalApproved ? "show active" : "")" id="proposal-form-pane" role="tabpanel" tabindex="0">
                        <div class="premium-card p-4">
                            <h4 class="fw-bold text-dark mb-4"><i class="fas fa-file-signature text-orange me-2"></i>A. Final Year Project Proposal</h4>
                            
                                @* Select corresponding Milestone *@
                                @{
                                    var propMilestone = milestones.FirstOrDefault(m => m.Title.Contains("Proposal", StringComparison.OrdinalIgnoreCase)) ?? milestones.FirstOrDefault();
                                    int propMilestoneId = propMilestone?.Id ?? 0;
                                    bool isPropLocked = propMilestone != null && (propMilestone.Status == "Submitted" || propMilestone.Status == "UnderReview" || propMilestone.Status == "Approved");
                                }
                                
                                @if (propMilestone != null && propMilestone.Status == "Rejected")
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger shadow-sm">
                                        <i class="fas fa-exclamation-circle fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Proposal Form Rejected (Needs Revision)</h5>
                                            <p class="mb-0 text-muted"><strong>Feedback:</strong> @propMilestone.SupervisorFeedback</p>
                                        </div>
                                    </div>
                                }
                                else if (isPropLocked)
                                {
                                    <div class="alert alert-info d-flex align-items-center mt-3 border-info shadow-sm">
                                        <i class="fas fa-lock fs-2 me-3 text-info"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Proposal Form Locked</h5>
                                            <p class="mb-0 text-muted">Your proposal has already been submitted. Current Status: <span class="badge bg-white text-dark ms-1 shadow-sm border">@propMilestone.Status</span></p>
                                            @if (!string.IsNullOrEmpty(propMilestone?.SupervisorFeedback))
                                            {
                                                <hr class="my-2 border-info opacity-25">
                                                <p class="mb-0 text-dark"><strong>Feedback:</strong> @propMilestone.SupervisorFeedback</p>
                                            }

                                            @if (propMilestone?.SubmissionFiles != null && propMilestone.SubmissionFiles.Any(f => f.UploadedBy != Model.StudentId))
                                            {
                                                var gFiles = propMilestone.SubmissionFiles.Where(f => f.UploadedBy != Model.StudentId).ToList();
                                                <hr class="my-3 border-info opacity-25">
                                                <h6 class="fw-bold text-primary mb-2"><i class="fas fa-file-pdf me-2"></i>Graded / Feedback Files</h6>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var file in gFiles)
                                                    {
                                                        <a href="@Url.Action("ViewFile", "Student", new { fileId = file.Id })" target="_blank" class="btn btn-outline-primary text-start d-flex align-items-center rounded-3 p-2 text-decoration-none bg-white border-primary border-opacity-25 shadow-sm">
                                                            <i class="fas fa-file-pdf text-primary me-3"></i>
                                                            <span class="text-dark fw-bold text-truncate flex-grow-1">@file.FileName</span>
                                                            <i class="fas fa-external-link-alt text-primary ms-3"></i>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (!isPropLocked)
                                {
                                <form asp-action="SubmitDigitalForm" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="formType" value="Proposal Form" />
                                    <input type="hidden" name="milestoneId" value="@propMilestoneId" />

                                <div class="form-section-title">Part 1: Proposal Details</div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Project Title</label>
                                    <input type="text" name="title" class="form-control bg-light" value="@Model.Title" readonly required />
                                </div>

                                <div class="mb-4 p-3 rounded-3" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                        <div>
                                            <div class="fw-bold text-dark mb-1"><i class="fas fa-file-word text-primary me-2"></i>FYP Proposal Template</div>
                                            <div class="text-muted small">Download the official Word template pre-filled with your student & project info. Complete it and upload as PDF below.</div>
                                        </div>
                                        <a href="@Url.Action("DownloadProposalTemplate", "Student")"
                                           class="btn btn-outline-dark fw-semibold rounded-3 px-4 py-2 text-decoration-none d-flex align-items-center gap-2"
                                           style="white-space: nowrap;">
                                            <i class="fas fa-download"></i> Download Template (.docx)
                                        </a>
                                    </div>
                                </div>

                                <div class="form-section-title">Part 2: Document Attachment</div>
                                <div class="mb-4">
                                    <div class="drag-drop-zone p-4 text-center border rounded-3" style="border: 2px dashed #cbd5e1 !important; background: #f8fafc; cursor: pointer; transition: all 0.3s ease;" id="dropZone" onclick="document.getElementById('proposalDocument').click()">
                                        <i class="fas fa-cloud-upload-alt fs-1 mb-3" style="color: var(--primary-orange) !important;"></i>
                                        <h6 class="fw-bold mb-1">Drag & Drop your proposal here</h6>
                                        <p class="text-muted small mb-0">or click to browse files (PDF ONLY)</p>
                                        <p class="text-danger fw-bold small mt-2 mb-0">* Required</p>
                                        <input type="file" name="attachedFile" id="proposalDocument" class="d-none" accept=".pdf" required onchange="updateFileName(this)" />
                                        <div id="fileNameDisplay" class="mt-3 fw-bold text-success" style="display:none;">
                                            <i class="fas fa-file-pdf me-2"></i><span id="fName"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex gap-3 justify-content-end">
                                    <button type="button" class="btn-draft" onclick="saveDraftAlert()">Save Draft</button>
                                    <button type="submit" class="btn-submit">Submit Proposal</button>
                                </div>
                            </form>
                            }
                        </div>
                    </div>

                    @* ── B. PROGRESS REPORT FORM ─────────────────────── *@
                    <div class="tab-pane fade @(isProposalApproved && !isAllProgressApproved ? "show active" : "")" id="progress-form-pane" role="tabpanel" tabindex="0">
                        <div class="premium-card p-4">
                            <h4 class="fw-bold text-dark mb-4"><i class="fas fa-chart-line text-orange me-2"></i>B. FYP Progress Report Form</h4>
                            
                            @{
                                var progressMilestones = milestones.Where(x => 
                                    (x.Status == "Pending" || x.Status == "Rejected")
                                    && !x.Title.Contains("Proposal", StringComparison.OrdinalIgnoreCase) 
                                    && !x.Title.Contains("Final", StringComparison.OrdinalIgnoreCase)).ToList();
                            }
                            
                            @if (!progressMilestones.Any())
                            {
                                <div class="alert alert-info d-flex align-items-center mt-3 border-info shadow-sm">
                                    <i class="fas fa-lock fs-2 me-3 text-info"></i>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">Progress Report Form Locked</h5>
                                        <p class="mb-0 text-muted">You have no pending progress report milestones to submit at this time.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @foreach (var rm in progressMilestones.Where(x => x.Status == "Rejected"))
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger shadow-sm">
                                        <i class="fas fa-exclamation-circle fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">@rm.Title Rejected (Needs Revision)</h5>
                                            <p class="mb-0 text-muted"><strong>Feedback:</strong> @rm.SupervisorFeedback</p>
                                        </div>
                                    </div>
                                }
                            <form asp-action="SubmitDigitalForm" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                                <input type="hidden" name="formType" value="Progress Report Form" />

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark" style="font-size: 0.95rem;">Select Milestone to Report On</label>
                                    <select name="milestoneId" id="progressMilestoneSelect" class="form-select" required onchange="toggleProgressTemplate(this)">
                                        <option value="">-- Choose a Milestone --</option>
                                        @foreach (var m in progressMilestones)
                                        {
                                            <option value="@m.Id">@m.Title (@m.Status)</option>
                                        }
                                    </select>
                                    <div class="invalid-feedback">Please select a milestone.</div>
                                </div>

                                <div id="progressTemplateSection" class="mb-4 p-3 rounded-3" style="background: #f8fafc; border: 1px dashed #cbd5e1; display: none;">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                        <div>
                                            <div class="fw-bold text-dark mb-1"><i class="fas fa-file-word text-primary me-2"></i>FYP Progress Report Template</div>
                                            <div class="text-muted small">Select a milestone above to download the pre-filled Word template for that specific progress report.</div>
                                        </div>
                                        <a href="@Url.Action("DownloadProgressTemplate", "Student")"
                                           id="btnDownloadProgress"
                                           class="btn btn-outline-dark fw-semibold rounded-3 px-4 py-2 text-decoration-none d-flex align-items-center gap-2"
                                           style="white-space: nowrap;">
                                            <i class="fas fa-download"></i> Download Template (.docx)
                                        </a>
                                    </div>
                                </div>

                                <div class="form-section-title">Part 1: Reporting Period</div>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Start Period</label>
                                        <input type="date" name="startDate" class="form-control" required />
                                        <div class="invalid-feedback">Start date is required.</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">End Period</label>
                                        <input type="date" name="endDate" class="form-control" required />
                                        <div class="invalid-feedback">End date is required.</div>
                                    </div>
                                </div>

                                <div class="form-section-title">Part 2: Document Attachment</div>
                                <div class="row g-3 mb-4">
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold mb-2">Attach Supporting Files (Optional)</label>
                                        <div class="drag-drop-zone p-4 text-center border rounded-3" style="border: 2px dashed #cbd5e1 !important; background: #f8fafc; cursor: pointer; transition: all 0.3s ease;" id="progressDropZone" onclick="document.getElementById('progressFiles').click()">
                                            <i class="fas fa-copy fs-1 mb-3" style="color: #3b82f6 !important;"></i>
                                            <h6 class="fw-bold mb-1">Drag & Drop your files here</h6>
                                            <p class="text-muted small mb-0">or click to browse (PDF ONLY)</p>
                                            <input type="file" name="attachedFiles" id="progressFiles" class="d-none" accept=".pdf" multiple onchange="updateMultiFileNames(this, 'progressFileList')" />
                                            <div id="progressFileList" class="mt-3 text-start small fw-semibold text-primary" style="display:none; max-width: 300px; margin: auto;">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex gap-3 justify-content-end">
                                    <button type="button" class="btn-draft" onclick="saveDraftAlert()">Save Draft</button>
                                    <button type="submit" class="btn-submit">Submit Progress Report</button>
                                </div>
                            </form>
                            }
                        </div>
                    </div>

                    @* ── C. FINAL SUBMISSION FORM ────────────────────── *@
                    <div class="tab-pane fade @(isAllProgressApproved ? "show active" : "")" id="final-form-pane" role="tabpanel" tabindex="0">
                        <div class="premium-card p-4">
                            <h4 class="fw-bold text-dark mb-4"><i class="fas fa-graduation-cap text-orange me-2"></i>C. Final FYP Report & Thesis Submission</h4>
                            
                                @* Select corresponding Milestone *@
                                @{
                                    var finalMilestone = milestones.FirstOrDefault(m => m.Title.Contains("Final") || m.Title.Contains("Thesis")) ?? milestones.LastOrDefault();
                                    int finalMilestoneId = finalMilestone?.Id ?? 0;
                                    bool isFinLocked = finalMilestone != null && (finalMilestone.Status == "Submitted" || finalMilestone.Status == "UnderReview" || finalMilestone.Status == "Approved");
                                }
                                
                                @if (finalMilestone != null && finalMilestone.Status == "Rejected")
                                {
                                    <div class="alert alert-danger d-flex align-items-center mt-3 border-danger shadow-sm">
                                        <i class="fas fa-exclamation-circle fs-2 me-3 text-danger"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Final Submission Rejected (Needs Revision)</h5>
                                            <p class="mb-0 text-muted"><strong>Feedback:</strong> @finalMilestone.SupervisorFeedback</p>
                                        </div>
                                    </div>
                                }
                                else if (isFinLocked)
                                {
                                    <div class="alert alert-info d-flex align-items-center mt-3 border-info shadow-sm">
                                        <i class="fas fa-lock fs-2 me-3 text-info"></i>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">Final Submission Locked</h5>
                                                <p class="mb-0 text-muted">Your final submission is currently: <span class="badge bg-white text-dark ms-1 shadow-sm border">@finalMilestone.Status</span></p>
                                            @if (!string.IsNullOrEmpty(finalMilestone?.SupervisorFeedback))
                                            {
                                                <hr class="my-2 border-info opacity-25">
                                                <p class="mb-0 text-dark"><strong>Feedback:</strong> @finalMilestone.SupervisorFeedback</p>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (!isFinLocked)
                                {
                                <form asp-action="SubmitDigitalForm" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                                    <input type="hidden" name="formType" value="Final Submission Form" />
                                    <input type="hidden" name="milestoneId" value="@finalMilestoneId" />

                                <div class="mb-4 p-3 rounded-3" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                        <div>
                                            <div class="fw-bold text-dark mb-1"><i class="fas fa-file-word text-primary me-2"></i>FYP Final Thesis Template</div>
                                            <div class="text-muted small">Download the official University template containing the correct structure (Cover, Abstract, TOC, Chapters).</div>
                                        </div>
                                        <a href="@Url.Action("DownloadFinalTemplate", "Student")"
                                           class="btn btn-outline-dark fw-semibold rounded-3 px-4 py-2 text-decoration-none d-flex align-items-center gap-2"
                                           style="white-space: nowrap;">
                                            <i class="fas fa-download"></i> Download Template (.docx)
                                        </a>
                                    </div>
                                </div>

                                <div class="form-section-title">Part 1: Thesis Metadata</div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Final Project Title</label>
                                    <input type="text" name="title" class="form-control bg-light" value="@Model.Title" readonly required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Abstract</label>
                                    <textarea name="abstract" class="form-control" rows="4" required placeholder="Enter the project abstract..."></textarea>
                                    <div class="invalid-feedback">Please provide an abstract.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Acknowledgements</label>
                                    <textarea name="acknowledgements" class="form-control" rows="2" placeholder="Acknowledge individuals and academic support..."></textarea>
                                </div>

                                <div class="form-section-title">Part 2: Project Repos & Viva</div>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Link to Source Code Repository (Optional)</label>
                                        <input type="url" name="sourceCodeLink" class="form-control" placeholder="GitHub, GitLab, etc." />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Viva Oral Examination Date (Assigned by faculty)</label>
                                        <input type="text" class="form-control bg-light border-0" value="TBA — Awaiting Final review" readonly />
                                    </div>
                                </div>

                                <div class="form-section-title">Part 3: Final File Upload</div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold mb-2">Upload Final Thesis (PDF, Max 20MB)</label>
                                    <div class="drag-drop-zone p-4 text-center border rounded-3" style="border: 2px dashed #cbd5e1 !important; background: #f8fafc; cursor: pointer; transition: all 0.3s ease;" id="finalDropZone" onclick="document.getElementById('finalDocument').click()">
                                        <i class="fas fa-cloud-upload-alt fs-1 mb-3" style="color: #ef4444 !important;"></i>
                                        <h6 class="fw-bold mb-1">Drag & Drop your final thesis here</h6>
                                        <p class="text-muted small mb-0">or click to browse files (PDF ONLY)</p>
                                        <p class="text-danger fw-bold small mt-2 mb-0">* Required</p>
                                        <input type="file" name="attachedFile" id="finalDocument" class="d-none" accept=".pdf" required onchange="updateFileNameForFinal(this)" />
                                        <div id="finalFileNameDisplay" class="mt-3 fw-bold text-danger" style="display:none;">
                                            <i class="fas fa-file-pdf me-2"></i><span id="fFinalName"></span>
                                        </div>
                                    </div>
                                    <div class="invalid-feedback d-block" id="finalFileError" style="display:none;">Please upload your final thesis PDF.</div>
                                </div>

                                <div class="d-flex gap-3 justify-content-end">
                                    <button type="submit" class="btn-submit bg-dark border-0">
                                        <i class="fas fa-file-pdf me-1"></i> Submit Final Report
                                    </button>
                                </div>
                            </form>
                                }
                        </div>
                    </div>

                </div>
            </div>
            
        </div>
    }

</div>

<script>
    function saveDraftAlert() {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                icon: 'info',
                title: 'Draft Saved',
                text: 'Draft saved successfully in the session! You can continue editing later.',
                confirmButtonColor: '#3b82f6',
                background: '#ffffff',
                customClass: { popup: 'rounded-4 shadow-sm border-0' }
            });
        } else {
            alert("Draft saved successfully in the session! You can continue editing later.");
        }
    }
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Drag and Drop Logic
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('proposalDocument');
        
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, preventDefaults, false);
        });
        
        function preventDefaults (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        
        ['dragenter', 'dragover'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, () => dropZone.style.borderColor = 'var(--primary-orange)', false);
        });
        
        ['dragleave', 'drop'].forEach(eventName => {
            if(dropZone) dropZone.addEventListener(eventName, () => dropZone.style.borderColor = '#cbd5e1', false);
        });
        
        if(dropZone) {
            dropZone.addEventListener('drop', (e) => {
                let dt = e.dataTransfer;
                let files = dt.files;
                fileInput.files = files;
                updateFileName(fileInput);
            }, false);
        }

        function updateFileName(input) {
            const display = document.getElementById('fileNameDisplay');
            const fName = document.getElementById('fName');
            if (input.files && input.files.length > 0) {
                fName.textContent = input.files[0].name;
                display.style.display = 'block';
            } else {
                display.style.display = 'none';
            }
        }
        
        function updateFileNameForFinal(input) {
            const display = document.getElementById('finalFileNameDisplay');
            const fName = document.getElementById('fFinalName');
            const errorLabel = document.getElementById('finalFileError');
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
                    errorLabel.textContent = "Only PDF files are allowed.";
                    errorLabel.style.display = 'block';
                    input.value = "";
                    display.style.display = 'none';
                    return;
                }
                if (file.size > 20 * 1024 * 1024) {
                    errorLabel.textContent = "File size exceeds 20MB limit.";
                    errorLabel.style.display = 'block';
                    input.value = "";
                    display.style.display = 'none';
                    return;
                }
                
                errorLabel.style.display = 'none';
                fName.textContent = file.name;
                display.style.display = 'block';
            } else {
                display.style.display = 'none';
            }
        }
        
        function updateMultiFileNames(input, listId) {
            const display = document.getElementById(listId);
            display.innerHTML = '';
            if (input.files && input.files.length > 0) {
                display.style.display = 'block';
                Array.from(input.files).forEach(file => {
                    const fileDiv = document.createElement('div');
                    fileDiv.className = 'mb-1';
                    fileDiv.innerHTML = '<i class="fas fa-file-alt me-2 text-primary"></i>' + file.name;
                    display.appendChild(fileDiv);
                });
            } else {
                display.style.display = 'none';
            }
        }
        
        // Setup Progress Drop Zone
        const progDropZone = document.getElementById('progressDropZone');
        const progFileInput = document.getElementById('progressFiles');
        if (progDropZone && progFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                progDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                progDropZone.addEventListener(eventName, () => progDropZone.style.borderColor = '#3b82f6', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                progDropZone.addEventListener(eventName, () => progDropZone.style.borderColor = '#cbd5e1', false);
            });
            progDropZone.addEventListener('drop', (e) => {
                progFileInput.files = e.dataTransfer.files;
                updateMultiFileNames(progFileInput, 'progressFileList');
            }, false);
        }

        // Setup Final Drop Zone
        const finalDropZone = document.getElementById('finalDropZone');
        const finalFileInput = document.getElementById('finalDocument');
        if (finalDropZone && finalFileInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, preventDefaults, false);
            });
            ['dragenter', 'dragover'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, () => finalDropZone.style.borderColor = '#ef4444', false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                finalDropZone.addEventListener(eventName, () => finalDropZone.style.borderColor = '#cbd5e1', false);
            });
            finalDropZone.addEventListener('drop', (e) => {
                finalFileInput.files = e.dataTransfer.files;
                updateFileNameForFinal(finalFileInput);
            }, false);
        }
        
        (function() {
            var successMsg = '@Html.Raw(TempData["Success"])';
            var errorMsg = '@Html.Raw(TempData["Error"])';
            
            if (successMsg && successMsg.trim() !== '') {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: successMsg,
                    confirmButtonColor: '#f97316',
                    background: '#ffffff',
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            }
            
            if (errorMsg && errorMsg.trim() !== '') {
                Swal.fire({
                    icon: 'error',
                    title: 'Submission Failed',
                    text: errorMsg,
                    confirmButtonColor: '#ef4444',
                    background: '#ffffff',
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            }

            // Bootstrap Form Validation
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });

            // --- AUTO SAVE FEATURE ---
            const formsToSave = document.querySelectorAll('form.needs-validation');
            formsToSave.forEach(form => {
                const formTypeInput = form.querySelector('input[name="formType"]');
                if(!formTypeInput) return;
                
                const storageKey = 'fyp_draft_' + formTypeInput.value.replace(/\s+/g, '_');
                
                // 1. Restore from Draft
                const savedDraft = localStorage.getItem(storageKey);
                if (savedDraft) {
                    try {
                        const data = JSON.parse(savedDraft);
                        for (const key in data) {
                            const field = form.querySelector(`[name="${key}"]`);
                            if (field && !field.readOnly && field.type !== 'file' && field.type !== 'hidden') {
                                field.value = data[key];
                            }
                        }
                    } catch(e) {}
                }
                
                // 2. Save to Draft on Input (debounced)
                let timeout;
                form.addEventListener('input', function(e) {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        const data = {};
                        const formData = new FormData(form);
                        for (let [key, value] of formData.entries()) {
                            const field = form.querySelector(`[name="${key}"]`);
                            if (field && !field.readOnly && field.type !== 'file' && field.type !== 'hidden') {
                                data[key] = value;
                            }
                        }
                        localStorage.setItem(storageKey, JSON.stringify(data));
                    }, 1000);
                });
                
                // 3. Clear Draft on Submit
                form.addEventListener('submit', function(e) {
                    if (form.checkValidity()) {
                        localStorage.removeItem(storageKey);
                    }
                });
            });
            // Initialize Tooltips using jQuery (Bootstrap 4 compatibility)
            try {
                $('[data-toggle="tooltip"]').tooltip();
                $('[data-bs-toggle="tooltip"]').tooltip();
            } catch(e) {}
            
        })();

        document.addEventListener("DOMContentLoaded", async function() {
            const source = document.getElementById('iafPdfSource');
            const iframe = document.getElementById('iafPdfIframe');
            
            if (source && iframe) {
                if (typeof html2pdf === 'undefined') return;

                const opt = {
                    margin: 0.5,
                    filename: 'FormDetails.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true },
                    jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
                };

                const htmlString = `
                    <div style="width: 800px; padding: 20px; background: white;">
                        ${source.innerHTML}
                    </div>
                `;

                try {
                    const pdfBlob = await html2pdf().set(opt).from(htmlString).outputPdf('blob');
                    const url = URL.createObjectURL(pdfBlob);
                    iframe.src = url;
                } catch(e) {
                    console.error("PDF generation failed", e);
                    iframe.parentElement.innerHTML = '<div class="alert alert-warning m-3">Failed to load PDF preview.</div>';
                }
            }
        });

        function toggleProgressTemplate(selectObj) {
            const templateSection = document.getElementById('progressTemplateSection');
            const downloadBtn = document.getElementById('btnDownloadProgress');
            if (selectObj.value) {
                templateSection.style.display = 'block';
                downloadBtn.href = '@Url.Action("DownloadProgressTemplate", "Student")?milestoneId=' + selectObj.value;
            } else {
                templateSection.style.display = 'none';
            }
        }
    </script>
}


