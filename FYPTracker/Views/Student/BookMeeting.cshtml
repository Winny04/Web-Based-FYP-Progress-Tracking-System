<!-- Reschedule Modal -->
<div class="modal fade" id="rescheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form asp-action="RescheduleMeeting" method="post" id="studentRescheduleForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="meetingId" id="reschedMeetingId" />
                <input type="hidden" id="reschedOriginalDate" />
                <input type="hidden" id="reschedOriginalTime" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-calendar-check text-primary me-2"></i>Reschedule Meeting</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Current Meeting Info -->
                    <div class="alert alert-light border py-2 px-3 small mb-3">
                        <span class="text-muted"><i class="fas fa-calendar-alt text-primary me-1"></i>Current Meeting:</span>
                        <strong id="reschedOriginalDateTime" class="text-dark ms-1"></strong>
                    </div>

                    <!-- Date Picker -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Date</label>
                        @{
                            var rSession = ViewBag.ActiveSession as AcademicSession;
                            var rCutoff = (DateTime?)ViewBag.MeetingBookingCutoff;
                            DateTime rMinDate = DateTime.Today;
                            DateTime rMaxDate = DateTime.Today;
                            bool rNoValidDates = true;

                            if (rSession?.StartDate is DateTime rStart &&
                                rSession.EndDate is DateTime rEnd &&
                                rCutoff.HasValue)
                            {
                                rMinDate = rStart.Date > DateTime.Today ? rStart.Date : DateTime.Today;
                                rMaxDate = rCutoff.Value.Date < rEnd.Date ? rCutoff.Value.Date : rEnd.Date;
                                rNoValidDates = rMinDate > rMaxDate;
                            }
                        }
                        @if (rNoValidDates)
                        {
                            <div class="alert alert-warning">No available dates in this academic session.</div>
                        }
                        else
                        {
                            <input type="date"
                                   name="meetingDate"
                                   id="reschedDateInput"
                                   class="form-control"
                                   required
                                   onchange="updateReschedAvailability()"
                                   min="@rMinDate.ToString("yyyy-MM-dd")"
                                   max="@rMaxDate.ToString("yyyy-MM-dd")" />
                        }
                    </div>

                    <!-- Available Slots Grid -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Available Slots</label>
                        <input type="hidden" name="meetingTime" id="reschedTimeInput" required />
                        <div id="reschedSameScheduleError" class="alert alert-warning py-2 small mb-2" style="display:none;">
                            <i class="fas fa-exclamation-triangle me-1"></i> The proposed date and time are the same as your current meeting. Please select a different date or time.
                        </div>
                        <div id="reschedAlertContainer"></div>
                        <div class="row g-2" id="reschedTimeSlots">
                            <div class="col-12 text-muted small"><i class="fas fa-arrow-up"></i> Please pick a date first to see available slots.</div>
                        </div>
                        <div id="reschedTimeError" class="text-danger mt-2 small" style="display:none;">Please pick an available time slot.</div>
                    </div>

                    <!-- Reason -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason for Rescheduling</label>
                        <textarea name="reason" class="form-control rounded-3" rows="2" required minlength="10" placeholder="e.g. I'm feeling unwell and won't be able to attend the meeting..."></textarea>
                    </div>

                    <div class="alert alert-info py-2 small mb-0">
                        <i class="fas fa-info-circle"></i> Your meeting date will not change until your Supervisor approves this request.
                    </div>
                </div>
                
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="submitRescheduleBtn" class="btn btn-primary px-4 rounded-3" disabled="@rNoValidDates">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const supervisorId = @(assignedSupervisor?.Id ?? 0);
    const timeInput    = document.getElementById('meetingTimeInput');
    const timeError    = document.getElementById('timeError');

    // ── Day auto-fill ──────────────────────────────────────────
    function calculateDay() {
        const val = document.getElementById('meetingDate').value;
        if (val) {
            const d = new Date(val + 'T00:00:00');
            document.getElementById('meetingDay').value =
                new Intl.DateTimeFormat('en-US', { weekday: 'long' }).format(d);
            updateAvailability();
        } else {
            document.getElementById('meetingDay').value = '';
        }
    }

    // ── Fetch & mark booked slots (Book modal) ──────────────────
    async function updateAvailability() {
        const dateVal = document.getElementById('meetingDate')?.value;
        const alertBox = document.getElementById('meetingAlertContainer');
        const submitBtn = document.getElementById('submitBookingBtn');
        const container = document.getElementById('timeSlotsContainer');

        if (timeInput) timeInput.value = '';
        if (alertBox) alertBox.innerHTML = '';
        if (timeError) timeError.style.display = 'none';

        if (!dateVal || supervisorId === 0) return;
        if (!container) return;

        container.innerHTML = '<div class="col-12 text-center text-muted py-2"><div class="spinner-border spinner-border-sm me-2"></div>Loading slots...</div>';
        if (submitBtn) submitBtn.disabled = true;

        try {
            const resp = await fetch(`/Student/GetAvailableSlots?supervisorId=${supervisorId}&date=${dateVal}`);
            const data = await resp.json();
            
            container.innerHTML = '';
            
            // 1. One meeting per week rule triggered
            if (data.hasExistingMeetingThisWeek) {
                let rescheduleBtnHtml = '';
                if (data.canReschedule && data.existingMeetingStatus === 'Approved') {
                    rescheduleBtnHtml = `
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="switchToReschedule(${data.existingMeetingId}, '${data.existingMeetingDate}', '${data.existingMeetingTime}')">
                                <i class="fas fa-calendar-alt me-1"></i> Request Reschedule Instead
                            </button>
                        </div>`;
                }
                if (alertBox) {
                    alertBox.innerHTML = `
                        <div class="alert alert-warning py-2 small mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-exclamation-triangle mt-1 me-2 text-warning"></i>
                                <div>
                                    <strong>Weekly Limit Reached</strong><br />
                                    ${data.message}
                                    ${rescheduleBtnHtml}
                                </div>
                            </div>
                        </div>`;
                }
                container.innerHTML = `<div class="col-12 text-muted small py-2"><i class="fas fa-ban me-1"></i> Booking unavailable because a meeting is already scheduled for this week.</div>`;
                if (submitBtn) submitBtn.disabled = true;
                return;
            }

            // 2. Day mismatch for recurring weekly schedule
            if (data.isDayMismatch) {
                if (alertBox) {
                    alertBox.innerHTML = `
                        <div class="alert alert-info py-2 small mb-3">
                            <i class="fas fa-calendar-day me-1"></i>
                            <strong>Recurring Schedule Day Mismatch</strong><br />
                            ${data.message}
                        </div>`;
                }
                container.innerHTML = `<div class="col-12 text-muted small py-2"><i class="fas fa-info-circle me-1"></i> Please choose a ${data.lockedDay} to schedule your recurring meeting.</div>`;
                if (submitBtn) submitBtn.disabled = true;
                return;
            }

            // 3. Locked slot conflict
            if (data.isLockedTimeConflicted) {
                if (alertBox) {
                    alertBox.innerHTML = `
                        <div class="alert alert-danger py-2 small mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-times-circle mt-1 me-2"></i>
                                <div>
                                    <strong>Locked Slot Conflict</strong><br />
                                    ${data.message}
                                </div>
                            </div>
                        </div>`;
                }
                container.innerHTML = `<div class="col-12 text-center text-danger fw-semibold py-2"><i class="fas fa-ban me-1"></i> ${data.lockedTimeDisplay} is unavailable on this date.</div>`;
                if (submitBtn) submitBtn.disabled = true;
                return;
            }

            // 4. Locked slot confirmed available
            if (data.isLocked) {
                if (alertBox) {
                    alertBox.innerHTML = `
                        <div class="alert alert-success py-2 small mb-3">
                            <i class="fas fa-lock me-1"></i>
                            <strong>Confirmed Weekly Time:</strong> Your recurring slot at ${data.lockedTimeDisplay} is available on this date.
                        </div>`;
                }
                if (timeInput) timeInput.value = data.lockedTime;
                container.innerHTML = `
                    <div class="col-12">
                        <div class="time-slot selected pe-none bg-success text-white fw-bold py-2 text-center" style="cursor: default;">
                            <i class="fas fa-check-circle me-1"></i> ${data.lockedTimeDisplay} (Locked Recurring Slot)
                        </div>
                    </div>`;
                if (submitBtn) submitBtn.disabled = false;
                return;
            }

            // 5. Explicit error or no availability
            if (data.noAvailability) {
                container.innerHTML = `<div class="col-12 text-center text-danger fw-bold"><i class="fas fa-exclamation-triangle me-1"></i>${data.message}</div>`;
                if (submitBtn) submitBtn.disabled = true;
                return;
            }

            // 6. Normal open slots
            if (data.slots && data.slots.length > 0) {
                data.slots.forEach((rawTime, idx) => {
                    const displayTime = (data.displaySlots && data.displaySlots[idx]) ? data.displaySlots[idx] : rawTime;
                    const col = document.createElement('div');
                    col.className = 'col-4';
                    col.innerHTML = `<div class="time-slot" data-time="${rawTime}" onclick="selectTime(this, 'timeSlotsContainer', 'meetingTimeInput', 'timeError')">${displayTime}</div>`;
                    container.appendChild(col);
                });
                if (submitBtn) submitBtn.disabled = false;
            } else {
                container.innerHTML = `<div class="col-12 text-center text-danger fw-bold"><i class="fas fa-exclamation-circle me-1"></i>${data.message || 'No available slots on this date.'}</div>`;
                if (submitBtn) submitBtn.disabled = true;
            }
        } catch (err) { 
            console.error(err); 
            container.innerHTML = '<div class="col-12 text-center text-danger">Error loading slots.</div>';
            if (submitBtn) submitBtn.disabled = true;
        }
    }

    function switchToReschedule(meetingId, date, timeDisplay, rawTime) {
        const scheduleModalEl = document.getElementById('scheduleMeetingModal');
        if (scheduleModalEl) {
            const modalInstance = bootstrap.Modal.getInstance(scheduleModalEl);
            if (modalInstance) {
                modalInstance.hide();
            }
        }
        openRescheduleModal(meetingId, date, timeDisplay, rawTime || timeDisplay);
    }

    // ── Generic slot selector ───────────────────────────────────
    function selectTime(el, containerId, inputId, errorId) {
        if (el.classList.contains('booked')) return;
        document.getElementById(containerId).querySelectorAll('.time-slot')
            .forEach(s => s.classList.remove('selected'));
        el.classList.add('selected');
        document.getElementById(inputId).value = el.dataset.time;
        const err = document.getElementById(errorId);
        if (err) err.style.display = 'none';
        if (inputId === 'reschedTimeInput') {
            validateStudentRescheduleSchedule();
        }
    }

    // ── Realtime Validation for Reason ──────────────────────────
    const meetingReason = document.getElementById('meetingReason');
    const meetingReasonError = document.getElementById('meetingReasonError');
    if (meetingReason && meetingReasonError) {
        meetingReason.addEventListener('input', function() {
            if (this.value.trim().length >= 10) {
                this.classList.remove('is-invalid');
                this.classList.add('is-valid');
                meetingReasonError.classList.add('d-none');
            } else {
                this.classList.remove('is-valid');
                this.classList.add('is-invalid');
                meetingReasonError.classList.remove('d-none');
            }
        });
    }

    // ── Book meeting form validation ────────────────────────────
    document.getElementById('bookingForm')?.addEventListener('submit', function(e) {
        const dateVal = document.getElementById('meetingDate')?.value;
        const timeVal = timeInput?.value;

        if (!dateVal) {
            Swal.fire('Missing Date', 'Please select a meeting date.', 'warning');
            e.preventDefault();
            return;
        }
        if (!timeVal) {
            e.preventDefault();
            if (timeError) timeError.style.display = 'block';
            Swal.fire('Missing Time', 'Please select an available time slot.', 'warning');
            return;
        }

        // Reason validation
        if (meetingReason && meetingReason.value.trim().length < 10) {
            e.preventDefault();
            meetingReason.classList.add('is-invalid');
            meetingReasonError.classList.remove('d-none');
            return;
        }

        // Debouncing: disable button on successful validation
        const submitBtn = e.target.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Booking...';
        }
    });

    // ── Reschedule modal (Approved → change date/time) ───────────
    const reschedTimeInput = document.getElementById('reschedTimeInput');
    const reschedTimeError = document.getElementById('reschedTimeError');

    function normalizeTimeTo24h(timeStr) {
        if (!timeStr) return '';
        timeStr = timeStr.trim();
        const match = timeStr.match(/^(\d{1,2}):(\d{2})(?:\s*([AP]M))?$/i);
        if (match) {
            let hours = parseInt(match[1], 10);
            const minutes = match[2];
            const modifier = match[3] ? match[3].toUpperCase() : null;
            if (modifier === 'PM' && hours < 12) hours += 12;
            if (modifier === 'AM' && hours === 12) hours = 0;
            return `${String(hours).padStart(2, '0')}:${minutes}`;
        }
        return timeStr;
    }

    function validateStudentRescheduleSchedule() {
        const origDate = document.getElementById('reschedOriginalDate')?.value;
        const origTime = document.getElementById('reschedOriginalTime')?.value;
        const proposedDate = document.getElementById('reschedDateInput')?.value;
        const proposedTime = document.getElementById('reschedTimeInput')?.value;
        const submitBtn = document.getElementById('submitRescheduleBtn');
        const errAlert = document.getElementById('reschedSameScheduleError');

        if (proposedDate && proposedTime && origDate && origTime) {
            if (proposedDate === origDate && normalizeTimeTo24h(proposedTime) === normalizeTimeTo24h(origTime)) {
                if (errAlert) errAlert.style.display = 'block';
                if (submitBtn) submitBtn.disabled = true;
                return false;
            }
        }
        if (errAlert) errAlert.style.display = 'none';
        if (proposedTime && submitBtn) submitBtn.disabled = false;
        return true;
    }

    function openRescheduleModal(id, date, timeDisplay, rawTime) {
        document.getElementById('reschedMeetingId').value = id;
        document.getElementById('reschedDateInput').value = date;
        const origDateEl = document.getElementById('reschedOriginalDate');
        const origTimeEl = document.getElementById('reschedOriginalTime');
        if (origDateEl) origDateEl.value = date || '';
        if (origTimeEl) origTimeEl.value = rawTime || timeDisplay || '';

        const origEl = document.getElementById('reschedOriginalDateTime');
        if (origEl) {
            let formattedDate = date;
            try {
                const parts = date.split('-');
                if (parts.length === 3) {
                    const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
                    formattedDate = new Intl.DateTimeFormat('en-US', { day: '2-digit', month: 'short', year: 'numeric' }).format(d);
                }
            } catch (e) {}
            origEl.textContent = `${formattedDate} at ${timeDisplay || ''}`.trim();
        }
        if (reschedTimeInput) reschedTimeInput.value = '';
        const alertBox = document.getElementById('reschedAlertContainer');
        if (alertBox) alertBox.innerHTML = '';
        if (reschedTimeError) reschedTimeError.style.display = 'none';
        const sameSchedErr = document.getElementById('reschedSameScheduleError');
        if (sameSchedErr) sameSchedErr.style.display = 'none';

        updateReschedAvailability();
        const modalEl = document.getElementById('rescheduleModal');
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    async function updateReschedAvailability() {
        const dateVal = document.getElementById('reschedDateInput')?.value;
        const meetingIdVal = document.getElementById('reschedMeetingId')?.value;
        const submitBtn = document.getElementById('submitRescheduleBtn');
        const alertBox = document.getElementById('reschedAlertContainer');
        const container = document.getElementById('reschedTimeSlots');
        const sameSchedErr = document.getElementById('reschedSameScheduleError');

        if (reschedTimeInput) reschedTimeInput.value = '';
        if (alertBox) alertBox.innerHTML = '';
        if (reschedTimeError) reschedTimeError.style.display = 'none';
        if (sameSchedErr) sameSchedErr.style.display = 'none';

        if (!dateVal || supervisorId === 0 || !container) return;

        container.innerHTML = '<div class="col-12 text-center text-muted py-2"><div class="spinner-border spinner-border-sm me-2"></div>Loading slots...</div>';
        if (submitBtn) submitBtn.disabled = true;

        try {
            let url = `/Student/GetAvailableSlots?supervisorId=${supervisorId}&date=${dateVal}`;
            if (meetingIdVal) {
                url += `&excludeMeetingId=${meetingIdVal}`;
            }
            const resp = await fetch(url);
            const data = await resp.json();
            
            container.innerHTML = '';
            
            if (data.hasExistingMeetingThisWeek) {
                if (alertBox) {
                    alertBox.innerHTML = `
                        <div class="alert alert-warning py-2 small mb-2">
                            <i class="fas fa-exclamation-triangle me-1"></i> ${data.message}
                        </div>`;
                }
                container.innerHTML = `<div class="col-12 text-muted small py-2"><i class="fas fa-ban me-1"></i> You already have another meeting scheduled for this week.</div>`;
                if (submitBtn) submitBtn.disabled = true;
                return;
            }

            if (data.noAvailability) {
                container.innerHTML = `<div class="col-12 text-center text-danger fw-bold"><i class="fas fa-exclamation-triangle me-1"></i>${data.message}</div>`;
                if (submitBtn) submitBtn.disabled = true;
                return;
            }

            if (data.slots && data.slots.length > 0) {
                data.slots.forEach((rawTime, idx) => {
                    const displayTime = (data.displaySlots && data.displaySlots[idx]) ? data.displaySlots[idx] : rawTime;
                    const col = document.createElement('div');
                    col.className = 'col-4';
                    col.innerHTML = `<div class="time-slot" data-time="${rawTime}" onclick="selectTime(this, 'reschedTimeSlots', 'reschedTimeInput', 'reschedTimeError')">${displayTime}</div>`;
                    container.appendChild(col);
                });
                if (submitBtn) submitBtn.disabled = false;
            } else {
                container.innerHTML = `<div class="col-12 text-center text-danger fw-bold"><i class="fas fa-exclamation-circle me-1"></i>${data.message || 'No available slots on this date.'}</div>`;
                if (submitBtn) submitBtn.disabled = true;
            }
        } catch (err) { 
            console.error(err); 
            container.innerHTML = '<div class="col-12 text-center text-danger">Error loading slots.</div>';
            if (submitBtn) submitBtn.disabled = true;
        }
    }

    document.getElementById('studentRescheduleForm')?.addEventListener('submit', function(e) {
        if (!reschedTimeInput?.value) {
            e.preventDefault();
            if (reschedTimeError) reschedTimeError.style.display = 'block';
            Swal.fire('Missing Time', 'Please select a time slot.', 'warning');
            return;
        }
        if (!validateStudentRescheduleSchedule()) {
            e.preventDefault();
            Swal.fire('Unchanged Schedule', 'The proposed date and time are the same as your current meeting. Please select a different date or time.', 'warning');
            return;
        }
        const submitBtn = document.getElementById('submitRescheduleBtn');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Submitting...';
        }
    });

    // ── Cancel confirmation ─────────────────────────────────────
    function confirmCancel(id) {
        Swal.fire({
            title: 'Cancel Request?',
            text: 'Are you sure you want to cancel this meeting request?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, cancel it'
        }).then(result => {
            if (result.isConfirmed)
                document.getElementById('cancelForm_' + id).submit();
        });
    }

    // ── View Meeting Details popup ──────────────────────────────
    function viewMeetingDetails(btn) {
        const status       = btn.getAttribute('data-status');
        const note         = btn.getAttribute('data-note');
        const originalDate = btn.getAttribute('data-date');
        const proposedDate = btn.getAttribute('data-proposed-date');
        const location     = btn.getAttribute('data-location');
        const meetingLink  = btn.getAttribute('data-meetinglink');

        let iconType = 'info';
        if (status === 'Approved')  iconType = 'success';
        if (status === 'Rejected')  iconType = 'error';
        if (status === 'Postponed') iconType = 'warning';

        let showCancel  = false;
        let confirmText = 'Close';
        let cancelText  = '';

        if (status === 'Rejected') {
            showCancel  = true;
            confirmText = 'Book Another Slot';
            cancelText  = 'Close';
        }

        let postponeHtml = '';
        if (status === 'Postponed' && proposedDate) {
            postponeHtml = `
                <div class="alert alert-warning text-start mb-3" style="font-size:.9rem;">
                    <strong>Previous Requested Date:</strong> ${originalDate}<br>
                    <strong>New Proposed Date:</strong> ${proposedDate}
                </div>`;
        }

        let locationHtml = '';
        if (meetingLink) {
            locationHtml = `<p class="mb-2"><a href="${meetingLink}" target="_blank" class="btn btn-sm btn-primary w-100"><i class="fas fa-video me-1"></i> Join Online Meeting</a></p>`;
        } else if (location) {
            locationHtml = `<p class="mb-2"><i class="fas fa-map-marker-alt text-danger me-1"></i><strong>Location / Link:</strong> ${location}</p>`;
        }

        Swal.fire({
            title: 'Meeting Details',
            html: `
                <div class="text-start mt-3">
                    <p class="mb-2"><strong>Status:</strong> <span class="badge bg-light text-dark border">${status}</span></p>
                    ${locationHtml}
                    ${postponeHtml}
                    <p class="mb-1"><strong>Supervisor's Note:</strong></p>
                    <div class="p-3 bg-light rounded border text-muted" style="white-space:pre-wrap;">${note}</div>
                </div>`,
            icon: iconType,
            showCancelButton: showCancel,
            confirmButtonText: confirmText,
            cancelButtonText:  cancelText,
            confirmButtonColor: status === 'Rejected' ? '#3b82f6' : '#ef4444',
            cancelButtonColor:  '#6c757d'
        }).then(result => {
            if (result.isConfirmed && status === 'Rejected') {
                new bootstrap.Modal(document.getElementById('scheduleMeetingModal')).show();
            }
        });
    }

    // ── Open Student Log Modal ──────────────────────────────────
    function openStudentLogModal(btn) {

    // Read Stage 1 and Stage 2 JSON templates
    const templates = JSON.parse(
        document.getElementById(
            'meetingLogTemplatesJson'
        ).textContent
    );

    const stage = String(btn.dataset.stage);
    const template = templates[stage];

    if (!template) {
        Swal.fire(
            'Template Error',
            'Meeting template not found for Stage ' + stage,
            'error'
        );
        return;
    }

    // MeetingBooking ID
    document.getElementById('logMeetingId').value =
        btn.dataset.id;

    // Template information
    document.getElementById('logTemplateTitle').textContent =
        template.title + ' — Version ' + template.version;
    // UI-only context from the existing meeting button attributes.
    document.getElementById('logMeetingMeta').textContent =
        'Stage ' + stage + '  ·  Meeting date: ' + (btn.dataset.meetingDate || 'Unknown');

    const container = document.getElementById(
        'meetingLogTemplateFields'
    );

    container.replaceChildren();

    // Student-editable fields mapped to the existing Controller
    const editableFields = {

        TopicsDiscussed: {
            name: 'keyTopicsDiscussed',
            value: btn.dataset.topics || '',
            required: true
        },

        ActionPoints: {
            name: 'actionPointsForNextMeeting',
            value: btn.dataset.action || '',
            required: true
        },

        ActionsCompleted: {
            name: 'completedActionsAndNotes',
            value: btn.dataset.completed || '',
            required: false
        },

        NextMeetingDate: {
            name: 'nextMeetingDate',
            value: btn.dataset.nextDate || '',
            required: false
        }
    };

    // Automatically populated or supervisor-owned fields
    const readonlyFields = {

        Supervisor: btn.dataset.supervisor || 'Not assigned',

        Student: btn.dataset.student || '',

        MeetingDate: btn.dataset.meetingDate || '',

        SupervisorSignature: 'Pending supervisor signature',

        SupervisorSignatureDate: 'Pending',

        SupervisorComments: 'Completed by supervisor'
    };

    // Follow the JSON display order
    const fields = [...template.fields].sort(
        (a, b) => a.order - b.order
    );

    fields.forEach(field => {

        const col = document.createElement('div');

        // Bootstrap layout based on JSON Columns
        const width = Number(field.columns);

        col.className = 'col-md-' + (
            Number.isInteger(width) &&
            width >= 3 &&
            width <= 12 ? width : 12
        );
        col.classList.add('meeting-log-field');

        // Label
        const label = document.createElement('label');
        label.className = 'form-label fw-bold';
        label.textContent = field.label;

        col.appendChild(label);

        const config = editableFields[field.key];

        if (config) {

            let input;

            if (field.key === 'NextMeetingDate') {
                input = document.createElement('input');
                input.type = 'date';
                input.readOnly = true;
                input.classList.add('bg-light');
            } else if (field.type === 'TextArea') {

                input = document.createElement('textarea');
                input.rows = 3;

                const minHeight = Number(field.minHeightMm);

                if (minHeight > 0 && minHeight <= 80) {
                    input.style.minHeight = minHeight + 'mm';
                }

            } else {

                input = document.createElement('input');
                input.type = 'text';
            }

            input.className = 'form-control rounded-3';

            if (field.key === 'NextMeetingDate') {
                input.classList.add('bg-light');
                input.readOnly = true;
            }

            input.id = config.name;
            input.name = config.name;
            input.value = config.value;
            input.required = config.required;
            label.htmlFor = input.id;
            if (config.required) {
                const mark = document.createElement('span');
                mark.className = 'text-danger ms-1';
                mark.textContent = '*';
                mark.setAttribute('aria-hidden', 'true');
                label.appendChild(mark);
            }

            col.appendChild(input);

        } else {

            // Display fields the student cannot edit
            const value = document.createElement('div');

            value.className =
                'form-control meeting-log-readonly';

            value.style.whiteSpace = 'pre-wrap';

            value.textContent =
                readonlyFields[field.key] ?? 'Not available';

            col.appendChild(value);
        }

        container.appendChild(col);
    });

    // Open the modal
    bootstrap.Modal.getOrCreateInstance(
        document.getElementById('studentLogModal')
    ).show();
}

    // ── View Final Log ───────────────────────────────────
    function viewFinalLog(logId) {
        window.open(
            '/Student/ViewMeetingLog/' + logId,
            '_blank'
        );
    }

    function confirmBookingSubmission(event) {
        event.preventDefault();
        Swal.fire({
            title: 'Confirm Booking',
            text: "Are you sure you want to schedule this meeting?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Submit'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('bookingForm').submit();
            }
        });
        return false;
    }

    function confirmLogSubmission(event) {
        event.preventDefault();
        Swal.fire({
            title: 'Confirm Upload',
            text: "Are you sure you want to submit this logbook?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Upload'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('studentLogForm').submit();
            }
        });
        return false;
    }
</script>

@section Scripts {
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<script>
    var meetingCalendar;

    function showCalendarMeetingDetails(calEvent) {
        const p = calEvent.extendedProps || {};
        let statusBadge = 'badge bg-success';
        if (p.status === 'Pending') statusBadge = 'badge bg-warning text-dark';
        else if (p.status === 'Postponed') statusBadge = 'badge bg-info text-dark';
        else if (p.status === 'Rejected') statusBadge = 'badge bg-danger';

        let linkHtml = '';
        if (p.meetingLink) {
            linkHtml = `<div class="mb-3"><a href="${p.meetingLink}" target="_blank" class="btn btn-sm btn-primary w-100"><i class="fas fa-video me-2"></i> Join Online Meeting</a></div>`;
        } else if (p.location && p.location !== 'TBA') {
            linkHtml = `<div class="mb-3 small p-2 bg-light rounded border"><i class="fas fa-map-marker-alt text-danger me-2"></i><strong>Location:</strong> ${p.location}</div>`;
        }

        Swal.fire({
            title: `<div class="fs-5 fw-bold text-dark mb-0">${calEvent.title}</div>`,
            html: `
                <div class="text-start mt-2">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="${statusBadge} px-2 py-1">${p.status}</span>
                        <span class="text-muted small fw-bold"><i class="far fa-clock me-1"></i>${p.timeRange || p.meetingTime}</span>
                    </div>
                    <div class="p-2 bg-light rounded border mb-3">
                        <div class="text-muted small mb-1"><i class="fas fa-calendar-day text-primary me-2"></i>Date: <strong class="text-dark">${p.meetingDateFormatted || p.meetingDate}</strong></div>
                        <div class="text-muted small mb-1"><i class="fas fa-user-tie text-secondary me-2"></i>Supervisor: <strong class="text-dark">${p.supervisorName || 'Supervisor'}</strong></div>
                        <div class="text-muted small"><i class="fas fa-layer-group text-info me-2"></i>Academic: <strong class="text-dark">Stage ${p.stage || 1}</strong> &bull; <strong class="text-dark">Week ${p.weekNumber || '-'}</strong></div>
                    </div>
                    ${linkHtml}
                    <div class="p-2 bg-light rounded border mb-2">
                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size:0.75rem;">Agenda / Purpose</small>
                        <div class="small text-dark" style="white-space:pre-wrap;">${p.reason || 'None provided'}</div>
                    </div>
                    ${p.supervisorNote && p.supervisorNote !== 'None' ? `
                    <div class="p-2 bg-light rounded border">
                        <small class="text-muted d-block fw-bold text-uppercase" style="font-size:0.75rem;">Supervisor Feedback / Notes</small>
                        <div class="small text-dark" style="white-space:pre-wrap;">${p.supervisorNote}</div>
                    </div>` : ''}
                </div>
            `,
            icon: p.status === 'Approved' ? 'success' : 'info',
            confirmButtonText: 'Close',
            customClass: {
                confirmButton: 'btn btn-primary px-4'
            },
            buttonsStyling: false
        });
    }

    function initCalendar() {
        var calendarEl = document.getElementById('calendar');
        if(calendarEl) {
            meetingCalendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                timeZone: 'local',
                height: 'auto',
                contentHeight: 'auto',
                expandRows: true,
                slotMinTime: '08:00:00',
                slotMaxTime: '18:00:00',
                scrollTime: '09:00:00',
                nowIndicator: true,
                dayMaxEvents: true,
                displayEventTime: true,
                eventTimeFormat: {
                    hour: 'numeric',
                    minute: '2-digit',
                    meridiem: 'short'
                },
                slotLabelFormat: {
                    hour: 'numeric',
                    minute: '2-digit',
                    meridiem: 'short'
                },
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek'
                },
                buttonText: {
                    today: 'Today',
                    month: 'Month',
                    week: 'Week'
                },
                events: function(fetchInfo, successCallback, failureCallback) {
                    fetch('@Url.Action("GetMeetingsCalendarData", "Student")')
                        .then(response => response.json())
                        .then(data => {
                            const emptyAlert = document.getElementById('calendarEmptyAlert');
                            if (emptyAlert) {
                                emptyAlert.style.display = (!data || data.length === 0) ? 'block' : 'none';
                            }
                            successCallback(data || []);
                        })
                        .catch(err => {
                            console.error('Error fetching calendar meetings:', err);
                            failureCallback(err);
                        });
                },
                eventDidMount: function(info) {
                    const p = info.event.extendedProps || {};
                    const timeStr = p.timeRange || p.meetingTime || '';
                    const stageStr = p.stage ? ` • Stage ${p.stage}` : '';
                    const weekStr = p.weekNumber ? ` Wk ${p.weekNumber}` : '';
                    const locStr = p.location && p.location !== 'TBA' ? `\nLocation: ${p.location}` : (p.meetingLink ? '\nLocation: Online Meeting' : '');
                    const notes = p.supervisorNote && p.supervisorNote !== 'None' ? `\nNotes: ${p.supervisorNote}` : '';
                    const tooltip = `${info.event.title}\nTime: ${timeStr} (${p.status || ''})${stageStr}${weekStr}${locStr}${notes}`;
                    info.el.setAttribute('title', tooltip);
                },
                eventClick: function(info) {
                    info.jsEvent.preventDefault();
                    showCalendarMeetingDetails(info.event);
                }
            });
            meetingCalendar.render();
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        initCalendar();
        
        var calendarTabEl = document.getElementById('calendar-tab');
        if (calendarTabEl) {
            calendarTabEl.addEventListener('shown.bs.tab', function () {
                if(meetingCalendar) {
                    meetingCalendar.render();
                    meetingCalendar.updateSize();
                }
            });
        }
    });

    document.addEventListener('MeetingUpdateEvent', function(e) {
        const payload = e.detail;
        const row = document.getElementById('meetingRow_' + payload.meetingId);
        if (!row) return;

        if (meetingCalendar) {
            meetingCalendar.refetchEvents();
        }

        if (payload.type === 'MeetingStatusUpdate') {
            // Update Status Badge
            const statusCell = row.cells[5]; // Status is 6th column
            let badgeCls = 'badge-pending';
            if (payload.status === 'Approved') badgeCls = 'badge-approved';
            else if (payload.status === 'Rejected') badgeCls = 'badge-rejected';
            else if (payload.status === 'Postponed') badgeCls = 'badge-postponed';
            statusCell.innerHTML = `<span class="status-badge ${badgeCls}">${payload.status}</span>`;
            
            // Update action buttons (7th column)
            let actionsHtml = '';
            if (payload.status === 'Approved') {
                // Reload to render the complete meeting data from Razor.
                window.location.reload();
                return;
            } else if (payload.status === 'Postponed') {
                actionsHtml = `
                    <form action="/Student/AcceptPostponedMeeting" method="post" class="d-inline" id="acceptForm_${payload.meetingId}">
                        <input name="__RequestVerificationToken" type="hidden" value="${document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''}" />
                        <input type="hidden" name="meetingId" value="${payload.meetingId}" />
                        <button type="submit" class="btn btn-sm btn-outline-success border-0 fw-semibold me-1">Accept</button>
                    </form>
                    <button type="button" class="btn btn-sm btn-outline-primary border-0 fw-semibold me-1" onclick="openRescheduleModal(${payload.meetingId}, '${payload.meetingDate}')">
                        Reschedule
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 fw-semibold" 
                            data-status="Postponed" 
                            data-note="${payload.message.includes('Note:') ? payload.message.split('Note: ')[1] : 'None'}"
                            data-date="${payload.meetingDateFormatted || payload.meetingDate}"
                            onclick="viewMeetingDetails(this)">
                        Details
                    </button>
                `;
            } else {
                actionsHtml = `
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 fw-semibold" 
                            data-status="${payload.status}" 
                            data-note="${payload.message.includes('Note:') ? payload.message.split('Note: ')[1] : 'None'}"
                            data-date="${payload.meetingDateFormatted || payload.meetingDate}"
                            onclick="viewMeetingDetails(this)">
                        Details
                    </button>
                `;
            }
            actionCell.innerHTML = actionsHtml;
            
        } else if (payload.type === 'MeetingLogSigned') {
            const actionCell = row.cells[6];
            actionCell.innerHTML = `
                <button type="button" class="btn btn-sm btn-outline-success border-0 fw-semibold me-1" onclick="Swal.fire('Signed', 'Your supervisor has signed this logbook. Refresh page to view PDF.', 'success')">
                    <i class="fas fa-file-contract"></i> Log Signed
                </button>
            `;
        }
    });

    $(document).ready(function () {
        $('#meetingTable').DataTable({
            "pageLength": 10,
            "ordering": true,
            "searching": true,
            "info": true,
            "lengthChange": true,
            "language": {
                "search": "Search Meetings:",
                "lengthMenu": "Show _MENU_ meetings per page",
                "info": "Showing _START_ to _END_ of _TOTAL_ meetings",
                "infoEmpty": "No meetings found",
                "infoFiltered": "(filtered from _MAX_ total meetings)"
            },
            "columnDefs": [
                { "orderable": false, "targets": [6] } // Disable sorting on Action column
            ]
        });
    });
</script>
}


