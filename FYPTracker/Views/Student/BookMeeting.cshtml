@using FYPTracker.Models
@{
    ViewData["Title"] = "Book Meeting";
    var currentUser           = ViewBag.CurrentUser as ApplicationUser;
    var assignedSupervisor    = ViewBag.AssignedSupervisor as ApplicationUser;
    var meetings              = ViewBag.Meetings as List<MeetingBooking> ?? new();
    var supervisorHasAvailability = (bool)(ViewBag.SupervisorHasAvailability ?? false);
}

<style>
    :root {
        --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }
    
    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .premium-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        font-size: 0.9rem;
        padding: 9px 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #475569;
        box-shadow: 0 0 0 3px rgba(71, 85, 105, 0.12);
    }

    .btn-submit {
        background: #1e293b;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 700;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: scale(1.03);
        color: white;
    }

    .status-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        display: inline-block;
    }
    
    .badge-pending   { background: #fef3c7; color: #92400e; }
    .badge-approved  { background: #d1fae5; color: #065f46; }
    .badge-rejected  { background: #fee2e2; color: #991b1b; }
    .badge-postponed { background: #dbeafe; color: #1e40af; }
    
    .table th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #475569;
        font-weight: 700;
        background-color: #f8fafc;
    }

    .time-slot {
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        font-size: .85rem;
        font-weight: 700;
        text-align: center;
        transition: all .2s;
        background: #f8fafc;
        color: #374151;
        border-color: #e2e8f0;
    }
    .time-slot:hover { border-color: #64748b; background: #f1f5f9; }
    .time-slot.selected { border-color: #1e293b; background: #1e293b; color: white; }
    .time-slot.booked { background: #f3f4f6 !important; color: #9ca3af !important; border-color: #e5e7eb !important; cursor: not-allowed; opacity: 0.7; text-decoration: line-through; }
    
    /* FullCalendar Custom Overrides */
    .fc .fc-daygrid-body tr:hover { background-color: transparent !important; }
    .fc .fc-daygrid-day:hover { background-color: #f8fafc !important; cursor: pointer; }

    /* Custom Monochrome Tabs */
    #meetingTabs .nav-link { color: #475569; transition: all 0.2s; }
    #meetingTabs .nav-link:hover { background-color: #f1f5f9; color: #1e293b; }
    #meetingTabs .nav-link.active { background-color: #0f172a !important; color: #ffffff !important; }
</style>

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-3">
            <span class="fs-4 text-success"><i class="fas fa-check-circle"></i></span>
            <div class="fw-bold">@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-3">
            <span class="fs-4 text-danger"><i class="fas fa-exclamation-circle"></i></span>
            <div class="fw-bold">@TempData["Error"]</div>
        </div>
    }
    @* ── Page Hero ──────────────────────────────────────────── *@
    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="display-6 fw-bold mb-2"><i class="fas fa-calendar-alt me-2"></i>Book Meeting</h2>
            <p class="mb-0 opacity-90">Schedule discussion slots with your supervisor. Instantly syncs with your academic calendar.</p>
        </div>
    </div>

    <!-- Tomorrow's Meeting Reminder -->
    @{
        var meetingsList = ViewBag.Meetings as List<FYPTracker.Models.MeetingBooking> ?? new List<FYPTracker.Models.MeetingBooking>();
        var tomorrowMeetings = meetingsList.Where(m => m.Status == "Approved" && m.MeetingDate.Date == DateTime.Today.AddDays(1).Date).ToList();
    }
    @if (tomorrowMeetings.Any())
    {
        foreach(var tm in tomorrowMeetings)
        {
            <div class="alert alert-primary border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" style="background-color: #e0f2fe;">
                <i class="fas fa-bell fa-2x text-primary me-3"></i>
                <div>
                    <h5 class="mb-1 fw-bold text-primary">Reminder: Upcoming Meeting Tomorrow!</h5>
                    <p class="mb-0 text-dark">You have an approved meeting scheduled for tomorrow at <strong>@tm.MeetingTime</strong>.</p>
                    @if(!string.IsNullOrEmpty(tm.Location)) {
                        <p class="mb-0 mt-1 text-dark"><i class="fas fa-map-marker-alt text-danger me-1"></i> <strong>Location / Link:</strong> @tm.Location</p>
                    }
                </div>
            </div>
        }
    }

    <!-- Tabs Nav -->
    @if (assignedSupervisor != null && !supervisorHasAvailability)
    {
        <div class="alert border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-3 p-4" style="background: linear-gradient(135deg, #fef3c7, #fffbeb); border-left: 5px solid #f59e0b !important;">
            <span class="fs-2"><i class="fas fa-exclamation-triangle text-warning"></i></span>
            <div>
                <h6 class="fw-bold text-dark mb-1">Supervisor Has Not Set Availability Yet</h6>
                <p class="mb-0 text-muted" style="font-size:0.9rem;">
                    Your supervisor <strong>@assignedSupervisor.FullName</strong> has not configured their available meeting time slots yet.
                    You will be able to book meetings once they set up their schedule. Please contact them if this persists.
                </p>
            </div>
        </div>
    }

    <!-- Tabs Nav -->
    <ul class="nav nav-pills mb-4" id="meetingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold px-4 rounded-pill" id="list-tab" data-bs-toggle="pill" data-bs-target="#list-view" type="button" role="tab" aria-controls="list-view" aria-selected="true">
                <i class="fas fa-list-ul me-2"></i> List View
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4 rounded-pill ms-2" id="calendar-tab" data-bs-toggle="pill" data-bs-target="#calendar-view" type="button" role="tab" aria-controls="calendar-view" aria-selected="false">
                <i class="fas fa-calendar-alt me-2"></i> Calendar View
            </button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="meetingTabsContent">
        <!-- List View -->
        <div class="tab-pane fade show active" id="list-view" role="tabpanel" aria-labelledby="list-tab">
            <div class="premium-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-dark mb-0"><i class="fas fa-list-ul text-danger me-2"></i>Meeting List Table</h5>
            @if (assignedSupervisor == null)
            {
                <a href="/Student/SelectSupervisor" class="btn btn-outline-danger rounded-3 px-4">
                    <i class="fas fa-search me-1"></i> Select a Supervisor
                </a>
            }
            else if (!supervisorHasAvailability)
            {
                <button type="button" class="btn btn-secondary rounded-3 px-4" disabled
                        title="Your supervisor has not configured their availability yet.">
                    <i class="fas fa-clock me-1"></i> Awaiting Supervisor Schedule
                </button>
            }
            else
            {
                <button type="button" class="btn btn-submit" data-bs-toggle="modal" data-bs-target="#scheduleMeetingModal">
                    <i class="fas fa-plus-circle me-1"></i> Schedule Meeting
                </button>
            }
        </div>
        <div class="table-responsive">
            <table id="meetingTable" class="table align-middle table-hover">
                <thead>
                    <tr>
                        <th class="ps-3" style="width: 50px;">No</th>
                        <th>Date</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int number = 1; }
                    
                    <!-- Dynamic database meetings -->
                    @foreach (var m in meetings)
                    {
                        var badgeCls = m.Status switch
                        {
                            "Approved" => "badge-approved",
                            "Rejected" => "badge-rejected",
                            "Postponed" => "badge-postponed",
                            _ => "badge-pending"
                        };

                        string displayTime = m.MeetingTime;
                        try {
                            if(TimeSpan.TryParse(m.MeetingTime, out var ts)) {
                                displayTime = DateTime.Today.Add(ts).ToString("h:mm tt");
                            }
                        } catch {}

                        <tr id="meetingRow_@m.Id">
                            <td class="ps-3 fw-bold text-muted">@(number++)</td>
                            <td>@m.MeetingDate.ToString("dd/MM/yyyy")</td>
                            <td>@m.MeetingDay</td>
                            <td>@displayTime</td>
                            <td>@m.Reason</td>
                            <td><span class="status-badge @badgeCls">@m.Status</span></td>
                            <td class="text-end pe-3">
                                @if (m.Status == "Pending")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary border-0 fw-semibold me-1" onclick="openRescheduleModal(@m.Id, '@m.MeetingDate.ToString("yyyy-MM-dd")')">
                                        Reschedule
                                    </button>
                                    <form asp-action="CancelMeeting" method="post" class="d-inline" id="cancelForm_@m.Id">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="meetingId" value="@m.Id" />
                                        <button type="button" class="btn btn-sm btn-outline-danger border-0 fw-semibold" onclick="confirmCancel(@m.Id)">Cancel</button>
                                    </form>
                                }
                                else
                                {
                                    @if (m.Status == "Approved")
                                    {
                                        if (m.MeetingLog == null || m.MeetingLog.LogStatus == "Draft")
                                        {
                                            var daysUntilMeeting = (m.MeetingDate.Date - DateTime.Today).TotalDays;
                                            if (daysUntilMeeting <= 7)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary border-0 fw-semibold me-1" 
                                                        data-id="@m.Id"
                                                        data-pdf="@(m.MeetingLog?.PdfLogbookPath)"
                                                        onclick="openStudentLogModal(this)">
                                                    <i class="fas fa-edit"></i> @(m.MeetingLog == null ? "Upload Logbook" : "View/Re-upload Logbook")
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary border-0 fw-semibold me-1" disabled title="Available 7 days before meeting">
                                                    <i class="fas fa-clock"></i> Available closer to date
                                                </button>
                                            }
                                        }
                                        else if (m.MeetingLog.LogStatus == "Signed")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success border-0 fw-semibold me-1" onclick="viewFinalLog(@m.MeetingLog.Id)">
                                                <i class="fas fa-file-contract"></i> View Log
                                            </button>
                                        }
                                    }
                                    else if (m.Status == "Postponed")
                                    {
                                        <form asp-action="AcceptPostponedMeeting" method="post" class="d-inline" id="acceptForm_@m.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="meetingId" value="@m.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success border-0 fw-semibold me-1">Accept</button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-primary border-0 fw-semibold me-1" onclick="openRescheduleModal(@m.Id, '@(m.ProposedNewDate?.ToString("yyyy-MM-dd") ?? m.MeetingDate.ToString("yyyy-MM-dd"))')">
                                            Reschedule
                                        </button>
                                        <form asp-action="CancelMeeting" method="post" class="d-inline" id="cancelForm_@m.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="meetingId" value="@m.Id" />
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0 fw-semibold" onclick="confirmCancel(@m.Id)">Cancel</button>
                                        </form>
                                    }

                                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 fw-semibold" 
                                            data-status="@m.Status" 
                                            data-note="@(m.SupervisorNote ?? "None")"
                                            data-date="@m.MeetingDate.ToString("dd MMM yyyy")"
                                            data-proposed-date="@(m.ProposedNewDate?.ToString("dd MMM yyyy") ?? "")"
                                            data-proposed-iso="@(m.ProposedNewDate?.ToString("yyyy-MM-dd") ?? "")"
                                            onclick="viewMeetingDetails(this)">
                                        Details
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div> <!-- End List View -->
    
    <!-- Calendar View -->
    <div class="tab-pane fade" id="calendar-view" role="tabpanel" aria-labelledby="calendar-tab">
        <div class="premium-card p-4">
            <h5 class="fw-bold text-dark mb-4"><i class="fas fa-calendar-alt text-primary me-2"></i>Meeting Calendar</h5>
            <div id="calendar" style="min-height: 400px;"></div>
        </div>
    </div>
    <!-- End Calendar View -->
    
    </div> <!-- End tab-content -->
</div>

@if (assignedSupervisor != null && supervisorHasAvailability)
{
    <!-- Schedule Meeting Modal -->
    <div class="modal fade" id="scheduleMeetingModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <form asp-action="SubmitMeetingBooking" method="post" id="bookingForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="supervisorId" value="@assignedSupervisor.Id" />
                    
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold text-dark"><i class="fas fa-plus-circle text-danger me-2"></i>Schedule Meeting</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    
                    <div class="modal-body">
                        <!-- Supervisor Name (Auto-filled & Read-only) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Supervisor</label>
                            <input type="text" class="form-control bg-light border-0" value="@assignedSupervisor.FullName" readonly />
                        </div>

                        <!-- Date Picker -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Date</label>
                            <input type="date" name="meetingDate" id="meetingDate" class="form-control" required onchange="calculateDay()" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <!-- Day (Auto-filled & Read-only) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Day</label>
                            <input type="text" id="meetingDay" class="form-control bg-light border-0" readonly placeholder="Pick a date first" />
                        </div>

                        <!-- Available Slots Grid -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Available Slots</label>
                            @if (ViewBag.FixedTime != null)
                            {
                                <input type="hidden" name="meetingTime" value="@ViewBag.FixedTime" required />
                                <input type="text" class="form-control bg-light border-0 text-success fw-bold" value="@ViewBag.FixedTime" readonly title="Your meeting time is fixed." />
                                <div class="text-muted small mt-1"><i class="fas fa-lock"></i> Your weekly meeting time is locked to your first meeting time.</div>
                            }
                            else
                            {
                                <input type="hidden" name="meetingTime" id="meetingTimeInput" required />
                                <div class="row g-2" id="timeSlotsContainer">
                                    <div class="col-12 text-muted small"><i class="fas fa-arrow-up"></i> Please pick a date first to see available slots.</div>
                                </div>
                                <div id="timeError" class="text-danger mt-2 small" style="display:none;">Please pick an available time slot.</div>
                            }
                        </div>

                        <!-- Reason -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Reason / Agenda</label>
                            <textarea name="reason" id="meetingReason" class="form-control" rows="3" required placeholder="Describe purpose of meeting..."></textarea>
                            <div id="meetingReasonError" class="text-danger fw-bold small mt-1 d-none">Please provide a detailed agenda (at least 10 characters).</div>
                        </div>
                    </div>
                    
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-submit px-4 rounded-3">Submit Booking</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Reschedule Modal -->
<div class="modal fade" id="rescheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form id="studentRescheduleForm" asp-action="RescheduleMeeting" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="meetingId" id="reschedMeetingId" />
                <input type="hidden" name="meetingTime" id="reschedTimeInput" value="@ViewBag.FixedTime" />
                
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-calendar-plus text-primary me-2"></i>Reschedule Your Meeting</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-4">Choose a new date and time. This will overwrite your current request.</p>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Pick New Date</label>
                        <input type="date" name="meetingDate" id="reschedDateInput" class="form-control rounded-3" 
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required onchange="updateReschedAvailability()" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Available Slots</label>
                        @if (ViewBag.FixedTime != null)
                        {
                            <input type="text" class="form-control bg-light border-0 text-success fw-bold" value="@ViewBag.FixedTime" readonly title="Your meeting time is fixed." />
                            <div class="text-muted small mt-1"><i class="fas fa-lock"></i> Your weekly meeting time is locked to your first meeting time.</div>
                        }
                        else
                        {
                            <div class="row g-2" id="reschedTimeSlots">
                                <div class="col-12 text-muted small"><i class="fas fa-arrow-up"></i> Please pick a date first to see available slots.</div>
                            </div>
                            <div id="reschedTimeError" class="text-danger mt-2 small" style="display:none;">Please select a time slot.</div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Confirm Reschedule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Student Log Draft Modal -->
<div class="modal fade" id="studentLogModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <form asp-action="SubmitMeetingLogStudent" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="meetingId" id="logMeetingId" />
                
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-dark"><i class="fas fa-file-upload text-primary me-2"></i>Upload Weekly Meeting Logbook</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-4">Download the template, fill it out, and upload it as a PDF. Your supervisor will review and sign this log.</p>
                    
                    <div class="mb-4 text-center">
                        <a href="/templates/Record_of_supervisor_meeting_template.docx" class="btn btn-outline-primary rounded-3" download>
                            <i class="fas fa-download me-2"></i>Download Word Template
                        </a>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Upload Completed Logbook (PDF)</label>
                        <input type="file" name="logbookPdf" id="logbookPdf" class="form-control rounded-3" accept="application/pdf" required />
                        <div id="existingLogbookLink" class="mt-2" style="display:none;">
                            <a href="#" target="_blank" class="text-success"><i class="fas fa-file-pdf me-1"></i>View Previously Uploaded Logbook</a>
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Submit Logbook</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const supervisorId = @(assignedSupervisor?.Id ?? 0);
    const timeInput    = document.getElementById('meetingTimeInput');
    const timeError    = document.getElementById('timeError');

    // ── Day auto-fill ──────────────────────────────────────────
    function calculateDay() {
        const val = document.getElementById('meetingDate').value;
        if (val) {
            const d = new Date(val + 'T00:00:00');
            document.getElementById('meetingDay').value =
                new Intl.DateTimeFormat('en-US', { weekday: 'long' }).format(d);
            updateAvailability();
        } else {
            document.getElementById('meetingDay').value = '';
        }
    }

    // ── Fetch & mark booked slots (Book modal) ──────────────────
    async function updateAvailability() {
        const dateVal = document.getElementById('meetingDate').value;
        if (!dateVal || supervisorId === 0) return;

        const container = document.getElementById('timeSlotsContainer');
        if (!container) return;

        container.innerHTML = '<div class="col-12 text-center text-muted py-2"><div class="spinner-border spinner-border-sm me-2"></div>Loading slots...</div>';
        if (timeInput) timeInput.value = '';

        try {
            const resp = await fetch(`/Student/GetAvailableSlots?supervisorId=${supervisorId}&date=${dateVal}`);
            const data = await resp.json();
            
            container.innerHTML = '';
            
            if (data.noAvailability) {
                container.innerHTML = `<div class="col-12 text-center text-danger fw-bold"><i class="fas fa-exclamation-triangle me-1"></i>${data.message}</div>`;
                return;
            }

            if (data.slots && data.slots.length > 0) {
                data.slots.forEach(slotTime => {
                    const col = document.createElement('div');
                    col.className = 'col-4';
                    col.innerHTML = `<div class="time-slot" data-time="${slotTime}" onclick="selectTime(this, 'timeSlotsContainer', 'meetingTimeInput', 'timeError')">${slotTime}</div>`;
                    container.appendChild(col);
                });
            } else {
                container.innerHTML = `<div class="col-12 text-center text-danger fw-bold"><i class="fas fa-exclamation-circle me-1"></i>${data.message || 'No available slots on this date.'}</div>`;
            }
        } catch (err) { 
            console.error(err); 
            container.innerHTML = '<div class="col-12 text-center text-danger">Error loading slots.</div>';
        }
    }

    // ── Generic slot selector ───────────────────────────────────
    function selectTime(el, containerId, inputId, errorId) {
        if (el.classList.contains('booked')) return;
        document.getElementById(containerId).querySelectorAll('.time-slot')
            .forEach(s => s.classList.remove('selected'));
        el.classList.add('selected');
        document.getElementById(inputId).value = el.dataset.time;
        const err = document.getElementById(errorId);
        if (err) err.style.display = 'none';
    }

    // ── Realtime Validation for Reason ──────────────────────────
    const meetingReason = document.getElementById('meetingReason');
    const meetingReasonError = document.getElementById('meetingReasonError');
    if (meetingReason && meetingReasonError) {
        meetingReason.addEventListener('input', function() {
            if (this.value.trim().length >= 10) {
                this.classList.remove('is-invalid');
                this.classList.add('is-valid');
                meetingReasonError.classList.add('d-none');
            } else {
                this.classList.remove('is-valid');
                this.classList.add('is-invalid');
                meetingReasonError.classList.remove('d-none');
            }
        });
    }

    // ── Book meeting form validation ────────────────────────────
    document.getElementById('bookingForm')?.addEventListener('submit', function(e) {
        const dateVal = document.getElementById('meetingDate')?.value;
        const timeVal = timeInput?.value;
        let valid = true;

        if (!dateVal) {
            Swal.fire('Missing Date', 'Please select a meeting date.', 'warning');
            e.preventDefault();
            return;
        }
        if (!timeVal && !document.querySelector('[name="meetingTime"][type="hidden"]')?.value) {
            e.preventDefault();
            if (timeError) timeError.style.display = 'block';
            Swal.fire('Missing Time', 'Please select a time slot.', 'warning');
            return;
        }

        // Reason validation
        if (meetingReason && meetingReason.value.trim().length < 10) {
            e.preventDefault();
            meetingReason.classList.add('is-invalid');
            meetingReasonError.classList.remove('d-none');
            // Not showing sweetalert for text length to keep it unobtrusive, inline error suffices
            return;
        }
    });

    // ── Reschedule modal (Pending → change date/time) ───────────
    const reschedTimeInput = document.getElementById('reschedTimeInput');
    const reschedTimeError = document.getElementById('reschedTimeError');

    function openRescheduleModal(id, date) {
        document.getElementById('reschedMeetingId').value = id;
        document.getElementById('reschedDateInput').value = date;
        if (reschedTimeInput && document.getElementById('reschedTimeSlots')) reschedTimeInput.value = '';
        document.getElementById('reschedTimeSlots')?.querySelectorAll('.time-slot')
            .forEach(s => s.classList.remove('selected', 'booked'));
        updateReschedAvailability();
        new bootstrap.Modal(document.getElementById('rescheduleModal')).show();
    }

    async function updateReschedAvailability() {
        const dateVal = document.getElementById('reschedDateInput')?.value;
        if (!dateVal || supervisorId === 0) return;

        const container = document.getElementById('reschedTimeSlots');
        if (!container) return;

        container.innerHTML = '<div class="col-12 text-center text-muted py-2"><div class="spinner-border spinner-border-sm me-2"></div>Loading slots...</div>';
        if (reschedTimeInput && document.getElementById('reschedTimeSlots')) reschedTimeInput.value = '';

        try {
            const resp = await fetch(`/Student/GetAvailableSlots?supervisorId=${supervisorId}&date=${dateVal}`);
            const data = await resp.json();
            
            container.innerHTML = '';
            
            if (data.noAvailability) {
                container.innerHTML = `<div class="col-12 text-center text-danger fw-bold"><i class="fas fa-exclamation-triangle me-1"></i>${data.message}</div>`;
                return;
            }

            if (data.slots && data.slots.length > 0) {
                data.slots.forEach(slotTime => {
                    const col = document.createElement('div');
                    col.className = 'col-4';
                    col.innerHTML = `<div class="time-slot" data-time="${slotTime}" onclick="selectTime(this, 'reschedTimeSlots', 'reschedTimeInput', 'reschedTimeError')">${slotTime}</div>`;
                    container.appendChild(col);
                });
            } else {
                container.innerHTML = `<div class="col-12 text-center text-danger fw-bold"><i class="fas fa-exclamation-circle me-1"></i>${data.message || 'No available slots on this date.'}</div>`;
            }
        } catch (err) { 
            console.error(err); 
            container.innerHTML = '<div class="col-12 text-center text-danger">Error loading slots.</div>';
        }
    }

    document.getElementById('studentRescheduleForm')?.addEventListener('submit', function(e) {
        if (document.getElementById('reschedTimeSlots') && !reschedTimeInput?.value) {
            e.preventDefault();
            if (reschedTimeError) reschedTimeError.style.display = 'block';
            Swal.fire('Missing Time', 'Please select a time slot.', 'warning');
        }
    });

    // ── Cancel confirmation ─────────────────────────────────────
    function confirmCancel(id) {
        Swal.fire({
            title: 'Cancel Request?',
            text: 'Are you sure you want to cancel this meeting request?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, cancel it'
        }).then(result => {
            if (result.isConfirmed)
                document.getElementById('cancelForm_' + id).submit();
        });
    }

    // ── View Meeting Details popup ──────────────────────────────
    function viewMeetingDetails(btn) {
        const status       = btn.getAttribute('data-status');
        const note         = btn.getAttribute('data-note');
        const originalDate = btn.getAttribute('data-date');
        const proposedDate = btn.getAttribute('data-proposed-date');
        const location     = btn.getAttribute('data-location');

        let iconType = 'info';
        if (status === 'Approved')  iconType = 'success';
        if (status === 'Rejected')  iconType = 'error';
        if (status === 'Postponed') iconType = 'warning';

        let showCancel  = false;
        let confirmText = 'Close';
        let cancelText  = '';

        if (status === 'Rejected') {
            showCancel  = true;
            confirmText = 'Book Another Slot';
            cancelText  = 'Close';
        }

        let postponeHtml = '';
        if (status === 'Postponed' && proposedDate) {
            postponeHtml = `
                <div class="alert alert-warning text-start mb-3" style="font-size:.9rem;">
                    <strong>Previous Requested Date:</strong> ${originalDate}<br>
                    <strong>New Proposed Date:</strong> ${proposedDate}
                </div>`;
        }

        let locationHtml = '';
        if (location) {
            locationHtml = `<p class="mb-2"><i class="fas fa-map-marker-alt text-danger me-1"></i><strong>Location / Link:</strong> ${location}</p>`;
        }

        Swal.fire({
            title: 'Meeting Details',
            html: `
                <div class="text-start mt-3">
                    <p class="mb-2"><strong>Status:</strong> <span class="badge bg-light text-dark border">${status}</span></p>
                    ${locationHtml}
                    ${postponeHtml}
                    <p class="mb-1"><strong>Supervisor's Note:</strong></p>
                    <div class="p-3 bg-light rounded border text-muted" style="white-space:pre-wrap;">${note}</div>
                </div>`,
            icon: iconType,
            showCancelButton: showCancel,
            confirmButtonText: confirmText,
            cancelButtonText:  cancelText,
            confirmButtonColor: status === 'Rejected' ? '#3b82f6' : '#ef4444',
            cancelButtonColor:  '#6c757d'
        }).then(result => {
            if (result.isConfirmed && status === 'Rejected') {
                new bootstrap.Modal(document.getElementById('scheduleMeetingModal')).show();
            }
        });
    }

    // ── Open Student Log Modal ──────────────────────────────────
    function openStudentLogModal(btn) {
        document.getElementById('logMeetingId').value = btn.getAttribute('data-id');
        
        const pdfPath = btn.getAttribute('data-pdf');
        const linkContainer = document.getElementById('existingLogbookLink');
        const linkAnchor = linkContainer.querySelector('a');

        if (pdfPath && pdfPath !== '') {
            linkAnchor.href = pdfPath;
            linkContainer.style.display = 'block';
            document.getElementById('logbookPdf').removeAttribute('required');
        } else {
            linkContainer.style.display = 'none';
            document.getElementById('logbookPdf').setAttribute('required', 'required');
        }

        new bootstrap.Modal(document.getElementById('studentLogModal')).show();
    }

    // ── Logbook File Validation ─────────────────────────────────
    document.getElementById('logbookPdf')?.addEventListener('change', function(e) {
        const file = this.files[0];
        if (file && file.type !== 'application/pdf') {
            Swal.fire({ 
                icon: 'error',
                title: 'Invalid File Format',
                text: 'Only PDF files are allowed for the weekly meeting logbook.',
                confirmButtonColor: '#3b82f6'
            });
            this.value = ''; // clear the input to prevent submission
        }
    });

    // ── View Final Log as PDF ───────────────────────────────────
    function viewFinalLog(logId) {
        // Since the user uploads a PDF, we don't need html2pdf. We just redirect to the ViewMeetingLog endpoint
        // which now returns the signed PDF directly.
        window.open('/Student/ViewMeetingLog/' + logId, '_blank');
    }
</script>

@section Scripts {
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<script>
    var meetingCalendar;
    function initCalendar() {
        var calendarEl = document.getElementById('calendar');
        if(calendarEl) {
            meetingCalendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                height: 'auto',
                contentHeight: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek'
                },
                events: '@Url.Action("GetMeetingsCalendarData", "Student")',
                eventClick: function(info) {
                    if(info.event.url) {
                        window.location.href = info.event.url;
                        info.jsEvent.preventDefault();
                    }
                }
            });
            meetingCalendar.render();
        }
    }
    document.addEventListener("DOMContentLoaded", function() {
        initCalendar();
        
        var calendarTabEl = document.getElementById('calendar-tab');
        if (calendarTabEl) {
            calendarTabEl.addEventListener('shown.bs.tab', function () {
                if(meetingCalendar) {
                    meetingCalendar.render();
                }
            });
        }
    });

    document.addEventListener('MeetingUpdateEvent', function(e) {
        const payload = e.detail;
        const row = document.getElementById('meetingRow_' + payload.meetingId);
        if (!row) return;

        if (payload.type === 'MeetingStatusUpdate') {
            // Update Status Badge
            const statusCell = row.cells[5]; // Status is 6th column
            let badgeCls = 'badge-pending';
            if (payload.status === 'Approved') badgeCls = 'badge-approved';
            else if (payload.status === 'Rejected') badgeCls = 'badge-rejected';
            else if (payload.status === 'Postponed') badgeCls = 'badge-postponed';
            statusCell.innerHTML = `<span class="status-badge ${badgeCls}">${payload.status}</span>`;
            
            // Update action buttons (7th column)
            const actionCell = row.cells[6];
            let actionsHtml = '';
            if (payload.status === 'Approved') {
                actionsHtml = `
                    <button type="button" class="btn btn-sm btn-outline-primary border-0 fw-semibold me-1" 
                            data-id="${payload.meetingId}"
                            data-pdf=""
                            onclick="openStudentLogModal(this)">
                        <i class="fas fa-edit"></i> Upload Logbook
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 fw-semibold" 
                            data-status="Approved" 
                            data-note="${payload.message.includes('Note:') ? payload.message.split('Note: ')[1] : 'None'}"
                            data-date="${payload.meetingDateFormatted || payload.meetingDate}"
                            data-proposed-date=""
                            data-proposed-iso=""
                            onclick="viewMeetingDetails(this)">
                        Details
                    </button>
                `;
            } else if (payload.status === 'Postponed') {
                actionsHtml = `
                    <form action="/Student/AcceptPostponedMeeting" method="post" class="d-inline" id="acceptForm_${payload.meetingId}">
                        <input name="__RequestVerificationToken" type="hidden" value="${document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''}" />
                        <input type="hidden" name="meetingId" value="${payload.meetingId}" />
                        <button type="submit" class="btn btn-sm btn-outline-success border-0 fw-semibold me-1">Accept</button>
                    </form>
                    <button type="button" class="btn btn-sm btn-outline-primary border-0 fw-semibold me-1" onclick="openRescheduleModal(${payload.meetingId}, '${payload.meetingDate}')">
                        Reschedule
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 fw-semibold" 
                            data-status="Postponed" 
                            data-note="${payload.message.includes('Note:') ? payload.message.split('Note: ')[1] : 'None'}"
                            data-date="${payload.meetingDateFormatted || payload.meetingDate}"
                            onclick="viewMeetingDetails(this)">
                        Details
                    </button>
                `;
            } else {
                actionsHtml = `
                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 fw-semibold" 
                            data-status="${payload.status}" 
                            data-note="${payload.message.includes('Note:') ? payload.message.split('Note: ')[1] : 'None'}"
                            data-date="${payload.meetingDateFormatted || payload.meetingDate}"
                            onclick="viewMeetingDetails(this)">
                        Details
                    </button>
                `;
            }
            actionCell.innerHTML = actionsHtml;
            
        } else if (payload.type === 'MeetingLogSigned') {
            const actionCell = row.cells[6];
            actionCell.innerHTML = `
                <button type="button" class="btn btn-sm btn-outline-success border-0 fw-semibold me-1" onclick="Swal.fire('Signed', 'Your supervisor has signed this logbook. Refresh page to view PDF.', 'success')">
                    <i class="fas fa-file-contract"></i> Log Signed
                </button>
            `;
        }
    });

    $(document).ready(function () {
        $('#meetingTable').DataTable({
            "pageLength": 10,
            "ordering": true,
            "searching": true,
            "info": true,
            "lengthChange": true,
            "language": {
                "search": "Search Meetings:",
                "lengthMenu": "Show _MENU_ meetings per page",
                "info": "Showing _START_ to _END_ of _TOTAL_ meetings",
                "infoEmpty": "No meetings found",
                "infoFiltered": "(filtered from _MAX_ total meetings)"
            },
            "columnDefs": [
                { "orderable": false, "targets": [6] } // Disable sorting on Action column
            ]
        });
    });
</script>
}


