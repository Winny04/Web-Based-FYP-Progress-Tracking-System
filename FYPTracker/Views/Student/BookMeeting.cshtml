@using FYPTracker.Models
@using System.Text.Json
@inject FYPTracker.Services.Forms.MeetingLogTemplateService MeetingLogTemplateService
@{
    ViewData["Title"] = "Book Meeting";
    var currentUser           = ViewBag.CurrentUser as ApplicationUser;
    var assignedSupervisor    = ViewBag.AssignedSupervisor as ApplicationUser;
    var meetings              = ViewBag.Meetings as List<MeetingBooking> ?? new();
    var supervisorHasAvailability = (bool)(ViewBag.SupervisorHasAvailability ?? false);
}

@{
    var stage1Template =
        await MeetingLogTemplateService.LoadAsync(1);

    var stage2Template =
        await MeetingLogTemplateService.LoadAsync(2);
}



<style>
    :root {
        --hero-grad: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }
    
    .page-hero {
        background: var(--hero-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(30,41,59,.18);
    }

    .premium-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        font-size: 0.9rem;
        padding: 9px 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #475569;
        box-shadow: 0 0 0 3px rgba(71, 85, 105, 0.12);
    }

    .btn-submit {
        background: #1e293b;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 700;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: scale(1.03);
        color: white;
    }

    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        line-height: 1.2;
    }
    
    .badge-pending   { background: #fef3c7; color: #92400e; border: 1px solid #f59e0b; }
    .badge-approved  { background: #d1fae5; color: #065f46; border: 1px solid #10b981; }
    .badge-rejected  { background: #fee2e2; color: #991b1b; border: 1px solid #ef4444; }
    .badge-postponed { background: #dbeafe; color: #1e40af; border: 1px solid #3b82f6; }
    .badge-cancelled { background: #f3f4f6; color: #374151; border: 1px solid #9ca3af; }
    .badge-conflict  { background: #fee2e2; color: #991b1b; border: 1px solid #dc2626; }
    
    .table th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #475569;
        font-weight: 700;
        background-color: #f8fafc;
    }

    .time-slot {
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        font-size: .85rem;
        font-weight: 700;
        text-align: center;
        transition: all .2s;
        background: #f8fafc;
        color: #374151;
        border-color: #e2e8f0;
    }
    .time-slot:hover { border-color: #64748b; background: #f1f5f9; }
    .time-slot.selected { border-color: #1e293b; background: #1e293b; color: white; }
    .time-slot.booked { background: #f3f4f6 !important; color: #9ca3af !important; border-color: #e5e7eb !important; cursor: not-allowed; opacity: 0.7; text-decoration: line-through; }
    
    /* FullCalendar Custom Overrides & UI Improvements */
    .fc .fc-daygrid-body tr:hover { background-color: transparent !important; }
    .fc .fc-daygrid-day:hover { background-color: #f8fafc !important; cursor: pointer; }
    .fc .fc-event {
        cursor: pointer;
        border-radius: 4px;
        padding: 2px 4px;
        font-size: 0.82rem;
        transition: transform 0.1s ease, box-shadow 0.1s ease;
        border: none;
    }
    .fc .fc-event:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
    }
    .fc .fc-event-main {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .fc .fc-event-time {
        font-weight: 600;
        margin-right: 4px;
    }
    .fc .fc-event-title {
        font-weight: 500;
    }
    .fc .fc-timegrid-slot {
        height: 2.2rem;
    }

    /* Custom Monochrome Tabs */
    #meetingTabs .nav-link { color: #475569; transition: all 0.2s; }
    #meetingTabs .nav-link:hover { background-color: #f1f5f9; color: #1e293b; }
    #meetingTabs .nav-link.active { background-color: #0f172a !important; color: #ffffff !important; }

    /* Meeting Logbook only: keep other Bootstrap modals unchanged. */
    #studentLogModal .modal-dialog {
        --bs-modal-width: 980px;
        max-width: min(980px, calc(100vw - 32px));
        margin: 16px auto;
    }

    #studentLogModal .modal-content {
        height: min(820px, calc(100dvh - 32px));
        max-height: calc(100dvh - 32px);
        overflow: hidden;
        border-radius: 18px;
    }

    #studentLogModal #studentLogForm {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        height: 100%;
        min-height: 0;
    }

    #studentLogModal .modal-header,
    #studentLogModal .modal-footer { flex-shrink: 0; }

    #studentLogModal .meeting-log-header {
        padding: 20px 26px;
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0 !important;
    }

    #studentLogModal .meeting-log-heading {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        min-width: 0;
    }

    #studentLogModal .meeting-log-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #1d4ed8;
        background: #eff6ff;
    }

    #studentLogModal .meeting-log-title {
        font-size: 1.15rem;
        line-height: 1.35;
        margin-bottom: 4px;
        color: #0f172a;
    }

    #studentLogModal #logTemplateTitle {
        display: block;
        color: #64748b;
        font-size: .8rem;
        overflow-wrap: anywhere;
    }

    #studentLogModal .meeting-log-context {
        color: #475569;
        font-size: .82rem;
        font-weight: 600;
        margin-top: 5px;
    }

    #studentLogModal .modal-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 22px 26px 28px;
        overscroll-behavior: contain;
    }

    #studentLogModal .meeting-log-notice {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        padding: 12px 14px;
        font-size: .85rem;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    #studentLogModal #meetingLogTemplateFields > div { min-width: 0; }

    #studentLogModal .meeting-log-field .form-label {
        font-size: .86rem;
        color: #334155;
        margin-bottom: 7px;
    }

    #studentLogModal .meeting-log-field .form-control {
        border: 1px solid #d7dee8;
        border-radius: 10px !important;
        font-size: .91rem;
        padding: 11px 13px;
        background: #fff;
        color: #1e293b;
    }

    #studentLogModal .meeting-log-field .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }

    #studentLogModal .meeting-log-field textarea {
        resize: vertical;
        line-height: 1.55;
    }

    #studentLogModal .meeting-log-field .meeting-log-readonly {
        background: #f8fafc;
        color: #64748b;
        min-height: 46px;
        overflow-wrap: anywhere;
    }

    #studentLogModal .meeting-log-footer {
        border-top: 1px solid #e2e8f0 !important;
        background: #fff;
        padding: 14px 26px;
        gap: 10px;
    }

    #studentLogModal .meeting-log-submit {
        background: #2563eb;
        border-color: #2563eb;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 10px;
    }

    #studentLogModal .meeting-log-cancel {
        border-radius: 10px;
        padding: 10px 20px;
    }

    @@media (max-width: 575.98px) {
        #studentLogModal .modal-dialog {
            max-width: calc(100vw - 16px);
            margin: 8px auto;
        }

        #studentLogModal .modal-content {
            height: calc(100dvh - 16px);
            max-height: calc(100dvh - 16px);
        }

        #studentLogModal .meeting-log-header { padding: 15px 16px; }
        #studentLogModal .modal-body { padding: 16px; }
        #studentLogModal .meeting-log-footer { padding: 12px 16px; }
        #studentLogModal .meeting-log-title { font-size: 1rem; }
        #studentLogModal .meeting-log-footer .btn { width: 100%; }
    }

</style>

<div class="container-xxl py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-3">
            <span class="fs-4 text-success"><i class="fas fa-check-circle"></i></span>
            <div class="fw-bold">@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-3">
            <span class="fs-4 text-danger"><i class="fas fa-exclamation-circle"></i></span>
            <div class="fw-bold">@TempData["Error"]</div>
        </div>
    }
    <!-- Welcome Header (Navy-blue matching Dashboard) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background-color: #0f172a; color: white;">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bolder mb-1"><i class="fas fa-calendar-alt me-2"></i>Book Meeting</h4>
                <p class="mb-0 text-white-50 fs-7 fw-bold">Schedule discussion slots with your supervisor. Instantly syncs with your academic calendar.</p>
            </div>
        </div>
    </div>

    <!-- Meeting Progress -->
    @{
        var p1 = ViewBag.ProgressStage1 as FYPTracker.ViewModels.MeetingProgressVM;
        var p2 = ViewBag.ProgressStage2 as FYPTracker.ViewModels.MeetingProgressVM;
    }
    @if (p1 != null || p2 != null)
    {
        <div class="row g-4 mb-4">
            @if (p1 != null && p1.Required.HasValue)
            {
                <div class="col-md-6">
                    <div class="premium-card p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-chart-pie text-primary me-2"></i>Stage 1 Meeting Progress</h6>
                            <span class="badge bg-primary rounded-pill">@p1.Completed / @p1.Required Completed</span>
                        </div>
                        <div class="progress" style="height: 10px; border-radius: 5px; background: #e2e8f0;">
                            <div class="progress-bar bg-primary rounded-pill" role="progressbar" style="width: @p1.ProgressPercentage%;" aria-valuenow="@p1.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted mt-2 d-block">Session: @p1.SessionName</small>
                    </div>
                </div>
            }
            @if (p2 != null && p2.Required.HasValue)
            {
                <div class="col-md-6">
                    <div class="premium-card p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-chart-pie text-success me-2"></i>Stage 2 Meeting Progress</h6>
                            <span class="badge bg-success rounded-pill">@p2.Completed / @p2.Required Completed</span>
                        </div>
                        <div class="progress" style="height: 10px; border-radius: 5px; background: #e2e8f0;">
                            <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: @p2.ProgressPercentage%;" aria-valuenow="@p2.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted mt-2 d-block">Session: @p2.SessionName</small>
                    </div>
                </div>
            }
        </div>
    }
    @{
        var studentConflicts = ViewBag.ActiveOverrideConflicts as List<FYPTracker.Models.OverrideMeetingConflictDto> ?? new List<FYPTracker.Models.OverrideMeetingConflictDto>();
        var conflictMeetingIds = new HashSet<int>(studentConflicts.Select(c => c.MeetingId));
    }

    <!-- Student Schedule Conflict Alert -->
    @if (studentConflicts.Any())
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4 p-4" style="background-color: #fffbeb; border-left: 5px solid #f59e0b !important;">
            <div class="d-flex align-items-center gap-3 mb-2">
                <i class="fas fa-exclamation-triangle text-warning fs-2"></i>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Schedule Conflict Detected (@studentConflicts.Count)</h5>
                    <span class="text-muted small">One or more of your meetings overlaps your supervisor's declared unavailable period.</span>
                </div>
            </div>
            <div class="mt-3">
                @foreach (var sc in studentConflicts)
                {
                    <div class="bg-white p-3 rounded-3 shadow-sm border border-warning border-opacity-25 mb-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="fw-bold text-dark">Meeting on @sc.MeetingDate.ToString("dd MMM yyyy") at @sc.MeetingTime</span>
                                @if (sc.Status == "Approved")
                                {
                                    <span class="badge px-2 py-1 fw-bold bg-success text-white border border-success shadow-sm ms-2">
                                        <i class="fas fa-check-circle me-1"></i>Approved
                                    </span>
                                }
                                else if (sc.Status == "Pending")
                                {
                                    <span class="badge px-2 py-1 fw-bold bg-warning text-dark border border-warning shadow-sm ms-2">
                                        <i class="fas fa-hourglass-half me-1"></i>Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge px-2 py-1 fw-bold bg-secondary text-white border shadow-sm ms-2">
                                        @sc.Status
                                    </span>
                                }
                            </div>
                            <span class="badge px-2 py-1 fw-bold bg-danger text-white border border-danger shadow-sm">
                                <i class="fas fa-exclamation-triangle me-1"></i>Schedule Conflict (Overlaps Busy Period)
                            </span>
                        </div>
                        <p class="text-muted small mb-0 mt-2">
                            <i class="fas fa-info-circle text-primary me-1"></i> Your booking has <strong>not</strong> been cancelled. It remains in its current status. Please wait for an updated schedule from your supervisor or contact them directly.
                        </p>
                    </div>
                }
            </div>
        </div>
    }

    @{
        var allPendingRequests = ViewBag.PendingReschedules as IEnumerable<FYPTracker.Models.MeetingRescheduleRequest>;
        var supervisorProposals = allPendingRequests?.Where(r => r.Status == "CounterProposed").ToList() ?? new List<FYPTracker.Models.MeetingRescheduleRequest>();
    }
    @if (supervisorProposals.Any())
    {
        <div class="alert alert-info border-0 rounded-4 shadow-sm mb-4 p-4" style="background-color: #f0fdf4; border-left: 5px solid #10b981 !important;">
            <div class="d-flex align-items-center gap-3 mb-3">
                <i class="fas fa-calendar-check text-success fs-2"></i>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Supervisor Proposed New Meeting Time (@supervisorProposals.Count)</h5>
                    <span class="text-muted small">Your supervisor has proposed an updated date and time for your meeting. Please accept or reject below.</span>
                </div>
            </div>
            @foreach (var sp in supervisorProposals)
            {
                <div class="bg-white p-3 rounded-3 shadow-sm border border-success border-opacity-25 mb-2">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <div>
                            <div class="fw-bold text-dark">
                                <span class="text-muted">Original Schedule:</span> @sp.OriginalDate.ToString("dd MMM yyyy") at @sp.OriginalTime
                                <i class="fas fa-arrow-right text-primary mx-2"></i>
                                <span class="text-success fw-bold">Proposed: @sp.ProposedDate.ToString("dd MMM yyyy") at @sp.ProposedTime</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-action="AcceptRescheduleProposal" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@sp.Id" />
                                <button type="submit" class="btn btn-sm btn-success fw-bold px-3">
                                    <i class="fas fa-check me-1"></i> Accept New Time
                                </button>
                            </form>
                            <form asp-action="DeclineRescheduleProposal" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@sp.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold px-3">
                                    <i class="fas fa-times me-1"></i> Reject
                                </button>
                            </form>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(sp.SupervisorResponse) || !string.IsNullOrWhiteSpace(sp.Reason))
                    {
                        <div class="small text-muted bg-light p-2 rounded border mt-2">
                            <i class="fas fa-comment-dots text-primary me-1"></i><strong>Supervisor's Reason:</strong> @(sp.SupervisorResponse ?? sp.Reason)
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Tomorrow's Meeting Reminder -->
    @{
        var meetingsList = ViewBag.Meetings as List<FYPTracker.Models.MeetingBooking> ?? new List<FYPTracker.Models.MeetingBooking>();
        var tomorrowMeetings = meetingsList.Where(m => m.Status == "Approved" && m.MeetingDate.Date == DateTime.Today.AddDays(1).Date).ToList();
    }
    @if (tomorrowMeetings.Any())
    {
        foreach(var tm in tomorrowMeetings)
        {
            bool hasConflict = conflictMeetingIds.Contains(tm.Id);
            <div class="alert @(hasConflict ? "alert-warning" : "alert-primary") border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" style="@(hasConflict ? "background-color: #fef3c7;" : "background-color: #e0f2fe;")">
                <i class="fas @(hasConflict ? "fa-exclamation-triangle text-warning" : "fa-bell text-primary") fa-2x me-3"></i>
                <div>
                    <h5 class="mb-1 fw-bold @(hasConflict ? "text-dark" : "text-primary")">
                        @(hasConflict ? "Notice: Upcoming Meeting Tomorrow with Schedule Conflict" : "Reminder: Upcoming Meeting Tomorrow!")
                    </h5>
                    <p class="mb-0 text-dark">
                        You have an approved meeting scheduled for tomorrow at <strong>@tm.MeetingTime</strong>.
                        @if (hasConflict)
                        {
                            <span class="text-danger fw-semibold d-block mt-1">
                                <i class="fas fa-exclamation-circle me-1"></i> Note: This meeting overlaps your supervisor's declared unavailable period. Please verify with your supervisor whether the meeting will take place as scheduled or be rescheduled.
                            </span>
                        }
                    </p>
                    @if(!string.IsNullOrEmpty(tm.MeetingLink)) {
                        <p class="mb-0 mt-1"><a href="@tm.MeetingLink" target="_blank" class="btn btn-sm btn-primary"><i class="fas fa-video me-1"></i> Join Online Meeting</a></p>
                    } else if(!string.IsNullOrEmpty(tm.Location)) {
                        <p class="mb-0 mt-1 text-dark"><i class="fas fa-map-marker-alt text-danger me-1"></i> <strong>Location / Link:</strong> @tm.Location</p>
                    }
                </div>
            </div>
        }
    }

    <!-- Tabs Nav -->
    @if (assignedSupervisor != null && !supervisorHasAvailability)
    {
        <div class="alert border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-3 p-4" style="background: linear-gradient(135deg, #fef3c7, #fffbeb); border-left: 5px solid #f59e0b !important;">
            <span class="fs-2"><i class="fas fa-exclamation-triangle text-warning"></i></span>
            <div>
                <h6 class="fw-bold text-dark mb-1">Teaching Timetable Missing</h6>
                <p class="mb-0 text-muted" style="font-size:0.9rem;">
                    Your supervisor <strong>@assignedSupervisor.FullName</strong> has not uploaded a teaching timetable yet.
                    You will be able to book meetings once they upload their timetable to the system. Please contact them if this persists.
                </p>
            </div>
        </div>
    }

    <!-- Tabs Nav -->
    <ul class="nav nav-pills mb-4" id="meetingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold px-4 rounded-pill" id="list-tab" data-bs-toggle="pill" data-bs-target="#list-view" type="button" role="tab" aria-controls="list-view" aria-selected="true">
                <i class="fas fa-list-ul me-2"></i> List View
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4 rounded-pill ms-2" id="calendar-tab" data-bs-toggle="pill" data-bs-target="#calendar-view" type="button" role="tab" aria-controls="calendar-view" aria-selected="false">
                <i class="fas fa-calendar-alt me-2"></i> Calendar View
            </button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="meetingTabsContent">
        <!-- List View -->
        <div class="tab-pane fade show active" id="list-view" role="tabpanel" aria-labelledby="list-tab">
            <div class="card border-0 shadow-sm rounded-3 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-dark mb-0"><i class="fas fa-list-ul text-danger me-2"></i>Meeting List Table</h5>
            @if (assignedSupervisor == null)
            {
                <a href="/Student/SelectSupervisor" class="btn btn-outline-danger rounded-3 px-4">
                    <i class="fas fa-search me-1"></i> Select a Supervisor
                </a>
            }
            else if (!supervisorHasAvailability)
            {
                <button type="button" class="btn btn-secondary rounded-3 px-4" disabled
                        title="Your supervisor has not uploaded a teaching timetable yet.">
                    <i class="fas fa-clock me-1"></i> Awaiting Supervisor Timetable
                </button>
            }
            else
            {
                <button type="button" class="btn btn-submit" data-bs-toggle="modal" data-bs-target="#scheduleMeetingModal">
                    <i class="fas fa-plus-circle me-1"></i> Schedule Meeting
                </button>
            }
        </div>
        @if(!meetings.Any()) {
            <p class="text-muted">No meetings booked yet.</p>
        }
        @foreach (var stageGroup in meetings.GroupBy(m => m.Stage).OrderBy(g => g.Key))
        {
        <h6 class="fw-bold text-primary mt-2 mb-3">Stage @stageGroup.Key Meetings</h6>
        <div class="table-responsive mb-4">
            <table class="table align-middle table-hover">
                <thead>
                    <tr>
                        <th class="ps-3" style="width: 120px;">Stage & Week</th>
                        <th>Date</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    
                    <!-- Dynamic database meetings -->
                    @foreach (var m in stageGroup)
                    {
                        var badgeCls = m.Status switch
                        {
                            "Approved" => "badge-approved",
                            "Rejected" => "badge-rejected",
                            "Postponed" => "badge-postponed",
                            _ => "badge-pending"
                        };

                        string displayTime = m.MeetingTime;
                        try {
                            if(TimeSpan.TryParse(m.MeetingTime, out var ts)) {
                                displayTime = DateTime.Today.Add(ts).ToString("h:mm tt");
                            }
                        } catch {}

                        <tr id="meetingRow_@m.Id">
                            <td class="ps-3">
                                <span class="badge @(m.Stage == 1 ? "bg-info" : "bg-primary")">Stage @m.Stage</span><br/>
                                @if(m.WeekNumber > 0) {
                                    <span class="badge bg-secondary text-white mt-1">Week @m.WeekNumber</span>
                                } else {
                                    <span class="badge bg-light text-muted mt-1 border">Unlogged</span>
                                }
                            </td>
                            <td>
                                <div>@m.MeetingDate.ToString("dd/MM/yyyy")</div>
                                @if (conflictMeetingIds.Contains(m.Id))
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 mt-1" style="font-size: 0.7rem;">
                                        <i class="fas fa-exclamation-triangle me-1"></i>Conflict
                                    </span>
                                }
                            </td>
                            <td>@m.MeetingDay</td>
                            <td>@displayTime</td>
                            <td>@m.Reason</td>
                            <td>
                                <span class="status-badge @badgeCls">@m.Status</span>
                                @if (conflictMeetingIds.Contains(m.Id))
                                {
                                    <div class="text-danger small mt-1" style="font-size: 0.7rem;">
                                        <i class="fas fa-calendar-times me-1"></i>Overlaps Busy Date
                                    </div>
                                }
                            </td>
                            <td class="text-end pe-3">
                                @{
                                    var pendingReq = ((IEnumerable<FYPTracker.Models.MeetingRescheduleRequest>)ViewBag.PendingReschedules)?.FirstOrDefault(r => r.MeetingBookingId == m.Id);
                                }
                                @if (pendingReq != null)
                                {
                                    if (pendingReq.Status == "CounterProposed")
                                    {
                                        <div class="d-inline-flex flex-column align-items-end me-1">
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 mb-1 fw-bold" style="font-size: 0.75rem;">
                                                <i class="fas fa-calendar-check me-1"></i>Proposed: @pendingReq.ProposedDate.ToString("dd MMM yyyy") at @pendingReq.ProposedTime
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(pendingReq.SupervisorResponse ?? pendingReq.Reason))
                                            {
                                                <span class="text-muted small fst-italic mb-1" style="max-width: 220px; font-size: 0.72rem; text-align: right;">
                                                    "@(pendingReq.SupervisorResponse ?? pendingReq.Reason)"
                                                </span>
                                            }
                                            <div class="d-flex gap-1">
                                                <form asp-action="AcceptRescheduleProposal" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@pendingReq.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success fw-bold px-2 py-1" style="font-size: 0.78rem;">
                                                        <i class="fas fa-check me-1"></i>Accept
                                                    </button>
                                                </form>
                                                <form asp-action="DeclineRescheduleProposal" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@pendingReq.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger fw-bold px-2 py-1" style="font-size: 0.78rem;">
                                                        <i class="fas fa-times me-1"></i>Reject
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark me-1">Reschedule Pending</span>
                                        <form asp-action="CancelRescheduleRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@pendingReq.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-semibold border-0" title="Cancel Reschedule Request">
                                                Cancel Request
                                            </button>
                                        </form>
                                    }
                                }
                                else if (m.Status == "Pending")
                                {
                                    <span class="badge bg-light text-muted border me-1"><i class="fas fa-hourglass-half me-1"></i>Awaiting Approval</span>
                                    <form asp-action="CancelMeeting" method="post" class="d-inline" id="cancelForm_@m.Id">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="meetingId" value="@m.Id" />
                                        <button type="button" class="btn btn-sm btn-outline-danger border-0 fw-semibold" onclick="confirmCancel(@m.Id)">Cancel</button>
                                    </form>
                                }
                                else if (m.Status == "Approved")
                                {
                                    bool isEligibleForReschedule = m.MeetingDate.Date >= DateTime.Today && (m.MeetingLog == null || m.MeetingLog.LogStatus != "Signed");
                                    if (isEligibleForReschedule)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary border-0 fw-semibold me-1" onclick="openRescheduleModal(@m.Id, '@m.MeetingDate.ToString("yyyy-MM-dd")', '@displayTime', '@m.MeetingTime')">
                                            <i class="fas fa-calendar-alt me-1"></i>Request Reschedule
                                        </button>
                                    }

                                    if (m.MeetingLog == null || m.MeetingLog.LogStatus == "Draft")
                                    {
                                        if (m.MeetingDate.Date <= DateTime.Today)
                                        {
                                            var nextApprovedMeeting = meetings
                                                .Where(n =>
                                                    n.StudentId == m.StudentId &&
                                                    n.SupervisorId == m.SupervisorId &&
                                                    n.Stage == m.Stage &&
                                                    n.AcademicSessionId == m.AcademicSessionId &&
                                                    n.Status == "Approved" &&
                                                    n.MeetingDate.Date > m.MeetingDate.Date)
                                                .OrderBy(n => n.MeetingDate)
                                                .ThenBy(n => n.MeetingTime)
                                                .FirstOrDefault();

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary border-0 fw-semibold me-1"
                                                    data-id="@m.Id"
                                                    data-stage="@m.Stage"
                                                    data-student="@(currentUser?.FullName ?? "")"
                                                    data-supervisor="@(m.Supervisor?.FullName ?? "")"
                                                    data-meeting-date="@m.MeetingDate.ToString("yyyy-MM-dd")"
                                                    data-next-date="@(nextApprovedMeeting?.MeetingDate.ToString("yyyy-MM-dd") ?? "")"
                                                    data-topics="@(m.MeetingLog?.KeyTopicsDiscussed ?? "")"
                                                    data-completed="@(m.MeetingLog?.CompletedActionsAndNotes ?? "")"
                                                    data-action="@(m.MeetingLog?.ActionPointsForNextMeeting ?? "")"
                                                    onclick="openStudentLogModal(this)">

                                                <i class="fas fa-edit"></i>
                                                @(m.MeetingLog == null ? "Record Logbook" : "Edit Logbook")
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary border-0 fw-semibold me-1"
                                                    disabled
                                                    title="Available on @m.MeetingDate.ToString("dd MMM yyyy")">
                                                <i class="fas fa-clock"></i>
                                                Available on @m.MeetingDate.ToString("dd MMM yyyy")
                                            </button>
                                        }
                                    }
                                    else if (m.MeetingLog.LogStatus == "Signed")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success border-0 fw-semibold me-1"
                                                onclick="viewFinalLog(@m.MeetingLog.Id)">
                                            <i class="fas fa-file-contract"></i>
                                            View Log
                                        </button>
                                    }
                                }
                                else if (m.Status == "Postponed")
                                {
                                    <form asp-action="AcceptPostponedMeeting" method="post" class="d-inline" id="acceptForm_@m.Id">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="meetingId" value="@m.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success border-0 fw-semibold me-1">Accept</button>
                                    </form>
                                    <form asp-action="CancelMeeting" method="post" class="d-inline" id="cancelForm_@m.Id">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="meetingId" value="@m.Id" />
                                        <button type="button" class="btn btn-sm btn-outline-danger border-0 fw-semibold" onclick="confirmCancel(@m.Id)">Cancel</button>
                                    </form>
                                }

                                <button type="button" class="btn btn-sm btn-outline-secondary border-0 fw-semibold" 
                                        data-status="@m.Status" 
                                        data-note="@(m.SupervisorNote ?? "None")"
                                        data-date="@m.MeetingDate.ToString("dd MMM yyyy")"
                                        data-proposed-date="@(m.ProposedNewDate?.ToString("dd MMM yyyy") ?? "")"
                                        data-proposed-iso="@(m.ProposedNewDate?.ToString("yyyy-MM-dd") ?? "")"
                                        data-location="@m.Location"
                                        data-meetinglink="@m.MeetingLink"
                                        onclick="viewMeetingDetails(this)">
                                    Details
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    </div>
    </div> <!-- End List View -->
    
    <!-- Calendar View -->
    <div class="tab-pane fade" id="calendar-view" role="tabpanel" aria-labelledby="calendar-tab">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fas fa-calendar-alt text-primary me-2"></i>Meeting Calendar</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fas fa-circle me-1" style="font-size: 0.6rem;"></i>Approved</span>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="fas fa-circle me-1" style="font-size: 0.6rem;"></i>Pending / Postponed</span>
                </div>
            </div>
            <div id="calendarEmptyAlert" class="alert alert-light border text-center py-3 mb-3 text-muted" style="display:none;">
                <i class="fas fa-calendar-times text-secondary me-2"></i>No scheduled meetings found in your calendar. You can schedule a meeting using the <strong>Schedule Meeting</strong> button.
            </div>
            <div id="calendar" style="min-height: 500px;"></div>
        </div>
    </div>
    <!-- End Calendar View -->
    
    </div> <!-- End tab-content -->
</div>

@if (assignedSupervisor != null && supervisorHasAvailability)
{
    <!-- Schedule Meeting Modal -->
    <div class="modal fade" id="scheduleMeetingModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <form asp-action="SubmitMeetingBooking" method="post" id="bookingForm" onsubmit="return confirmBookingSubmission(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="supervisorId" value="@assignedSupervisor.Id" />
                    
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold text-dark"><i class="fas fa-plus-circle text-danger me-2"></i>Schedule Meeting</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    
                    <div class="modal-body">
                        <!-- Supervisor Name (Auto-filled & Read-only) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Supervisor</label>
                            <input type="text" class="form-control bg-light border-0" value="@assignedSupervisor.FullName" readonly />
                        </div>

                        <!-- Date Picker -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Date</label>
                            @{
                                var session = ViewBag.ActiveSession as AcademicSession;
                                var cutoff = (DateTime?)ViewBag.MeetingBookingCutoff;

                                DateTime minDate = DateTime.Today;
                                DateTime maxDate = DateTime.Today;

                                bool noValidDates = true;

                                if (session?.StartDate is DateTime start &&
                                    session.EndDate is DateTime end &&
                                    cutoff.HasValue)
                                {
                                    minDate = start.Date > DateTime.Today
                                        ? start.Date
                                        : DateTime.Today;

                                    maxDate = cutoff.Value.Date < end.Date
                                        ? cutoff.Value.Date
                                        : end.Date;

                                    noValidDates = minDate > maxDate;
                                }
                            }
                            @if (noValidDates)
                            {
                                <div class="alert alert-warning">
                                    No available meeting dates in this academic session.
                                </div>
                            }
                            else
                            {
                                <input type="date"
                                    name="meetingDate"
                                    id="meetingDate"
                                    class="form-control"
                                    required
                                    onchange="calculateDay()"
                                    min="@minDate.ToString("yyyy-MM-dd")"
                                    max="@maxDate.ToString("yyyy-MM-dd")" />

                                <small class="text-muted">
                                    Available dates:
                                    @minDate.ToString("dd/MM/yyyy")
                                    -
                                    @maxDate.ToString("dd/MM/yyyy")
                                </small>
                            }
                        </div>

                        <!-- Day (Auto-filled & Read-only) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Day</label>
                            <input type="text" id="meetingDay" class="form-control bg-light border-0" readonly placeholder="Pick a date first" />
                        </div>

                        <!-- Available Slots Grid -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Available Slots</label>
                            <input type="hidden" name="meetingTime" id="meetingTimeInput" required />
                            <div id="meetingAlertContainer"></div>
                            <div class="row g-2" id="timeSlotsContainer">
                                <div class="col-12 text-muted small"><i class="fas fa-arrow-up"></i> Please pick a date first to see available slots.</div>
                            </div>
                            <div id="timeError" class="text-danger mt-2 small" style="display:none;">Please pick an available time slot.</div>
                        </div>

                        <!-- Reason -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Reason / Agenda</label>
                            <textarea name="reason" id="meetingReason" class="form-control" rows="3" required placeholder="Describe purpose of meeting..."></textarea>
                            <div id="meetingReasonError" class="text-danger fw-bold small mt-1 d-none">Please provide a detailed agenda (at least 10 characters).</div>
                        </div>
                    </div>
                    
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit"
                            id="submitBookingBtn"
                            class="btn btn-submit px-4 rounded-3"
                            disabled="@noValidDates">
                        Submit Booking
                    </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@{
