@using FYPTracker.Models
@{
    ViewData["Title"] = "Select Supervisor";
    var currentUser     = ViewBag.CurrentUser as ApplicationUser;
    var supervisors     = ViewBag.Supervisors as List<ApplicationUser> ?? new();
    var applicantCounts = ViewBag.ApplicantCounts as Dictionary<int, int> ?? new();
    var myRequests      = ViewBag.MyRequests  as List<SupervisorRequest> ?? new();
    var hasApproved     = myRequests.Any(r => r.Status == "Approved");
    var activeCount     = myRequests.Count(r => r.Status == "Pending" || r.Status == "Approved");
}

<div class="container-xxl py-4">

    @if (hasApproved)
    {
        var approved = myRequests.First(r => r.Status == "Approved");
        <div class="alert alert-success border-0 rounded-3 shadow-sm p-4 mb-4 d-flex align-items-center gap-3">
            <span class="fs-2 text-success"><i class="fas fa-check-circle"></i></span>
            <div>
                <h5 class="fw-bold mb-1">Supervisor Confirmed</h5>
                <div>You are officially supervised by <strong>@approved.Supervisor?.FullName</strong> (@approved.Supervisor?.Email).</div>
            </div>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-4">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4">@TempData["Error"]</div>
    }

    <!-- Welcome Header (Navy-blue matching Dashboard) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background-color: #0f172a; color: white;">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bolder mb-1"><i class="fas fa-user-tie me-2"></i>Select Your FYP Supervisor</h4>
                <p class="mb-0 text-white-50 fs-7 fw-bold">You may only select one supervisor. Your request will expire in @ViewBag.SupervisorRequestTimeoutDays days if not responded to.</p>
            </div>
            <div>
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill fw-bold fs-7">@activeCount @(activeCount == 1 ? "Pending Request" : "Pending Requests")</span>
            </div>
        </div>
    </div>

    @if (ViewBag.IsProfileIncomplete == true)
    {
        <div class="alert alert-warning border-0 rounded-3 shadow-sm p-5 mb-4 d-flex align-items-center gap-4" style="background-color: #fff3cd;">
            <span class="fs-1 text-warning"><i class="fas fa-exclamation-triangle"></i></span>
            <div>
                <h4 class="fw-bold mb-2 text-dark">Profile Configuration Pending</h4>
                <div class="text-dark fs-6">
                    Your account is missing essential academic information (Programme or Academic Session).<br/>
                    <strong>Please contact your FYP Coordinator or Administrator to configure your profile before you can select a supervisor.</strong>
                </div>
            </div>
        </div>
    }
    else if (!hasApproved)
    {
        <div class="row g-4">
            <!-- Table and Search -->
            <div class="col-lg-9">
                <!-- Search & Filter Controls -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-3">
                        <div class="d-flex gap-0 align-items-stretch">
                            <input type="text" id="supSearch" class="form-control border-end-0 rounded-start-3 rounded-end-0" placeholder="Search by name or expertise..." onkeyup="filterSupervisors()" />
                            <select id="deptFilter" class="form-select bg-light border-start-0 rounded-start-0 rounded-end-3 w-auto" onchange="filterSupervisors()">
                                <option value="">All Departments</option>
                                @{
                                    var departments = ViewBag.Departments as List<string> ?? new List<string>();
                                    foreach (var dept in departments)
                                    {
                                        if (!string.IsNullOrEmpty(dept))
                                        {
                                            <option value="@dept">@dept</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Supervisor Table -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table align-middle table-hover mb-0" id="supervisorTable">
                                <thead>
                                    <tr class="text-muted small fw-bold text-uppercase border-bottom">
                                        <th style="width: 50px;">No</th>
                                        <th>Name</th>
                                        <th>Department</th>
                                        <th>Programme</th>
                                        <th>Specialization</th>
                                        <th>Available Slots</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int num = 1; }
                                    @foreach (var sup in supervisors)
                                    {
                                        var existing = myRequests.FirstOrDefault(r => r.SupervisorId == sup.Id);
                                        var appCount = applicantCounts.ContainsKey(sup.Id) ? applicantCounts[sup.Id] : 0;
                                        
                                        // Dynamically read MaxStudentSlots from the DB
                                        int maxSlots = sup.MaxStudentSlots ?? 5;
                                        int slotsLeft = Math.Max(0, maxSlots - appCount);
                                        string deptLabel = sup.EmpDepartment?.Name ?? "-";
                                        string programme = !string.IsNullOrEmpty(sup.Programme) ? sup.Programme : "-";
                                        string specialization = !string.IsNullOrEmpty(sup.Specialization) ? sup.Specialization : "-";
                                        
                                        <tr class="sup-row" data-dept="@deptLabel" data-name="@sup.FullName" data-prog="@programme" data-spec="@specialization">
                                            <td class="text-muted fw-bold">@(num++)</td>
                                            <td>
                                                <div class="fw-bold text-dark fs-7">@sup.FullName</div>
                                                <div class="text-muted fs-8">@sup.Email</div>
                                            </td>
                                            <td class="fs-8">@deptLabel</td>
                                            <td class="fs-8">@programme</td>
                                            <td class="fs-8">@specialization</td>
                                            <td class="fs-8">
                                                @if (slotsLeft > 0)
                                                {
                                                    <span class="text-success fw-bold">@slotsLeft of @maxSlots slots available</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger fw-bold">Full</span>
                                                }
                                            </td>
                                            <td>
                                                @if (slotsLeft > 0)
                                                {
                                                    <span class="badge bg-info text-dark rounded-pill px-2 py-1 fs-8 fw-bold">Open</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1 fs-8 fw-bold">Full</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (existing != null)
                                                {
                                                    <span class="badge @(existing.Status == "Approved" ? "bg-success" : existing.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark") rounded-pill px-2 py-1 fs-8 fw-bold" id="table-status-@existing.Id">@existing.Status</span>
                                                }
                                                else if (slotsLeft > 0 && activeCount < 1)
                                                {
                                                    <button class="btn btn-primary btn-sm fw-bold px-3 py-1" onclick="openApplyConfirmation(@sup.Id, '@sup.FullName')">Select</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-secondary btn-sm fw-bold px-3 py-1" disabled>Select</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side Panel Choice & Countdown -->
            <div class="col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom pt-3 pb-2">
                        <h6 class="fw-bolder text-dark mb-0"><i class="fas fa-tasks text-primary me-2"></i>Request Status</h6>
                    </div>
                    <div class="card-body p-4">
                        @if (!myRequests.Any())
                        {
                            <p class="text-muted fs-8 text-center mt-3">No applications submitted yet. Select a supervisor from the table.</p>
                        }
                        @{ int reqCounter = 1; }
                        @foreach (var req in myRequests)
                        {
                            <div class="p-3 border rounded-3 mb-3 bg-light" id="side-req-box-@req.Id">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-white text-dark border px-2 py-1 rounded-pill fs-8">#@(reqCounter++)</span>
                                    <span class="badge @(req.Status == "Approved" ? "bg-success" : req.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark") rounded-pill px-2 py-1 fs-8 fw-bold" id="side-status-@req.Id">@req.Status</span>
                                </div>
                                <div class="fw-bold text-dark fs-7"><i class="fas fa-user-tie me-1 text-muted"></i>@req.Supervisor?.FullName</div>
                                <div class="text-muted mb-2 mt-1 fs-8 fw-bold"><strong>Topic:</strong> @req.ProjectTopic</div>
                                
                                <div class="text-muted mb-2 fs-8">
                                    <div><i class="far fa-calendar-plus me-1"></i>Requested: @req.RequestedDate.ToString("dd MMM yyyy")</div>
                                    @if (req.Status == "Pending")
                                    {
                                        var deadline = req.RequestedDate.AddDays(ViewBag.SupervisorRequestTimeoutDays);
                                        <div><i class="far fa-clock me-1"></i>Deadline: @deadline.ToString("dd MMM yyyy, h:mm tt")</div>
                                    }
                                </div>

                                @if (req.Status == "Pending")
                                {
                                    <div class="badge bg-danger rounded-pill w-100 mt-1 d-flex align-items-center justify-content-center gap-1 py-2 fs-8 fw-bold" id="side-countdown-@req.Id">
                                        <i class="far fa-clock"></i>
                                        <span class="countdown-timer" data-expiry="@req.RequestedDate.AddDays(ViewBag.SupervisorRequestTimeoutDays).ToString("o")">Calculating...</span>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(req.ResponseNote))
                                {
                                    <div class="mt-2 text-muted fs-8 p-2 rounded" style="background:#f1f5f9; border-left: 3px solid #6b7280;">
                                        <strong>Note:</strong> @req.ResponseNote
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center">
            <i class="fas fa-check-circle text-success mb-3" style="font-size: 4rem;"></i>
            <h3 class="fw-bold text-dark">Supervision Confirmed</h3>
            <p class="text-muted mb-4 fs-6">Your supervision request has been accepted. You can now start submitting chapters and view milestones!</p>
            <div>
                <a href="/Student/Index" class="btn btn-primary fw-bold rounded-pill px-5 py-2">Go To Dashboard</a>
            </div>
        </div>
    }
</div>

<!-- DETAILED SUPERVISOR SELECTION & CONFIRMATION MODAL -->
<div class="modal fade" id="applyConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-sm rounded-3 overflow-hidden">
            <form asp-action="SubmitSupervisorRequest" method="post" id="subReqForm">
                <input type="hidden" name="supervisorId" id="modalSupId" />
                <div class="modal-header border-bottom bg-light">
                    <h5 class="fw-bold text-dark mb-0"><i class="fas fa-paper-plane text-primary me-2"></i>Request Supervisor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    
                    <!-- Confirmation Statement Box -->
                    <div class="alert alert-warning border-0 p-3 mb-4 rounded-3 d-flex align-items-center gap-3">
                        <i class="fas fa-question-circle fs-3 text-warning"></i>
                        <h6 class="fw-bold mb-0 text-dark" id="confirmationText">Are you sure you want to request [Supervisor] as your supervisor?</h6>
                    </div>

                    <div class="card border mb-4 shadow-none">
                        <div class="card-header bg-light pt-3 pb-2 border-bottom">
                            <h6 class="fw-bold text-dark mb-0"><i class="fas fa-user-edit text-muted me-2"></i>Part A: Student & Request Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold fs-8">Full Name</label>
                                    <input type="text" class="form-control form-control-sm bg-light border-0" value="@currentUser?.FullName" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold fs-8">Matric ID</label>
                                    <input type="text" name="matricNumber" class="form-control form-control-sm bg-light border-0" value="@currentUser?.EmployeeId" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold fs-8">Program</label>
                                    <input type="text" name="program" class="form-control form-control-sm bg-light border-0" value="@currentUser?.Programme" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold fs-8">Phone Number <span class="text-danger">*</span></label>
                                    <input type="tel" name="phoneNumber" id="modalPhone" class="form-control form-control-sm" value="@currentUser?.Phone" placeholder="012-3456789" required />
                                    <div id="modalPhoneError" class="text-danger fs-8 mt-1 d-none">Please provide a valid Malaysia Phone Number (e.g. 012-3456789).</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold fs-8">Session / Semester</label>
                                    <input type="text" name="sessionSemester" class="form-control form-control-sm bg-light border-0" value="@currentUser?.AcademicSession" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border shadow-none">
                        <div class="card-header bg-light pt-3 pb-2 border-bottom">
                            <h6 class="fw-bold text-dark mb-0"><i class="fas fa-file-alt text-muted me-2"></i>Part B: Project Topic</h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold fs-8">Project Topic / Proposed Title</label>
                                <input type="text" name="projectTopic" id="projectTopic" class="form-control form-control-sm" placeholder="Enter your proposed project title" minlength="5" maxlength="200" required />
                                <div id="projectTopicError" class="text-danger fs-8 mt-1 d-none">Please enter a valid project topic (min 5 characters).</div>
                            </div>
                            <div class="mb-0">
                                <label class="form-label fw-semibold fs-8">Brief Proposal / Message</label>
                                <textarea name="requestMessage" id="requestMessage" class="form-control form-control-sm" rows="4" placeholder="e.g. My project aims to solve [Problem] by building a [Solution] using [Tech Stack]..." minlength="10" maxlength="1000" required></textarea>
                                <div id="requestMessageError" class="text-danger fs-8 mt-1 d-none">Please enter a brief proposal (min 10 characters).</div>
                                <div class="form-text mt-2 text-muted fs-8">
                                    <strong class="text-primary"><i class="fas fa-lightbulb me-1"></i>Quick Guide:</strong> Please include:
                                    <ul class="mb-0 ps-3 mt-1">
                                        <li><strong>Problem:</strong> What issue are you trying to solve?</li>
                                        <li><strong>Solution:</strong> What system/app are you building?</li>
                                        <li><strong>Tech Stack:</strong> E.g., .NET Core, React, SQL Server.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-top p-3 bg-light">
                    <button type="button" class="btn btn-secondary btn-sm fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold px-5">Confirm & Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openApplyConfirmation(supId, supName) {
        document.getElementById('modalSupId').value = supId;
        document.getElementById('confirmationText').innerHTML = "Are you sure you want to request <strong>" + supName + "</strong> as your supervisor?";
        new bootstrap.Modal(document.getElementById('applyConfirmModal')).show();
    }

    function filterSupervisors() {
        var query = document.getElementById('supSearch').value.toLowerCase();
        var dept = document.getElementById('deptFilter').value.toLowerCase();
        var rows = document.querySelectorAll('.sup-row');

        rows.forEach(function(row) {
            var name = row.getAttribute('data-name').toLowerCase();
            var prog = row.getAttribute('data-prog').toLowerCase();
            var spec = row.getAttribute('data-spec').toLowerCase();
            var rowDept = row.getAttribute('data-dept').toLowerCase();

            var matchesSearch = name.includes(query) || prog.includes(query) || spec.includes(query);
            var matchesDept = dept === "" || rowDept.includes(dept);

            if (matchesSearch && matchesDept) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    // Dynamic Countdown Timer
    document.addEventListener("DOMContentLoaded", function() {
        var timerElements = document.querySelectorAll('.countdown-timer');
        
        function updateTimers() {
            var now = new Date().getTime();
            timerElements.forEach(function(el) {
                // 2 days expiry from requested date
                var expiryStr = el.getAttribute('data-expiry');
                var expiryDate = new Date(expiryStr);
                var expiryTime = expiryDate.getTime();
                
                var diff = expiryTime - now;
                if (diff <= 0) {
                    el.textContent = "Expired";
                    return;
                }
                
                var days = Math.floor(diff / (1000 * 60 * 60 * 24));
                var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((diff % (1000 * 60)) / 1000);
                
                el.textContent = days + "d " + hours + "h " + minutes + "m " + seconds + "s left";
            });
        }
        
        updateTimers();
        setInterval(updateTimers, 1000);
    });

    const phonePattern = /^(\+?60|0)1[0-9][\-\s]?[0-9]{3,4}[\-\s]?[0-9]{4}$/;

    var modalPhoneInput = document.getElementById('modalPhone');
    if (modalPhoneInput) {
        modalPhoneInput.addEventListener('input', function() {
            var err = document.getElementById('modalPhoneError');
            if (!this.value.trim() || !phonePattern.test(this.value.trim())) {
                err.classList.remove('d-none');
                this.classList.add('is-invalid');
            } else {
                err.classList.add('d-none');
                this.classList.remove('is-invalid');
            }
        });
    }

    document.getElementById('projectTopic').addEventListener('input', function() {
        var err = document.getElementById('projectTopicError');
        if (this.value.trim().length < 5) {
            err.classList.remove('d-none');
            this.classList.add('is-invalid');
        } else {
            err.classList.add('d-none');
            this.classList.remove('is-invalid');
        }
    });

    document.getElementById('requestMessage').addEventListener('input', function() {
        var err = document.getElementById('requestMessageError');
        if (this.value.trim().length < 10) {
            err.classList.remove('d-none');
            this.classList.add('is-invalid');
        } else {
            err.classList.add('d-none');
            this.classList.remove('is-invalid');
        }
    });

    document.getElementById('subReqForm').addEventListener('submit', function(e) {
        var topic = document.getElementById('projectTopic');
        var msg = document.getElementById('requestMessage');
        var phone = document.getElementById('modalPhone');
        var isValid = true;

        if (!phone || !phone.value.trim() || !phonePattern.test(phone.value.trim())) {
            document.getElementById('modalPhoneError').classList.remove('d-none');
            if (phone) phone.classList.add('is-invalid');
            isValid = false;
        }
        
        if (topic.value.trim().length < 5) {
            document.getElementById('projectTopicError').classList.remove('d-none');
            topic.classList.add('is-invalid');
            isValid = false;
        }
        
        if (msg.value.trim().length < 10) {
            document.getElementById('requestMessageError').classList.remove('d-none');
            msg.classList.add('is-invalid');
            isValid = false;
        }
        
        if (!isValid) {
            e.preventDefault();
            return;
        }

        var submitBtn = this.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Requesting...';
    });

    document.addEventListener('RequestStatusUpdateEvent', function(e) {
        var d = e.detail;
        var tableBadge = document.getElementById('table-status-' + d.requestId);
        var sideBadge = document.getElementById('side-status-' + d.requestId);
        var sideBox = document.getElementById('side-req-box-' + d.requestId);
        var countdown = document.getElementById('side-countdown-' + d.requestId);

        var newClass = d.status === 'Approved' ? 'bg-success' : d.status === 'Rejected' ? 'bg-danger' : 'bg-warning text-dark';
        var badgeClasses = 'badge rounded-pill px-2 py-1 fs-8 fw-bold ' + newClass;
        
        if (tableBadge) {
            tableBadge.className = badgeClasses;
            tableBadge.innerText = d.status;
        }
        if (sideBadge) {
            sideBadge.className = badgeClasses;
            sideBadge.innerText = d.status;
        }
        if (countdown && d.status !== 'Pending') {
            countdown.remove();
        }
        if (d.status === 'Approved') {
            // Show a big success message or reload fully so they can go to dashboard
            Swal.fire('Congratulations!', 'Your request was approved. Refreshing dashboard...', 'success').then(() => {
                window.location.reload();
            });
        }
    });
</script>
}
