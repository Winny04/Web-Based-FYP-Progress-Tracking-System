@model FYPTracker.Models.FYPProject
@{
    ViewData["Title"] = "Stage 2: Final Submission";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var milestones = Model.Milestones.ToList();
    
    // Stage 2 Milestones
    var s2Turnitin = milestones.FirstOrDefault(m => m.Title.Equals("Step 1: Turnitin", StringComparison.OrdinalIgnoreCase));
    var s2Dpp = milestones.FirstOrDefault(m => m.Title.Equals("Step 2: DPP report full", StringComparison.OrdinalIgnoreCase));
    var s2Marksheet = milestones.FirstOrDefault(m => m.Title.Equals("Step 3: Marksheet Submission", StringComparison.OrdinalIgnoreCase));
    var s2Meeting = milestones.FirstOrDefault(m => m.Title.Equals("Step 4: Record of Supervisor Meeting Form Submission", StringComparison.OrdinalIgnoreCase));
    var s2Slides = milestones.FirstOrDefault(m => m.Title.Equals("Step 5: Presentation Slides Submission", StringComparison.OrdinalIgnoreCase));

    bool isTurnitinDone = s2Turnitin != null && (s2Turnitin.Status == "Submitted" || s2Turnitin.Status == "Approved" || s2Turnitin.Status == "Completed");
    bool isDppDone = s2Dpp != null && (s2Dpp.Status == "Submitted" || s2Dpp.Status == "Approved" || s2Dpp.Status == "Completed");
    bool isMarksheetDone = s2Marksheet != null && (s2Marksheet.Status == "Submitted" || s2Marksheet.Status == "Approved" || s2Marksheet.Status == "Completed");
    bool isMeetingDone = s2Meeting != null && (s2Meeting.Status == "Submitted" || s2Meeting.Status == "Approved" || s2Meeting.Status == "Completed");
    bool isSlidesDone = s2Slides != null && (s2Slides.Status == "Submitted" || s2Slides.Status == "Approved" || s2Slides.Status == "Completed");
    
    // Overall completion check
    bool isStage2Completed = isTurnitinDone && isDppDone && isMarksheetDone && isMeetingDone && isSlidesDone;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-graduation-cap text-primary me-2"></i>Stage 2: Final Submission</h2>
            <p class="text-muted mb-0">Complete the final requirements for your Final Year Project.</p>
        </div>
        <a href="@Url.Action("Forms", "Student")" class="btn btn-outline-secondary rounded-pill shadow-sm"><i class="fas fa-arrow-left me-2"></i>Back to Stage 1</a>
    </div>

    @if (isStage2Completed)
    {
        <div class="alert alert-success d-flex align-items-center shadow-sm mb-4" role="alert" style="border-left: 5px solid #10b981;">
            <i class="fas fa-check-circle fs-2 me-3 text-success"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1 text-success">Stage 2 Fully Submitted!</h5>
                <p class="mb-0 text-dark">You have successfully uploaded all required documents. Your supervisor and examiner will now grade your final submission.</p>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.FinalGrade))
        {
            <div class="premium-card p-4 mb-4 bg-white border border-primary shadow-sm rounded-4">
                <h4 class="text-primary fw-bold mb-3"><i class="fas fa-award me-2"></i>Final Results</h4>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <span class="d-block text-muted small text-uppercase fw-bold mb-1">Final Grade</span>
                            <span class="fs-2 fw-bold text-primary">@Model.FinalGrade</span>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <span class="d-block text-muted small text-uppercase fw-bold mb-1">Examiner Comments</span>
                            <p class="mb-0">@(string.IsNullOrEmpty(Model.ExaminerComments) ? "No comments provided." : Model.ExaminerComments)</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card premium-card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold mb-0 text-dark">Submission Steps</h5>
                </div>
                <div class="card-body p-4">
                    
                    @* STEP 1: Turnitin *@
                    <div class="mb-5">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-3 @(isTurnitinDone ? "bg-success" : "bg-primary")" style="width: 40px; height: 40px; font-weight: bold; font-size: 18px;">
                                @(isTurnitinDone ? Html.Raw("<i class=\"fas fa-check\"></i>") : "1")
                            </div>
                            <h5 class="fw-bold mb-0 @(isTurnitinDone ? "text-success" : "text-dark")">Step 1: Turnitin Report</h5>
                        </div>
                        <div class="ms-5 ps-2 border-start border-2 @(isTurnitinDone ? "border-success" : "border-light")">
                            <form asp-action="SubmitStage2Milestone" asp-controller="Student" enctype="multipart/form-data" method="post">
                                <input type="hidden" name="stepTitle" value="Step 1: Turnitin" />
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Upload your Turnitin similarity report (PDF only)</label>
                                    @if(isTurnitinDone) {
                                        <div class="alert alert-light border shadow-sm p-3"><i class="fas fa-file-pdf text-danger me-2"></i> Turnitin Report Submitted</div>
                                    } else {
                                        <input class="form-control" type="file" name="file" accept=".pdf" required>
                                        <button type="submit" class="btn btn-primary mt-3 px-4 rounded-pill shadow-sm"><i class="fas fa-upload me-2"></i> Submit Turnitin Report</button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>

                    @* STEP 2: DPP Report *@
                    <div class="mb-5" style="opacity: @(isTurnitinDone ? "1" : "0.5"); pointer-events: @(isTurnitinDone ? "auto" : "none");">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-3 @(isDppDone ? "bg-success" : (isTurnitinDone ? "bg-primary" : "bg-secondary"))" style="width: 40px; height: 40px; font-weight: bold; font-size: 18px;">
                                @(isDppDone ? Html.Raw("<i class=\"fas fa-check\"></i>") : "2")
                            </div>
                            <h5 class="fw-bold mb-0 @(isDppDone ? "text-success" : "text-dark")">Step 2: DPP Report Full</h5>
                        </div>
                        <div class="ms-5 ps-2 border-start border-2 @(isDppDone ? "border-success" : "border-light")">
                            <form asp-action="SubmitStage2Milestone" asp-controller="Student" enctype="multipart/form-data" method="post">
                                <input type="hidden" name="stepTitle" value="Step 2: DPP report full" />
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Upload your full dissertation report (max 300-350 pages, PDF only)</label>
                                    @if(isDppDone) {
                                        <div class="alert alert-light border shadow-sm p-3"><i class="fas fa-file-pdf text-danger me-2"></i> DPP Report Submitted</div>
                                    } else {
                                        <input class="form-control" type="file" name="file" accept=".pdf" required>
                                        <button type="submit" class="btn btn-primary mt-3 px-4 rounded-pill shadow-sm"><i class="fas fa-upload me-2"></i> Submit DPP Report</button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>

                    @* STEP 3: Marksheet Submission *@
                    <div class="mb-5" style="opacity: @(isDppDone ? "1" : "0.5"); pointer-events: @(isDppDone ? "auto" : "none");">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-3 @(isMarksheetDone ? "bg-success" : (isDppDone ? "bg-primary" : "bg-secondary"))" style="width: 40px; height: 40px; font-weight: bold; font-size: 18px;">
                                @(isMarksheetDone ? Html.Raw("<i class=\"fas fa-check\"></i>") : "3")
                            </div>
                            <h5 class="fw-bold mb-0 @(isMarksheetDone ? "text-success" : "text-dark")">Step 3: Marksheet Submission</h5>
                        </div>
                        <div class="ms-5 ps-2 border-start border-2 @(isMarksheetDone ? "border-success" : "border-light")">
                            <form asp-action="SubmitStage2Milestone" asp-controller="Student" enctype="multipart/form-data" method="post">
                                <input type="hidden" name="stepTitle" value="Step 3: Marksheet Submission" />
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Upload your evaluation marksheet template (PDF only)</label>
                                    @if(isMarksheetDone) {
                                        <div class="alert alert-light border shadow-sm p-3"><i class="fas fa-file-pdf text-danger me-2"></i> Marksheet Template Submitted</div>
                                    } else {
                                        <input class="form-control" type="file" name="file" accept=".pdf" required>
                                        <button type="submit" class="btn btn-primary mt-3 px-4 rounded-pill shadow-sm"><i class="fas fa-upload me-2"></i> Submit Marksheet Form</button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>
                    
                    @* STEP 4: Meeting Form *@
                    <div class="mb-5" style="opacity: @(isMarksheetDone ? "1" : "0.5"); pointer-events: @(isMarksheetDone ? "auto" : "none");">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-3 @(isMeetingDone ? "bg-success" : (isMarksheetDone ? "bg-primary" : "bg-secondary"))" style="width: 40px; height: 40px; font-weight: bold; font-size: 18px;">
                                @(isMeetingDone ? Html.Raw("<i class=\"fas fa-check\"></i>") : "4")
                            </div>
                            <h5 class="fw-bold mb-0 @(isMeetingDone ? "text-success" : "text-dark")">Step 4: Record of Supervisor Meeting Form</h5>
                        </div>
                        <div class="ms-5 ps-2 border-start border-2 @(isMeetingDone ? "border-success" : "border-light")">
                            <form asp-action="SubmitStage2Milestone" asp-controller="Student" enctype="multipart/form-data" method="post">
                                <input type="hidden" name="stepTitle" value="Step 4: Record of Supervisor Meeting Form Submission" />
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Upload your completed and signed supervisor meeting record (PDF only)</label>
                                    @if(isMeetingDone) {
                                        <div class="alert alert-light border shadow-sm p-3"><i class="fas fa-file-pdf text-danger me-2"></i> Meeting Record Submitted</div>
                                    } else {
                                        <input class="form-control" type="file" name="file" accept=".pdf" required>
                                        <button type="submit" class="btn btn-primary mt-3 px-4 rounded-pill shadow-sm"><i class="fas fa-upload me-2"></i> Submit Meeting Record</button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>

                    @* STEP 5: Presentation Slides *@
                    <div style="opacity: @(isMeetingDone ? "1" : "0.5"); pointer-events: @(isMeetingDone ? "auto" : "none");">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-3 @(isSlidesDone ? "bg-success" : (isMeetingDone ? "bg-primary" : "bg-secondary"))" style="width: 40px; height: 40px; font-weight: bold; font-size: 18px;">
                                @(isSlidesDone ? Html.Raw("<i class=\"fas fa-check\"></i>") : "5")
                            </div>
                            <h5 class="fw-bold mb-0 @(isSlidesDone ? "text-success" : "text-dark")">Step 5: Presentation Slides</h5>
                        </div>
                        <div class="ms-5 ps-2">
                            <form asp-action="SubmitStage2Milestone" asp-controller="Student" enctype="multipart/form-data" method="post">
                                <input type="hidden" name="stepTitle" value="Step 5: Presentation Slides Submission" />
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Upload your final presentation slides (PDF only)</label>
                                    @if(isSlidesDone) {
                                        <div class="alert alert-light border shadow-sm p-3"><i class="fas fa-file-pdf text-danger me-2"></i> Presentation Slides Submitted</div>
                                    } else {
                                        <input class="form-control" type="file" name="file" accept=".pdf" required>
                                        <button type="submit" class="btn btn-primary mt-3 px-4 rounded-pill shadow-sm"><i class="fas fa-upload me-2"></i> Submit Presentation Slides</button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card premium-card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-info-circle text-primary me-2"></i>Important Notes</h5>
                </div>
                <div class="card-body p-4 text-muted">
                    <ul class="list-unstyled mb-0" style="line-height: 1.8;">
                        <li class="mb-3"><i class="fas fa-angle-right text-primary me-2"></i> You must complete each step in sequential order.</li>
                        <li class="mb-3"><i class="fas fa-angle-right text-primary me-2"></i> The DPP Report must strictly be between 300 to 350 pages long.</li>
                        <li class="mb-3"><i class="fas fa-angle-right text-primary me-2"></i> All uploads must be in <strong>PDF format</strong>.</li>
                        <li><i class="fas fa-angle-right text-primary me-2"></i> Once Step 5 is submitted, your project will be available for joint marking by your Supervisor and Examiner.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
