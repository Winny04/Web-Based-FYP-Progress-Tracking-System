@model FYPTracker.Models.FYPProject
@{
    ViewData["Title"] = "Stage 2: Final Submission";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var milestones = Model.Milestones.ToList();
    // Stage 2 Milestones
    var stage2Milestones = milestones
        .Where(m => m.Title.StartsWith("Step", StringComparison.OrdinalIgnoreCase))
        .OrderBy(m => m.DueDate ?? DateTime.MaxValue)
        .ToList();
    
    // Overall completion check
    bool isStage2Completed = stage2Milestones.All(m => m.Status == "Submitted" || m.Status == "Approved" || m.Status == "Completed");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-graduation-cap text-primary me-2"></i>Stage 2: Final Submission</h2>
            <p class="text-muted mb-0">Complete the final requirements for your Final Year Project.</p>
        </div>
        <a href="@Url.Action("Forms", "Student")" class="btn btn-outline-secondary rounded-pill shadow-sm"><i class="fas fa-arrow-left me-2"></i>Back to Stage 1</a>
    </div>

    @if (isStage2Completed)
    {
        <div class="alert alert-success d-flex align-items-center shadow-sm mb-4" role="alert" style="border-left: 5px solid #10b981;">
            <i class="fas fa-check-circle fs-2 me-3 text-success"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1 text-success">Stage 2 Fully Submitted!</h5>
                <p class="mb-0 text-dark">You have successfully uploaded all required documents. Your supervisor and examiner will now grade your final submission.</p>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.FinalGrade))
        {
            <div class="premium-card p-4 mb-4 bg-white border border-primary shadow-sm rounded-4">
                <h4 class="text-primary fw-bold mb-3"><i class="fas fa-award me-2"></i>Final Results</h4>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <span class="d-block text-muted small text-uppercase fw-bold mb-1">Final Grade</span>
                            <span class="fs-2 fw-bold text-primary">@Model.FinalGrade</span>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <span class="d-block text-muted small text-uppercase fw-bold mb-1">Examiner Comments</span>
                            <p class="mb-0">@(string.IsNullOrEmpty(Model.ExaminerComments) ? "No comments provided." : Model.ExaminerComments)</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card premium-card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold mb-0 text-dark">Submission Steps</h5>
                </div>
                <div class="card-body p-4">
                    
                    @{
                        bool previousDone = true;
                    }
                    @for (int i = 0; i < stage2Milestones.Count; i++)
                    {
                        var step = stage2Milestones[i];
                        bool isDone = step.Status == "Submitted" || step.Status == "Approved" || step.Status == "Completed";
                        bool isRejected = step.Status == "Rejected" || step.Status == "Revision";
                        bool isUnderReview = step.Status == "UnderReview";
                        bool isUnlocked = previousDone || isRejected || isUnderReview;
                        bool isLast = i == stage2Milestones.Count - 1;

                        string labelText = "Upload your document (PDF only)";
                        string btnText = "Submit Document";
                        if (step.Title.Contains("Turnitin")) { labelText = "Upload your Turnitin similarity report (PDF only)"; btnText = "Submit Turnitin Report"; }
                        else if (step.Title.Contains("DPP")) { labelText = "Upload your full dissertation report (max 300-350 pages, PDF only)"; btnText = "Submit DPP Report"; }
                        else if (step.Title.Contains("Marksheet")) { labelText = "Upload your evaluation marksheet template (PDF only)"; btnText = "Submit Marksheet Form"; }
                        else if (step.Title.Contains("Meeting")) { labelText = "Upload your completed and signed supervisor meeting record (PDF only)"; btnText = "Submit Meeting Record"; }
                        else if (step.Title.Contains("Presentation")) { labelText = "Upload your final presentation slides (PDF only)"; btnText = "Submit Presentation Slides"; }

                        <div class="@(isLast ? "" : "mb-5")" style="opacity: @(isUnlocked ? "1" : "0.5"); pointer-events: @(isUnlocked ? "auto" : "none");">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-3 @(isDone ? "bg-success" : (isUnlocked ? "bg-primary" : "bg-secondary"))" style="width: 40px; height: 40px; font-weight: bold; font-size: 18px;">
                                    @(isDone ? Html.Raw("<i class=\"fas fa-check\"></i>") : (i + 1).ToString())
                                </div>
                                <h5 class="fw-bold mb-0 @(isDone ? "text-success" : (isRejected ? "text-danger" : (isUnderReview ? "text-warning" : "text-dark")))">@step.Title</h5>
                            </div>
                            <div class="ms-5 ps-2 @(isLast ? "" : "border-start border-2 " + (isDone ? "border-success" : (isRejected ? "border-danger" : (isUnderReview ? "border-warning" : "border-light"))))">
                                <form asp-action="SubmitStage2Milestone" asp-controller="Student" enctype="multipart/form-data" method="post">
                                    <input type="hidden" name="stepTitle" value="@step.Title" />
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-bold">@labelText</label>
                                        @{ var latestFile = step.SubmissionFiles?.Where(f => f.UploadedBy == Model.StudentId).OrderByDescending(f => f.UploadedDate).FirstOrDefault(); }
                                        @if(isDone) {
                                            <div class="alert alert-light border shadow-sm p-3 mb-0 d-flex justify-content-between align-items-center">
                                                <span><i class="fas fa-file-pdf text-danger me-2"></i> Document Submitted</span>
                                                @if(latestFile != null && !string.IsNullOrEmpty(latestFile.FilePath)) {
                                                    <a href="@Url.Action("ViewFile", "Student", new { fileId = latestFile.Id })" target="_blank" class="btn btn-sm btn-outline-secondary">View File</a>
                                                }
                                            </div>
                                            @if(step.Status == "Approved" || step.Status == "Completed") {
                                                <div class="text-success mt-2 small fw-bold"><i class="fas fa-check-circle me-1"></i> Approved</div>
                                            }

                                            @if (step.SubmissionFiles != null && step.SubmissionFiles.Any(f => f.UploadedBy != Model.StudentId))
                                            {
                                                <div class="mt-3 p-3 bg-light-primary rounded border border-primary border-opacity-25">
                                                    <h6 class="fw-bold text-primary mb-2 small"><i class="fas fa-comment-dots me-1"></i>Supervisor Feedback Files</h6>
                                                    @foreach (var sFile in step.SubmissionFiles.Where(f => f.UploadedBy != Model.StudentId).ToList())
                                                    {
                                                        <a href="@Url.Action("ViewFile", "Student", new { fileId = sFile.Id })" target="_blank" class="btn btn-sm btn-white border shadow-sm w-100 text-start mb-1 text-truncate">
                                                            <i class="fas fa-file-download text-primary me-2"></i>@sFile.FileName
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        } else {
                                            @if (isRejected || isUnderReview) {
                                                <div class="alert @(isRejected ? "alert-danger" : "alert-warning") shadow-sm p-3 mb-3 border-0" style="border-left: 4px solid @(isRejected ? "#dc3545" : "#ffc107") !important;">
                                                    <h6 class="fw-bold mb-2"><i class="fas fa-exclamation-triangle me-2"></i>@(isRejected ? "Revision Required" : "Needs Attention")</h6>
                                                    <p class="mb-2 text-dark small">@(string.IsNullOrEmpty(step.SupervisorFeedback) ? "Please check your document." : step.SupervisorFeedback)</p>
                                                    @if(latestFile != null && !string.IsNullOrEmpty(latestFile.FilePath)) {
                                                        <a href="@Url.Action("ViewFile", "Student", new { fileId = latestFile.Id })" target="_blank" class="btn btn-sm @(isRejected ? "btn-outline-danger" : "btn-outline-warning") mt-1"><i class="fas fa-eye me-1"></i> View Previous Submission</a>
                                                    }
                                                </div>
                                            }
                                            <input class="form-control" type="file" name="file" accept=".pdf" required>
                                            <button type="submit" class="btn btn-primary mt-3 px-4 rounded-pill shadow-sm"><i class="fas fa-upload me-2"></i> @btnText</button>
                                        }
                                    </div>
                                </form>
                            </div>
                        </div>

                        previousDone = isDone;
                    }

                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card premium-card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-info-circle text-primary me-2"></i>Important Notes</h5>
                </div>
                <div class="card-body p-4 text-muted">
                    <ul class="list-unstyled mb-0" style="line-height: 1.8;">
                        <li class="mb-3"><i class="fas fa-angle-right text-primary me-2"></i> You must complete each step in sequential order.</li>
                        <li class="mb-3"><i class="fas fa-angle-right text-primary me-2"></i> The DPP Report must strictly be between 300 to 350 pages long.</li>
                        <li class="mb-3"><i class="fas fa-angle-right text-primary me-2"></i> All uploads must be in <strong>PDF format</strong>.</li>
                        <li><i class="fas fa-angle-right text-primary me-2"></i> Once Step 5 is submitted, your project will be available for joint marking by your Supervisor and Examiner.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
