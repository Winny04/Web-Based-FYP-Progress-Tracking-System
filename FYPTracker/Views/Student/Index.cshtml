@using FYPTracker.Models
@model FYPProject?
@{
    ViewData["Title"] = "Student Home";
    var currentUser = ViewBag.CurrentUser as ApplicationUser;
    var name = currentUser?.FullName ?? "Student";
    var studentId = currentUser?.EmployeeId ?? "S12345678";
    var supervisorName = Model?.Supervisor?.FullName ?? "Not Assigned";
    var session = !string.IsNullOrEmpty(currentUser?.AcademicSession) ? currentUser.AcademicSession : "—";
    
    var milestones = Model?.Milestones?.ToList() ?? new List<FYPMilestone>();
    int total = milestones.Count;
    int approved = milestones.Count(m => m.Status == "Approved");
    int pending = milestones.Count(m => m.Status == "Submitted" || m.Status == "UnderReview" || m.Status == "Pending" && m.SubmittedDate.HasValue);
    int revision = milestones.Count(m => m.Status == "Rejected" || m.Status == "Revision");
    int notStarted = total - approved - pending - revision;
    
    int pct = total > 0 ? (int)((double)approved / total * 100) : 0;
    
    // Choose progress bar colour based on pct
    string progressColor = "bg-danger"; // 0-30%
    if (pct > 30 && pct <= 60) {
        progressColor = "bg-warning"; // 31-60%
    } else if (pct > 60) {
        progressColor = "bg-success"; // 61-100%
    }
    
    // Upcoming deadline check for the alert bar
    FYPMilestone? upcomingUrgent = milestones
        .Where(m => m.DueDate.HasValue && m.Status != "Approved")
        .OrderBy(m => m.DueDate)
        .FirstOrDefault();
        
    int? daysLeft = null;
    string alertClass = "";
    string alertText = "";
    if (upcomingUrgent != null && upcomingUrgent.DueDate.HasValue) {
        daysLeft = (int)(upcomingUrgent.DueDate.Value - DateTime.Today).TotalDays;
        if (daysLeft < 0) {
            alertClass = "alert-danger bg-danger text-white border-0 shadow-lg glow-alert";
            alertText = $"⚠️ Overdue: {upcomingUrgent.Title} was due on {upcomingUrgent.DueDate.Value:dd/MM/yyyy} — Overdue by {Math.Abs(daysLeft.Value)} days!";
        } else if (daysLeft <= 5) {
            alertClass = "alert-warning bg-warning text-dark border-0 shadow-md";
            alertText = $"⚠️ Upcoming: {upcomingUrgent.Title} is due in {daysLeft} days — {upcomingUrgent.DueDate.Value:dd/MM/yyyy}";
        }
    }
    
    var activities = ViewBag.Activities as List<FYPActivity> ?? new List<FYPActivity>();
    
    // Check if the student has a scheduled defense
    var scheduledDefense = milestones.FirstOrDefault(m => m.RejectionCount >= 3 && m.DefenseDate.HasValue);

    var upcomingMeeting = ViewBag.UpcomingMeeting as MeetingBooking;
    var pendingMeetingsCount = ViewBag.PendingMeetingsCount != null ? (int)ViewBag.PendingMeetingsCount : 0;

    // ── NEXT STEP LOGIC ──
    string nextStepTitle = "";
    string nextStepDesc = "";
    string nextStepIcon = "";
    string nextStepBtnText = "";
    string nextStepLink = "";
    string nextStepColor = "";
    string nextStepDueDate = "";

    if (Model != null && milestones.Any())
    {
        var iaf = milestones.FirstOrDefault(m => m.Title.Contains("IAF"));
        var proposal = milestones.FirstOrDefault(m => m.Title.Contains("Proposal"));
        var progress = milestones.FirstOrDefault(m => m.Title.Contains("Progress"));
        var final = milestones.FirstOrDefault(m => m.Title.Contains("Final"));

        // Check for ANY rejections first (highest priority)
        var rejectedMilestone = milestones.FirstOrDefault(m => m.Status == "Rejected" || m.Status == "Revision");
        if (rejectedMilestone != null)
        {
            nextStepTitle = $"Revision Required: {rejectedMilestone.Title}";
            nextStepDesc = $"Your supervisor has requested revisions for your {rejectedMilestone.Title}. Please review the feedback and resubmit.";
            nextStepIcon = "fas fa-exclamation-triangle";
            nextStepBtnText = "View Feedback & Revise";
            nextStepLink = "/Student/Forms";
            nextStepDueDate = rejectedMilestone.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
        }
        else
        {
            // Calculate strictly sequential next step
            var isIafApproved = iaf != null && iaf.Status == "Approved";
            var isProposalApproved = proposal != null && proposal.Status == "Approved";
            var isProgressApproved = progress != null && progress.Status == "Approved";
            var isFinalApproved = final != null && final.Status == "Approved";

            var isIafPending = iaf != null && (iaf.Status == "Submitted" || iaf.Status == "UnderReview" || (iaf.Status == "Pending" && iaf.SubmittedDate.HasValue));
            var isProposalPending = proposal != null && (proposal.Status == "Submitted" || proposal.Status == "UnderReview" || (proposal.Status == "Pending" && proposal.SubmittedDate.HasValue));
            var isProgressPending = progress != null && (progress.Status == "Submitted" || progress.Status == "UnderReview" || (progress.Status == "Pending" && progress.SubmittedDate.HasValue));
            var isFinalPending = final != null && (final.Status == "Submitted" || final.Status == "UnderReview" || (final.Status == "Pending" && final.SubmittedDate.HasValue));

            if (!isIafApproved && !isIafPending)
            {
                nextStepTitle = "Submit Initial Assessment Form (IAF)";
                nextStepDesc = "Your project is registered. Your first step is to submit your IAF to your supervisor.";
                nextStepIcon = "far fa-file-alt";
                nextStepBtnText = "Go to Forms";
                nextStepLink = "/Student/Forms";
                nextStepDueDate = iaf?.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
            }
            else if (isIafPending)
            {
                nextStepTitle = "Wait for IAF Approval";
                nextStepDesc = "Your IAF is currently under review by your supervisor. You must wait for approval before proceeding.";
                nextStepIcon = "fas fa-hourglass-half";
                nextStepBtnText = "View Status";
                nextStepLink = "/Student/ProjectDetails";
                nextStepDueDate = iaf?.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
            }
            else if (isIafApproved && !isProposalApproved && !isProposalPending)
            {
                nextStepTitle = "Submit Proposal Form";
                nextStepDesc = "Your IAF is approved. You can now submit your formal Project Proposal.";
                nextStepIcon = "fas fa-feather-alt";
                nextStepBtnText = "Submit Proposal";
                nextStepLink = "/Student/Forms";
                nextStepDueDate = proposal?.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
            }
            else if (isProposalPending)
            {
                nextStepTitle = "Wait for Proposal Approval";
                nextStepDesc = "Your Proposal is currently under review by your supervisor.";
                nextStepIcon = "fas fa-hourglass-half";
                nextStepBtnText = "View Status";
                nextStepLink = "/Student/ProjectDetails";
                nextStepDueDate = proposal?.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
            }
            else if (isProposalApproved && !isProgressApproved && !isProgressPending)
            {
                nextStepTitle = "Submit Progress Report";
                nextStepDesc = "Your Proposal is approved. Continue working on your project and submit your Progress Report.";
                nextStepIcon = "fas fa-tasks";
                nextStepBtnText = "Submit Progress Report";
                nextStepLink = "/Student/Forms";
                nextStepDueDate = progress?.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
            }
            else if (isProgressPending)
            {
                nextStepTitle = "Wait for Progress Report Approval";
                nextStepDesc = "Your Progress Report is currently under review by your supervisor.";
                nextStepIcon = "fas fa-hourglass-half";
                nextStepBtnText = "View Status";
                nextStepLink = "/Student/ProjectDetails";
                nextStepDueDate = progress?.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
            }
            else if (isProgressApproved && !isFinalApproved && !isFinalPending)
            {
                nextStepTitle = "Submit Final Submission";
                nextStepDesc = "Your Progress Report is approved. You are now in the final stretch. Submit your Final Documentation.";
                nextStepIcon = "fas fa-graduation-cap";
                nextStepBtnText = "Final Submission";
                nextStepLink = "/Student/Forms";
                nextStepDueDate = final?.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
            }
            else if (isFinalPending)
            {
                nextStepTitle = "Wait for Final Approval";
                nextStepDesc = "Your Final Submission is currently under review by your supervisor.";
                nextStepIcon = "fas fa-hourglass-half";
                nextStepBtnText = "View Status";
                nextStepLink = "/Student/ProjectDetails";
                nextStepDueDate = final?.DueDate?.ToString("dd MMM yyyy") ?? "Not Set";
            }
            else if (isFinalApproved)
            {
                nextStepTitle = "Congratulations!";
                nextStepDesc = "Your FYP is fully approved and completed! Fantastic work.";
                nextStepIcon = "fas fa-award";
                nextStepBtnText = "View Final Details";
                nextStepLink = "/Student/ProjectDetails";
            }
        }
        
        // Single sleek primary color for uniform design
        nextStepColor = "#4f46e5";
    }
}

<style>
    :root {
        --bg-body: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #1e293b;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --accent-dark: #0f172a;
        --accent-light: #334155;
    }

    body {
        background-color: var(--bg-body);
        font-family: 'Inter', sans-serif;
    }

    .premium-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
    }

    .taskbar {
        background-color: var(--accent-dark);
        border-radius: 16px;
        color: white;
        padding: 32px 40px;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.3);
        margin-bottom: 32px;
        position: relative;
        overflow: hidden;
    }

    .stat-card-clean {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: transform 0.2s ease;
    }

    .stat-card-clean:hover {
        transform: translateY(-2px);
        border-color: #cbd5e1;
    }

    .stat-icon-wrapper {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        background-color: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-dark);
        font-size: 1.5rem;
    }

    .action-alert {
        border-left: 4px solid var(--accent-dark);
        background-color: #f8fafc;
        padding: 16px 20px;
        border-radius: 8px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 12px;
        border-top: 1px solid var(--border-color);
        border-right: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .action-alert-icon {
        color: var(--accent-dark);
        font-size: 1.25rem;
        margin-top: 2px;
    }

    .btn-monochrome {
        background-color: var(--accent-dark);
        color: white;
        border: none;
        font-weight: 500;
        transition: background-color 0.2s;
    }

    .btn-monochrome:hover {
        background-color: var(--accent-light);
        color: white;
    }

    .btn-outline-monochrome {
        background-color: transparent;
        color: var(--accent-dark);
        border: 1px solid var(--border-color);
        font-weight: 500;
        transition: all 0.2s;
    }

    .btn-outline-monochrome:hover {
        background-color: var(--accent-dark);
        color: white;
    }

    .badge-bell {
        position: absolute;
        top: -6px;
        right: -6px;
        font-size: 0.65rem;
        padding: 4px 6px;
        border-radius: 999px;
    }

    .progress-bar-container {
        height: 18px;
        background-color: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }

    .timeline-element {
        border-left: 2px solid #cbd5e1;
        padding-left: 20px;
        position: relative;
        padding-bottom: 24px;
    }

    .timeline-element::before {
        content: '';
        position: absolute;
        left: -7px;
        top: 4px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: var(--primary-indigo);
        box-shadow: 0 0 0 4px white;
    }

    .timeline-element:last-child {
        padding-bottom: 0;
    }

    .table-responsive {
        border-radius: 12px;
        overflow: hidden;
    }

    .table thead th {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: #475569;
    }

    .status-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        text-transform: uppercase;
        display: inline-block;
    }
    
    .status-approved { background-color: #d1fae5; color: #065f46; }
    .status-pending { background-color: #fef3c7; color: #92400e; }
    .status-revision { background-color: #fee2e2; color: #991b1b; }
    .status-notstarted { background-color: #e2e8f0; color: #475569; }
    .status-submitted { background-color: #dbeafe; color: #1e40af; }
    
    .action-btn {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 8px;
        padding: 6px 14px;
        transition: all 0.2s ease;
    }
    
    .action-btn-primary {
        background-color: var(--primary-indigo);
        color: white;
        border: none;
    }
    
    .action-btn-primary:hover {
        background-color: #4338ca;
        transform: scale(1.05);
    }

    .action-btn-secondary {
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .action-btn-secondary:hover {
        background-color: #e2e8f0;
    }
</style>

<div class="container-fluid py-4">

    @* ── TOP TASKBAR ────────────────────────────────────────── *@
    <div class="taskbar mb-4 d-flex justify-content-between align-items-center flex-wrap gap-4">
        <div>
            <h1 class="display-6 fw-bold mb-2">Welcome Back, @name</h1>
            <div class="d-flex align-items-center gap-3 flex-wrap opacity-90" style="font-size: 0.9rem;">
                <span><strong>Matric ID:</strong> @studentId</span>
                <span class="text-white-50">|</span>
                <span><strong>Supervisor:</strong> @supervisorName</span>
                <span class="text-white-50">|</span>
                <span><strong>Session:</strong> @session</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <!-- Notification Bell Icon -->
            <a href="/Student/Notifications" class="btn btn-icon btn-custom position-relative bg-white bg-opacity-10 text-white rounded-circle p-3" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-bell fs-4"></i>
                @if (ViewBag.UnreadNotificationCount > 0)
                {
                    <span class="badge bg-danger badge-bell">@ViewBag.UnreadNotificationCount</span>
                }
            </a>

        </div>
    </div>

    @* ── DEADLINES ALERT BAR ────────────────────────────────── *@
    @if (upcomingUrgent != null && upcomingUrgent.DueDate.HasValue && daysLeft.HasValue && daysLeft.Value <= 5)
    {
        var isOverdue = daysLeft < 0;
        var absDays = Math.Abs(daysLeft.Value);
        
        <div class="action-alert">
            <div class="action-alert-icon">
                <i class="fas @(isOverdue ? "fa-exclamation-circle text-danger" : "fa-clock text-warning")"></i>
            </div>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-1 text-dark">Impending Deadline: @upcomingUrgent.Title</h6>
                <div class="text-muted" style="font-size: 0.9rem;">
                    Due Date: <strong class="text-dark">@upcomingUrgent.DueDate.Value.ToString("dd MMMM yyyy")</strong>. 
                    (@(absDays == 1 ? "1 Day" : $"{absDays} Days") @(isOverdue ? "Overdue" : "Left"))
                </div>
            </div>
            <div>
                <a href="/Student/Forms" class="btn btn-monochrome btn-sm py-2 px-3">Go to Forms</a>
            </div>
        </div>
    }

    @* ── PENDING MEETINGS ALERT ── *@
    @if (pendingMeetingsCount > 0)
    {
        <div class="action-alert">
            <div class="action-alert-icon">
                <i class="fas fa-handshake"></i>
            </div>
            <div class="flex-grow-1" style="font-size: 0.95rem;">
                <strong>Meeting Request Pending</strong> You have <strong>@pendingMeetingsCount meeting request(s)</strong> waiting for supervisor approval. You'll be notified as soon as they respond.
            </div>
        </div>
    }

    @if (scheduledDefense != null && scheduledDefense.DefenseDate.HasValue)
    {
        <div class="action-alert" style="border-left-color: #ef4444;">
            <div class="action-alert-icon text-danger">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-1 text-danger">Defense Presentation Scheduled</h6>
                <div class="text-muted mb-2" style="font-size: 0.9rem;">
                    Your IAF has been rejected 3 times. You are required to attend a mandatory Defense session.
                </div>
                <div class="d-flex flex-wrap gap-4 fw-bold" style="font-size: 0.9rem; color: #1e293b;">
                    <span><i class="fas fa-calendar-day me-2 text-muted"></i>@scheduledDefense.DefenseDate.Value.ToString("dd MMM yyyy")</span>
                    <span><i class="fas fa-clock me-2 text-muted"></i>@scheduledDefense.DefenseTime</span>
                    <span><i class="fas fa-map-marker-alt me-2 text-muted"></i>@scheduledDefense.DefenseVenue</span>
                </div>
            </div>
        </div>
    }

    @* ── DYNAMIC NEXT STEP INDICATOR ── *@
    @if (Model != null && milestones.Any() && !string.IsNullOrEmpty(nextStepTitle))
    {
        <div class="action-alert">
            <div class="action-alert-icon">
                <i class="@nextStepIcon"></i>
            </div>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-1 text-dark">Current Action Required: @nextStepTitle</h6>
                <div class="text-muted" style="font-size: 0.9rem;">@nextStepDesc</div>
            </div>
            <div class="text-end">
                <a href="@nextStepLink" class="btn btn-monochrome btn-sm py-2 px-3">@nextStepBtnText</a>
            </div>
        </div>
    }

    <div class="row g-4">
        
        @* ── PROGRESS & STATS ──────────────────────────────────── *@
        <div class="col-lg-8">
            @if (Model == null)
            {
                <!-- Empty State CTA -->
                <div class="premium-card p-5 mb-4 text-center">
                    <div class="mb-4 mt-2">
                        <i class="fas fa-folder-plus fa-4x text-muted opacity-50"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-3">Welcome to FYP Tracker</h3>
                    <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">
                        Your very first step is to secure a supervisor and register your project topic. You won't be able to submit forms or book meetings until this is done!
                    </p>
                    <a href="/Student/SelectSupervisor" class="btn btn-monochrome px-4 py-2">
                        <i class="fas fa-user-plus me-2"></i> Select Supervisor
                    </a>
                </div>
            }
            else
            {
                <!-- Progress Bar Card -->
                <div class="premium-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;"><i class="fas fa-chart-line text-muted me-2"></i>Your FYP Progress</h6>
                        <span class="badge bg-light text-dark fw-bold px-3 py-2 border">@pct% Completed</span>
                    </div>
                    <div class="progress-bar-container progress">
                        <div class="progress-bar bg-dark" role="progressbar" style="width: @pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <!-- Statistics Cards (3 columns) -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="stat-card-clean">
                            <div class="stat-icon-wrapper">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div>
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Approved</h6>
                                <h3 class="fw-bold text-dark mb-0">@approved</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card-clean">
                            <div class="stat-icon-wrapper">
                                <i class="fas fa-hourglass-half"></i>
                            </div>
                            <div>
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Pending</h6>
                                <h3 class="fw-bold text-dark mb-0">@pending</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card-clean">
                            <div class="stat-icon-wrapper">
                                <i class="fas fa-redo-alt"></i>
                            </div>
                            <div>
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Revision</h6>
                                <h3 class="fw-bold text-dark mb-0">@revision</h3>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Status Chapter Table -->
            <div class="premium-card p-4">
                <h5 class="fw-bold text-dark mb-4"><i class="fas fa-folder-open text-warning me-2"></i>Status Chapter Table</h5>
                @if (Model == null)
                {
                    <div class="text-center py-5">
                        <p class="text-muted">You do not have any project created yet. Please select a supervisor first!</p>
                        <a href="/Student/SelectSupervisor" class="btn btn-monochrome rounded-3 px-4 mt-2">
                            <i class="fas fa-user-plus me-1"></i> Choose Supervisor
                        </a>
                    </div>
                }
                else if (!milestones.Any())
                {
                    <div class="text-center py-5">
                        <p class="text-muted">No milestones/chapters defined for your project.</p>
                        <a href="/Student/Forms" class="btn btn-outline-monochrome rounded-3 px-4 mt-2">Submit Proposal</a>
                    </div>
                }
                else
                {
                    <style>
                        .assignment-group-header {
                            background-color: #f4f5f7;
                            color: #2d3748;
                            font-weight: 600;
                            padding: 12px 16px;
                            border-bottom: 1px solid #e2e8f0;
                            border-top: 1px solid #e2e8f0;
                            font-size: 0.95rem;
                            display: flex;
                            align-items: center;
                        }
                        .assignment-item {
                            background-color: #ffffff;
                            padding: 16px 20px;
                            border-bottom: 1px solid #e2e8f0;
                            display: flex;
                            align-items: flex-start;
                            gap: 16px;
                            transition: background-color 0.2s ease;
                        }
                        .assignment-item:last-child {
                            border-bottom: none;
                        }
                        .assignment-icon {
                            color: #718096;
                            font-size: 1.1rem;
                            margin-top: 3px;
                        }
                        .assignment-title {
                            font-weight: 600;
                            color: #1a202c;
                            font-size: 1.05rem;
                            margin-bottom: 4px;
                            display: block;
                        }
                        .assignment-meta {
                            font-size: 0.85rem;
                            color: #718096;
                        }
                        .assignment-meta-separator {
                            margin: 0 6px;
                            color: #cbd5e0;
                        }
                        .action-link {
                            color: inherit;
                            text-decoration: none;
                        }
                        .action-link:hover {
                            text-decoration: underline;
                        }
                    </style>

                    <div class="border rounded-3 overflow-hidden bg-white">
                        @{
                            var upcomingMilestones = milestones.Where(m => m.DueDate.HasValue && m.DueDate.Value >= DateTime.Today).OrderBy(m => m.DueDate).ToList();
                            var undatedMilestones = milestones.Where(m => !m.DueDate.HasValue).OrderBy(m => m.Title).ToList();
                            var pastMilestones = milestones.Where(m => m.DueDate.HasValue && m.DueDate.Value < DateTime.Today).OrderByDescending(m => m.DueDate).ToList();
                        }

                        <style>
                            .assignment-group-header {
                                cursor: pointer;
                            }
                            .assignment-group-header .fa-caret-down {
                                transition: transform 0.2s ease;
                            }
                            .assignment-group-header.collapsed .fa-caret-down {
                                transform: rotate(-90deg);
                            }
                        </style>

                        @if (upcomingMilestones.Any())
                        {
                            <div class="assignment-group-header" style="border-top: none;" data-bs-toggle="collapse" data-bs-target="#collapse-upcoming" aria-expanded="true" aria-controls="collapse-upcoming">
                                <i class="fas fa-caret-down me-2" style="font-size: 0.85em;"></i> Upcoming Assignments
                            </div>
                            <div class="collapse show" id="collapse-upcoming">
                                @foreach (var m in upcomingMilestones)
                                {
                                    var statusText = string.IsNullOrEmpty(m.Status) || (m.Status == "Pending" && !m.SubmittedDate.HasValue) ? "Not Started" : m.Status;
                                    var iconClass = (m.Title.Contains("Quiz", StringComparison.OrdinalIgnoreCase) || m.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)) ? "fas fa-rocket" : "far fa-edit";
                                    
                                    <div class="assignment-item">
                                        <i class="@iconClass assignment-icon"></i>
                                        <div class="flex-grow-1">
                                            @if (m.Status == "Approved" || statusText == "Not Started" || m.Status == "Rejected" || m.Status == "Revision")
                                            {
                                                <a href="/Student/Forms" class="assignment-title action-link">@m.Title</a>
                                            }
                                            else
                                            {
                                                <span class="assignment-title">@m.Title</span>
                                            }
                                            
                                            <div class="assignment-meta">
                                                <span>Due @m.DueDate!.Value.ToString("MMM dd") at 11:59pm</span> <span class="assignment-meta-separator">|</span>
                                                
                                                @if (statusText == "Approved") {
                                                    <span>Approved</span>
                                                } else if (statusText == "Rejected" || statusText == "Revision") {
                                                    <span class="text-danger fw-bold">Revision Needed</span>
                                                } else if (statusText == "Not Started") {
                                                    <span>Not Yet Submitted</span>
                                                } else {
                                                    <span>@statusText</span>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            @if (m.Status == "Approved" || m.Status == "Rejected" || m.Status == "Revision")
                                            {
                                                var fallbackFeedback = (m.Status == "Approved") ? "No feedback provided yet." : "Please revise according to guidelines.";
                                                <button type="button" class="btn btn-sm text-primary p-0 border-0 ms-3 hover-elevate-up" style="background: transparent; cursor: default;" title="Supervisor Feedback" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="left" data-bs-content="@Html.Raw(System.Web.HttpUtility.HtmlAttributeEncode(!string.IsNullOrEmpty(m.SupervisorFeedback) ? m.SupervisorFeedback : fallbackFeedback))">
                                                    <i class="far fa-comment-dots fs-5"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (undatedMilestones.Any())
                        {
                            <div class="assignment-group-header @(upcomingMilestones.Any() ? "" : "border-top-0")" data-bs-toggle="collapse" data-bs-target="#collapse-undated" aria-expanded="true" aria-controls="collapse-undated">
                                <i class="fas fa-caret-down me-2" style="font-size: 0.85em;"></i> Undated Assignments
                            </div>
                            <div class="collapse show" id="collapse-undated">
                                @foreach (var m in undatedMilestones)
                                {
                                    var statusText = string.IsNullOrEmpty(m.Status) || (m.Status == "Pending" && !m.SubmittedDate.HasValue) ? "Not Started" : m.Status;
                                    var iconClass = (m.Title.Contains("Quiz", StringComparison.OrdinalIgnoreCase) || m.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)) ? "fas fa-rocket" : "far fa-edit";
                                    
                                    <div class="assignment-item">
                                        <i class="@iconClass assignment-icon"></i>
                                        <div class="flex-grow-1">
                                            @if (m.Status == "Approved" || statusText == "Not Started" || m.Status == "Rejected" || m.Status == "Revision")
                                            {
                                                <a href="/Student/Forms" class="assignment-title action-link">@m.Title</a>
                                            }
                                            else
                                            {
                                                <span class="assignment-title">@m.Title</span>
                                            }
                                            
                                            <div class="assignment-meta">
                                                @if (statusText == "Approved") {
                                                    <span>Approved</span>
                                                } else if (statusText == "Rejected" || statusText == "Revision") {
                                                    <span class="text-danger fw-bold">Revision Needed</span>
                                                } else if (statusText == "Not Started") {
                                                    <span>Not Yet Submitted</span>
                                                } else {
                                                    <span>@statusText</span>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            @if (m.Status == "Approved" || m.Status == "Rejected" || m.Status == "Revision")
                                            {
                                                var fallbackFeedback = (m.Status == "Approved") ? "No feedback provided yet." : "Please revise according to guidelines.";
                                                <button type="button" class="btn btn-sm text-primary p-0 border-0 ms-3 hover-elevate-up" style="background: transparent; cursor: default;" title="Supervisor Feedback" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="left" data-bs-content="@Html.Raw(System.Web.HttpUtility.HtmlAttributeEncode(!string.IsNullOrEmpty(m.SupervisorFeedback) ? m.SupervisorFeedback : fallbackFeedback))">
                                                    <i class="far fa-comment-dots fs-5"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (pastMilestones.Any())
                        {
                            <div class="assignment-group-header @(!upcomingMilestones.Any() && !undatedMilestones.Any() ? "border-top-0" : "")" data-bs-toggle="collapse" data-bs-target="#collapse-past" aria-expanded="true" aria-controls="collapse-past">
                                <i class="fas fa-caret-down me-2" style="font-size: 0.85em;"></i> Past Assignments
                            </div>
                            <div class="collapse show" id="collapse-past">
                                @foreach (var m in pastMilestones)
                                {
                                    var statusText = string.IsNullOrEmpty(m.Status) || (m.Status == "Pending" && !m.SubmittedDate.HasValue) ? "Not Started" : m.Status;
                                    var iconClass = (m.Title.Contains("Quiz", StringComparison.OrdinalIgnoreCase) || m.Title.Contains("IAF", StringComparison.OrdinalIgnoreCase)) ? "fas fa-rocket" : "far fa-edit";
                                    
                                    <div class="assignment-item">
                                        <i class="@iconClass assignment-icon"></i>
                                        <div class="flex-grow-1">
                                            @if (m.Status == "Approved" || statusText == "Not Started" || m.Status == "Rejected" || m.Status == "Revision")
                                            {
                                                <a href="/Student/Forms" class="assignment-title action-link">@m.Title</a>
                                            }
                                            else
                                            {
                                                <span class="assignment-title">@m.Title</span>
                                            }
                                            
                                            <div class="assignment-meta">
                                                <strong class="text-dark">Closed</strong> <span class="assignment-meta-separator">|</span>
                                                <span>Due @m.DueDate!.Value.ToString("MMM dd") at 11:59pm</span> <span class="assignment-meta-separator">|</span>
                                                
                                                @if (statusText == "Approved") {
                                                    <span>Approved</span>
                                                } else if (statusText == "Rejected" || statusText == "Revision") {
                                                    <span class="text-danger fw-bold">Revision Needed</span>
                                                } else if (statusText == "Not Started") {
                                                    <span>Not Yet Submitted</span>
                                                } else {
                                                    <span>@statusText</span>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            @if (m.Status == "Approved" || m.Status == "Rejected" || m.Status == "Revision")
                                            {
                                                var fallbackFeedback = (m.Status == "Approved") ? "No feedback provided yet." : "Please revise according to guidelines.";
                                                <button type="button" class="btn btn-sm text-primary p-0 border-0 ms-3 hover-elevate-up" style="background: transparent; cursor: default;" title="Supervisor Feedback" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-placement="left" data-bs-content="@Html.Raw(System.Web.HttpUtility.HtmlAttributeEncode(!string.IsNullOrEmpty(m.SupervisorFeedback) ? m.SupervisorFeedback : fallbackFeedback))">
                                                    <i class="far fa-comment-dots fs-5"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── UPCOMING MEETING & ACTIVITIES (Right Sidebar) ── *@
        <div class="col-lg-4">

            @if (upcomingMeeting != null)
            {
                <div class="premium-card p-4 mb-4 border-0 shadow-sm" style="background-color: #f8fafc; border-left: 6px solid #1e293b !important;">
                    <h5 class="fw-bold text-dark mb-3"><i class="fas fa-calendar-check me-2 text-muted"></i>Upcoming Meeting</h5>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center text-dark fw-bold">
                            <i class="far fa-calendar-alt text-muted me-3 fs-5"></i>
                            @upcomingMeeting.MeetingDate.ToString("dd MMMM yyyy") (@upcomingMeeting.MeetingDay)
                        </div>
                        <div class="d-flex align-items-center text-dark fw-bold">
                            <i class="far fa-clock text-muted me-3 fs-5"></i>
                            @{
                                string dispTime = upcomingMeeting.MeetingTime;
                                try {
                                    if(TimeSpan.TryParse(upcomingMeeting.MeetingTime, out var ts)) {
                                        dispTime = DateTime.Today.Add(ts).ToString("h:mm tt");
                                    }
                                } catch {}
                            }
                            @dispTime
                        </div>
                        <div class="d-flex align-items-start text-dark mt-2">
                            <i class="fas fa-quote-left text-muted me-3 mt-1 opacity-50"></i>
                            <span class="small opacity-75 fw-semibold" style="line-height: 1.4;">@upcomingMeeting.Reason</span>
                        </div>
                    </div>
                </div>
            }

            <div class="premium-card p-4 h-100 d-flex flex-column">
                <h5 class="fw-bold text-dark mb-4"><i class="fas fa-history text-indigo me-2"></i>Recent Activities</h5>
                <div class="flex-grow-1 overflow-auto pe-2" style="max-height: 450px;">
                    @if (!activities.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-tasks d-block fs-1 opacity-20 mb-3"></i>
                            No activity logged yet.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column">
                            @foreach (var a in activities)
                            {
                                <div class="timeline-element">
                                    <div class="fw-bold text-dark" style="font-size: 0.9rem;">@a.Title</div>
                                    @if (!string.IsNullOrEmpty(a.Description))
                                    {
                                        <p class="text-muted mb-1" style="font-size: 0.82rem; line-height: 1.4;">@a.Description</p>
                                    }
                                    <small class="text-muted d-block" style="font-size: 0.75rem;"><i class="far fa-clock me-1"></i>@a.CreatedDate.ToString("dd/MM/yyyy hh:mm tt")</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
        var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
            return new bootstrap.Popover(popoverTriggerEl);
        });
    });
</script>



