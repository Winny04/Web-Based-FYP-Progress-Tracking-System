@using FYPTracker.Models
@using Microsoft.EntityFrameworkCore
@model EmployeeInfo
@inject FYPTrackerContext DbContext
@{
    ViewData["Title"] = "Student Profile";
    
    // Fetch project and supervisor dynamically
    var project = DbContext.FYPProjects.Include(p => p.Supervisor).FirstOrDefault(p => p.StudentId == Model.Id);
    var supervisorName = project?.Supervisor?.FullName ?? "Not Assigned";
    var session = "2025/2026";
    var programme = Model.Department ?? "Software Engineering";
}

<style>
    :root {
        --blue-grad: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        --primary-blue: #3b82f6;
    }
    
    .page-hero {
        background: var(--blue-grad);
        border-radius: 20px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
        box-shadow: 0 8px 32px rgba(59, 130, 246, 0.25);
    }

    .premium-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid rgba(59, 130, 246, 0.1);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .form-control {
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        font-size: 0.9rem;
        padding: 9px 14px;
        transition: border-color 0.2s;
    }

    .form-control:focus {
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    .btn-submit {
        background: var(--blue-grad);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 700;
        transition: all 0.2s;
    }

    .btn-submit:hover {
        opacity: 0.9;
        transform: scale(1.03);
        color: white;
    }

    .profile-photo-circle {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        border: 4px solid white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        overflow: hidden;
        margin: 0 auto 15px auto;
    }
</style>

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-3">
            <span class="fs-4 text-success"><i class="fas fa-check-circle"></i></span>
            <div class="fw-bold">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-3">
            <span class="fs-4 text-danger"><i class="fas fa-exclamation-circle"></i></span>
            <div class="fw-bold">@TempData["Error"]</div>
        </div>
    }

    @* ── Page Title & Hero ──────────────────────────────────── *@
    <div class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-user-circle me-2"></i>My Profile</h2>
            <p class="mb-0 opacity-90">View and update your student account settings, change password, and customize your experience.</p>
        </div>
    </div>

    <div class="row g-4">
        
        @* ── LEFT COLUMN: Profile info display & edit ──────────── *@
        <div class="col-lg-7">
            <!-- Edit Profile & Info Display Card -->
            <div class="premium-card p-4">
                <div class="text-center mb-4">
                    <!-- Circular Profile Photo -->
                    <div class="profile-photo-circle">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img id="avatarPreview" src="@Model.Image" alt="Profile Image" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <img id="avatarPreview" src="/assets/media/avatars/student_avatar.png" alt="Profile Image" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                    </div>
                    <h4 class="fw-bold text-dark mb-0">@Model.FullName</h4>
                    <span class="badge bg-light text-muted border px-3 py-1 rounded-pill mt-1">@Model.UserType</span>
                </div>

                <form asp-action="EditProfile" asp-controller="EmployeeInfo" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="UserName" value="@Model.UserName" />
                    <input type="hidden" name="ShortName" value="@Model.ShortName" />
                    <input type="hidden" name="UserType" value="@Model.UserType" />
                    <input type="hidden" name="PassCode" value="@Model.PassCode" />
                    <input type="hidden" name="Department" value="@Model.Department" />
                    <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />
                    <input type="hidden" name="isImgChanged" id="isImgChanged" value="false" />

                    <!-- Circular Photo Upload -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Upload Profile Photo</label>
                        <input type="file" name="picture" class="form-control" accept="image/*" onchange="previewImage(this)" />
                    </div>

                    <!-- Display Info & Editable Fields -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Student ID</label>
                            <input type="text" class="form-control bg-light border-0" value="@Model.EmployeeId" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" name="Email" class="form-control" value="@Model.Email" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <!-- Contact Number mapped to Phone field -->
                            <input type="tel" name="PhoneNumber" class="form-control" value="+60 12-345 6789" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Programme / Course</label>
                            <input type="text" class="form-control bg-light border-0" value="@programme" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Academic Session</label>
                            <input type="text" class="form-control bg-light border-0" value="@session" readonly />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Assigned Supervisor Name</label>
                            <input type="text" class="form-control bg-light border-0" value="@supervisorName" readonly />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <!-- Account Actions: Logout -->
                        <a href="/EmployeeInfo/Logout" class="btn btn-outline-danger rounded-3 px-4 fw-bold">
                            <i class="fas fa-sign-out-alt me-1"></i> Logout
                        </a>
                        <button type="submit" class="btn-submit">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* ── RIGHT COLUMN: Security Section (Change Password) ── *@
        <div class="col-lg-5">
            <div class="premium-card p-4 h-100">
                <h5 class="fw-bold text-dark mb-4"><i class="fas fa-shield-alt text-primary me-2"></i>Security Section</h5>
                
                <form asp-action="ChangePassword" asp-controller="EmployeeInfo" method="post" id="changePasswordForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Password</label>
                        <div class="position-relative">
                            <input type="password" name="currentPassword" id="currentPassword" class="form-control" required />
                            <span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('currentPassword', this)">
                                <i class="fas fa-eye text-muted"></i>
                            </span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password</label>
                        <div class="position-relative">
                            <input type="password" name="newPassword" id="newPassword" class="form-control" required />
                            <span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('newPassword', this)">
                                <i class="fas fa-eye text-muted"></i>
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Confirm New Password</label>
                        <div class="position-relative">
                            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" required />
                            <span class="position-absolute top-50 translate-middle-y cursor-pointer" style="right: 15px;" onclick="togglePasswordVisibility('confirmPassword', this)">
                                <i class="fas fa-eye text-muted"></i>
                            </span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold rounded-3 py-2" style="background:var(--blue-grad); border:none;">
                        <i class="fas fa-key me-1"></i> Change Password
                    </button>
                </form>
            </div>
        </div>

    </div>

</div>

<script>
    function togglePasswordVisibility(fieldId, element) {
        var field = document.getElementById(fieldId);
        var icon = element.querySelector('i');
        if (field.type === "password") {
            field.type = "text";
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            field.type = "password";
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('avatarPreview').src = e.target.result;
                document.getElementById('isImgChanged').value = 'true';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
        var pass = document.getElementById('newPassword').value;
        var confirm = document.getElementById('confirmPassword').value;
        if (pass !== confirm) {
            e.preventDefault();
            alert("New passwords do not match!");
        }
    });
</script>