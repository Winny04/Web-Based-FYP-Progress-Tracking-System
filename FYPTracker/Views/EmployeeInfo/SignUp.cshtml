@section scripts{
<script>
     $(document).ready(function() {
        $("#kt_sign_up_submit").click(function(){

                var UserName = $("#EmplooyeeInfoID").val();
                var EmplooyeeInfoID = $("#EmplooyeeInfoID").val();
                var FullName = $("#FullName").val();
                var ShortName = $("#ShortName").val();
                var PassCode = $("#PassCode").val();
                var Email = $("#Email").val();
                var Department = $("#Department").val();


                if(EmplooyeeInfoID == '' || FullName == '' || ShortName == '' || PassCode == '' || Email == '' || Department == ''){
                    Swal.fire({
                            text: "Please fill in all fields.",
                            icon: "warning",
                            buttonsStyling: false,
                            confirmButtonText: "Ok, got it!",
                            customClass: {
                                confirmButton: "btn btn-primary",
                            }
                        });
                     return false;
                }
                else if(Email == null || Email.indexOf("sophicautomation.com") < 0){ //if not found
                    Swal.fire({
                            text: "Inccorect email format. Please use company's email address.",
                            icon: "warning",
                            buttonsStyling: false,
                            confirmButtonText: "Ok, got it!",
                            customClass: {
                                confirmButton: "btn btn-primary",
                            }
                        });
                     return false;
                }
               

            var form = {
                UserName : UserName,
                EmplooyeeInfoID : EmplooyeeInfoID, 
                FullName : FullName,
                ShortName : ShortName,
                PassCode : PassCode,
                Email : Email,
                Department : Department
            };

            $.ajax({
                url: "/EmployeeInfo/Create",
                method: "POST",
                data: {
                    newEmployee: form
                },
                success:function(result) {
                    if(result.status){
                        Swal.fire({
                            text: result.msg,
                            icon: "success",
                            buttonsStyling: false,
                            confirmButtonText: "Ok, got it!",
                            customClass: {
                                confirmButton: "btn btn-primary",
                            }
                        }).then(function() {
                            window.location.href = '/EmployeeInfo/Login';
                        });
                    }
                    else{
                         Swal.fire({
                            text: result.msg,
                            icon: "warning",
                            buttonsStyling: false,
                            confirmButtonText: "Ok, got it!",
                            customClass: {
                                confirmButton: "btn btn-primary",
                            }
                        });
                    }
                },
                error:function(result) {
                    Swal.fire({
                            text: result.msg,
                            icon: "error",
                            buttonsStyling: false,
                            confirmButtonText: "Ok, got it!",
                            customClass: {
                                confirmButton: "btn btn-primary",
                            }
                        });
                }
            });
        });

    }); //End $(document).ready
               
</script>
}

