" />
                </svg>
            </span>
            <!--end::Svg Icon-->
            <h3 class="fw-bolder m-0 text-gray-800">@DateTime.Now.ToString("MMM dd, yyyy")</h3>
        </div>
        <!--end::Title-->
        <!--begin::Toolbar-->
        <div class="card-toolbar m-0">
            <!--begin::Tab nav-->
            <ul class="nav nav-tabs nav-line-tabs nav-stretch fs-6 border-0 fw-bolder" role="tablist">
                <li class="nav-item" role="presentation">
                    <a id="kt_activity_today_tab" class="nav-link justify-content-center text-active-gray-800 active" data-bs-toggle="tab" role="tab" href="#kt_activity_today">Today</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a id="kt_activity_week_tab" class="nav-link justify-content-center text-active-gray-800" data-bs-toggle="tab" role="tab" href="#kt_activity_week">Week</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a id="kt_activity_month_tab" class="nav-link justify-content-center text-active-gray-800" data-bs-toggle="tab" role="tab" href="#kt_activity_month">Month</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a id="kt_activity_custom_tab" class="nav-link justify-content-center text-active-gray-800" data-bs-toggle="tab" role="tab" href="#kt_activity_custom">Custom</a>
                </li>
            </ul>
            <!--end::Tab nav-->
        </div>
        <!--end::Toolbar-->
    </div>
    <!--end::Card head-->
    <!--begin::Card body-->
    <div class="card-body">
        <!--begin::Tab Content-->
        <div class="tab-content">
            <!--begin::Tab panel-->
            <div id="kt_activity_today" class="card-body p-0 tab-pane fade show active" role="tabpanel" aria-labelledby="kt_activity_today_tab">
                <!--begin::Timeline-->
                <div class="timeline">
                    <!--begin::Timeline item-->
                    @if(Model.Today.Count() == 0)
                    {
                        <h1 class="text-center text-muted fs-1">Today don't have activity yet</h1>
                    }
                    @foreach(var item in Model.Today)
                    {
                          <!--begin::Timeline item-->
                        <div class="timeline-item">
                            <!--begin::Timeline line-->
                            <div class="timeline-line w-40px"></div>
                            <!--end::Timeline line-->
                            <!--begin::Timeline icon-->
                            <div class="timeline-icon symbol symbol-circle symbol-40px">
                                <div class="symbol-label bg-light">
                                    <!--begin::Svg Icon | path: icons/duotune/art/art005.svg-->
                                    <span class="svg-icon svg-icon-2 svg-icon-gray-500">
                                       <i class="fonticon-bookmark"></i>
                                    </span>
                                    <!--end::Svg Icon-->
                                </div>
                            </div>
                            <!--end::Timeline icon-->
                            <!--begin::Timeline content-->
                            <div class="timeline-content mb-4 mt-n1">
                                <!--begin::Timeline heading-->
                                <div class="pe-3 mb-5">
                                    <!--begin::Title-->
                                    <div class="fs-5 fw-bold mb-2">Case <a href="@item.ReferrerUrl">#@item.Id</a> @item.ShortMessage:</div>
                                    <!--end::Title-->
                                    <!--begin::Description-->
                                    <div class="d-flex align-items-center mt-1 fs-6">
                                        <!--begin::Info-->
                                        <div class="text-muted me-2 fs-7">Created at @Html.DisplayFor(x => item.CreatedOn) by</div>
                                        <!--end::Info-->
                                        <!--begin::User-->
                                       <span class="text-primary fw-bolder me-1">@item.Employee.UserName</span>
                                        <!--end::User-->
                                    </div>
                                    <!--end::Description-->
                                </div>
                                <!--end::Timeline heading-->
                                <!--begin::Timeline details-->
                                <!--end::Timeline details-->
                            </div>
                            <!--end::Timeline content-->
                        </div>
                        <!--end::Timeline item-->
                    }
                    <!--end::Timeline item-->
                </div>
                <!--end::Timeline-->
            </div>
            <!--end::Tab panel-->
            <!--begin::Tab panel-->
            <div id="kt_activity_week" class="card-body p-0 tab-pane fade show" role="tabpanel" aria-labelledby="kt_activity_week_tab">
                <!--begin::Timeline-->
                <div class="timeline">
                @if(Model.Week.Count() == 0)
                {
                    <h1 class="text-center text-muted fs-1">This week don't have activity yet</h1>
                }
                @foreach(var item in Model.Week)
                {
                   <!--begin::Timeline item-->
                        <div class="timeline-item">
                            <!--begin::Timeline line-->
                            <div class="timeline-line w-40px"></div>
                            <!--end::Timeline line-->
                            <!--begin::Timeline icon-->
                            <div class="timeline-icon symbol symbol-circle symbol-40px">
                                <div class="symbol-label bg-light">
                                    <!--begin::Svg Icon | path: icons/duotune/art/art005.svg-->
                                    <span class="svg-icon svg-icon-2 svg-icon-gray-500">
                                       <i class="fonticon-bookmark"></i>
                                    </span>
                                    <!--end::Svg Icon-->
                                </div>
                            </div>
                            <!--end::Timeline icon-->
                            <!--begin::Timeline content-->
                            <div class="timeline-content mb-4 mt-n1">
                                <!--begin::Timeline heading-->
                                <div class="pe-3 mb-5">
                                    <!--begin::Title-->
                                    <div class="fs-5 fw-bold mb-2">Case <a href="@item.ReferrerUrl">#@item.Id</a> @item.ShortMessage:</div>
                                    <!--end::Title-->
                                    <!--begin::Description-->
                                    <div class="d-flex align-items-center mt-1 fs-6">
                                        <!--begin::Info-->
                                        <div class="text-muted me-2 fs-7">Created at @Html.DisplayFor(x => item.CreatedOn) by</div>
                                        <!--end::Info-->
                                        <!--begin::User-->
                                       <span class="text-primary fw-bolder me-1">@item.Employee.UserName</span>
                                        <!--end::User-->
                                    </div>
                                    <!--end::Description-->
                                </div>
                                <!--end::Timeline heading-->
                                <!--begin::Timeline details-->
                                <!--end::Timeline details-->
                            </div>
                            <!--end::Timeline content-->
                        </div>
                        <!--end::Timeline item-->
                }
                </div>
                <!--end::Timeline-->
            </div>
            <!--end::Tab panel-->
            <!--begin::Tab panel-->
            <div id="kt_activity_month" class="card-body p-0 tab-pane fade show" role="tabpanel" aria-labelledby="kt_activity_month_tab">
                <!--begin::Timeline-->
                <div class="timeline">
                    @if(Model.Month.Count() == 0)
                    {
                        <h1 class="text-center text-muted fs-1">This month don't have activity yet</h1>
                    }
                    @foreach(var item in Model.Month)
                    {
                        <!--begin::Timeline item-->
                        <div class="timeline-item">
                            <!--begin::Timeline line-->
                            <div class="timeline-line w-40px"></div>
                            <!--end::Timeline line-->
                            <!--begin::Timeline icon-->
                            <div class="timeline-icon symbol symbol-circle symbol-40px">
                                <div class="symbol-label bg-light">
                                    <!--begin::Svg Icon | path: icons/duotune/art/art005.svg-->
                                    <span class="svg-icon svg-icon-2 svg-icon-gray-500">
                                       <i class="fonticon-bookmark"></i>
                                    </span>
                                    <!--end::Svg Icon-->
                                </div>
                            </div>
                            <!--end::Timeline icon-->
                            <!--begin::Timeline content-->
                            <div class="timeline-content mb-4 mt-n1">
                                <!--begin::Timeline heading-->
                                <div class="pe-3 mb-5">
                                    <!--begin::Title-->
                                    <div class="fs-5 fw-bold mb-2">Case <a href="@item.ReferrerUrl">#@item.Id</a> @item.ShortMessage:</div>
                                    <!--end::Title-->
                                    <!--begin::Description-->
                                    <div class="d-flex align-items-center mt-1 fs-6">
                                        <!--begin::Info-->
                                        <div class="text-muted me-2 fs-7">Created at @Html.DisplayFor(x => item.CreatedOn) by</div>
                                        <!--end::Info-->
                                        <!--begin::User-->
                                      <span class="text-primary fw-bolder me-1">@item.Employee.UserName</span>
                                        <!--end::User-->
                                    </div>
                                    <!--end::Description-->
                                </div>
                                <!--end::Timeline heading-->
                                <!--begin::Timeline details-->
                                <!--end::Timeline details-->
                            </div>
                            <!--end::Timeline content-->
                        </div>
                        <!--end::Timeline item-->
                    }
                </div>
                <!--end::Timeline-->
            </div>
            <!--end::Tab panel-->
            <!--start: Tab-->
            <div id="kt_activity_custom" class="card-body p-0 tab-pane fade show" role="tabpanel" aria-labelledby="kt_activity_month_tab">
                <div class="card card-flush mb-5">
                     <div class="card-header pt-7">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bolder fs-3 mb-1 font-weight-bold">Audit Trails</span>

                        </h3>
                        <div class="card-toolbar">
                            <div class="d-flex flex-stack flex-wrap gap-4">
                                <div class="d-flex align-items-center position-relative my-1">
                                    <label class="fs-6 fw-bold p-3 my-2">Start On</label>
                                    <input id="startOnDate" class="form-control form-control-solid form-select-sm w-150px ps-9" type="text" />
                                </div>
                                 <div class="d-flex align-items-center position-relative my-1">
                                    <label class="fs-6 fw-bold p-3 my-2">End On</label>
                                    <input id="endOnDate" class="form-control form-control-solid form-select-sm w-150px ps-9" type="text" />
                                </div>
                                <div class="d-flex align-items-center position-relative my-1">
                                    <!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
                                    <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                        </svg>
                                    </span>
                                    <!--end::Svg Icon-->
                                    <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search..." />
                                </div>
                            </div>
                        </div>
                    </div>
                      <div class="card-body py-3">
                    <div class="table-responsive">
                        <table id="auditLogsTable" class="table table-row-dashed align-middle gs-0 gy-4">
                            <thead>
                                <tr class="font-weight-bold">
                                    <th>Short Message</th>
                                    <th>Ip Address</th>
                                    <th>Perform by</th>
                                    <th>Full Message</th>
                                    <th>Full Message</th>
                                    <th>Action By</th>
                                    <th>Referrer Url</th>
                                    <th>Created On</th>
                                    
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var log in Model.All)
                                {
                                    <tr>
                                        <td>@log.ShortMessage</td>
                                        <td>@log.IpAddress</td>
                                        <td>
                                            @{
                                                if(log.Employee != null)
                                                {
                                                    <span>@log.Employee.UserName</span>    
                                                }
                                            }
                                        </td>
                                        <td>@log.FullMessage</td>
                                        <td>@log.FullMessage</td>
                                        <td>@log.Employee.FullName</td>
                                        <td>
                                            @{
                                                if(log.ReferrerUrl != null)
                                                {
                                                     <a href="@log.ReferrerUrl">Click here</a>
                                                }
                                            }
                                        </td>
                                        <td>@log.CreatedOn.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                </div>
            </div>
            <!--end: Tab-->
        </div>
        <!--end::Tab Content-->
    </div>
    <!--end::Card body-->
</div>

@section scripts{
    <script>
        var minDate, maxDate;
 
// Custom filtering function which will search data in column four between two values
$.fn.dataTable.ext.search.push(
    function( settings, data, dataIndex ) {
        var min = minDate.val();
        var max = maxDate.val();
        console.log('aaadata',data)
        var date = new Date(data[7]);
        console.log("search date", date);
 
        if (
            ( min === null && max === null ) ||
            ( min === null && date <= max ) ||
            ( min <= date   && max === null ) ||
            ( min <= date   && date <= max )
        ) {
            return true;
        }
        return false;
    }
);
 
$(document).ready(function() {
    // Create date inputs
    minDate = new DateTime($('#startOnDate'), {
        format: 'DD-MM-yyyy'
    });
    maxDate = new DateTime($('#endOnDate'), {
        format: 'DD-MM-yyyy'
    });
 
    // DataTables initialisation
    var table = $('#auditLogsTable').DataTable();
 
    // Refilter the table
    $('#startOnDate, #endOnDate').on('change', function () {
        table.draw();
    });

    var filterSearch = document.getElementById("filter_search");

    filterSearch.addEventListener("keyup", function (e) {
        table.search(e.target.value).draw();
    });
});
    </script>
    
}
