					}
				});
                //}
            })

            $('#cancelBtn').click(function(){
                Swal.fire({
					text: "Are you sure you would like to cancel?",
					icon: "warning",
					showCancelButton: true,
					buttonsStyling: false,
					confirmButtonText: "Yes, cancel it!",
					cancelButtonText: "No, return",
					customClass: {
						confirmButton: "btn btn-primary",
						cancelButton: "btn btn-active-light"
					}
				}).then(function (result) {
					if (result.value) {
						//form.reset(); // Reset form	
						window.location.href = '@Url.Action("Index","PurchaseOrder",new {id = Model.Prid})';	
					} else if (result.dismiss === 'cancel') {
						Swal.fire({
							text: "Your form has not been cancelled!.",
							icon: "error",
							buttonsStyling: false,
							confirmButtonText: "Ok, got it!",
							customClass: {
								confirmButton: "btn btn-primary",
							}
						});
					}
				});
            })

          
                $('#rejectBtn').hide();


            $('#rejectBtn').click(function(){
                Swal.fire({
					text: "Are you sure you would like to reject?",
					icon: "warning",
					showCancelButton: true,
					buttonsStyling: false,
					confirmButtonText: "Yes, reject it!",
					cancelButtonText: "No, return",
					customClass: {
						confirmButton: "btn btn-primary",
						cancelButton: "btn btn-active-light"
					}
				}).then(function (result) {
					if (result.value) {
                        rejectModal.show();
						@*$.post('@Url.Action("rejectForm","FormList")',{id:@Model.Id,remark:'something...'},function(data,status){
                            console.log(status);
                            window.location.href = '@Url.Action("Index","FormList",new {id = Model.ProjectId})';
                        })*@
					} else if (result.dismiss === 'cancel') {
						Swal.fire({
							text: "The form has not been reject!.",
							icon: "error",
							buttonsStyling: false,
							confirmButtonText: "Ok, got it!",
							customClass: {
								confirmButton: "btn btn-primary",
							}
						});
					}
				});
            })
            
        })


        const data = @Html.Raw(string.IsNullOrEmpty(Model.Data) ? "{}" : Model.Data);
        const submission = @Html.Raw(string.IsNullOrEmpty(Model.DataResponse) ? "{data:{}}" : Model.DataResponse);
        var formStatus = {
            "label": "Form Status",
            "labelPosition": "left-left",
            "disabled": true,
            "tableView": true,
            "key": "formStatus",
            "hidden": true,
            "type": "textfield",
            "input": true,
           
        }

        if(JSON.stringify(data) !== JSON.stringify({})){
            data.components.unshift(formStatus);
        }

        var builder;
        var renderer;
        var state = {
            formioVersion: 'default',
            form: data,
            submission: submission,
            options: {},
        };

        function initBuilder(form) {
            if (builder) {
                builder.instance.destroy();
            }
            builder = new Formio.FormBuilder(document.getElementById('builder'), form, _.cloneDeep(state.options));

            builder.instance.ready.then(function () {
                builder.instance.on('change', function (event, flags) {
                    if (!flags) {
                        setForm(builder.instance.schema, 'builder');
                    }
                });
            })
        }

        function initRenderer(form) {
            if (renderer) {
                renderer.destroy();
            }
            Formio.createForm(document.getElementById('render'), form, _.cloneDeep(state.options))
                .then(function (self) {
                    renderer = self;
                    renderer.submission = state.submission;
                    renderer.on('change', function (event, flags) {
                        if (flags && !flags.fromSubmission) {
                            setSubmission(renderer.submission, 'renderer');
                        }
                    });
                });

            document.getElementsByName('Data')[0].value = JSON.stringify(form)
        }

        function setForm(form, from) {
            console.log('setForm', form, from);
            state.form = form;
            if (!renderer.checkData()) {
                document.getElementById("submitBtn").disabled = true;
            } else {
                document.getElementById("submitBtn").disabled = false;
            }

        }

        function setSubmission(submission, from) {
            console.log('setSubmission', submission, from);
            if (renderer && from !== 'renderer') {
                renderer.submission = submission;
            }

            document.getElementsByName('DataResponse')[0].value = JSON.stringify(submission);
            document.getElementsByName('DataResponse')[1].value = JSON.stringify(submission);
        }

        initBuilder(state.form);
        initRenderer(state.form);


                if (submission == null) {
            submission.data.push({
                projectCode: '@ViewBag.projectCode',
                poNumber: '@ViewBag.poNo',
                projectName: '@ViewBag.projectName',
                category: '@ViewBag.category',
                customer: '@ViewBag.customer'
            });
        } else {

                            submission.data.projectCode = '@ViewBag.projectCode';
                            submission.data.poNumber = '@ViewBag.poNo';
                            submission.data.projectName = '@ViewBag.projectName';
                            submission.data.category = '@ViewBag.category';
                            submission.data.customer = '@ViewBag.customer';


            //console.log(submission.data.dataGrid.length);
            //if (submission.data.dataGrid != undefined || submission.data.dataGrid != null) {
            //    for (i = 0; i < submission.data.dataGrid.length; i++) {

            //        if (submission.data.dataGrid[i].keyInUser1 == "Admin") {
            //            data.components.filter(a => a.key === 'dataGrid').at(0).components.at(i).columns.at(0).components.at(0).disabled = true;
            //            /*data.components.filter(a => a.key === 'dataGrid').at(0).components.at(i).columns.at(1).components.at(0).hidden = true;*/
            //        }
            //    }
            //}



        }
    </script>
}
