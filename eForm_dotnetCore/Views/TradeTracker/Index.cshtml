@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@model IEnumerable<eForm_dotnetCore.Models.TradeTracker>

@{
    ViewBag.Title = "Trading Sourcing Tracker";
}
<style>
    .tableBorder {
        border-right: 2px solid #D3D3D3;
        color: black;
        font-size: 15px;
        text-align: center;
    }

    .dataTables_wrapper .dt-buttons .buttons-colvis {
        background-color: #007bff;
        border-color: #007bff;
        color: #fff;
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        margin: 10px;
    }

        .dataTables_wrapper .dt-buttons .buttons-colvis:hover {
            background-color: #0069d9;
            border-color: #0062cc;
            color: #fff;
        }
</style>

<div class="card">
    <h3 style="margin-left:30px; margin-top:20px;">Trading Sourcing Tracker</h3>
    <div class="card-header border-0">

        <div class="card-toolbar">
            <div class="d-flex flex-stack flex-wrap gap-4">
                <div class="d-flex align-items-center position-relative my-1">
                    <span class="svg-icon svg-icon-1 position-absolute px-1" style="margin-right:1.5rem !important;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                        </svg>
                    </span>
                    <input type="text" id="filter_search" class="form-control form-control-solid w-250px" placeholder="Search sourcing" style="padding-left:2.8rem !important;" />
                </div>
            </div>
        </div>

        <div class="card-toolbar">
            <div class="d-flex align-items-center py-3 py-md-1">
                <button data-bs-toggle="modal" data-bs-target="#modal_import" class="btn btn-outline-success border mr-2">Import</button>
                <a href="@Url.Action("Edit")" class="btn btn-primary mr-2">Add</a>
            </div>
        </div>
    </div>

    <div class="card-body py-0">
        @* <label>@Html.ValidationMessageFor(model => model.EmplooyeeInfoID, "", new { @class = "text-danger" })</label>*@
        <div class="table-responsive">
            <table id="tradingTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted">
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Started Date</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>SalesPIC</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Description</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Brand</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Part No</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Quantity</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Support Document</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Chances of PO</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Sourcing Status</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Selected Supplier</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Competitor</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Target Price</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Final Price</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Target Lead Time</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Final Lead Time</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Warranty</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Remark</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Closed Date</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Status of Sales</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Customer PO#</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Pending/Lost Reason</b></th>
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Action</b></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var form in Model)
                    {
                        <tr id="@form.Id" class="text-center">
                             <td class="tableCellStandard tableCellBorderLeft">
                                @form.StartedDate?.ToString("d")
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.SalesPIC
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Description
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Brand
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.PartNo
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Quantity
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.SupportDoc
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.ChancesPO
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.StatusSource
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Supplier
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.CompetitorName
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.TargetPrice
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.FinalPrice
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.TargetLeadTime?.ToString("d")
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.LeadTime?.ToString("d")
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Warranty
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Remark
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.ClosedDate?.ToString("d")
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.StatusSales
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.CustomerPO
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.ReasonPending
                            </td>
                             <td class="tableCellStandard tableCellBorderLeft">
                                <a href="@Url.Action("Edit",new {id = form.Id})" class="btn btn-sm btn-primary m-2">Edit</a>
                                <button onclick="deleteRecord('@form.Id')" class="btn btn-sm btn-danger">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@*Import BOM Modal*@
<div class="modal fade" id="modal_import" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Import</h1>
                    <div class="text-muted fw-bold fs-5">
                        Please click the link to download the Excel Template.
                        <a href="/BOMTemplate/TradingSourcingTemp.xlsx" class="fw-bolder link-primary">Download template</a>.
                    </div>
                </div>


                <form asp-controller="TradeTracker" asp-action="ImportData" method="post" enctype="multipart/form-data">
                    <div class="mt-3 my-5 ml-5">
                        <input type="file" name="file" id="postedFile" accept=".csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" />
                    </div>

                    <button type="submit" class="btn btn-primary">Import</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_create" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Add New Vendor</h1>
                </div>

                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Vendor Name</label>
                    <input type="text" id="supplierName" class="form-control" placeholder="Please provide a vendor name" required />
                </div>

                <div class="d-flex justify-content-end">
                    <button onclick="addSupplier()" class="btn btn-primary">Add</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        var table = document.getElementById("tradingTable")
        //var filterCompleted = document.getElementById('filterBaseCompleted');
        var dataTable = $(table).DataTable({
            pageLength: 5,
            dom: 'Bfrtipl',
            buttons: [
                'colvis'
            ],
            lengthMenu: [[5, 10, 15, -1], [5, 10, 15, 'All']],
            order: []
        });

        var filterSearch = document.getElementById("filter_search");
        filterSearch.addEventListener("keyup", function (e) {
            console.log('sss')
            dataTable.search(e.target.value).draw();
        });

        $('div.dataTables_filter').addClass('d-none');
    })

    function deleteRecord(id){
        Swal.fire({
            text: "Are you sure delete this record?",
            icon: "warning",
            showCancelButton: true,
            buttonsStyling: false,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "No, return",
            customClass: {
                confirmButton: "btn btn-primary",
                cancelButton: "btn btn-active-light"
            }
        }).then(function (result) {
            if (result.value) {
                var table = $('#tradingTable').DataTable();
                $.ajax({
                    url: "@Url.Action("DeleteRecord","TradeTracker")",
                    method: 'POST',
                    data: {
                        id
                    },
                    //success: function() {location.reload();}
                    success: function () {
                        table.row("#" + id).remove().draw();
                    }
                });
            } else if (result.dismiss === 'cancel') {
                Swal.fire({
                    text: "Your request has been cancelled!.",
                    icon: "error",
                    buttonsStyling: false,
                    confirmButtonText: "Ok, got it!",
                    customClass: {
                        confirmButton: "btn btn-primary",
                    }
                });
            }
        });

    }

</script>

