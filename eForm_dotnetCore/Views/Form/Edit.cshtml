@model Form

@{
    ViewBag.Title = "Edit";
    ViewBag.Rev = "Rev " + ViewBag.NewRevision;
}
@if (ViewBag.Recovery != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Recovery
    </div>
}
<style>

