@using eForm_dotnetCore.Domain
@using eForm_dotnetCore.Helpers
@model IEnumerable<TableData>

@{
	ViewData["Title"] = PageTitle.ManageForm;
}

<style>
.tableBorder{
    color:black;
    font-size:15px;
    border-right: 2px solid #D3D3D3;
    text-align:center;
}
</style>

<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">
        <div class="card card-flush mb-5 mb-xl-8">
            <!--begin::Header-->
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                   @* <span class="card-label fw-bolder fs-3 mb-1">Manage Form</span>*@
                    <span class="text-muted mt-1 fw-bold fs-7" style="color:black;font-size:10px;">Total @Model.Count() requests</span>
                </h3>
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-4">
                        <div class="me-6 my-1">
                            <a href="#" class="btn btn-sm btn-primary btn-active-light" data-bs-toggle="modal" data-bs-target="#modal_new_request">
                                <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                                <span class="svg-icon svg-icon-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                        <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="black" />
                                        <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="black" />
                                    </svg>
                                </span>
                                <!--end::Svg Icon-->New Form
                            </a>
                        </div>
                        <!--end::Destination-->
                        <!--begin::Status-->
                        <div class="d-flex align-items-center fw-bolder">
                            <!--begin::Label-->
                            <div class="text-dark fs-7 me-2">Status</div>
                            <!--end::Label-->
                            <!--begin::Select-->
                            <select class="form-select form-select-transparent text-dark fs-7 lh-1 fw-bolder py-0 ps-3 w-auto" data-control="select2" data-hide-search="true" data-dropdown-css-class="w-150px" data-placeholder="Select an option" data-kt-table-widget-4="filter_status">
                                <option></option>
                                <option value="Show All" selected="selected">Show All</option>
                                <option value="Unpublish">Unpublish</option>
                                <option value="Publish">Publish</option>
                                <option value="Submitted">Submitted</option>
                            </select>
                            <!--end::Select-->
                        </div>
                        @*<div class="d-flex align-items-center fw-bolder">
                            <!--begin::Label-->
                            <div class="text-dark fs-7 me-2">Status</div>
                            <!--end::Label-->
                            <!--begin::Select-->
                            <select class="select form-select form-select-transparent text-dark fs-7 lh-1 fw-bolder py-0 ps-3 w-auto" multiple>
                                <option></option>
                                <option value="Show All" selected="selected">Show All</option>
                                <option value="Unpublish">Unpublish</option>
                                <option value="Publish">Publish</option>
                                <option value="Submitted">Submitted</option>
                            </select>
                            <!--end::Select-->
                        </div>*@
                        <div class="d-flex align-items-center position-relative my-1">
                            <!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <!--end::Svg Icon-->
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search Request" />
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Header-->
            <!--begin::Body-->
            <div class="card-body py-3">
                <!--begin::Table container-->
                <div class="table-responsive">
                    <!--begin::Table-->
                    <table id="formRequestTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <!--begin::Table head-->
                        <thead>
                            <tr class="fw-bolder text-muted">
@*                                <th class="w-25px">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid">
                                        <input class="form-check-input" type="checkbox" value="1" data-kt-check="true" data-kt-check-target=".widget-9-check" />
                                    </div>
                                </th>*@
                                <th class="text-center min-w-150px" style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Name</b></th>
                                <th class="text-center min-w-150px"style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Document Name</b></th>
                                <th class="text-center min-w-100px"style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Revision</b></th>
                                <th class="text-center min-w-150px"style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Last Modified Date</b></th>
                                <th class="text-center min-w-150px"style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Modified By</b></th>
                                <th class="text-center min-w-100px"style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Status</b></th>
                                <th class="text-center min-w-100px"style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Actions</b></th>
                            </tr>
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody>
                            @foreach (var form in Model)
                            {
                                <tr id="@form.Id">
@*                                    <td>
                                        <div class="form-check form-check-sm form-check-custom form-check-solid">
                                            <input class="form-check-input widget-9-check" type="checkbox" value="1" />
                                        </div>
                                    </td>*@
                                    <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                        <a href="#" class="text-dark fw-bolder text-hover-primary fs-6 me-3">@Html.DisplayFor(modelItem => form.Name)</a>
                                    </td>
                                    <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                        <a href="#" class="text-dark fw-bolder text-hover-primary fs-6">@Html.DisplayFor(modelItem => form.DocumentName)</a>
                                    </td>
                                    <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                        <a href="#" class="text-dark fw-bolder text-hover-primary fs-6">@Html.DisplayFor(modelItem => form.Revision)</a>
                                    </td>
                                    <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                        @Html.DisplayFor(modelItem => form.LastUpdated)
                                    </td>
                                    <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                        <a href="#" class="text-dark fw-bolder text-hover-primary fs-6">@Html.DisplayFor(modelItem => form.ModifiedBy)</a>
                                    </td>
                                    <td class="text-end" style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                        <div class="d-flex flex-column w-100 me-2">
                                            <div class="d-flex flex-stack mb-2 mt-1">
                                                @if (form.Status == "Unpublish")
                                                {
                                                    <div class="badge badge-light-warning">@form.Status</div>
                                                }
                                                else if (form.Status == "Publish")
                                                {
                                                    <div class="badge badge-light-primary">@form.Status</div>
                                                }
                                                else if (form.Status == "Submitted")
                                                {
                                                    <div class="badge badge-light-success">@form.Status</div>
                                                }
                                                else
                                                {
                                                    <div class="badge badge-light-secondary">@form.Status</div>
                                                }
                                            </div>
                                            @*		<div class="progress h-6px w-100">
                                                @if(form.Status == "Unpublish")
                                                {
                                                <div class="progress-bar bg-danger" role="progressbar" style="width: 10%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                                                }else if(form.Status == "Publish"){
                                                <div class="progress-bar bg-warning" role="progressbar" style="width: 30%" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100"></div>
                                                }
                                                else if(form.Status == "Submitted"){
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: 50%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
                                                }
                                                else{
                                                <div class="progress-bar bg-success" role="progressbar" style="width: 70%" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100"></div>
                                                }
                                                </div>*@
                                        </div>
                                    </td>
                                    <td style="color:black;font-size:15px">
                                        <a href="#" class="btn btn-sm btn-light btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                                            Actions
                                            <!--begin::Svg Icon | path: icons/duotune/arrows/arr072.svg-->
                                        <span class="svg-icon svg-icon-5 m-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                    <path d="M11.4343 12.7344L7.25 8.55005C6.83579 8.13583 6.16421 8.13584 5.75 8.55005C5.33579 8.96426 5.33579 9.63583 5.75 10.05L11.2929 15.5929C11.6834 15.9835 12.3166 15.9835 12.7071 15.5929L18.25 10.05C18.6642 9.63584 18.6642 8.96426 18.25 8.55005C17.8358 8.13584 17.1642 8.13584 16.75 8.55005L12.5657 12.7344C12.2533 13.0468 11.7467 13.0468 11.4343 12.7344Z" fill="black" />
                                                </svg>
                                            </span>
                                            <!--end::Svg Icon-->
                                    </a>
                                        <!--begin::Menu-->
                                    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 w-125px py-4" data-kt-menu="true">
                                            <div class="menu-item px-3">
                                                <a href="@Url.Action("View", "Form", new { id = form.Id })" class="menu-link px-3">View</a>
                                            </div>
                                            <!--begin::Menu item-->
                                        <div class="menu-item px-3">
                                                <a href="@Url.Action("Edit", "Form", new { id = form.Id })" class="menu-link px-3">Edit</a>
                                            </div>
                                            <!--end::Menu item-->
                                            <!--begin::Menu item-->
                                        @*<div class="menu-item px-3">
                                                <a href="#" class="menu-link px-3" onclick="deleteRequest(@form.Id)">Delete</a>
                                            </div>*@
                                            <!--end::Menu item-->
                                    </div>
                                        <!--end::Menu-->
                                </td>
                                </tr>
                            }
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Table container-->
            </div>
            <!--begin::Body-->
        </div>
    </div>
</div>

<div class="modal fade" id="modal_new_request" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <!--begin::Modal content-->
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <!--begin::Close-->
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                    <!--end::Svg Icon-->
                </div>
                <!--end::Close-->
            </div>
            <!--begin::Modal header-->
            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <!--begin:Form-->
                <form id="new_request_form" asp-controller="Form" asp-action="addNewRequest" method="post" class="form">
                    <!--begin::Heading-->
                    <div class="mb-13 text-left">
                        <!--begin::Title-->
                        <h1 class="mb-3">Create Form</h1>
                        <!--end::Title-->
                    </div>
                    <!--end::Heading-->
                    <!--begin::Input group-->
                    <div class="d-flex flex-column mb-8 fv-row">
                        <!--begin::Label-->
                        <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                            <span class="required">Name</span>
                            @*							<i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title="Specify a request title for future usage and reference"></i>
                            *@
                        </label>
                        <!--end::Label-->
                        <input type="text" class="form-control form-control-solid" placeholder="Enter Form Name" name="request_title" />
                    </div>
                    <!--end::Input group-->
                    <!--begin::Actions-->
                    <div class="text-center">
                        <button type="reset" id="new_request_cancel" class="btn btn-light me-3">Cancel</button>
                        <button type="submit" id="kt_modal_new_target_submit" class="btn btn-primary">
                            <span class="indicator-label">Submit</span>
                            <span class="indicator-progress">
                                Please wait...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                    <!--end::Actions-->
                </form>
                <!--end:Form-->
            </div>
            <!--end::Modal body-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>

@section scripts{
<script>
    $(document).ready(function () {
        $("#kt_daterangepicker_3").flatpickr();

        //var table = document.getElementById("formRequestTable");
        //    tail.select(".select", {
        //        search: true
        //    });

        var dataTable = $(table).DataTable({
            "info":false,
            "order":[]
        });

        var model1 = document.getElementById("modal_new_request");
        var requestModal = new bootstrap.Modal(model1);

        var cancelButton = document.getElementById('new_request_cancel');

        cancelButton.addEventListener('click', function (e) {
            e.preventDefault();

            Swal.fire({
                text: "Are you sure you would like to cancel?",
                icon: "warning",
                showCancelButton: true,
                buttonsStyling: false,
                confirmButtonText: "Yes, cancel it!",
                cancelButtonText: "No, return",
                customClass: {
                    confirmButton: "btn btn-primary",
                    cancelButton: "btn btn-active-light"
                }
            }).then(function (result) {
                if (result.value) {
                    //form.reset(); // Reset form
                    requestModal.hide(); // Hide modal
                } else if (result.dismiss === 'cancel') {
                    Swal.fire({
                        text: "Your form has not been cancelled!.",
                        icon: "error",
                        buttonsStyling: false,
                        confirmButtonText: "Ok, got it!",
                        customClass: {
                            confirmButton: "btn btn-primary",
                        }
                    });
                }
            });
        });

        var filterSearch = document.getElementById('filter_search');
        filterSearch.addEventListener('keyup', function (e) {
            dataTable.search(e.target.value).draw();
        });
    })

    function deleteRequest(formId){
        Swal.fire({
                text: "Are you sure delete this form?",
                icon: "warning",
                showCancelButton: true,
                buttonsStyling: false,
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "No, return",
                customClass: {
                    confirmButton: "btn btn-primary",
                    cancelButton: "btn btn-active-light"
                }
            }).then(function (result) {
                if (result.value) {
                    var table = $('#formRequestTable').DataTable();
                    $.ajax({
                         url : "@Url.Action("deleteRequest","Form")",
                         method : 'delete',
                         data : {
                            id :formId
                         },
                         //success: function() {location.reload();}
                         success: function() {
                            table.row("#"+formId).remove().draw();
                         }
                    });
                } else if (result.dismiss === 'cancel') {
                    Swal.fire({
                        text: "Your form has not been cancelled!.",
                        icon: "error",
                        buttonsStyling: false,
                        confirmButtonText: "Ok, got it!",
                        customClass: {
                            confirmButton: "btn btn-primary",
                        }
                    });
                }
            });
    }
</script>
}