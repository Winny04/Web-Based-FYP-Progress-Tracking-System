                <h4 class="modal-title">Archive Confirmation</h4>
            </div>
            <div class="modal-body">

                Are you sure you want to archive this form?
                <br>
                @using (Html.BeginForm("Archive", "Form", FormMethod.Post, new { id = "myform2", @class = "" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <p class="control-label col-md-2">Remark</p>
                        <div class="col-md-10">
                            <input type="text" name="Remark" value="" class="form-control" required />
                        </div>
                    </div>
                    <p id="chooseId2" hidden></p>
                    <div class="modal-footer">
                        <button id="myInput" type="submit" class="btn btn-primary" value="Edit">Archive</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

