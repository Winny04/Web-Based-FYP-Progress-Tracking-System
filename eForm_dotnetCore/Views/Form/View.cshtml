@model Form
@{
    ViewBag.Title = "View";
}

<div class="card">
    <div class="card-header">
        <div class="card-title fs-3 fw-bolder">View Form</div>
    </div>

    @using (Html.BeginForm("Edit","Home",FormMethod.Post,new { id = "myform1", @class = "form" }))
    {
        @Html.AntiForgeryToken()
        <div class="card-body p-18">
            <div class="row mb-8">
                <div class="col-xl-3">
					<div class="fs-6 fw-bold mt-2 mb-3">Name</div>
				</div>
                <div class="col-xl-9 fv-row">
					<input type="text" class="form-control form-control-solid h-40px" name="name" value="@Model.Name" disabled/>
				</div>
             </div>
             <div class="row mb-8">
				<!--begin::Col-->
				<div class="col-xl-3">
					<div class="fs-6 fw-bold mt-2 mb-3">Revision</div>
				</div>
				<!--end::Col-->
				<!--begin::Col-->
				<div class="col-xl-9 fv-row">
					<input type="text" class="form-control form-control-solid h-40px" name="type" value="@Model.Revision" disabled/>
				</div>
			</div>
            <div class="row mb-8">
			    <!--begin::Col-->
			    <div class="col-xl-3">
				    <div class="fs-6 fw-bold mt-2 mb-3">Document Name</div>
			    </div>
			    <!--end::Col-->
			    <!--begin::Col-->
			    <div class="col-xl-9 fv-row">
			   					<input type="text" class="form-control form-control-solid h-40px" name="type" value="@Model.DocumentName" disabled/>
                </div>
			    <!--begin::Col-->
		    </div>
             <div class="row mb-8">
			    <!--begin::Col-->
			    <div class="col-xl-3">
				    <div class="fs-6 fw-bold mt-2 mb-3">Status</div>
			    </div>
			    <!--end::Col-->
			    <!--begin::Col-->
			    <div class="col-xl-9 fv-row pt-2">
                    @if(Model.Status == "Unpublish")
					{
						<div class="badge badge-light-warning fs-5">@Model.Status</div>
					}else if(Model.Status == "Publish"){
						<div class="badge badge-light-primary fs-5">@Model.Status</div>
					}
					else if(Model.Status == "Submitted"){
						<div class="badge badge-light-success fs-5">@Model.Status</div>
					}
					else{
						<div class="badge badge-light-secondary fs-5">@Model.Status</div>
					}
			    </div>
			    <!--begin::Col-->
		    </div>
           
            <div class="row mb-8">
			    <!--begin::Col-->
			    <div class="col-xl-3">
				    <div class="fs-6 fw-bold mt-2 mb-3">Remark</div>
			    </div>
			    <!--end::Col-->
			    <!--begin::Col-->
			    <div class="col-xl-9 fv-row">
				    <textarea name="Remark" class="form-control form-control-solid h-40px" disabled>@Model.Remark</textarea>
			    </div>
			    <!--begin::Col-->
		    </div>
        </div>
    }

