@using System.Collections
@using eForm_dotnetCore.ViewModel
@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using Microsoft.EntityFrameworkCore;
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using eForm_dotnetCore.Configuration.Auhtorization;
@using eForm_dotnetCore.Models;

@model BOMOverviewViewModel

@{
    ViewData["Title"] = PageTitle.TradingPR;
    var itemCategories = EnumHelpers.ToSelectList<BomItemCategory>();
    var fabricationBrandList = EnumHelpers.ToSelectList<FabricationBrand>();

    var ableViewActualMCost = Context.GetUserType().Equals("Buyer", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("CEO", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("GFC", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("HOD", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("PM", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("Quality", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("Sales", StringComparison.OrdinalIgnoreCase);

    var ableViewDrawing = Context.GetUserType().Equals("Buyer", StringComparison.OrdinalIgnoreCase)
                   || Context.GetUserType().Equals("PM", StringComparison.OrdinalIgnoreCase)
                   || Context.GetUserType().Equals("HOD", StringComparison.OrdinalIgnoreCase);

}

<style>
    span.prefix {
        background-color: #afafaf;
        color: #fff8f8;
        line-height: 10px;
        height: 30px;
        padding: 10px;
        border: 1px #888 solid;
        font-size: 9pt;
    }

    .dataTables_wrapper .dt-buttons .buttons-colvis {
        background-color: #007bff;
        border-color: #007bff;
        color: #fff;
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        margin: 10px;
    }

        .dataTables_wrapper .dt-buttons .buttons-colvis:hover {
            background-color: #0069d9;
            border-color: #0062cc;
            color: #fff;
        }
</style>

<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxxl">
    <div class="content flex-row-fluid" id="kt_content">
        <div class="card card-flush">
            <div class="card-header" style="padding: 0px 12px">
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-2">
                        <div class="d-flex align-items-center fw-bolder">
                            <!--begin::Select Category-->
                            <select class="form-control" id="categoryFilter">
                                <option value=" " selected>Category</option>
                                @foreach (var item in itemCategories)
                                {
                                    var shortName = EnumHelpers.ToSelectList<BomItemCategoryShortName>().Where(x => x.Id == item.Id).Select(x => x.Text).FirstOrDefault();
                                    <option value="@item.Text">@item.Text Part (@shortName)</option>
                                }
                            </select>
                        </div>
                        <div class="d-flex align-items-center fw-bolder">
                            <select class="form-control" id="statusFilter">
                                <option value=" " selected>Status</option>
                                <option value="New">New</option>
                                <option value="RFQ Sent">RFQ Sent</option>
                                <option value="RFQ Updated">RFQ Updated</option>
                                <option value="RFQ Approved">RFQ Approved</option>
                                <option value="RFQ Reject">RFQ Reject</option>
                                <option value="PR Sent">PR Sent</option>
                                <option value="PR Approved">PR Approved</option>
                                <option value="PR Reject">PR Reject</option>
                                <option value="PO Approved">PO Approved</option>
                                <option value="PO Revise">PO Revise</option>
                                <option value="PO Reject">PO Reject</option>
                                <option value="ETA Updated">ETA Updated</option>
                                <option value="Partial Received">Partial Received</option>
                                <option value="Item Received">Item Received</option>
                                <option value="Item Issued Out">Item Issued Out</option>
                                <option value="Completed">Completed</option>
                            </select>
                            <!--end::Select-->
                        </div>
                        <div class="d-flex align-items-center position-relative my-1">
                            <!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <!--end::Svg Icon-->
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search Form" />
                        </div>
                    </div>
                </div>
            </div>
       
        <table id="tradingPRTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4" style="background-color:white;">
            <thead>
                <tr class="font-weight-bold text-center">
                    <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Project</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>BOM No</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Status</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Cat.</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Module</b></th>
                    <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Description</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Brand</b></th>
                    <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Part No.</b></th>
                    <th class="mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Unit Qty</b></th>
                    <th class="mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Total Qty</b></th>
                    <th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>PR</b></th>
                    <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Supplier</b></th>
                    <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Vendor Quot.</b></th>
                    <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>PO</b></th>
                    <th class="min-w-50px mw-50" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>PO Qty</b></th>
                    <th class="min-w-50px mw-50" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Unit Price(RM)</b></th>
                    <th class="min-w-50px mw-50" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Total Price(RM)</b></th>
                    <th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>ETA</b></th>
                    <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Recv. Date</b></th>
                    <th class="min-w-100px mw-100" style="color:black;font-size:11px;"><b>Action</b></th>
                </tr>
            </thead>
        </table>
        </div>
    </div>
</div>

@*Edit BOM modal*@
<div class="modal fade" id="modal_edit" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Edit BOM</h1>
                    <div class="text-muted fw-bold fs-5">
                        If you need more info, please check
                        <a href="#" class="fw-bolder link-primary">Project Guidelines</a>.
                    </div>
                </div>
                <input type="hidden" id="selectedFormId" />
                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Module</label>
                    <input id="eModule" class="form-control form-control-lg form-control-solid" name="Module" type="text" required />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>

                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Description</label>
                    <input id="ePartDesc" class="form-control form-control-lg form-control-solid" name="PartDesc" type="text" />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>

                <div id="eFBBrandString" class="mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2">Brand</label>
                    <input id="eBrand" class="form-control form-control-lg form-control-solid" name="Brand" type="text" />
                    @*<p id="evalidateFBBrand" class="text-danger" type="text">The brand of Fabrication Part only accept Sheet Metal,Perspex,Profile,Base Plate, and Structure</p>*@
                </div>

                <div id="eFBBrandDropdown" class="mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Brand</label>
                    <select id="eFBBrand" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="Select a Brand" name="Brand" required>
                        <option value="">Select brand...</option>
                        @foreach (var i in fabricationBrandList)
                        {
                            var brandName = EnumHelpers.ToSelectList<FabricationBrand>().Where(x => x.Id == i.Id).Select(x => x.Text).FirstOrDefault();
                            <option value="@i.Text.Replace('_', ' ')">@brandName.Replace('_', ' ')</option>
                        }
                    </select>
                </div>

                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Item Category</label>
                    <select id="eItemCategory" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="Select a Category" name="ItemCategory" required>
                        <option value="">Select category...</option>
                        @foreach (var i in itemCategories)
                        {
                            <option value="@i.Text">@i.Text part</option>
                        }
                    </select>
                </div>

                <div class="mb-2 fv-row" id="attachFileItem2">
                    <label class="fs-6 fw-bold mb-2 required">Part No</label>
                    <div id="itemFile2Container" hidden></div>
                    <input type="file" class="form-control" id="itemFile2" accept="application/pdf" multiple />
                </div>
                <div class="mb-2 fv-row" id="epartNoContainer">
                    <label class="fs-6 fw-bold mb-2 required">Part No</label>
                    <input id="ePartNumber" class="form-control form-control-lg form-control-solid" name="PartNumber" type="text" />
                </div>
                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Unit Qty</label>
                    <input id="eUnitQty" class="form-control form-control-lg form-control-solid" name="UnitQty" onchange="upTotalQty(this.value,'eRequireQty')" type="number" value="0" />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>
                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Total Qty</label>
                    <input id="eRequireQty" class="form-control form-control-lg form-control-solid" name="RequireQty" type="number" value="0" />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>

                <input type="hidden" value="@ViewBag.ProjectId" id="hProjectId" />
                <input type="hidden" id="hCheckedId" />
                <div class="text-center">
                    <button type="button" id="edit_request_close" class="btn btn-light me-3">Cancel</button>
                    <button type="button" id="edit_bom_submit" class="btn btn-primary">
                        <span class="indicator-label">Submit</span>
                    </button>
                </div>
                <div id="loading-spinner" style="text-align:center;display:none;margin-top:20px;">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="text-active-success">Saving form. Please wait...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upload Part No File -->
<div class="modal fade" id="modal_upload_file" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Upload File</h1>
                </div>

                <form asp-controller="TradingPR" asp-action="attachFile" method="post" enctype="multipart/form-data">
                    <div class="mt-3 my-5 ml-5">
                        <input type="file" name="files" accept="application/pdf" multiple />
                    </div>
                    <input type="hidden" id="uploadFile_bomId" name="bomId" />
