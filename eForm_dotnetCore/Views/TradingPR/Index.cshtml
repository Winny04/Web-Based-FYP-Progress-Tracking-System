                        <div class="spinner-border text-info" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                        <p class="text-active-success">Upload in progress. Please wait...</p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script>
        var rfqColors = [];
        var colorList = ["ff0000", "72aafe", "d38d4a"];
        var counter = 0;
        var prCounter = 0;

        function availableBaseStatus(currentStatus, itemStatus) {
            const statusFlow = [
                 "New",
                 "RFQ Sent",
                 "RFQ Updated",
                 "RFQ Reject",
                 "RFQ Approved",
                 "PR Sent",
                 "PR Reject",
                 "PR Approved",
                 "PO Revise",
                 "PO Reject",
                 "PO Approved",
                 "ETA Updated",
                 "Partial Received",
                 "Item Received",
                 "Item Issued Out",
                 "Completed"
                 ];

            const currentIndex = statusFlow.indexOf(currentStatus);
            const itemIndex = statusFlow.indexOf(itemStatus);

            return itemIndex >= currentIndex;
        }

        $(document).ready(function() {
            var table = document.getElementById("tradingPRTable");
            var dataTable = $(table).DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                searchDelay: 500,
                pageLength: 5,
                "pagingType": "full_numbers",
                "rowCallback": function (row, data) {
                    $(row).attr('id', data.id);
                    $(row).css('max-height','30px')
                    $(row).css('color', 'black')
                    $(row).css('font-size', '11px')
                    $(row).css('border-right', '2px solid #D3D3D3')
                    $(row).addClass('text-center text-break');
                },
                 dom: 'Brti<"bottom"pl><"clear">',
                buttons: [
                    'colvis'
                ],
                lengthMenu: [[5, 10, 15,-1], [5, 10, 15,"All"]],
                select: {
                    style: "os",
                    selector: "td:first-child"
                },
                "ajax": {
                    "url": "@Url.Action("LoadData")",
                    "type": "POST",
                    "data": function(d) {
                        d.Status = $("#statusFilter").val();
                        d.Category = $("#categoryFilter").val();
                    }
                },
                columnDefs: [
                    {
                        targets: 0,
                        render: function (data, type, row) {
                            return row.projectName || '';
                        }
                    },
                    {
                        targets: 1,
                        render: function (data, type, row) {
                            return row.bomNo;
                        }
                    },
                    {
                        targets: 2,
                        render: function (data, type, row) {
                            let statusDiv = ''
                            let lastUpdatedLabel = ''
                            let approverDiv = ''

                            if (row.status === "New" || row.status === "PR Sent" || row.status === "Item Issued Out" ) {
                                statusDiv = `<div class="badge badge-light-primary badge-status">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Sent" || row.status === "PR Approved" || row.status === "PO Revise") {
                                statusDiv = `<div class="badge badge-light-warning badge-status">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Updated" || row.status === "PO Approved" || row.status === "ETA Updated" || row.status === "Partial Received") {
                                statusDiv = `<div class="badge badge-light-info">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Approved" || row.status === "Item Received" || row.status === "Completed") {
                                statusDiv = `<div class="badge badge-light-success">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Reject" || row.status === "PR Reject" || row.status === "Receiving Reject" || row.status === "PO Reject" || row.status === "PO Cancelled") {
                                statusDiv = `<div class="badge badge-light-danger badge-status">${row.status}</div>`
                            }

                            let convertDateTime = moment(row.lastUpdatedDate).format('DD MMM YYYY')
                            lastUpdatedLabel = `
                                <span class="fs-8 fw-light lh-sm d-block">
                                    <span style="font-size:11px;font-family: sans-serif;">${convertDateTime}</span>
                                </span>`

                            if (row.totalApprover > 0 && row.status == "PR Sent")
                            {
                                const labelBg = ['bg-light-success', 'bg-light-warning']
                                const labelText = ['Approved', 'Pending']
                                approverDiv += '<div>';

                                if (row.prApprovers.some(x => x.type === "HOD" && x.approved))
                                {
                                    approverDiv += `<p style="font-size=12px" class=${labelBg[0]}>HOD ${labelText[0]}</p>`
                                }
                                else
                                {
                                    approverDiv += `<p style="font-size=12px" class=${labelBg[1]}>HOD ${labelText[1]}</p>`
                                }

                                if(row.totalApprover > 1)
                                {
                                    if (row.prApprovers.some(x => x.type === "GFC" && x.approved)) {
                                        approverDiv += `<p style="font-size=12px" class=${labelBg[0]}>GFC ${labelText[0]}</p>`
                                    }
                                    else{
                                        approverDiv += `<p style="font-size=12px" class=${labelBg[1]}>GFC ${labelText[1]}</p>`
                                    }
                                }
                                if (row.totalApprover > 2) {
                                    if (row.prApprovers.some(x => x.type === "CEO" && x.approved)) {
                                        approverDiv += `<p style="font-size=12px" class=${labelBg[0]}>CEO ${labelText[0]}</p>`
                                    }
                                    else {
                                        approverDiv += `<p style="font-size=12px" class=${labelBg[1]}>CEO ${labelText[1]}</p>`
                                    }
                                }
                            }

                            approverDiv += '</div>'

                            return statusDiv + lastUpdatedLabel + approverDiv
                        }
                    },
                    {
                        targets: 3,
                        render: function (data, type, row) {
                            return row.itemCategory;
                        }
                    },
                    {
                        targets: 4,
                        render: function (data, type, row) {
                            return row.module;
                        }
                    },
                    {
                        targets: 5,
                        render: function (data, type, row) {
                            return `
                                <div style="color:black;font-size:11px; word-wrap: break-word;">
                                    ${row.partDesc}
                                </div>
                            `
                        }
                    },
                    {
                        targets: 6,
                        render: function (data, type, row) {
                            return row.brand
                        }
                    },
                    {
                        targets: 7,
                        render: function (data, type, row) {
                            let partNoEle = ''
                            if (row.itemCategory === "Fabrication") {
                                if (row.bomSupportFiles != null && row.bomSupportFiles.some(x => x.type === "IC") && ('@ableViewDrawing' === 'True' || row.canViewDrawing)) {
                                    const bfs = row.bomSupportFiles.filter(x => x.type === "IC");
                                    const imageTypes = [".png",".jpeg",".jpg"]
                                    bfs.forEach(sf => {
                                        var sfId = sf.supportFileId
                                        var po = sf.supportFile.fileName.split(/ - |_-_/)[0];
                                        var previewEndPoint = imageTypes.includes(bfs[0].supportFile.contentType) ? "PreviewImage" : "ShowPDF";
                                        if(previewEndPoint === "PreviewImage"){
                                            partNoEle += ` <a href="/BOM/${previewEndPoint}?id=${sfId}" target="_blank">${sf.supportFile.fileName}</a>`
                                        }
                                        else{
                                            partNoEle += `<a href="/BOM/${previewEndPoint}?supportFileId=${sfId}" target="_blank">${sf.supportFile.fileName}</a>`
                                        }
                                        const removeBtn = `<a href="/TradingPR/removeFile/${sfId}?projectId=${row.projectId}" class="mx-2 text-danger">X</a>`
                                        partNoEle += removeBtn
                                    })
                                }
                                else
                                {
                                    const disabled = row.projectStatus === "Completed"
                                    const btnClass = disabled ? 'btn-secondary' : 'btn-primary'

                                    if(disabled){
                                        partNoEle += `
                                            <button id="uploadPart" class="btn ${btnClass}" disabled>
                                                Upload
                                            </button>
                                        `
                                    }
                                    else{
                                        partNoEle += `
                                            <button id="uploadPart" class="btn ${btnClass}" onclick="openUploadFileModal(${row.id},'IC')">
                                                Upload
                                            </button>
                                        `
                                    }
                                }
                            }
                            else
                            {
                                partNoEle += row.partNumber
                            }

                            return partNoEle
                        }
                    },
                    {
                        targets: 8,
                        render: function (data, type, row) {
                            return row.unitQty
                        }
                    },
                    {
                        targets: 9,
                        render: function (data, type, row) {
                            return row.requireQty
                        }
                    },
                    {
                        targets: 10,
                        render: function (data, type, row) {
                            let prEle = ''

                            if (row.pr === null) {
                                prEle += `<span class="text-muted">-</span>`
                            }
                            else {
                                let colorStr = colorList[prCounter]
                                if (rfqColors.length > 0 && rfqColors.some(x => x.name === row.prName)) {
                                    colorStr = rfqColors.find(x => x.name === row.prName).color;
                                }
                                else {
                                    rfqColors.push({
                                        name: row.prName,
                                        color: colorStr
                                    })
                                    prCounter += 1;
                                    if (prCounter === 5) {
                                        prCounter = 0
                                    }
                                }

                                prEle += `<a href="/PurchaseRequisition/Edit/${row.prId}" class="link-success" style="color:#${colorStr}"><b>${row.prName}</b></a>`
                            }

                            return prEle
                        }
                    },
                    {
                        targets: 11,
                        render: function (data, type, row) {
                            return row.supplierName || '-'
                        }
                    },
                    {
                        targets: 12,
                        render: function (data, type, row) {
                            if(row.quotName === ""){
                                return "-"
                            }

                            return `<a href="${row.quotUrl}" target="_blank">${row.quotName}</a>`
                        }
                    },
                    {
                        targets: 13,
                        render: function (data, type, row) {
                            let poEle = ''
                            if (row.bomSupportFiles != null && row.bomSupportFiles.some(x => x.type === "PO")) {
                                const bfs = row.bomSupportFiles.filter(x => x.type === "PO");
                                bfs.forEach(sf => {
                                    var po = sf.supportFile.fileName.split(/ - |_-_/)[0];
                                    var sfId = sf.supportFileId
                                    poEle += `<a href="/BOM/ShowPDF?supportFileId=${sfId}" target="_blank">${po}</a>`
                                })
                            }
                            else {
                                poEle = '-'
                            }

                            return poEle
                        }
                    },
                    {
                        targets: 14,
                        render: function (data, type, row) {
                            if(row.prQuantity === -1){
                                return "-"
                            }
                            return row.prQuantity
                        }
                    },
                    {
                        targets: 15,
                        render: function (data, type, row) {
                            if(row.prUnitPrice === -1){
                                return "-"
                            }
                            return row.prUnitPrice.toFixed(4)
                        }
                    },
                    {
                        targets: 16,
                        render: function (data, type, row) {
                            if (row.prTotalPrice === -1) {
                                return "-"
                            }
                            return row.prTotalPrice.toFixed(2)
                        }
                    },
                    {
                        targets: 17,
                        render: function (data, type, row) {
                            if (row.eta === null) {
                                return "-"
                            }
                            const convertDateStr = moment(row.eta).format('DD MMMM YYYY')
                            return convertDateStr
                        }
                    },
                    {
                        targets: 18,
                        render: function (data, type, row) {
                            if (row.receivedDate === null) {
                                return "-"
                            }
                            const convertDateStr = moment(row.receivedDate).format('DD MMMM YYYY')
                            return convertDateStr
                        }
                    },
                    {
                        targets: 19,
                        render: function (data, type, row) {
                            let actionEle = `<div class="d-flex gap-2 align-items-center justify-content-center">`

                            if (row.projectStatus !== "Completed") {
                                
                                actionEle += ` <button type="button" class="btn btn-sm btn-primary" onclick="setEditForm(${row.projectId},${row.id})">Edit</button>`
                                if ((row.status == "PO Approved" || row.status == "ETA Updated") && ("@Context.GetUserType()" === "PM" || "@Context.GetUserType()" === "SuperAdminAssistant" || "@Context.GetUserType()" === "SuperAdmin" || "@Context.GetUserType()" === "Purchaser"))
                                {
                                    actionEle += `<a href="/POTracker/POHistory/${row.id}" class="btn btn-sm btn-info">Reject PO</a>`
                                }
                                
                                if(!availableBaseStatus("PR Approved",row.status))
                                {
                                    actionEle += ` <button type="button" class="btn btn-sm btn-danger" onclick="deleteForm(${row.id})">Delete</a>`
                                }
                            }
                           
                            actionEle += "</div>"
                            return actionEle
                        }
                    },
                ],
                "order": [],
            });
            
            $("#eItemCategory").change(function () {
                if ($("#eItemCategory").val() == "@BomItemCategory.Fabrication.ToString()") {
                    $("#eFBBrandDropdown").show();
                    $("#eFBBrandString").hide();
                    $("#attachFileItem2").show();
                    $("#epartNoContainer").hide();
                    $("#epartNoContainer").val(null);
                } else {
                    $("#eFBBrandDropdown").hide();
                    $("#eFBBrandString").show();
                    $("#attachFileItem2").hide();
                    $("#attachFileItem2").val(null);
                    $("#epartNoContainer").show();
                }
            });
            
            $("#edit_bom_submit").click(function () {
                var Id = $("#selectedFormId").val();
                var Module = $("#eModule").val();
                var PartNumber = $("#ePartNumber").val();
                var Brand = $("#eBrand").val();
                var BrandFb = $("#eFBBrand").val();
                var PartDesc = $("#ePartDesc").val();
                var ItemCategory = $("#eItemCategory").val();
                var UnitQty = $("#eUnitQty").val();
                var RequireQty = $("#eRequireQty").val();
                //var ProductName = $("#eProductName").val();

                if (ItemCategory == "@BomItemCategory.Fabrication.ToString()") {
                    Brand = BrandFb;
                }

                var form = {
                    Id: Id,
                    Module: Module,
                    PartNumber: PartNumber,
                    Brand: Brand,
                    PartDesc: PartDesc,
                    ItemCategory: ItemCategory,
                    UnitQty: UnitQty,
                    RequireQty: RequireQty,

                };
                Swal.fire({
                    text: "Are you sure edit this bom?",
                    icon: "warning",
                    showCancelButton: true,
                    buttonsStyling: false,
                    confirmButtonText: "Yes!",
                    cancelButtonText: "No, return",
                    customClass: {
                        confirmButton: "btn btn-primary",
                        cancelButton: "btn btn-active-light"
                    }
                }).then(function (result) {
                    $("#loading-spinner").css("display", "block");

                    $.ajax({
                        url: '@Url.Action("Edit", "BOM")',
                        type: 'POST',
                        data: { form: form },
                        success: function (result) {
                            if (result.result == true) {
                                var formData = new FormData();
                                var anyFiles = false;

                                if (document.getElementById("itemFile2").files.length != 0) {
                                    var file1 = $("#itemFile2").get(0).files;
                                    anyFiles = true;
                                    for (var i = 0; i < document.getElementById("itemFile2").files.length; i++) {
                                        formData.append('files', file1[i]);
                                    }

                                    formData.append('types', "IC");

                                    formData.append('bomId', result.id);

                                    $.ajax({
                                        url: "/BOM/attachFile",
                                        type: "POST",
                                        data: formData,
                                        enctype: 'multipart/form-data',
                                        processData: false,
                                        contentType: false,
                                        cache: false,
                                        success: function (result) {
                                            $("#kt_modal_new_target_submit").prop("disabled", false);
                                            $("#new_request_close").prop("disabled", false);
                                            $("#loading-spinner").css("display", "none");
                                            //window.location.href = "/BOM/Index/" + result.id;
                                            location.reload();
                                        }
                                    });
                                }

                                $("#loading-spinner").css("display", "none");
                                $("#modal_edit").modal("hide");
                                location.reload();
                            }
                            else {
                                $("#loading-spinner").css("display", "none");
                                Swal.fire({
                                    text: result.msg,
                                    icon: "error",
                                    confirmButtonText: "Close",
                                })
                            }
                        }
                    });
                })
            });

            // Filter by status
            $('#statusFilter').change(function() {
                dataTable.ajax.reload();
            });

            // Filter by category
            $('#categoryFilter').change(function() {
                dataTable.ajax.reload();
            });

            // Search
            $('#filter_search').on('keyup', function() {
                dataTable.search(this.value).draw();
            });
        });
        
        function openUploadFileModal(bomId, type) {
            $("#uploadFile_bomId").val(bomId);
            $("#uploadFileType").val(type);
            $("#modal_upload_file").modal("show");
        }

        function setEditForm(projectId, formId) {
            var id = formId;
            $("#selectedFormId").val(id);
            $("#eModule").val("");
            $("#ePartNumber").val("");
            $("#eBrand").val("");
            $("#eFBBrand").val("");
            $("#ePartDesc").val("");
            $("#eItemCategory").val("");
            $("#eUnitQty").val("");
            $("#eRequireQty").val("");

            $.ajax({
                url: "/BOM/Edit",
                data: { id: id, projectId: projectId },
                success: function (result) {
                    if (result != null) {
                        $("#eModule").val(result.data.module);
                        //$("#eProductName").val(result.data.productName);
                        $("#ePartNumber").val(result.data.partNumber);
                        $("#ePartDesc").val(result.data.partDesc);
                        $("#eItemCategory").val(result.data.itemCategory).change();
                        if (result.data.itemCategory == "Fabrication") {
                            $("#eFBBrand").val(result.data.brand).change();
                        }
                        else {
                            $("#eBrand").val(result.data.brand);
                        }
                        $("#eUnitQty").val(result.data.unitQty);
                        $("#eRequireQty").val(result.data.requireQty);
                        document.getElementById("eUnitQty").disabled = result.block;

                        if (result.data.bomSupportFiles != null) {
                            var search = result.data.bomSupportFiles.filter(x => x.type === "QUO");
                            if (search.length > 0) {
                                var target = search[0];
                                //var po = target.supportFile.fileName.split(/ - |_-_/)[0];
                                var opening = "<div class='d-flex justify-content-between'>"
                                var link = `<a href='/BOM/downloadFile/${target.id}'>${target.supportFile.fileName}</a><a href="#" class="text-danger">x</a>`;
                                var closing = "</div>";
                                document.getElementById('itemFile2Container').insertAdjacentHTML("afterbegin", opening + link + closing);
                                document.getElementById('itemFile2Container').style.display = "block";
                            }
                        }
                        $("#modal_edit").modal("show");
                    }
                    else {
                        alert(result.msg);
                    }
                }
            });
        }
        
        function deleteForm(formId) {
            Swal.fire({
                text: "Are you sure delete this bom?",
                icon: "warning",
                showCancelButton: true,
                buttonsStyling: false,
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "No, return",
                customClass: {
                    confirmButton: "btn btn-primary",
                    cancelButton: "btn btn-active-light"
                }
            }).then(function (result) {
                if (result.value) {
                    var table = $("#tradingPRTable").DataTable();
                    $.ajax({
                        url: "@Url.Action("deleteForm", "BOM")",
                        method: "POST",
                        data: {
                            id: formId
                        },
                        success: function () {
                            table.row("#" + formId).remove().draw();
                        }
                    });
                } else if (result.dismiss === "cancel") {
                    Swal.fire({
                        text: "Your bom has not been cancelled!.",
                        icon: "error",
                        buttonsStyling: false,
                        confirmButtonText: "Ok, got it!",
                        customClass: {
                            confirmButton: "btn btn-primary",
                        }
                    });
                }
            });
        }
  </script>
}