@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.ViewModels

@model IEnumerable<POTrackerViewModel>

@{
    ViewData["Title"] = PageTitle.POHistory;
    var canCrud = Context.GetUserType() == "Purchaser" || Context.GetUserType() == "SuperAdminAssistant" || Context.GetUserType() == "SuperAdmin" || Context.GetUserType() == "PM";
}
<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">

        <div class="card card-flush mb-5 mb-xl-8">
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">@PageTitle.POTracker</span>

                </h3>
                @{
                    if (canCrud)
                    {

                        <div class="card-toolbar m-0">
                            <ul class="nav nav-tabs nav-line-tabs nav-stretch fs-6 border-0 fw-bolder">
                                <li class="nav-item" role="presentation">
                                    <a id="kt_activity_po_tracker_tab" class="nav-link justify-content-center text-active-gray-800" href='@Url.Action("Index","POTracker")' target='_blank'>PO List</a>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <a id="kt_activity_po_history_tab" class="nav-link justify-content-center text-active-gray-800 active" data-bs-toggle="tab" role="tab" href="#">PO History</a>
                                </li>
                            </ul>
                        </div>
                    }
                }


                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-4">
                        <div class="d-flex align-items-center position-relative my-1">
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search table" />
                        </div>
                        @* <a href="@Url.Action("ExportToExcel", new {id = ViewBag.ProjectId})" class="btn btn-outline-success">Excel</a>*@
                        <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modal_excel">Excel</button>
                    </div>
                </div>
            </div>
             <div class="d-flex justify-content-end flex-wrap gap-4">
                <div class="d-flex align-items-center position-relative my-1">
                    <label class="fs-6 fw-bold p-3 my-2">Start On</label>
                    <input id="startOnDate" class="form-control form-control-solid form-select-sm w-150px ps-9" value="@DateTime.Now.ToString("yyyy-MM-dd")"/>
                </div>
                    <div class="d-flex align-items-center position-relative my-1">
                    <label class="fs-6 fw-bold p-3 my-2">End On</label>
                    <input id="endOnDate" class="form-control form-control-solid form-select-sm w-150px ps-9" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <!--end::Header-->
            <!--begin::Body-->
            @* <div class="card card-flush mb-5 mb-xl-8">*@
            <div class="card-body py-3">
                <div class="tab-content">
                    <!--PO History-->
                    <div id="kt_activity_po_history" class="card-body p-0">
                        <div class="table-responsive">
                            <table id="PoHistoryTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                                <thead>
                                    <tr class="fw-bolder fs-6 text-uppercase text-center">
                                        <th class="text-center min-w-80px smallThText tableCellBorderLeft tableCellBorderRight"><b>Status</b></th>
                                        <th class="text-center min-w-80px smallThText tableCellBorderRight"><b>PR Approve Date</b></th>
                                        <th class="text-center min-w-70px smallThText tableCellBorderRight"><b>Project Code</b></th>
                                        <th class="text-center min-w-60px smallThText tableCellBorderRight"><b>Project PO</b></th>
                                        <th class="text-center min-w-60px smallThText tableCellBorderRight"><b>Customer</b></th>
                                        <th class="text-center min-w-60px smallThText tableCellBorderRight"><b>Project Name</b></th>
                                        <th class="text-center min-w-60px smallThText tableCellBorderRight"><b>Category</b></th>
                                        @*<th class="text-center min-w-60px smallThText tableCellBorderRight"><b>Rfq</b></th>*@
                                        <th class="text-center min-w-60px smallThText tableCellBorderRight"><b>PR</b></th>
                                        <th class="text-center min-w-60px smallThText tableCellBorderRight"><b>Request by</b></th>
                                        <th class="text-center min-w-30px smallThText tableCellBorderRight"><b>PO</b></th>
                                        <th class="text-center min-w-80px smallThText tableCellBorderRight"><b>PO Done At</b></th>
                                        <th class="text-center min-w-70px smallThText tableCellBorderRight"><b>Remark</b></th>
                                        <th class="text-center min-w-40px smallThText tableCellBorderRight"><b>Action</b></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Count() > 0)
                                    {
                                        @foreach (var form in Model.Where(x => x.Status == "PO Approved"))
                                        {
                                            <tr id="@form.Id" class="text-center">
                                                @*Status*@
                                                <td class="tableCellStandard tableCellBorderLeft">
                                                    @if (form.Status.Equals("New", StringComparison.OrdinalIgnoreCase) || form.Status.Equals("PR Approved", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <div class="badge badge-light-primary badge-status">@form.Status.ToUpper()</div>
                                                    }
                                                    else if (form.Status.Equals("RFQ Sent", StringComparison.OrdinalIgnoreCase) || form.Status.Equals("PR Approved", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <div class="badge badge-light-warning badge-status">@form.Status.ToUpper()</div>
                                                    }
                                                    else if (form.Status.Equals("RFQ Approved", StringComparison.OrdinalIgnoreCase) || form.Status == "PO Approved")
                                                    {
                                                        <div class="badge badge-light-info badge-status">@form.Status.ToUpper()</div>
                                                    }
                                                    else if (form.Status == "PR Sent" || form.Status == "Item Received")
                                                    {
                                                        <div class="badge badge-light-success badge-status">@form.Status.ToUpper()</div>
                                                    }
                                                    else if (form.Status == "RFQ Reject" || form.Status == "PR Reject")
                                                    {
                                                        <div class="badge badge-light-danger badge-status">@form.Status.ToUpper()</div>
                                                    }
                                                </td>
                                                @*PR Approved Date*@
                                                <td class="tableCellStandard">
                                                    @if (form.CreatedDate != null)
                                                    {
                                                        <p>@form.PRApproveDate?.ToString("yyyy-MM-dd")</p>
                                                    }
                                                    else
                                                    {
                                                        <p>-</p>
                                                    }
                                                </td>
                                                @*Project Code*@
                                                <td class="tableCellStandard">
                                                    @form.ProjectCode
                                                </td>
                                                <td class="tableCellStandard">
                                                    @form.CustomerPO
                                                </td>
                                                <td class="tableCellStandard">
                                                    @form.Customer
                                                </td>
                                                <td class="tableCellStandard">
                                                    @form.ProjectName
                                                </td>
                                                <td class="tableCellStandard">
                                                    @form.ProjectCategory
                                                </td>
                                               @* <td class="tableCellStandard">
                                                    <div class="menu-item">
                                                        <a href="@Url.Action("Edit", "RFQ", new { id = form.RfqId,bomId = form.BomId })" class="link-primary"><b>@form.RfqName</b></a>
                                                    </div>
                                                </td>*@

                                                <td class="tableCellStandard">
                                                    <div class="menu-item">
                                                        <a href="/PurchaseRequisition/Edit/@form.Id" class="link-primary"><b>@form.PrName</b></a>
                                                    </div>
                                                </td>
                                                <td class="tableCellStandard">
                                                    @form.Requestor
                                                </td>

                                                <td class="tableCellStandard">
                                                    @if (form.BomSupportFiles != null && form.BomSupportFiles.Any())
                                                    {
                                                        var sfId = form.BomSupportFiles[0].SupportFileId;
                                                        <a href="#" onclick="openPDF(@sfId)">
                                                            @form.BomSupportFiles[0].SupportFile.FileName
                                                        </a>
                                                    }
                                                </td>
                                                <td class="tableCellStandard">
                                                    @if (form.BomSupportFiles != null && form.BomSupportFiles.Any())
                                                    {
                                                        <p>@form.BomSupportFiles[0].SupportFile.CreatedAt.ToString("yyyy-MM-dd")</p>
                                                    }
                                                </td>
                                                <td class="tableCellStandard"> @form.Remark</td>
                                                <td class="tableCellBorderRight">
                                                    @{
                                                        if (canCrud)
                                                        {
                                                            <a href="#" class="btn btn-sm btn-light btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                                                                Actions
                                                                <span class="svg-icon svg-icon-5 m-0">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="20" viewBox="0 0 24 24" fill="none">
                                                                        <path d="M11.4343 12.7344L7.25 8.55005C6.83579 8.13583 6.16421 8.13584 5.75 8.55005C5.33579 8.96426 5.33579 9.63583 5.75 10.05L11.2929 15.5929C11.6834 15.9835 12.3166 15.9835 12.7071 15.5929L18.25 10.05C18.6642 9.63584 18.6642 8.96426 18.25 8.55005C17.8358 8.13584 17.1642 8.13584 16.75 8.55005L12.5657 12.7344C12.2533 13.0468 11.7467 13.0468 11.4343 12.7344Z" fill="black" />
                                                                    </svg>
                                                                </span>
                                                            </a>

                                                            <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 w-125px py-4" data-kt-menu="true">
                                                                <div class="menu-item px-3">
                                                                    <a href="@Url.Action("Edit",new {id = form.Id})" class="menu-link px-3" target="_blank">Review PO Form</a>
                                                                    <a href="#" class="menu-link px-3" data-bs-toggle="modal" data-bs-target="#modal_edit" onclick="editPO(@form.Id)">Edit</a>
                                                                </div>
                                                                @if (form.BomSupportFiles != null && form.BomSupportFiles.Any())
                                                                {
                                                                    <div class="menu-item px-3">
                                                                        <a data-toggle="tooltip" title="Delete uploaded PO only" href="#" class="menu-link px-3" onclick="RevertPO(@form.Id)">Revert</a>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <a href="#" class="btn" style="background-color: #d9d9d9;color: #a3a3a3;" disabled>
                                                                Actions
                                                                <span class="svg-icon svg-icon-5 m-0">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="20" viewBox="0 0 24 24" fill="none">
                                                                        <path d="M11.4343 12.7344L7.25 8.55005C6.83579 8.13583 6.16421 8.13584 5.75 8.55005C5.33579 8.96426 5.33579 9.63583 5.75 10.05L11.2929 15.5929C11.6834 15.9835 12.3166 15.9835 12.7071 15.5929L18.25 10.05C18.6642 9.63584 18.6642 8.96426 18.25 8.55005C17.8358 8.13584 17.1642 8.13584 16.75 8.55005L12.5657 12.7344C12.2533 13.0468 11.7467 13.0468 11.4343 12.7344Z" fill="black" />
                                                                    </svg>
                                                                </span>
                                                            </a>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <!--end::Table body-->
                            </table>
                            <!--end::Table-->
                        </div>
                    </div>





                </div>  <!--end: tab content-->
                <!--end::Table container-->
            </div>
            <!--begin::Body-->
        </div>
    </div>
</div>


@*Edit PO modal*@
<div class="modal fade" id="modal_edit" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog " style="margin: 2% 0% 0% 5%;">
        <div class="modal-content rounded" style="width: 250%;">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                @*Title*@
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Edit PO</h1>
                </div>
                <input type="hidden" id="hPRId" />
                @*PO*@
                <div class="row my-5 mx-1">
                    <label class="col-1"><b>PO</b></label>
                    <div class="col-5">
                        <div>
                            <input class="col-6" type="file" id="file-po" name="files" accept="application/pdf" />
                            <input type="button" id="btnDelPO" href="#" class="btn btn-outline-danger" style="display:none;" value="X" />
                        </div>
                        <input type="hidden" id="uploadFileType" name="types" value="PO" />
                    </div>
                    <div class="col-6">
                        <b class="mx-2">PR Number:</b> <a id="prNumber" href="#" class="link-primary"></a>
                    </div>
                </div>


                <table id="tblEditPO" class="table table-bordered align-middle gs-0 gy-4">
                    <!--begin::Table head-->
                    <thead>
                        <tr class="fw-bolder fs-6 text-uppercase text-center">
                            <th class="text-center min-w-75px smallThText tableCellBorderLeft tableCellBorderRight"><b>Item Line</b></th>
                            <th class="text-center min-w-75px smallThText tableCellBorderRight"><b>PO Qty</b></th>
                            <th class="text-center min-w-125px smallThText tableCellBorderRight"><b>Unit Price</b></th>
                            <th class="text-center min-w-125px smallThText tableCellBorderRight"><b>Discount</b></th>
                            <th class="text-center min-w-125px smallThText tableCellBorderRight"><b>Tax</b></th>
                            <th class="text-center min-w-125px smallThText tableCellBorderRight"><b>Shipping Cost</b></th>
                            <th class="text-center min-w-125px smallThText tableCellBorderRight"><b>Bank Fee</b></th>
                            <th class="text-center min-w-125px smallThText tableCellBorderRight"><b>Total Price</b></th>
                            <th class="text-center min-w-100px smallThText tableCellBorderRight"><b>ETA</b></th>
                        </tr>
                    </thead>


                    <tbody class="fw-bold text-gray-600 table-bordered" id="tblEditPO-Body">
                    </tbody>

                    <input type="hidden" value="@ViewBag.ProjectId" id="hProjectId" />

                </table>

                @*Remark*@
                <div class="col-8 mt-2 mb-3">
                    <label class="fs-6 fw-bold mb-2"><b>Remark</b></label>
                    <input id="eRemark" class="form-control form-control-lg form-control-solid" name="Remark" type="text" />
                </div>

                <div class="text-center">
                    <button type="button" id="edit_po_submit" class="btn btn-primary">
                        <span class="indicator-label">Submit</span>
                    </button>
                    <button type="button" id="btn-reject" class="btn btn-danger">
                        <span class="indicator-label">Reject</span>
                    </button>
                    <button type="button" id="edit_close" class="btn btn-light me-3">Cancel</button>
                </div>

                <div id="loading-spinner" style="text-align:center;display:none;margin-top:20px;">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="text-active-success">Saving form. Please wait...</p>
                </div>
            </div>
        </div>
    </div>
</div>


@*Reject PO modal*@
<div class="modal fade" id="modal_reject" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                @*Title*@
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Reject PO</h1>
                </div>
                <input type="hidden" id="hPRId" />
                @*Remark*@
                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2">Please state a reason of reject</label>
                    <input id="rejectReason" class="form-control form-control-lg form-control-solid" type="text" />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>

                <input type="hidden" value="@ViewBag.ProjectId" id="hProjectId" />

                <div class="text-center">
                    <button type="button" id="edit_bom_reject" class="btn btn-primary">
                        <span class="indicator-label">Reject</span>
                    </button>

                    <button type="button" id="edit_close" class="btn btn-light me-3">Cancel</button>
                </div>
                <div id="loading-spinner" style="text-align:center;display:none;margin-top:20px;">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="text-active-success">Saving form. Please wait...</p>
                </div>


            </div>
        </div>
    </div>
</div>

@*Export Excel modal*@
<div class="modal fade" id="modal_excel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                @*Title*@
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Export to Excel</h1>
                </div>
                <b>Please enter a date range. Leave blank if wish to export all records.</b>
                <form asp-controller="POTracker" asp-action="ExportToExcel" method="post" enctype="multipart/form-data">
                    @*Date Range*@

                    <div class="d-flex flex-column mb-2 fv-row mt-3">
                        <label class="fs-6 fw-bold mb-2">From: </label>
                        <input class="kt_daterangepicker form-control form-control-lg" id="fromDate" name="fromDate" />

                        <label class="fs-6 fw-bold mb-2">To: </label>
                        <input class="kt_daterangepicker form-control form-control-lg" id="toDate" name="toDate" />
                        <input hidden id="isHistory" name="isHistory" value="true" />
                    </div>

                    <div class="text-center">
                        <button type="submit" id="btn-export-excel" class="btn btn-success">
                            <span class="indicator-label">Export</span>
                        </button>

                        <button type="button" id="export_close" class="btn btn-light me-3">Cancel</button>
                    </div>
                    <div id="loading-spinner-excel" style="text-align:center;display:none;margin-top:20px;">
                        <div class="spinner-border text-info" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                        <p class="text-active-success">Saving form. Please wait...</p>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>



@section scripts{
    <script>
        var minDate, maxDate;

        $.fn.dataTable.ext.search.push(
            function( settings, data, dataIndex ) {
                var min = reContructDateTime(minDate.val());
                var max = reContructDateTime(maxDate.val());
                console.log('aaadata',data)
                var splitDate = data[10].split('-')
                var date = new Date(splitDate[0],splitDate[1],splitDate[2])
                console.log("search date", min, max, date);
 
                if (
                    ( min === null && max === null ) ||
                    ( min === null && date <= max ) ||
                    ( min <= date   && max === null ) ||
                    ( min <= date   && date <= max )
                ) {
                    return true;
                }
                return false;
            }
        );

        $(document).ready(function () {
            minDate = new DateTime($('#startOnDate'), {
                format: 'DD-MM-yyyy'
            });
            maxDate = new DateTime($('#endOnDate'), {
                format: 'DD-MM-yyyy'
            });

            var historyTable = document.getElementById("PoHistoryTable");

            var historyDataTable = $(historyTable).DataTable({
                "info": false,
                "order": []
            });

             $('#startOnDate, #endOnDate').on('change', function () {
                historyDataTable.draw();
                });

            $(".kt_daterangepicker").flatpickr({
                dateFormat: "Y-m-d",
            });

            var filterSearch = document.getElementById("filter_search");
            filterSearch.addEventListener("keyup", function (e) {
                historyDataTable.search(e.target.value).draw();
            });


            $("#edit_po_submit").click(function () {
                $("#edit_po_submit").prop("disabled", true);
                $("#btn-reject").prop("disabled", true);
                $("#edit_close").prop("disabled", true);
                $("#loading-spinner").css("display", "block");

                var data = [];
                var prId = $("#hPRId").val();
                $("#tblEditPO").children("tbody").children("tr").each(function (i) {
                    var $this = $(this);
                    var my_td = $this.children("td");
                    var second_col = my_td.eq(0);
                    var elem = second_col.html();
                    bomId = $(elem).val();



                    data.push({
                        BomId: bomId,
                        POLineNo: $("#ePOLineNo-" + bomId).val(),
                        Quantity: $("#ePOQuantity-" + bomId).val(),
                        UnitPrice: $("#eUnitPrice-" + bomId).val(),
                        Discount: $("#eDiscount-" + bomId).val(),
                        Tax: $("#eTax-" + bomId).val(),
                        ShippingCost: $("#eShippingCost-" + bomId).val(),
                        BankFee: $("#eBankFee-" + bomId).val(),
                        TotalPrice: $("#eTotalPrice-" + bomId).val(),
                        EstDeliveryDate: $("#eEstDeliveryDate-" + bomId).val()
                    });

                }); //end loop


                $.ajax({
                    url: "@Url.Action("EditPO","POTracker")",
                    type: 'POST',
                    data: { data: data,remark: $("#eRemark").val(), prId },
                    success: function (result) {
                        if (result.status == true) {

                            var formData = new FormData();
                            var anyFiles = false;

                            if (document.getElementById("file-po").files.length != 0) {
                                var file2 = $("#file-po").get(0).files;
                                formData.append('files', file2[0]);
                                formData.append('types', "PO");
                                anyFiles = true;
                            }

                            formData.append('prId', prId);

                            if (anyFiles) {
                                $.ajax({
                                    url: "/POTracker/attachFile",
                                    type: "POST",
                                    data: formData,
                                    enctype: 'multipart/form-data',
                                    processData: false,
                                    contentType: false,
                                    cache: false,
                                    success: function (result) {
                                    }
                                });
                            }

                            setInterval(function () {
                                $("#edit_po_submit").prop("disabled", false);
                                $("#btn-reject").prop("disabled", false);
                                $("#edit_close").prop("disabled", false);
                                $("#loading-spinner").css("display", "none");
                                $("#modal_edit").modal("hide");
                                location.reload();
                            }, 2000);
                        }
                        else {
                            alert(result.msg);
                        }
                    }

                });
            });

            $("#edit_bom_reject").click(function (e) {
                e.preventDefault();
                var prId = $("#hPRId").val();
                var remark = $("#rejectReason").val();

                if (prId != null) {
                    Swal.fire({
                        text: "Are you sure want to reject this PO?",
                        icon: "warning",
                        showCancelButton: true,
                        buttonsStyling: false,
                        confirmButtonText: "Yes!",
                        cancelButtonText: "No, return",
                        customClass: {
                            confirmButton: "btn btn-primary",
                            cancelButton: "btn btn-active-light"
                        }
                    }).then(function (result) {
                        if (result.value) {
                            $.ajax({
                                url: '@Url.Action("RejectPO","POTracker")',
                                type: 'POST',
                                data: { prId: prId, remark: remark },
                                success: function (result) {
                                    if (result.status) {
                                        Swal.fire({
                                            text: result.msg,
                                            icon: "success",
                                            showCancelButton: false,
                                            buttonsStyling: false,
                                            confirmButtonText: "Done",
                                            customClass: {
                                                confirmButton: "btn btn-success"
                                            }
                                        }).then(function (result) {
                                            location.reload();
                                        });
                                    }
                                },
                                error: function (result) {
                                    Swal.fire({
                                        text: result.msg,
                                        icon: "error",
                                        showCancelButton: false,
                                        buttonsStyling: false,
                                        confirmButtonText: "OK",
                                        customClass: {
                                            confirmButton: "btn btn-primary"
                                        }
                                    });
                                }
                            });
                        }
                    });
                }//end if
            });

            $("#btn-reject").click(function (e) {
                e.preventDefault();
                $("#modal_edit").modal('toggle');
                $("#modal_reject").modal('toggle');
            });

            $("#file-po").change(function () {
                if ($(this).val() != '') {
                    $("#btnDelPO").css("display", "inline-block");
                }
                else {
                    $("#btnDelPO").css("display", "none");
                }
            });


            $(".eTotalPrice").change(function () {
                $(this).val(parseFloat($(this).val()).toFixed(4));
            });


            $("#btnDelPO").click(function (e) {
                e.preventDefault();
                $("#file-po").val('');
                $(this).css("display", "none");
            });

            $("#export_close").click(function (e) {
                e.preventDefault();
                $("#modal_excel").modal('toggle');
            });
        });

        function reContructDateTime(oriDate){
            if(oriDate === null) return new Date();

            const yyyy = oriDate.getFullYear();
            const mm = oriDate.getMonth() + 1; // Months start at 0!
            const dd = oriDate.getDate();

            return new Date(yyyy,mm,dd)
        }


        function editPO(prId) {
            if (prId != null) {
                $("#hPRId").val(prId);
                $.ajax({
                    url: "/POTracker/GetPO",
                    method: "POST",
                    data: {
                        prId: prId
                    },
                    success: function (response) {
                        $("#prNumber").attr("href", "/PurchaseRequisition/Edit/" + response.prId);
                        $("#prNumber").text(response.prNumber);
                        //table.row("#"+ PrId).remove().draw();
                        //location.reload();

                        $("#tblEditPO-Body").empty();

                        $.each(response.result, function (key, value) {
                            var row = "";
                            var eta = "";

                            if (value.estDeliveryDate != null) {
                                eta = value.estDeliveryDate.toString().split('T', 1)[0]; //remove time
                            }

                            row = "";
                            row += "<tr>";
                            row += '<td><input id="eBomId-' + value.bomId + '" class="form-control  form-control-solid " name="bomId" type="text" value="' + value.bomId + '" readonly/></td>';
                            row += '<td><input id="ePOQuantity-' + value.bomId + '" data-id="' + value.bomId + '" class="form-control  form-control-solid ePOQuantity " name="Quantity" type="number" step="1" placeholder="0"  value="' + value.quantity + '"  onchange=CalculateTotal(' + value.bomId + ') /></td>';

                            row += '<td><div class="d-flex align-items-center flex-row border border-0 bg-light"><span class="">' + value.currency + '</span>';
                            row += '<input id="eUnitPrice-' + value.bomId + '" data-id="' + value.bomId + '" class="form-control form-control-solid eUnitPrice " name="UnitPrice" type="number" step="0.0001" placeholder="0.00" min="0.00" data-type="currency" value="' + value.unitPrice.toFixed(4) + '"  onchange=CalculateTotal(' + value.bomId + ') />';
                            row += '</div></td>';

                            row += '<td><div class="d-flex align-items-center flex-row border border-0 bg-light"><span>' + value.currency + '</span>';
                            row += '<input id="eDiscount-' + value.bomId + '" data-id="' + value.bomId + '" class="form-control form-control-solid eDiscount" name="Discount" type="number" step="0.0001" placeholder="0.00" min="0.00" value="' + value.discount.toFixed(4) + '"  onchange=CalculateTotal(' + value.bomId + ') />';
                            row += '</div></td>';

                            row += '<td><div class="d-flex align-items-center flex-row border border-0 bg-light"><span>' + value.currency + '</span>';
                            row += '<input id="eTax-' + value.bomId + '" data-id="' + value.bomId + '" class="form-control  form-control-solid eTax" name="Tax" type="number" step="0.0001" placeholder="0.00" min="0.0000"value="' + value.tax.toFixed(4) + '" onchange=CalculateTotal(' + value.bomId + ') />';
                            row += '</div></td>';

                            row += '<td><div class="d-flex align-items-center flex-row border border-0 bg-light"><span>' + value.currency + '</span>';
                            row += '<input id="eShippingCost-' + value.bomId + '" data-id="' + value.bomId + '" class="form-control form-control-solid eShippingCost" name="ShippingCost" type="number" step="0.0001" placeholder="0.00" min="0.0000" value="' + value.shippingCost.toFixed(4) + '" onchange=CalculateTotal(' + value.bomId + ') />';
                            row += '</div></td>';

                            row += '<td><div class="d-flex align-items-center flex-row border border-0 bg-light"><span>' + value.currency + '</span>';
                            row += '<input id="eBankFee-' + value.bomId + '" data-id="' + value.bomId + '" class="form-control  form-control-solid eBankFee" name="BankFee" type="number" step="0.0001" placeholder="0.00" min="0.0000" value="' + value.bankFee.toFixed(4) + '" onchange=CalculateTotal(' + value.bomId + ') />';
                            row += '</div></td>';

                            row += '<td><div class="d-flex align-items-center flex-row border border-0 bg-light"><span>' + value.currency + '</span>';
                            row += '<input id="eTotalPrice-' + value.bomId + '" data-id="' + value.bomId + '" class="form-control  form-control-solid eTotalPrice" name="TotalPrice" type="number" step="0.0001" min="0.0000" value="' + value.totalPrice.toFixed(4) + '"/> ';
                            row += '</div></td>';

                            row += '<td><input class=" form-control form-control-solid"  type="date" id="eEstDeliveryDate-' + value.bomId + '" name="EstDeliveryDate" value="' + eta + '"/></td>';
                            row += '</tr>';


                            $("#tblEditPO-Body").append(row);
                            $("#eRemark").val(response.remark);

                        }); //end loop
                    },
                    error: function (response) {
                    }
                });

            }
        }

        function CalculateTotal(bomId) {
            //$(this).val(parseFloat($(this).val()).toFixed(4));

            var poQty = parseFloat($("#ePOQuantity-" + bomId).val());
            var unitPrice = parseFloat($("#eUnitPrice-" + bomId).val());
            var discount = parseFloat($("#eDiscount-" + bomId).val());
            var tax = parseFloat($("#eTax-" + bomId).val());
            var shipFee = parseFloat($("#eShippingCost-" + bomId).val());
            var bankFee = parseFloat($("#eBankFee-" + bomId).val());
            var total = 0;
            var totalPrice = 0;
            var additional = 0;
            var rebate = 0;
            additional = tax + shipFee + bankFee;
            additional = additional - discount;

            total = parseFloat(poQty * unitPrice);
            totalPrice = parseFloat(additional + total);

            $("#eTotalPrice-" + bomId).val(parseFloat(totalPrice).toFixed(4));

        }


        function RevertPO(PrId) {
            $("#hPRId").val(PrId);
            Swal.fire({
                text: "Are you sure to revert? This action will delete uploaded PO and revert item status to PR Approved.",
                icon: "warning",
                showCancelButton: true,
                buttonsStyling: false,
                confirmButtonText: "Revert",
                cancelButtonText: "No",
                customClass: {
                    confirmButton: "btn btn-danger",
                    cancelButton: "btn btn-active-light"
                }
            }).then(function (result) {
                if (result.value) {
                    RevertPOProcess();
                } else if (result.dismiss === "cancel") {
                    Swal.fire({
                        text: "Your action has been cancelled!.",
                        icon: "error",
                        buttonsStyling: false,
                        confirmButtonText: "Ok, got it!",
                        customClass: {
                            confirmButton: "btn btn-primary",
                        }
                    });
                }
            });
        }

        function RevertPOProcess() {
            var PrId = $("#hPRId").val();

            $.ajax({
                url: "/POTracker/RevertPO",
                method: "post",
                data: {
                    prId: PrId
                },
                success: function () {
                    Swal.fire({
                        text: "PO Revert Success.",
                        icon: "success",
                        buttonsStyling: false,
                        confirmButtonText: "Ok",
                        customClass: {
                            confirmButton: "btn btn-primary",
                        }
                    }).then(function (result) {
                        if (result.value) {
                            location.reload();
                        }
                    });
                }
            });
        }

        function openPDF(supportFileId) {
            window.open("/BOM/ShowPDF?supportFileId=" + supportFileId, "_blank");
        }

        $("#edit_close").click(function () {
            $("#modal_edit").modal("hide");
        });
    </script>
