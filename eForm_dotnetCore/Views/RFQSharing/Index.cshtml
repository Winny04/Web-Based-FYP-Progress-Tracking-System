@model eForm_dotnetCore.Controllers.RFQSharingController.RSModel

@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.Common
@using Microsoft.Net.Http.Headers;

@{
    ViewData["Title"] = "Request For Quotation";
    var isFabrication = ViewBag.isFabrication;
    var bomId = ViewBag.bomId;
    var rfqId = ViewBag.rfqId;
}

<div class="card card-xxl-stretch mb-5 mb-xxl-10">
    <div class="card-header d-flex justify-content-between">
        <div class="card-title">
            <h4>@Model.RFQName</h4>
        </div>
        <div class="card-title">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal_import_RFQ_Sharing">
                Import
            </button>
            <a href="@Url.Action("DownloadRFQDrawing",new {id = Model.Id})" @{
                if (isFabrication)
                {
                    @:class="btn btn-info mx-2"
                }
                else
                {
                    @:hidden="true"
                }
            }>
                Download Drawing
            </a>
            <a href="@Url.Action("ExportToExcel",new {id = Model.Id})" class="btn btn-outline-success mx-2">Export To Excel</a>
        </div>
    </div>
    <div class="card-body pb-0">
        <div class="form-horizontal">
            <input type="hidden" name="DataResponse" id="DataResponse" value="" />
            <input type="hidden" name="id" id="rfqId" value="@Model.Id" />

            <div class="card">
                <div class="card-body" style="overflow-x:auto">
                    <div id="render"></div>
                </div>
            </div>

            <div class="form-group pt-3">
                <div class="d-flex flex-row justify-content-end">
                    <button type="button" id="rejectSR" class="btn btn-danger mx-2">Reject</button>
                    <button type="button" id="submitSR" class="btn btn-primary text-end">Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_import_RFQ_Sharing" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">

                <div class="mb-13 text-center">
                    <h1 class="mb-3">Import RFQ List</h1>
                    <div class="text-muted fw-bold fs-5">
                        Please click the link to download the Excel Template.
                        <a href="@Url.Action("DownloadRFQSharingTemplate", "RFQSharing", new { id = Model.Id })" class="fw-bolder link-primary">
                            Download template
                        </a>.
                    </div>
                </div>

                <div class="mt-3 my-5 ml-5">
                    <input type="file" name="postedFile" id="postedFile" accept=".csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" />
                </div>

                <div class="text-center">
                    <button type="button" id="import_modal_close" class="btn btn-light me-3">Cancel</button>
                    <button type="button" id="import_rfq_sharing_submit" class="btn btn-primary">Import</button>
                    <p id="import-validation" class="text-warning" type="text"></p>
                </div>

                <div id="loading-spinner-import" style="text-align:center;display:none;margin-top:20px;">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="text-active-success">Import in progress. Please wait...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Function To Edit Form
        $(document).ready(function() {
            $('#submitSR').click(function () {
                if (!renderer.checkData()) {
                    //Swal.fire("Please complete the required item before submitting the form!");
                    var errorField = [];
                    renderer.everyComponent((component) => {
                        if (component.component.validate.required === true && (component.getValue() === null || component.getValue() === "")) {
                            errorField.push(component.component.label);
                        }
                    });
                    Swal.fire('Please complete the following items:\n' + errorField.toString());

                }
                else {
                    Swal.fire({
                        text: "Are you sure you would like to submit? Once submitted, it can't be edited.",
                        icon: "info",
                        showCancelButton: true,
                        buttonsStyling: false,
                        confirmButtonText: "Yes",
                        cancelButtonText: "No",
                        customClass: {
                            confirmButton: "btn btn-primary",
                            cancelButton: "btn btn-active-light"
                        }
                    }).then(function (result) {
                        if (result.value) {
                            Swal.fire({
                                title: '<div class="spinner-border text-info" role="status"><span class="sr-only">Loading...</span></div>',
                                text: "Please wait...",
                                icon: "success",
                                showCancelButton: false,
                                showConfirmButton: false,
                                buttonsStyling: false,
                            });

                            $.ajax({
                                url: "@Url.Action("SubmitSR")",
                                method: "POST",
                                data:
                                {
                                id: "@Model.Id",
                                dataResponse: $('#DataResponse').val()
                                },
                                success: function (result) {
                                    if (result.autoapprove === true) {
                                        window.location.href = "@Html.Raw(Url.Action("AnonymousEdit", "RFQ", new { id = ViewBag.rfqId, bomId = ViewBag.bomId }))";
                                    } else {
                                        window.location.href = "@Url.Action("Success", "RFQSharing")";
                                    }
                                }
                                // success: function () {
                                //     window.location.href = "@Url.Action("Success", "RFQSharing")";
                                // }
                            });

                        } else if (result.dismiss === 'cancel') {
                            Swal.fire({
                                text: "Your request has been cancelled!.",
                                icon: "error",
                                buttonsStyling: false,
                                confirmButtonText: "Ok, got it!",
                                customClass: {
                                    confirmButton: "btn btn-primary",
                                }
                            });
                        }
                    });
                }
            });

            $('#rejectSR').click(function () {
                Swal.fire({
                    text: "Are you sure you would like to reject? Once rejected, it can't be edited.",
                    icon: "info",
                    showCancelButton: true,
                    buttonsStyling: false,
                    confirmButtonText: "Yes",
                    cancelButtonText: "No",
                    customClass: {
                        confirmButton: "btn btn-primary",
                        cancelButton: "btn btn-active-light"
                    }
                }).then(function (result) {
                    if (result.value) {
                        Swal.fire({
                            title: '<div class="spinner-border text-info" role="status"><span class="sr-only">Loading...</span></div>',
                            text: "Please wait...",
                            icon: "success",
                            showCancelButton: false,
                            showConfirmButton: false,
                            buttonsStyling: false,
                        });

                        $.ajax({
                            url: "@Url.Action("RejectSR")",
                            method: "POST",
                            data:
                            {
                            id: "@Model.Id",
                            dataResponse: $('#DataResponse').val()
                            },
                            success: function () {
                                window.location.href = "@Url.Action("Success", "RFQSharing")"
                            // window.location.href = "@Html.Raw(Url.Action("AnonymousEdit", "RFQ", new { id = ViewBag.rfqId, bomId = ViewBag.bomId }))";
                            }
                        });

                    } else if (result.dismiss === 'cancel') {
                        Swal.fire({
                            text: "Your request has been cancelled!.",
                            icon: "error",
                            buttonsStyling: false,
                            confirmButtonText: "Ok, got it!",
                            customClass: {
                                confirmButton: "btn btn-primary",
                            }
                        });
                    }
                });
            });

            $("#import_rfq_sharing_submit").click(function () {
                $("#import-validation").val("");
                $("import_rfq_sharing_submit").attr("disabled", "disabled");
                $("#import_modal_close").attr("disabled", "disabled");
                $("#loading-spinner-import").css("display", "block");
                var formData = new FormData();
                var postedFile = document.getElementById("postedFile").files[0];
                formData.append("FileUpload", postedFile);
                formData.append("Id", "@Model.Id");

                $.ajax({
                    url: "/RFQSharing/ImportRFQSharing",
                    data: formData,
                    processData: false,
                    contentType: false,
                    type: "POST",
                    success: function (result) {
                        if (result.result) {
                            window.location.href = "/RFQSharing/Index/" + "@Model.Id" + "?bomId=" + @ViewBag.bomId + "&fromImport=true";
                        }
                        else {
                            $("#import-validation").text(result.msg);
                            $("import_rfq_sharing_submit").prop("disabled", false);
                            $("#import_modal_close").prop("disabled", false);
                            $("#loading-spinner-import").css("display", "none");
                        }
                    },
                    error: function (result) {
                        $("#import-validation").text(result.msg);
                        $("#import_rfq_submit").prop("disabled", false);
                        $("#import_modal_close").prop("disabled", false);
                        $("#loading-spinner-import").css("display", "none");
                    }
                });
            });
        });

        const data = @Html.Raw(string.IsNullOrEmpty(Model.Data) ? "{}" : Model.Data);
        const submission = @Html.Raw(string.IsNullOrEmpty(Model.DataResponse) ? "{data:{}}" : Model.DataResponse);
        var stateOptions = {};

        var renderer;
        var state = {
            formioVersion: 'default',
            form: data,
            submission: submission,
            options: stateOptions,
        };

        function initRenderer(form) {
            if (renderer) {
                renderer.destroy();
            }
            Formio.createForm(document.getElementById('render'), form, _.cloneDeep(state.options))
                .then(function (self) {
                    renderer = self;
                    renderer.submission = state.submission;
                    renderer.on('change', function (event, flags) {
                        if (flags && !flags.fromSubmission) {
                            setSubmission(renderer.submission, 'renderer');
                        }
                    });

                    // Event listener for the 'All Unquote' checkbox
                    renderer.everyComponent((component) => {
                        if (component.component.key === 'checkbox') { // Assuming 'checkbox' is the key for the All Unquote button
                            component.on('change', (event) => {
                                const isChecked = component.getValue();
                                applyAllUnquote(isChecked); // Pass true to check all or false to uncheck all
                            });
                        }
                    });
                });
        }



        function setForm(form, from) {
            state.form = form;
        }

        function setSubmission(submission, from) {
            console.log('setSubmission', submission, from);
            if (renderer && from !== 'renderer') {
                renderer.submission = submission;
            }

            document.getElementsByName('DataResponse')[0].value = JSON.stringify(submission);
            //document.getElementsByName('DataResponse')[1].value = JSON.stringify(submission);
        }

        function applyAllUnquote(checked) {
            if (!renderer) return;

            renderer.everyComponent((component) => {
                if (component.component.key === 'Unquote') { // Targeting all 'Unquote' checkboxes
                    component.setValue(checked); // Check or uncheck based on the 'checked' value
                }
            });
        }



        initRenderer(state.form);

    </script>
    }
