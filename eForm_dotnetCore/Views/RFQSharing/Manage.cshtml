@model IEnumerable<RFQSharing>

@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers

@{
    ViewBag.Title = "Manage Sharing RFQ";
    var sourceId = "";

    if (!string.IsNullOrEmpty(Context.Request.Query["sourceId"]))
    {
        sourceId = Context.Request.Query["sourceId"];
    }
    else
    {
        sourceId = Context.Request.RouteValues["sourceId"]?.ToString();
    }
}
<style>
    .tableBorder {
        border-right: 2px solid #D3D3D3;
        color: black;
        font-size: 15px;
        text-align: center;
    }
</style>

<div class="card">
    <h3 style="margin-left:30px; margin-top:20px;">Manage Sharing RFQ</h3>
    <div class="card-header border-0">

        <div class="card-toolbar">
            <div class="d-flex flex-stack flex-wrap gap-4">
                <div class="d-flex align-items-center position-relative my-1">
                    <span class="svg-icon svg-icon-1 position-absolute px-1" style="margin-right:1.5rem !important;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                        </svg>
                    </span>
                    <input type="text" id="filter_search" class="form-control form-control-solid w-250px" placeholder="Search RFQ" style="padding-left:2.8rem !important;" />
                </div>
            </div>
        </div>
        <div class="card-toolbar">
             <div class="d-flex flex-stack flex-wrap gap-2">
                <div class="d-flex align-items-center fw-bolder">
                    <button class="btn btn-primary" onclick="addSupplier()">Additional Supplier</button>
                </div>
                <div class="d-flex align-items-center">
                    <select class="form-control" id="statusFilter">
                        <option value=" " selected>Status</option>
                        <option value="Submitted">Submitted</option>
                        <option value="Processing">Processing</option>
                    </select>
                </div>
            </div>
            
        </div>
    </div>

    <div class="card-body py-0">
        <div class="table-responsive">
            <table id="rsTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted">
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Ori. RFQ</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Sharing. RFQ</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Receiver</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Status</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Submitted Date</b></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var form in Model)
                    {
                        <tr id="@form.Id" class="text-center">
                            <td class="tableCellStandard tableCellBorderLeft">
                                <a href="@Url.Action("Edit","RFQ",new {id = form.Sourcing.RFQId})">@form.Sourcing.RFQ.Rfqname</a>
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                <a href="@Url.Action("Index","RFQSharing",new {id = form.Id})">Sharing RFQ</a>
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Supplier.VendorName
                            </td>
                             <td class="tableCellStandard tableCellBorderLeft">
                                @if (form.SubmittedDate.HasValue)
                                {
                                    <div class="badge badge-light-success badge-status">Submitted</div>
                                }
                                else
                                {
                                    <div class="badge badge-light-warning badge-status">Processing</div>
                                }
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.SubmittedDate?.ToString("d")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_addSupplier" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Add Supplier</h1>
                </div>

                <div id="selectSupplierForm"></div>
            </div>
        </div>
    </div>
</div>

<script>
    let dataTable;
    var requestModal;
    $(document).ready(function () {
        var modal1 = document.getElementById("modal_addSupplier");
        requestModal = new bootstrap.Modal(modal1);

        var table = document.getElementById("rsTable")
        dataTable = $(table).DataTable({
            "info": false,
            "order": []
        });

        var filterSearch = document.getElementById("filter_search");
        filterSearch.addEventListener("keyup", function (e) {
            dataTable.search(e.target.value).draw();
        });

        $("#statusFilter").change(function (e) {
            if(e.target.value === " "){
                dataTable.columns(2).search("", true, false).draw();
            }
            else
            {
                var regex = '\\b' + e.target.value + '\\b';
                dataTable.columns(2).search(regex, true, false).draw();
            }
        });
    })

    function addSupplier(){
        $.ajax({
            url: '@Url.Action("AddSupplier","RFQSharing")',
            data: { id: "@sourceId" },
            type: 'get',
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                $("#selectSupplierForm").html(response);
                requestModal.show();
            }
        });
    }

</script>

