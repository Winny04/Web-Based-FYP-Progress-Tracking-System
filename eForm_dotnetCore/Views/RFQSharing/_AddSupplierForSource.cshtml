@model eForm_dotnetCore.Controllers.RFQSharingController.AddSourceSupplierModel

<form asp-controller="RFQSharing" asp-action="AddSupplier" method="post">
    <div class="d-flex flex-row justify-content-between">
        <label class="d-flex align-items-center fs-6 fw-bold mb-2">
            <span class="required">Additional Supplier:</span>
        </label>

        <select class="form-select form-select-solid" data-kt-select2="true" data-placeholder="Select option" name="supplierId">
            @foreach(var s in Model.Suppliers)
            {
                <option value="@s.Id">@s.VendorName</option>
            }
        </select>
    </div>

    <input hidden name="id" value="@Model.SourceId" />
    <div class="text-center">
        <button type="submit" class="btn btn-primary mt-2">Submit</button>
    </div>
</form>