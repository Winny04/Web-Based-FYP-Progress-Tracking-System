                <form asp-controller="BOM" asp-action="attachFile" method="post" enctype="multipart/form-data">
                    <div class="mt-3 my-5 ml-5">
                        <input type="file" name="files" accept="application/pdf" multiple />
                    </div>
                    <input type="hidden" id="uploadFile_bomId" name="bomId" />
                    <input type="hidden" id="uploadFileType" name="types" />

                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Upload</button>
