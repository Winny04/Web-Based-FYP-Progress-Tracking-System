            var oldSelected = $("#picsContainer").val();
            var newSelected = "";
            if (isChecked) {
                newSelected = oldSelected + "," + userId;
                newSelected = newSelected.replace(/^,/, '');
                $("#picsContainer").val(newSelected);
                $('#leaderList').html('');
                $('#leaderList').append($('<option>', {
