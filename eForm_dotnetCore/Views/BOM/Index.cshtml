            function viewPOFile(projectId) {
            fetch(`/Project/ViewPOFile?projectId=${projectId}`)
                .then(response => {
                    if (response.headers.get('Content-Type').includes('application/json')) {
                        return response.json();
                    } else {
                        return response.blob(); //return the Blob (PDF file)
                    }
                })
                .then(data => {
                    if (data instanceof Blob) {
                        // Open the PDF file in a new tab
                        const fileURL = URL.createObjectURL(data);
                        window.open(fileURL, '_blank');
                    } else if (data && !data.success) {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error fetching PO file:', error);
                    alert('An error occurred while trying to fetch the PO file.');
                });
        }

