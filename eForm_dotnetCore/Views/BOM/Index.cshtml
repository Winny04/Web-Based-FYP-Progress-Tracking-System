        // ========== COPY BOM FUNCTIONALITY ==========
        
        // Load projects when modal opens
        $('#modal_copy_BOM').on('show.bs.modal', function () {
            loadSourceProjects();
        });

        // Load available projects
        var allProjects = []; // Store all projects for filtering
        
        function loadSourceProjects() {
            $.ajax({
                url: '@Url.Action("GetProjects", "BOM")',
                type: 'GET',
                success: function (data) {
                    allProjects = data || [];
                    displayProjects(allProjects);
                },
                error: function () {
                    alert('Failed to load projects');
                }
            });
        }

        function displayProjects(projects) {
            var select = $('#sourceProjectSelect');
            select.empty();
            select.append('<option value="">-- Select a project from the list --</option>');
            
            if (projects && projects.length > 0) {
                projects.forEach(function (project) {
                    // Don't show current project
                    if (project.id != @ViewBag.ProjectId) {
                        select.append(`<option value="${project.id}">${project.code} - ${project.name}</option>`);
                    }
                });
            }
        }

        // Project search filter
        $('#projectSearchInput').on('keyup', function () {
            var searchText = $(this).val().toLowerCase();
            var filteredProjects = allProjects.filter(function (project) {
                var projectText = (project.code + ' ' + project.name).toLowerCase();
                return projectText.indexOf(searchText) !== -1;
            });
            displayProjects(filteredProjects);
        });

        // When source project is selected, load its BOM items
        $('#sourceProjectSelect').on('change', function () {
            var projectId = $(this).val();
            if (projectId) {
                loadBOMItems(projectId);
            } else {
                $('#bomItemsContainer').hide();
                $('#btnCopyBOMSubmit').prop('disabled', true);
            }
        });

        // Load BOM items from selected project
        function loadBOMItems(projectId) {
            $.ajax({
                url: '@Url.Action("GetBOMsByProject", "BOM")',
                type: 'GET',
                data: { projectId: projectId },
                success: function (data) {
                    var tbody = $('#bomItemsList');
                    tbody.empty();
                    
                    if (data && data.length > 0) {
                        data.forEach(function (bom) {
                            var row = `
                                <tr>
                                    <td>
                                        <div class="form-check form-check-sm form-check-custom form-check-solid">
                                            <input class="form-check-input bom-checkbox" type="checkbox" value="${bom.id}" data-bom='${JSON.stringify(bom)}' />
                                        </div>
                                    </td>
                                    <td>${bom.bomNo || ''}</td>
                                    <td>${bom.partDesc || ''}</td>
                                    <td>${bom.partNumber || ''}</td>
                                    <td><span class="badge badge-light-${getStatusColor(bom.status)}">${bom.status}</span></td>
                                </tr>
                            `;
                            tbody.append(row);
                        });
                        
                        $('#bomItemsContainer').show();
                        updateCopyButton();
                    } else {
                        tbody.append('<tr><td colspan="5" class="text-center text-muted">No BOM items found in this project</td></tr>');
                        $('#bomItemsContainer').show();
                        $('#btnCopyBOMSubmit').prop('disabled', true);
                    }
                },
                error: function () {
                    alert('Failed to load BOM items');
                }
            });
        }

        // Select/deselect all checkboxes
        $('#selectAllBoms').on('change', function () {
            $('.bom-checkbox').prop('checked', $(this).prop('checked'));
            updateCopyButton();
        });

        // Update copy button state when checkboxes change
        $(document).on('change', '.bom-checkbox', function () {
            updateCopyButton();
        });

        function updateCopyButton() {
            var checkedCount = $('.bom-checkbox:checked').length;
            $('#btnCopyBOMSubmit').prop('disabled', checkedCount === 0);
        }

        function getStatusColor(status) {
            if (!status) return 'secondary';
            if (status.includes('Approved')) return 'success';
            if (status.includes('Reject')) return 'danger';
            if (status.includes('Sent') || status.includes('Updated')) return 'info';
            if (status === 'New') return 'warning';
            return 'primary';
        }

        // Submit copy request
        $('#btnCopyBOMSubmit').on('click', function () {
            var selectedBoms = [];
            $('.bom-checkbox:checked').each(function () {
                selectedBoms.push($(this).val());
            });

            if (selectedBoms.length === 0) {
                alert('Please select at least one BOM item to copy');
                return;
            }

            var sourceProjectId = $('#sourceProjectSelect').val();
            var targetProjectId = @ViewBag.ProjectId;

            // Show loading state
            var btn = $(this);
            btn.find('.indicator-label').hide();
            btn.find('.indicator-progress').show();
            btn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("CopyBOMToProject", "BOM")',
                type: 'POST',
                data: {
                    sourceProjectId: sourceProjectId,
                    targetProjectId: targetProjectId,
                    bomIds: selectedBoms.join(',')
                },
                success: function (response) {
                    if (response.success) {
                        // Close modal first
                        $('#modal_copy_BOM').modal('hide');
                        
                        // Show success popup
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.message,
                            confirmButtonText: 'OK'
                        }).then(function() {
                            location.reload();
                        });
                    } else {
                        // Build error list
                        var errorList = '';
                        if (response.errors && response.errors.length > 0) {
                            errorList = '<ul style="text-align: left;">';
                            response.errors.forEach(function (error) {
                                errorList += `<li>${error.message}</li>`;
                            });
                            errorList += '</ul>';
                        } else {
                            errorList = response.message || 'Failed to copy BOM items';
                        }
                        
                        // Show error popup
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            html: errorList,
                            confirmButtonText: 'OK'
                        });
                        
                        // Reset button
                        btn.find('.indicator-label').show();
                        btn.find('.indicator-progress').hide();
                        btn.prop('disabled', false);
                    }
                },
                error: function (xhr) {
                    var errorMsg = 'An error occurred while copying BOM items';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    
                    // Show error popup
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: errorMsg,
                        confirmButtonText: 'OK'
                    });
                    
                    // Reset button
                    btn.find('.indicator-label').show();
                    btn.find('.indicator-progress').hide();
                    btn.prop('disabled', false);
                }
            });
        });

        // BOM Items Search Filter
        $('#bomSearchInput').on('keyup', function () {
            var searchText = $(this).val().toLowerCase();
            $('#bomItemsList tr').each(function () {
                var rowText = $(this).text().toLowerCase();
                if (rowText.indexOf(searchText) === -1) {
                    $(this).hide();
                } else {
                    $(this).show();
                }
            });
        });

        // Reset modal when closed
        $('#modal_copy_BOM').on('hidden.bs.modal', function () {
            $('#sourceProjectSelect').val('').trigger('change');
            $('#bomItemsList').empty();
            $('#bomItemsContainer').hide();
            $('#copy-bom-message').empty();
            $('#selectAllBoms').prop('checked', false);
            $('#btnCopyBOMSubmit').prop('disabled', true);
            $('#btnCopyBOMSubmit').find('.indicator-label').show();
            $('#btnCopyBOMSubmit').find('.indicator-progress').hide();
            $('#bomSearchInput').val('');
            $('#projectSearchInput').val('');
        });


    </script>
