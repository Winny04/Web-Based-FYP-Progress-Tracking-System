        function setEditForm(formId) {
            var projectId = $("#hProjectId").val();
            var id = formId;
            $("#selectedFormId").val(id);
            $("#eModule").val("");
            $("#ePartNumber").val("");
            $("#eBrand").val("");
            $("#eFBBrand").val("");
            $("#ePartDesc").val("");
            $("#eItemCategory").val("");
            $("#eUnitQty").val("");
            $("#eRequireQty").val("");

            $.ajax({
                url: "/BOM/Edit",
                data: { id: id, projectId: projectId },
                success: function (result) {
                    if (result != null) {
                        $("#eModule").val(result.data.module);
                        //$("#eProductName").val(result.data.productName);
                        $("#ePartNumber").val(result.data.partNumber);
                        $("#ePartDesc").val(result.data.partDesc);
                        $("#eItemCategory").val(result.data.itemCategory).change();
                        if (result.data.itemCategory == "Fabrication") {
                            $("#eFBBrand").val(result.data.brand).change();
                        }
                        else {
                            $("#eBrand").val(result.data.brand);
                        }
                        $("#eUnitQty").val(result.data.unitQty);
                        $("#eRequireQty").val(result.data.requireQty);
                        document.getElementById("eUnitQty").disabled = result.block;

                        if (result.data.bomSupportFiles != null) {
                            var search = result.data.bomSupportFiles.filter(x => x.type === "QUO");
                            if (search.length > 0) {
                                var target = search[0];
                                //var po = target.supportFile.fileName.split(/ - |_-_/)[0];
                                var opening = "<div class='d-flex justify-content-between'>"
                                var link = `<a href='/BOM/downloadFile/${target.id}'>${target.supportFile.fileName}</a><a href="#" class="text-danger">x</a>`;
                                var closing = "</div>";
                                document.getElementById('itemFile2Container').insertAdjacentHTML("afterbegin", opening + link + closing);
                                document.getElementById('itemFile2Container').style.display = "block";
                            }
                        }
                        $("#modal_edit").modal("show");
                    }
                    else {
                        alert(result.msg);
                    }
                }
            });
        }
