        function createRFQ(projectId, bomId) {
            var selected = getSelectRowIds();

            // MULTIPLE RFQs
            if (selected.length > 0) {

                Swal.fire({
                    title: 'Create Multiple RFQs?',
                    text: `This will create ${selected.length} RFQ(s). Continue?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Create',
                    cancelButtonText: 'Cancel',
                    buttonsStyling: false,
                    customClass: {
                        confirmButton: "btn btn-primary",
                        cancelButton: "btn btn-secondary"
                    }
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    Swal.fire({
                        title: 'Creating RFQs...',
                        html: `Processing <b>0</b> of <b>${selected.length}</b> item(s)`,
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    processSequentialRFQs(projectId, selected);
                });

                return; // Stop here
            }

            // SINGLE RFQ (original behaviour)
            $.ajax({
                        url: "@Url.Action("addNewRFQ", "BOM")",
                method: "post",
                data: { projectId, bomId },
                success: function (res) {
                    if (res.result) {
                        window.location.href = "/RFQ/Edit/" + res.id + "?bomId=" + bomId;
                    } else {
                        alert(res.msg);
                    }
                }
            });
        }

