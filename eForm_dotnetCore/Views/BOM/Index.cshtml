@using System.Collections
@using eForm_dotnetCore.ViewModel
@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using Microsoft.EntityFrameworkCore;
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using eForm_dotnetCore.Configuration.Auhtorization;
@using eForm_dotnetCore.Models;

@model BOMOverviewViewModel

@{
    ViewData["Title"] = PageTitle.BOM + " " + Model.Project.Code;
    var itemCategories = EnumHelpers.ToSelectList<BomItemCategory>();
    var fabricationBrandList = EnumHelpers.ToSelectList<FabricationBrand>();
    var PICS = ViewBag.PICs != ""
              ? ViewBag.PICs
              : string.Empty;
    var PICIds = ViewBag.PICIds != ""
              ? ViewBag.PICIds
              : string.Empty;
    var PICSList = PICS.Split(",");
    string PICLeaderID = ViewBag.PICLeaderId;
    string PICLeaderName = ViewBag.PICLeader;
    var rand = CommonHelpers.RandomString(10);

    var isProjectCompleted = Model.Project.Status == "Completed" ? true : false;
    var canAdd = CommonHelpers.isPics(Model.Project) || Context.GetUserType().Equals("HOD", StringComparison.OrdinalIgnoreCase);
    var ableViewActualMCost = CommonHelpers.isPics(Model.Project)
                              || Context.GetUserType().Equals("Buyer", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("CEO", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("GFC", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("HOD", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("PM", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("Quality", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("Sales", StringComparison.OrdinalIgnoreCase);

    var ableViewDrawing = CommonHelpers.isPics(Model.Project) || Context.GetUserType().Equals("Buyer", StringComparison.OrdinalIgnoreCase)
                   || Context.GetUserType().Equals("PM", StringComparison.OrdinalIgnoreCase)
                   || Context.GetUserType().Equals("HOD", StringComparison.OrdinalIgnoreCase);
    EformSophicDemoContext context = new EformSophicDemoContext();
    var employeeInfoList = context.EmployeeInfos
    .Include(x => x.EmpDepartment).Select(x => new { x.ShortName, x.Id, x.EmpDepartment.Name }).ToList();
    Dictionary<string, string> color = new Dictionary<string, string>();
    Dictionary<string, string> prColor = new Dictionary<string, string>();
    string[] colorList = { "ff0000", "72aafe", "d38d4a" };
    var counter = 0;
    var prCounter = 0;
}

<style>
    span.prefix {
        background-color: #afafaf;
        color: #fff8f8;
        line-height: 10px;
        height: 30px;
        padding: 10px;
        border: 1px #888 solid;
        font-size: 9pt;
    }

    .dataTables_wrapper .dt-buttons .buttons-colvis {
        background-color: #007bff;
        border-color: #007bff;
        color: #fff;
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        margin: 10px;
    }

        .dataTables_wrapper .dt-buttons .buttons-colvis:hover {
            background-color: #0069d9;
            border-color: #0062cc;
            color: #fff;
        }
</style>

<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxxl">
    <div class="content flex-row-fluid" id="kt_content">
        <div class="card card-flush mb-xl-1">
            <div class="card-header pt-3 row">
                <div class="col col-3">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bolder fs-2 mb-1 font-weight-bold">BILL OF MATERIAL (BOM)</span>
                    </h3>
                </div>
                <div class="col col-8 pt-3">
                    <label class="fs-6 fw-bold mr-2">Doc No:</label> <b>@BomHeaderAttribute.DocumentNo</b>
                    <label class="fs-6 fw-bold ml-5 mr-2">Rev No:</label> <b>@BomHeaderAttribute.RevisionNo</b>
                    <label class="fs-6 fw-bold ml-5 mr-2">Eff Date:</label> <b>@BomHeaderAttribute.EffectiveDate</b>

                    <!-- View QF Button -->
                    <a href="javascript:void(0);"
                       class="btn btn-primary ml-3"
                       onclick="viewQFFile(@Model.Project.Id)">View QF</a>

                </div>
                <div class="row mt-1">
                    <div class="col-3">
                        <label for="Code" class="fs-6 fw-bold mb-2">Project Code:</label>
                        <input type="text" id="pCode" class="form-control form-control-solid text-black font-weight-bold" name="Code" value="@Model.Project.Code" readonly>
                    </div>
                    <div class="col-5">
                        <label for="Name" class="fs-6 fw-bold mb-2">Project Name:</label>
                        <input type="text" id="pName" class="form-control form-control-solid text-black font-weight-bold" name="Name" value="@Model.Project.Name" readonly>
                    </div>

                    @if (ableViewActualMCost)
                    {
                        <div class="col-4 d-flex">
                            <div class="col-5">
                                <label for="Name" class="fs-6 fw-bold mb-2">Actual Material Cost:</label>
                                <div class="d-flex align-items-center flex-row">
                                    <span @{
                                          if (Model.Project.GetTotalActualCost() > Model.Project.BudgetMaterialCost)
                                          {
                                              @:class="border-danger prefix"
                                          }
                                          else
                                          {
                                              @:class="prefix"
                                          }
                                      }
>RM </span>
                                <input type="text" id="pActualMCost" name="ActualMaterialCost" value="@Math.Round(Model.Project.GetTotalActualCost(), 4)" readonly
                                       @{
                                           if (Model.Project.ActualMaterialCost > Model.Project.BudgetMaterialCost)
                                           {
                                               @:class="border-danger form-control form-control-solid text-black font-weight-bold"
                                           }
                                           else
                                           {
                                               @:class="form-control form-control-solid text-black font-weight-bold"
                                           }
                                       }
>
                            </div>
                            @if (Model.Project.ActualMaterialCost > Model.Project.BudgetMaterialCost)
                            {
                                <span class="text-muted fs-5">&#9888; Actual Cost is been exceed Budget Cost</span>
                            }
                        </div>
                        <div class="col-5">
                            <label for="ExtraCost" class="fs-6 fw-bold mb-2">Extra Cost:</label>
                            <div class="d-flex align-items-center flex-row">
                                <span class="prefix">RM </span>
                                <a @{
                                   if (!isProjectCompleted && (@Context.GetUserType() == "PM" || @Context.GetUserType() == "SuperAdminAssistant" || @Context.GetUserType() == "SuperAdmin" || Context.GetUserId() == ViewBag.PICLeaderId || UserTypes.CLevels.Contains(@Context.GetUserType())))
                                   {
                                       @:class="text-decoration-none"
                                       @:data-bs-toggle="modal"
                                       @:data-bs-target="#modal_edit_extraCost"
                                   }
                                   else
                                   {
                                       @:hidden="hidden"
                                   }
                                                                      }
>
                                    <input type="text" class="form-control form-control-solid text-black font-weight-bold" value="@Model.Project.ExtraCost" readonly>
                                </a>
                            </div>
                        </div>
                    </div>
                                        }
                </div>
            </div>
            <div class="collapse hide" id="bomHeader">
                <div class="px-5 pt-4">
                    <div class="row mb-6">
                        <div class="col-3">
                            <label for="Code" class="fs-6 fw-bold mb-2">Create Date:</label> <b>@Model.Project.CreatedDate.ToString("yyyy-MM-dd h:mm tt")</b>
                            @*<input type="text" id="CreatedDate" class="form-control form-control-solid text-black font-weight-bold" name="CreatedDate" value="@Model.Project.CreatedDate.ToString("yyyy-MM-dd h:mm tt")" readonly>*@
                        </div>
                        <div class="col-6"></div>
                        <div class="col-3 text-end">
                            <label for="Code" class="fs-6 fw-bold mb-2">Update Date:</label> <b>@Model.Project.LastUpdatedDate.ToString("yyyy-MM-dd h:mm tt")</b>
                            @*<input type="text" id="LastUpdatedDate" class="form-control form-control-solid text-black font-weight-bold" name="LastUpdatedDate" value="@Model.Project.LastUpdatedDate.ToString("yyyy-MM-dd h:mm tt")" readonly>*@
                        </div>

                    </div>
                    <div class="row mb-6">
                        <div class="col-3">
                            <label for="PoNumber" class="fs-6 fw-bold mb-2">PO Number:</label>
                        <input type="text" id="pPoNumber" class="form-control form-control-solid text-black font-weight-bold" name="PoNumber" value="@Model.Project.PoNumber" readonly>
                        </div>
                        <div class="col-3">
                            <label for="Requestor" class="fs-6 fw-bold mb-2">Customer:</label>
                            <input type="text" id="pRequestor" class="form-control  form-control-solid text-black font-weight-bold" name="Requestor" value="@Model.Project.Customer" readonly>
                        </div>

                        <div class="col-3">
                            <label for="Code" class="fs-6 fw-bold mb-2">Project Category:</label>
                            <input type="text" id="pCategory" class="form-control form-control-solid text-black font-weight-bold" name="Code" value="@ViewBag.ProjectCategory" readonly>
                        </div>
                        <div class="col-3">
                            <label for="Requestor" class="fs-6 fw-bold mb-2">Project Quantity:</label>
                            <input type="text" id="pPOQty" class="form-control  form-control-solid text-black font-weight-bold" name="POQty" value="@Model.Project.PoQuantity" readonly>
                        </div>
                    </div>
                    <div class="row mb-6">
                        <div class="col-4">
                            <label for="PoNumber" class="fs-6 fw-bold mb-2">Budget Material Cost:</label>
                            <div class="d-flex align-items-center flex-row">
                                <span class="prefix">RM </span>
                                <input type="text" id="pPOQty" class="form-control  form-control-solid text-black font-weight-bold" name="POQty" value="@Model.Project.BudgetMaterialCost" readonly>
                            </div>
                        </div>

                        <div class="col-8">
                            <label for="PICS" class="fs-6 fw-bold mb-2">Build by:</label>
                            <a @{
                                                              if (!isProjectCompleted && (@Context.GetUserType() == "PM" || @Context.GetUserType() == "SuperAdminAssistant" || @Context.GetUserType() == "SuperAdmin" || Context.GetUserId() == ViewBag.PICLeaderId || UserTypes.CLevels.Contains(@Context.GetUserType())))
                               {
                                   @:class="text-decoration-none"
                                   @:data-bs-toggle="modal"
                                   @:data-bs-target="#modal_edit_pics"
                               }
                               else
                               {
                                   @:disabled="disabled"
                               }
                                                              }
>
                                <input type="text" id="pics" class="form-control form-control-solid text-black font-weight-bold" value="@ViewBag.PICs" readonly>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
            <div class="d-flex justify-content-center">

                <button id="btn-colp-header" type="button" class="btn btn-link pb-2" data-toggle="collapse" data-target="#bomHeader">
                    Show More
                </button>
            </div>
        </div>
        <div class="card card-flush">
            <div class="card-header">
                <div class="card-toolbar ">
                    <div class="d-flex flex-stack flex-wrap gap-2">
                        <div class="d-flex align-items-center fw-bolder">
                            <!--begin::Select-->
                            <select class="form-control" id="categoryFilter">
                                <option value=" " selected>Category</option>
                                @foreach (var item in itemCategories)
                                {
                                    var shortName = EnumHelpers.ToSelectList<BomItemCategoryShortName>().Where(x => x.Id == item.Id).Select(x => x.Text).FirstOrDefault();
                                    <option value="@item.Text">@item.Text Part (@shortName)</option>
                                }
                            </select>
                        </div>
                        <div class="d-flex align-items-center fw-bolder">
                            <select class="form-control" id="statusFilter">
                                <option value=" " selected>Status</option>
                                <option value="New">New</option>
                                <option value="RFQ Sent">RFQ Sent</option>
                                <option value="RFQ Updated">RFQ Updated</option>
                                <option value="RFQ Approved">RFQ Approved</option>
                                <option value="RFQ Reject">RFQ Reject</option>
                                <option value="PR Sent">PR Sent</option>
                                <option value="PR Approved">PR Approved</option>
                                <option value="PR Reject">PR Reject</option>
                                <option value="PO Approved">PO Approved</option>
                                <option value="PO Revise">PO Revise</option>
                                <option value="PO Reject">PO Reject</option>
                                <option value="ETA Updated">ETA Updated</option>
                                <option value="Partial Received">Partial Received</option>
                                <option value="Item Received">Item Received</option>
                                <option value="Item Issued Out">Item Issued Out</option>
                                <option value="Completed">Completed</option>
                            </select>
                            <!--end::Select-->
                        </div>
                        <div class="d-flex align-items-center position-relative my-1">
                            <!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <!--end::Svg Icon-->
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search Form" />
                        </div>
                    </div>
                </div>
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap" style="gap: 2px;">
                        <button type="button" onclick="mergeForm('@FormType.RFQ')"
                                @{
                                    if (isProjectCompleted || !canAdd)
                                    {
                                        @:class="btn btn-sm btn-secondary smallButtonText disabled"
                                        @:disabled="disabled"
                                    }
                                    else
                                    {
                                        @:class="btn btn-sm btn-primary"
                                    }
                                }
>
                            Merge RFQ
                        </button>
                        <button type="button" onclick="mergeForm('@FormType.PR')"
                                @{
                                    if (isProjectCompleted || !canAdd)
                                    {
                                        @:class="btn btn-sm btn-secondary smallButtonText disabled"
                                        @:disabled="disabled"
                                    }
                                    else
                                    {
                                        @:class="btn btn-sm btn-primary"
                                    }
                                }
>
                            Merge PR
                        </button>
                        <button type="button" id="btnDeleteMore" class="btn btn-sm btn-danger smallButtonText" disabled>
                            Delete
                        </button>
                        <a href="#" id="btnImportBOM"
                           @{
                               if (isProjectCompleted || !canAdd)
                               {
                                   @:class="btn btn-sm btn-secondary smallButtonText disabled"
                                   @:disabled="disabled"
                               }
                               else
                               {
                                   @:class="btn btn-sm btn-primary smallButtonText"
                                   @:data-bs-toggle="modal"
                                   @:data-bs-target="#modal_import_BOM"
                               }
                           }
>
                            <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                            <span class="svg-icon svg-icon-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="black" />
                                    <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="black" />
                                </svg>
                            </span>
                            <!--end::Svg Icon-->Import BOM
                        </a>
                        <a href="#" id="btnMassUploadDrawings"
                           @{
                               if (isProjectCompleted || !canAdd)
                               {
                                   @:class="btn btn-sm btn-secondary smallButtonText disabled"
                                   @:disabled="disabled"
                               }
                               else
                               {
                                   @:class="btn btn-sm btn-primary smallButtonText"
                                   @:data-bs-toggle="modal"
                                   @:data-bs-target="#modal_mass_upload"
                               }
                           }
>
                            <span class="svg-icon svg-icon-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 2v20M2 12h20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                </svg>
                            </span>Mass Upload Drawings
                        </a>
                        <a href="#" id="btnCopyBOM"
                           @{
                               if (isProjectCompleted || !canAdd)
                               {
                                   @:class="btn btn-sm btn-secondary smallButtonText disabled"
                                   @:disabled="disabled"
                               }
                               else
                               {
                                   @:class="btn btn-sm btn-success smallButtonText"
                                   @:data-bs-toggle="modal"
                                   @:data-bs-target="#modal_copy_BOM"
                               }
                           }
>
                            <span class="svg-icon svg-icon-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="7" y="2" width="14" height="16" rx="3" fill="black"/>
                                    <rect x="3" y="6" width="14" height="16" rx="3" fill="black"/>
                                </svg>
                            </span>
                            Copy BOM
                        </a>
                        <a href="#" id="btnNewBom"
                           @{
                               if (isProjectCompleted || !canAdd)
                               {
                                   @:class="btn btn-sm btn-secondary smallButtonText disabled"
                                   @:disabled="disabled"
                               }
                               else
                               {
                                   @:class="btn btn-sm btn-primary smallButtonText"
                                   @:data-bs-toggle="modal"
                                   @:data-bs-target="#modal_new"
                               }
                           }
>
                            <span class="svg-icon svg-icon-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="black" />
                                    <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="black" />
                                </svg>
                            </span>
                            Add Item
                        </a>
                        <a href="#" id="btnUpdateETA"
                           @{
                               if (isProjectCompleted || !canAdd)
                               {
                                   @:class="btn btn-sm btn-secondary smallButtonText disabled"
                                   @:disabled="disabled"
                               }
                               else
                               {
                                   @:class="btn btn-sm btn-primary smallButtonText"
                                   @:data-bs-toggle="modal"
                                   @:data-bs-target="#modal_update_BOM"
                               }
                           }
>
                            <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                            <span class="svg-icon svg-icon-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="black" />
                                    <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="black" />
                                </svg>
                            </span>
                            <!--end::Svg Icon-->Update ETA
                        </a>
                        <a href="@Url.Action("ExportToExcel", new { id = ViewBag.ProjectId })" class="btn btn-outline-success smallButtonText">Excel</a>
                        <a href="@Url.Action("ExportToExcel_ByCategory", new { id = ViewBag.ProjectId })" class="btn btn-outline-success smallButtonText">Excel By Category</a>
                        <button class="btn btn-sm btn-outline-warning fw-bold fs-sm-7 smallButtonText">
                            PR Approved
                            <span>@Model.PRApprovedRate %</span>
                        </button>
                        <button class="btn btn-sm btn-outline-info fw-bold fs-sm-7 smallButtonText">
                            PO Approved
                            <span>@Model.POApprovedRate %</span>
                        </button>
                    </div>
                </div>

            </div>
            <div class="d-flex m-2">
                <p id="selectRowLabel"><span id="numRowSelected"></span> items selected</p>
            </div>
        </div>
        <table id="formListTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4" style="background-color:white;">
            <!--begin::Table head-->
            <thead>
                <tr class="font-weight-bold text-center">
                    <th class="min-w-25px pl-2"></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>ITEM NO</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Status</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Cat.</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Module</b></th>
                    <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Description</b></th>
                    <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Brand</b></th>
                    <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Part No.</b></th>
                    <th class="mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Unit Qty</b></th>
                    <th class="mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Total Qty</b></th>
                    <th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>RFQ</b></th>
                    <th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>PR</b></th>
                    <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Supplier</b></th>
                    <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Vendor Quot.</b></th>
                    <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>PO</b></th>
                    <th class="min-w-50px mw-50" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>PO Qty</b></th>
                    <th class="min-w-50px mw-50" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Unit Price(RM)</b></th>
                    <th class="min-w-50px mw-50" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Total Price(RM)</b></th>
                    <th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>ETA</b></th>
                    <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Recv. Date</b></th>
                    <th class="min-w-100px mw-100" style="color:black;font-size:11px;"><b>Action</b></th>
                </tr>
            </thead>
        </table>

    </div>
</div>

@*Add New BOM modal*@
<div class="modal fade" id="modal_new" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
