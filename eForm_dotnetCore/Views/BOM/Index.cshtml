        $("#massUploadForm").submit(function (e) {
            e.preventDefault();
            
            var formData = new FormData();
            var files = document.getElementById("massFiles").files;
            
            if (files.length === 0) {
                Swal.fire("Warning", "Please select at least one PDF file.", "warning");
                return;
            }

            for (var i = 0; i < files.length; i++) {
                formData.append("massFiles", files[i]);
            }
            formData.append("projectId", $("#massUploadProjectId").val());

            var submitBtn = $("#btnMassUploadSubmit");
            submitBtn.prop("disabled", true);
            submitBtn.find(".indicator-label").hide();
            submitBtn.find(".indicator-progress").show();

            $.ajax({
                url: "/BOM/MassAttachDrawings",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    submitBtn.prop("disabled", false);
                    submitBtn.find(".indicator-label").show();
                    submitBtn.find(".indicator-progress").hide();
                    
                    if (res.success) {
                        var msg = "Successfully matched and attached " + res.successCount + " drawings.<br/>";
                        if (res.errorFiles && res.errorFiles.length > 0) {
                            msg += "<br/><b>Failed to match the following files:</b><br/>" + res.errorFiles.join("<br/>");
                            Swal.fire({
                                icon: 'warning',
                                title: 'Mass Upload Complete',
                                html: msg,
                                confirmButtonText: 'OK'
                            }).then((result) => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: 'All ' + res.successCount + ' drawings updated perfectly!',
                                confirmButtonText: 'OK'
                            }).then((result) => {
                                window.location.reload();
                            });
                        }
                    } else {
                        Swal.fire("Error", res.msg || "Something went wrong during mass upload.", "error");
                    }
                },
                error: function (err) {
                    submitBtn.prop("disabled", false);
                    submitBtn.find(".indicator-label").show();
                    submitBtn.find(".indicator-progress").hide();
                    Swal.fire("Error", "An unexpected error occurred: " + err.statusText, "error");
                }
            });
        });



