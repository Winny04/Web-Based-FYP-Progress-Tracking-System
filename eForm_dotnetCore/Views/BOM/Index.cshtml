@section scripts {
    <script>
        var colorList = ["ff0000", "72aafe", "d38d4a"];
        const listStatus = [
            "New",
            "RFQ Sent",
            "RFQ Updated",
            "RFQ Reject",
            "RFQ Approved",
            "PR Sent",
            "PR Reject",
            "PR Approved",
            "PO Revise",
            "PO Reject",
            "PO Approved",
            "ETA Updated",
            "Partial Received",
            "Item Received",
            "Item Issued Out",
            "Completed"
        ];
        var counter = 0;
        var prCounter = 0;
        var rfqColors = []

        var picLeaderConst = "";
        $(document).ready(function () {
            $("#selectRowLabel").hide();

            var table = document.getElementById("formListTable");
            $("#attachFileItem").hide();
            $("#validateFBBrand").hide();
            $('#FBBrandDropdown').hide();
            $('#eFBBrandDropdown').hide();
            $("#partNoContainer").hide();
            picLeaderConst = $("#leaderList").val();
            var dataTable = $(table).DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                searchDelay: 500,
                pageLength: 5,
                "pagingType": "full_numbers",
                "rowCallback": function (row, data) {
                    //console.log('row call back',data)
                    $(row).attr('id',   data.id);
                    $(row).css('max-height','30px')
                    $(row).css('color', 'black')
                    $(row).css('font-size', '11px')
                    $(row).css('border-right', '2px solid #D3D3D3')
                    $(row).addClass('text-center text-break');
                },
                dom: 'Bfrtipl',
                buttons: [
                    'colvis'
                ],
                lengthMenu: [[5, 10, 15, 20, 25, -1], [5, 10, 15, 20, 25, "All"]],
                select: {
                    style: "os",
                    selector: "td:first-child"
                },
                "ajax": {
                    "url": "@Url.Action("LoadData")",
                    "type": "POST",
                    "data":function(d){
                        d.Status = $("#statusFilter").val();
                        d.Category = $("#categoryFilter").val();
                        d.ProjectId = '@Model.ProjectId'
                    }
                },
                columnDefs: [
                    {
                        targets: 0,
                        render: function (data, type, row) {
                            let checkboxEle = `
                                        <div class="form-check form-check-sm form-check-custom form-check-solid">
                                            <input class="form-check-input checkSingle" id="checkBox" type="checkbox" value="${row.id}" data-kt-check="true" data-kt-check-target=".widget-9-check" />
                                        </div>
                            `
                            return checkboxEle;
                        }
                    },
                    {
                        targets: 1,
                        render: function (data, type, row) {
                            return row.id;
                        }
                    },
                    {
                        targets: 2,
                        render: function (data, type, row) {
                            let statusDiv = ''
                            let lastUpdatedLabel = ''
                            let approverDiv = ''

                            if (row.status === "New" || row.status === "PR Sent" || row.status === "Item Issued Out" ) {
                                statusDiv = `<div class="badge badge-light-primary badge-status">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Sent" || row.status === "PR Approved" || row.status === "PO Revise") {
                                statusDiv = `<div class="badge badge-light-warning badge-status">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Updated" || row.status === "PO Approved" || row.status === "ETA Updated" || row.status === "Partial Received") {
                                statusDiv = `<div class="badge badge-light-info">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Approved" || row.status === "Item Received" || row.status === "Completed") {
                                statusDiv = `<div class="badge badge-light-success">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Reject" || row.status === "PR Reject" || row.status === "Receiving Reject" || row.status === "PO Reject" || row.status === "PO Cancelled") {
                                statusDiv = `<div class="badge badge-light-danger badge-status">${row.status}</div>`
                            }

                            let convertDateTime = moment(row.lastUpdatedDate).format('DD MMM YYYY HH:mm')
                            lastUpdatedLabel = `
                                     <span class="fs-8 fw-light lh-sm d-block">
                                        <span style="font-size:11px;font-family: sans-serif;">${convertDateTime}</span>
                                    </span>`

                            if (row.totalApprover > 0 && row.Status == "PR Sent")
                            {
                                const labelBg = ['bg-light-success', 'bg-light-warning']
                                const labelText = ['Approved', 'Pending']
                                approverDiv += '<div>';
                                let approverClass =''
                                if (row.prApprovers.some(x => x.type === "HOD" && x.approved))
                                {
                                    approverDiv += `<p style="font-size=12px" class=${labelBg[0]}>HOD ${labelText[0]}</p>`
                                }
                                else
                                {
                                    approverDiv += `<p style="font-size=12px" class=${labelBg[1]}>HOD ${labelText[1]}</p>`
                                }

                                if(row.totalApprover > 1)
                                {
                                    if (row.prApprovers.some(x => x.type === "GFC" && x.approved)) {
                                        approverDiv += `<p style="font-size=12px" class=${labelBg[0]}>GFC ${labelText[0]}</p>`
                                    }
                                    else{
                                        approverDiv += `<p style="font-size=12px" class=${labelBg[0]}>GFC ${labelText[0]}</p>`
                                    }
                                }
                                if (row.totalApprover > 2) {
                                    if (row.prApprovers.some(x => x.type === "CEO" && x.approved)) {
                                        approverDiv += `<p style="font-size=12px" class=${labelBg[0]}>CEO ${labelText[0]}</p>`
                                    }
                                    else {
                                        approverDiv += `<p style="font-size=12px" class=${labelBg[0]}>CEO ${labelText[0]}</p>`
                                    }
                                }
                            }

                            approverDiv += '</div>'

                            return statusDiv + lastUpdatedLabel + approverDiv
                        }
                    },
                    {
                        targets: 3,
                        render: function (data, type, row) {
                            return row.itemCategory;
                        }
                    },
                    {
                        targets: 4,
                        render: function (data, type, row) {
                            return row.module;
                        }
                    },
                    {
                        targets: 5,
                        render: function (data, type, row) {
                            return `
                                <div style="color:black;font-size:11px; word-wrap: break-word;">
                                    ${row.partDesc}
                                </div>
                            `
                        }
                    },
                    {
                        targets: 6,
                        render: function (data, type, row) {
                            return row.brand
                        }
                    },
                    {
                        targets: 7,
                        render: function (data, type, row) {
                            let partNoEle = ''
                            if (row.itemCategory === "Fabrication") {
                                if (row.bomSupportFiles != null && row.bomSupportFiles.some(x => x.type === "IC") && '@ableViewDrawing' === 'True') {
                                    const bfs = row.bomSupportFiles.filter(x => x.type === "IC");
                                    const imageTypes = [".png",".jpeg",".jpg"]
                                    bfs.forEach(sf =>{
                                        var sfId = sf.supportFileId
                                        var po = sf.supportFile.fileName.split(/ - |_-_/)[0];
                                        //console.log("IC",sf.supportFile.fileName, po)
                                        var previewEndPoint = imageTypes.includes(bfs[0].supportFile.contentType) ? "PreviewImage" : "ShowPDF";
                                        if(previewEndPoint === "PreviewImage"){
                                            partNoEle += ` <a href="/BOM/${previewEndPoint}?id=${sfId}" target="_blank">${sf.supportFile.fileName}</a>`
                                        }
                                        else{
                                            partNoEle += `<a href="/BOM/${previewEndPoint}?supportFileId=${sfId}" target="_blank">${sf.supportFile.fileName}</a>`
                                        }
                                        const removeBtn = `<a href="/BOM/removeFile/${sfId}?projectId=@Model.ProjectId" class="mx-2 text-danger">X</a>`
                                        partNoEle += removeBtn
                                    })
                                }
                                else
                                {
                                    const disabled = "@isProjectCompleted" === "True" || "@canAdd" === "False"
                                    const btnClass = disabled ? 'btn-secondary' : 'btn-primary'

                                    if(disabled){
                                        partNoEle += `
                                            <button id="uploadPart" class="btn ${btnClass}" disabled>
                                                Upload
                                            </button>
                                        `
                                    }
                                    else{
                                        partNoEle += `
                                                <button id="uploadPart" class="btn ${btnClass}" onclick="openUploadFileModal(${row.id},'IC')">
                                                    Upload
                                                </button>
                                            `
                                    }
                                }
                            }
                            else
                            {
                                partNoEle += row.partNumber
                            }

                            return partNoEle
                        }
                    },
                    {
                        targets: 8,
                        render: function (data, type, row) {
                            return row.unitQty
                        }
                    },
                    {
                        targets: 9,
                        render: function (data, type, row) {
                            return row.requireQty
                        }
                    },
                    {
                        targets: 10,
                        render: function (data, type, row) {
                            let rfqEle = ''

                            if(row.rfq === null)
                            {
                                const disabled = "@isProjectCompleted" === "True" || "@canAdd" === "False"
                                const btnClass = disabled ? 'btn-secondary' : 'btn-primary'

                                if(disabled){
                                    rfqEle += `<button
                                                class="btn btn-sm ${btnClass}"
                                                disabled
                                                >Create RFQ</button>`
                                }
                                else{
                                    rfqEle += `<button type="button"
                                        class="btn btn-sm ${btnClass}"
                                                onclick="createRFQ('@Model.ProjectId',${row.id})">Create RFQ</button>`
                                }
                            }
                            else
                            {
                                let colorStr = colorList[counter]
                                if (rfqColors.length > 0 && rfqColors.some(x => x.name === row.rfqName))
                                {
                                    colorStr = rfqColors.find(x => x.name === row.rfqName).color;
                                }
                                else
                                {
                                    rfqColors.push({
                                        name:row.rfqName,
                                        color:colorStr
                                    })
                                    counter +=1;
                                    if(counter === 5){
                                        counter = 0
                                    }
                                }

                                rfqEle +=
                                `
                                    <a href="/RFQ/Edit/${row.rfqId}?bomId=${row.id}" class="link-success" style="color:#${colorStr}"><b>${row.rfqName}</b></a>
                                `
                            }

                            return rfqEle
                        }
                    },
                    {
                        targets: 11,
                        render: function (data, type, row) {
                            let prEle = ''

                            if (row.pr === null) {
                                if ("@isProjectCompleted" === "True" || "@canAdd" === "False"){
                                    prEle += `<button
                                                type="button"
                                                class="btn btn-sm secondary"
                                                disabled
                                                >Create PR</button>`
                                }
                                else if (row.status !== "RFQ Approved" && row.status !== "PO Reject" && row.status !== "ETA Updated") {
                                    prEle += `<button
                                            type="button"
                                            class="btn btn-sm btn-secondary"
                                            disabled
                                            >Create PR</button>`
                                }
                                else
                                {
                                    prEle += `<button
                                            type="button"
                                            class="btn btn-sm btn-primary"
                                            onclick="createPR('@Model.ProjectId',${row.id})"
                                            >Create PR</button>`
                                }
                            }
                            else {
                                let colorStr = colorList[prCounter]
                                if (rfqColors.length > 0 && rfqColors.some(x => x.name === row.rfqName)) {
                                    colorStr = rfqColors.find(x => x.name === row.rfqName).color;
                                }
                                else {
                                    rfqColors.push({
                                        name: row.prName,
                                        color: colorStr
                                    })
                                    prCounter += 1;
                                    if (prCounter === 5) {
                                        prCounter = 0
                                    }
                                }

                                prEle +=`<a
                                        href="/PurchaseRequisition/Edit/${row.prId}"
                                        class="link-success"
                                style="color:#${colorStr}"><b>${row.prName}</b></a>
                                        `
                            }

                            return prEle
                        }
                    },
                    {
                        targets: 12,
                        render: function (data, type, row) {
                            return row.supplierName
                        }
                    },
                    {
                        targets: 13,
                        render: function (data, type, row) {
                            if(row.quotName === ""){
                                return ""
                            }

                            return ` <a href="${row.quotUrl}" target="_blank">
                                            ${row.quotName}
                            </a>`
                        }
                    },
                    {
                        targets: 14,
                        render: function (data, type, row) {
                            let poEle = ''
                            if (row.bomSupportFiles != null && row.bomSupportFiles.some(x => x.type === "PO")) {
                                const bfs = row.bomSupportFiles.filter(x => x.type === "PO");
                                bfs.forEach(sf => {
                                    var po = sf.supportFile.fileName.split(/ - |_-_/)[0];
                                    console.log("PO",sf.supportFile.fileName,po)
                                    var sfId = sf.supportFileId
                                    poEle += `<a href="/BOM/ShowPDF?supportFileId=${sfId}" target="_blank">${po}</a>`
                                })
                            }

                            return poEle
                        }
                    },
                    {
                        targets: 15,
                        render: function (data, type, row) {
                            if(row.prQuantity === -1){
                                return ""
                            }

                            return row.prQuantity
                        }
                    },
                    {
                        targets: 16,
                        render: function (data, type, row) {
                            if(row.prUnitPrice === -1){
                                return ""
                            }

                            return row.prUnitPrice
                        }
                    },
                    {
                        targets: 17,
                        render: function (data, type, row) {
                            if (row.prTotalPrice === -1) {
                                return ""
                            }

                            return row.prTotalPrice
                        }
                    },
                    {
                        targets: 18,
                        render: function (data, type, row) {
                            if (row.eta === null) {
                                return ""
                            }

                            const convertDateStr = moment(row.eta).format('DD MMMM YYYY')

                            return convertDateStr
                        }
                    },
                    {
                        targets: 19,
                        render: function (data, type, row) {
                            if (row.receivedDate === null) {
                                return ""
                            }

                            const convertDateStr = moment(row.receivedDate).format('DD MMMM YYYY')

                            return convertDateStr
                        }
                    },
                    {
                        targets: 20,
                        render: function (data, type, row) {
                            let actionEle = `
                            <div class="d-flex gap-2 align-items-center">`

                            if ("@isProjectCompleted" === "False" && "@canAdd" === "True") {
                                actionEle += ` <button type="button" class="btn btn-sm btn-primary" onclick="setEditForm(${row.id})">Edit</button>`
                                if ((row.status == "PO Approved" || row.status == "ETA Updated") && ("@Context.GetUserType()" === "PM" || "@Context.GetUserType()" === "SuperAdminAssistant"|| "@Context.GetUserType()" === "SuperAdmin" || "@Context.GetUserType()" === "Purchaser"))
                                {
                                    actionEle += `<a href="/POTracker/POHistory/${row.id}" class="btn btn-sm btn-info">Reject PO</a>`
                                }

                                if(!availableBaseStatus("PR Approved",row.status)){
                                    actionEle += ` <button type="button" class="btn btn-sm btn-danger" onclick="deleteForm(${row.id})">Delete</a>`
                                }
                            }

                            actionEle += "</div>"

                            return actionEle
                        }
                    },
                ],
                "order": [],
            });

            dataTable.on('select deselect', function (e, dt, type, indexes) {
                CheckCanDelete()
            });

            dataTable.on('processing.dt', function (e, settings, processing) {
                //console.log('is process', processing)
                if (processing) {
                    Swal.showLoading()
                } else {
                    Swal.close();
                }
            });

            var picDataTable = $(picTable).DataTable({
                "info": false,
                "processing": false,
