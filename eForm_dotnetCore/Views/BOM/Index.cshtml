                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Create New BOM</h1>
                    <div class="text-muted fw-bold fs-5">
                        If you need more info, please check
                        <a href="#" class="fw-bolder link-primary">Project Guidelines</a>.
                    </div>
                </div>

                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Module</label>
                    <input id="Module" class="form-control form-control-lg form-control-solid" name="Module" type="text" required />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>

                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Description</label>
                    <input id="PartDesc" class="form-control form-control-lg form-control-solid" name="PartDesc" type="text" required />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>

                <div id="FBBrandString" class="mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Brand</label>
                    <input id="Brand" class="form-control form-control-lg form-control-solid" name="Brand" type="text" required />
                </div>

                <div id="FBBrandDropdown" class="mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Brand</label>
                    <select id="FBBrand" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="Select a Brand" name="Brand" required>
                        <option value="">Select brand...</option>
                        @foreach (var i in fabricationBrandList)
                        {
                            var brandName = EnumHelpers.ToSelectList<FabricationBrand>().Where(x => x.Id == i.Id).Select(x => x.Text).FirstOrDefault();
                            <option value="@i.Text.Replace('_', ' ')">@brandName.Replace('_', ' ')</option>
                        }
                    </select>
                </div>

                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Item Category</label>
                    <select id="ItemCategory" class="form-select form-select-solid" data-control="select2" data-hide-search="true" data-placeholder="Select a Category" name="ItemCategory" required>
                        <option value="">Select category...</option>
                        @foreach (var i in itemCategories)
                        {
                            var shortName = EnumHelpers.ToSelectList<BomItemCategoryShortName>().Where(x => x.Id == i.Id).Select(x => x.Text).FirstOrDefault();
                            <option value="@i.Text">@i.Text Part (@shortName)</option>

                        }
                    </select>
                </div>

                <div class="mb-2 fv-row" id="attachFileItem">
                    <label class="fs-6 fw-bold mb-2 required">Part No</label>
                    <table>
                        <tr>
                            <td>
                                <input type="file" style="width:500px;" class="form-control" id="itemFile" accept="application/pdf" required multiple />
                            </td>
                            <td>
                                <button type="button" style="border:none;background:none;" onclick="resetPartNO()">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" style="">
                                        <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                                        <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    </table>

                </div>
                <div class="mb-2 fv-row" id="partNoContainer">
                    <label class="fs-6 fw-bold mb-2 required">Part No</label>
                    <input id="PartNumber" class="form-control form-control-lg required form-control-solid" name="PartNumber" type="text" required />
                </div>
                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Unit Qty</label>
                    <input id="UnitQty" class="form-control form-control-lg form-control-solid" name="UnitQty" onchange="upTotalQty(this.value,'RequireQty')" type="number" value="0" />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>
                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Total Qty</label>
                    <input id="RequireQty" class="form-control form-control-lg form-control-solid" name="RequireQty" type="number" value=@Model.Project.PoQuantity />
                    <p id="name-existed-validation" class="text-danger" type="text"></p>
                </div>

                <input type="hidden" value="@ViewBag.ProjectId" id="hProjectId" />
                <input type="hidden" id="hCheckedId" />
                <div class="text-center">
                    <button type="button" id="new_request_close" class="btn btn-light me-3">Cancel</button>
                    <button type="button" id="kt_modal_new_target_submit" class="btn btn-primary">
                        <span class="indicator-label">Submit</span>
                    </button>
                </div>
                <div id="loading-spinner" style="text-align:center;display:none;margin-top:20px;">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="text-active-success">Creating new form. Please wait...</p>
                </div>
            </div>
        </div>
    </div>
</div>

