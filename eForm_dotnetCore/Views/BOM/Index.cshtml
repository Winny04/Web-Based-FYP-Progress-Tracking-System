        function getSelectRowIds() {
            var selected = []
            var dtTable = $("#formListTable").DataTable();
            var selectedRow = dtTable.rows({ selected: true }).data();

            console.log('selectedrow', selectedRow)

            var mapRowIds = selectedRow.map(x => x.id);

            for (var i = 0; i < mapRowIds.length; i++) {
                selected.push(mapRowIds[i])
                var ssss = dtTable.row("#" + mapRowIds[i]).node();
                $(ssss).find('td input:checkbox').prop("checked", true);
            }

            var rowsDeselected = dtTable.rows({ selected: false }).nodes();
            dtTable.rows(rowsDeselected).every(function () {
                $(this.node()).find('td input:checkbox').prop("checked", false);
            });
            return selected;
        }

        function mergeForm(type) {
            var selected = getSelectRowIds();


            if (selected.length < 1) {
                alert('Please select at least two bom items before merge')
                return;
            }

            $.ajax({
                type: 'POST',
                url: `/BOM/mergeBOM`,
                data: { select: selected.toString(), projectId: @ViewBag.ProjectId, type },
                cache: false,
                success: function (result) {
                    if (result.result) {
                        if (result.redirectId) {
                            if (type === 'RFQ') {
                                window.location.href = `/RFQ/Edit/${result.redirectId}?bomId=${selected.toString()}`;
                            } else if (type === 'PR') {
                                window.location.href = `/PurchaseRequisition/Edit/${result.redirectId}`;
                            } else {
                                location.reload();
                            }
                        } else {
                            location.reload();
                        }
                    }
                    else {
                        Swal.fire({
                            text: result.msg,
                            icon: "error",
                            buttonsStyling: false,
                            confirmButtonText: "Ok, got it!",
                            customClass: {
                                confirmButton: "btn btn-primary",
                            }
                        });
                    }
                },
                error: function (result) {
                    console.log("error: " + result.msg);
                    console.log("error 2 : " + result.str);
                }
            });
        }

