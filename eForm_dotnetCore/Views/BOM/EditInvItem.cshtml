@model BomInventory
@{
    ViewBag.Title = "Edit Inventory Item";
}

<div class="d-flex justify-content-center flex-column-fluid">
    <div class="card">
        <div class="card-header">
            <h3 style="margin-left:30px; margin-top:20px;" class="mb-2">Edit Inventory Item</h3>
        </div>
        <div class="card-body py-2">
            <form asp-controller="BOM" asp-action="AddOrUpdateBomInv" method="post">
                <div class="row mb-6">
                    <label class="col-4 col-form-label required fw-bold fs-6">Description: </label>
                    <textarea name="description" class="col-8" required>@Model.Description</textarea>
                </div>

                <div class="row mb-6">
                    <label class="col-4 col-form-label required fw-bold fs-6">Supplier: </label>
                    <input type="text" class="form-control col-8" name="supplier" placeholder="Supplier" required value="@Model.Supplier" />
                </div>

                <div class="row mb-6">
                    <label class="col-4 col-form-label required fw-bold fs-6">Currency:</label>
                    <input type="text" class="form-control col-8" name="currency" placeholder="Currency" required value="@Model.Currency" />
                </div>

                <div class="row mb-6">
                    <label class="col-4 col-form-label required fw-bold fs-6">Brand: </label>
                    <input type="text" class="form-control col-8" name="brand" placeholder="Brand" required value="@Model.Brand" />
                </div>

                <div class="row mb-6">
                    <label class="col-4 col-form-label required fw-bold fs-6">Module: </label>
                    <input type="text" class="form-control col-8" name="module" placeholder="Module" required value="@Model.Module" />
                </div>

                <div class="row mb-2">
                    <label class="col-4 col-form-label required fw-bold fs-6">Unit Price: </label>
                    <input type="number" class="form-control col-8" name="unitPrice" placeholder="Unit Price" step="0.01" value="@Model.UnitPrice" required />
                </div>

                <input type="hidden" value="@Model.Id" name="id"/>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mb-2">Save</button>
                </div>
            </form>
        </div>
        <div class="card-footer">
            <a href='@Url.Action("Inventory","BOM")' class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>
