@{
    @model SupportFile
}

<style>
    .image-container{
        display: flex;
        position: relative;
        justify-content: center;
        align-items: center;
        width: 100%;
        cursor:pointer;
    }
    .image-container .download-button{
        visibility: hidden;
    }
    .image-container:hover .download-button{
        visibility: visible;
    }
    .download-button{
        position: absolute;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.36);
        width: 100%;
        height: 100%;
        z-index: 2;
    }
    img{
        width: auto;
        max-width:-webkit-fill-available;
        height:auto;
        z-index: 1;
    }
    .download-icon-size {
        height: 5.25rem !important;
        width: 5.25rem !important;
    }
    
</style>

<div class="image-container mt-8">
    <div class="download-button" onclick="downloadImage('@Model.FileName')">
        <span class="download-icon-size">
            <i class="fa fa-download" style="font-size: 6rem !important;color:black"></i>
        </span>
    </div>
    <img src="/documents/@Model.FileName" class="detailImage" />
</div>

<script>
function downloadImage(fileName) {
    var a = document.createElement('a');
    a.href = "/documents/"+fileName;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
}
</script>