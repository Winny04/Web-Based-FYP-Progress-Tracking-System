@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@model IEnumerable<eForm_dotnetCore.Models.SupplierVM>

@{
    ViewBag.Title = "Manage Supplier";
}
<style>
    .tableBorder {
        border-right: 2px solid #D3D3D3;
        color: black;
        font-size: 15px;
        text-align: center;
    }
</style>

<div class="card">
    <h3 style="margin-left:30px; margin-top:20px;">Manage Supplier</h3>
    <div class="card-header border-0">

        <div class="card-toolbar">
            <div class="d-flex flex-stack flex-wrap gap-4">
                <div class="d-flex align-items-center position-relative my-1">
                    <span class="svg-icon svg-icon-1 position-absolute px-1" style="margin-right:1.5rem !important;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                        </svg>
                    </span>
                    <input type="text" id="filter_search" class="form-control form-control-solid w-250px" placeholder="Search supplier" style="padding-left:2.8rem !important;" />
                </div>
            </div>
        </div>
       
        <div class="card-toolbar">
            <div class="d-flex align-items-center py-3 py-md-1">
                <button data-bs-toggle="modal" data-bs-target="#modal_create" class="btn btn-primary mr-2">Add</button>
            </div>
        </div>
    </div>

    <div class="card-body py-0">
        @* <label>@Html.ValidationMessageFor(model => model.EmplooyeeInfoID, "", new { @class = "text-danger" })</label>*@
        <div class="table-responsive">
            <table id="supplierTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted">
                        <th class="min-w-200px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Code</b></th>
                        <th class="min-w-200px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Vendor Name</b></th>
                        <th class="min-w-200px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Phone Number</b></th>
                        <th class="min-w-200px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Fax Number</b></th>
                        <th class="min-w-200px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Email</b></th>
                        <th class="min-w-200px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>WebSite</b></th>
                        <th class="min-w-200px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Terms</b></th>
                        <th class="min-w-200px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Currency</b></th>
                        <th hidden>Completed</th>
                        <th class="min-w-200px" style="color:black;font-size:15px;"><b>Action</b></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var form in Model)
                    {
                         <tr id="@form.Id" class="text-center">
                             <td class="tableCellStandard tableCellBorderLeft">
                                 @form.registrationCode
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.companyName
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.telephoneNumber
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.faxNumber
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.emailAddress
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.websiteAddress
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.creditTerms
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.accountCurrency
                            </td>
                            <td hidden>
                                @form.Completed
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                <a href="#" class="btn btn-sm btn-light btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">Actions</a>

                                <div class="menu menu-sub menu-sub-dropdown menu-row menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 py-4" data-kt-menu="true">
                                    <div class="menu-item px-3">
                                        <button onclick="redirectToEdit('@form.Id')" class="menu-link px-3">View</button>
                                    </div>
                                     <div class="menu-item px-3">
                                        <a class="btn btn-secondary menu-link px-3" href="@Url.Action("SupportFiles","SupplierInfo",new {id = form.Id})">Attachment</a>
                                    </div>
                                    <div class="menu-item px-3">
                                        <button class="menu-link px-3" onclick="deleteSupplier('@form.Id')">Delete</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@*Import BOM Modal*@
<div class="modal fade" id="modal_import" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Import</h1>
                </div>


                <form asp-controller="SupplierInfo" asp-action="ImportData" method="post" enctype="multipart/form-data">
                    <div class="mt-3 my-5 ml-5">
                        <input type="file" name="file" id="postedFile" accept=".csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" />
                    </div>

                   <button type="submit" class="btn btn-primary">Import</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_create" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Add New Vendor</h1>
                </div>

                <div class="d-flex flex-column mb-2 fv-row">
                    <label class="fs-6 fw-bold mb-2 required">Vendor Name</label>
                    <input type="text" id="supplierName" class="form-control" placeholder="Please provide a vendor name" required />
                </div>

                <div class="d-flex justify-content-end">
                    <button onclick="addSupplier()" class="btn btn-primary">Add</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        var table = document.getElementById("supplierTable")
        //var filterCompleted = document.getElementById('filterBaseCompleted');
         var dataTable = $(table).DataTable({
            "info": false,
            "order": []
        });

        var filterSearch = document.getElementById("filter_search");
        filterSearch.addEventListener("keyup", function(e) {
            console.log('e',e.target.value)
            dataTable.search(e.target.value).draw();
        });

        //$("#filterBaseCompleted").change(function (e) {
        //    dataTable.columns(8).search(e.target.value).draw();
        //});
        
    })

    function addSupplier(){
        Swal.showLoading()

        if ($("#supplierName").val() === undefined && $("#supplierName").val().trim().length < 1){
            alert("Please provide a valid vendor name")
        }
        else{
            $.post('@Url.Action("AddSupplier","SupplierInfo")', { supplierName: $("#supplierName").val() },function(e){
                if(e.result){
                    window.location.href = "/SupplierInfo/Edit/"+e.vendorId;
                    //location.reload();
                }
                else{
                    Swal.fire(e.msg);
                }
            })
        }
    }

    function deleteSupplier(itemId){
        Swal.fire({
            text: "Are you sure delete this supplier?",
            icon: "warning",
            showCancelButton: true,
            buttonsStyling: false,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "No, return",
            customClass: {
                confirmButton: "btn btn-primary",
                cancelButton: "btn btn-active-light"
            }
        }).then(function (result) {
            if (result.value) {
                $.ajax({
                    url: "@Url.Action("DeleteSupplier","SupplierInfo")",
                    method: "POST",
                    data: {
                        id: itemId
                    },
                    success: function () {
                        dataTable.row("#" + itemId).remove().draw();
                    }
                });

            } else if (result.dismiss === "cancel") {
                Swal.fire({
                    text: "Your request has been cancelled!.",
                    icon: "error",
                    buttonsStyling: false,
                    confirmButtonText: "Ok, got it!",
                    customClass: {
                        confirmButton: "btn btn-primary",
                    }
                });
            }
        });
    }

    function redirectToEdit(id){
        window.location.href = "/SupplierInfo/Edit/"+id;
    }
    
</script>

