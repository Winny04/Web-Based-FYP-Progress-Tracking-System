                        <h1 class="mb-3">Create New Project</h1>
                        <div class="text-muted fw-bold fs-5">
                            If you need more info, please check
                            <a href="#" class="fw-bolder link-primary">Project Guidelines</a>.
                        </div>
                    </div>

                    @*Code*@
                    @*<div class="d-flex flex-column mb-8 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                        <span>Code</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="Enter Project Code" name="Code" readonly />
                        </div>*@
                    @*Customer*@
                    <div class="d-flex flex-column mb-8 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                            <span class="required">Customer</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="Enter Customer" id="newCustomer" name="Customer" required />
                    </div>
                    @*Quotation Number*@
                    <div class="d-flex flex-column mb-8 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                            <span>Quotation</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="Enter Quotation Number" name="QuotationNo" />
                    </div>
                    @*PO Number*@
                    <div class="d-flex flex-column mb-8 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                            <span>Project PO</span>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="Enter Customer PO Number" name="poNumber" />
                    </div>
                    @*Project Name*@
                    <div class="d-flex flex-column mb-8 fv-row">
                        <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                            <span class="required">Project Name</span>
                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title="Specify a project name for future usage and reference"></i>
                        </label>
                        <input type="text" class="form-control form-control-solid" placeholder="Enter Project Name" id="newProjectName" name="name" required />
                    </div>
                    @*Project Category*@
                    <div class="d-flex flex-column mb-8 fv-row">
                        <label class="required fs-6 fw-bold mb-2">Project Category</label>
