            function archiveProject(projectId) {
                Swal.fire({
                    text: "Are you sure you want to archive this project?",
                    icon: "warning",
                    showCancelButton: true,
                    buttonsStyling: false,
                    confirmButtonText: "Yes, archive it!",
                    cancelButtonText: "No, return",
                    customClass: {
                        confirmButton: "btn btn-primary",
                        cancelButton: "btn btn-active-light"
                    }
                }).then(function (result) {
                    if (result.value) {
                        var table = $('#projectListTable').DataTable();
                        $.ajax({
                            url: "@Url.Action("ArchiveProject", "Project")",
                            method: 'POST',
                            data: {
                                id: projectId
                            },
                            success: function () {
                                Swal.fire({
                                    text: "Project archived successfully.",
                                    icon: "success",
                                    confirmButtonText: "OK",
                                    buttonsStyling: false,
                                    customClass: {
                                        confirmButton: "btn btn-primary",
                                    }
                                }).then(function () {
                                    location.reload();
                                });
                            },
                            error: function () {
                                Swal.fire({
                                    text: "Failed to archive the project.",
                                    icon: "error",
                                    confirmButtonText: "OK",
                                    buttonsStyling: false,
                                    customClass: {
                                        confirmButton: "btn btn-primary",
                                    }
                                });
                            }
                        });
                    } else if (result.dismiss === 'cancel') {
                        Swal.fire({
                            text: "Project archive cancelled.",
                            icon: "info",
                            confirmButtonText: "Ok, got it!",
                            buttonsStyling: false,
                            customClass: {
                                confirmButton: "btn btn-primary",
                            }
                        });
                    }
                });
            }

