            function exportBomSubmit(){
                Swal.showLoading();
                $.ajax({
                    type: "GET",
                    url: "/Home/ExportBOMList",
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function (response) {
                        var url = window.URL || window.webkitURL;
                        var link = url.createObjectURL(response);

                        var downloadLink = document.createElement('a');
                        downloadLink.href = link;
                        downloadLink.download = 'all_project_bom_' + new Date().toISOString() + '.xlsx';

                        document.body.appendChild(downloadLink);

                        downloadLink.click();

                        document.body.removeChild(downloadLink);

                        Swal.close();
                    }
                });
            }

            function selectPIC(userId, value, dept){
                var elemId = "Chkbox-" + userId;
                var isChecked = document.getElementById(elemId).checked
                var oldSelected = $("#picsContainer").val();
                //var oldPreview = $("#picPreview").val();
                var newSelected = "";
                //var newPreview = "";
                if(isChecked){
                     newSelected = oldSelected + "," + userId;
                     newSelected = newSelected.replace(/^,/, '');
                     //newPreview = oldPreview + "," + value + dept;
                     //newPreview = newPreview.replace(/^,/, '');
                     $("#picsContainer").val(newSelected);
                     $('#leaderList').html('');
                     $.ajax({
                            url : "@Url.Action("GetShortName", "Home")",
                            method : 'POST',
                            data : {
                            userIds :newSelected
                            },
                            success: function(result) {
                               $("#picPreview").val(result);

                              var splitSelectedPICId = newSelected.split(',');

                              $.each(splitSelectedPICId, function(index, value) {

                                    $.ajax({
                                        url : "@Url.Action("GetShortName", "Home")",
