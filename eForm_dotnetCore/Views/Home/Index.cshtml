@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.ViewModels;
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using eForm_dotnetCore.Configuration.Auhtorization;

@model ProjectOverviewViewModel
@{
    //ViewData["Title"] = "Dashboard(Project)";
    ViewData["Title"] = PageTitle.Dashboard + " " + (MenuTitle.EBOM);
}
@using Microsoft.AspNetCore.Mvc;
@using eForm_dotnetCore.Models;
@using System.Net;
@using Microsoft.AspNetCore.Mvc.Rendering;
@using Microsoft.Data.SqlClient;

@{
    var context = new EformSophicDemoContext();
    var list = context.Category.ToList();

    //var logInuser = context.EmployeeInfo.Where(d => d.UserName == Context.User.Identity.Name).FirstOrDefault();
    var logInuser = ViewBag.CurrentUser;
    var projectOldYear = Model.Projects.Where(x => x.PoStartDate != null).OrderBy(x => x.PoStartDate).Select(x => x.PoStartDate).FirstOrDefault();
    var projectNewYear = Model.Projects.Where(x => x.PoStartDate != null).OrderBy(x => x.PoStartDate).Select(x => x.PoStartDate).LastOrDefault();

    var isAuthRole = Context.GetUserType().Equals("Buyer", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("CEO", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("GFC", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("HOD", StringComparison.OrdinalIgnoreCase)
                               || Context.GetUserType().Equals("Sales", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("PM", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("SuperAdminAssistant", StringComparison.OrdinalIgnoreCase)
                              || Context.GetUserType().Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase);
}
<div class="row gy-5 g-xl-10 justify-content-center">
    @foreach (var card in Model.CardModels)
    {
        <div class="col-sm-6 col-xl-2 mb-xl-10">
            @await Component.InvokeAsync("OverviewCard", new
                {
                    bg = card.bgColor,
                    symbol = card.symbol,
                    title = card.title,
                    value = card.value
                })
        </div>
    }
</div>
<div class="row gy-5 g-xl-10">
    <div class="col-xl-12 mb-5 mb-xl-10 pt-5">
        <!--begin::Tables Widget 9-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-3 gap-2 gap-md-5">
                <!--begin::Card title-->
                <div class="card-title">
                    <!--begin::Search-->
                    <div class="d-flex align-items-center position-relative my-1">
                        <select id="docSearchType" class="form-select form-select-solid w-125px me-2" data-control="select2" data-hide-search="true">
                            <option value="Project">Project</option>
                            <option value="RFQ">RFQ</option>
                            <option value="PR">PR</option>
                        </select>
                        <div class="position-relative">
                            <!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
                            <span class="svg-icon svg-icon-1 position-absolute ms-4" style="top: 50%; transform: translateY(-50%);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <!--end::Svg Icon-->
                            <input type="text" id="filter_search" class="form-control form-control-solid w-250px ps-14 filterDataTable" placeholder="Search Project..." />
                        </div>
                    </div>
                    <!--end::Search-->
                </div>
                <div class="d-flex align-items-center position-relative mx-10">
                    <div class="card-toolbar m-0">
                        <ul class="nav nav-tabs nav-line-tabs nav-stretch fs-6 border-0 fw-bolder" role="tablist">
                            <li class="nav-item" role="presentation">
                                <a id="kt_activity_project_tab" class="nav-link justify-content-center text-active-gray-800" href="#">All Project</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a id="kt_activity_myProject_tab" class="nav-link justify-content-center text-active-gray-800 active" href="#">My Project</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a id="kt_activity_archivedProject_tab" class="nav-link justify-content-center text-active-gray-800" href="#">Archived Project</a>
                            </li>

                        </ul>
                    </div>
                </div>
                <!--end::Card title-->
                <!--begin::Card toolbar-->
                <div class="card-toolbar flex-row-fluid justify-content-end gap-5">
                    <div class="w-100 mw-150px">
                        <select id="yearFilter" class="form-select form-select-solid mx-2 filterDataTable" data-control="select2" data-hide-search="true" data-placeholder="Year">
                            <option></option>
                            <option value="All">All</option>
                            @{
                                int fromYear = projectOldYear.Value.Year;
                                int toYear = projectNewYear.Value.Year;

                                for (int year = toYear; year >= fromYear; year--)
                                {
                                    <option value="@year">@year</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="w-100 mw-150px">
                        <!--begin::Select2-->
                        <select class="form-select form-select-solid filterDataTable" data-control="select2" data-hide-search="true" data-placeholder="Status" id="selectStatus">
                            <option></option>
                            <option value="All">All</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Overdue">Overdue</option>
                            <option value="New">New</option>
                        </select>
                        <!--end::Select2-->
                    </div>

                    <!--begin::Add product-->
                    <button id="btnAddProject" type="button" data-bs-toggle="modal" data-bs-target="#modal_new_project"
                    @{
                                if (logInuser.UserType == "HOD" || logInuser.UserType == "PM" || logInuser.UserType == "Sales" || logInuser.UserType == "SuperAdminAssistant" || logInuser.UserType == "SuperAdmin" || logInuser.UserType == "Buyer")
                        {
                            @:class="btn btn-primary"
                        }
                        else
                        {
                            @:class="btn btn-secondary"
                            @:disabled="disabled"
                        }
                    }>
                        Add Project
                    </button>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#modal_export_bom" @{
                        if (isAuthRole)
                        {
                            @:class="border btn btn-outline-success"
                        }
                        else
                        {
                            @:class="border btn btn-secondary"
                            @:disabled="disabled"
                            @:style="pointer-events: none; cursor: default;"
                        }
                    }>
                        Export BOMs
                    </button>
                    <a href="@Url.Action("ExportToExcel")" @{
                                              if (logInuser.UserType != "Sales" || logInuser.UserType == "SuperAdminAssistant" || logInuser.UserType == "SuperAdmin")
                        {
                            @:class="border btn btn-outline-success"
                        }
                        else
                        {
                            @:class="border btn btn-secondary"
                            @:style="pointer-events: none; cursor: default;"
                        }
                    }>Excel</a>
                </div>
                <!--end::Card toolbar-->
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body pt-0">
                <input type="hidden" id="currUserName" value="@logInuser.ShortName" />
                <!--begin::Table-->
                <table class="table align-middle fs-6 gy-5" id="projectListTable">
                    <!--begin::Table head-->
                    <thead>
                        <!--begin::Table row-->
                        <tr class="fw-bolder text-uppercase gs-0" style="text-align:center;">
                            @*<th class="w-10px pe-2">
                                <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                <input class="form-check-input" type="checkbox" data-kt-check="true" data-kt-check-target="#kt_ecommerce_products_table .form-check-input" value="1" />
                                </div>
                                </th>*@
                            <th class="text-center min-w-50px smallThText" style="border-left: 2px solid #D3D3D3;"><b>Status</b></th>
                            <th class="text-center smallThText" style="display:none"><b>Archive</b></th>


                            <th class="text-center min-w-50px smallThText" style=""><b>Project Code</b></th>
                            <th class="text-center min-w-70px smallThText" style=""><b>Customer</b></th>

                            <th class="text-center min-w-80px smallThText"
                            @{
                                    if (logInuser.EmpDepartment.Name != "BD" && (logInuser.UserType != "SuperAdminAssistant" || logInuser.UserType != "SuperAdmin"))
                                {
                                    @:style="display:none"
                                }
                            }><b>Quotation</b></th>


                            <th class="text-center smallThText"><b>Project PO</b></th>
                            <th class="text-center smallThText"><b>Project Name</b></th>
                            <th class="text-center  smallThText"><b>Project Category</b></th>
                            <th class="text-center min-w-50px smallThText"><b>PO Qty</b></th>
                            <th class="text-center min-w-75px smallThText"><b>PO Received Date</b></th>
                            <th class="text-center  smallThText"><b>Project Delivery Date</b></th>
                            <th class="text-center  smallThText"><b>Penalty Terms</b></th>
                            <th class="text-center  smallThText"><b>Budget Material Cost</b></th>
                            <th class="text-center min-w-90px smallThText" style="display:none"><b>PIC</b></th>
                            <th class="text-center  smallThText"><b>Actions</b></th>
                            <th></th>
                            <th></th>
                        </tr>
                        <!--end::Table row-->
                    </thead>
                    <!--end::Table head-->
                    <!--begin::Table body-->
                    <tbody class="fw-bold text-gray-600">
                        <!--begin::Table row-->
                        @foreach (var project in Model.Projects)
                        {
                            <tr id="@project.Id">
                                <!--begin::Checkbox-->
                                @*<td>
                                    <div class="form-check form-check-sm form-check-custom form-check-solid">
                                    <input class="form-check-input" type="checkbox" value="1" />
                                    </div>
                                    </td>*@
                                <!--end::Checkbox-->

                                <td class="text-center smallTdText" style="border-left: 2px solid #D3D3D3;">
                                    @if (project.Status == "Overdue")
                                    {
                                        <div class="badge badge-light-danger badge-status">Overdue</div>
                                    }
                                    else if (project.Status == "Active")
                                    {
                                        <div class="badge badge-light-success badge-status">In Progress</div>
                                    }
                                    else if (project.Status == "New")
                                    {
                                        <div class="badge badge-light-primary badge-status">New</div>
                                    }
                                    else
                                    {
                                        <div class="badge badge-light-success badge-status">Completed</div>
                                    }
                                </td>

                                <td class="text-center smallTdText" style="display:none">@project.Archive</td>

                                <td class="text-center smallTdText">
                                    @*<span href="#" class="text-dark fw-bolder d-block fs-6">@Html.DisplayFor(modelItem => project.Code)</span>*@
                                    @Html.DisplayFor(modelItem => project.Code)
                                </td>
                                <td class="text-center smallTdText">
                                    @Html.DisplayFor(modelItem => project.Customer)
                                </td>
                                <td class="text-center smallTdText"
                                @{
                                        if (logInuser.EmpDepartment.Name != "BD" && (logInuser.UserType != "SuperAdminAssistant" || logInuser.UserType != "SuperAdmin"))
                                    {
                                        @:style="display:none"
                                    }
                                }>
                                    @if (string.IsNullOrEmpty(project.QuotationNo))
                                    {
                                        <span class="pt-3">-</span>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => project.QuotationNo)
                                    }
                                </td>

                                <td class="text-center smallTdText">
                                    @*@Html.DisplayFor(modelItem => project.PoNumber)*@
                                    @if (string.IsNullOrEmpty(project.PoNumber))
                                    {
                                        <span class="pt-3">-</span>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => project.PoNumber)
                                    }
                                </td>
                                <td class="text-center smallTdText">
                                    @Html.DisplayFor(modelItem => project.Name)
                                </td>
                                <td class="text-center smallTdText">
                                    @Html.DisplayFor(modelItem => project.CategoryInfo.CategoryName)
                                </td>
                                <td class="text-center smallTdText">
                                    @*@Html.DisplayFor(modelItem => project.PoQuantity)*@
                                    @if (project.PoQuantity == null)
                                    {
                                        <span class="pt-3">-</span>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => project.PoQuantity)
                                    }
                                </td>
                                <td class="text-center smallTdText pt-3">
                                    @if (project.PoStartDate != null)
                                    {
                                        <p>@project.PoStartDate?.ToString("yyyy-MM-dd")</p>
                                    }
                                    else
                                    {
                                        <p>-</p>
                                    }
                                </td>
                                <td class="text-center smallTdText pt-1">
                                    @if (!String.IsNullOrEmpty(project.PoDueDate))
                                    {
                                        @if (project.Status == "Overdue")
                                        {
                                            <div class="badge badge-light-danger badge-status">@project.PoDueDate.Split(",").Last()</div>
                                        }
                                        else if (project.Status == "New")
                                        {
                                            <p>@project.PoDueDate.Split(",").Last()</p>
                                        }
                                        else
                                        {
                                            <div class="badge badge-light-success badge-status">@project.PoDueDate.Split(",").Last()</div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="pt-2">-</p>
                                    }
                                </td>
                                <td class="text-center smallTdText ">
                                    @if (string.IsNullOrEmpty(project.PoTerms))
                                    {
                                        <span class="pt-3">-</span>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => project.PoTerms)
                                    }
                                </td>
                                <td class="text-center smallTdText pt-1">
                                    @{
                                        int budget = 0;
                                        int actualCost = project.ActualMaterialCost.HasValue ? (int)project.ActualMaterialCost : 0;
                                        budget = project.BudgetMaterialCost.HasValue ? (int)project.BudgetMaterialCost : 0;
                                        string strBudget = "RM " + budget.ToString("#,###,##0.00");

                                        if (budget != 0 && budget < actualCost) //If spent too much
                                        {
                                            <div class="badge badge-light-danger badge-status">@strBudget</div>
                                        }
                                        // else if(budget == actualCost)
                                        //{
                                        //    <div class="badge badge-light-warning badge-status">@strBudget</div>
                                        //}
                                        else if (budget >= actualCost)
                                        {
                                            <div class="badge badge-light-success badge-status">@strBudget</div>
                                        }
                                        else
                                        {
                                            <p class="pt-2">@strBudget</p>
                                        }

                                    }
                                </td>

                                @*PIC*@
                                <td class="text-center smallTdText " style="display:none">

                                    @{
                                        if (!String.IsNullOrEmpty(project.PICS))
                                        {
                                            var pics = project.PICS.Split(',');

                                            foreach (var pic in pics)
                                            {

                                                if (logInuser.UserType == "PM" || logInuser.UserType == "CEO" || logInuser.UserType == "GFC" || logInuser.UserType == "HOD" || logInuser.UserType == "SuperAdminAssistant" || logInuser.UserType == "SuperAdmin" || logInuser.Id == project.PICLeader)
                                                {
                                                    <input type="text" onclick="editPICSetPID(@project.Id, '@project.PICS', '@project.PICLeader')" id="pics_@project.Id" class="form-control font-weight-bold text-decoration-none smallTdText "
                                                           data-bs-toggle="modal" data-bs-target="#modal_edit_pics" value="@pic"
                                                           style="border:none; border-right:none !important; font-size:10px; text-align:center;background-color:aliceblue; height:20px; margin:3px 0 3px 0; color:#44718b !important" readonly>

                                                }
                                                else
                                                {
                                                    <input type="text" id="pics_@project.Id" class="form-control font-weight-bold text-decoration-none smallTdText " value="@pic" style="border:none; border-right:none !important; font-size:10px; text-align:center;background-color:aliceblue; height:20px; margin:3px 0 3px 0; color:#44718b !important" readonly>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            if (logInuser.UserType == "PM" || logInuser.UserType == "CEO" || logInuser.UserType == "GFC" || logInuser.UserType == "HOD" || logInuser.UserType == "SuperAdminAssistant" || logInuser.UserType == "SuperAdmin")
                                            {
                                                <input type="text" placeholder="+Add" onclick="editPICSetPID(@project.Id, '', '')" id="pics_@project.Id" class="form-control text-decoration-none smallTdText "
                                                       data-bs-toggle="modal" data-bs-target="#modal_edit_pics" value="" style="border:none; border-right:none !important; font-size:10px; text-align:center;background-color:white; height:20px; margin:3px 0 3px 0; color:#85bedf !important" readonly>

                                            }
                                            else
                                            {
                                                <input type="text" placeholder="+Add" id="pics_@project.Id" class="form-control text-decoration-none smallTdText "
                                                       value="" style="border:none; border-right:none !important; font-size:10px; text-align:center;background-color:white; height:20px; margin:3px 0 3px 0; color:#85bedf !important" readonly>

                                            }
                                        }
                                    }

                                </td>

                                <td class="text-center smallTdText" style="border-right: 2px solid #D3D3D3;">
                                    <a href="#" class="btn btn-sm btn-light btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end" style="font-size:9px; font-weight:bold; width:90%;padding-right:5px;padding-left:5px;">
                                        Actions
                                        <!--begin::Svg Icon | path: icons/duotune/arrows/arr072.svg-->
                                        <span class="svg-icon svg-icon-5 m-0">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                <path d="M11.4343 12.7344L7.25 8.55005C6.83579 8.13583 6.16421 8.13584 5.75 8.55005C5.33579 8.96426 5.33579 9.63583 5.75 10.05L11.2929 15.5929C11.6834 15.9835 12.3166 15.9835 12.7071 15.5929L18.25 10.05C18.6642 9.63584 18.6642 8.96426 18.25 8.55005C17.8358 8.13584 17.1642 8.13584 16.75 8.55005L12.5657 12.7344C12.2533 13.0468 11.7467 13.0468 11.4343 12.7344Z" fill="black" />
                                            </svg>
                                        </span>
                                        <!--end::Svg Icon-->
                                    </a>
                                    <!--begin::Menu-->
                                    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 w-125px py-4" data-kt-menu="true">
                                        <!--begin::Menu item-->
                                        @{
                                            <div class="menu-item px-3">
                                                <a href="@Url.Action("Index", "BOM", new { id = project.Id })" class="menu-link px-3">View</a>
                                            </div>
                                            @if (logInuser.UserType == "PM" || logInuser.EmployeeId == "ET0027" || logInuser.UserType == "SuperAdminAssistant" || logInuser.UserType == "SuperAdmin")
                                            {
                                                <div class="menu-item px-3">
                                                    <a href="#" data-id="@project.Id" class="menu-link px-3 editBtn">Edit</a>
                                                </div>

                                                @if (project.Archive == 0)
                                                {
                                                    <div class="menu-item px-3">
                                                        <a href="#" class="menu-link px-3" onclick="archiveProject(@project.Id)">Archive</a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="menu-item px-3">
                                                        <a href="#" class="menu-link px-3" onclick="unarchiveProject(@project.Id)">Unarchive</a>
                                                    </div>
                                                }

                                                <div class="menu-item px-3">
                                                    <a href="#" class="menu-link px-3" onclick="deleteProject(@project.Id)">Delete</a>
                                                </div>
                                            }
                                        }
                                        <!--end::Menu item-->
                                    </div>
                                    <!--end::Menu-->
                                </td>
                                <td style="display:none">@project.PICS</td> @*For filter MyProject*@

                                @{
                                    if (project.PoStartDate.HasValue)
                                    {
                                        var poStartYear = project.PoStartDate.Value;
                                        <td style="display:none">@poStartYear.Year</td>
                                    }
                                    else
                                    {
                                        <td style="display:none"></td>
                                    }
                                }
                                <!--end::Action=-->
                            </tr>

                        }
                        <!--end::Table row-->
                    </tbody>
                    <!--end::Table body-->
                </table>
                <!--end::Table-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Tables Widget 9-->
    </div>
    <!--end::Col-->
</div>

<div class="modal fade" id="modal_export_bom" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <!--begin::Close-->
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Export Boms</h1>
                </div>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex">
                        <div class="fw-bold fs-5">
                            You understand that exposure of information will result in strict prosecution and legal liability by the company.
                        </div>
                    </div>
                    <p class="text-muted">Note:Exporting all boms may take few minutes to complete</p>
                    <div class="d-flex gap-2">
                        <div class="form-check form-check-sm form-check-custom form-check-solid">
                            <input class="form-check-input" type="checkbox" id="agreeCheck" />
                        </div>
                        <div class="fw-bold ml-4">Yes,I'm understand</div>
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-success" id="exportBtn" disabled>Export</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_new_project" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">

        <!--begin::Modal content-->
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <!--begin::Close-->
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
