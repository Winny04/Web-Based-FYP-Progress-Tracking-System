                    var type = $("#docSearchType").val();
                    
                    if (type === "Project") {
                        dataTable.search(e.target.value).draw();
                    } else {
                        // Prevent project table from filtering when searching PR/RFQ
                        if (e.key === 'Enter' || e.keyCode === 13) {
