                    }
                }).then(function (result) {
                    if (result.value) {
                        var table = $('#projectListTable').DataTable();
                        $.ajax({
                            url: "@Url.Action("UnarchiveProject", "Project")",
                            method: 'POST',
                            data: {
                                id: projectId
                            },
                            success: function () {
                                Swal.fire({
                                    text: "Project unarchived successfully.",
                                    icon: "success",
                                    confirmButtonText: "OK",
                                    buttonsStyling: false,
                                    customClass: {
                                        confirmButton: "btn btn-primary",
                                    }
                                }).then(function () {
                                    location.reload();
                                });
                            },
                            error: function () {
                                Swal.fire({
                                    text: "Failed to unarchive the project.",
                                    icon: "error",
                                    confirmButtonText: "OK",
                                    buttonsStyling: false,
                                    customClass: {
                                        confirmButton: "btn btn-primary",
                                    }
                                });
