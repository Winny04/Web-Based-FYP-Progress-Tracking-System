                                        },
                                        success: function(result) {
                                                $('#leaderList').append($('<option>', {
                                                    value: value,
                                                    text : result
                                                }));
                                        }
                                    });

                              }); //end loop
                            } //end success
                    }); //end GetShortName ajax

                    var check = $("#hAddOrEdit").val();
                    if(check != "add"){
                        $("#leaderList").val(picLeaderConst).change();
                    }else{
                        $("#leaderList").val(addPicLeaderConst).change();
                    }

                }
                else{
                    oldSelected = oldSelected.replace("," + userId,"");
                    oldSelected = oldSelected.replace(userId,"");
                    //oldSelected = oldSelected.replace(/^,/, ''); //remove first comma
                    //oldSelected = oldSelected.replace(/,\s*$/, ""); //remove last commma
                    //oldPreview = oldPreview.replace("," + value +   dept ,"");
                    newSelected = oldSelected;
                    //newPreview = oldPreview;
                    newSelected = newSelected.replace(/^,/, '');
                    //newPreview = newPreview.replace(/^,/, '');
                    $("#picsContainer").val(newSelected);
                    $('#leaderList').html('');
                     $.ajax({
                            url : "@Url.Action("GetShortName", "Home")",
                            method : 'POST',
                            data : {
                            userIds :newSelected
                            },
                            success: function(result) {
                               $("#picPreview").val(result);

                                var splitSelectedPICId = newSelected.split(',');

                              $.each(splitSelectedPICId, function(index, value) {

                                    $.ajax({
                                    url : "@Url.Action("GetShortName", "Home")",
                                    method : 'POST',
                                    data : {
                                    userIds :value
                                    },
                                    success: function(result) {
                                        $('#leaderList').append($('<option>', {
                                            value: value,
                                            text : result
                                        }));
                                    }
                                });
                              }); // end loop
                            }//end success
                    }); //end GetShortName aja

                    var check = $("#hAddOrEdit").val();
                    if(check != "add"){
                        $("#leaderList").val(picLeaderConst).change();
                    }else{
                        $("#leaderList").val(addPicLeaderConst).change();

                    }
                }
            }


