@using System.Collections
@using eForm_dotnetCore.ViewModel
@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using Microsoft.EntityFrameworkCore;

@model Brand

@{
    ViewData["Title"] = "Edit Brand Recommendation";
}
<style>
    textarea {
        white-space: pre-line;
    }
</style>

<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxxl">
    <div class="content flex-row-fluid" id="kt_content">
        <div class="card card-flush mb-xl-1">
            <div class="card-body">
                <div class="card m-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3>Edit Brand Recommendation</h3>
                        <button class="btn btn-primary" onclick="addSupplier()">Add Supplier</button>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <div class="d-flex flex-column mb-8 fv-row">
                                    <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                                        <span>Brand</span>
                                    </label>
                                    <input class="form-control form-control-solid" placeholder="Brand..." value="@Model.Name" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <table id="brandTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                                <thead>
                                    <tr class="fw-bolder text-muted">
                                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Primary</b></th>
                                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Supplier</b></th>
                                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Action</b></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var supplier in Model.BrandSuppliers)
                                    {
                                        <tr id="@supplier.Id" class="text-center">
                                            <td class="tableCellStandard tableCellBorderLeft">
                                                <input class="form-check-input checkSingle" title="isprimeCheck" id="checkBox-@supplier.Id" type="checkbox" value="@supplier.SupplierId" data-kt-check="true" data-kt-check-target=".widget-9-check" style="margin-left:7px;" checked="@supplier.IsPrimary" />
                                            </td>
                                            <td class="tableCellStandard tableCellBorderLeft">
                                                @supplier.Supplier.VendorName
                                            </td>
                                            <td class="tableCellStandard tableCellBorderLeft">
                                                <button onclick="deleteRecord('@supplier.Id')" class="btn btn-sm btn-danger">Remove</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-end">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" id="returnUrl" name="returnUrl" value="@Context.Request.Headers["Referer"].ToString()" />
                    <button class="btn btn-primary mr-2" onclick="saveChanges()">Save</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Discharge</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_addSupplier" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Add Supplier</h1>
                </div>

                <div id="selectSupplierForm"></div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        var selectedSupplier = [];
        var requestModal;
        $(document).ready(function () {
            var table = document.getElementById("brandTable")
            var modal1 = document.getElementById("modal_addSupplier");
            requestModal = new bootstrap.Modal(modal1);
            var dataTable = $(table).DataTable({
                "info": false,
                "pageLength": 5,
                "lengthMenu": [[5, 10, 15, -1], [5, 10, 15, 'All']],
                "order": []
            });

            @foreach(var supplier in Model.BrandSuppliers.Where(x => x.IsPrimary).ToList())
            {
                @:selectedSupplier.push('@supplier.SupplierId')
            }

            $(document).on('change', '.checkSingle', function () {
                var isChecked = $(this).is(':checked');
                console.log('cccccc', isChecked, $(this).attr('value'))
                var rowIndex = $(this).closest('tr').index(); // Get the row index
                console.log('Checkbox changed in row ' + rowIndex + ': ' + isChecked);

                if (isChecked) {
                    if (selectedSupplier.length >= 3) {
                        this.checked = false
                        alert('Max prime supplier is 3')
                        return;
                    }
                    var supplierId = $(this).attr('value');
                    selectedSupplier.push(supplierId);
                    console.log("selectedSupplier " + selectedSupplier);
                }
                else {
                    var supplierId = $(this).attr('value');
                    selectedSupplier = $.grep(selectedSupplier, function (n) {
                        return n != supplierId;
                    });
                    console.log("selectedSupplier " + selectedSupplier);
                }
            });
        })

        function deleteRecord(id) {
            Swal.fire({
                text: "Are you sure delete this supplier?",
                icon: "warning",
                showCancelButton: true,
                buttonsStyling: false,
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "No, return",
                customClass: {
                    confirmButton: "btn btn-primary",
                    cancelButton: "btn btn-active-light"
                }
            }).then(function (result) {
                if (result.value) {
                    var table = $('#brandTable').DataTable();
                    $.ajax({
                        url: "@Url.Action("Delete","BrandRecommend")",
                        method: 'POST',
                        data: {
                            id
                        },
                        //success: function() {location.reload();}
                        success: function () {
                            table.row("#" + id).remove().draw();
                        }
                    });
                } else if (result.dismiss === 'cancel') {
                    Swal.fire({
                        text: "Your request has been cancelled!.",
                        icon: "error",
                        buttonsStyling: false,
                        confirmButtonText: "Ok, got it!",
                        customClass: {
                            confirmButton: "btn btn-primary",
                        }
                    });
                }
            });
        }

        function saveChanges(){
            $.ajax({
                url: "@Url.Action("Edit","BrandRecommend")",
                method:'POST',
                data:{
                    id:'@Model.Id',
                    suppliers:selectedSupplier
                },
                success: function (e) {
                    Swal.fire({
                        text: "Your changes has been saved",
                        icon: "success",
                        showCancelButton: false,
                        buttonsStyling: false,
                        confirmButtonText: "Okay",
                        customClass: {
                            confirmButton: "btn btn-light-success font-weight-bold mr-2",
                        }
                    })
                }
            })
        }

        function addSupplier() {
            $.ajax({
                url: '@Url.Action("AddSupplier","BrandRecommend")',
                data: { id: "@Model.Id" },
                type: 'get',
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    $("#selectSupplierForm").html(response);
                    requestModal.show();
                }
            });
        }
    </script>
}