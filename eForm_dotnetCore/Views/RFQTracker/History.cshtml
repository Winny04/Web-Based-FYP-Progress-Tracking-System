@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.ViewModels
@{
    ViewData["Title"] = PageTitle.RFQTracker;
}
<style>
    .tableBorder {
        border-right: 2px solid #D3D3D3;
        color: black;
        font-size: 15px;
    }

    .parent {
        cursor: pointer
    }

    .child-row-content {
        width: 90%;
        display: flex;
        justify-content: center;
    }

    .child-table {
        width: 90%;
        border-collapse: collapse;
    }

        .child-table td {
            padding: 8px;
            border: 1px solid #ddd;
        }
</style>

<div id="kt_content_container" class="col-xl-12 mb-5 mb-xl-10 pb-5">
    <div class="content flex-row-fluid" id="kt_content">
        <div class="card card-flush mb-2 mb-xl-8">
            <div class="card-header pt-7">
                <div class="card-toolbar">
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bolder fs-3 mb-1">RFQ History</span>
                    </h3>
                </div>
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-2">
                        <div class="d-flex align-items-center position-relative my-1">
                            <!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <!--end::Svg Icon-->
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search Form" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body py-3">
                <div class="table-responsive">
                    <table id="mytable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <thead>
                            <tr class="fw-bolder text-muted">
                                <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Status</b></th>
                                <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Update Date</b></th>
                                <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Project Code</b></th>
                                <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Project Name</b></th>
                                <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Description</b></th>
                                <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Brand</b></th>
                                <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Part No.</b></th>
                                <th class="mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Qty</b></th>
                                <th class="min-w-70px mw-70px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Require Date.</b></th>
                                <th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>RFQ</b></th>
                                <th class="min-w-50px mw-50px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Request By.</b></th>
                                <th class="min-w-100px mw-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Remark.</b></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script>
        $(document).ready(function () {
            var table = $("#mytable").DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                searchDelay: 500,
                drawCallback: function () {
                    $('#mytable td').css('color', 'black');
                    $('#mytable td').css('font-size', '15px');
                    $('#mytable td').css('border-right', '2px solid #D3D3D3');
                },
                "ajax": {
                    "url": "@Url.Action("LoadData")",
                    "type": "POST"
                },
                "pagingType": "full_numbers",
                columnDefs: [
                    {
                        targets: 0,
                        render: function (data, type, row) {
                            if (row.status ==="New" || row.status === "PR Sent" || row.status === "Item Issued Out")
                            {
                                return `<div class="badge badge-light-primary badge-status">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Sent" || row.status === "PR Approved"|| row.status === "PO Revise")
                            {
                                return `<div class="badge badge-light-warning badge-status">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Updated" || row.status === "PO Approved") {
                                return `<div class="badge badge-light-info">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Approved" || row.status === "Item Received" || row.status === "Completed") {
                                return `<div class="badge badge-light-success">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Reject" || row.status === "PR Reject" || row.status === "Receiving Reject" || row.status === "PO Reject" || row.status === "PO Cancelled") {
                                return `<div class="badge badge-light-danger badge-status">${row.status}</div>`
                            }
                        }
                    },
                    {
                        targets: 1,
                        render:function(data,type,row){
                            return moment(row.lastUpdatedDate).format('DD MMM YYYY')
                        }
                    },
                    {
                        targets: 2,
                        render:function(data,type,row){
                            return row.project.code
                        }
                    },
                    {
                        targets: 3,
                        render:function(data,type,row){
                            return row.project.name
                        }
                    },
                    {
                        targets: 4,
                        render:function(data,type,row){
                            return row.partDesc
                        }
                    },
                    {
                        targets: 5,
                        render:function(data,type,row){
                            return row.brand
                        }
                    },
                    {
                        targets: 6,
                        render: function (data, type, row) {
                            var partNo = "";
                            if (row.itemCategory === "Fabrication" && row.bomSupportFiles.length > 0) {
                                var drawing = row.bomSupportFiles.filter(x => x.type === "IC")
                                if(drawing.length && drawing.length > 0){
                                    for (var j = 0; j < drawing.length; j++) {
                                        partNo += `<p><a href='${drawing[j].supportFile.contentType}' target='_blank'>${drawing[j].supportFile.fileName}</a></p>`
                                    }
                                }
                            }
                            else
                            {
                                partNo = row.partNumber
                            }
                            return partNo
                        }
                    },
                    {
                        targets: 7,
                        render: function (data, type, row) {
                            return row.requireQty
                        }
                    },
                    {
                        targets: 8,
                        render: function (data, type, row) {
                            if(row.requireDate !== null){
                                return moment(row.requireDate).format('DD MMM YYYY')
                            }
                            return ""
                        }
                    },
                    {
                        targets: 9,
                        render: function (data, type, row) {
                            if (row.rfqId !== null){
                                return `<a href='/RFQ/Edit/${row.rfqId}'>${row.rfq.rfqname}</a>`
                            }
                            else
                            {
                                return ""
                            }
                        }
                    },
                    {
                        targets: 10,
                        render: function (data, type, row) {
                            if (row.rfqId !== null){
                                return `${row.rfq.requestor.fullName}`
                            }
                            else
                            {
                                return ""
                            }
                        }
                    },
                    {
                        targets: 11,
                        render: function (data, type, row) {
                            if (row.rfqId !== null &&  row.rfq.remark !== null) {
                                return `${row.rfq.remark}`
                            }
                            else {
                                return ""
                            }
                        }
                    },
                ],
            })

            var filterSearch = document.getElementById("filter_search");
            filterSearch.addEventListener("keyup", function (e) {
                setTimeout(() => {
                    table.search(e.target.value).draw();
                }, 3000);
                
            });

            table.on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    Swal.showLoading()
                } else {
                    Swal.close();
                }
            });
        })

        function formatChildRow(data) {
            var obj = JSON.parse(data[0]);
            console.log('obj', obj)
            var childContent = '<div class="child-row-content"><table class="child-table">' +
                '<thead>' +
                '<tr class="fw-bolder text-muted">' +
                '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>Description</b></th >' +
                '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>Brand</b></th >' +
                '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>PartNo</b></th >' +
                '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>Quantity</b></th >' +
                '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>Require Date</b></th >' +
                '</tr>' +
                '</thead>' +
                '<tbody>';

            if (obj.length && obj.length > 0) {
                for (var i = 0; i < obj.length; i++) {
                    var currentItem = obj[i];
                    var partNo = "";
                    if (currentItem.ItemCategory === "Fabrication") {
                        var files = currentItem.BomSupportFiles
                        if (files !== undefined && files.length > 0) {
                            var drawing = files.filter(x => x.Type === "IC")
                            for (var j = 0; j < drawing.length; j++) {
                                partNo += `<p><a href='${drawing[j].SupportFile.ContentType}' target='_blank'>${drawing[j].SupportFile.FileName}</a></p>`
                            }
                        }
                    }
                    else {
                        partNo = currentItem.PartNumber;
                    }
                    var newRow = '<tr>' +
                        `<td>${currentItem.PartDesc}</td>` +
                        `<td>${currentItem.Brand}</td>` +
                        `<td>${partNo}</td>` +
                        `<td>${currentItem.RequireQty}</td>` +
                        `<td>${moment(currentItem.RequireDate).format('DD MMM YYYY')}</td>` +
                        '</tr>'

                    childContent += newRow
                }
            }

            childContent += '</tbody></table></div>';
            return childContent;
        }

        function deleteRFQ(rfqId) {
            Swal.fire({
                title: 'Remove Form',
                text: 'Reason',
                html: `<textarea class="form-control form-control-solid mb-3" rows="2" placeholder="Remove this form because..." id="reason"></textarea>`,
                icon: "warning",
                preConfirm: () => {
                    const reason = Swal.getPopup().querySelector('#reason').value
                    return { reason: reason }
                },
                showCancelButton: true,
                buttonsStyling: false,
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "No, return",
                customClass: {
                    confirmButton: "btn btn-primary",
                    cancelButton: "btn btn-active-light"
                }
            }).then(function (result) {
                if (result.value) {
                    var table = $("#mytable").DataTable();
                    $.ajax({
                        url: "@Url.Action("DeleteRFQ","RFQTracker")",
                        method: "delete",
                        data: {
                            rfqId: rfqId,
                            reason: result.value.reason,
                            fromTracker: true
                        },
                        success: function () {
                            table.row("#" + rfqId).remove().draw();
                        }
                    });
                } else if (result.dismiss === "cancel") {
                    Swal.fire({
                        text: "Your form has not been cancelled!.",
                        icon: "error",
                        buttonsStyling: false,
                        confirmButtonText: "Ok, got it!",
                        customClass: {
                            confirmButton: "btn btn-primary",
                        }
                    });
                }
            });
        }
    </script>
}
