			  //default search
			  //table.columns(0).search($('#statusFilter').val(), true, false).draw();

			  var filterSearch = document.getElementById("filter_search");
			  filterSearch.addEventListener("keyup", function (e) {
				  table.search(e.target.value).draw();
			  });


			  // $('#statusFilter').change(function () {
				 //  var status = $(this).val(); Get the selected value
				 //  if (status) {
					////   Redirect to the desired URL, appending the status as a query parameter
					//   window.location.href = "@Url.Action("Index")?status=" + status;

				 //  }
			  // });

		  $('#applyCategoryFilter').click(function () {
			  var selectedCategories = [];
			  $('.category-checkbox:checked').each(function () {
				  selectedCategories.push($(this).val().trim());
			  });

			  var categoryColumnIndex = 5;

			  if (selectedCategories.length > 0) {

				  var regex = selectedCategories.map(function (cat) {
					  return '^' + cat.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + '$';
				  }).join('|');

				  table.column(categoryColumnIndex)
					  .search(regex, true, false)
					  .draw();
			  } else {
				  // If none selected, reset the filter
				  table.column(categoryColumnIndex)
					  .search('', true, false)
					  .draw();
			  }
		  });

			// Dropdown
			$('#categoryDropdown').on('click', function (e) {
				e.stopPropagation();
				$('#categoryCheckboxes').toggle();
			});

			// Close dropdown when clicking outside
			$(document).on('click', function (e) {
				if (!$(e.target).closest('#categoryFilterContainer').length) {
					$('#categoryCheckboxes').hide();
				}
