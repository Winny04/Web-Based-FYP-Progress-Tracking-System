		function formatChildRow(data) {
			  var obj = JSON.parse(data[0]);
			  console.log('obj',obj)
			  var childContent = '<div class="child-row-content"><table class="child-table">' +
				  '<thead>'+
				  '<tr class="fw-bolder text-muted">' +
					  '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>Description</b></th >'+
					  '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>Brand</b></th >'+
					  '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>PartNo</b></th >'+
					  '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>Quantity</b></th >' +
					  '<th class="min-w-100 mw-100px" style = "color:black; font-size:15px; border-right: 2px solid #D3D3D3;"> <b>Require Date</b></th >' +
				  '</tr>' +
				  '</thead>' +
				  '<tbody>';

			  if (obj.length && obj.length > 0){
				  for (var i = 0; i < obj.length;i++){
					  var currentItem =  obj[i];
					  var partNo = "";
					  if (currentItem.ItemCategory === "Fabrication") {
						  var files = currentItem.BomSupportFiles
						  if (files !== undefined && files.length > 0) {
							  var drawing = files.filter(x => x.Type === "IC")
							  for (var j = 0; j < drawing.length; j++) {
								  partNo += `<p><a href='${drawing[j].SupportFile.ContentType}' target='_blank'>${drawing[j].SupportFile.FileName}</a></p>`
							  }
						  }
					  }
					  else{
						  partNo = currentItem.PartNumber;
					  }
					  var newRow = '<tr>'+
						  `<td>${currentItem.PartDesc}</td>` +
						  `<td>${currentItem.Brand}</td>` +
						  `<td>${partNo}</td>` +
						  `<td>${currentItem.RequireQty}</td>` +
						  `<td>${moment(currentItem.RequireDate).format('DD MMM YYYY')}</td>` +
					  '</tr>'

					  childContent += newRow
				  }
			  }

			  childContent += '</tbody></table></div>';
			  return childContent;
			}

		  function deleteRFQ(rfqId) {
			  Swal.fire({
				  title: 'Reject Form',
				  text: 'Reason',
				  html: `<textarea class="form-control form-control-solid mb-3" rows="2" placeholder="Please enter reason for rejection" id="reason"></textarea>`,
				  icon: "warning",
				  preConfirm: () => {
					  const reason = Swal.getPopup().querySelector('#reason').value
					  return { reason: reason }
				  },
				  showCancelButton: true,
				  buttonsStyling: false,
				  confirmButtonText: "Yes, reject it!",
				  cancelButtonText: "No, return",
				  customClass: {
					  confirmButton: "btn btn-primary",
					  cancelButton: "btn btn-active-light"
				  }
			  }).then(function (result) {
				  if (result.value) {
					  var table = $("#mytable").DataTable();
					  $.ajax({
						  url: "@Url.Action("DeleteRFQ", "RFQTracker")",
						  method: "delete",
						  data: {
							  rfqId: rfqId,
							  reason: result.value.reason,
							  fromTracker: true
						  },
						  success: function () {
							  table.row("#" + rfqId).remove().draw();
						  }
					  });
				  } else if (result.dismiss === "cancel") {
					  Swal.fire({
						  text: "Your form has not been cancelled!.",
						  icon: "error",
						  buttonsStyling: false,
						  confirmButtonText: "Ok, got it!",
						  customClass: {
							  confirmButton: "btn btn-primary",
						  }
					  });
				  }
			  });
		  }
		  
		  function filterRFQTracker() {
			const status = $("#statusFilter").val();
			const fromDate = $("#dateFrom").val();
			const toDate = $("#dateTo").val();

			const query =
				`?status=${encodeURIComponent(status || "")}` +
				`&fromDate=${encodeURIComponent(fromDate || "")}` +
				`&toDate=${encodeURIComponent(toDate || "")}`;

			window.location.href = '@Url.Action("Index", "RFQTracker")' + query;
		}

		function resetFilter() {
			window.location.href = '@Url.Action("Index", "RFQTracker")';
		}

		$("#statusFilter").change(function () {
			filterRFQTracker();   // ✔ call main filter function
		});

	</script>
}
