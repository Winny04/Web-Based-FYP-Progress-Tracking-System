@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.ViewModels
@model IEnumerable<Bom>

@{
	ViewData["Title"] = PageTitle.RFQTracker;
	var context = new EformSophicDemoContext();
	var itemCategories = EnumHelpers.ToSelectList<BomItemCategory>();
	var statuslist = context.Boms
		.Where(x => x.RFQId.HasValue && x.Project.Status != "Completed")
		.GroupBy(x => x.Status)
		.Select(g => new { Status = g.Key, Count = g.Count() })
		.ToList();

}

<style>
	.tableBorder {
		border-right: 2px solid #D3D3D3;
		color: black;
		font-size: 15px;
	}

	.parent {
		cursor: pointer
	}

	.child-row-content {
		width: 90%;
		display: flex;
		justify-content: center;
	}

	.child-table {
		width: 90%;
		border-collapse: collapse;
	}

		.child-table td {
			padding: 8px;
			border: 1px solid #ddd;
		}
</style>

<div id="kt_content_container" class="col-xl-12 mb-5 mb-xl-10 pb-5">
	<div class="content flex-row-fluid" id="kt_content">
		<div class="card card-flush mb-2 mb-xl-8">
			<div class="card-header pt-7">

				<div class="card-toolbar">
					<h3 class="card-title align-items-start flex-column">
						<span class="card-label fw-bolder fs-3 mb-1">@PageTitle.RFQTracker</span>
					</h3>
				</div>
				@*       <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-2">
                        <div class="d-flex align-items-center position-relative my-1">
                            <!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <!--end::Svg Icon-->
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search Form" />
                        </div>
                    </div>
                </div>*@
				<div class="card-title">
					<!--begin::Search-->
					<div class="d-flex align-items-center position-relative my-1">
						<!--begin::Svg Icon | path: icons/duotune/general/gen021.svg-->
						<span class="svg-icon svg-icon-1 position-absolute ms-4">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
								<rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
								<path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
							</svg>
						</span>
						<!--end::Svg Icon-->
						<input type="text" id="filter_search" class="form-control form-control-solid w-250px ps-14 filterDataTable" placeholder="Search Project" />
					</div>
					<!--end::Search-->
				</div>
				<div class="card-toolbar flex-row-fluid gap-5">
					<div class="w-100 mw-150px">
						<select id="statusFilter" class="form-select form-select-solid mx-2 filterDataTable" data-control="select2" data-hide-search="true">

							@{
								foreach (var i in statuslist)
								{
									if (ViewBag.status == i.Status)
									{
										<option value="@i.Status" selected>@i.Status</option>
									}
									else if (ViewBag.status == null)
									{
										if (i.Status == "RFQ Sent")
										{
											<option value="@i.Status" selected>@i.Status</option>
										}
										else
										{
											<option value="@i.Status">@i.Status</option>
										}
									}
									else
									{
										<option value="@i.Status">@i.Status</option>
									}
								}
							}
						</select>
					</div>
					<div class="w-100 mw-200px" id="categoryFilterContainer">
						<div class="dropdown position-relative">
							<button class="btn btn-outline-primary w-100 text-start d-flex justify-content-between align-items-center" type="button" id="categoryDropdown">
								<span>Select Categories</span>
								<i class="bi bi-chevron-down"></i>
							</button>

							<div class="dropdown-menu show p-3 shadow rounded border-0 mt-1 w-100"
								 style="max-height: 300px; overflow-y: auto; display: none;"
								 id="categoryCheckboxes">

								<div class="ps-2">

									@foreach (var item in itemCategories)
									{
										var shortName = EnumHelpers.ToSelectList<BomItemCategoryShortName>()
										.Where(x => x.Id == item.Id)
										.Select(x => x.Text)
										.FirstOrDefault();
										<div class="form-check mb-2">
											<input class="form-check-input category-checkbox" type="checkbox" value="@item.Text" id="chk_@item.Id">
											<label class="form-check-label small" for="chk_@item.Id">@item.Text Part (@shortName)</label>
										</div>
									}
								</div>

								<button class="btn btn-sm btn-primary w-100 mt-3" id="applyCategoryFilter">
									Apply Filter
								</button>
							</div>
						</div>
					</div>

				</div>
			</div>
			<div class="card-body py-3">
				<div class="container-fluid mb-3">
					<div class="row g-3 align-items-end">

						<!-- From -->
						<div class="col">
							<label for="dateFrom" class="form-label">From</label>
							<input type="date" id="dateFrom" class="form-control form-control-sm">
						</div>

						<!-- To -->
						<div class="col">
							<label for="dateTo" class="form-label">To</label>
							<input type="date" id="dateTo" class="form-control form-control-sm">
						</div>

						<!-- Buttons right -->
						<div class="col-auto d-flex gap-2">
							<button class="btn btn-primary btn-sm" onclick="filterRFQTracker()">Filter</button>
							<button class="btn btn-secondary btn-sm" onclick="resetFilter()">Reset</button>
						</div>

					</div>
				</div>

				<div class="table-responsive">
					<table id="mytable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
						<thead>
							<tr class="fw-bolder text-muted">
								<th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>ITEM No</b></th>
								<th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Status</b></th>
								<th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Update Date</b></th>
								<th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Project Code</b></th>
								<th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Project Name</b></th>
								<th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Category</b></th>
								<th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Description</b></th>
								<th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Brand</b></th>
								<th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Part No.</b></th>
								<th class="mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Qty</b></th>
								<th class="min-w-70px mw-70px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Require Date.</b></th>
								<th class="min-w-70px mw-70px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>RFQ Sharing Status</b></th>
								<th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>RFQ</b></th>
								<th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Quotation</b></th>
								<th class="min-w-50px mw-50px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Request By.</b></th>
								<th class="min-w-100px mw-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Remark.</b></th>
								<th class="min-w-50px mw-50px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Action</b></th>
							</tr>
						</thead>
						<tbody>
							@foreach (var form in Model)
							{
								<tr id="@form.RFQ.Id" class="text-center parent" style="max-height:30px" data-category="@form.ItemCategory">
									<td>
										@form.Id
									</td>
									<td>
										@if (form.Status == "RFQ Sent")
										{
											<div class="badge badge-light-warning badge-status">@form.Status</div>
										}
										else if (form.Status == "RFQ Approved")
										{
											<div class="badge badge-light-success badge-status">@form.Status</div>
										}
										else if (form.Status == "RFQ Reject" || form.Status == "RFQ REJECT")
										{
											<div class="badge badge-light-danger badge-status">@form.Status</div>
										}
										else
										{
											<div class="badge badge-light-primary badge-status">@form.Status</div>
										}
									</td>
									<td>
										@form.RFQ.LastUpdatedDate
									</td>
									<td>
										@form.Project.Code
									</td>
									<td>
										@form.Project.Name
									</td>
									<td>
										@form.ItemCategory
									</td>
									<td style="color:black;font-size:11px;border-right: 2px solid #D3D3D3; word-wrap: break-word; max-width:100px">
										@form.PartDesc
									</td>
									<td>
										@form.Brand
									</td>
									<td>
										@if (form.ItemCategory == "Fabrication")
										{
											if (form.BomSupportFiles != null && form.BomSupportFiles.Where(x => x.Type == "IC").Any())
											{
												foreach (var sf in form.BomSupportFiles.Where(x => x.Type == "IC").ToList())
												{
													<a href="@sf.SupportFile.ContentType" target="_blank">@sf.SupportFile.FileName</a>
												}
											}
										}
										else
										{
											@form.PartNumber
										}
									</td>
									<td>
										@form.RequireQty
									</td>
									<td>
										@form.RequireDate
									</td>
									<td>
										@if (!string.IsNullOrEmpty(form.RFQSharingStatus))
										{
											var statuses = form.RFQSharingStatus.Split(", ");
											foreach (var status in statuses)
											{
												if (status == "Processing")
												{
													<div class="badge badge-light-warning">Processing</div>
												}
												else if (status == "Rejected")
												{
													<div class="badge badge-light-danger">Rejected</div>
												}
												else if (status == "Submitted")
												{
													<div class="badge badge-light-success">Submitted</div>
												}
												else if (status == "N/A")
												{
													<div class="badge badge-light-secondary">N/A</div>
												}
												else
												{
													<div class="badge badge-light-secondary">Not Available</div>
												}
											}
										}
										else
										{
											<div class="badge badge-light-secondary">N/A</div>
										}
									</td>

									<td>
										<p><a href="@Url.Action("Edit","RFQ",new {id = form.RFQId,bomId = form.Id})">@form.RFQ.Rfqname</a></p>
										@if (form.IsPOUpdated)
										{
											<span class="text-warning">(Source Sent)</span>
										}
									</td>
									<td>
										@if (form.SupplierQuotations?.Any() == true)
										{
											foreach (var q in form.SupplierQuotations)
											{
												<div class="mb-2">
													@q.SupplierName<br />
													<a href="@q.FileUrl" target="_blank">@q.FileName</a>
												</div>
											}
										}
										else
										{
											<span class="text-muted">-</span>
										}
									</td>
									<td>
										@form.RFQ.Requestor.ShortName
									</td>
									<td>
										@Html.Raw(form.RFQ.Remark)
									</td>
									<td>
										@*    <button class="btn btn-danger mr-2" onclick="deleteRFQ(@form.RFQ.Id)"
									@{
									if(form.RFQ.Project.Status == "Completed"){
									@:class="btn btn-sm btn-secondary smallButtonText disabled"
									@:disabled="disabled"
									}
									else{
									@:class="btn btn-sm btn-danger"
									}
									}>Delete</button>*@
										<button onclick="deleteRFQ(@(form.RFQId))"
										@{
											var projectStatus = form.Project?.Status ?? "";
											if (projectStatus == "Completed")
											{
												@:class="btn btn-sm btn-secondary smallButtonText"
												@:disabled="disabled"
											}
											else
											{
												@:class="btn btn-sm btn-danger mr-2"
											}
										}>
											Reject
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>

				@*      <div class="table-responsive">
                    <table id="mytable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <thead>
                            <tr class="fw-bolder text-muted">
                                <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Status</b></th>
                                <th class="min-w-70px mw-70px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Update Date</b></th>
                                <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Project Code</b></th>
                                <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Project Name</b></th>
                                <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Description</b></th>
                                <th class="min-w-50px mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Brand</b></th>
                                <th class="min-w-100px mw-100px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Part No.</b></th>
                                <th class="mw-50px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>Qty</b></th>
                                <th class="min-w-70px mw-70px" style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Require Date</b></th>
                                <th class="min-w-80px mw-80px" style="color:black;font-size:11px;border-right: 2px solid #D3D3D3;"><b>RFQ</b></th>
                                <th class="min-w-50px mw-50px" style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Request By</b></th>
                                <th class="min-w-100px mw-100px" style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Remark</b></th>
                                <th class="min-w-50px mw-50px" style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Action</b></th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dynamic rows will be inserted by DataTables -->
                        </tbody>
                    </table>
                </div>*@

			</div>
		</div>
	</div>
</div>


@section scripts {
	<script>
		  $(document).ready(function () {
			  var table = $("#mytable").DataTable({
				  dom: 'ltip',
				  pageLength: 10,
				  lengthMenu: [[5, 10, 15, -1], [5, 10, 15, 'All']],
				  "order": [],
				  drawCallback: function () {
					  $('#mytable td').css('color', 'black');
					  $('#mytable td').css('font-size', '15px');
					  $('#mytable td').css('border-right', '2px solid #D3D3D3');
				  },
				  columnDefs: [{
					  targets: [2], // Update Date
					  render: function (data, type, row) {
						  var dateFormats = ['M/D/YYYY h:mm:ss A', 'D/M/YYYY h:mm:ss A','YYYY-MM-DD h:mm:ss A'];
						  if (type === 'sort' || type === 'type') {
							  return moment(data, dateFormats).isValid()
								  ? moment(data, dateFormats).format('YYYYMMDDHHmmss')
								  : '';
						  }

						  return moment(data, dateFormats).isValid()
							  ? moment(data, dateFormats).format('D/M/YYYY h:mm:ss A')
							  : 'Invalid Date';
					  }
				  }, {
					  targets: [10], // Require Date
					  render: function (data, type, row) {
						  var dateFormats = ['M/D/YYYY h:mm:ss A', 'D/M/YYYY h:mm:ss A', 'YYYY-MM-DD h:mm:ss A'];
						  if (type === 'sort' || type === 'type') {
							  return moment(data, dateFormats).isValid()
								  ? moment(data, dateFormats).format('YYYYMMDDHHmmss')
								  : '';
						  }

						  return moment(data, dateFormats).isValid()
							  ? moment(data, dateFormats).format('D/M/YYYY h:mm:ss A')
							  : 'Invalid Date';
					  }

				  }
				  ]
			  })


