@using eForm_dotnetCore.Helpers
@model Pr
@using Microsoft.Net.Http.Headers;
@using eForm_dotnetCore.Common;

@{
    ViewData["Title"] = "Edit PR - "+(Model.Prname);
    var userType = Context.GetUserType();
    var isProjectCompleted = ViewBag.isProjectCompleted;
    var IsDepartmentSame = ViewBag.IsDepartmentSame;
    var isFabrication = ViewBag.isFabrication;
    var allowSubmit = ViewBag.allowSubmit;
    var bomStatus = ViewBag.BomStatus;
}

<style>
    div.formio-component-textarea > div > div:nth-child(1){
        padding:10px 10px !important;
    }

    .formio-component.table-no-borders table,
    .formio-component.table-no-borders td,
    .formio-component.table-no-borders th {
        border: none !important;
        box-shadow: none !important;
    }

    .formio-component.table-no-borders table tbody tr td {
        border-bottom: none !important;
    }

    .formio-component.panel-fit {
        width: fit-content;
    }
</style>

<div class="card card-xxl-stretch mb-5 mb-xxl-10">
    <div class="card-header d-flex justify-content-between">
        <div class="card-title">
            <button type="button" id="backtoBOM" class="btn btn-primary">Back to BOM</button>
            <h3 class="mx-2">Edit form - @Model.Prname</h3>
        </div>
        <div class="card-title">
            <a href="@Url.Action("DownloadPRDrawing", new { id = Model.Id })" @{
               if (isFabrication)
               {
                   @:class="btn btn-info mx-2"
               }
               else
               {
                   @:hidden="true"
               }
            }>
                Download Drawing
            </a>
            @*<a href="@Url.Action("ExportToPDF",new {id = Model.Id})" class="btn btn-danger mx-2">Export To PDF</a>*@
            <button onclick="exportExcel(@Model.Id)" class="btn btn-outline-success mx-2">Export To Excel</button>
            <button onclick="exportExcel2026(@Model.Id)" class="btn btn-outline-success mx-2">Export To Excel 2026</button>
        </div>
    </div>
    <form id="fillForm" asp-action="Edit" method="post">
        <div class="card-body pb-0">
            <div class="form-horizontal">
                <div class="form-group">
                    @Html.LabelFor(model => model.Prname, "Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Prname, new { htmlAttributes = new { @class = "form-control", required = "", disabled = "disabled" } })
                        @Html.ValidationMessageFor(model => model.Prname, "", new { @class = "text-danger" })
                    </div>
                </div>
                <input type="hidden" name="Data" value="" />
                <input type="hidden" name="DataResponse" id="DataResponse" value="" />
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />

                <div id="builder" hidden></div>

                <div class="card">
                    <div class="card-body" style="overflow-x:auto">
                        <div id="render"></div>
                    </div>
                </div>

                <div class="form-group pt-3">
                    <div class="row gy-5 g-xl-10 justify-content-center">
                        @if (bomStatus == "PR Sent")
                        {
                            <div class="col-sm-12 col-lg-4">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="card-title fs-3 fw-bolder">Approver 1</div>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-6">
                                            <div class="col-6 text-start">
                                                <span class="w-100 fs-4 fw-bolder">@ViewBag.HODDept HOD</span>
                                            </div>
                                            <div class="col-6">
                                                @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "HOD" && x.Approved == true).Any())
                                                {
                                                    <span>@Model.PRApprovers.FirstOrDefault(x => x.Type == "HOD" && x.Approved == true).Approver.UserName</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="row mb-6">
                                            <div class="col-4 text-start">
                                                <span class="w-100 fs-4 fw-bolder">Status</span>
                                            </div>
                                            <div class="col-8">
                                                <div class="d-flex flex-row justify-content-center">
                                                    @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "HOD" && x.Approved == true).Any())
                                                    {
                                                        <div class="badge badge-light-success badge-status">Approved</div>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                        @{
                                                        if(!isProjectCompleted && (userType == "HOD" || userType == "SuperAdmin") && IsDepartmentSame)
                                                        {
                                                                                            @:class="btn btn-sm btn-primary me-3"
                                                                                            @:onclick="approveOrReject('HOD',1)"
                                                        }
                                                        else{
                                                                                            @:class="btn btn-sm btn-secondary me-3"
                                                                                            @:disabled="disabled"
                                                        }
                                                        }>
                                                            Approve
                                                        </button>
                                                        <button type="button"
                                                        @{
                                                        if(!isProjectCompleted && (userType == "HOD" || userType == "SuperAdmin") && IsDepartmentSame)
                                                        {
                                                                                            @:class="btn btn-sm btn-danger me-3"
                                                                                            @:onclick="approveOrReject('HOD',0)"
                                                        }
                                                        else{
                                                                                            @:class="btn btn-sm btn-secondary me-3"
                                                                                            @:disabled="disabled"
                                                        }
                                                        }>
                                                            Reject
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-6">
                                            <div class="col-6 text-start">
                                                <span class="w-100 fs-4 fw-bolder">Date</span>
                                            </div>
                                            <div class="col-6">
                                                @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "HOD" && x.Approved == true).Any())
                                                {
                                                    <span>@Model.PRApprovers.FirstOrDefault(x => x.Type == "HOD" && x.Approved == true).LastUpdated.ToString("dd MMM yyyy HHmm")</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @if (Model.totalApprover > 1)
                            {
                                <div class="col-sm-12 col-lg-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="card-title fs-3 fw-bolder">Approver 2</div>
                                        </div>
                                        <div class="card-body">
                                            <div class="row mb-6">
                                                <div class="col-6 text-start">
                                                    <span class="w-100 fs-4 fw-bolder">GFC</span>
                                                </div>
                                                <div class="col-6">
                                                    @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "GFC" && x.Approved == true).Any())
                                                    {
                                                        <span>@Model.PRApprovers.FirstOrDefault(x => x.Type == "GFC" && x.Approved == true).Approver.UserName</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="row mb-6">
                                                <div class="col-4 text-start">
                                                    <span class="w-100 fs-4 fw-bolder">Status</span>
                                                </div>
                                                <div class="col-8">
                                                    <div class="d-flex flex-row justify-content-center">
                                                        @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "GFC" && x.Approved == true).Any())
                                                        {
                                                            <div class="badge badge-light-success badge-status">Approved</div>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                        @{
                                                        if(!isProjectCompleted && (userType == "GFC" || userType == "SuperAdmin") && Model.PRApprovers.Any(x => x.Type == "HOD" && x.Approved))
                                                        {
                                                                                            @:class="btn btn-sm btn-primary me-3"
                                                                                            @:onclick="approveOrReject('GFC',1)"
                                                        }
                                                        else{
                                                                                            @:class="btn btn-sm btn-secondary me-3"
                                                                                            @:disabled="disabled"
                                                        }
                                                        }>
                                                                Approve
                                                            </button>
                                                            <button type="button"
                                                        @{
                                                        if(!isProjectCompleted && (userType == "GFC" || userType == "SuperAdmin") && Model.PRApprovers.Any(x => x.Type == "HOD" && x.Approved))
                                                        {
                                                                                            @:class="btn btn-sm btn-danger me-3"
                                                                                            @:onclick="approveOrReject('GFC',0)"
                                                        }
                                                        else{
                                                                                            @:class="btn btn-sm btn-secondary me-3"
                                                                                            @:disabled="disabled"
                                                        }
                                                        }>
                                                                Reject
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row mb-6">
                                                <div class="col-6 text-start">
                                                    <span class="w-100 fs-4 fw-bolder">Date</span>
                                                </div>
                                                <div class="col-6">
                                                    @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "GFC" && x.Approved == true).Any())
                                                    {
                                                        <span>@Model.PRApprovers.FirstOrDefault(x => x.Type == "GFC" && x.Approved == true).LastUpdated.ToString("dd MMM yyyy HHmm")</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (Model.totalApprover > 2)
                            {
                                <div class="col-sm-12 col-lg-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="card-title fs-3 fw-bolder">Approver 3</div>
                                        </div>
                                        <div class="card-body">
                                            <div class="row mb-6">
                                                <div class="col-6 text-start">
                                                    <span class="w-100 fs-4 fw-bolder">CEO</span>
                                                </div>
                                                <div class="col-6">
                                                    @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "CEO" && x.Approved == true).Any())
                                                    {
                                                        <span>@Model.PRApprovers.FirstOrDefault(x => x.Type == "CEO" && x.Approved == true).Approver.UserName</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="row mb-6">
                                                <div class="col-4 text-start">
                                                    <span class="w-100 fs-4 fw-bolder">Status</span>
                                                </div>
                                                <div class="col-8">
                                                    <div class="d-flex flex-row justify-content-center">
                                                        @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "CEO" && x.Approved == true).Any())
                                                        {
                                                            <div class="badge badge-light-success badge-status">Approved</div>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                        @{
                                                        if(!isProjectCompleted && (userType == "CEO" || userType == "SuperAdmin") && Model.PRApprovers.Any(x => x.Type == "HOD" && x.Approved) && Model.PRApprovers.Any(x => x.Type == "GFC" && x.Approved))
                                                        {
                                                                                            @:class="btn btn-sm btn-primary me-3"
                                                                                            @:onclick="approveOrReject('CEO',1)"
                                                        }
                                                        else{
                                                                                            @:class="btn btn-sm btn-secondary me-3"
                                                                                            @:disabled="disabled"
                                                        }
                                                        }>
                                                                Approve
                                                            </button>
                                                            <button type="button"
                                                        @{
                                                        if(!isProjectCompleted && (userType == "CEO" || userType == "SuperAdmin") && Model.PRApprovers.Any(x => x.Type == "HOD" && x.Approved) && Model.PRApprovers.Any(x => x.Type == "GFC" && x.Approved))
                                                        {
                                                                                            @:class="btn btn-sm btn-danger me-3"
                                                                                            @:onclick="approveOrReject('CEO',0)"
                                                        }
                                                        else{
                                                                                            @:class="btn btn-sm btn-secondary me-3"
                                                                                            @:disabled="disabled"
                                                        }
                                                        }>
                                                                Reject
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row mb-6">
                                                <div class="col-6 text-start">
                                                    <span class="w-100 fs-4 fw-bolder">Date</span>
                                                </div>
                                                <div class="col-6">
                                                    @if (Model.PRApprovers != null && Model.PRApprovers.Where(x => x.Type == "CEO" && x.Approved == true).Any())
                                                    {
                                                        <span>@Model.PRApprovers.FirstOrDefault(x => x.Type == "CEO" && x.Approved == true).LastUpdated.ToString("dd MMM yyyy HHmm")</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* <div class="form-group pt-3">
                                <div class="d-flex flex-row justify-content-end">
                                    <button type="button" onclick="backToSubmit('RFQ Approved','@FormType.PR')" class="btn btn-primary mx-2" >Back to Submit</button>
                                </div>
                            </div> *@
                        }

                           @if (bomStatus == "PR Sent" || bomStatus == "PR Approved")
                        {
                            <div class="form-group pt-3">
                                <div class="d-flex flex-row justify-content-end">
                                    <button type="button" onclick="backToSubmit('RFQ Approved','@FormType.PR')" class="btn btn-primary mx-2">Back to Submit</button>
                                </div>
                            </div>
                        }

                        @if (bomStatus == "PO Approved")
                        {
                            <div class="form-group pt-3">
                                <div class="d-flex flex-row justify-content-end">
                                    <button type="button" class="btn btn-warning mx-2" data-bs-toggle="modal" data-bs-target="#modal_edit_PR">Revise PR</button>
                                </div>
                            </div>
                        }

                        <div class="d-flex flex-row justify-content-end">
                            @if (bomStatus == "PR Reject")
                            {
                                <button type="button" onclick="backToSubmit('RFQ Approved','@FormType.PR')" class="btn btn-primary mx-2">Back to Submit</button>

                            }
                            @if (((bomStatus == "RFQ Approved" || bomStatus == "PR Reject" || bomStatus == "PO Reject") && bomStatus != "PO Revise") && allowSubmit)
                            {
                                <button type="button" id="deleteBtn" class="btn btn-danger mr-2 text-end">Delete</button>
                               
                            }
                            @if((bomStatus == "RFQ Approved" || bomStatus == "PR Reject" || bomStatus == "PO Reject" || bomStatus == "PO Revise") && allowSubmit)
                            {

                                    <input type="submit" id="updateButton" name="updateButton" value="Save" class="btn btn-success mr-2" />
                                    <button type="button" id="submitBtn" class="btn btn-primary">Submit</button>          
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>
</div>

@if(@Context.Request != null){
    <a href="@Context.Request.Headers[HeaderNames.Referer]">Back To Details</a>
}

<div class="modal fade" id="modal_approve_reject_pr" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <!--begin::Modal content-->
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <!--begin::Close-->
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                    <!--end::Svg Icon-->
                </div>
                <!--end::Close-->
            </div>
            <!--begin::Modal header-->
            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <!--begin:Form-->
                <form asp-action="approveOrReject" method="post" class="form">
                    <!--begin::Heading-->
                    <div class="mb-13 text-center">
                        <!--begin::Title-->
                        <h1 id="remarkTitle" class="mb-3">Reject Form</h1>
                        <!--end::Title-->
                        <!--begin::Description-->
                        <div class="text-muted fw-bold fs-5">
                            If you need more info, please check
                            <a href="#" class="fw-bolder link-primary">Project Guidelines</a>.
                        </div>
                        <!--end::Description-->
                    </div>
                    <!--end::Heading-->
                    <!--begin::Input group-->
                    <div class="d-flex flex-column mb-8 fv-row">
                        <label class="required fs-6 fw-bold mb-2">Reason</label>
                        <textarea class="form-control form-control-solid" placeholder="Reason..." rows="2" name="remark" required></textarea>
                    </div>

                    <input name="approver" id="rm_approver" value="" hidden/>
                    <input name="empId" value=@Context.GetUserId() hidden/>
                    <input name="action" id="rejectOrApprove" hidden/>
                    <input name="prId" value=@Model.Id hidden/>
                    <!--begin::Actions-->
                    <div class="text-center">
                         <button type="submit" class="btn btn-primary">
                            <span class="indicator-label">Submit</span>
                        </button>
                    </div>
                     <div id="loading-spinner" style="text-align:center;display:none;margin-top:20px;">
                        <div class="spinner-border text-info" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                        <p class="text-active-success">Creating new form. Please wait...</p>
                    </div>
                </form>
                <!--end:Form-->
            </div>
            <!--end::Modal body-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>

