        function backToSubmit(status,formType){
            $.post('@Url.Action("reverseStatus","RFQ")', {id:@Model.Id,status,formType}, function() {
                location.reload();
            });
        }
        
        $("#editPR_submit").click(function () {
            
            const remark = $("#reviseRemark").val().trim();
            
            if (!remark) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Please enter a reason',
                    text: 'A reason is required before revising the PR.'
                });
                return;
            }
            
            // disable buttons and show loading spinner
            $("#editPR_submit").attr("disabled", true);
            $("#editPR_modal_close").attr("disabled", true);
            $("#loading-spinner-editPR").show();

            $.ajax({
                url: '/PoTracker/POWithRemark', 
                type: 'POST',
                data: {
                    prId: @Model.Id,   
                    type: 1,          
                    remark: remark    
                },
                success: function () {
                    Swal.fire({
                        icon: 'success',
                        title: 'PR revised successfully!',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        location.reload(); // refresh page after success
                    });
                },
                error: function (xhr) {
                    console.error(xhr);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error revising PR',
                        text: 'Something went wrong, please try again.'
                    });
                },
                complete: function () {
                    $("#loading-spinner-editPR").hide();
                    $("#editPR_submit").removeAttr("disabled");
                    $("#editPR_modal_close").removeAttr("disabled");
                }
            });
        });


        function approveOrReject(approver, action) {
            if (approver === 'HOD' && action == 1) {
                $.ajax({
                    url: "@Url.Action("isBudgetExceed")",
                    type: "GET",
                    data: { projectId: @Model.ProjectId},
                    success: function (result) {
                        if (result) {
                            Swal.fire({
                                text: "The total spend have been exceed budget. Are you sure you still want to approve?",
                                icon: "info",
                                showCancelButton: true,
                                buttonsStyling: false,
                                confirmButtonText: "Yes, approve it!",
                                cancelButtonText: "No, return",
                                customClass: {
                                    confirmButton: "btn btn-primary",
                                    cancelButton: "btn btn-active-light"
                                }
                            }).then(function (result) {
                                if (result.value) {
                                    showApproveRejectModal(approver, action);
                                }
                            });
                        } else {
                            showApproveRejectModal(approver, action);
                        }
                    }
                });
            } else {
                showApproveRejectModal(approver, action);
            }
        }

        function showApproveRejectModal(approver, action) {
            if(action == 0){
                $("#remarkTitle").html("Reject Form");
            }
            else{
                $("#remarkTitle").html("Approve Form");
            }
             $("#rm_approver").val(approver);
            $("#rejectOrApprove").val(action);
            $("#modal_approve_reject_pr").modal("show");
        }


        const data = @Html.Raw(string.IsNullOrEmpty(Model.Data) ? "{}" : Model.Data);
        
        try {
            if (data && Array.isArray(data.components)) {
                 const findAndFixTotalPrice = (components) => {
                    if (!components || !Array.isArray(components)) return;
                    components.forEach(c => {
                        if (!c) return;
                        if (c.key === 'totalPrice') {
                            //c.calculateValue = "value = (row.unitPrice || 0) * (row.totalQuantity || 0);";
                        }
                        if (c.components) findAndFixTotalPrice(c.components);
                        if (Array.isArray(c.columns)) c.columns.forEach(col => findAndFixTotalPrice(col.components));
                        if (Array.isArray(c.rows)) {
                            c.rows.forEach(r => {
                                if (Array.isArray(r)) {
                                    r.forEach(cell => {
                                        if (cell && cell.components) findAndFixTotalPrice(cell.components);
                                    });
                                }
                            });
                        }
                    });
                };
                findAndFixTotalPrice(data.components);
            }
        } catch (e) {
            console.error("Error applying price fix patch:", e);
        }

        const submission = @Html.Raw(string.IsNullOrEmpty(Model.DataResponse) ? "{data:{'auth':'"+ViewBag.auth+"' ,'gridHeader':[{'code': '"+ ViewBag.projectCode +"','customer':'" + ViewBag.customer + "','poNumber':'" + ViewBag.poNo +"','projectName':'"+ ViewBag.projectName + "','projectCategory':'" + @ViewBag.category + "','poQuantity':'"+ ViewBag.poQuantity + "','requester':'"+ ViewBag.requester+"','department':'"+ViewBag.department+"','buyer':'"+ViewBag.buyer+"' }] }} " : Model.DataResponse);
        var check = ('@bomStatus' == "RFQ Approved" || '@bomStatus' == "PR Sent" || 
        '@bomStatus' == "PR Reject" || '@bomStatus' == "PO Reject" || '@bomStatus' ==  "PO Revise") ? true : false;
        var stateOptions = {};
        if (!check) {
            console.log('check')
           stateOptions = {
                readOnly: true,
              //  viewOnly: true
            }
        }

        var builder;
        var renderer;
        var state = {
            formioVersion: 'default',
            form: data,
            submission: submission,
            options: stateOptions,
        };

        function initBuilder(form) {
            if (builder) {
                builder.instance.destroy();
            }
            builder = new Formio.FormBuilder(document.getElementById('builder'), form, _.cloneDeep(state.options));

            builder.instance.ready.then(function() {
                builder.instance.on('change', function(event, flags) {
                    if (!flags) {
                        setForm(builder.instance.schema, 'builder');
                    }
                });
            })
        }

        function initRenderer(form) {
            if (renderer) {
                renderer.destroy();
            }

            Formio.createForm(document.getElementById('render'), form, _.cloneDeep(state.options))
                .then(function(self) {
                    renderer = self;
                    renderer.submission = state.submission;
                    
                    renderer.ready.then(() => {         
                        const hideColumnCheckbox = renderer.getComponent('selectBoxes1');

                        if (hideColumnCheckbox) {
                            // Try to unlock through Form.io API
                            hideColumnCheckbox.disabled = false;
                            hideColumnCheckbox.options.readOnly = false;
                            hideColumnCheckbox.options.disabled = false;

                            // Directly enable the DOM checkboxes (force clickable)
                            setTimeout(() => {
                                const inputs = document.querySelectorAll('[name^="data[selectBoxes1]"]');
                                inputs.forEach(input => {
                                    input.removeAttribute('disabled');
                                    input.style.pointerEvents = 'auto';
                                    input.style.opacity = '1';
                                    input.disabled = false;
                                });
                            }, 300);
                        }
                    });

                    renderer.on('change', function(event, flags) {
                        if (flags && !flags.fromSubmission) {
                            setSubmission(renderer.submission, 'renderer');
                        }
                    });
                });

            document.getElementsByName('Data').value = JSON.stringify(form)
        }

        function setForm(form, from) {
            console.log('setForm', form, from);
            state.form = form;
            //if (!renderer.checkData()) {
            //    document.getElementById("submitBtn").disabled = true;
            //} else {
            //    document.getElementById("submitBtn").disabled = false;
            //}

        }

        function setSubmission(submission, from) {
            console.log('setSubmission', submission, from);
            if (renderer && from !== 'renderer') {
                renderer.submission = submission;
            }
            document.getElementsByName('DataResponse')[0].value = JSON.stringify(submission);
        }

        function addPendingItems(){
            $.post('@Url.Action("addPendingItems")', { id: @Model.Id, dataResponse: JSON.stringify(renderer.submission) }, function () {
                location.reload();
            });
        }

        function exportExcel(id){
            Swal.showLoading()
             $.post('@Url.Action("Edit")', { id, dataResponse: JSON.stringify(renderer.submission) }, function () {
                window.location.href = '/PurchaseRequisition/ExportToExcel?id='+id;
                Swal.hideLoading()
            });
        }

        function exportExcel2026(id){
            Swal.showLoading()
             $.post('@Url.Action("Edit")', { id, dataResponse: JSON.stringify(renderer.submission) }, function () {
                window.location.href = '/PurchaseRequisition/ExportToExcel2026?id='+id;
                Swal.hideLoading()
            });
        }

        initBuilder(state.form);
        initRenderer(state.form);

        if (submission == null) {
            submission.data.header.push({
                code: '@ViewBag.projectCode',
                poNumber: '@ViewBag.poNo',
                projectName: '@ViewBag.projectName',
                projectCategory: '@ViewBag.category',
                customer: '@ViewBag.customer',
                poQuantity: '@ViewBag.poQuantity',
                supplierName: '@ViewBag.supplierName'
            });
        }

        $('#backtoBOM').click(function () {
            window.location.href = "@Url.Action("Index", "BOM")" + "?id=" + @Model.ProjectId
        });
    </script>
