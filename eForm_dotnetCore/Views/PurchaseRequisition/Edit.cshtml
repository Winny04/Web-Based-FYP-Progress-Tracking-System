<div class="modal fade" id="modal_edit_PR" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1"
                                  transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1"
                                  transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>

            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-8 text-center">
                    <h1 class="mb-3">Revise Purchase Requisition</h1>
                    <div class="text-muted fw-bold fs-5">
                        Please provide a reason for revising this PR.
                    </div>
                </div>

                <div class="mb-5">
                    <label class="form-label fw-bold">Revision Reason</label>
                    <textarea id="reviseRemark" class="form-control" rows="3"
                              placeholder="Enter your reason for revision..."></textarea>
                </div>

                <div class="text-center">
                    <button type="button" id="editPR_modal_close" class="btn btn-light me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="editPR_submit" class="btn btn-primary">Submit</button>
                </div>

                <div id="loading-spinner-editPR" style="text-align:center;display:none;margin-top:20px;">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="text-active-success">Processing revision... Please wait...</p>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Function To Edit Form
        $(document).ready(function() {

            $("#submitBtn").click(function() {
                if (!renderer.checkData()) {
                     //Swal.fire("Please complete the required item before submitting the form!");
                    var errorField = [];
                      renderer.everyComponent((component) => {
                        if (component.component.validate.required === true && (component.getValue() === null || component.getValue() === "")) { 
                            errorField.push(component.component.label);
                        }
                    });
                    Swal.fire('Please complete the following items:\n' + errorField.toString());

                }
                else{
                    var form = $('#fillForm').serialize();
                    Swal.fire({
                        text: "Are you sure you would like to submit?",
                        icon: "warning",
                        showCancelButton: true,
                        buttonsStyling: false,
                        confirmButtonText: "Yes",
                        cancelButtonText: "No",
                        customClass: {
                            confirmButton: "btn btn-primary",
                            cancelButton: "btn btn-active-light"
                        }
                    }).then(function(result) {
                        if (result.value) {
                            $.ajax({
                                url: "@Url.Action("isBudgetExceed")",
                                type: "GET",
                                data: { projectId: @Model.ProjectId},
                                success: function (result) {
                                    if (result) {
                                        Swal.fire({
                                            text: "The total spend have been exceed budget. Are you sure you still want to submit?",
                                            icon: "info",
                                            showCancelButton: true,
                                            buttonsStyling: false,
                                            confirmButtonText: "Yes, submit it!",
                                            cancelButtonText: "No, return",
                                            customClass: {
                                                confirmButton: "btn btn-primary",
                                                cancelButton: "btn btn-active-light"
                                            }
                                        }).then(function (result) {
                                            if (result.value) {
                                                Swal.fire({
                                                    title: '<div class="spinner-border text-info" role="status"><span class="sr-only">Loading...</span></div>',
                                                    text: "Please wait...",
                                                    icon: "success",
                                                    showCancelButton: false,
                                                    showConfirmButton: false,
                                                    buttonsStyling: false,
                                                });
                                                //form.reset(); // Reset form
                                                var isProjectCompleted = false;
                                                $.post('@Url.Action("Submit", "PurchaseRequisition")', form, function(res) {
                                                    console.log("result", res);
