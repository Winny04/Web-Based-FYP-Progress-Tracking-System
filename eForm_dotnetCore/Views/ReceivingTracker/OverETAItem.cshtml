@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.ViewModels
@using Microsoft.AspNetCore.Authorization
@using eForm_dotnetCore.Configuration.Auhtorization;

@{
    ViewData["Title"] = "Overdue ETA Items";
}
<div id="kt_content_container" class="container-fluid d-flex flex-column-fluid align-items-start">
    <div class="content flex-row-fluid" id="kt_content">
        <div class="card card-flush mb-5 mb-xl-8">
            <div class="card-header">
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-2">
                        <h3 class="d-flex align-items-center fw-bolder">
                            <span class="card-label fw-bolder fs-3 mb-1">Overdue ETA Items</span>
                        </h3>
                    </div>
                </div>
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-2">
                        <div class="d-flex align-items-center position-relative mr-2">
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search table" style="height:36px;" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-secondary" onclick="downloadExcelTemplate()">
                                <i class="fas fa-download me-2"></i> Download Excel Template
                            </button>

                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                                <i class="fas fa-file-import me-2"></i> Bulk Mark Received
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblOverEta" class="table table-row-gray-300 align-middle gs-0 gy-4">
                        <thead>
                            <tr class="fw-bolder fs-6 text-uppercase text-center">
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Item No</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Status</b></th>
                                <th class="min-w-100px tableCellBorderRight smallThText"><b>Description</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Brand</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Project Code</b></th>
                                <th class="min-w-70px tableCellBorderRight smallThText"><b>Project Name</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>PR No.</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>PO</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>ETA</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Days Over ETA</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Action</b></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="importExcelModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Mark Items as Received</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Instructions:</strong>
                    <ol class="mb-0 mt-2">
                        <li>Download the Excel template first</li>
                        <li>Fill 'Y' in the "Mark Received (Y/N)" column</li>
                        <li>Upload the completed file here</li>
                        <li>Items marked with 'Y' will be updated to "Item Received" status</li>
                    </ol>
                </div>

                <form id="importExcelForm">
                    <div class="form-group mb-4">
                        <label class="form-label">Select Excel File:</label>
                        <input type="file" name="excelFile" id="excelFile" class="form-control" accept=".xlsx,.xls" required />
                        <div class="form-text">Only .xlsx or .xls files are accepted</div>
                    </div>

                    <div class="progress mb-3 d-none" id="uploadProgress">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                    </div>

                    <div id="uploadResult" class="d-none"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="uploadExcelFile()" id="uploadBtn">
                    <i class="fas fa-upload me-2"></i> Upload & Update
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var table = document.getElementById("tblOverEta");
            var dataTable = $(table).DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                searchDelay: 500,
                drawCallback: function () {
                    $('#mytable td').css('color', 'black');
                    $('#mytable td').css('font-size', '15px');
                    $('#mytable td').css('border-right', '2px solid #D3D3D3');
                },
                "ajax": {
                    "url": "@Url.Action("GetOverEtaItems")",
                    "type": "POST"
                },
                "pagingType": "full_numbers",
                columnDefs: [
                    {
                        targets: 0,
                        render: function (data, type, row) {
                            return row.itemNo;
                        }
                    },
                    {
                        targets: 1,
                        render: function (data, type, row) {
                            if (row.status === "New" || row.status === "PR Sent" || row.status === "Item Issued Out") {
                                return `<div class="badge badge-light-primary badge-status">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Sent" || row.status === "PR Approved" || row.status === "PO Revise") {
                                return `<div class="badge badge-light-warning badge-status">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Updated" || row.status === "PO Approved") {
                                return `<div class="badge badge-light-info">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Approved" || row.status === "Item Received" || row.status === "Completed") {
                                return `<div class="badge badge-light-success">${row.status}</div>`
                            }
                            else if (row.status === "RFQ Reject" || row.status === "PR Reject" || row.status === "Receiving Reject" || row.status === "PO Reject" || row.status === "PO Cancelled") {
                                return `<div class="badge badge-light-danger badge-status">${row.status}</div>`
                            }
                        }
                    },
                    {
                        targets: 2,
                        render: function (data, type, row) {
                            return row.desc
                        }
                    },
                    {
                        targets: 3,
                        render: function (data, type, row) {
                            return row.brand
                        }
                    },
                    {
                        targets: 4,
                        render: function (data, type, row) {
                            return row.projectCode
                        }
                    },
                    {
                        targets: 5,
                        render: function (data, type, row) {
                            return row.projectName
                        }
                    },
                    {
                        targets: 6,
                        render: function (data, type, row) {
                            return `<a href="/PurchaseRequisition/Edit/${row.prId}" class="link-primary"><b>${row.prNo}</b></a>`
                        }
                    },
                    {
                        targets: 7,
                        render: function (data, type, row) {
                            if (row.poId !== null) {
                                return `<a class="text-primary text-hover-underline" onclick="openPDF(${row.poId})">${row.poName}</a>`
                            }
                            else{
                                return ""
                            }
                        }
                    },
                    {
                        targets:8,
                        render: function (data, type, row) {
                            if (row.poId !== null) {
                                return `${moment(row.eta).format('DD-MMM-YYYY')} `
                            }
                        }
                    },
                    {
                        targets:9,
                        render: function (data, type, row) {
                            return `${row.daysOverEta} days`
                        }
                    },
                    {
                        targets:10,
                        render: function (data, type, row) {
                            return `<a onclick="markCompleted(${row.prId})" class="btn text-white btn-sm btn-primary">Mark Received</a>`
                        }
                    },
                ],
            });

            dataTable.on('processing.dt', function (e, settings, processing) {
                if (processing) {
                    Swal.showLoading()
                } else {
                    Swal.close();
                }
            });

            var filterSearch = document.getElementById('filter_search');
            filterSearch.addEventListener('keyup', function (e) {
                dataTable.search(e.target.value).draw();
            });

        }); 

        function downloadExcelTemplate() {
            Swal.fire({
                title: 'Downloading Template',
                text: 'Please wait...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            var dataTable = $('#tblOverEta').DataTable();

                   
            var pageInfo = dataTable.page.info();
            var length = pageInfo.length;    
            var start = pageInfo.start;       

            window.location.href = '@Url.Action("DownloadOverdueETATemplate", "ReceivingTracker")' + '?length=' + length + '&start=' + start;

            setTimeout(() => {
                Swal.close();
                Swal.fire({
                    title: 'Template Downloaded',
                    html: `
                        <div class="text-start">
                            <p><strong>Instructions:</strong></p>
                            <ol>
                                <li>Open the downloaded Excel file</li>
                                <li>Fill 'Y' in the "Mark Received (Y/N)" column for items you want to mark as received</li>
                                <li>Save the file</li>
                                <li>Upload it using the "Bulk Mark Received" button</li>
                            </ol>
                            <p class="text-muted"><small>Downloaded ${length} records (current page view)</small></p>
                            <p class="text-muted"><small>Do not modify the Item No, PR No, or PO File ID columns</small></p>
                        </div>
                    `,
                    icon: 'info',
                    confirmButtonText: 'OK'
                });
            }, 1000);
        }

        function uploadExcelFile() {
            var fileInput = document.getElementById('excelFile');
            var file = fileInput.files[0];
            var dataTable = $('#tblOverEta').DataTable();   
            if (!file) {
                Swal.fire({
                    text: 'Please select an Excel file first.',
                    icon: 'warning',
                    confirmButtonText: 'OK'
                });
                return;
            }

            var extension = file.name.split('.').pop().toLowerCase();
            if (extension !== 'xlsx' && extension !== 'xls') {
                Swal.fire({
                    text: 'Please upload only Excel files (.xlsx or .xls).',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                return;
            }

            Swal.fire({
                title: 'Confirm Upload',
                text: 'Are you sure you want to upload and update items?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Upload',
                cancelButtonText: 'Cancel',
                customClass: {
                    confirmButton: 'btn btn-primary',
                    cancelButton: 'btn btn-light'
                }
            }).then((result) => {
                if (result.isConfirmed) {

                    var formData = new FormData();
                    formData.append('excelFile', file);

                    $('#uploadProgress').removeClass('d-none');
                    $('#uploadBtn').prop('disabled', true);

                    var progress = 0;
                    var progressInterval = setInterval(() => {
                        progress += 10;
                        if (progress > 90) progress = 90;
                        $('#uploadProgress .progress-bar').css('width', progress + '%');
                    }, 200);

                    $.ajax({
                        url: '@Url.Action("BulkUpdateReceivedFromExcel", "ReceivingTracker")',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function(response) {
                          clearInterval(progressInterval);
                          $('#uploadProgress .progress-bar').css('width', '100%');

                         if (response.success) {
                             if (response.updatedCount > 0) {
                                 Swal.fire({
                                   title: 'Success!',
                                   html: `
                                     <div class="text-start">
                                          <p>${response.message}</p>
                                          ${response.updatedCount > 0 ?
                                             `<p class="text-success"><i class="fas fa-check-circle me-2"></i>Updated: ${response.updatedCount} items</p>` : ''}
                                          ${response.skippedCount > 0 ?
                                              `<p class="text-warning"><i class="fas fa-exclamation-circle me-2"></i>Skipped: ${response.skippedCount} items</p>` : ''}
                                          ${response.errorCount > 0 ?
                                              `<p class="text-danger"><i class="fas fa-times-circle me-2"></i>Errors: ${response.errorCount}</p>` : ''}
                                          <hr>
                                          <div class="alert alert-warning mt-3">
                                             <i class="fas fa-exclamation-triangle me-2"></i>
                                             <strong>Important:</strong> Updated items have been removed from the overdue list.
                                             If you want to update more items, please <strong>re-download the Excel template</strong>
                                             to get the latest data.
                                           </div>
                                       </div>
                                     `,
                                     icon: 'success',
                                     confirmButtonText: 'OK, Got It',
                                     showCancelButton: true,
                                     cancelButtonText: 'Download New Template',
                                     customClass: {
                                         confirmButton: 'btn btn-success',
                                         cancelButton: 'btn btn-primary'
                                      }
                                  }).then((result) => {
                                        if (result.dismiss === Swal.DismissReason.cancel) {
                          
                                            downloadExcelTemplate();
                                         }

                     
                                        if (typeof dataTable !== 'undefined') {
                                            dataTable.ajax.reload();
                                          }

                      
                                       $('#importExcelModal').modal('hide');
                                       $('#importExcelForm')[0].reset();
                                       $('#uploadResult').addClass('d-none').html('');
                                   });
                              } else {
                   
                              Swal.fire({
                                 title: 'No Changes Made',
                                 html: `
                                     <div class="text-start">
                                         <p>${response.message}</p>
                                         <div class="alert alert-info mt-3">
                                             <i class="fas fa-info-circle me-2"></i>
                                             No items were marked with 'Y' in the Excel file.
                                      </div>
                                     </div>
                                  `,
                                  icon: 'info',
                                  confirmButtonText: 'OK'
                              }).then(() => {
                                  if (typeof dataTable !== 'undefined') {
                                      dataTable.ajax.reload();
                               }
                              $('#importExcelModal').modal('hide');
                              $('#importExcelForm')[0].reset();
                              $('#uploadResult').addClass('d-none').html('');
                           });
                         }
                      } else {
                          Swal.fire({
                              title: 'Upload Failed',
                              text: response.message,
                              icon: 'error',
                              confirmButtonText: 'OK'
                          });
                        }
                      },
                        error: function(xhr, status, error) {
                            clearInterval(progressInterval);
                            Swal.fire({
                                title: 'Upload Error',
                                text: 'An error occurred during upload: ' + error,
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });
                        },
                        complete: function() {
                            $('#uploadProgress').addClass('d-none');
                            $('#uploadBtn').prop('disabled', false);
                            $('#uploadProgress .progress-bar').css('width', '0%');
                        }
                    });
                }
            });
        }

        $('#excelFile').on('change', function() {
            var file = this.files[0];
            if (file) {
                var extension = file.name.split('.').pop().toLowerCase();
                if (extension !== 'xlsx' && extension !== 'xls') {
                    Swal.fire({
                        text: 'Please select only Excel files (.xlsx or .xls)',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        $(this).val('');
                    });
                }
            }
        });

        function markCompleted(prId){
            Swal.fire({
                text: "Confirm mark as Completed?",
                icon: "warning",
                showCancelButton: true,
                buttonsStyling: false,
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                customClass: {
                    confirmButton: "btn btn-primary",
                    cancelButton: "btn btn-active-light"
                }
            }).then(function (result) {
                $.ajax({
                    url: '/ReceivingTracker/MarkCompleted',
                    type: 'POST',
                    data: { PrIds : prId },
                    success: function(result) {
                        if(result.status == true){
                             Swal.fire({
                                    text: "BOM has been Marked as Completed",
                                    icon: "success",
                                    showCancelButton: false,
                                    buttonsStyling: false,
                                    confirmButtonText: "Okay",
                                        customClass: {
                                            confirmButton: "btn btn-light-success font-weight-bold mr-2",
                                        }
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                            location.reload();
                                    }
                                });
                        }
                        else{
                             Swal.fire({
                                text: result.msg,
                                icon: "error",
                                buttonsStyling: false,
                                confirmButtonText: "Ok",
                                customClass: {
                                    confirmButton: "btn btn-primary",
                                }
                            }).then((result) => {
                                if (result.isConfirmed) {
                                       
                                }
                            }); 
                        }
                    }
                });
            });
        }

        function openPDF(supportFileId) {
            window.open("/BOM/ShowPDF?supportFileId=" + supportFileId, "_blank");
        }

    </script>
}