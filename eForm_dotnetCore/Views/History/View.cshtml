                                    //             '<input type="hidden" id="uploadFile_bomId" name="BomId" value="DO" />' +
                                    //             '<input type="hidden" id="uploadFileType" name="types" value="DO" />';
                                    //$("#div-file-do").empty();
                                    //$("#div-file-do").html(doHtml);
                                    location.reload();
                                }//end success
                              });//end ajax
                        }
                    });//end swal

             });

             //Delete uploaded INV
             $(".btnDelINVFromDb").click(function(e){
                 e.preventDefault();
                 var sfId = $(this).data('prid');
                  Swal.fire({
                        text: "Are you sure want to delete?",
                        icon: "warning",
                        showCancelButton: true,
                        buttonsStyling: false,
                        confirmButtonText: "Yes",
                        cancelButtonText: "No",
                        customClass: {
                            confirmButton: "btn btn-primary",
                            cancelButton: "btn btn-active-light"
                        }
                    }).then(function (result) {
                        if (result.value)
                        {
                            var prId = $("#hPRId").val();
