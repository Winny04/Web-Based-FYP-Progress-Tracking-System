@*Model Upload File*@
<div class="modal fade" id="modal_upload_file" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Upload File</h1>
                </div>

                <form asp-controller="BOM" asp-action="attachFile" method="post" enctype="multipart/form-data">
                    <div class="mt-3 my-5 ml-5">
                        <input type="file" name="files" accept="application/pdf" />
                    </div>
                    <input type="hidden" id="uploadFile_bomId" name="bomId" />
                    <input type="hidden" id="uploadFileType" name="types" />
                    <input type="hidden" id="isFromReceiving" name="isFromReceiving" value="true" />

                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Upload</button>
                    </div>

                    <div id="loading-spinner-import" style="text-align:center;display:none;margin-top:20px;">
                        <div class="spinner-border text-info" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                        <p class="text-active-success">Upload in progress. Please wait...</p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@*Modal PIC*@
<div class="modal fade" id="modal_edit_pics" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-850px">
        <div class="modal-content rounded  h-580px">

            <div class="modal-body scroll-y px-10 px-lg-15 pt-3 pb-1">
                <div class="mb-3 mt-3 text-center">
                    <h3 class="mb-1" id="PICModalTitle">Issued Out PIC</h3>
                </div>
                <div class="row" style="display:flex;">
                    <div class="col col-3"><label>Selected PIC: </label></div>
                    <div class="col col-9"><input type="text" id="picPreview" class="form-control form-control-solid" value="" readonly /></div>
                </div>
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-4">
                        <div class="d-flex align-items-center fw-bolder">
                            <span class="svg-icon svg-icon-1 position-absolute ms-4">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <input type="text" id="filter_search_pic" class="form-control form-control-solid w-250px ps-14" placeholder="Search PIC" />
                            <select class="form-select form-select-solid m-4" data-control="select2" data-hide-search="true" data-placeholder="Department" id="departmentFilter">
                                <option value=" ">Show All</option>
                                @{
                                    var deptList = ViewBag.DepartmentList;
                                    @foreach (var item in deptList)
                                    {

                                        <option value="@item">@item</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="text-center">
                            <div id="loading-spinner" class="spinner-border text-info" role="status" style="vertical-align:middle;display:none">
                                <span class="sr-only">Loading...</span>
                            </div>
                            <button type="button" id="btnSavePIC" class="btn btn-success" style="width:150px">
                                <span class="indicator-label">Save</span>
                            </button>
                        </div>
                        @*<div id="loading-spinner" style="text-align:center;display:none;margin-top:20px;">
                            <div class="spinner-border text-info" role="status">
                            <span class="sr-only">Loading...</span>
                            </div>
                            <p class="text-active-success">Saving PIC. Please wait...</p>
                            </div>*@
                    </div>
                </div>
                @*UserList Template*@
                <div class="card-body pt-0">

                    <table class="table align-middle fs-6" id="picTable">
                        <thead>
                            <tr class="fw-bolder text-uppercase gs-0" style="text-align:center;">
                                <th class="w-10px pe-2 text-right">
                                </th>
                                <th class="text-left min-w-90px PicOptions"><b>PIC</b></th>
                                <th hidden><b>Department</b></th>
                        <tbody class="fw-bold text-gray-600">
                                    @if (Model.Any())
                                    {
                                        @foreach (var user in ViewBag.EmployeeList)
                                        {
                                    <tr id="@user.ShortName">
                                        <td class="text-right p-1">
                                            <div class="form-check form-check-sm form-check-custom form-check-solid">
                                                <input class="form-check-input chkboxPIC" type="checkbox" value="'@user.ShortName (@user.Department)'" id="Chkbox-@user.Id" onclick="selectPIC('@user.Id','@user.ShortName','(@user.Department)')" />
                                            </div>
                                        </td>
                                        <td class="text-left PicOptions">
                                                    @user.ShortName   (@user.Department)
                                        </td>
                                        <td hidden>
                                                    @user.Department
                                        </td>
                                    </tr>
                                        }
                                    }
                    </table>
                </div>

                @*<form asp-controller="ReceivingTracker" asp-action="editPICs" method="post">*@
                <input type="hidden" id="picsContainer" name="picsContainer" class="form-control form-control-solid" readonly />
                <input type="hidden" value="" name="bomId" id="hBomIdPIC" />
                <input type="hidden" value="" name="target-bomId" id="hTargetBomId" />
                @* </form>*@
            </div>
        </div>
    </div>
</div>





