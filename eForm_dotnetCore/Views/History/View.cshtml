       function editRec(bomId){
        if(bomId != null){
            $("#hBomId").val(bomId);
            //$("#hPRId").val(prId);
            $("#uploadFile_bomId").val(bomId);
             $.ajax({
                    url: "/ReceivingTracker/GetReceiving",
                    method: "POST",
                    data: {
                        bomId: bomId
                    },
                    success: function(response) {
                         //var eta = "";
                         var receivedDate = "";
                         var issueOutDate = "";
                         //if(response.result[0].estDeliveryDate != null){
                         //    eta = response.result[0].estDeliveryDate.toString().split('T', 1)[0]; //remove time
                         //}
                          if(response.result.receivedDate != null){
                             receivedDate = response.result.receivedDate.toString().split('T', 1)[0]; //remove time
                         }
                          if(response.result.issuedOutDate != null){
                             issueOutDate = response.result.issuedOutDate.toString().split('T', 1)[0]; //remove time
                         }

                         var picIds = response.result.issuedPIC;
                         $.ajax({
                            url : "@Url.Action("GetShortName","ReceivingTracker")",
                            method : 'POST',
                            data : {
                            userIds :picIds
                            },
                            success: function(result) {
                               $("#eIssueOutBy").val(result);
                            }
                         });

                        $("#eReceivedQty").val(response.result.receivedQuantity);
                        $("#eBalanceQty").val(response.result.balanceToReceiveQty);
                        $("#hIssueOutPicId").val(response.result.issuedPIC);
                        $("#eIssueOutDate").val(issueOutDate);
                        $("#eIssueOutQty").val(response.result.issuedQuantity);
                        $("#eBalanceToIssueOutQty").val(response.result.balanceToIssueOutQty);
                        $("#eRemark").val(response.result.receivingRemark);
                        $("#eReceivedDate").val(receivedDate);
                        $("#ePOQty").val(response.poQty);
                        $("#picsContainer").val(response.result.issuedPIC);
                        $("#picPreview").val(response.result.issuedPIC);
                        $("#hFile-do").val(response.fileDO);
                        $("#hFile-invoice").val(response.fileINV);
                        $("#hBomIdPIC").val(bomId);

                         var bomStatus =  response.result.status;
                        HideAndSeek(bomStatus);
                    },
                    error: function(response){

                    }
                    });
        }
    }

      function HideAndSeek(status){
            if(status === "PO Approved"){
                $("#div-file-do").show();
                $("#div-file-inv").show();
                $("#div-file-grn").hide();
                $("#divReceivedDate").show();
                $("#divReceivedQty").show();
                $("#divBalanceQty").hide();
                $("#divIssueOutBy").hide();
                $("#divIssueOutDate").hide();
                $("#divIssueOutQty").hide();
                $("#divBalanceToIssueOutQty").hide();
                $("#divRemark").show();
            }
            else if(status == "Item Received")
            {
                $("#div-file-do").hide();
                $("#div-file-inv").hide();
                $("#div-file-grn").hide();
                $("#divReceivedDate").hide();
                $("#divReceivedQty").hide();
                $("#divBalanceQty").hide();
                $("#divIssueOutBy").show();
                $("#divIssueOutDate").show();
                $("#divIssueOutQty").show();
                $("#divBalanceToIssueOutQty").show();
                $("#divRemark").show();
            }
            else if(status == "Item Issued Out")
            {
                $("#div-file-do").hide();
                $("#div-file-inv").hide();
                $("#div-file-grn").show();
                $("#divReceivedDate").hide();
                $("#divReceivedQty").hide();
                $("#divBalanceQty").hide();
                $("#divIssueOutBy").hide();
                $("#divIssueOutDate").hide();
                $("#divIssueOutQty").hide();
                $("#divBalanceToIssueOutQty").hide();
                $("#divRemark").show();
            }

      }

