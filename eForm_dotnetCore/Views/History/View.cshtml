@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.ViewModels
@using Microsoft.AspNetCore.Authorization
@using eForm_dotnetCore.Configuration.Auhtorization;

@inject IAuthorizationService AuthorizationService

@model IEnumerable<HistoryModel>

@{
    ViewData["Title"] = PageTitle.History + " - " + @Model.Select(x => x.PrName).FirstOrDefault();

    var authResource = new AuthResource("Type", "Finance", null);
    var canWrite = await AuthorizationService.AuthorizeAsync(User, authResource, new UserTypeRequirement());
}
<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">

        <div class="card card-flush mb-5 mb-xl-8">
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">@PageTitle.ReceivingTracker - Item List  </span>
                </h3>
            </div>

            <div class="row col-12 mx-3" style="width:98%;">
                <div class="col-2  p-2">
                    <b>PR Number: </b>
                    <div class="flex-column mb-2 fv-row">
                        <a href="/PurchaseRequisition/Edit/@Model.Select(x => x.PrId).FirstOrDefault()" class="link-primary"><span><b>@Model.Select(x => x.PrName).FirstOrDefault()</b></span></a>
                    </div>
                </div>
                <div class="col-2  p-2">
                    <b>Project Code: </b>
                    <div class="flex-column mb-2 fv-row">
                        <span>@Model.Select(x => x.ProjectCode).FirstOrDefault()</span>
                    </div>
                </div>
                <div class="col-3  p-2">
                    <b>Project Name: </b>
                    <div class="flex-column mb-2 fv-row">
                        <span>@Model.Select(x => x.ProjectName).FirstOrDefault()</span>
                    </div>
                </div>
                <div class="col-3  p-2">
                    <b>Customer: </b>
                    <div class="flex-column mb-2 fv-row">
                        <span>@Model.Select(x => x.VendorName).FirstOrDefault()</span>
                    </div>
                </div>
                <div class="col-2  p-2">
                    <b>Category: </b>
                    <div class="flex-column mb-2 fv-row">
                        <span>@Model.Select(x => x.ProjectCategory).FirstOrDefault()</span>
                    </div>
                </div>
            </div>

            <div class="row col-12 mx-3 border fileContainer">
                <input type="hidden" id="hPRId" value="@ViewBag.PrId" />
                <input type="hidden" id="hBomIdToPrint" value="@ViewBag.PrId" />
                @*PO*@
                <div class="col-3 border border-left-0 p-2">
                    <b>PO: </b>
                    <div class="flex-column mb-2 fv-row">
                        @{
                            if (Model.Any())
                            {
                                if (Model.FirstOrDefault().PO.Where(x => x.Type == "PO").Any())
                                {
                                    var PO = Model.FirstOrDefault().PO.FirstOrDefault(x => x.Type == "PO");
                                    var sfId = PO.SupportFileId;
                                    <div class="col col-12  border p-1">
                                        <a href="#" onclick="openPDF(@sfId)"> @PO.SupportFile.FileName</a>
                                    </div>
                                }
                                else
                                {
                                    <p>-</p>
                                }
                            }
                        }
                    </div>
                </div>
                @*DO*@
                <div class="col-3 border p-2">
                    <b>DO: </b>

                    <div class="flex-column mb-2 fv-row" id="div-file-do">
                       
                        <input type="hidden" id="uploadFile_bomId" name="BomId" value="DO" />
                        <input type="hidden" id="uploadFileType" name="types" value="DO" />
                        @{
                            if (Model.Any())
                            {
                                foreach (var item in Model.FirstOrDefault().DO.Where(x => x.Type == "DO").ToList())
                                {
                                    if (Model.FirstOrDefault().DO.Where(x => x.Type == "DO").Any())
                                    {
                                        var DO = item;
                                        var sfId = DO.SupportFileId;
                                        <div class="col col-12  border p-1">
                                            <input type="hidden" id="file-do" accept="application/pdf" multiple="multiple" style="display:none" />
                                            <a href="#" onclick="openPDF(@sfId)"> @DO.SupportFile.FileName</a>
                                            
                                        </div>

                                    }
                                }
                                //else
                                //{
                                //    <div class="mb-3 ml-5 d-flex">
                                //        <input type="file" id="file-do" onchange="SelectedFileDo()" name="DO" accept="application/pdf" />
                                //        <input type="button" id="btnDelDO" onclick="DelDo()" href="#" class="btn btn-outline-danger" style="display:none;" value="X" />
                                //    </div>
                                //    <input type="hidden" id="uploadFile_bomId" name="BomId" value="DO" />
                                //    <input type="hidden" id="uploadFileType" name="types" value="DO" />
                                //}
                            }
                        }
                    </div>

                </div>
                @*INV*@
                <div class="col-3 border p-2">
                    <b>Invoice: </b>
                    <div class="flex-column mb-2 fv-row" id="div-file-inv">
                       
                        <input type="hidden" id="uploadFile_bomId" name="BomId" />
                        <input type="hidden" id="uploadFileType" name="types" value="Invoice" />
                        @{
                            if (Model.Any())
                            {
                                foreach (var item in Model.FirstOrDefault().DO.Where(x => x.Type == "INV").ToList())
                                {
                                    if (Model.FirstOrDefault().Invoice.Where(x => x.Type == "INV").Any())
                                    {
                                        var INV = item;
                                        var sfId = INV.SupportFileId;
                                        <div class="col col-12  border p-1">
                                            <input type="hidden" id="file-invoice" accept="application/pdf" multiple="multiple" style="display:none" />
                                            <a href="#" onclick="openPDF(@sfId)"> @INV.SupportFile.FileName</a>
                                        </div>
                                    }
                                }
                                //else
                                //{
                                //    <div class="mb-3 ml-5 d-flex">
                                //        <input type="file" id="file-invoice" onchange="SelectedFileInv()" name="Invoice" multiple="multiple" accept="application/pdf" value="INV" />
                                //        <input type="button" id="btnDelINV" onclick="DelInv()" href="#" class="btn btn-outline-danger" style="display:none;" value="X" />
                                //    </div>
                                //    <input type="hidden" id="uploadFile_bomId" name="BomId" />
                                //    <input type="hidden" id="uploadFileType" name="types" value="Invoice" />
                                //}
                            }
                        }
                    </div>
                </div>
                @*GRN*@
                <div class="col-3 border border-right-0 p-2">
                    <b>GRN: </b>
                    <div class="flex-column mb-2 fv-row" id="div-file-grn">
                      
                        <input type="hidden" id="uploadFile_bomId" name="BomId" />
                        <input type="hidden" id="uploadFileType" name="types" value="GRN" />
                        @{
                            if (Model.Any())
                            {
                                foreach (var item in Model.FirstOrDefault().DO.Where(x => x.Type == "GRN").ToList())
                                {
                                    if (Model.FirstOrDefault().GRN.Where(x => x.Type == "GRN").Any())
                                    {
                                        var GRN = item;
                                        var sfId = GRN.SupportFileId;
                                        <div class="col col-12  border p-1">
                                            <input type="hidden" id="file-grn" accept="application/pdf" style="display:none" />
                                            <a href="#" onclick="openPDF(@sfId)"> @GRN.SupportFile.FileName</a>
                                        </div>
                                    }
                                }
                                //else
                                //{
                                //    <div class="mb-3 ml-5 d-flex">
                                //        <input type="file" id="file-grn" onchange="SelectedFileGrn()" multiple="multiple" name="GRN" accept="application/pdf" value="GRN" />
                                //        <input type="button" id="btnDelGRN" href="#" onclick="DelGrn()" class="btn btn-outline-danger" style="display:none;" value="X" />
                                //    </div>
                                //    <input type="hidden" id="uploadFile_bomId" name="BomId" />
                                //    <input type="hidden" id="uploadFileType" name="types" value="GRN" />
                                //}
                            }
                        }
                    </div>
                </div>



            </div>
            <!--end::Header-->
            <!--begin::Body-->
            @* <div class="card card-flush mb-5 mb-xl-8">*@
            <div class="card-body py-3">
                <div class="d-flex flex-stack flex-wrap gap-4 float-right mb-2">
                 
                    <div class="d-flex align-items-center position-relative my-1">
                        <span class="svg-icon svg-icon-3 position-absolute ms-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                            </svg>
                        </span>
                        <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search table" />
                    </div>
                </div>

                <!--begin::Table container-->
                <div class="table-responsive">

                    <!--begin::Table-->
                    <table id="tblPRItems" class="table table-row-gray-300 align-middle gs-0 gy-4">
                        <!--begin::Table head-->
                        <thead>
                            <tr class="fw-bolder fs-6 text-uppercase text-center">
                                <th class="min-w-35px tableCellBorderLeft tableCellBorderRight smallThText">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid">
                                        <input id="checkedAll" class="form-check-input" type="checkbox" value="" data-kt-check="true" data-kt-check-target=".widget-9-check" style="margin-left:7px;" />
                                    </div>
                                </th>
                                <th class="min-w-50px tableCellBorderLeft tableCellBorderRight smallThText"><b>Item No.</b></th>
                                <th class="min-w-70px tableCellBorderRight smallThText"><b>Status</b></th>
                                @*<th class="min-w-50px tableCellBorderRight smallThText"><b>Request by</b></th>
                                    <th class="min-w-70px tableCellBorderRight smallThText"><b>Project Code</b></th>
                                    <th class="min-w-50px tableCellBorderRight smallThText"><b>Project PO</b></th>
                                    <th class="min-w-70px tableCellBorderRight smallThText"><b>Customer</b></th>
                                    <th class="min-w-70px tableCellBorderRight smallThText"><b>Project Name</b></th>
                                    <th class="min-w-70px tableCellBorderRight smallThText"><b>Category</b></th>*@
                                @*<th class="min-w-70px tableCellBorderRight smallThText" ><b>Department</b></th>*@
                                @*<th class="min-w-50px tableCellBorderRight smallThText" ><b>Supplier Name</b></th>*@
                                @*<th class="min-w-50px tableCellBorderRight smallThText" ><b>PR no.</b></th>*@
                                @*<th class="min-w-50px tableCellBorderRight smallThText" ><b>PR line</b></th>*@

                                <th class="min-w-50px tableCellBorderRight smallThText"><b>PO Line No.</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Issue Form Status</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>PO Qty.</b></th>
                                <th class="min-w-150px tableCellBorderRight smallThText"><b>Description</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Brand</b></th>
                                <th class="min-w-70px tableCellBorderRight smallThText"><b>Part No.</b></th>
                                <th class="min-w-70px tableCellBorderRight smallThText"><b>Unit Price</b></th>
                                <th class="min-w-70px tableCellBorderRight smallThText"><b>Total Price</b></th>
                                <th class="min-w-70px tableCellBorderRight smallThText"><b>ETA</b></th>
                                @* <th class="min-w-70px tableCellBorderRight smallThText"><b>DO</b></th>
                                    <th class="min-w-50px tableCellBorderRight smallThText"><b>Invoice</b></th>*@
                                <th class="min-w-100px tableCellBorderRight smallThText"><b>Received Date</b></th>
                                <th class="min-w-75px tableCellBorderRight smallThText"><b>Received Qty</b></th>
                                <th class="min-w-50px tableCellBorderRight smallThText"><b>Balance Qty</b></th>
                                <th class="min-w-100px tableCellBorderRight smallThText"><b>Issue Out By</b></th>
                                <th class="min-w-100px tableCellBorderRight smallThText"><b>Issue Out Date</b></th>
                                <th class="min-w-75px tableCellBorderRight smallThText"><b>Issue Out Qty</b></th>
                                <th class="min-w-75px tableCellBorderRight smallThText"><b>Balance to Issue Out Qty</b></th>
                                @* <th class="min-w-70px tableCellBorderRight smallThText"><b>GRN</b></th>*@
                                <th class="min-w-125px tableCellBorderRight smallThText"><b>Remark</b></th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (Model.Count() > 0)
                            {
                                @foreach (var form in Model)
                                {
                                    <tr id="@form.Id" class="text-center">
                                        <td class="text-center tableCellBorderLeft smallTdText">
                                            @{
                                                if (form.Status == "Item Issued Out" /*&& form.IssueStatus != "Generated"*/)
                                                {
                                                    <div class="form-check form-check-sm form-check-custom form-check-solid">
                                                        <input class="form-check-input checkSingle" id="checkBox" type="checkbox" value="@form.Id" data-kt-check="true" data-kt-check-target=".widget-9-check" style="margin-left:7px;" />
                                                    </div>
                                                }
                                            }
                                        </td>
                                        <td class="text-center tableCellBorderLeft smallTdText">
                                            <input id="bomId-@form.Id" class="form-control form-control-lg form-control-solid itemNumber" type="hidden" value="@form.Id" />
                                            @form.Id
                                        </td>
                                        <td class="text-center tableCellBorderLeft smallTdText">
                                            @{
                                                var status = form.Status;
                                                <input type="hidden" id="hBomStatus-@form.Id" value="@status" />
                                                if (status == "Completed")
                                                {
                                                    <div class="badge badge-light-primary badge-status">@status.ToUpper()</div>
                                                }
                                                else if (status == "Item Issued Out")
                                                {
                                                    <div class="badge badge-light-success badge-status">@status.ToUpper()</div>
                                                }
                                                else if (status == "Item Received")
                                                {
                                                    <div class="badge badge-light-warning badge-status">@status.ToUpper()</div>
                                                }
                                                else if (status == "PO Approved")
                                                {
                                                    <div class="badge badge-light-info badge-status">@status.ToUpper()</div>
                                                }
                                                else
                                                {
                                                    <div class="badge badge-light-danger badge-status">Unknown</div>
                                                }
                                            }
                                        </td>

                                        @*PO*@
                                        @* <td class="text-center tableCellBorderRight smallThText">
                                            @if (form.PO != null)
                                            {
                                            if (form.PO.Where(x => x.Type == "PO").Any())
                                            {

                                            var sfId = form.PO.FirstOrDefault(x => x.Type == "PO").SupportFileId;
                                            <a href="#" onclick="openPDF(@sfId)">@form.PO.FirstOrDefault(x => x.Type == "PO").SupportFile.FileName</a>
                                            }
                                            }
                                            </td>*@

                                        @*PO Line No*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @form.POLineNo
                                        </td>
                                        @*Issue Status*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @form.IssueStatus
                                        </td>
                                        @*PO Qty*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            <input type="hidden" id="ePOQty-@form.Id" value="@form.Quantity" />
                                            @form.Quantity
                                        </td>
                                        @*Description*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @form.Description
                                        </td>
                                        @*Brand*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @form.brand
                                        </td>
                                        @*Part No*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @{
                                                if (form.ItemCategory.Equals("Fabrication", StringComparison.InvariantCultureIgnoreCase) && form.PO != null && form.PO.Where(x => x.Type == "IC").Any() && form.isPICs)
                                                {
                                                    int count = 0;
                                                    foreach (var file in form.PO.Where(x => x.Type == "IC").ToList())
                                                    {
                                                        @if (count > 0)
                                                        {
                                                            <hr />
                                                        }
                                                        count++;
                                                        @*var sfId = form.PO.FirstOrDefault(x => x.Type == "IC").SupportFileId;
                                                            <a href="#" onclick="openPDF(@sfId)">@form.PO.FirstOrDefault(x => x.Type == "IC").SupportFile.FileName</a>*@
                                                        var sfId = file.SupportFileId;
                                                        <div><a href="#" onclick="openPDF(@sfId)">@file.SupportFile.FileName</a></div>

                                                    }
                                                }
                                                else
                                                {
                                                    @form.PartNo
                                                }
                                            }
                                        </td>
                                        @*Unit Price*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @form.UnitPrice
                                        </td>
                                        @*Total Price*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @form.TotalPrice
                                        </td>
                                        @*Estimate Delivery Date*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @form.EstDeliveryDate?.ToString("yyyy-MM-dd")
                                        </td>
                                        @*Received Date*@
                                        <td class="text-center tableCellBorderRight align-middle">

                                            <input class="kt_daterangepicker_1 form-control form-control-lg  border smallThText" id="eReceivedDate-@form.Id" name="ReceivedDate"
                                           @{
                                           if((form.Status == "PO Approved") || (form.BalanceToReceivedQty != 0)){
                                           if(form.ReceivedDate != null){
                                               @:value="@form.ReceivedDate?.ToString("yyyy-MM-dd")"
                                           }
                                           else{
                                               @:value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           }
                                           }
                                           else{
                                               @:disabled="disabled"
                                               @:style="background-color:#e9ecef"
                                               @:value="@form.ReceivedDate?.ToString("yyyy-MM-dd")"
                                           }
                                           } />

                                        </td>
                                        @*Received Qty*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            <input id="eReceivedQty-@form.Id" class="form-control form-control-lg  eReceivedQty text-center smallThText border" data-bomid="@form.Id" type="number" step="1" name="ReceivedQuantity"
                                           @{
                                           if((form.Status == "PO Approved")){
                                           if(form.ReceivedQuantity != null){
                                               @:value="@form.ReceivedQuantity"
                                           }
                                           else{
                                               @:value="@form.Quantity"
                                           }
                                           }else{
                                               @:disabled="disabled"
                                               @:style="background-color:#e9ecef"
                                               @:value="@form.ReceivedQuantity"
                                           }
                                           } />

                                            @{
                                                if ((form.Status == "Item Issued Out" || form.Status == "Item Received") && form.BalanceToReceivedQty < 0)
                                                {
                                                    <p>+</p>
                                                    <input id="eReceivedQty2-@form.Id" class="form-control form-control-lg  eReceivedQty2 text-center smallThText border" data-bomid="@form.Id" type="number" step="1" name="ReceivedQuantity" />
                                                }
                                            }
                                        </td>
                                        @*Balance Qty*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @{
                                                if (form.BalanceToReceivedQty > 0)
                                                {
                                                    <input id="eBalanceQty-@form.Id" class="form-control form-control-lg form-control-solid eBalanceQty text-center smallThText " type="text" name="BalanceToReceivedQty" value="+@form.BalanceToReceivedQty " style="background-color:#10d92e69 " readonly />
                                                }
                                                else if (form.BalanceToReceivedQty == 0)
                                                {
                                                    <input id="eBalanceQty-@form.Id" class="form-control form-control-lg form-control-solid eBalanceQty text-center smallThText " type="text" name="BalanceToReceivedQty" value="@form.BalanceToReceivedQty " style="background-color:#10d92e69 " readonly />
                                                }
                                                else
                                                {
                                                    <input id="eBalanceQty-@form.Id" class="form-control form-control-lg form-control-solid eBalanceQty text-center smallThText " type="text" name="BalanceToReceivedQty" value="@form.BalanceToReceivedQty " style="background-color: #ddaf088c " readonly />
                                                }
                                            }
                                        </td>
                                    
                                        @*Issue Out By*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            <input type="hidden" id="hIssueOutPicId-@form.Id" value="@form.IssuedPICId" />
                                            @* @form.IssuedPIC*@

                                            <input id="eIssueOutBy-@form.Id" class="form-control form-control-lg eIssueOutBy text-center smallThText border" type="text" value="@form.IssuedPIC"
                                           @{
                                           if((form.Status == "Item Received") || (form.Status == "Item Issued Out" && form.IssueStatus == "Partial" && form.BalanceToReceivedQty <= 0 && form.BalanceToIssueOutQty <= 0)){
                                               @:onclick="editPICSetPID(@form.Id)"
                                               @:data-bs-toggle="modal"
                                               @:data-bs-target="#modal_edit_pics"
                                               @:style="background-color:white;"
                                               @:readonly="readonly"
                                           }
                                           else{
                                               @:disabled="disabled"
                                               @:style="background-color:#e9ecef;"
                                           }
                                           } />

                                        </td>
                                        @*Issue Out Date*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            <input class="kt_daterangepicker_2 form-control form-control-lg  text-center smallThText border" id="eIssueOutDate-@form.Id" name="IssueOutDate"
                                           @{
                                           if((form.Status == "Item Received") || (form.Status == "Item Issued Out" && form.IssueStatus == "Partial" && form.BalanceToReceivedQty <= 0 && form.BalanceToIssueOutQty <= 0)){
                                           if(form.IssueOutDate != null){
                                               @:value="@form.IssueOutDate?.ToString("yyyy-MM-dd")"
                                           }
                                           else{
                                               @:value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           }
                                           } else{
                                               @:disabled="disabled"
                                               @:style="background-color:#e9ecef;"
                                               @:value="@form.IssueOutDate?.ToString("yyyy-MM-dd")"
                                           }
                                           } />
                                        </td>
                                        @*Issue Out Qty*@
                                        <td class="text-center tableCellBorderRight smallThText">

                                            <input id="eIssueOutQty-@form.Id" class="form-control form-control-lg eIssueOutQty text-center smallThText border" data-bomid="@form.Id" type="number" name="IssuedQty"
                                           @{
                                           if(form.Status == "Item Received"){
                                           if(form.IssuedQty != null){
                                               @:value="@form.IssuedQty"
                                           }
                                           else{
                                               @:value="@form.ReceivedQuantity"
                                           }
                                           }
                                           else{
                                               @:disabled="disabled"
                                               @:value="@form.IssuedQty"
                                           }
                                           } />

                                            @{
                                                if (form.Status == "Item Issued Out" && (form.BalanceToIssueOutQty < 0 || form.BalanceToReceivedQty < 0))
                                                {
                                                    <p>+</p>
                                                    <input id="eIssueOutQty2-@form.Id" class="form-control form-control-lg eIssueOutQty2 text-center smallThText border" data-bomid="@form.Id" type="number" name="IssuedQty2" />

                                                }
                                            }
                                        </td>
                                        @*Balance to Issue Out Qty*@
                                        <td class="text-center tableCellBorderRight smallThText">
                                            @{
                                                if (form.BalanceToIssueOutQty > 0)
                                                {
                                                    <input id="eBalanceToIssueOutQty-@form.Id" class="form-control form-control-lg form-control-solid text-center smallThText " type="text" name="BalanceToIssueOutQty" value="+ @form.BalanceToIssueOutQty " style="background-color:#10d92e69 " readonly />
                                                }
                                                else if (form.BalanceToIssueOutQty == 0)
                                                {
