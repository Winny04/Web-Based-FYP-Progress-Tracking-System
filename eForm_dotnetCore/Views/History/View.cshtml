                        {
                            var prId = $("#hPRId").val();
                            var fileType = "DO";
                              $.ajax({
                                url: '@Url.Action("DeleteUploadedFile","ReceivingTracker")',
                                type: 'POST',
                                data: { prId: prId, fileType: fileType, sfId:sfId },
                                success: function(result) {
                                     Swal.fire({
                                            text: result.msg,
                                            icon: "success",
                                            showCancelButton: false,
                                            showConfirmButton: false,
                                            buttonsStyling: false,
                                            confirmButtonText: "Done",
                                            customClass: {
                                                confirmButton: "btn btn-success"
                                            }
                                    }); //end swal

