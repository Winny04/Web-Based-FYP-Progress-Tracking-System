                var issueOutQty = $("#eIssueOutQty-" + bomid).val();
                var receivedQty = $(this).val();
                var balanceQty = "0";
                var balanceIssueOutQty = "0";

                var qty = poQty - receivedQty;
                if(qty > 0){
                    qty = qty * -1
                    balanceQty =  qty;
                }
                else if(qty < 0){
                     qty = qty * -1
                     balanceQty = "+" + qty;
                }
                else{
                     balanceQty = qty;
                }
                $("#eBalanceQty-" + bomid).val(balanceQty);

                if($("#hBomStatus-" + bomid).val() == "Item Issued Out"){
                    $(".eIssueOutQty",allPages).trigger("change");
                }

                 //Styling
                if(balanceQty >= 0){
                    $("#eBalanceQty-" + bomid).css("background-color",goodColorCode);
                }
                else if(balanceQty < 0){ 
                     $("#eBalanceQty-" + bomid).css("background-color",warningColorCode);
                }
                else{
                    $("#eBalanceQty-" + bomid).css("background-color", defaultColorCode);
                }

            });

