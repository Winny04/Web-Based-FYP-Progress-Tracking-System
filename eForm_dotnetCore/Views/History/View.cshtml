        function CheckHasSelectedBom(){
            var allPages = $("#tblPRItems").dataTable().fnGetNodes();
            if($('input[type="checkbox"]:checked', allPages).length > 0){
                $("#btnPrintIssueForm").attr('disabled',false);
            }
            else{
                    $("#btnPrintIssueForm").attr('disabled','disabled');
            }

            //Button Mark as Completed
            //var do = $("#file-do").val();
            //var inv = $("#file-invoice").val();
            //var grn = $("#file-grn").val();
            //console.log("do " + do );
            //console.log("inv " + inv );
            //console.log("grn " + grn );

            var selectedBom = [];
             $('input[type="checkbox"]:checked', allPages).each(function() {
                var chkboxValue = $(this).attr('value');
                if (chkboxValue != "" && chkboxValue != null) {
                    selectedBom.push($(this).attr('value'));
                }
            }); //end loop

             $.ajax({
                type: 'GET',
                url: '@Url.Action("CheckCanCompleted","ReceivingTracker")',
                data: { select: selectedBom.toString() },
                cache: false,
                success: function(response) {
                    if (response.result == true) {
                        $("#btnMarkCompleted").attr('disabled',false);
                    } else {
                        $("#btnMarkCompleted").attr('disabled','disabled');
                    }
                }
            });

        }

