@using eForm_dotnetCore.Helpers
@model IEnumerable<Category>

@{
    ViewData["Title"] = PageTitle.ManageCategory; 
}
<style>
    #mytable:not(.nohover) > tbody > tr {
        cursor: text !important;
    }

        #mytable:not(.nohover) > tbody > tr:hover {
            background: none;
        }
</style>

<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">
        <div class="card">
            <!--begin::Modal content-->
            <div class="modal-content">
                <div class="card-body pt-0">
                    <div class="card-header border-0 pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bolder fs-3 mb-1" style="margin-right:20px;">Category List</span>
                            <span class="text-dark mt-1 fw-bold fs-7" style="color:black">Total @ViewBag.CategoryList.Count Category</span>
                        </h3>

                        <div class="card-toolbar">
                            <div class="d-flex justify-content-end" data-kt-customer-table-toolbar="base" style="margin-left:400px;">
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add">Add Category</button>
                            </div>
                        </div>
                        <input type="text" id="search" onkeyup="searchFunction()" data-kt-customer-table-filter="search" class="form-control form-control-solid w-250px ps-15" placeholder="Search" />
                    </div>

                    <!--end::Header-->
                    <!--begin::Body-->
                    <div class="card-body py-3">
                        <!--begin::Table container-->
                        <div class="table-responsive">
                            <!--begin::Table-->
                            <table id="mytable" " class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                                <thead>
                                    <tr class="fw-bolder text-dark">
                                        <th style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Category Name</b></th>
                                        <th style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Category Short Name</b></th>
                                        <th style="color:black;font-size:15px"><b>Function</b></th>
                                    </tr>
                                </thead>
                                <tbody class="fw-bold text-dark-600">
                                    @if(ViewBag.CategoryList.Count == 0)
                                    {
                                    <tr>
                                        <td colspan="2">
                                            <p>There are no any data in database.</p>
                                        </td>
                                    </tr>
                                    }

                                    @foreach(var item in (IEnumerable<Category>)ViewBag.CategoryList){
                                    <tr>
                                        <td style="width:60%;color:black;font-size:15px;border-right: 2px solid #D3D3D3;">@Html.DisplayFor(a => item.CategoryName)</td>
                                        <td style="width:15%;color:black;font-size:15px;border-right: 2px solid #D3D3D3;">@Html.DisplayFor(a => item.CategoryShortName)</td>
                                        <td style="width:25%;color:black;font-size:15px;">
                                            <a><input type="button" class="btn btn-primary" value="Delete" style="background-color:red;" onclick="@("window.location.href='" + @Url.Action("RemoveCategory", "Manage") + "/?Id=" + @item.Id + "'");"></a>
                                            <a><input type="button" class="btn btn-primary editCategory" value="Edit" data-id="@item.Id" data-name="@item.CategoryName,@item.CategoryShortName"  data-bs-toggle="modal" data-bs-target="#editCategory"></a>
                                        </td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="add" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <!--begin::Modal content-->
        <div class="modal-content">
            <!--begin::Form-->
            @using (Html.BeginForm("AddCategory", "Manage", new { enctype = "multipart/form-data"}, FormMethod.Post)){

            <!--begin::Modal header-->
            <div class="modal-header" id="kt_modal_add_customer_header">
                <!--begin::Modal title-->
                <h2 class="fw-bolder">Add a Category</h2>
                <!--end::Modal title-->
                <!--begin::Close-->
                <div id="modal_close" class="btn btn-icon btn-sm btn-active-icon-primary" onclick="hideModal()">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body py-10 px-lg-17">
                <div class="pe-7" id="kt_modal_add_customer_scroll" data-kt-scroll="true" data-kt-scroll-activate="{default: false, lg: true}" data-kt-scroll-max-height="auto" data-kt-scroll-dependencies="#kt_modal_add_customer_header" data-kt-scroll-wrappers="#kt_modal_add_customer_scroll" data-kt-scroll-offset="300px">
                    <div class="fv-row mb-7">
                        <label class="required fs-6 fw-bold mb-2">Category Name</label>
                        <input type="text" class="form-control form-control-solid" name="CategoryName" id="CategoryName" required />
                        <!--end::Input-->
                          <label class="required fs-6 fw-bold mb-2">Category Short Name</label>
                           <input type="text" class="form-control form-control-solid" name="CategoryShortName" id="CategoryShortName" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer flex-center">
                <button type="reset" id="kt_modal_add_customer_cancel" class="btn btn-light me-3">Reset</button>
                <button type="submit" id="kt_modal_add_customer_submit" class="btn btn-primary">
                    <span class="indicator-label">Submit</span>
                    <span class="indicator-progress">
                        Please wait...
                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editCategory" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <!--begin::Modal content-->
        <div class="modal-content">
            <!--begin::Form-->
            @using (Html.BeginForm("EditCategory", "Manage", new { enctype = "multipart/form-data"}, FormMethod.Post)){

            <input type="text" name="categoryId" id="categoryId" hidden />
            <div class="modal-header" id="kt_modal_add_customer_header">
                <h2 class="fw-bolder">Edit Category</h2>
                <div id="modal_close" class="btn btn-icon btn-sm btn-active-icon-primary" onclick="hideModal()">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body py-10 px-lg-17">
                <div id="kt_modal_add_customer_scroll" data-kt-scroll="true" data-kt-scroll-activate="{default: false, lg: true}" data-kt-scroll-max-height="auto" data-kt-scroll-dependencies="#kt_modal_add_customer_header" data-kt-scroll-wrappers="#kt_modal_add_customer_scroll" data-kt-scroll-offset="300px">
                    <div class="fv-row mb-7">
                        <label class="required fs-6 fw-bold mb-2">Category Name</label>
                        <p id="CategoryName"></p>
                        <input type="text" class="form-control form-control-solid" name="categoryName" id="eCategoryName" required />
                         <label class="required fs-6 fw-bold mb-3 mt-3">Category Short Name</label>
                         <input type="text" class="form-control form-control-solid" name="categoryShortName" id="eCategoryShortName" required />
                    </div>
                </div>
            </div>

            <div class="modal-footer flex-center">
                <button type="reset" id="kt_modal_add_customer_cancel" class="btn btn-light me-3">Reset</button>
                <button type="submit" id="kt_modal_add_customer_submit" class="btn btn-primary">
                    <span class="indicator-label">Submit</span>
                    <span class="indicator-progress">
                        Please wait...
                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </div>
            }
        </div>
    </div>
</div>
<script>
        $(document).ready(function () {
            $(document).on("click", ".editCategory", function () {
                var itemId = $(this).data("id");
                var itemName = $(this).data("name");
                var itemNameList = itemName.split(',');
                $("#categoryId").val(itemId);
                $("#eCategoryName").val(itemNameList[0]);
                $("#eCategoryShortName").val(itemNameList[1]);
                //document.getElementById("CategoryName").value = "Johnny Bravo";
            });

        });

        function hideModal() {
            $('#add').modal('hide');
        }

        function hideModal1() {
            $('#delete').modal('hide');
        }



        function searchFunction() {
          var input, filter, table, tr, td, i, txtValue;
          input = document.getElementById("search");
          filter = input.value.toUpperCase();
          table = document.getElementById("mytable");
          tr = table.getElementsByTagName("tr");
          for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[0];
            if (td) {
              txtValue = td.textContent || td.innerText;
              if (txtValue.toUpperCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
              } else {
                tr[i].style.display = "none";
              }
            }
          }
        }
</script>