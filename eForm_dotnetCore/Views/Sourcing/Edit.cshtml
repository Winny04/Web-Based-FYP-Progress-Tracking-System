@model SourceEditVM


@{
    ViewData["Title"] = "Edit Sourcing";
}

<div class="card card-xxl-stretch mb-5 mb-xxl-10" id="kt_content">
    <div class="card-header d-flex justify-content-between">
        <div class="card-title">
            <h3>Edit Sourcing - @Model.Source.RFQ.Rfqname</h3>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="form-horizontal">
            <div class="form-group pt-3">
                <div class="row gy-5 g-xl-10 justify-content-center">

                    @foreach(var supplier in Model.Suppliers)
                    {
                        <div class="col-sm-12 col-lg-4">
                            <div class="card">
                                <div class="card-header align-items-center">
                                    <div class="card-title fs-3 fw-bolder">@supplier.Supplier.VendorName</div>
                                    <div class="d-flex flex-column">
                                        @if(Model.Source.BestPriceSupplierId.HasValue &&
                                      supplier.Supplier.Id == Model.Source.BestPriceSupplierId.Value)
                                        {
                                            <span class="text-primary fw-bolder">Best Price</span>
                                        }
                                        @if(Model.Source.BestLeadTimeSupplierId.HasValue &&
                                       supplier.Supplier.Id == Model.Source.BestLeadTimeSupplierId.Value)
                                        {
                                            <span class="text-primary fw-bolder">Best Lead</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-6">
                                        <div class="col-6 text-start">
                                            <span class="w-100 fs-4 fw-bolder">Price:</span>
                                        </div>
                                        <div class="col-6">
                                            <span>RM @supplier.Price</span>
                                        </div>
                                    </div>
                                     <div class="row mb-6">
                                        <div class="col-6 text-start">
                                            <span class="w-100 fs-4 fw-bolder">Lead Time:</span>
                                        </div>
                                        <div class="col-6">
                                            <span>@supplier.LeadTime?.ToString("dd-MM-yyyy")</span>
                                        </div>
                                    </div>
                                    @{
                                        var remark = "";
                                        if (Model.Source.BestPriceSupplierId.HasValue &&
                                        supplier.Supplier.Id == Model.Source.BestPriceSupplierId.Value
                                        && !string.IsNullOrEmpty(Model.RemarkForBestPrice))
                                        {
                                            remark += Model.RemarkForBestPrice;
                                        }
                                        @if (Model.Source.BestLeadTimeSupplierId.HasValue &&
                                        supplier.Supplier.Id == Model.Source.BestLeadTimeSupplierId.Value
                                        && !string.IsNullOrEmpty(Model.RemarkForBestLead))
                                        {
                                            remark += Model.RemarkForBestLead;
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(remark))
                                    {
                                        <div class="row mb-6">
                                            <div class="col-6 text-start">
                                                <span class="w-100 fs-4 fw-bolder">Remark:</span>
                                            </div>
                                            <div class="col-6">
                                                <span>@remark</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="row gy-5 g-xl-10 justify-content-center mb-3">
             <div class="col-6 text-start">
                <span class="w-100 fs-4 fw-bolder">Select Supplier Standard:</span>
            </div>
            <div class="col-6">
                <select class="form-select form-select-solid" id="supplierStandard" name="supplierStandard">
                    <option value="1">Price</option>
                    <option value="2">Lead Time</option>
                </select>
            </div>
        </div>
        <div class="row gy-5 g-xl-10 justify-content-center mb-3">
            <div class="col-6 text-start">
                <span class="w-100 fs-4 fw-bolder">Selected Supplier:</span>
            </div>
            <div class="col-6">
                <select class="form-select form-select-solid" id="supplierId" name="supplierId">
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <option value="@supplier.Supplier.Id">@supplier.Supplier.VendorName</option>
                    }
                </select>
            </div>
        </div>
          <input type="hidden" id="sourceId" name="id" value="@Model.Source.Id" />
            <div class="d-flex justify-content-end mt-2">
                <button class="btn btn-primary m-1" onclick="saveOrConfirm(1)">Save</button>
                <button class="btn btn-success m-1" onclick="saveOrConfirm(2)">Confirm</button>
            </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $("#supplierStandard").val("@Model.Source.SupplierStandard")

            $("#supplierId").val("@Model.Source.SupplierId")

        })

        function saveOrConfirm(action){
            var id = $("#sourceId").val();
            var standard = $("#supplierStandard").val();
            var supplierId = $("#supplierId").val();

            if(action == 1){
                $.post('@Url.Action("Edit")', 
                {
                    id, standard, supplierId
                }
                , function () {
                    window.location.href = "@Url.Action("Index")"
                });
            }
            else{
                $.post('@Url.Action("ConfirmSupplier")',
                {
                        id, standard, supplierId
                }
                , function () {
                    window.location.href = "@Url.Action("Index")"
                });
            }
            window.location.href = "@Url.Action("Index")"
        }
    </script>
}