@model IEnumerable<SourcingVM>

@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers

@{
    ViewBag.Title = "Manage Sourcing";
}
<style>
    .tableBorder {
        border-right: 2px solid #D3D3D3;
        color: black;
        font-size: 15px;
        text-align: center;
    }
</style>

<div class="card">
    <h3 style="margin-left:30px; margin-top:20px;">Manage Sourcing</h3>
    <div class="card-header border-0">

        <div class="card-toolbar">
            <div class="d-flex flex-stack flex-wrap gap-4">
                <div class="d-flex align-items-center position-relative my-1">
                    <span class="svg-icon svg-icon-1 position-absolute px-1" style="margin-right:1.5rem !important;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                            <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                        </svg>
                    </span>
                    <input type="text" id="filter_search" class="form-control form-control-solid w-250px" placeholder="Search RFQ" style="padding-left:2.8rem !important;" />
                </div>
            </div>
        </div>
        <div class="card-toolbar">
            <div class="d-flex flex-stack flex-wrap gap-2">
                <div class="d-flex align-items-center py-3 py-md-1">
                    <select class="form-control" id="statusFilter">
                        <option value="RFQ Sent" selected>Pending</option>
                        <option value=" ">All</option>
                    </select>
                </div>
                <div class="d-flex align-items-center py-3 py-md-1">
                    <a href="@Url.Action("EmailContent","Manage",new {type = EmailTemplateConfiguration.SREmailContent})" class="btn btn-primary">Manage Email Content</a>
                </div>
                <div class="d-flex align-items-center py-3 py-md-1">
                    <button data-bs-toggle="modal" class="btn btn-outline-success" data-bs-target="#modal_export">Export</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card-body py-0">
        <div class="table-responsive">
            <table id="rsTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="font-weight-bold text-center">
                        <th class="min-w-100px" style="color:black;font-size:15px; border-right: 2px solid #D3D3D3;"><b>Ori. RFQ</b></th>
                        <th hidden><b>Status</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Brand</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Response</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Final Price</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Final Lead Date</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Selected Supplier</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Total Price Save</b></th>
                        <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Action</b></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var form in Model)
                    {
                        <tr id="@form.Id" class="text-center" 
                        @{
                            if(form.Status == "RFQ Sent"){
                            @:style="background-color:#edd86d"
                            }
                        }>
                            <td class="tableCellStandard tableCellBorderLeft" >
                                <a href="@Url.Action("Edit", "RFQ", new { id = form.RFQId, bomId = form.BOMId })">@form.RFQName</a>
                            </td>
                            <td hidden>
                                @form.Status
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Brand
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.TotalResponse / @form.TotalSend
                            </td>
                             <td class="tableCellStandard tableCellBorderLeft">
                                @form.FinalPrice
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.FinalLeadTime?.ToString("dd/MM/yyyy")
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @form.Supplier
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                @if (form.TotalPriceSave.HasValue)
                                {
                                    <span>@form.TotalPriceSave</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="tableCellStandard tableCellBorderLeft">
                                <button class="btn btn-sm btn-light btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">Actions</button>

                                <div class="menu menu-sub menu-sub-dropdown menu-row menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 py-4" data-kt-menu="true">
                                    <div class="menu-item px-3">
                                        <a class="menu-link px-3" href="@Url.Action("Edit",new { id = form.Id})">Edit</a>
                                    </div>
                                    <div class="menu-item px-3">
                                        <a class="menu-link px-3" href="@Url.Action("Manage","RFQSharing",new { sourceId = form.Id})">Details</a>
                                    </div>
                                    <div class="menu-item px-3">
                                        <button class="menu-link px-3" onclick="deleteSR('@form.Id')">Delete</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_export" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <div class="mb-13 text-center">
                    <h1 class="mb-3">Export Sourcing</h1>
                </div>

                <form asp-controller="Sourcing" asp-action="ExportSourcing" method="post">
                    <div class="d-flex flex-column mb-2 fv-row">
                        <label class="fs-6 fw-bold mb-2">Start From</label>
                        <input class="form-control" type="date" id="start_date" name="startFrom" min="2022-01-01" max="YYYY-MM-DD" required>
                    </div>
                    <div class="d-flex flex-column mb-2 fv-row">
                        <label class="fs-6 fw-bold mb-2">End At</label>
                        <input class="form-control" type="date" id="end_date" name="endAt" min="2022-01-01" max="YYYY-MM-DD" required>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Export</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    let dataTable;
    $(document).ready(function () {
        var today = new Date().toISOString().split('T')[0];

        // Set the max attribute for the date inputs to today's date
        document.getElementById('start_date').max = today;
        document.getElementById('end_date').max = today;


        var table = document.getElementById("rsTable")
        dataTable = $(table).DataTable({
            "info": false,
            "order": []
        });

        var filterSearch = document.getElementById("filter_search");
        filterSearch.addEventListener("keyup", function (e) {
            dataTable.search(e.target.value).draw();
        });

        dataTable.columns(1).search($("#statusFilter").val(), true, false).draw();

        $("#statusFilter").change(function (e) {
            if (e.target.value === " ") {
                dataTable.columns(1).search("", true, false).draw();
            }
            else {
                var regex = '\\b' + e.target.value + '\\b';
                dataTable.columns(1).search(regex, true, false).draw();
            }
        });
    })

    function deleteSR(id) {
        Swal.fire({
            text: "Are you sure delete this sharing link?",
            icon: "warning",
            showCancelButton: true,
            buttonsStyling: false,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "No, return",
            customClass: {
                confirmButton: "btn btn-primary",
                cancelButton: "btn btn-active-light"
            }
        }).then(function (result) {
            if (result.value) {
                $.ajax({
                    url: "@Url.Action("Delete")",
                    method: "POST",
                    data: {
                        id
                    },
                    success: function () {
                        dataTable.row("#" + id).remove().draw();
                    }
                });

            } else if (result.dismiss === "cancel") {
                Swal.fire({
                    text: "Your request has been cancelled!.",
                    icon: "error",
                    buttonsStyling: false,
                    confirmButtonText: "Ok, got it!",
                    customClass: {
                        confirmButton: "btn btn-primary",
                    }
                });
            }
        });
    }

</script>

