@model PreviewSourcingVM

@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.Common
@using Microsoft.Net.Http.Headers;

@{
    ViewData["Title"] = "Preview Sourcing";
}

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

<style>
    .form-check {
        margin-bottom: 8px;
    }

    .datagrid-table td:last-child,
    .datagrid-table th:last-child {
        display: none !important;
    }

    /* Or by component class */
    .formio-component-rejectBtn {
        display: none !important;
    }

    .preferred-vendor {
        color: #1a1a2e;
        font-weight: 700;
    }
</style>

<div class="card card-xxl-stretch mb-5 mb-xxl-10">
    <div class="card-header d-flex justify-content-between">
        <div class="card-title">
            <h3>Preview Sourcing</h3>
        </div>
    </div>

    <form id="fillForm" asp-action="CreateSourcing" method="post">
        <div class="card-body pb-0">
            <div class="form-horizontal">
                <input type="hidden" name="DataResponse" id="DataResponse" value="" />
                <input type="hidden" name="brand" id="brand" value="@Model.Brand" />
                <input type="hidden" name="rfqId" id="rfqId" value="@Model.RFQId" />
                <input type="hidden" name="list" id="list" value="@ViewBag.list" />
                <div class="card">
                    <div class="card-body" style="overflow-x:auto">
                        <div id="render"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer pt-3">
            <div class="row gy-5 g-xl-10 justify-content-center">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title">
                            <h3>Brand Recommendation</h3>
                        </div>
                        <div>
                            @if (Model.BrandRecommend != null)
                            {
                                <a href="@Url.Action("Edit","BrandRecommend",new {id = Model.BrandRecommend.Id})" class="btn btn-primary">Edit</a>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.BrandRecommend == null)
                        {
                            <p class="text-danger">
                                The specific brand recommendation wasn't found.
                                <a href="@Url.Action("Edit","BrandRecommend",new {brand = Model.Brand})">Click here to create recommendation for brand</a>
                            </p>
                        }
                        else
                        {
                            <div class="d-flex flex-column">
                                <div class="row">
                                    <div class="d-flex flex-column mb-3 fv-row">
                                        <label class="fs-6 fw-bold mb-2">Brand</label>
                                        <input class="form-control form-control-solid" value="@Model.Brand" disabled />
                                    </div>
                                </div>

                                <hr />

                                <div class="row">
                                    <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                                        <span>Select Brand Recommended Suppliers</span>
                                    </label>
                                    <div class="scrollable-box" id="brandSuppliers">
                                        @foreach (var supplier in Model.BrandRecommend.BrandSuppliers.OrderByDescending(s => s.IsPrimary))
                                        {
                                            var emailText = Model.EmailList.ContainsKey(supplier.SupplierId.ToString())
                                            ? Model.EmailList[supplier.SupplierId.ToString()].Email
                                            : "Email Not Set";

                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" name="selectSuppliers" value="@supplier.SupplierId" />
                                                @if (supplier.IsPrimary)
                                                {
                                                    <label class="form-check-label preferred-vendor">
                                                        @supplier.Supplier.VendorName - @emailText
                                                    </label>
                                                }
                                                else
                                                {
                                                    <label class="form-check-label">@supplier.Supplier.VendorName - @emailText</label>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <hr />

                                <div class="row mt-4">
                                    <label class="d-flex align-items-center fs-6 fw-bold mb-2">
                                        <span>Select Additional Vendors</span>
                                    </label>

                                    <input type="text" id="vendorSearch" class="form-control mb-3" placeholder="Search vendors..." />

                                    <div class="scrollable-box" id="additionalVendors">
                                        @foreach (var vendor in Model.AllVendors)
                                        {
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" name="selectedVendors" value="@vendor.Id" />
                                                <label class="form-check-label">@vendor.VendorName - @vendor.Email</label>
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="row gy-5 g-xl-10 justify-content-center mt-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <div class="card-title">
                            <h3>Email Content</h3>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-column">
                            <div class="text-end">
                                <a href="@Url.Action("EmailContent","Manage",new {type = EmailTemplateConfiguration.SREmailContent})" class="btn btn-primary mb-2">Edit Content</a>
                            </div>
                            <div class="card p-3">
                                @Html.Raw(Model.EmailContent)
                            </div>
                        </div>
                    </div>
                    <div class="card-header d-flex justify-content-between">
                        <div class="card-title">
                            <h3>Remarks</h3>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-column">
                            <div class="card p-3">
                                <textarea id="remarks" name="remarks" rows="4" cols="50"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if ((Model.BrandRecommend != null && Model.BrandRecommend.BrandSuppliers.Any()) ||
            (Model.AllVendors != null && Model.AllVendors.Any()))
            {
                <div class="d-flex mt-2 justify-content-end">
                    <button type="submit" class="text-end btn btn-primary">Send E-mail to suppliers</button>
                </div>
            }
        </div>
    </form>

</div>

@section Scripts {
    <script>
            $(document).ready(function() {
                var currentDate = new Date();
                currentDate.setDate(currentDate.getDate() + 2); // Add 2 days to the current date
                currentDate.setHours(currentDate.getHours() + 8);

                var formattedDate = currentDate.toISOString().slice(0, 16);

                document.getElementById('leadTime').value = formattedDate;
            });

            const data = @Html.Raw(string.IsNullOrEmpty(Model.Data) ? "{}" : Model.Data);
            const submission = @Html.Raw(string.IsNullOrEmpty(Model.DataResponse) ? "{data:{}}" : Model.DataResponse);
            var stateOptions = {
            readOnly: 'true',
            viewOnly: 'true'
            };

            var renderer;
            var state = {
                formioVersion: 'default',
                form: data,
                submission: submission,
                options: stateOptions,
            };

            function initRenderer(form) {
                if (renderer) {
                    renderer.destroy();
                }
                Formio.createForm(document.getElementById('render'), form, _.cloneDeep(state.options))
                    .then(function(self) {
                        renderer = self;
                        renderer.submission = state.submission;

                             const rejectButton = document.querySelector('.formio-component-rejectBtn');
                             if (rejectButton) {
                                 rejectButton.style.display = 'none';
                             }

                        renderer.on('change', function(event, flags) {
                            console.log('onchange', flags)

                            if (flags && !flags.fromSubmission) {
                                setSubmission(renderer.submission, 'renderer');
                            }
                        });
                    });
            }

            function setForm(form, from) {
                state.form = form;
            }

            function setSubmission(submission, from) {
                console.log('setSubmission', submission, from);
                if (renderer && from !== 'renderer') {
                    renderer.submission = submission;
                }

                document.getElementsByName('DataResponse')[0].value = JSON.stringify(submission);
                //document.getElementsByName('DataResponse')[1].value = JSON.stringify(submission);
            }

            initRenderer(state.form);

            // Filtering function
            document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("vendorSearch").addEventListener("keyup", function () {
                var filter = this.value.toLowerCase();
                var checkboxes = document.querySelectorAll('input[name="selectedVendors"]');

                checkboxes.forEach(function(checkbox) {
                    var label = checkbox.nextElementSibling;
                    var container = checkbox.closest('.form-check');

                    if (label) {
                        var text = label.textContent.toLowerCase();
                        container.style.display = text.includes(filter) ? "" : "none";
                    }
                });
            });

            document.querySelectorAll('.scrollable-box').forEach(function(box) {
                box.style.maxHeight = '200px';
                box.style.overflowY = 'auto';
            });
        });

    </script>

    <style>
        .scrollable-box {
            max-height: 200px;
            overflow-y: auto;
            border: 1px solid #ddd;
            padding: 10px;
            background-color: #f9f9f9;
        }
    </style>
}
