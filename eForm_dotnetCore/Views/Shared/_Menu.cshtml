                                </span>
                                <span class="menu-title">HODs</span>
                                <span class="menu-arrow"></span>
                            </span>
                            <div class="menu-sub menu-sub-lg-down-accordion menu-sub-lg-dropdown menu-rounded-0 py-lg-4 w-lg-225px">

                                @foreach (var dept in allDepts)
                                {
                                    <div class="menu-item">
                                        <a class="menu-link active py-3" href="/PRApproval/Index?deptId=@dept.Id">
                                            <span class="menu-bullet">
                                                <span class="bullet bullet-dot"></span>
                                            </span>
                                            <span class="menu-title">@dept.Name</span>
                                            <span style="float:right; margin-right: 10px">
                                                @{
                                                    var currentHOD = HODApprovalList
                                                    .Where(x => x.DepartmentId == dept.Id)
                                                    .ToList();

                                                    var prIds = currentHOD.Select(x => x.PRId).Distinct().ToList();

                                                    var prList = await _context.Prs.Where(x => prIds.Contains(x.Id) && !string.IsNullOrEmpty(x.Rfqid)).Select(x => x.Id).ToListAsync();
                                                    var pendingApproveCount = 0;
                                                    foreach (var pr in prList)
                                                    {
                                                        var bom = bomQuery.Where(x => x.PRId == pr).FirstOrDefault();
                                                        if (bom != null && bom.Status == "PR Sent")
                                                        {
                                                            pendingApproveCount++;
                                                        }
                                                    }

                                                    if (pendingApproveCount == 0)
                                                    {
                                                        <span class="badge badge-light-success badge-circle fw-bolder fs-7"> @pendingApproveCount</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-light-danger badge-circle fw-bolder fs-7"> @pendingApproveCount</span>
                                                    }
                                                }
                                            </span>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
