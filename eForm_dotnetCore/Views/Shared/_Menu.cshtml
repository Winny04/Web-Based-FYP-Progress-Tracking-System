@inject IAuthorizationService AuthorizationService

@{
    EformSophicDemoContext _context = new EformSophicDemoContext();
    var user = _context.EmployeeInfos
    .Include(x => x.EmpDepartment)
    .Where(d => d.UserName == Context.User.Identity.Name).FirstOrDefault();
    var authReceiving = new AuthResource("Type", "CEO,GFC,HOD,PM,Sales,Buyer,Requestor,Quality,Finance", null);
    var authApproval = new AuthResource("Type", "CEO,GFC,HOD,PM,Buyer,Requestor,Quality,Finance", null);
    var canSeeReceiving = await AuthorizationService.AuthorizeAsync(User, authReceiving, new UserTypeRequirement());
    var canSeeApproval = await AuthorizationService.AuthorizeAsync(User, authApproval, new UserTypeRequirement());
    var bomQuery = _context.Boms.AsQueryable();


    //PR Approver
    //var prs = _context.Prs
    //            .Where(x => x.Status == "PR Sent").ToList();
    var allDepts = _context.Department.ToList();

    var ctxPrApprover = _context.PRApprover.ToList();
    var hodQuery = ctxPrApprover.Where(x => x.DepartmentId.HasValue &&
                    x.Type == "HOD").AsQueryable();
    var HODApprovalList = hodQuery.Where(x => x.Approved == false).ToList();
    var HODApprovalList2 = hodQuery.ToList();
    var GFCApprovalList = ctxPrApprover.Where(x => x.Type == "GFC").ToList();
    var CEOApprovalList = ctxPrApprover.Where(x => x.Type == "CEO" && x.Approved == false).ToList();


    var GFCApprovalCount = (from x in GFCApprovalList
                            from y in HODApprovalList2
                            where x.PRId == y.PRId
                            && x.Approved == false
                            && y.Approved == true
                            select x).Count();

    var query = (from x in HODApprovalList2
                 from y in GFCApprovalList
                 where x.PRId == y.PRId
                 && x.Approved == true
                 && y.Approved == true
                 select y).ToList();

    var CEOApprovalCount = (from x in query
                            from z in CEOApprovalList
                            where x.PRId == z.PRId
                            select z).Count();

}
