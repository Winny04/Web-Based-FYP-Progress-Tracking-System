@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.ViewModels

@model IEnumerable<ReceivingTrackerViewModel>

@{
    ViewData["Title"] = PageTitle.CompletedTracker;
}
<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">

        <div class="card card-flush mb-5 mb-xl-8">
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">@PageTitle.CompletedTracker</span>

                </h3>
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-4">
                        <div class="d-flex align-items-center position-relative my-1">
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search Form" />
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Header-->
            <!--begin::Body-->
            @* <div class="card card-flush mb-5 mb-xl-8">*@
            <div class="card-body py-3">
                <!--begin::Table container-->
                <div class="table-responsive">
                    <!--begin::Table-->
                    <table id="formListTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <!--begin::Table head-->
                        <thead>
                            <tr class="fw-bolder fs-6 text-uppercase text-center">
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Requestor</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Department</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Customer PO</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Project Name</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Project Category</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>PO</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Quantity</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Unit Price</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Total Price</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>ETA</b></th>
                                <th class="min-w-150px" style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Received Date</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Received Qty</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Balance to Receive Qty</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>DO</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Invoice</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>GRN</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Issued PIC</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Issued Qty</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Balance to Issue Out Qty</b></th>
                                <th class="min-w-100px" style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;"><b>Issue Out Date</b></th>
                                <th class="min-w-70px"  style="color:black;font-size:15px;"><b>Status</b></th>
                            </tr>
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody>
                            @if (Model.Count() > 0)
                            {
                                @foreach (var form in Model)
                                {
                                    <tr id="@form.Id" class="text-center">
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.Requestor
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.Department
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.CustomerPO
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.ProjectName
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.ProjectCategory
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @if (form.PO != null)
                                            {
                                                if (form.PO.Where(x => x.Type == "PO").Any())
                                                {
                                                    <a href="@Url.Action("downloadFile",new {id = form.PO.FirstOrDefault(x => x.Type == "PO").SupportFileId})">
                                                        @form.PO.FirstOrDefault(x => x.Type == "PO").SupportFile.FileName
                                                    </a>
                                                }
                                            }
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.Quantity
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.UnitPrice
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.TotalPrice
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.ETA
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.ReceivedDate
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.ReceivedQuantity
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.BalanceToReceivedQty
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @if (form.DO != null)
                                            {
                                                if (form.DO.Where(x => x.Type == "DO").Any())
                                                {
                                                    <a href="@Url.Action("downloadFile",new {id = form.DO.FirstOrDefault(x => x.Type == "DO").SupportFileId})">
                                                        @form.DO.FirstOrDefault(x => x.Type == "DO").SupportFile.FileName
                                                    </a>
                                                }
                                            }
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @if (form.Invoice != null)
                                            {
                                                if (form.Invoice.Where(x => x.Type == "INV").Any())
                                                {
                                                    <a href="@Url.Action("downloadFile",new {id = form.Invoice.FirstOrDefault(x => x.Type == "INV").SupportFileId})">
                                                        @form.Invoice.FirstOrDefault(x => x.Type == "INV").SupportFile.FileName
                                                    </a>
                                                }
                                            }
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @if (form.GRN != null)
                                            {
                                                if (form.GRN.Where(x => x.Type == "GRN").Any())
                                                {
                                                    <a href="@Url.Action("downloadFile",new {id = form.GRN.FirstOrDefault(x => x.Type == "GRN").SupportFileId})">
                                                        @form.GRN.FirstOrDefault(x => x.Type == "GRN").SupportFile.FileName
                                                    </a>
                                                }
                                            }
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.IssuedPIC
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.IssuedQty
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.BalanceToIssueOutQty
                                        </td>
                                        <td style="color:black;font-size:15px;border-right: 2px solid #D3D3D3;">
                                            @form.IssueOutDate
                                        </td>
                                        <td style="color:black;font-size:15px;">
                                            @if (form.Status == "Item Received")
                                            {
                                                <div class="badge badge-light-success badge-status">@form.Status</div>
                                            }
                                            else
                                            {
                                                <div class="badge badge-light-danger badge-status">Unknown</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Table container-->
            </div>
            <!--begin::Body-->
        </div>
    </div>
</div>



@section scripts{
<script>

       $(document).ready(function () {
            $("#kt_daterangepicker_1,kt_daterangepicker_2").flatpickr({
               dateFormat: "Y-m-d",
           })

           var table = document.getElementById("formListTable");
           $("#attachFileItem").hide();

           var dataTable = $(table).DataTable({
               "info":false,
               "order":[]
           });


           var filterSearch = document.getElementById("filter_search");
           filterSearch.addEventListener("keyup", function (e) {
               dataTable.search(e.target.value).draw();
           });


          }); //End $(document).ready()

</script>
}
