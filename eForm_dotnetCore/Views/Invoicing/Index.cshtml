@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@model IEnumerable<eForm_dotnetCore.Models.Invoice>

@{
    ViewBag.Title = "Manage Invoices";
}

<style>
    .tableBorder {
        border-right: 2px solid #D3D3D3;
        color: black;
        font-size: 15px;
        text-align: center;
    }
</style>

@if (ViewBag.ErrorMessages != null && ViewBag.ErrorMessages.Count > 0)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <ul>
            @foreach (var error in ViewBag.ErrorMessages)
            {
                <li>@error</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}



@if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="card">
    <h3 style="margin-left:30px; margin-top:20px;">Manage Invoices</h3>

    <div class="card-header border-0">
        <div class="card-toolbar">
            <form method="get" asp-action="Index" asp-controller="Invoice" class="d-flex">
                <input type="text" name="searchQuery" class="card-toolbar me-3" placeholder="Search invoices..." value="@Context.Request.Query["searchQuery"]">
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>

        <div class="card-toolbar">
            <button data-bs-toggle="modal" data-bs-target="#uploadModal" class="btn btn-primary me-3">Upload Invoice</button>
            <button data-bs-toggle="modal" data-bs-target="#deletedInvoicesModal" class="btn btn-danger">Deleted Invoices</button>
        </div>
    </div>

    <div class="card-body py-0">
        <div class="table-responsive">
            <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                <thead>
                    <tr class="fw-bolder text-muted">
                        <th class="text-center">Invoice Number</th>
                        <th class="text-center">File Name</th>
                        <th class="text-center">Upload Date</th>
                        <th class="text-center">Uploaded By</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model)
                    {
                        <tr>
                            <td class="text-center">@invoice.InvoiceNumber</td>
                            <td class="text-center">@invoice.FileName</td>
                            <td class="text-center">@invoice.UploadDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-center">@invoice.UploadedBy</td>
                            <td class="text-center">
                                <a href="javascript:void(0);" onclick="openFile('@Url.Action("ViewFile", "Invoice", new { id = invoice.Id })', '@invoice.FileName')"
                                   class="btn btn-sm btn-light">View</a>

                                <form id="deleteForm-@invoice.Id" method="post" asp-action="Delete" asp-controller="Invoice" style="display:inline;">
                                    <input type="hidden" name="id" value="@invoice.Id" />
                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteInvoice(@invoice.Id)">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <button class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body px-10 px-lg-15 pt-0 pb-15">
                <h3 class="text-center mb-3">Upload Invoice</h3>

                <form asp-action="Upload" asp-controller="Invoice" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Invoice Number</label>
                        <input type="text" name="invoiceNumber" class="form-control" required />
                    </div>

                    <input type="hidden" name="uploadedBy" value="@User.Identity.Name" />

                    <div class="mb-3">
                        <label class="form-label">Upload File</label>
                        <input type="file" name="file" class="form-control" accept=".xls,.xlsx,.pdf,.jpg,.jpeg,.png" required />
                    </div>

                    <div class="d-flex justify-content-center">
                        <button type="submit" class="btn btn-primary">Upload</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<!-- Deleted Invoices Modal -->
<div class="modal fade" id="deletedInvoicesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-750px">
        <div class="modal-content rounded shadow">
            <div class="modal-header pb-0 border-0 justify-content-between">
                <h3 class="text-center mb-3 text-primary fw-bold">Deleted Invoices</h3>
                <button class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body px-10 px-lg-15 pt-0 pb-15">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center">Invoice Number</th>
                                <th class="text-center">File Name</th>
                                <th class="text-center">Upload Date</th>
                                <th class="text-center">Uploaded By</th>
                                <th class="text-center">Deleted By</th>
                                <th class="text-center">Deleted Date</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.DeletedInvoices != null && ViewBag.DeletedInvoices.Count > 0)
                            {
                                @foreach (var invoice in ViewBag.DeletedInvoices)
                                {
                                    <tr class="table-light">
                                        <td class="text-center fw-bold">@invoice.InvoiceNumber</td>
                                        <td class="text-center">@invoice.FileName</td>
                                        <td class="text-center text-muted">@invoice.UploadDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-center">@invoice.UploadedBy</td>
                                        <td class="text-center text-danger fw-semibold">@invoice.DeletedBy</td>
                                        <td class="text-center text-muted">@invoice.DeletedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-center">
                                            <a href="javascript:void(0);" onclick="openFile('@Url.Action("ViewFile", "Invoice", new { id = invoice.Id })', '@invoice.FileName')"
                                               class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted fs-6">No deleted invoices available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>




<script>
    function openFile(url, fileName) {
        var newWindow = window.open(url, '_blank');

        if (newWindow) {
            setTimeout(function () {
                newWindow.document.title = fileName;
            }, 500); // Delay to ensure the document is loaded before changing the title
        }
    }

    function deleteInvoice(invoiceId) {
        if (confirm("Are you sure you want to delete?")) {
            document.getElementById("deleteForm-" + invoiceId).submit();
        }
    }


</script>