            function backToSubmit(status, formType) {
                // Check if RFQ has a linked PR
                 $.get('@Url.Action("CheckLinkedPR", "RFQ")', { id: @Model.RFQId }, function (hasPR) {
                // Customize modal text based on presence of PR
                        const msg = hasPR
                            ? "⚠️ This RFQ has a linked PR that will be deleted if you continue.<br><br>Do you want to proceed?"
                            : "Are you sure you want to revert this RFQ?";
                        $('#revertModalText').html(msg);

                        // Store data for later use when user confirms
                        $('#revertModalConfirm').data('status', status);
                        $('#revertModalConfirm').data('formType', formType);
                        $('#revertModalConfirm').data('hasPR', hasPR);

                        // Show the modal
                        $('#modal_revert_rfq').modal('show');
                    });
                }

                // When user confirms in modal
                $('#revertModalConfirm').on('click', function () {
                    const status = $(this).data('status');
                    const formType = $(this).data('formType');
                    const hasPR = $(this).data('hasPR');

                    $('#revertModalConfirm, #revertModalCancel').prop('disabled', true);
                    $('#revert-loading-spinner').show();

                    $.post('@Url.Action("reverseStatus", "RFQ")', {
                        id: @Model.RFQId,
                        status,
                        formType,
                        forceDeletePR: hasPR
                    })
                    .done(() => {
                        location.reload();
                    })
                    .fail(() => {
                        alert("Error reverting RFQ.");
                        $('#revert-loading-spinner').hide();
                        $('#revertModalConfirm, #revertModalCancel').prop('disabled', false);
                    });
                });

