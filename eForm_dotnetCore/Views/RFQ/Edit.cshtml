                        renderer = self;
                        renderer.submission = state.submission;

                       renderer.ready.then(() => {
                    const hideColumnCheckbox = renderer.getComponent('selectBoxes1');

                    if (hideColumnCheckbox) {
                        // Try to unlock through Form.io API
                        hideColumnCheckbox.disabled = false;
                        hideColumnCheckbox.options.readOnly = false;
                        hideColumnCheckbox.options.disabled = false;

                        // Directly enable the DOM checkboxes (force clickable)
                        setTimeout(() => {
                            const inputs = document.querySelectorAll('[name^="data[selectBoxes1]"]');
                            inputs.forEach(input => {
                                input.removeAttribute('disabled');
                                input.style.pointerEvents = 'auto';
                                input.style.opacity = '1';
                                input.disabled = false;
                            });
                        }, 300);
                    }
                });
                        let debounceTimer;
                        renderer.on('change', function (event, flags) {
                            clearTimeout(debounceTimer);
                            debounceTimer = setTimeout(function() {
                                if (flags && !flags.fromSubmission) {
                                    setSubmission(renderer.submission, 'renderer');
                                }
                            }, 500);
                        });
                    });

                document.getElementsByName('Data')[0].value = JSON.stringify(form);
