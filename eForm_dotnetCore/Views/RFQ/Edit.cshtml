            function uploadBase64File(supplierid,rfqid,quatno,base64String, fileName, contentType = null) {
                const formData = new FormData();
                formData.append('supplierId', supplierid);
                formData.append('rfqId', rfqid);
                formData.append('quotNo', quatno);
                formData.append('base64String', base64String);
                formData.append('fileName', fileName);
                //formData.append('supportFileId',supportFileIdVal);
                
                if (contentType) formData.append('contentType', contentType);

                $.ajax({
                    url: '@Url.Action("UploadBase64", "Supplier")',
                    type: 'POST',  // Changed to POST
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        //console.log('File uploaded successfully:', response);
                        //alert('File uploaded!');
                    },
                    error: function (xhr, status, error) {
                        console.error('Upload failed:', xhr.responseText);
                        alert('Upload failed: ' + xhr.responseText);
                    }
                });
            }

            $('#backtoBOM').click(function () {
                window.location.href = '@Url.Action("Index", "BOM", new { id = Model.ProjectId })';
            });
            
            function addSupplier(){
                $.ajax({
                    url: '@Url.Action("AddSupplier", "RFQSharing")',
                    data: { id: "@sourceId" },
                    type: 'get',
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        $("#selectSupplierForm").html(response);
                        requestModal.show();
                    }
                });
            }
        </script>
    }
