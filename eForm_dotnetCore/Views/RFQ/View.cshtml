@model Rfq

@{
    Layout = "~/Views/Shared/_LayoutAnonymous.cshtml";
}

<div class="card card-xxl-stretch mb-5 mb-xxl-10">
    <div class="card-header d-flex justify-content-between">
        <div class="card-title">
            <h3>Edit form - @Model.FormName</h3>
        </div>
    </div>
    <div class="card-body pb-0">
        <form>
            <div class="form-horizontal">
                <div class="form-group">
                    @Html.LabelFor(model => model.FormName, "Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.FormName, new { htmlAttributes = new { @class = "form-control", required = "", disabled = "disabled" } })
                        @Html.ValidationMessageFor(model => model.FormName, "", new { @class = "text-danger" })
                    </div>
                </div>
                 <div class="d-flex justify-content-between align-item-center px-4 my-2">
                      <div class="form-group">
                        @Html.LabelFor(model => model.CreatedDate, "Create Date", htmlAttributes: new { @class = "control-label fw-bold fs-2" })
                        <div>
                            @Html.DisplayFor(x => x.CreatedDate)
                        </div>
                    </div>
                     <div class="form-group">
                        @Html.LabelFor(model => model.LastUpdatedDate, "Last Update Date", htmlAttributes: new { @class = "control-label fw-bold fs-2" })
                        <div>
                            @Html.DisplayFor(x => x.LastUpdatedDate)
                        </div>
                    </div>
                </div>
                <input type="hidden" name="Data" value="" />
                <input type="hidden" name="DataResponse" id="DataResponse" value="" />
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="AssignUser" value="" />
                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                <input type="hidden" id="checkbox-Id" value="" />
                @*<input type="hidden" name="Bomid" value="@Model.Bomid" />*@

                <div id="builder" hidden></div>

                <div class="card">
                    <div class="card-body" style="overflow-x:auto">
                        <div id="render"></div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
<script>
    const data = @Html.Raw(string.IsNullOrEmpty(Model.Data) ? "{}" : Model.Data);
    const submission = @Html.Raw(string.IsNullOrEmpty(Model.DataResponse) ? "{data:{}}" : Model.DataResponse);
    var check = '@Model.Status' == "RFQ Approved" ||'@Model.Status' == "Pending RFQ Approved" ? true : false;
    var stateOptions = {};
    if(check)
        stateOptions ={
            readOnly: 'true',
            viewOnly: 'true'
        }

    var formStatus = {
        "label": "Form Status",
        "labelPosition": "left-left",
        "disabled": true,
        "tableView": true,
        "key": "formStatus",
        "hidden": true,
        "type": "textfield",
        "input": true,
    }

    if(JSON.stringify(data) !== JSON.stringify({})){
        data.components.unshift(formStatus);
    }

    var builder;
    var renderer;
    var state = {
        formioVersion: 'default',
        form: data,
        submission: submission,
        options: stateOptions,
    };

    function initBuilder(form) {
        if (builder) {
            builder.instance.destroy();
        }
        builder = new Formio.FormBuilder(document.getElementById('builder'), form, _.cloneDeep(state.options));

        builder.instance.ready.then(function () {
            builder.instance.on('change', function (event, flags) {
                if (!flags) {
                    setForm(builder.instance.schema, 'builder');
                }
            });
        })
    }

    function initRenderer(form) {
        if (renderer) {
            renderer.destroy();
        }
        Formio.createForm(document.getElementById('render'), form, _.cloneDeep(state.options))
            .then(function (self) {
                renderer = self;
                renderer.submission = state.submission;
                renderer.on('change', function (event, flags) {


                    if (flags && !flags.fromSubmission){
                        setSubmission(renderer.submission, 'renderer');
                    }
                });
            });

        document.getElementsByName('Data')[0].value = JSON.stringify(form);
    }

    function setForm(form, from) {
        console.log('setForm', form, from);
        state.form = form;
        if (!renderer.checkData()) {
            document.getElementById("submitBtn").disabled = true;
        } else {
            document.getElementById("submitBtn").disabled = false;
        }
    }

    function setSubmission(submission, from) {
        console.log('setSubmission', submission, from);
        if (renderer && from !== 'renderer') {
            renderer.submission = submission;
        }

        document.getElementsByName('DataResponse')[0].value = JSON.stringify(submission);
      //document.getElementsByName('DataResponse')[1].value = JSON.stringify(submission); 
    }

    initBuilder(state.form);
    initRenderer(state.form);
</script>
}
