<div class="modal fade" id="modal_reject_from_edit" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-6 px-lg-10 pt-0 pb-6">
                <div class="text-center">
                    <h1 class="mb-3">Reject Form</h1>
                    <div class="text-muted fw-bold fs-5">
                        Please enter reason for rejection.
                    </div>
                    <form asp-action="DeleteRFQ" asp-controller="RFQTracker">
                        <div class="d-flex flex-column mt-5 mb-8 fv-row">
                            <label class="fs-6 fw-bold mb-2">Reason</label>
                            <textarea class="form-control form-control-solid mb-3" rows="2" name="reason"></textarea>
                        </div>
                        <input name="rfqId" value="@Model.RFQId" hidden />
                        <input name="fromTracker" value="true" hidden />
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


    @section Scripts {
        <script>
            // Function To Edit Form

            $(document).ready(function () {
                var model1 = document.getElementById("modal_reject_rfq");
                var rejectModal = new bootstrap.Modal(model1);
                
                $('#submitBtn').click(function () {
                    submitRFQ(false);
                });


                $("#fillForm").submit(function (event) {
                    Swal.fire({
                        html: 'Loading...',
                        ProgressBar: true,
                        didOpen: () => {
                            Swal.showLoading()
                        }
                    })
                })

                $("#import_rfq_submit").click(function () {
                    $("#import-validation").val("");
                    $("import_rfq_submit").attr("disabled", "disabled");
                    $("#import_modal_close").attr("disabled", "disabled");
                    $("#loading-spinner-import").css("display", "block");
                    var formData = new FormData();
                    var postedFile = document.getElementById("postedFile").files[0];
                    formData.append("FileUpload", postedFile);
                    formData.append("Id", @Model.RFQId);

                    $.ajax({
                        url: "/RFQ/ImportRFQ",
                        data: formData,
                        processData: false,
                        contentType: false,
                        type: "POST",
                        success: function (result) {
                            if (result.result) {
                                window.location.href = "/RFQ/Edit/" + @Model.RFQId+"?bomId=" + @Model.Id;
                            }
                            else {
                                $("#import-validation").text(result.msg);
                                $("import_rfq_submit").prop("disabled", false);
                                $("#import_modal_close").prop("disabled", false);
                                $("#loading-spinner-import").css("display", "none");
                            }
                        },
                        error: function (result) {
                            $("#import-validation").text(result.msg);
                            $("#import_rfq_submit").prop("disabled", false);
                            $("#import_modal_close").prop("disabled", false);
                            $("#loading-spinner-import").css("display", "none");
                        }
                    });
                });

                $('#rejectBtn').click(function () {
                    Swal.fire({
                        text: "Are you sure you would like to reject?",
                        icon: "warning",
                        showCancelButton: true,
                        buttonsStyling: false,
                        confirmButtonText: "Yes, reject it!",
                        cancelButtonText: "No, return",
                        customClass: {
                            confirmButton: "btn btn-primary",
                            cancelButton: "btn btn-active-light"
                        }
                    }).then(function (result) {
                        if (result.value) {
                            Swal.fire({
                                title: '<div class="spinner-border text-info" role="status"><span class="sr-only">Loading...</span></div>',
                                text: "Please wait...",
                                icon: "success",
                                showCancelButton: false,
                                showConfirmButton: false,
                                buttonsStyling: false,
                            });
                            $.post('@Url.Action("rejectRFQ","RFQ")', { id: @Model.RFQId, remark: $("#rejectRemark").val() }, function (data, status) {
                                console.log(status);
                                window.location.href = '@Url.Action("Index","BOM",new {id = Model.ProjectId})';
                            })
                        } else if (result.dismiss === 'cancel') {
                            Swal.fire({
                                text: "The RFQ has not been reject!.",
                                icon: "error",
                                buttonsStyling: false,
                                confirmButtonText: "Ok, got it!",
                                customClass: {
                                    confirmButton: "btn btn-primary",
                                }
                            });
                        }
                    });
                });
            });

            var autoTrigger = $('#autoTrigger').val();

            function submitRFQ(autoSubmit) {
                if (!renderer.checkData()) {
                    var errorField = [];
                    renderer.everyComponent((component) => {
                        const value = component.getValue();
                        const isRequired = component.component.validate?.required;

                        // Check if field is required and empty
                        if (isRequired && (value === null || value === "" || (Array.isArray(value) && value.length === 0))) {
                            errorField.push(component.component.label + " is required.");
                        }
                        // Check if field has custom validation error
                        else if (component.error !== null) {
                            errorField.push(component.component.label + ": " + component.error.message);
                        }
                    });
                    
                    if (autoSubmit) {
                        autoTrigger = 'false';
                        window.location.href = "@Url.Action("Success", "RFQSharing")"
                    }
                }
                else {
                    let totalPrice = 0;
                    $('#rsTable tbody tr').each(function () {
                        let price = parseFloat($(this).data('price'));
                        if (!isNaN(price)) {
                            totalPrice += price;
                        }
                    });

                    // If autoSubmit is true, skip Swal confirmation
                    if (autoSubmit) {
                        triggerSubmit();
                    } else {
                        Swal.fire({
                            text: "Are you sure you would like to submit?",
                            icon: "info",
                            showCancelButton: true,
                            buttonsStyling: false,
                            confirmButtonText: "Yes",
                            cancelButtonText: "No",
                            customClass: {
                                confirmButton: "btn btn-primary",
                                cancelButton: "btn btn-active-light"
                            }
                        }).then(function (result) {
                            if (result.value) {
                                triggerSubmit();
                            } else if (result.dismiss === 'cancel') {
                                Swal.fire({
