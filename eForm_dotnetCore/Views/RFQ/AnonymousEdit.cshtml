@model Bom
@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.Common
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using eForm_dotnetCore.Configuration.Auhtorization;
@using Microsoft.Net.Http.Headers;

@{
    ViewData["Title"] = "Edit RFQ - " + (Model.RFQ.Rfqname);
    var isProjectCompleted = ViewBag.isProjectCompleted;
    var isFabrication = ViewBag.isFabrication;
    var allowSubmit = ViewBag.allowSubmit;
    var errorMsg = ViewBag.Error;
    var bomStatus = ViewBag.BomStatus;
    var srs = ViewBag.srs as List<RFQSharing> ?? new List<RFQSharing>();
}

@{
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Html.Raw(ViewBag.Error)
        </div>
    }
}

<div class="card card-xxl-stretch mb-5 mb-xxl-10">
    <div class="card-header d-flex justify-content-between">
        <div class="card-title">
            <h5>Edit form - @Model.RFQ.Rfqname</h5>
        </div>
        <div class="card-title">
            <a href="@Url.Action("DownloadRFQDrawing",new {id = Model.RFQId})" @{
                if (isFabrication)
                {
                    @:class="btn btn-info mx-2"
                }
                else
                {
                    @:hidden="true"
                }
            }>
                Download Drawing
            </a>
            <button @{
                if (bomStatus.Equals("RFQ Sent", StringComparison.OrdinalIgnoreCase) && !isProjectCompleted)
                {
                    @:class="btn btn-primary"
                    @:data-bs-toggle="modal"
                    @:data-bs-target="#modal_import_RFQ"
                }
                else
                {
                    @:class="btn btn-secondary disabled"
                    @:disabled="disabled"
                }
            }>
                Import
            </button>
            <a href="@Url.Action("ExportToExcel",new {id = Model.RFQId})" class="btn btn-outline-success mx-2">Export To Excel</a>
        </div>
    </div>
    <form id="fillForm" asp-action="Edit" method="post">
        <div class="card-body pb-0">
            <div class="form-horizontal">
                <div class="form-group">
                    @Html.LabelFor(model => model.RFQ.Rfqname, "Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.RFQ.Rfqname, new { htmlAttributes = new { @class = "form-control", required = "", disabled = "disabled" } })
                        @Html.ValidationMessageFor(model => model.RFQ.Rfqname, "", new { @class = "text-danger" })
                    </div>
                </div>

                <input type="hidden" name="Data" id="hiddendata" value="" />
                <input type="hidden" name="DataResponse" id="DataResponse" value="" />
                <input type="hidden" name="id" id="rfqId" value="@Model.RFQId" />
                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                <input type="hidden" name="bomId" value="@Model.Id" />
                <input type="hidden" name="IsAutoSubmit" id="IsAutoSubmit" value="true" />
                <input type="hidden" name="VendorName" id="VendorName" value="@(srs.FirstOrDefault()?.Supplier?.VendorName ?? "Vendor")" />
                <input type="hidden" id="autoTrigger" value="@ViewBag.AutoTrigger.ToString().ToLower()" />
                <div class="card">
                    <style>
                        div#render .formio-component-textarea textarea,
                        div#render .formio-component-textfield input[type="text"] {
                            word-wrap: break-word;
                            white-space: pre-wrap;
                            max-width: 100%;
                            min-width: 100px; 
                        }
                    </style>
                    <div class="card-body" style="overflow-x:auto">
                        <div id="render"></div>
                    </div>
                </div>

                <div class="form-group pt-3">
                    <div class="d-flex flex-row justify-content-end">
                        @{
                            if (!isProjectCompleted)
                            {
                                var prevStatus = CommonHelpers.GetPrevStatus(bomStatus);
                                <button type="button" onclick="backToSubmit('@prevStatus','@FormType.RFQ')" class="btn btn-primary mx-2"
                                @{
                                    if (bomStatus.Equals("New", StringComparison.OrdinalIgnoreCase))
                                    {
                                        @:hidden
                                    }
                                }>
                                    Back to Submit
                                </button>
                                if (bomStatus.Equals("RFQ Updated", StringComparison.OrdinalIgnoreCase) && allowSubmit)
                                {
                                    <button type="button" id="approveBtn" class="btn btn-success mx-2">Approve</button>
                                    <button type="button" class="btn btn-danger mx-2" data-bs-toggle="modal" data-bs-target="#modal_reject_rfq">Reject</button>
                                }
                                else if (!CommonHelpers.availableBaseStatus("RFQ Approved", bomStatus) || bomStatus.Equals("PR Reject") || bomStatus.Equals("PO Reject") || bomStatus.Contains("Cancelled"))
                                {
                                    if (allowSubmit)
                                    {
                                        <input type="submit" id="updateButton" name="updateButton" value="Save" class="btn btn-success mr-2 text-end" />
                                        if (!CommonHelpers.availableBaseStatus("RFQ Sent", bomStatus) || Context.GetUserType() == "Buyer" || Context.GetUserType() == "SuperAdminAssistant" || Context.GetUserType() == "SuperAdmin")
                                        {
                                            if (bomStatus.Equals("New", StringComparison.OrdinalIgnoreCase) || bomStatus.Equals("Pending Submit RFQ", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(bomStatus))
                                            {
                                                <button type="button" data-bs-toggle="modal" data-bs-target="#modal_delete_rfq" class="btn btn-danger mr-2 text-end">Delete</button>
                                            }
                                            else
                                            {
                                                <button type="button" data-bs-toggle="modal" data-bs-target="#modal_reject_from_edit" class="btn btn-danger mr-2 text-end">Reject</button>
                                            }
                                        }
                                        <button type="button" id="submitBtn" name="submitButton" class="btn btn-primary text-end">Submit</button>
                                    }
                                }
                            }
                        }
                    </div>
                    <br />
                    <hr />
                    <br />
                    @if (srs.Any())
                    {
                        <div class="card-body py-0">
                            <div class="table-responsive">
                                <table id="rsTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                                    <thead>
                                        <tr class="fw-bolder text-muted">
                                            <th class="min-w-100px" style="color:black; font-size:15px; border-left: 2px solid #D3D3D3; border-right: 2px solid #D3D3D3;"><b>Sharing. RFQ</b></th>
                                            <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Receiver</b></th>
                                            <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Status</b></th>
                                            <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Submitted Date</b></th>
                                            <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Lead Time</b></th>
                                            <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Net Price</b></th>
                                            <th class="min-w-100px" style="color:black; font-size:15px; border-right: 2px solid #D3D3D3;"><b>Action</b></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var form in srs)
                                        {
                                            <tr id="@form.Id" class="text-center" data-price="@form.TotalPrice.GetValueOrDefault(0)">

                                                <td class="tableCellStandard tableCellBorderLeft">
                                                    <a href="@Url.Action("Index","RFQSharing",new {id = form.Id, bomId = @Model.Id})">Sharing RFQ</a>
                                                </td>
                                                <td class="tableCellStandard tableCellBorderLeft">
                                                    @form.Supplier.VendorName
                                                </td>
                                                <td class="tableCellStandard tableCellBorderLeft">
                                                    @if (form.SubmittedDate.HasValue && form.Rejected == false)
                                                    {
                                                        <div class="badge badge-light-success badge-status">Submitted</div>
                                                    }
                                                    else if (form.Rejected == true)
                                                    {
                                                        <div class="badge badge-light-danger badge-status">Rejected</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="badge badge-light-warning badge-status">Processing</div>
                                                    }
                                                </td>
                                                <td class="tableCellStandard tableCellBorderLeft">
                                                    @form.SubmittedDate?.ToString("d")
                                                </td>
                                                <td class="tableCellStandard tableCellBorderLeft text-center">
                                                    @if (form.UniqueDeliveryDates != null && form.UniqueDeliveryDates.Any())
                                                    {
                                                        if (form.UniqueDeliveryDates.Count == 1)
                                                        {
                                                            <span style="font-size: 16px; color: #000; font-weight: normal;">@form.UniqueDeliveryDates.First().ToString("dd/MM/yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex flex-wrap gap-2 justify-content-center">
                                                                @foreach (var date in form.UniqueDeliveryDates)
                                                                {
                                                                    <span class="badge badge-light-secondary" style="font-size: 14px; padding: 6px 12px; color: #000; font-weight: normal; background-color: #e9ecef; border: 1px solid #d0d0d0;">@date.ToString("dd/MM/yyyy")</span>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                    else if (form.LeadTime != null && form.LeadTime != DateTime.MinValue)
                                                    {
                                                        <span style="font-size: 16px; color: #000; font-weight: normal;">@form.LeadTime.Value.ToString("dd/MM/yyyy")</span>
                                                    }
                                                </td>

                                                <td class="tableCellStandard tableCellBorderLeft">
                                                    @if (form.TotalPrice != null)
                                                    {
                                                        <span>@ViewBag.Currency @form.TotalPrice.Value.ToString("N2")</span>
                                                    }
                                                </td>


                                                <td class="tableCellStandard tableCellBorderLeft">
                                                    @if (form.SubmittedDate.HasValue)
                                                    {
                                                        var isDisabled = bomStatus.Equals("RFQ Updated", StringComparison.OrdinalIgnoreCase)
                                                        || bomStatus.Equals("RFQ Approved", StringComparison.OrdinalIgnoreCase);

                                                        <button onclick="copypricerfq('@form.Id','@form.Supplier.VendorName')"
                                                                type="button"
                                                                class="btn btn-sm btn-info"
                                                        @(isDisabled ? "disabled" : "")>
                                                            Copy Price
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    }
                </div>
            </div>
        </div>
    </form>
</div>

@*Import BOM Modal*@
<div class="modal fade" id="modal_import_RFQ" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <span class="svg-icon svg-icon-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="black" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="black" />
                        </svg>
                    </span>
                </div>
            </div>
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">

                <div class="mb-13 text-center">
                    <h1 class="mb-3">Import RFQ</h1>
                    <div class="text-muted fw-bold fs-5">
                        Please click the link to download the Excel Template.
                        <a href="@Url.Action("DownloadRFQTemplate", "RFQ", new { id = ViewBag.RFQId })" class="fw-bolder link-primary">
                            Download template
                        </a>.
                    </div>
                </div>

                <div class="mt-3 my-5 ml-5">
                    <input type="file" name="postedFile" id="postedFile" accept=".csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" />
                </div>

                <div class="text-center">
                    <button type="button" id="import_modal_close" class="btn btn-light me-3">Cancel</button>
                    <button type="button" id="import_rfq_submit" class="btn btn-primary">Import</button>
                    <p id="import-validation" class="text-warning" type="text"></p>
                </div>

                <div id="loading-spinner-import" style="text-align:center;display:none;margin-top:20px;">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="text-active-success">Import in progress. Please wait...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (@Context.Request != null)
{
    <a href="@Context.Request.Headers[HeaderNames.Referer]">Back To Details</a>
}


