            function initRenderer(form) {
                if (state.submission && state.submission.data && Array.isArray(state.submission.data.itemList)) {
                    const itemList = state.submission.data.itemList;

                    const hasQuotationLineNo = itemList.some(item => {
                        const val = item.quotationLineNo;
                        return val !== undefined && val !== null && val !== '';
                    });

                    if (hasQuotationLineNo) {
                        itemList.sort((a, b) => {
                            const aLine = parseInt(a.quotationLineNo);
                            const bLine = parseInt(b.quotationLineNo);

                            if (isNaN(aLine)) return 1;
                            if (isNaN(bLine)) return -1;

                            return aLine - bLine;
                        });

                        // Force deep clone to make Form.io re-render the updated list
                        state.submission = JSON.parse(JSON.stringify(state.submission));
                    }
                }

                if (renderer) {
                    renderer.destroy();
                }

                Formio.createForm(document.getElementById('render'), form, _.cloneDeep(state.options))
                    .then(function (self) {
                        renderer = self;
                        renderer.submission = state.submission;
                        let debounceTimer;
                        renderer.on('change', function (event, flags) {
                            clearTimeout(debounceTimer);
                            debounceTimer = setTimeout(function() {
                                if (flags && !flags.fromSubmission) {
                                    setSubmission(renderer.submission, 'renderer');
                                }

                                if (autoTrigger === 'true') {
                                    console.log('Auto trigger submit after renderer ready');
                                    submitRFQ(true);
                                }
                            }, 500);
                        });
                    });

                document.getElementsByName('Data')[0].value = JSON.stringify(form);
            }

