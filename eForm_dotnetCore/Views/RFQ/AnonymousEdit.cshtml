                        },
                        //success: function() {location.reload();}
                        success: function (e) {
                            if (e.result) {
                                alert("The selected brand from RFQ already record in the system.")
                            }
                            else {
                                var baseurl = '@Url.Action("PreviewSourcing","Sourcing")';
                                var itemList = items.join(',');
                                var finalUrl = baseurl + '?list=' + itemList + '&brand=' + brand + '&rfqId=' + '@Model.RFQId';
                                window.location.href = finalUrl;
                            }
                        }
                    });
                })
                Swal.close();
