@using eForm_dotnetCore.Common
@using eForm_dotnetCore.Helpers
@using eForm_dotnetCore.ViewModels

@model IEnumerable<PRTrackerViewModel>

@{
    ViewData["Title"] = PageTitle.PRTracker;
}
<div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
    <div class="content flex-row-fluid" id="kt_content">

        <div class="card card-flush mb-5 mb-xl-8">
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bolder fs-3 mb-1">@PageTitle.PRTracker</span>

                </h3>
                <div class="card-toolbar">
                    <div class="d-flex flex-stack flex-wrap gap-4">
                        <button id="mergeBtn" type="button" class="btn btn-primary" hidden>Merge in one</button>
                        <div class="d-flex align-items-center position-relative my-1">
                            <span class="svg-icon svg-icon-3 position-absolute ms-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="black" />
                                    <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="black" />
                                </svg>
                            </span>
                            <input type="text" id="filter_search" class="form-control form-control-solid form-select-sm w-150px ps-9" placeholder="Search Form" />
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Header-->
            <!--begin::Body-->
            @* <div class="card card-flush mb-5 mb-xl-8">*@
            <div class="card-body py-3">
                <!--begin::Table container-->
                <div class="table-responsive">
                    <!--begin::Table-->
                    <table id="formListTable" class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <!--begin::Table head-->
                        <thead>
                            <tr class="fw-bolder fs-6 text-uppercase text-center">
                                @*<th class="w-25px">
                                    <div class="form-check form-check-sm form-check-custom form-check-solid">
                                    <input class="form-check-input" type="checkbox" value="1" id="checkAll"/>
                                    </div>
                                    </th>*@
                                <th class="min-w-50px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>Status</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>PR No</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>Project Code</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>Customer</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>Project PO No</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>Project Name</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>Project Category</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>Requestor</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>PR Total Price</b></th>
                                <th class="min-w-100px" style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;"><b>Remark</b></th>
                                <th class="min-w-70px" style="color:black;font-size:12px;"><b>Action</b></th>

                            </tr>
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody>
                            @if (Model.Count() > 0)
                            {
                                @foreach (var form in Model)
                                {
                                    <tr id="@form.Id" class="text-center">
                                        @* <td>
                                            <div class="form-check form-check-sm form-check-custom form-check-solid me-2">
                                            <input class="form-check-input widget-9-check btn-chkBox" type="checkbox" value="@form.Id,@form.BomId,@form.BomModule" />
                                            </div>
                                            </td>*@
                                        <td style="color:black;font-size:14px;border-right: 2px solid #D3D3D3;">
                                           @if (form.Status.Equals("New", StringComparison.OrdinalIgnoreCase) || form.Status.Equals("PR Approve", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="badge badge-light-primary badge-status">@form.Status.ToUpper()</div>
                                            }
                                            else if (form.Status.Equals("RFQ Sent", StringComparison.OrdinalIgnoreCase) || form.Status.Equals("PR Approved", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="badge badge-light-warning badge-status">@form.Status.ToUpper()</div>
                                            }
                                            else if (form.Status.Equals("RFQ Approved", StringComparison.OrdinalIgnoreCase) || form.Status == "PO Approved")
                                            {
                                                <div class="badge badge-light-info">@form.Status.ToUpper()</div>
                                            }
                                            else if (form.Status == "PR Sent" || form.Status == "Item Received")
                                            {
                                                <div class="badge badge-light-success">@form.Status.ToUpper()</div>
                                            }
                                            else if (form.Status == "RFQ Reject" || form.Status == "PR Reject")
                                            {
                                                <div class="badge badge-light-danger badge-status">@form.Status.ToUpper()</div>
                                            }
                                        </td>
                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                           <div class="menu-item">
                                                    <a href="/PurchaseRequisition/Edit/@form.Id" class="link-primary"><b>@form.PrName</b></a>
                                            </div>
                                        </td>
                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                            @form.ProjectCode
                                        </td>
                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                            @form.Customer
                                        </td>
                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                            @form.CustomerPO
                                        </td>
                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                            @form.ProjectName
                                        </td>
                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                            @form.ProjectCategory
                                        </td>
                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                            @form.Requestor
                                        </td>

                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                            @form.PRTotalPrice
                                        </td>
                                        <td style="color:black;font-size:12px;border-right: 2px solid #D3D3D3;">
                                            @form.Remark
                                        </td>
                                        <td style="color:black;font-size:12px;">
                                            <a href="#" class="btn btn-sm btn-light btn-active-light-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                                                Actions
                                                <span class="svg-icon svg-icon-5 m-0">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                        <path d="M11.4343 12.7344L7.25 8.55005C6.83579 8.13583 6.16421 8.13584 5.75 8.55005C5.33579 8.96426 5.33579 9.63583 5.75 10.05L11.2929 15.5929C11.6834 15.9835 12.3166 15.9835 12.7071 15.5929L18.25 10.05C18.6642 9.63584 18.6642 8.96426 18.25 8.55005C17.8358 8.13584 17.1642 8.13584 16.75 8.55005L12.5657 12.7344C12.2533 13.0468 11.7467 13.0468 11.4343 12.7344Z" fill="black" />
                                                    </svg>
                                                </span>
                                            </a>

                                            <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 w-125px py-4" data-kt-menu="true">
                                                <div class="menu-item px-3">
                                                    <a href="#" class="menu-link px-3" onclick="deletePR(@form.Id)">Delete PR</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Table container-->
            </div>
            <!--begin::Body-->
        </div>
    </div>
</div>
@section scripts{
<script>

    $(document).ready(function () {
        var table = document.getElementById("formListTable");

        var dataTable = $(table).DataTable({
            "info":false,
            "order":[]
        });

        var filterSearch = document.getElementById("filter_search");
        filterSearch.addEventListener("keyup", function (e) {
            dataTable.search(e.target.value).draw();
        });
       });



    function deletePR(PrId){
        Swal.fire({
                text: "Are you sure delete this PR?",
                icon: "warning",
                showCancelButton: true,
                buttonsStyling: false,
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "No, return",
                customClass: {
                    confirmButton: "btn btn-primary",
                    cancelButton: "btn btn-active-light"
                }
            }).then(function (result) {
                if (result.value) {
                    var table = $("#formListTable").DataTable();
                    $.ajax({
                         url : "@Url.Action("DeletePR","PRTracker")",
                         method : "delete",
                         data : {
                            id :PrId
                         },
                         success: function() {
                            //table.row("#"+ PrId).remove().draw();
                            location.reload();
                         }
                    });
                } else if (result.dismiss === "cancel") {
                    Swal.fire({
                        text: "Your form has not been cancelled!.",
                        icon: "error",
                        buttonsStyling: false,
                        confirmButtonText: "Ok, got it!",
                        customClass: {
                            confirmButton: "btn btn-primary",
                        }
                    });
                }
            });
    }
</script>
}
